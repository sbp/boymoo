     (:label "rt:print-check-punctuation")
     (:ldrb-reg 7 8 6)
     (:cbz 7 "rt:print-quoted")
     (:cmp-reg 5 7)
     (:b-cond :eq "rt:print-check-next")
     (:add 6 6 1)
     (:b "rt:print-check-punctuation")
     (:label "rt:print-check-next")
     (:add 4 4 1)
     (:cmp-reg 4 2)
     (:b-cond :lo "rt:print-check-char")
     (:label "rt:print-plain")
     (:cmp-reg 0 20)
     (:b-cond :hs "rt:print-return")
     (:cbz 2 "rt:print-return")
     (:ldrb 5 1 0)
     (:strb 5 0 0)
     (:add 0 0 1)
     (:add 1 1 1)
     (:sub 2 2 1)
     (:b "rt:print-plain")
     (:label "rt:print-quoted")
     (:cmp-reg 0 20)
     (:b-cond :hs "rt:print-return")
     (:strb 3 0 0)
     (:add 0 0 1)
     (:adr 8 "rt:hex-digits")
     (:label "rt:print-quoted-char")
     (:cmp-reg 0 20)
     (:b-cond :hs "rt:print-return")
     (:cbz 2 "rt:print-close-quote")
