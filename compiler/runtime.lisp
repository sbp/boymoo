    ; In: A datum in x0. Out: x0 is the character's tagged byte code
    ; for CHAR-CODE, or the character for CODE-CHAR. Outside their
    ; domains each uses byte code zero.
    ; Changes: NZCV, plus x1 for CHAR-CODE. Stack: None. Allocates: No.
    (:label "prim:COMMON-LISP::CHAR-CODE")
    (:and-mask 1 0 3)
    (:cmp 1 4)
    (:b-cond :ne "rt:zero")
    (:lsr 0 0 3)
    (:lsl 0 0 1)
    (:add 0 0 1)
    (:ret)
    (:label "prim:COMMON-LISP::CODE-CHAR")
    (:tst-mask 0 1)
    (:b-cond :eq "rt:zero-character")
    (:cmp 0 511)
    (:b-cond :hi "rt:zero-character")
    (:lsl 0 0 2)
    (:ret)
    ; In: None. Out: x0 is character zero, tagged integer zero or
    ; tagged integer one, respectively.
    ; Changes: None. Stack: None. Allocates: No.
    (:label "rt:zero-character")
    (:movz 0 4 0)
    (:ret)
    (:label "rt:zero")
    (:movz 0 1 0)
    (:ret)
    (:label "rt:one")
    (:movz 0 3 0)
    (:ret)

    ; In: A datum in x0. Out: x3 is the numeric class, 3 for integers,
    ; 4 for fractions, 5 for complex rationals or 0 for other data.
    ; For header-tagged data, x4 is its header address.
    ; Changes: x4 when not an output, x5 and NZCV. x0, x1, x6 and x7
    ; are preserved. Stack: None. Allocates: No.
    (:label "rt:num-type")
    (:movz 3 3 0)
    (:tst-mask 0 1)
    (:b-cond :ne "rt:num-type-return")
    (:and-mask 3 0 3)
    (:cmp 3 2)
    (:b-cond :ne "rt:num-type-other")
    (:sub 4 0 2)
    (:add-reg 4 28 4 0)
    (:ldrb 3 4 0)
    (:sub 5 3 3)
    (:cmp 5 2)
    (:b-cond :ls "rt:num-type-return")
    (:label "rt:num-type-other")
    (:movz 3 0 0)
    ; Shared return: Gives back the caller's current registers and flags.
    (:label "rt:num-type-return")
    (:ret)

    ; In: A datum in x0. Out: x0 is the numerator, denominator, real
    ; part or imaginary part. NUMERATOR and DENOMINATOR fix
    ; nonrational data to zero, and REALPART and IMAGPART fix
    ; nonnumeric data to zero.
    ; Changes: x3 through x5 and NZCV. Stack: Up to 16 machine bytes
    ; for saves. Allocates: No.
    (:label "prim:COMMON-LISP::NUMERATOR")
    (:tst-mask 0 1)
    (:b-cond :ne "rt:num-type-return")
    (:stp-pre 29 30 31 -16)
    (:bl "rt:num-type")
    (:ldp-post 29 30 31 16)
    (:cmp 3 3)
    (:b-cond :eq "rt:num-type-return")
    (:cmp 3 4)
    (:b-cond :ne "rt:zero")
    (:ldr 0 4 8)
    (:ret)
    (:label "prim:COMMON-LISP::DENOMINATOR")
    (:tst-mask 0 1)
    (:b-cond :ne "rt:one")
    (:stp-pre 29 30 31 -16)
    (:bl "rt:num-type")
    (:ldp-post 29 30 31 16)
    (:cmp 3 4)
    (:b-cond :ne "rt:one")
    (:ldr 0 4 16)
    (:ret)
    (:label "prim:COMMON-LISP::REALPART")
    (:tst-mask 0 1)
    (:b-cond :ne "rt:num-type-return")
    (:stp-pre 29 30 31 -16)
    (:bl "rt:num-type")
    (:ldp-post 29 30 31 16)
    (:cbz 3 "rt:zero")
    (:cmp 3 5)
    (:b-cond :ne "rt:num-type-return")
    (:ldr 0 4 8)
    (:ret)
    (:label "prim:COMMON-LISP::IMAGPART")
    (:tst-mask 0 1)
    (:b-cond :ne "rt:zero")
    (:stp-pre 29 30 31 -16)
    (:bl "rt:num-type")
    (:ldp-post 29 30 31 16)
    (:cmp 3 5)
    (:b-cond :ne "rt:zero")
    (:ldr 0 4 16)
    (:ret)

    ; In: Datums in x0 and, for binary operations, x1.
    ; Out: x0 is the arithmetic result or, for <, T or NIL. Nonnumeric
    ; arguments count as zero and the reciprocal of zero is zero.
    ; Changes: Volatile set and x24, x26 and x27. Stack: None locally.
    ; Allocates: Yes. The immediate paths keep the operands available
    ; for the general routines if the computation needs to allocate.
    (:label "prim:ACL2::BINARY-+")
    (:and-reg 2 0 1)
    (:tst-mask 2 1)
    (:b-cond :eq "rt:n-add")
    (:sub 2 1 1)
    (:adds-reg 2 0 2 0)
    (:b-cond :vs "rt:z-add-op")
    (:mov 0 2)
    (:ret)
    (:label "prim:ACL2::BINARY-*")
    (:and-reg 2 0 1)
    (:tst-mask 2 1)
    (:b-cond :eq "rt:n-multiply")
    (:asr 2 0 1)
    (:sub 3 1 1)
    (:smulh 4 2 3)
    (:mul 2 2 3)
    (:asr 3 2 63)
    (:cmp-reg 4 3)
    (:b-cond :ne "rt:z-multiply-op")
    (:add 0 2 1)
    (:ret)
    (:label "prim:ACL2::UNARY--")
    (:tst-mask 0 1)
    (:b-cond :eq "rt:n-negate")
    (:movz 2 2 0)
    (:subs-reg 2 2 0 0)
    (:b-cond :vs "rt:z-negate-op")
    (:mov 0 2)
    (:ret)
    (:label "prim:ACL2::UNARY-/")
    (:tst-mask 0 1)
    (:b-cond :eq "rt:n-reciprocal")
    (:cmn 0 1)
    (:b-cond :lt "rt:q-reciprocal")
    (:cmp 0 3)
    (:b-cond :gt "rt:q-reciprocal")
    (:ret)
    (:label "prim:COMMON-LISP::<")
    (:and-reg 2 0 1)
    (:tst-mask 2 1)
    (:b-cond :eq "rt:n-less")
    (:cmp-reg 0 1)
    (:b-cond :lt "rt:true")
    (:b "rt:nil")

    ; In: Datums in x0 and x1.
    ; Out: The operands in x0 and x1, with nonnumbers mapped to zero.
    ; x3 gives the maximum of their original numeric classes.
    ; Changes: x4 through x7 and NZCV. Stack: 16 machine bytes for saves.
    ; Allocates: No.
    (:label "rt:n-types")
    (:stp-pre 29 30 31 -16)
    (:bl "rt:num-type")
    (:cmp 3 0)
    (:movz 6 1 0)
    (:csel 6 0 6 :ne)
    (:mov 7 3)
    (:mov 0 1)
    (:bl "rt:num-type")
    (:cmp 3 0)
    (:movz 1 1 0)
    (:csel 1 0 1 :ne)
    (:mov 0 6)
    (:cmp-reg 3 7)
    (:csel 3 3 7 :hs)
    (:ldp-post 29 30 31 16)
    (:ret)
    ; In: Datums in x0 and, for binary operations, x1.
    ; Out: x0 is the result of the corresponding numeric primitive.
    ; Changes: Volatile set and x24, x26 and x27.
    ; Stack: 16 machine bytes for saves. Allocates: Yes.
    (:label "rt:n-add")
    (:stp-pre 29 30 31 -16)
    (:bl "rt:n-types")
    (:ldp-post 29 30 31 16)
    (:cmp 1 1)
    (:b-cond :eq "rt:num-type-return")
    (:cmp 0 1)
    (:b-cond :eq "rt:num-return-second")
    (:cmp 3 5)
    (:b-cond :eq "rt:c-add")
    (:cmp 3 4)
    (:b-cond :eq "rt:q-add")
    (:b "rt:z-add-op")
    (:label "rt:n-multiply")
    (:stp-pre 29 30 31 -16)
    (:bl "rt:n-types")
    (:ldp-post 29 30 31 16)
    (:cmp 0 1)
    (:b-cond :eq "rt:zero")
    (:cmp 1 1)
    (:b-cond :eq "rt:zero")
    (:cmp 1 3)
    (:b-cond :eq "rt:num-type-return")
    (:cmp 0 3)
    (:b-cond :eq "rt:num-return-second")
    (:cmp 3 5)
    (:b-cond :eq "rt:c-multiply")
    (:cmp 3 4)
    (:b-cond :eq "rt:q-multiply")
    (:b "rt:z-multiply-op")
    (:label "rt:n-negate")
    (:stp-pre 29 30 31 -16)
    (:bl "rt:num-type")
    (:ldp-post 29 30 31 16)
    (:cmp 3 5)
    (:b-cond :eq "rt:c-negate")
    (:cmp 3 4)
    (:b-cond :eq "rt:q-negate")
    (:cbz 3 "rt:zero")
    (:b "rt:z-negate-op")
    (:label "rt:n-reciprocal")
    (:stp-pre 29 30 31 -16)
    (:bl "rt:num-type")
    (:ldp-post 29 30 31 16)
    (:cbz 3 "rt:zero")
    (:cmp 3 5)
    (:b-cond :eq "rt:c-reciprocal")
    (:b "rt:q-reciprocal")
    (:label "rt:n-less")
    (:stp-pre 29 30 31 -16)
    (:bl "rt:n-types")
    (:cmp 3 5)
    (:b-cond :eq "rt:n-less-complex")
    (:bl "rt:q-compare")
    (:b "rt:n-less-result")
    (:label "rt:n-less-complex")
    (:bl "rt:c-compare")
    (:label "rt:n-less-result")
    (:ldp-post 29 30 31 16)
    (:cmp 0 1)
    (:b-cond :lt "rt:true")
    (:b "rt:nil")

    ; In: Rational operands in x0 and x1, with nonnumbers treated as zero.
    ; Out: x0 is tagged -1, 0 or 1 from comparison.
    ; Changes: Volatile set and x24, x26 and x27.
    ; Stack: 16 machine bytes for saves. Allocates: Yes.
    (:label "rt:q-compare")
    (:stp-pre 29 30 31 -16)
    (:bl "rt:n-types")
    (:ldp-post 29 30 31 16)
    (:cmp 3 4)
    (:b-cond :eq "rt:q-compare-products")
    (:b "rt:z-compare")

    ; In: Datums in x0 and x1.
    ; Out: x0 is the canonical complex result. Nonrational parts count
    ; as zero. The imaginary part may be zero, yielding the real part.
    ; Changes: Volatile set and x24, x26 and x27.
    ; Stack: 16 machine bytes for saves. Allocates: Yes.
    (:label "prim:COMMON-LISP::COMPLEX")
    (:stp-pre 29 30 31 -16)
    (:bl "rt:num-type")
    (:cmp 3 5)
    (:csel 3 31 3 :eq)
    (:cmp 3 0)
    (:movz 6 1 0)
    (:csel 6 0 6 :ne)
    (:mov 0 1)
    (:bl "rt:num-type")
    (:cmp 3 5)
    (:csel 3 31 3 :eq)
    (:cmp 3 0)
    (:movz 1 1 0)
    (:csel 1 0 1 :ne)
    (:mov 0 6)
    (:ldp-post 29 30 31 16)
    ; In: The rational real and imaginary parts in x0 and x1 for
    ; rt:c-box, or the reduced numerator and positive denominator for
    ; rt:q-box. rt:num-box-fields also takes the complete header in x2.
    ; Out: x0 is the canonical number. The boxing entries return x0
    ; directly when the imaginary part is zero or denominator is one.
    ; Changes: Volatile set and x24, x26 and x27.
    ; Stack: 16 machine bytes for the header and link. Allocates: Yes.
    (:label "rt:c-box")
    (:cmp 1 1)
    (:b-cond :eq "rt:num-type-return")
    (:movz 2 4101 0)
    (:b "rt:num-box-fields")
    (:label "rt:q-box")
    (:cmp 1 3)
    (:b-cond :eq "rt:num-type-return")
    (:movz 2 4100 0)
    (:label "rt:num-box-fields")
    (:stp-pre 2 30 31 -16)
    (:movz 2 24 0)
    (:bl "rt:z-reserve")
    (:ldp-post 3 30 31 16)
    (:str 3 2 0)
    (:stp 0 1 2 8)
    (:sub-reg 0 2 28 0)
    (:add 0 0 2)
    (:ret)
    ; In: A datum in x1. Out: The same datum in x0.
    ; Changes: None. Stack: None. Allocates: No.
    (:label "rt:num-return-second")
    (:mov 0 1)
    (:ret)

    ; In: Span addresses in x0 and x1 and their common byte length in x2.
    ; Out: x0 is untagged one for equal spans or zero otherwise.
    ; Changes: x1 through x4 and NZCV. Stack: None. Allocates: No.
    (:label "rt:equal-bytes")
    (:cmp 2 8)
    (:b-cond :lo "rt:equal-bytes-tail")
    (:ldr 3 0 0)
    (:ldr 4 1 0)
    (:cmp-reg 3 4)
    (:b-cond :ne "rt:bytes-differ")
    (:add 0 0 8)
    (:add 1 1 8)
    (:sub 2 2 8)
    (:b "rt:equal-bytes")
    (:label "rt:equal-bytes-tail")
    (:cbz 2 "rt:bytes-match")
    (:ldrb 3 0 0)
    (:ldrb 4 1 0)
    (:cmp-reg 3 4)
    (:b-cond :ne "rt:bytes-differ")
    (:add 0 0 1)
    (:add 1 1 1)
    (:sub 2 2 1)
    (:b "rt:equal-bytes-tail")
    ; In: None. Out: x0 is zero at rt:bytes-differ or one at rt:bytes-match.
    ; Changes: None. Stack: None. Allocates: No.
    (:label "rt:bytes-differ")
    (:movz 0 0 0)
    (:ret)
    (:label "rt:bytes-match")
    (:movz 0 1 0)
    (:ret)

    ; In: Datums in x0 and x1. Out: x0 is T if they are equal, else NIL.
    ; Changes: x1 through x12, NZCV and x24.
    ; Stack: Up to 16 machine bytes for saved x25 and link. An
    ; outstanding comparison uses two value words. Allocates: No.
    ; Equal words and equal cars leave no deferred comparison on a list spine.
    (:label "prim:COMMON-LISP::EQUAL")
    (:cmp-reg 0 1)
    (:b-cond :eq "rt:true")
    (:eor-reg 2 0 1)
    (:tst-mask 2 3)
    (:b-cond :ne "rt:nil")
    (:and-mask 2 0 3)
    (:cmp 2 2)
    (:b-cond :eq "rt:equal-enter")
    (:cbnz 2 "rt:nil")
    (:label "rt:equal-enter")
    (:stp-pre 25 30 31 -16)
    (:b "rt:equal-distinct")
    (:label "rt:equal-next")
    (:ldr 7 31 0)
    (:cmp-reg 25 7)
    (:b-cond :eq "rt:equal-yes")
    (:sub 25 25 16)
    (:ldp 0 1 25 0)
    (:label "rt:equal-pair")
    (:cmp-reg 0 1)
    (:b-cond :eq "rt:equal-next")
    (:label "rt:equal-distinct")
    (:eor-reg 2 0 1)
    (:tst-mask 2 3)
    (:b-cond :ne "rt:equal-no")
    (:and-mask 2 0 3)
    (:cbz 2 "rt:equal-cons")
    (:cmp 2 2)
    (:b-cond :ne "rt:equal-no")
    (:sub 0 0 2)
    (:sub 1 1 2)
    (:add-reg 0 28 0 0)
    (:add-reg 1 28 1 0)
    (:ldr 2 0 0)
    (:ldr 3 1 0)
    (:cmp-reg 2 3)
    (:b-cond :ne "rt:equal-no")
    (:and-mask 3 2 8)
    (:cmp 3 2)
    (:b-cond :eq "rt:equal-no")
    (:add 0 0 8)
    (:add 1 1 8)
    (:cmp 3 4)
    (:b-cond :lo "rt:equal-byte-span")
    (:cmp 3 6)
    (:b-cond :eq "rt:equal-vector")
    (:b "rt:equal-fields")
    (:label "rt:equal-byte-span")
    (:lsr 2 2 8)
    (:bl "rt:equal-bytes")
    (:cbz 0 "rt:equal-no")
    (:b "rt:equal-next")
    (:label "rt:equal-cons")
    (:add-reg 0 28 0 0)
    (:add-reg 1 28 1 0)
    (:label "rt:equal-fields")
    (:ldp 0 2 0 0)
    (:ldp 1 3 1 0)
    (:cmp-reg 0 1)
    (:b-cond :eq "rt:equal-second")
    (:cmp-reg 2 3)
    (:b-cond :eq "rt:equal-distinct")
    (:add 8 25 16)
    (:bl "rt:ensure-stack")
    (:stp 2 3 25 0)
    (:add 25 25 16)
    (:b "rt:equal-distinct")
    (:label "rt:equal-second")
    (:mov 0 2)
    (:mov 1 3)
    (:b "rt:equal-pair")
    (:label "rt:equal-vector")
    (:lsr 7 2 8)
    (:cbz 7 "rt:equal-next")
    (:mov 5 0)
    (:mov 6 1)
    (:label "rt:equal-vector-word")
    (:sub 7 7 8)
    (:ldr-reg 0 5 7)
    (:ldr-reg 1 6 7)
    (:cmp-reg 0 1)
    (:b-cond :eq "rt:equal-vector-loop")
    (:add 8 25 16)
    (:bl "rt:ensure-stack")
    (:stp 0 1 25 0)
    (:add 25 25 16)
    (:label "rt:equal-vector-loop")
    (:cbnz 7 "rt:equal-vector-word")
    (:b "rt:equal-next")
    (:label "rt:equal-yes")
    (:ldp-post 25 30 31 16)
    (:b "rt:true")
    (:label "rt:equal-no")
    (:ldp-post 25 30 31 16)
    (:b "rt:nil"))
   (runtime-integer-code)
   (runtime-division-code)
   (runtime-bit-code)
   (runtime-rational-code)))

(defun runtime-sequence-code ()
  '(; In: A datum in x0. Out: String payload address and byte length
    ; in x1 and x2, or two zeros if the datum is not a string.
    ; Changes: x3 and NZCV. Stack: None. Allocates: No.
    (:label "rt:string-view")
    (:and-mask 3 0 3)
    (:cmp 3 2)
    (:b-cond :ne "rt:no-string")
    (:sub 1 0 2)
    (:add-reg 1 28 1 0)
    (:ldr 2 1 0)
    (:and-mask 3 2 8)
    (:cmp 3 1)
    (:b-cond :ne "rt:no-string")
    (:lsr 2 2 8)
    (:add 1 1 8)
    (:ret)
    (:label "rt:no-string")
    (:movz 1 0 0)
    (:movz 2 0 0)
    (:ret)

    ; In: A byte length in x0 for rt:new-string. rt:empty-string takes no input.
    ; Out: String datum, payload address and byte length in x0, x1 and x2.
    ; The header and padding are initialized. The caller fills the payload.
    ; Changes: Volatile set and x26 through x27.
    ; Stack: 16 machine bytes for the length and link on the small-string
    ; path. Allocates: Yes.
    (:label "rt:new-string")
    (:lsr 1 0 18)
    (:cbnz 1 "rt:new-large-string")
    (:stp-pre 0 30 31 -16)
    (:adds 1 0 15)
    (:b-cond :hs "rt:datum-size")
    (:lsr 0 1 3)
    (:lsl 0 0 3)
    (:bl "rt:alloc")
    (:ldp-post 2 30 31 16)
    (:lsl 3 2 8)
    (:add 3 3 1)
    (:str 3 0 0)
    (:add 1 0 8)
    (:sub-reg 0 0 28 0)
    (:add 0 0 2)
    (:tst-mask 2 3)
    (:b-cond :eq "rt:string-made")
    (:lsr 3 2 3)
    (:lsl 3 3 3)
    (:str-reg 31 1 3)
    (:label "rt:string-made")
    (:ret)
    (:label "rt:empty-string")
    (:movz 0 0 0)
    (:b "rt:new-string")

    ; In: A source datum in x0 and result-type datum in x1.
    ; Out: x0 is the result. COMMON-LISP::LIST selects a list of
    ; characters from a string. Other result types select a string
    ; from a list, using byte zero for noncharacters.
    ; Changes: Volatile set and x24, x26 and x27.
    ; Stack: Up to 16 machine bytes for saves and one value word for
    ; the source over allocation. Allocates: Yes.
    ; The package number of the symbol NIL identifies COMMON-LISP.
    (:label "prim:COMMON-LISP::COERCE")
    (:and-mask 2 1 3)
    (:cmp 2 2)
    (:b-cond :ne "rt:coerce-to-string")
    (:sub 1 1 2)
    (:add-reg 1 28 1 0)
    (:ldrb 2 1 0)
    (:cmp 2 2)
    (:b-cond :ne "rt:coerce-to-string")
    (:ldr 2 1 16)
    (:ldr 3 28 48)
    (:cmp-reg 2 3)
    (:b-cond :ne "rt:coerce-to-string")
    (:ldr 1 1 8)
    (:sub 1 1 2)
    (:add-reg 1 28 1 0)
    (:ldr 2 1 0)
    (:cmp 2 1025)
    (:b-cond :ne "rt:coerce-to-string")
    (:ldr 2 1 8)
    (:and-mask 2 2 32)
    (:movz 3 18764 0)
    (:movk 3 21587 16)
    (:cmp-reg 2 3)
    (:b-cond :ne "rt:coerce-to-string")

    ; Reserve all the conses at once and walk the bytes from the end.
    (:stp-pre 29 30 31 -16)
    (:bl "rt:string-view")
    (:cbz 2 "rt:coerce-no-list")
    (:add 8 25 8)
    (:bl "rt:ensure-stack")
    (:str 0 25 0)
    (:add 25 25 8)
    (:lsl 0 2 4)
    (:bl "rt:alloc-cells")
    (:mov 5 0)
    (:sub 25 25 8)
    (:ldr 0 25 0)
    (:bl "rt:string-view")
    (:movz 0 34 0)
    (:label "rt:coerce-list-loop")
    (:sub 2 2 1)
    (:ldrb-reg 3 1 2)
    (:lsl 3 3 3)
    (:add 3 3 4)
    (:stp 3 0 5 0)
    (:sub-reg 0 5 28 0)
    (:add 5 5 16)
    (:cbnz 2 "rt:coerce-list-loop")
    (:ldp-post 29 30 31 16)
    (:ret)
    (:label "rt:coerce-no-list")
    (:ldp-post 29 30 31 16)
    (:b "rt:nil")

    ; The cons count is obtained without copying the list. After
    ; allocation the saved list is read again and its bytes are filled.
    (:label "rt:coerce-to-string")
    (:tst-mask 0 3)
    (:b-cond :ne "rt:empty-string")
    (:stp-pre 29 30 31 -16)
    (:bl "rt:list-length")
    (:add 8 25 8)
    (:bl "rt:ensure-stack")
    (:str 0 25 0)
    (:add 25 25 8)
    (:mov 0 2)
    (:bl "rt:new-string")
    (:sub 25 25 8)
    (:ldr 4 25 0)
    (:label "rt:coerce-string-loop")
    (:add-reg 4 28 4 0)
    (:ldp 3 4 4 0)
    (:and-mask 5 3 3)
    (:cmp 5 4)
    (:lsr 3 3 3)
    (:csel 3 3 31 :eq)
    (:strb 3 1 0)
    (:add 1 1 1)
    (:subs 2 2 1)
    (:b-cond :ne "rt:coerce-string-loop")
    (:ldp-post 29 30 31 16)
    (:ret)

    ; In: A datum in x0. Out: The untagged count of consecutive conses in
    ; x2. x0 retains the original datum.
    ; Changes: x3 and NZCV. Stack: None. Allocates: No.
    (:label "rt:list-length")
    (:movz 2 0 0)
    (:mov 3 0)
    (:label "rt:list-length-loop")
    (:tst-mask 3 3)
    (:b-cond :ne "rt:list-length-done")
    (:add 3 3 8)
    (:ldr-reg 3 28 3)
    (:add 2 2 1)
    (:b "rt:list-length-loop")
    (:label "rt:list-length-done")
    (:ret)
    ; In: A datum in x0. Out: x0 is the tagged byte length of a string
    ; or the tagged count of consecutive conses.
    ; Changes: x1 through x3 and NZCV. Stack: 16 machine bytes for saves.
    ; Allocates: No.
    (:label "jet:COMMON-LISP::LENGTH")
    (:stp-pre 29 30 31 -16)
    (:bl "rt:string-view")
    (:cbnz 1 "rt:length-tag")
    (:bl "rt:list-length")
    (:label "rt:length-tag")
    (:lsl 0 2 1)
    (:add 0 0 1)
    (:ldp-post 29 30 31 16)
    (:ret)

    ; In: A datum in x0. Out: x0 is its untagged value for a positive
    ; immediate, 2^32 for a positive boxed integer, or zero otherwise.
    ; Changes: x3, x4 and NZCV. Stack: None. Allocates: No.
    (:label "rt:sequence-count")
    (:tst-mask 0 1)
    (:b-cond :ne "rt:sequence-count-immediate")
    (:and-mask 3 0 3)
    (:cmp 3 2)
    (:b-cond :ne "rt:sequence-count-zero")
    (:sub 4 0 2)
    (:add-reg 4 28 4 0)
    (:ldrb 3 4 0)
    (:cmp 3 3)
    (:b-cond :ne "rt:sequence-count-zero")
    (:ldr 3 4 8)
    (:cbnz 3 "rt:sequence-count-zero")
    (:movz 0 1 32)
    (:ret)
    (:label "rt:sequence-count-immediate")
    (:asr 0 0 1)
    (:cmp 0 0)
    (:csel 0 0 31 :gt)
    (:ret)
    (:label "rt:sequence-count-zero")
    (:movz 0 0 0)
    (:ret)

    ; In: Source datum in x0 and index datum in x1.
    ; Out: The character at the fixed index in x0, or NIL for an
    ; out-of-range position or a non-string. Index fixing uses rt:sequence-count.
    ; Changes: x1 through x5 and NZCV. Stack: 16 machine bytes for saves.
    ; Allocates: No.
    (:label "jet:COMMON-LISP::CHAR")
    (:stp-pre 29 30 31 -16)
    (:mov 5 1)
    (:bl "rt:string-view")
    (:cbz 1 "rt:char-nil")
    (:mov 0 5)
    (:bl "rt:sequence-count")
    (:cmp-reg 0 2)
    (:b-cond :hs "rt:char-nil")
    (:ldrb-reg 0 1 0)
    (:lsl 0 0 3)
    (:add 0 0 4)
    (:ldp-post 29 30 31 16)
    (:ret)
    (:label "rt:char-nil")
    (:ldp-post 29 30 31 16)
    (:b "rt:nil")

    ; In: Sequence, start and end datums in x0, x1 and x2.
    ; Out: Result sequence in x0, padded with zero bytes for a string
    ; or NIL elements for a list when the request extends past the source.
    ; Changes: Volatile set and x24, x26 and x27. Stack: 32 machine bytes
    ; for saves and up to two value words for source and end roots.
    ; Allocates: Yes.
    ; The counts are the positive integers in START and END-START.
    ; The subtraction uses numeric fixing, and a NIL end gives LENGTH.
    (:label "jet:COMMON-LISP::SUBSEQ")
    (:stp-pre 19 20 31 -16)
    (:stp-pre 21 30 31 -16)
    (:mov 5 0)
    (:mov 6 1)
    (:mov 7 2)
    (:bl "rt:string-view")
    (:cmp 1 0)
    (:cset 21 :ne)
    (:cmp 7 34)
    (:b-cond :ne "rt:subseq-end-ready")
    (:cbnz 21 "rt:subseq-tag-length")
    (:bl "rt:list-length")
    (:label "rt:subseq-tag-length")
    (:lsl 7 2 1)
    (:add 7 7 1)
    (:label "rt:subseq-end-ready")
    (:and-reg 0 6 7)
    (:tst-mask 0 1)
    (:b-cond :eq "rt:subseq-numeric")
    (:asr 6 6 1)
    (:asr 7 7 1)
    (:cmp 6 0)
    (:csel 20 6 31 :gt)
    (:subs-reg 19 7 6 0)
    (:csel 19 19 31 :gt)
    (:mov 0 5)
    (:b "rt:subseq-checked")
    (:label "rt:subseq-numeric")
    (:add 8 25 16)
    (:bl "rt:ensure-stack")
    (:stp 5 7 25 0)
    (:add 25 25 16)
    (:mov 0 6)
    (:bl "rt:sequence-count")
    (:mov 20 0)
    (:mov 0 6)
    (:bl "prim:ACL2::UNARY--")
    (:mov 1 0)
    (:sub 2 25 8)
    (:ldr 0 2 0)
    (:bl "prim:ACL2::BINARY-+")
    (:bl "rt:sequence-count")
    (:mov 19 0)
    (:sub 25 25 16)
    (:ldr 0 25 0)
    (:label "rt:subseq-checked")
    (:movz 1 1 32)
    (:cmp-reg 19 1)
    (:b-cond :hs "rt:datum-size")
    (:cbz 21 "rt:subseq-list")

    ; The string root is reloaded after allocating its result. The
    ; remaining bytes beyond the end of the source are filled with zero.
    (:add 8 25 8)
    (:bl "rt:ensure-stack")
    (:str 0 25 0)
    (:add 25 25 8)
    (:mov 0 19)
    (:bl "rt:new-string")
    (:mov 6 0)
    (:mov 7 1)
    (:sub 25 25 8)
    (:ldr 0 25 0)
    (:bl "rt:string-view")
    ; Copy the intersection of the slice with the source before padding.
    (:subs-reg 4 2 20 0)
    (:csel 4 4 31 :hi)
    (:cmp-reg 4 19)
    (:csel 4 4 19 :ls)
    (:add-reg 1 1 20 0)
    (:lsr 3 4 4)
    (:cbz 3 "rt:subseq-copy-tail")
    (:label "rt:subseq-copy-blocks")
    (:ldp-post 2 5 1 16)
    (:stp 2 5 7 0)
    (:add 7 7 16)
    (:subs 3 3 1)
    (:b-cond :ne "rt:subseq-copy-blocks")
    (:label "rt:subseq-copy-tail")
    (:and-mask 3 4 4)
    (:cbz 3 "rt:subseq-pad")
    (:label "rt:subseq-copy-bytes")
    (:ldrb 2 1 0)
    (:strb 2 7 0)
    (:add 1 1 1)
    (:add 7 7 1)
    (:subs 3 3 1)
    (:b-cond :ne "rt:subseq-copy-bytes")
    (:label "rt:subseq-pad")
    ; Large strings have a fresh mapping. Its unused bytes read as zero.
    (:lsr 3 19 18)
    (:cbnz 3 "rt:subseq-string-done")
    (:sub-reg 5 19 4 0)
    (:lsr 3 5 4)
    (:cbz 3 "rt:subseq-pad-tail")
    (:label "rt:subseq-pad-blocks")
    (:stp 31 31 7 0)
    (:add 7 7 16)
    (:subs 3 3 1)
    (:b-cond :ne "rt:subseq-pad-blocks")
    (:label "rt:subseq-pad-tail")
    (:and-mask 3 5 4)
    (:cbz 3 "rt:subseq-string-done")
    (:label "rt:subseq-pad-bytes")
    (:strb 31 7 0)
    (:add 7 7 1)
    (:subs 3 3 1)
    (:b-cond :ne "rt:subseq-pad-bytes")
    (:label "rt:subseq-string-done")
    (:mov 0 6)
    (:b "rt:subseq-return")

