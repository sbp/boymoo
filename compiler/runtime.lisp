     (:movz 3 58 0)
     (:strb 3 0 0)
     (:strb 3 0 1)
     (:add 0 0 2)
     (:mov 5 21)
     (:movz 3 0 0)
     (:bl "rt:print-part")
     (:b "rt:stop-datum-ready")
     (:label "rt:print-string")
     (:mov 0 22)
     (:mov 5 21)
     (:movz 3 34 0)
     (:bl "rt:print-part")
     (:label "rt:stop-datum-ready")
     (:cmp-reg 0 20)
     (:b-cond :lo "rt:stop-datum-write")
     (:sub 0 20 1)
     (:movz 3 32 0)
     (:strb 3 0 0)
     (:movz 3 46 0)
     (:strb 3 0 1)
     (:strb 3 0 2)
     (:strb 3 0 3)
     (:add 0 0 4)
     (:label "rt:stop-datum-write")
     (:sub-reg 2 0 19 0)
     (:mov 1 19)
     (:movz 0 1 0)
     (:b "rt:stop")

     ; In: Destination cursor in x0, limit in x20 with room for two
