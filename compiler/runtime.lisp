    ; of conses whose last cdr is NIL, including any padding elements.
    (:label "rt:subseq-list")
    (:cbz 19 "rt:subseq-nil")
    (:lsr 1 19 60)
    (:cbnz 1 "rt:datum-size")
    (:label "rt:subseq-drop")
    (:cbz 20 "rt:subseq-list-allocate")
    (:tst-mask 0 3)
    (:b-cond :ne "rt:subseq-list-allocate")
    (:add 0 0 8)
    (:ldr-reg 0 28 0)
    (:sub 20 20 1)
    (:b "rt:subseq-drop")
    (:label "rt:subseq-list-allocate")
    (:add 8 25 8)
    (:bl "rt:ensure-stack")
    (:str 0 25 0)
    (:add 25 25 8)
    (:lsl 0 19 4)
    (:bl "rt:alloc-cells")
    (:mov 1 0)
    (:sub-reg 0 0 28 0)
    (:sub 25 25 8)
    (:ldr 2 25 0)
    (:movz 5 34 0)
    (:label "rt:subseq-list-fill")
    (:mov 3 5)
    (:tst-mask 2 3)
    (:b-cond :ne "rt:subseq-list-store")
    (:add-reg 2 28 2 0)
    (:ldp 3 2 2 0)
    (:label "rt:subseq-list-store")
    (:add 1 1 16)
    (:sub-reg 4 1 28 0)
    (:subs 19 19 1)
    (:csel 4 5 4 :eq)
    (:stp 3 4 1 -16)
    (:b-cond :ne "rt:subseq-list-fill")
    (:b "rt:subseq-return")
    (:label "rt:subseq-nil")
    (:movz 0 34 0)
    (:label "rt:subseq-return")
    (:ldp-post 21 30 31 16)
    (:ldp-post 19 20 31 16)
    (:ret)

    ; In: Datums in x0 and x1. Out: Integer result in x0, the first
    ; integer shifted by the second. Nonintegers count as zero.
    ; Changes: Volatile set and x24, x26 and x27. Stack: None locally.
    ; Allocates: Yes.
    ; On immediate operands the machine shift is sufficient when
    ; shifting the doubled integer back recovers its original bits.
    (:label "jet:COMMON-LISP::ASH")
    (:cmp 0 1)
    (:b-cond :eq "rt:num-type-return")
    (:and-reg 2 0 1)
    (:tst-mask 2 1)
    (:b-cond :eq "rt:n-ash")
    (:asr 2 1 1)
    (:cmp 2 0)
    (:b-cond :lt "rt:ash-right")
    (:cmp 2 62)
    (:b-cond :gt "rt:n-ash")
    (:sub 3 0 1)
    (:lslv 4 3 2)
    (:asrv 5 4 2)
    (:cmp-reg 5 3)
    (:b-cond :ne "rt:n-ash")
    (:add 0 4 1)
    (:ret)
    (:label "rt:ash-right")
    (:neg 2 2)
    (:movz 3 63 0)
    (:cmp-reg 2 3)
    (:csel 2 2 3 :ls)
    (:asrv 0 0 2)
    (:lsr 0 0 1)
    (:lsl 0 0 1)
    (:add 0 0 1)
    (:ret)
    ; In: Datums in x0 and x1. Out: Integer XOR in x0.
    ; Nonintegers count as zero. Changes: Volatile set and x24, x26
    ; and x27. Stack: None locally. Allocates: Yes.
    (:label "jet:ACL2::BINARY-LOGXOR")
    (:and-reg 2 0 1)
    (:tst-mask 2 1)
    (:b-cond :eq "rt:z-xor-op")
    (:eor-reg 0 0 1)
    (:add 0 0 1)
    (:ret)))


(defun runtime-symbol-code ()
  '(; In: A datum in x0. Out: Symbol header address in x1, or zero.
    ; Changes: x2 and NZCV. Stack: None. Allocates: No.
    (:label "rt:symbol-view")
    (:and-mask 2 0 3)
    (:cmp 2 2)
    (:b-cond :ne "rt:no-symbol")
    (:sub 1 0 2)
    (:add-reg 1 28 1 0)
    (:ldrb 2 1 0)
    (:cmp 2 2)
    (:b-cond :eq "rt:symbol-view-done")
    (:label "rt:no-symbol")
    (:movz 1 0 0)
    (:label "rt:symbol-view-done")
    (:ret)
    ; In: A datum in x0. Out: The symbol's name in x0, or an empty string.
    ; Changes: Volatile set and x26 through x27 on the empty-string path.
    ; Stack: 16 machine bytes for saves. Allocates: Yes.
    (:label "prim:COMMON-LISP::SYMBOL-NAME")
    (:stp-pre 29 30 31 -16)
    (:bl "rt:symbol-view")
    (:ldp-post 29 30 31 16)
    (:cbz 1 "rt:empty-string")
    (:ldr 0 1 8)
    (:ret)

    ; In: A valid tagged package number in x0.
    ; Out: The address of its package vector in x0.
    ; Changes: x1. Stack: None. Allocates: No.
    (:label "rt:package-row")
    (:ldr 1 28 8)
    (:add 1 1 6)
    (:add-reg 1 28 1 0)
    (:lsr 0 0 1)
    (:add-reg 1 1 0 3)
    (:ldr 0 1 0)
    (:sub 0 0 2)
    (:add-reg 0 28 0 0)
    (:ret)
    ; In: A datum in x0. Out: The name of the symbol's package in x0,
    ; or an empty string for a nonsymbol. Stops for a hidden package.
    ; Changes: Volatile set and x26 through x27 on the empty-string path.
    ; Stack: 16 machine bytes for saves. Allocates: Yes.
    (:label "prim:ACL2::SYMBOL-PACKAGE-NAME")
    (:stp-pre 29 30 31 -16)
    (:bl "rt:symbol-view")
    (:cbz 1 "rt:package-name-empty")
    (:mov 5 0)
    (:ldr 0 1 16)
    (:bl "rt:package-row")
    (:ldp-post 29 30 31 16)
    (:ldr 1 0 24)
    (:cmp 1 34)
    (:b-cond :eq "rt:package-name-hidden")
    (:ldr 0 0 8)
    (:ret)
    (:label "rt:package-name-empty")
    (:ldp-post 29 30 31 16)
    (:b "rt:empty-string")
    (:label "rt:package-name-hidden")
    (:mov 0 5)
    (:b "rt:hidden-symbol")

    ; In: Name address in x1 and byte length in x2.
    ; Out: The matching package vector address in x0, or zero.
    ; Changes: x1 through x9 and NZCV. Stack: 16 machine bytes for saves.
    ; Allocates: No.
    (:label "rt:find-package")
    (:stp-pre 29 30 31 -16)
    (:mov 5 1)
    (:mov 6 2)
    (:ldr 7 28 8)
    (:sub 7 7 2)
    (:add-reg 7 28 7 0)
    (:ldr 8 7 0)
    (:lsr 8 8 8)
    (:add 7 7 8)
    (:add-reg 8 7 8 0)
    (:label "rt:find-package-loop")
    (:cmp-reg 7 8)
    (:b-cond :hs "rt:find-package-miss")
    (:ldr 9 7 0)
    (:add 7 7 8)
    (:sub 9 9 2)
    (:add-reg 9 28 9 0)
    (:ldr 0 9 8)
    (:sub 0 0 2)
    (:add-reg 0 28 0 0)
    (:ldr 2 0 0)
    (:lsr 2 2 8)
    (:cmp-reg 2 6)
    (:b-cond :ne "rt:find-package-loop")
    (:add 0 0 8)
    (:mov 1 5)
    (:bl "rt:equal-bytes")
    (:cbz 0 "rt:find-package-loop")
    (:mov 0 9)
    (:ldp-post 29 30 31 16)
    (:ret)
    (:label "rt:find-package-miss")
    (:movz 0 0 0)
    (:ldp-post 29 30 31 16)
    (:ret)

    ; In: A datum in x0. rt:package-query also takes the package vector
    ; field offset in x6, 16 for imports or 24 for the witness.
    ; Out: The requested field in x0, or for a nonstring, NIL for
    ; imports and the ACL2 witness for PKG-WITNESS. Stops for string
    ; names of absent or hidden packages, or for a missing ACL2 default.
    ; Changes: x1 through x9 and NZCV. Stack: 32 machine bytes for
    ; saves, the datum and field offset. Allocates: No.
    (:label "prim:ACL2::PKG-IMPORTS")
    (:movz 6 16 0)
    (:b "rt:package-query")
    (:label "prim:ACL2::PKG-WITNESS")
    (:movz 6 24 0)
    (:label "rt:package-query")
    (:stp-pre 29 30 31 -16)
    (:stp-pre 0 6 31 -16)
    (:bl "rt:string-view")
    (:cbnz 1 "rt:package-query-string")
    (:cmp 6 16)
    (:b-cond :eq "rt:package-query-nil")
    (:adr 1 "rt:acl2-name")
    (:movz 2 4 0)
    (:bl "rt:find-package")
    (:cbz 0 "rt:missing-acl2")
    (:ldr 0 0 24)
    (:b "rt:package-query-return")
    (:label "rt:package-query-nil")
    (:movz 0 34 0)
    (:b "rt:package-query-return")
    (:label "rt:package-query-string")
    (:bl "rt:find-package")
    (:ldp 5 6 31 0)
    (:cbz 0 "rt:package-query-fail")
    (:ldr 1 0 24)
    (:cmp 1 34)
    (:b-cond :eq "rt:package-query-fail")
    (:ldr-reg 0 0 6)
    (:label "rt:package-query-return")
    (:add 31 31 16)
    (:ldp-post 29 30 31 16)
    (:ret)
    (:label "rt:package-query-fail")
    (:mov 0 5)
    (:cmp 6 16)
    (:b-cond :eq "rt:imports-absent")
    (:b "rt:witness-absent")

    ; In: Name datum in x0 and package-designating datum in x1.
    ; Out: The interned symbol in x0, or NIL unless x0 was a string
    ; and x1 was a symbol.
    ; Changes: Volatile set and x24, x26 and x27 if allocation is
    ; required. May replace the dynamic table root at x28 + 24 or
    ; update its buckets and entry count.
    ; Stack: 48 machine bytes for saves and one value word for the
    ; name over allocation. Allocates: Yes.
    ; Search the static table first so that imports resolve through
    ; their keys. The dynamic table holds symbols of the key's package.
    (:label "prim:ACL2::INTERN-IN-PACKAGE-OF-SYMBOL")
    (:stp-pre 19 20 31 -16)
    (:stp-pre 21 22 31 -16)
    (:stp-pre 29 30 31 -16)
    (:mov 19 0)
    (:mov 0 1)
    (:bl "rt:symbol-view")
    (:cbz 1 "rt:intern-nil")
    (:ldr 20 1 16)
    (:mov 0 19)
    (:bl "rt:string-view")
    (:cbz 1 "rt:intern-nil")
    (:mov 21 2)
    (:mov 8 1)
    (:movz 3 0 0)
    (:movz 4 0 0)
    (:label "rt:intern-hash")
    (:cmp-reg 4 21)
    (:b-cond :hs "rt:intern-bucket")
    (:ldrb-reg 5 8 4)
    (:add-reg 3 3 3 5)
    (:add-reg 3 3 5 0)
    (:add 4 4 1)
    (:b "rt:intern-hash")
    (:label "rt:intern-bucket")
    (:lsr 4 20 1)
    (:movz 5 7919 0)
    (:mul 4 4 5)
    (:add-reg 3 3 4 0)
    (:lsl 9 3 1)
    (:add 9 9 1)
    (:and-mask 3 3 12)
    (:ldr 4 28 16)
    (:add 4 4 6)
    (:add-reg 4 28 4 0)
    (:add-reg 4 4 3 3)
    (:ldr 22 4 0)
    (:label "rt:intern-static")
    (:cmp 22 34)
    (:b-cond :eq "rt:intern-dynamic-start")
    (:add-reg 4 28 22 0)
    (:ldp 4 22 4 0)
    (:add-reg 4 28 4 0)
    (:ldp 6 5 4 0)
    (:add-reg 6 28 6 0)
    (:ldp 4 0 6 0)
    (:cmp-reg 4 20)
    (:b-cond :ne "rt:intern-static")
    (:bl "rt:intern-name-equal")
    (:cbz 0 "rt:intern-static")
    (:mov 0 5)
    (:b "rt:intern-return")
    (:label "rt:intern-dynamic-start")
    (:ldr 1 28 24)
    (:cmp 1 34)
    (:b-cond :eq "rt:intern-create")
    (:sub 1 1 2)
    (:add-reg 1 28 1 0)
    (:bl "rt:intern-bucket-address")
    (:ldr 22 4 0)
    (:label "rt:intern-dynamic")
    (:cmp 22 34)
    (:b-cond :eq "rt:intern-create")
    (:add 4 22 6)
    (:add-reg 4 28 4 0)
    (:ldp 5 6 4 0)
    (:ldr 22 4 16)
    (:cmp-reg 6 9)
    (:b-cond :ne "rt:intern-dynamic")
    (:add 4 5 6)
    (:add-reg 4 28 4 0)
    (:ldp 0 6 4 0)
    (:cmp-reg 6 20)
    (:b-cond :ne "rt:intern-dynamic")
    (:bl "rt:intern-name-equal")
    (:cbz 0 "rt:intern-dynamic")
    (:mov 0 5)
    (:b "rt:intern-return")

    ; Keep the name on the value stack during growth and allocation.
    ; The symbol and entry are allocated together and linked into
    ; the current table before another allocation can collect them.
    (:label "rt:intern-create")
    (:mov 22 9)
    (:add 8 25 8)
    (:bl "rt:ensure-stack")
    (:str 19 25 0)
    (:add 25 25 8)
    (:movz 0 0 0)
    (:ldr 1 28 24)
    (:cmp 1 34)
    (:b-cond :eq "rt:intern-grow")
    (:sub 1 1 2)
    (:add-reg 1 28 1 0)
    (:ldp 0 2 1 0)
    (:lsr 0 0 11)
    (:sub 0 0 1)
    (:lsr 2 2 1)
    (:cmp-reg 2 0)
    (:b-cond :lo "rt:intern-allocate")
    (:label "rt:intern-grow")
    (:bl "rt:intern-grow-table")
    (:label "rt:intern-allocate")
    (:movz 0 56 0)
    (:bl "rt:alloc")
    (:sub 25 25 8)
    (:ldr 1 25 0)
    (:movz 2 4098 0)
    (:str 2 0 0)
    (:stp 1 20 0 8)
    (:sub-reg 5 0 28 0)
    (:add 5 5 2)
    (:add 0 0 24)
    (:movz 2 6150 0)
    (:str 2 0 0)
    (:stp 5 22 0 8)
    (:ldr 1 28 24)
    (:sub 1 1 2)
    (:add-reg 1 28 1 0)
    (:mov 9 22)
    (:bl "rt:intern-bucket-address")
    (:ldr 3 4 0)
    (:str 3 0 24)
    (:sub-reg 3 0 28 0)
    (:add 3 3 2)
    (:str 3 4 0)
    (:sub 6 28 128)
    (:ldr 7 6 112)
    (:movz 8 1 0)
    (:orr-reg 7 7 8)
    (:str 7 6 112)
    (:ldr 3 1 8)
    (:add 3 3 2)
    (:str 3 1 8)
    (:mov 0 5)
    (:b "rt:intern-return")
    (:label "rt:intern-nil")
    (:movz 0 34 0)
    (:label "rt:intern-return")
    (:ldp-post 29 30 31 16)
    (:ldp-post 21 22 31 16)
    (:ldp-post 19 20 31 16)
    (:ret)

    ; In: Candidate string datum in x0, name span in x8 and length in x21.
    ; Out: x0 is untagged one for equal strings or zero otherwise.
    ; Changes: x1 through x4 and NZCV. Stack: None. Allocates: No.
    (:label "rt:intern-name-equal")
    (:sub 0 0 2)
    (:add-reg 0 28 0 0)
    (:ldr 2 0 0)
    (:lsr 2 2 8)
    (:cmp-reg 2 21)
    (:b-cond :ne "rt:bytes-differ")
    (:add 0 0 8)
    (:mov 1 8)
    (:b "rt:equal-bytes")

    ; In: The table vector address in x1 and the tagged hash in x9.
    ; Out: x4 is the address of the bucket head word.
    ; Changes: x3. Stack: None. Allocates: No.
    ; The table vector holds a tagged entry count followed by the bucket
    ; heads. Each entry vector holds a symbol, tagged hash and next entry.
    (:label "rt:intern-bucket-address")
    (:ldr 3 1 0)
    (:lsr 3 3 11)
    (:sub 3 3 2)
    (:lsr 4 9 1)
    (:and-reg 4 4 3)
    (:add-reg 4 1 4 3)
    (:add 4 4 16)
    (:ret)

    ; In: The old bucket count in x0, zero when the table root is NIL.
    ; Out: Publishes a table with sixteen buckets or twice the old count
    ; at x28 + 24. Relinks the old entries in the new buckets by cached hash.
    ; Changes: Volatile set and x26 through x27. Stack: 16 machine bytes
    ; for the new size and link. Allocates: Yes.
    (:label "rt:intern-grow-table")
    (:lsl 2 0 1)
    (:movz 3 16 0)
    (:cmp 0 0)
    (:csel 2 3 2 :eq)
    (:lsl 2 2 3)
    (:stp-pre 2 30 31 -16)
    (:add 0 2 16)
    (:bl "rt:alloc")
    (:mov 1 0)
    (:ldr 2 31 0)
    (:add 3 2 8)
    (:lsl 3 3 8)
    (:add 3 3 6)
    (:str 3 1 0)
    (:add 4 1 16)
    (:add-reg 2 4 2 0)
    (:movz 0 34 0)
    (:label "rt:intern-clear-buckets")
    (:str 0 4 0)
    (:add 4 4 8)
    (:cmp-reg 4 2)
    (:b-cond :lo "rt:intern-clear-buckets")
    (:movz 0 1 0)
    (:ldr 2 28 24)
    (:cmp 2 34)
    (:b-cond :eq "rt:intern-grown")
    (:sub 2 2 2)
    (:add-reg 2 28 2 0)
    (:ldp 3 0 2 0)
    (:lsr 3 3 8)
    (:add 7 2 8)
    (:add-reg 7 7 3 0)
    (:add 6 2 16)
    (:label "rt:intern-rehash-bucket")
    (:cmp-reg 6 7)
    (:b-cond :hs "rt:intern-grown")
    (:ldr 5 6 0)
    (:add 6 6 8)
    (:label "rt:intern-rehash-entry")
    (:cmp 5 34)
    (:b-cond :eq "rt:intern-rehash-bucket")
    (:sub 8 5 2)
    (:add-reg 8 28 8 0)
    (:ldp 9 10 8 16)
    (:bl "rt:intern-bucket-address")
    (:ldr 3 4 0)
    (:str 3 8 24)
    (:str 5 4 0)
    (:mov 5 10)
    (:b "rt:intern-rehash-entry")
    (:label "rt:intern-grown")
    (:str 0 1 8)
    (:sub-reg 1 1 28 0)
    (:add 1 1 2)
    (:str 1 28 24)
    (:sub 3 28 128)
    (:movz 4 2 0)
    (:str 4 3 112)
    (:ldp-post 2 30 31 16)
    (:ret)
    (:label "rt:acl2-name")
    (:bytes "ACL2")))

(defun runtime-stop-item (label message-label status message)
  (list (list :label label)
        (list :movz 0 status 0)
        (list :adr 1 message-label)
        (list :movz 2 (length message) 0)
        '(:b "rt:stop")
        (list :label message-label)
        (list :bytes message)))

(defun runtime-stop-with-datum-item (label message-label message)
  (list (list :label label)
        (list :adr 1 message-label)
        (list :movz 2 (length message) 0)
        '(:b "rt:stop-with-datum")
        (list :label message-label)
        (list :bytes message)))

(defun runtime-stop-code ()
  (append
   ; In: None for fixed messages. The other stops take a symbol in x0
   ; for rt:undefined and rt:hidden-symbol, or a string in x0 for
   ; rt:imports-absent and rt:witness-absent.
   ; Out: Writes the diagnostic and exits with its status for a fixed
   ; message or status one for a message that includes a datum.
   ; Changes: No return. Stack: None locally. Allocates: No.
   (runtime-stop-item "rt:number-size" "rt:number-size-message" 3
                      "memory exhausted: a number is too large")
   (runtime-stop-item "rt:memory" "rt:memory-message" 3
                      "memory exhausted: the system refused more")
   (runtime-stop-item "rt:size" "rt:size-message" 3
                      "memory exhausted: a size is too large")
