     (:label "rt:print-part")
     (:sub 5 5 2)
     (:add-reg 1 28 5 0)
     (:ldr 2 1 0)
     (:lsr 2 2 8)
     (:add 1 1 8)
     (:cbnz 3 "rt:print-quoted")
     (:movz 3 124 0)
     (:cbz 2 "rt:print-quoted")
     (:movz 4 0 0)
