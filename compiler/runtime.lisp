; A numeric formula names its runtime calls and their argument slots.
; Slots begin with the inputs and continue with each successive result.
; In: Datum arguments in x0 onward, according to the formula's arity.
; Out: The last step's result in x0.
; Changes: Volatile set and x24, x26 and x27.
; Stack: 16 machine bytes for saves. The local value frame holds the
; arguments and one word per intermediate result, addressed from x19.
; Allocates: Yes if a step allocates.
(defun runtime-formula-arguments (args reg)
  (if (endp args)
      nil
    (cons (list :ldr reg 19 (* 8 (car args)))
          (runtime-formula-arguments (cdr args) (+ 1 reg)))))

(defun runtime-formula-steps (steps)
  (if (endp steps)
      '((:mov 25 19) (:ldp-post 19 30 31 16) (:ret))
    (append (runtime-formula-arguments (cdar steps) 0)
            (list (list :bl (caar steps)))
            (if (endp (cdr steps))
                nil
              '((:str 0 25 0) (:add 25 25 8)))
            (runtime-formula-steps (cdr steps)))))

(defun runtime-number-formula (name arity steps)
  (append (list (list :label name)
                '(:stp-pre 19 30 31 -16)
                '(:mov 19 25)
                (list :add 8 25 (* 8 (+ arity (- (length steps) 1))))
                '(:bl "rt:ensure-stack"))
          (if (equal arity 1)
              '((:str 0 25 0) (:add 25 25 8))
            '((:stp 0 1 25 0) (:add 25 25 16)))
          (runtime-formula-steps steps)))

(defun runtime-number-formulas (formulas)
  (if (endp formulas)
      nil
    (append (runtime-number-formula (caar formulas) (cadar formulas)
                                    (caddar formulas))
            (runtime-number-formulas (cdr formulas)))))

