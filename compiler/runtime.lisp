   '(; In: Descriptor in x0, readable byte span in x1, byte count in x2.
     ; Out: Writes the span, retrying short writes. x0 is zero on success
     ; or one on error.
     ; Changes: Volatile set. Stack: 32 machine bytes for saves.
     ; Allocates: No.
     (:label "rt:write-all")
     (:stp-pre 19 20 31 -16)
     (:stp-pre 21 30 31 -16)
     (:mov 19 0)
     (:mov 20 1)
     (:mov 21 2)
     (:label "rt:write-loop")
     (:cbz 21 "rt:write-done")
     (:mov 0 19)
     (:mov 1 20)
     (:movz 2 16 16)
     (:cmp-reg 21 2)
     (:csel 2 21 2 :ls)
     (:bl "sys:write")
     (:cmp 0 0)
     (:b-cond :le "rt:write-failed")
     (:add-reg 20 20 0 0)
     (:sub-reg 21 21 0 0)
     (:b "rt:write-loop")
     (:label "rt:write-done")
     (:movz 0 0 0)
     (:b "rt:write-return")
     (:label "rt:write-failed")
     (:movz 0 1 0)
     (:label "rt:write-return")
     (:ldp-post 21 30 31 16)
     (:ldp-post 19 20 31 16)
     (:ret)

     ; In: Exit status in x0, readable message span in x1 and byte count in x2.
     ; Out: Writes the message and a newline to descriptor 2, then exits.
     ; Changes: No return. Stack: None locally. Allocates: No.
     (:label "rt:stop")
     (:mov 22 0)
     (:movz 0 2 0)
     (:bl "rt:write-all")
     (:movz 0 2 0)
     (:adr 1 "rt:newline")
     (:movz 2 1 0)
     (:bl "rt:write-all")
     (:mov 0 22)
     (:b "sys:exit")
     (:label "rt:newline")
     (:quad 10)

