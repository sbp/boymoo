     ; adding an ellipsis when the spelling exceeds the limit.
     (:label "rt:stop-with-datum")
     (:mov 21 0)
     (:sub 31 31 2304)
     (:mov-sp 19 31)
     (:mov 0 19)
     (:label "rt:stop-copy-prefix")
     (:cbz 2 "rt:stop-prefix-done")
     (:ldrb 3 1 0)
     (:strb 3 0 0)
     (:add 1 1 1)
     (:add 0 0 1)
     (:sub 2 2 1)
     (:b "rt:stop-copy-prefix")
     (:label "rt:stop-prefix-done")
     (:movz 3 32 0)
     (:strb 3 0 0)
     (:add 22 0 1)
     (:add 20 22 2001)
