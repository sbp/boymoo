(in-package "BOYMOO-COMPILER")

(include-book "a64")

; The heap mapping begins with a page of private runtime state. The last
; 128 bytes of that page hold these words, at offsets from x28 minus 128:
;   0 and 8: the floor and ceiling of the allocation space.
;   16: the lowest address occupied by conses in that space.
;   24 and 32: the floor and ceiling of the other space.
;   40 and 48: the floor and ceiling of the value stack.
;   56: the first separately mapped string.
;   64: the end of the combined heap spaces.
;   72 and 80: bytes mapped for strings since collection and their budget.
;   88 and 96: the old generation's header and cons allocation cursors.
;   104: the old generation's major-collection threshold in bytes.
;   112: flags for intern-table changes. Bit 0 records a bucket write.
;        Bit 1 records changes to entry links during rehashing.
;   120: the nursery bytes used since the last full collection.
; The allocation space is the nursery between collections. Both spaces
; have fixed spans. Between collections their combined allocation fits
; within the capacity of one space. Headers grow from its floor, conses
; grow down from its ceiling, and x26 limits their combined byte count.

; Contracts apply to entry labels. In lists inputs in addition to the
; incoming return address and the runtime state described above. Out
; lists results. Changes bounds the other registers and flags that may
; be overwritten on return. All unlisted registers and flags are preserved
; on return, including x23, x24, x25, x26, x27, x28 and sp. Register
; preservation concerns bits, including when a collection moves data.
; Stack gives local machine-stack bytes and value-stack words, excluding
; space used by callees. Frames are restored on return. A routine may
; read or write its own frame, including saved registers. No incoming
; stack words are accessed except where specified. Allocation can
; collect and rewrite the words from the value-stack base up to x25
; and the symbol-table root. Those value-stack words are initialized
; datums. The volatile set is x0 through x17 and NZCV. Its listed
; clobbers allow for returning system calls and collection.
; Nonreturning paths have no preservation guarantee.

(defun runtime-memory-code ()
  '(; In: The block at data:static and the system's aligned sp.
    ; Out: Exits after passing standard input to rt:entry and writing its result.
    ; Changes: Initializes x23 through x28 and replaces sp.
    ; Stack: 16 machine bytes for reading and one value word for the entry argument.
    ; Allocates: Yes.
    (:label "rt:start")
    (:adr-far 19 "data:static")
    (:ldr 20 19 0)
    ; An odd final static word gives the space size in MiB.
    (:sub 2 20 8)
    (:ldr-reg 22 19 2)
    (:movz 1 4096 0)
    (:tst-mask 22 1)
    (:lsr 22 22 1)
    (:csel 22 22 1 :ne)
    (:lsl 22 22 20)
    (:adds-reg 0 20 22 1)
    (:b-cond :hs "rt:size")
    (:movz 1 2 16)
    (:adds-reg 0 0 1 0)
    (:b-cond :hs "rt:size")
    (:bl "sys:map")
    (:cbz 0 "rt:memory")
    (:movz 1 16384 0)
    (:add-reg 28 0 1 0)
    (:sub 21 28 128)
    (:add-reg 27 28 20 0)
    (:mov 1 28)
    (:label "rt:copy-static")
    (:ldr 2 19 0)
    (:str 2 1 0)
    (:add 19 19 8)
    (:add 1 1 8)
    (:cmp-reg 1 27)
    (:b-cond :lo "rt:copy-static")
    ; Align both spaces to a boundary usable on either system.
    (:movz 1 65535 0)
    (:add-reg 27 27 1 0)
    (:lsr 27 27 16)
    (:lsl 27 27 16)
    (:add-reg 2 27 22 0)
    (:add-reg 3 2 22 0)
    (:stp 27 2 21 0)
    (:stp 2 2 21 16)
    (:str 3 21 32)
    (:str 3 21 64)
    (:stp 2 3 21 88)
    (:movz 4 16 16)
    (:str 4 21 104)

    ; The value stack grows within a reservation. The machine stack has
    ; a margin for calls made by a function while checking its frame.
    (:movz 0 16384 16)
    (:bl "sys:map")
    (:cbz 0 "rt:memory")
    (:mov 25 0)
    (:movz 1 16384 16)
    (:add-reg 1 25 1 0)
    (:stp 25 1 21 40)
    (:movz 1 1 16)
    (:add-reg 24 25 1 0)
    (:movz 0 1024 16)
    (:bl "sys:map")
    (:cbz 0 "rt:memory")
    (:movz 1 1024 16)
    (:add-reg 1 0 1 0)
    (:mov-sp 31 1)
    (:movz 1 16384 0)
    (:add-reg 23 0 1 0)

    ; Read straight into a string mapping. The unused reservation
    ; after the last input page can be unmapped when the size is known.
    (:movz 0 1 32)
    (:movk 0 1 16)
    (:bl "sys:map")
    (:cbz 0 "rt:memory")
    (:add 19 0 32)
    (:movz 20 0 0)
    (:movz 1 1 32)
    (:add-reg 21 19 1 0)
    (:sub 21 21 8)
    (:sub 31 31 16)
    (:label "rt:read-input")
    (:add-reg 1 19 20 0)
    (:sub-reg 2 21 1 0)
    (:mov 22 2)
    (:cbnz 2 "rt:read-chunk")
    (:mov-sp 1 31)
    (:movz 2 1 0)
    (:label "rt:read-chunk")
    (:movz 3 1 16)
    (:cmp-reg 2 3)
    (:csel 2 2 3 :ls)
    (:movz 0 0 0)
    (:bl "sys:read")
    (:cmp 0 0)
    (:b-cond :mi "rt:read-error")
    (:cbz 0 "rt:input-ready")
    (:cbz 22 "rt:datum-size")
    (:add-reg 20 20 0 0)
    (:b "rt:read-input")
    (:label "rt:input-ready")
    (:add 31 31 16)
    (:movz 1 65535 0)
    (:add 21 20 32)
    (:add-reg 21 21 1 0)
    (:lsr 21 21 16)
    (:lsl 21 21 16)
    (:sub 22 19 32)
    (:movz 1 1 32)
    (:movk 1 1 16)
    (:sub-reg 1 1 21 0)
    (:cbz 1 "rt:input-publish")
    (:add-reg 0 22 21 0)
    (:bl "sys:unmap")
    (:cbnz 0 "rt:memory")
    (:label "rt:input-publish")
    (:stp 31 21 22 0)
    (:lsl 0 20 8)
    (:add 0 0 1)
    (:stp 31 0 22 16)
    (:sub 1 28 128)
    (:str 22 1 56)
    (:movz 2 16 16)
    (:cmp-reg 21 2)
    (:csel 2 21 2 :hs)
    (:str 2 1 80)
    (:sub-reg 0 19 28 0)
    (:sub 0 0 6)
    (:str 0 25 0)
    (:add 25 25 8)
    (:movz 1 16 16)
    (:add-reg 26 27 1 0)
    (:bl "rt:entry")

    ; Only a string can be written as the result of the entry function.
    (:and-mask 3 0 3)
    (:cmp 3 2)
    (:b-cond :ne "rt:result-error")
    (:sub 0 0 2)
    (:add-reg 1 28 0 0)
    (:ldrb 3 1 0)
    (:cmp 3 1)
    (:b-cond :ne "rt:result-error")
    (:ldr 2 1 0)
    (:lsr 2 2 8)
    (:add 1 1 8)
    (:movz 0 1 0)
    (:bl "rt:write-all")
    (:cbnz 0 "rt:write-error")
    (:b "sys:exit")

    ; In: Required next-free address in x0 for rt:grow or x8 for
    ; rt:ensure-stack. x24 is the current limit and x25 still bounds the roots.
    ; Out: x24 covers the required address or the routine stops. The
    ; stack base is fixed. Growth uses the larger of the required size
    ; and twice the current size, capped at the end of the reservation.
    ; The doubling does not wrap: the kernel places the reservation far
    ; below 2^63.
    ; Changes: x9 through x12 and NZCV. rt:grow also copies x0 to x8.
    ; Stack: None. Allocates: No.
    ; Callers can keep data, sizes and cursors in x0 through x7 across
    ; either entry, then initialize the reserved words before raising x25.
    (:label "rt:grow")
    (:mov 8 0)
    (:label "rt:ensure-stack")
    (:cmp-reg 8 24)
    (:b-cond :ls "rt:grow-return")
    (:sub 9 28 128)
    (:ldp 10 11 9 40)
    (:cmp-reg 8 11)
    (:b-cond :hi "rt:stack-size")
    (:sub-reg 12 24 10 0)
    (:add-reg 12 10 12 1)
    (:cmp-reg 12 8)
    (:csel 12 12 8 :hs)
    (:cmp-reg 12 11)
    (:csel 24 12 11 :ls)
    (:label "rt:grow-return")
    (:ret)

    ; In: x0 is a byte count, a multiple of eight.
    ; Out: x0 is the start of a contiguous header allocation of that size.
    ; Changes: Volatile set and x26 through x27. The fast path only
    ; changes x1, NZCV and x27 besides the result.
    ; Stack: None locally. Allocates: Yes.
    ; Initialize all fields the collector can read before publishing a
    ; reference or making another allocation.
    (:label "rt:alloc")
    (:adds-reg 1 27 0 0)
    (:b-cond :hs "rt:size")
    (:cmp-reg 1 26)
    (:b-cond :hi "rt:alloc-box-slow")
    (:mov 0 27)
    (:mov 27 1)
    (:ret)
    (:label "rt:alloc-box-slow")
    (:movz 1 0 0)
    (:b "rt:collect")

    ; In: x0 is a byte count, a multiple of sixteen.
    ; Out: x0 is the lowest address of a contiguous cons allocation of that size.
    ; Changes: Volatile set and x26 through x27. The fast path only
    ; changes x1, x2, x9, NZCV and x26 besides the result. It lowers the
    ; next cons address in the runtime state and debits x26 by the byte count.
    ; Stack: None locally. Allocates: Yes.
    ; Initialize the entire run without an intervening allocation.
    (:label "rt:alloc-cells")
    (:sub 9 28 128)
    (:sub-reg 2 26 27 0)
    (:cmp-reg 0 2)
    (:b-cond :hi "rt:alloc-cells-slow")
    (:ldr 1 9 16)
    (:sub-reg 26 26 0 0)
    (:sub-reg 0 1 0 0)
    (:str 0 9 16)
    (:ret)
    (:label "rt:alloc-cells-slow")
    (:movz 1 1 0)

    ; In: The pending byte count in x0 and its kind in x1, zero for
    ; header allocation and one for cons allocation. x25 bounds the roots.
    ; Out: x0 is the pending allocation's address. Copy live nursery
    ; objects into the old space and use a full copy if space is still
    ; needed, the old space has reached its threshold, or the separate
    ; mappings need a sweep. Both generations share a single space's
    ; capacity, so all nursery survivors fit before the full copy.
    ; Changes: The volatile set, x26 and x27. Rewrites roots through
    ; forwarding and releases used pages before reusing a source space.
    ; Stack: 64 machine bytes for saves and the request. Allocates: Yes.
    (:label "rt:collect")
    (:stp-pre 19 20 31 -16)
    (:stp-pre 21 22 31 -16)
    (:stp-pre 29 30 31 -16)
    (:stp-pre 0 1 31 -16)
    (:movz 2 1 32)
    (:cmp-reg 0 2)
    (:b-cond :hi "rt:datum-size")
    (:movz 29 0 0)
    (:sub 17 28 128)
    (:ldp 19 6 17 0)
    (:sub-reg 5 19 28 0)
    (:sub-reg 6 6 28 0)
    (:ldp 20 21 17 88)
    (:mov 8 20)
    (:mov 22 21)
    (:bl "rt:remembered-symbols")
    (:b "rt:collect-trace")

    ; The nursery is empty. Make the old space the source of a full
    ; copy into the former nursery and retain it as the new nursery.
    (:label "rt:collect-major")
    (:ldp 8 9 17 0)
    (:ldp 19 22 17 24)
    (:ldp 27 2 17 88)
    (:stp 19 22 17 0)
    (:sub-reg 5 19 28 0)
    (:sub-reg 6 22 28 0)
    (:str 2 17 16)
    (:stp 8 9 17 24)
    (:movz 29 1 0)
    (:mov 20 8)
    (:mov 21 9)
    (:mov 22 21)
    (:label "rt:collect-trace")
    (:ldr 0 28 24)
    (:bl "rt:forward")
    (:str 0 28 24)
    (:ldr 9 17 40)
    (:label "rt:collect-roots")
    (:cmp-reg 9 25)
    (:b-cond :hs "rt:scan")
    (:ldr 0 9 0)
    (:bl "rt:forward")
    (:str 0 9 0)
    (:add 9 9 8)
    (:b "rt:collect-roots")

    (:label "rt:scan")
    (:cmp-reg 22 21)
    (:b-cond :hi "rt:scan-cons")
    (:cmp-reg 8 20)
    (:b-cond :hs "rt:collect-finish")
    (:ldr 9 8 0)
    (:and-mask 10 9 8)
    (:lsr 9 9 8)
    (:add 9 9 7)
    (:lsr 9 9 3)
    (:add 11 8 8)
    (:add-reg 8 11 9 3)
    (:cmp 10 1)
    (:b-cond :eq "rt:scan")
    (:cmp 10 3)
    (:b-cond :eq "rt:scan")
    (:label "rt:scan-fields")
    (:cmp-reg 11 8)
    (:b-cond :hs "rt:scan")
    (:ldr 0 11 0)
    (:bl "rt:forward")
    (:str 0 11 0)
    (:add 11 11 8)
    (:b "rt:scan-fields")
    (:label "rt:scan-cons")
    (:sub 22 22 16)
    (:ldr 0 22 0)
    (:bl "rt:forward")
    (:str 0 22 0)
    (:ldr 0 22 8)
    (:bl "rt:forward")
    (:str 0 22 8)
    (:b "rt:scan")

    (:label "rt:collect-finish")
    ; Allow a small heap that retained most of its data to grow for
    ; longer between full copies. Otherwise double its live bytes.
    (:cbz 29 "rt:collect-save-cursors")
    (:ldp 2 3 17 24)
    (:sub-reg 4 20 2 0)
    (:sub-reg 5 3 21 0)
    (:add-reg 4 4 5 0)
    (:lsl 7 4 1)
    ; Limit the source space at the next full copy when a large live
    ; heap will require a substantial destination space.
    (:lsr 10 4 27)
    (:cbz 10 "rt:major-small")
    (:lsr 7 4 1)
    (:add-reg 7 7 4 0)
    (:b "rt:major-target")
    (:label "rt:major-small")
    (:lsr 10 4 23)
    (:cbnz 10 "rt:major-target")
    (:lsr 10 4 20)
    (:cbz 10 "rt:major-target")
    (:ldp 8 9 17 0)
    (:sub-reg 8 27 8 0)
    (:ldr 10 17 16)
    (:sub-reg 9 9 10 0)
    (:add-reg 8 8 9 0)
    (:sub-reg 9 8 4 0)
    (:lsr 10 8 3)
    (:cmp-reg 9 10)
    (:add-reg 8 7 4 0)
    (:csel 7 8 7 :ls)
    (:label "rt:major-target")
    (:movz 5 16 16)
    (:cmp-reg 7 5)
    (:csel 7 7 5 :hs)
    (:str 7 17 104)
    (:str 31 17 120)
    (:label "rt:collect-save-cursors")
    (:stp 20 21 17 88)
    (:mov 8 27)
    (:ldp 19 22 17 0)
    (:ldr 20 17 16)
    (:cbnz 29 "rt:collect-release")
    (:sub-reg 2 8 19 0)
    (:sub-reg 3 22 20 0)
    (:ldr 4 17 120)
    (:add-reg 2 2 3 0)
    (:add-reg 4 4 2 0)
    (:str 4 17 120)

    (:label "rt:collect-release")
    (:movz 1 65535 0)
    (:add-reg 1 8 1 0)
    (:lsr 1 1 16)
    (:lsl 1 1 16)
    (:mov 0 19)
    (:bl "rt:release-range")
    (:lsr 0 20 16)
    (:lsl 0 0 16)
    (:mov 1 22)
    (:bl "rt:release-range")
    (:cbz 29 "rt:collect-choose-budget")
    (:bl "rt:sweep-strings")

    (:label "rt:collect-choose-budget")
    (:sub 17 28 128)
    (:ldp 2 3 17 24)
    (:ldp 4 5 17 88)
    (:sub-reg 4 4 2 0)
    (:sub-reg 5 3 5 0)
    (:add-reg 4 4 5 0)
    (:sub-reg 6 3 2 0)
    (:sub-reg 6 6 4 0)
    (:ldr 0 31 0)
    (:cmp-reg 0 6)
    (:b-cond :hi "rt:collect-need-capacity")
    (:cbnz 29 "rt:collect-allocate")
    (:cbz 0 "rt:collect-major")
    ; For a large promoted heap, use only the old-size threshold that
    ; the last full collection set. Keep the extra triggers for smaller
    ; heaps.
    (:lsr 8 4 27)
    (:cbnz 8 "rt:collect-old-limit")
    ; Sweep separate mappings ahead of a large pending allocation
    ; when they already account for a large part of resident memory.
    (:movz 5 16 16)
    (:cmp-reg 0 5)
    (:b-cond :ls "rt:collect-old-limit")
    (:ldr 5 17 80)
    (:lsr 5 5 25)
    (:cbnz 5 "rt:collect-major")
    (:label "rt:collect-old-limit")
    (:ldr 5 17 104)
    (:cmp-reg 4 5)
    (:b-cond :hs "rt:collect-major")
    (:cbnz 8 "rt:collect-allocate")
    ; Bound nursery churn between full sweeps even with few promotions.
    (:ldr 5 17 120)
    (:lsr 5 5 25)
    (:cbnz 5 "rt:collect-major")
    (:b "rt:collect-allocate")
    (:label "rt:collect-need-capacity")
    (:cbnz 29 "rt:heap-size")
    (:b "rt:collect-major")
    (:label "rt:collect-allocate")
    ; Keep 1 MiB for an old generation below 128 MiB. Otherwise use
    ; one eighth of the promoted bytes, up to 32 MiB.
    (:movz 7 16 16)
    (:lsr 8 4 3)
    (:lsr 9 4 27)
    (:cmp 9 0)
    (:csel 7 8 7 :ne)
    (:movz 8 512 16)
    (:cmp-reg 7 8)
    (:csel 7 7 8 :ls)
    (:cmp-reg 7 0)
    (:csel 7 7 0 :hs)
    (:cmp-reg 7 6)
    (:csel 7 7 6 :ls)
    (:ldp 27 22 17 0)
    (:add-reg 26 27 7 0)
    (:str 22 17 16)
    (:ldp-post 0 1 31 16)
    (:ldp-post 29 30 31 16)
    (:ldp-post 21 22 31 16)
    (:ldp-post 19 20 31 16)
    (:cbnz 1 "rt:alloc-cells")
    (:b "rt:alloc")

    ; In: x17 points to runtime state, x19 is the nursery floor, and
    ; x20 and x21 are the old generation's allocation cursors.
    ; Out: Forwards young fields of older intern-table objects before
    ; the ordinary traversal. Interning writes bucket heads. Rehashing
    ; also writes the next entry in each chain. Keep each original next
    ; datum in a register to follow the chain after updating its field.
    ; Changes: x0 through x4, x10 through x16, NZCV and the cursors.
    ; Stack: 16 machine bytes for saves. Allocates: No.
    (:label "rt:remembered-symbols")
    (:ldr 12 17 112)
    (:cbz 12 "rt:remembered-return")
    (:str 31 17 112)
    (:ldr 10 28 24)
    (:cmp 10 34)
    (:b-cond :eq "rt:remembered-return")
    (:stp-pre 29 30 31 -16)
    (:sub 10 10 2)
    (:add-reg 10 28 10 0)
    (:ldr 11 10 0)
    (:lsr 11 11 8)
    (:add-reg 11 10 11 0)
    (:add 11 11 8)
    (:add 13 10 16)
    (:ldr 14 17 8)
    (:cmp-reg 10 19)
    (:cset 15 :lo)
    (:cmp-reg 10 14)
    (:cset 16 :hs)
    (:orr-reg 15 15 16)
    (:label "rt:remembered-bucket")
    (:cmp-reg 13 11)
    (:b-cond :hs "rt:remembered-end")
    (:ldr 0 13 0)
    (:mov 16 0)
    (:cbz 15 "rt:remembered-bucket-next")
    (:bl "rt:forward")
    (:str 0 13 0)
    (:label "rt:remembered-bucket-next")
    (:add 13 13 8)
    (:cmp 12 2)
    (:b-cond :lo "rt:remembered-bucket")
    (:label "rt:remembered-entry")
    (:cmp 16 34)
    (:b-cond :eq "rt:remembered-bucket")
    (:sub 10 16 2)
    (:add-reg 10 28 10 0)
    (:ldr 16 10 24)
    (:cmp-reg 10 19)
    (:b-cond :lo "rt:remembered-entry-old")
    (:cmp-reg 10 14)
    (:b-cond :lo "rt:remembered-entry")
    (:label "rt:remembered-entry-old")
    (:mov 0 16)
    (:bl "rt:forward")
    (:str 0 10 24)
    (:b "rt:remembered-entry")
    (:label "rt:remembered-end")
    (:ldp-post 29 30 31 16)
    (:label "rt:remembered-return")
    (:ret)


    ; In: x0 is a datum. x17 points to runtime state, x19 is the source
    ; space floor, and x20 and x21 are the destination allocation cursors.
    ; X5 and x6 hold the source boundaries as offsets from x28. X29
    ; is zero for a minor collection or one for a full collection.
    ; Out: x0 is the forwarded datum. Data outside the source retain
    ; their values. A full collection marks separate strings it reaches.
    ; Changes: x1 through x4, NZCV and the cursor x20 or x21 when copying.
    ; Stack: None. Allocates: No. Copies only within the collector's space.
    ; A copied cons leaves the unused datum tag 6 and its new datum.
    ; A copied header leaves its new datum with the high bit set.
    (:label "rt:forward")
    (:cmp-reg 0 5)
    (:b-cond :lo "rt:forward-return")
    (:cmp-reg 0 6)
    (:b-cond :hs "rt:forward-foreign")
    (:and-mask 1 0 3)
    (:cbz 1 "rt:forward-pointer")
    (:cmp 1 2)
    (:b-cond :ne "rt:forward-return")
    (:label "rt:forward-pointer")
    (:sub-reg 2 0 1 0)
    (:add-reg 2 28 2 0)
    (:cbnz 1 "rt:forward-box")
    (:ldp 3 4 2 0)
    (:cmp 3 6)
    (:b-cond :eq "rt:forward-cons-seen")
    (:sub 21 21 16)
    (:stp 3 4 21 0)
    (:sub-reg 0 21 28 0)
    (:movz 3 6 0)
    (:stp 3 0 2 0)
    (:ret)
    (:label "rt:forward-cons-seen")
    (:mov 0 4)
    (:ret)
    (:label "rt:forward-foreign")
    (:cbz 29 "rt:forward-return")
    (:and-mask 1 0 3)
    (:cmp 1 2)
    (:b-cond :ne "rt:forward-return")
    (:sub 2 0 2)
    (:add-reg 2 28 2 0)
    (:cmp-reg 2 28)
    (:b-cond :lo "rt:forward-string")
    (:ldr 3 17 64)
    (:cmp-reg 2 3)
    (:b-cond :lo "rt:forward-return")
    (:label "rt:forward-string")
    (:movz 3 1 0)
    (:sub 4 2 8)
    (:str 3 4 0)
    (:ret)
    (:label "rt:forward-box")
    (:ldr 3 2 0)
    (:cmp 3 0)
    (:b-cond :mi "rt:forward-box-seen")
    (:sub-reg 0 20 28 0)
    (:add 0 0 2)
    (:movz 4 32768 48)
    (:orr-reg 4 4 0)
    (:str 4 2 0)
    (:str 3 20 0)
    (:add 20 20 8)
    (:lsr 3 3 8)
    (:add 3 3 7)
    (:lsr 3 3 3)
    (:cbz 3 "rt:forward-return")
    (:add 2 2 8)
    (:label "rt:forward-copy")
    (:ldr 4 2 0)
    (:str 4 20 0)
    (:add 2 2 8)
    (:add 20 20 8)
    (:subs 3 3 1)
    (:b-cond :ne "rt:forward-copy")
    (:label "rt:forward-return")
    (:ret)
    (:label "rt:forward-box-seen")
    (:and-mask 0 3 63)
    (:ret)

    ; In: x0 and x1 are the page-aligned start and exclusive end.
    ; Out: Releases the pages if the end exceeds the start, or stops on error.
    ; Changes: Volatile set. Stack: 16 machine bytes for saves.
    ; Allocates: No.
    (:label "rt:release-range")
    (:subs-reg 1 1 0 0)
    (:b-cond :ls "rt:release-return")
    (:stp-pre 29 30 31 -16)
    (:bl "sys:release")
    (:cbnz 0 "rt:memory")
    (:ldp-post 29 30 31 16)
    (:label "rt:release-return")
    (:ret)

    ; In: The list of separately mapped strings and their marks.
    ; Out: Unlinks and unmaps unmarked strings, clears surviving marks,
    ; zeroes the new mapping count and sets the next mapping budget.
    ; Changes: Volatile set, x19, x20 and x22. Stack: 16 machine bytes
    ; for saves. Allocates: No.
    ; A mapping contains its next pointer, byte size and mark before
    ; the ordinary string header.
    (:label "rt:sweep-strings")
    (:stp-pre 29 30 31 -16)
    (:sub 19 28 72)
    (:movz 22 0 0)
    (:label "rt:sweep-string")
    (:ldr 0 19 0)
    (:cbz 0 "rt:sweep-done")
    (:ldp 20 1 0 0)
    (:ldr 2 0 16)
    (:cbnz 2 "rt:sweep-keep")
    (:str 20 19 0)
    (:bl "sys:unmap")
    (:cbnz 0 "rt:memory")
    (:b "rt:sweep-string")
    (:label "rt:sweep-keep")
    (:str 31 0 16)
    (:add-reg 22 22 1 0)
    (:mov 19 0)
    (:b "rt:sweep-string")
    (:label "rt:sweep-done")
    (:movz 2 16 16)
    (:cmp-reg 22 2)
    (:csel 22 22 2 :hs)
    (:sub 17 28 128)
    (:stp 31 22 17 72)
    (:ldp-post 29 30 31 16)
    (:ret)

    ; In: x0 is the string's byte length.
    ; Out: x0 is the string datum, x1 its payload address, x2 its length.
    ; The header is initialized and the mapping is linked into the string
    ; list. The caller fills the payload. Live mappings keep their addresses.
    ; Changes: Volatile set and x26 through x27 if collection runs.
    ; Stack: 32 machine bytes for saves. Allocates: Yes.
    ; Account for newly mapped bytes even when all intervening
