(in-package "BOYMOO-COMPILER")

(include-book "a64")

(set-verify-guards-eagerness 0)

(defconst *nil-name* "COMMON-LISP::NIL")
(defconst *quote-name* "COMMON-LISP::QUOTE")
(defconst *if-name* "COMMON-LISP::IF")

(defun printable-byte-p (c)
  (let ((n (char-code c)))
    (and (<= 32 n) (<= n 126))))

(defun check-program-bytes (s i left)
  (declare (xargs :measure (nfix left)))
  (if (zp left)
      t
    (let ((c (char s i)))
      (if (or (equal c #\Newline) (printable-byte-p c))
          (check-program-bytes s (+ i 1) (- left 1))
        (compiler-error "Nonprintable input at byte ~x0." i)))))

(defun delimiter (c)
  (or (equal c #\Space) (equal c #\Newline)
      (equal c #\() (equal c #\))))

; Bars and quotes delimit parts of atoms. A delimiter inside its own
; part is written as a hexadecimal escape.
(defun atom-end (s i left closing)
  (declare (xargs :measure (nfix left)))
  (if (zp left)
      (if closing (compiler-error "Unclosed atom at byte ~x0." i) i)
    (let ((c (char s i)))
      (cond ((equal c #\Newline)
             (if closing (compiler-error "Unclosed atom at byte ~x0." i) i))
            (closing
             (atom-end s (+ i 1) (- left 1)
                       (if (equal c closing) nil closing)))
            ((delimiter c) i)
            ((or (equal c #\|) (equal c #\"))
             (atom-end s (+ i 1) (- left 1) c))
            (t (atom-end s (+ i 1) (- left 1) nil))))))

(defun find-char (s i left wanted)
  (declare (xargs :measure (nfix left)))
  (cond ((zp left) nil)
        ((equal (char s i) wanted) i)
        (t (find-char s (+ 1 i) (- left 1) wanted))))

(defun token-end (s i end)
  (if (and (< (+ i 2) end)
           (equal (char s i) #\#)
           (equal (char s (+ i 1)) #\C)
           (equal (char s (+ i 2)) #\())
      (let ((j (find-char s (+ i 3) (- end (+ i 3)) #\))))
        (if j (+ j 1) (compiler-error "Unclosed complex rational at byte ~x0." i)))
    (atom-end s i (- end i) nil)))

; A quoted datum stays in its canonical text until the data builder
; needs it. Only parentheses outside atoms contribute to its nesting.
(defun datum-end (s i end depth fuel)
  (declare (xargs :measure (nfix fuel)))
  (if (or (zp fuel) (<= end i))
      (compiler-error "Unclosed quoted datum at byte ~x0." i)
    (let ((c (char s i)))
      (cond ((equal c #\()
             (datum-end s (+ i 1) end (+ depth 1) (- fuel 1)))
            ((equal c #\))
             (if (equal depth 1)
                 (+ i 1)
               (if (< 1 depth)
                   (datum-end s (+ i 1) end (- depth 1) (- fuel 1))
                 (compiler-error "Missing quoted datum at byte ~x0." i))))
            ((equal c #\Space)
             (datum-end s (+ i 1) end depth (- fuel 1)))
            ((equal c #\Newline)
             (compiler-error "Unclosed quoted datum at byte ~x0." i))
            (t (let ((j (token-end s i end)))
                 (if (zp depth)
                     j
                   (datum-end s j end depth (- fuel 1)))))))))

(defun read-after (s i end in-list)
  (let ((c (char s i)))
    (if (if in-list
            (or (equal c #\Space) (equal c #\)))
          (or (<= end i) (equal c #\Newline)))
        i
      (compiler-error "Missing separator at byte ~x0." i))))

(defun read-list-role (frames terms)
  (let* ((frame (car frames))
         (items (cdr frame)))
    (cond ((not terms) nil)
          ((not frame) :line)
          ((eq (car frame) :term) (if items :term :lambda))
          ((and (eq (car frame) :define-line) (consp (cdr items))) :definition)
          ((and (or (eq (car frame) :definition) (eq (car frame) :lambda))
                (consp (cdr items)))
           :term)
          (t nil))))

(defun read-push (item frames)
  (let ((role (if (and (eq (caar frames) :line) (not (cdar frames))
                       (equal item "define"))
                  :define-line
                (caar frames))))
    (cons (cons role (cons item (cdar frames))) (cdr frames))))

; Each open list holds its grammatical role and its elements in reverse
; order. The parser returns completed lines in reverse order.
(defun read-lines (s i end frames lines terms fuel)
  (declare (xargs :measure (nfix fuel)))
  (cond ((<= end i)
         (if (consp frames) (compiler-error "Unclosed list at byte ~x0." i) lines))
        ((zp fuel) (compiler-error "The reader did not advance at byte ~x0." i))
        (t
         (let ((c (char s i)))
           (cond ((equal c #\Newline)
                  (if (or (consp frames) (equal i 0) (equal (char s (- i 1)) #\Newline))
                      (compiler-error "Invalid line ending at byte ~x0." i)
                    (read-lines s (+ i 1) end nil lines terms (- fuel 1))))
                 ((equal c #\Space)
                  (if (and (consp (cdar frames))
                           (not (member-equal (char s (+ i 1)) '(#\Space #\Newline #\)))))
                      (read-lines s (+ i 1) end frames lines terms (- fuel 1))
                    (compiler-error "Unexpected space at byte ~x0." i)))
                 ((and (eq (caar frames) :term) (equal (cadar frames) *quote-name*)
                       (not (cddar frames)) (not (equal c #\))))
                  (let ((j (datum-end s i end 0 (- end i))))
                    (read-lines s (read-after s j end t) end
                                (read-push (subseq s i j) frames)
                                lines terms (- fuel 1))))
                 ((equal c #\()
                  (let ((role (read-list-role frames terms)))
                    (read-lines s (+ i 1) end (cons (list role) frames) lines terms
                                (- fuel 1))))
                 ((equal c #\))
                  (if (not (consp (cdar frames)))
                      (compiler-error "Unexpected closing parenthesis at byte ~x0." i)
                    (let ((item (reverse-onto (cdar frames) nil)))
                      (if (consp (cdr frames))
                          (read-lines s (read-after s (+ i 1) end t) end
                                      (read-push item (cdr frames))
                                      lines terms (- fuel 1))
                        (read-lines s (read-after s (+ i 1) end nil) end nil (cons item lines)
                                    terms (- fuel 1))))))
                 ((consp frames)
                  (let ((j (token-end s i end)))
                    (read-lines s (read-after s j end t) end
                                (read-push (subseq s i j) frames)
                                lines terms (- fuel 1))))
                 (t (compiler-error "Expected a line at byte ~x0." i)))))))

(defun read-program (s)
  (let ((n (length s)))
    (if (and (< 0 n) (equal (char s (- n 1)) #\Newline)
             (check-program-bytes s 0 n))
        (read-lines s 0 n nil nil t n)
      (compiler-error "The compiler input must end with a line feed: ~x0." n))))

(defun hex-value (c)
  (let ((n (char-code c)))
    (cond ((and (<= 48 n) (<= n 57)) (- n 48))
          ((and (<= 65 n) (<= n 70)) (- n 55))
          (t (compiler-error "Invalid hexadecimal digit: ~x0." c)))))

(defun hex-byte (s i)
  (+ (* 16 (hex-value (char s i))) (hex-value (char s (+ i 1)))))

(defun decode-characters (s i left delimiter chars)
  (declare (xargs :measure (nfix left)))
  (if (zp left)
      (coerce (reverse-onto chars nil) 'string)
    (let ((c (char s i)))
      (cond ((equal c delimiter)
             (compiler-error "Unexpected delimiter at byte ~x0." i))
            ((not (equal c #\\))
             (decode-characters s (+ i 1) (- left 1) delimiter (cons c chars)))
            ((< left 3)
             (compiler-error "Truncated hexadecimal escape at byte ~x0." i))
            (t
             (let ((byte (code-char (hex-byte s (+ i 1)))))
               (if (and (printable-byte-p byte) (not (equal byte delimiter))
                        (not (equal byte #\\)))
                   (compiler-error "A character escaped that is written as itself at byte ~x0." i)
                 (decode-characters s (+ i 3) (- left 3) delimiter (cons byte chars)))))))))

(defun decode-part (s i end)
  (let ((delimiter (char s i)))
    (if (or (equal delimiter #\|) (equal delimiter #\"))
        (let* ((start (+ i 1))
               (last (- end 1))
               (n (- last start)))
          (cond ((or (< n 0) (not (equal (char s last) delimiter))
                     (find-char s start n delimiter))
                 (compiler-error "Invalid delimited text: ~x0." s))
                ((find-char s start n #\\)
                 (decode-characters s start n delimiter nil))
                (t (subseq s start last))))
      (subseq s i end))))

(defun plain-symbol-char-p (c)
  (let ((n (char-code c)))
    (or (and (<= 65 n) (<= n 90))
        (and (<= 48 n) (<= n 57))
        (member-equal c '(#\- #\+ #\* #\/ #\< #\= #\> #\! #\?
                          #\$ #\% #\& #\_ #\^ #\~ #\. #\@)))))

(defun plain-symbol-part-p (s i left)
  (declare (xargs :measure (nfix left)))
  (or (zp left)
      (and (plain-symbol-char-p (char s i))
           (plain-symbol-part-p s (+ i 1) (- left 1)))))

(defun decode-symbol-part (s i end)
  (if (equal (char s i) #\|)
      (let* ((part (decode-part s i end))
             (n (length part)))
        (if (and (< 0 n) (plain-symbol-part-p part 0 n))
            (compiler-error "A symbol part between bars that needs none: ~x0." s)
          part))
    (if (and (< i end) (plain-symbol-part-p s i (- end i)))
        (subseq s i end)
      (compiler-error "Invalid symbol part: ~x0." s))))

(defun symbol-separator (s)
  (and (stringp s)
       (let* ((n (length s))
              (first (char s 0))
              (i (cond ((equal first #\|)
                        (let ((end (find-char s 1 (- n 1) #\|)))
                          (and end (+ end 1))))
                       ((plain-symbol-char-p first) (find-char s 0 n #\:)))))
         (and i (< (+ i 2) n) (equal (char s i) #\:)
              (equal (char s (+ i 1)) #\:) i))))
