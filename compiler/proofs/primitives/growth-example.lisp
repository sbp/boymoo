(in-package "BOYMOO-PROOFS")

(include-book "paths")
(include-book "../foundations/checks")

(logic)
(set-verify-guards-eagerness 0)

(defun p6-load-growth-example-code (items offset base count machine)
  (declare (xargs :measure (acl2-count items)))
  (cond ((or (atom items) (zp count)) machine)
        ((eq (caar items) :label)
         (p6-load-growth-example-code (cdr items) offset base count machine))
        (t
         (let* ((word (boymoo-compiler::a64-word (car items) offset *p6-runtime-layout*))
                (next (boymoo-model::a64-store 4 (+ base offset) word machine)))
           (p6-load-growth-example-code (cdr items) (+ 4 offset) base (1- count) next)))))

; The high reservation satisfies the heap invariant and makes the
; doubled limit exceed the range of an unsigned 64-bit word.
(defun p6-growth-overflow-example ()
  (let* ((base #x100000)
         (stack (- (expt 2 64) (+ *proof-value-reservation* 4096)))
         (stack-end (+ stack *proof-value-reservation*))
         (limit (+ stack (* 3 (expt 2 28))))
         (required (+ limit 16))
         (machine-base #x400000000)
         (machine-end (+ machine-base *proof-machine-reservation*))
         (runtime-base #x40000)
         (link (- runtime-base 4))
         (offset (p6-runtime-offset "rt:ensure-stack"))
         (items (p6-runtime-items-from "rt:ensure-stack" (boymoo-compiler::runtime-code)))
         (objects (proof-check-static-objects base))
         (witness (acl2::intern-in-package-of-symbol "ACL2-PKG-WITNESS" nil))
         (packages (list (proof-package "COMMON-LISP" witness t nil)))
         (lines '(("package" "\"COMMON-LISP\"" "COMMON-LISP::NIL"))))
    (mv-let (image constants)
      (boymoo-compiler::data-build lines lines)
      (declare (ignore constants))
      (let* ((active (proof-align-up (+ base (car image)) *proof-runtime-page*))
             (inactive (+ active *proof-space-size*))
             (end (+ inactive *proof-space-size*))
             (registers (list (cons 8 required)
                              (cons 23 (+ machine-base *proof-machine-margin*))
                              (cons 24 limit) (cons 25 stack)
                              (cons 26 (+ active *proof-runtime-page*))
                              (cons 27 active) (cons 28 base) (cons 30 link)))
             (machine (boymoo-model::a64-state registers machine-end (+ runtime-base offset) 0 nil))
             (machine (proof-check-write-words
                       (list (cons 0 active) (cons 8 inactive) (cons 16 inactive)
                             (cons 24 inactive) (cons 32 end)
                             (cons 40 stack) (cons 48 stack-end) (cons 64 end)
                             (cons 80 *proof-minimum-string-budget*))
                       (- base 128) machine))
             (machine (proof-load-cleared-string (boymoo-compiler::image-string (cdr image))
                                                 base machine))
             (machine (p6-load-growth-example-code items offset runtime-base 13 machine))
             (regions (list (proof-region runtime-base (+ runtime-base 65536) :rx)
                            (proof-region (- base *proof-heap-prefix*) end :rw)
                            (proof-region stack stack-end :rw)
                            (proof-region machine-base machine-end :rw)))
             (world (proof-world machine regions 4096 nil nil nil nil nil)))
        (mv-let (reason after)
          (proof-run 13 (list link) world)
          (list (if (proof-heap-p world objects packages) t nil)
                reason (proof-grow-limit required world) (proof-stack-limit after)
                (proof-grow-return-p "rt:ensure-stack" required world after objects objects packages)))))))

(assert-event
 (let ((result (p6-growth-overflow-example)))
   (prog2$ (cw "Stack growth example: ~x0~%" result)
           (equal result '(nil :cut #xfffffffffffff000 #xffffffffeffff010 nil)))))
