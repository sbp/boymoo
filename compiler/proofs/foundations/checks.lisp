(in-package "BOYMOO-PROOFS")

(include-book "interfaces")

(logic)
(set-verify-guards-eagerness 0)

(defun proof-check-instructions ()
  (let* ((address #x1000)
         (code (boymoo-compiler::a64-bytes
                '((:clz 1 0) (:clz 2 1) (:cmp 31 12) (:cmn 31 0))))
         (machine (boymoo-model::a64-state nil #x9000 address 0 nil))
         (loaded (proof-store-string code address machine))
         (first (proof-cpu-step loaded))
         (second (proof-cpu-step first))
         (third (proof-cpu-step (proof-cpu-step second)))
         (fourth (proof-cpu-step (proof-cpu-step third))))
    (and (equal (proof-reg 1 first) 64)
         (equal (proof-reg 2 second) 57)
         (equal (boymoo-model::a64-nzcv third) 8)
         (equal (boymoo-model::a64-nzcv fourth) 4)
         (equal (boymoo-model::a64-sp fourth) #x9000)
         (equal (boymoo-model::a64-pc fourth) (+ address 24)))))

(assert-event (proof-check-instructions))

(defun proof-check-write-words (words base machine)
  (if (atom words)
      machine
    (proof-check-write-words
     (cdr words) base
     (boymoo-model::a64-store 8 (+ base (caar words)) (cdar words) machine))))

(defun proof-check-data ()
  (let* ((base #x100000)
         (external #x8000)
         (negative-offset (boymoo-model::a64-unsigned 64 (+ 2 (- external base))))
         (empty (boymoo-model::a64-state nil 0 0 0 nil))
         (machine (boymoo-model::a64-store 8 external 513 empty))
         (machine (proof-store-string "AB" (+ external 8) machine))
         (machine (proof-check-write-words
                   (list (cons 32 4098) (cons 40 82) (cons 48 1)
                         (cons 80 769) (cons 96 6147) (cons 104 0)
                         (cons 112 0) (cons 120 (expt 2 30))
                         (cons 128 4100) (cons 136 98) (cons 144 7)
                         (cons 152 4101) (cons 160 130)
                         (cons 168 (proof-integer-word -1))
                         (cons 176 154) (cons 184 negative-offset)
                         (cons 192 4102) (cons 200 176) (cons 208 34))
                   base machine))
         (machine (proof-store-string "NIL" (+ base 88) machine))
         (objects (list (proof-object (+ base 32) :static :header 1)
                        (proof-object (+ base 80) :static :header 0)
                        (proof-object (+ base 96) :active :header 0)
                        (proof-object (+ base 128) :active :header 1)
                        (proof-object (+ base 152) :active :header 2)
                        (proof-object (+ base 176) :active :cons 3)
                        (proof-object (+ base 192) :active :header 4)
                        (proof-object external :external :header 0)))
         (packages (list (proof-package "COMMON-LISP"
                                        (acl2::intern-in-package-of-symbol
                                         "ACL2-PKG-WITNESS" nil)
                                        t nil)))
         (value (cons (complex (/ (expt 2 62) 3) -1) "AB")))
    (and (proof-value-p 34 nil base objects packages machine)
         (proof-value-p 176 value base objects packages machine)
         (equal (proof-view 194 base objects packages machine)
                (list :vector (proof-value-view value) (proof-value-view nil)))
         (proof-value-p (proof-character-word #\A) #\A base objects packages machine)
         (proof-value-p (proof-integer-word (- (expt 2 62))) (- (expt 2 62))
                        base objects packages machine)
         (not (proof-view 6 base objects packages machine)))))

(assert-event (proof-check-data))

(defun proof-check-static-objects (base)
  (list (proof-object (+ base 32) :static :header 1)
        (proof-object (+ base 56) :static :header 1)
        (proof-object (+ base 80) :static :header 0)
        (proof-object (+ base 96) :static :header 0)
        (proof-object (+ base 112) :static :cons 1)
        (proof-object (+ base 128) :static :cons 2)
        (proof-object (+ base 144) :static :cons 3)
        (proof-object (+ base 160) :static :cons 1)
        (proof-object (+ base 176) :static :cons 2)
        (proof-object (+ base 192) :static :cons 3)
        (proof-object (+ base 208) :static :header 0)
        (proof-object (+ base 232) :static :header 0)
        (proof-object (+ base 256) :static :header 1)
        (proof-object (+ base 280) :static :cons 1)
        (proof-object (+ base 296) :static :cons 2)
        (proof-object (+ base 312) :static :cons 3)
        (proof-object (+ base 328) :static :header 2)
        (proof-object (+ base 360) :static :header 3)
        (proof-object (+ base 376) :static :header 4)))

(defun proof-check-static-heap ()
  (let* ((base #x100000)
         (stack #x300000000)
         (stack-end (+ stack *proof-value-reservation*))
         (machine-base #x400000000)
         (machine-end (+ machine-base *proof-machine-reservation*))
         (objects (proof-check-static-objects base))
         (witness (acl2::intern-in-package-of-symbol "ACL2-PKG-WITNESS" nil))
         (packages (list (proof-package "COMMON-LISP" witness t nil)))
         (lines '(("package" "\"COMMON-LISP\"" "COMMON-LISP::NIL"))))
    (mv-let (image constants)
      (boymoo-compiler::data-build lines lines)
      (declare (ignore constants))
      (let* ((active (proof-align-up (+ base (car image)) *proof-runtime-page*))
             (inactive (+ active *proof-space-size*))
             (end (+ inactive *proof-space-size*))
             (registers (list (cons 23 (+ machine-base *proof-machine-margin*))
                              (cons 24 (+ stack *proof-runtime-page*))
                              (cons 25 (+ stack 8))
                              (cons 26 (+ active *proof-runtime-page*))
                              (cons 27 active) (cons 28 base)))
             (machine (boymoo-model::a64-state registers machine-end 0 0 nil))
             (machine (proof-check-write-words
                       (list (cons 0 active) (cons 8 inactive) (cons 16 inactive)
                             (cons 24 inactive) (cons 32 end)
                             (cons 40 stack) (cons 48 stack-end) (cons 64 end)
                             (cons 80 *proof-minimum-string-budget*))
                       (- base 128) machine))
             (machine (boymoo-model::a64-store 8 stack *proof-nil* machine))
             (machine (proof-load-cleared-string (boymoo-compiler::image-string (cdr image))
                                                 base machine))
             (regions (list (proof-region (- base *proof-heap-prefix*) end :rw)
                            (proof-region stack stack-end :rw)
                            (proof-region machine-base machine-end :rw)))
             (world (proof-world machine regions 4096 nil nil nil nil nil)))
        (and (equal (proof-dynamic-root base machine) *proof-nil*)
             (proof-heap-p world objects packages)
             (equal (proof-stack-prefix (+ stack 8) world objects packages)
                    (list :slots (proof-value-view nil))))))))

(assert-event (proof-check-static-heap))

(defun proof-check-process ()
  (let* ((code (append
                (boymoo-compiler::linux-system-code)
                '((:label "rt:start")
                  (:movz 0 4096 0) (:bl "sys:map") (:mov 19 0)
                  (:movz 0 0 0) (:mov 1 19) (:movz 2 3 0) (:bl "sys:read")
                  (:movz 0 0 0) (:add 1 19 2) (:movz 2 1 0) (:bl "sys:read")
                  (:movz 0 1 0) (:mov 1 19) (:movz 2 2 0) (:bl "sys:write")
                  (:movz 0 1 0) (:add 1 19 1) (:movz 2 1 0) (:bl "sys:write")
                  (:mov 0 19) (:movz 1 4096 0) (:bl "sys:release")
                  (:mov 0 19) (:movz 1 4096 0) (:bl "sys:unmap")
                  (:movz 0 0 0) (:b "sys:exit"))))
         (regions (list (proof-region #x8000 #xa000 :rw)))
         (machine (boymoo-model::a64-state nil #xa000 0 0 nil)))
    (mv-let (image offset)
      (boymoo-compiler::a64-assemble-image code "os:main")
      (let* ((file (boymoo-compiler::elf-image-executable image offset))
             (start (proof-load-linux file machine regions 4096 "Az"
                                      '(#x900000 2 0 1 1 0 0))))
        (and start
             (equal (proof-world-pc start) (+ *proof-linux-code-base* offset))
             (proof-linked-image-p code "os:main" *proof-linux-code-base* start)
             (mv-let (reason finish)
               (proof-run 128 nil start)
               (and (equal reason '(:exit . 0))
                    (proof-source-observation-p (boymoo-model::core-value "Az") finish)
                    (null (proof-world-input finish))
                    (null (proof-world-replies finish))
                    (not (proof-covered-p #x900000 1 :read (proof-world-regions finish)))
                    (equal (boymoo-model::a64-load 1 #x900000 (proof-world-machine finish))
                           0))))))))

(assert-event (proof-check-process))
