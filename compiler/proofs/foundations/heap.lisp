(in-package "BOYMOO-PROOFS")

(include-book "kernel")
(include-book "values")

(logic)
(set-verify-guards-eagerness 0)

(defconst *proof-space-size* (expt 2 32))
(defconst *proof-value-reservation* (expt 2 30))
(defconst *proof-machine-reservation* (expt 2 26))
(defconst *proof-machine-margin* (expt 2 14))
(defconst *proof-heap-prefix* (expt 2 14))
(defconst *proof-runtime-page* (expt 2 16))
(defconst *proof-minimum-string-budget* (expt 2 20))

(defun proof-heap-base (world) (proof-world-reg 28 world))
(defun proof-box-top (world) (proof-world-reg 27 world))
(defun proof-heap-limit (world) (proof-world-reg 26 world))
(defun proof-stack-top (world) (proof-world-reg 25 world))
(defun proof-stack-limit (world) (proof-world-reg 24 world))
(defun proof-machine-limit (world) (proof-world-reg 23 world))

(defun proof-runtime-word (offset world)
  (proof-load-word (+ (- (proof-heap-base world) 128) offset)
                   (proof-world-machine world)))

(defun proof-active-floor (world) (proof-runtime-word 0 world))
(defun proof-active-end (world) (proof-runtime-word 8 world))
(defun proof-cons-floor (world) (proof-runtime-word 16 world))
(defun proof-inactive-floor (world) (proof-runtime-word 24 world))
(defun proof-inactive-end (world) (proof-runtime-word 32 world))
(defun proof-stack-base (world) (proof-runtime-word 40 world))
(defun proof-stack-end (world) (proof-runtime-word 48 world))
(defun proof-external-head (world) (proof-runtime-word 56 world))
(defun proof-spaces-end (world) (proof-runtime-word 64 world))
(defun proof-string-bytes-since-collection (world) (proof-runtime-word 72 world))
(defun proof-string-budget (world) (proof-runtime-word 80 world))

(defun proof-static-size (base machine) (proof-load-word base machine))

(defun proof-dynamic-root (base machine) (proof-load-word (+ base 24) machine))

(defun proof-object-size (object machine)
  (if (eq (proof-object-kind object) :cons)
      16
    (+ 8 (proof-align-up
          (proof-header-size (proof-load-word (proof-object-address object) machine))
          8))))

(defun proof-object-disjoint-p (address end objects machine)
  (if (atom objects)
      t
    (let* ((object (car objects))
           (other (proof-object-address object)))
      (and (proof-disjoint-p address end other (+ other (proof-object-size object machine)))
           (proof-object-disjoint-p address end (cdr objects) machine)))))

(defun proof-object-record-p (object)
  (and (true-listp object)
       (equal (len object) 4)
       (unsigned-byte-p 64 (proof-object-address object))
       (equal (mod (proof-object-address object) 8) 0)
       (natp (proof-object-rank object))
       (member-eq (proof-object-zone object) '(:static :active :external))
       (member-eq (proof-object-kind object) '(:cons :header))))

(defun proof-object-view (object base objects packages machine)
  (proof-view (proof-object-word object base) base objects packages machine))

(defun proof-symbol-object-p (object machine)
  (and (eq (proof-object-kind object) :header)
       (equal (proof-header-type
               (proof-load-word (proof-object-address object) machine))
              2)))

(defun proof-object-map-p (pending objects symbols base packages machine)
  (if (atom pending)
      (null pending)
    (let* ((object (car pending))
           (address (proof-object-address object))
           (size (proof-object-size object machine))
           (view (proof-object-view object base objects packages machine))
           (symbol (proof-symbol-object-p object machine)))
      (and (proof-object-record-p object)
           (proof-span-p address size)
           view
           (proof-object-disjoint-p address (+ address size) (cdr pending) machine)
           (or (not symbol) (not (member-eq (proof-view-value view) symbols)))
           (proof-object-map-p (cdr pending) objects
                               (if symbol (cons (proof-view-value view) symbols) symbols)
                               base packages machine)))))

(defun proof-static-objects (objects)
  (if (atom objects)
      nil
    (if (eq (proof-object-zone (car objects)) :static)
        (cons (car objects) (proof-static-objects (cdr objects)))
      (proof-static-objects (cdr objects)))))

(defun proof-static-spans-p (objects base size machine)
  (if (atom objects)
      t
    (and (proof-subspan-p (proof-object-address (car objects))
                          (proof-object-size (car objects) machine)
                          (+ base 32) (+ base size))
         (proof-static-spans-p (cdr objects) base size machine))))

(defun proof-packages-p (packages)
  (if (atom packages)
      (null packages)
    (let* ((package (car packages))
           (name (proof-package-name package))
           (witness (proof-package-witness package))
           (imports (proof-package-imports package)))
      (and (true-listp package) (equal (len package) 4)
           (stringp name) (< 0 (length name))
           (symbolp witness)
           (equal (symbol-name witness) "ACL2-PKG-WITNESS")
           (equal (acl2::symbol-package-name witness) name)
           (booleanp (proof-package-visible package))
           (symbol-listp imports)
           (equal (acl2::pkg-imports name) imports)
           (not (assoc-equal name (cdr packages)))
           (proof-packages-p (cdr packages))))))

(defun proof-package-row-views (packages)
  (if (atom packages)
      nil
    (let ((package (car packages)))
      (cons (list :vector
                  (proof-value-view (proof-package-name package))
                  (proof-value-view (proof-package-imports package))
                  (proof-value-view (if (proof-package-visible package)
                                        (proof-package-witness package)
                                      nil)))
            (proof-package-row-views (cdr packages))))))

(defun proof-hash-characters (characters hash bits)
  (if (atom characters)
      (boymoo-model::a64-unsigned bits hash)
    (proof-hash-characters
     (cdr characters)
     (boymoo-model::a64-unsigned bits (+ (* 33 hash) (char-code (car characters))))
     bits)))

(defun proof-symbol-hash (number name bits)
  (boymoo-model::a64-unsigned
   bits (+ (proof-hash-characters (coerce name 'list) 0 bits) (* 7919 number))))

(defun proof-static-bucket-p (entries number packages)
  (if (atom entries)
      (null entries)
    (let* ((entry (car entries))
           (key (car entry))
           (package (car key))
           (name (cdr key))
           (symbol (cdr entry)))
      (and (consp key)
           (natp package) (< package (len packages))
           (stringp name)
           (equal (proof-symbol-hash package name 12) number)
           (symbolp symbol)
           (equal symbol (acl2::intern-in-package-of-symbol
                          name (proof-package-witness (nth package packages))))
           (not (assoc-equal key (cdr entries)))
           (proof-static-bucket-p (cdr entries) number packages)))))

(defun proof-static-buckets-p (buckets index packages)
  (if (atom buckets)
      (and (null buckets) (equal index 4096))
    (and (< index 4096)
         (proof-value-view-p (car buckets))
         (proof-static-bucket-p (proof-view-value (car buckets)) index packages)
         (proof-static-buckets-p (cdr buckets) (+ 1 index) packages))))

(defun proof-static-binding (number name buckets)
  (assoc-equal (cons number name)
               (proof-view-value
                (nth (proof-symbol-hash number name 12) buckets))))

(defun proof-import-bindings-p (imports number buckets)
  (if (atom imports)
      t
    (let* ((symbol (car imports))
           (name (symbol-name symbol)))
      (and (equal (proof-static-binding number name buckets)
                  (cons (cons number name) symbol))
           (proof-import-bindings-p (cdr imports) number buckets)))))

(defun proof-package-bindings-p (packages number buckets)
  (if (atom packages)
      t
    (and (proof-import-bindings-p (proof-package-imports (car packages)) number buckets)
         (proof-package-bindings-p (cdr packages) (+ 1 number) buckets))))

(defun proof-home-bindings-p (pending base objects packages machine buckets)
  (if (atom pending)
      t
    (let* ((object (car pending))
           (address (proof-object-address object)))
      (and (if (proof-symbol-object-p object machine)
               (let* ((view (proof-object-view object base objects packages machine))
                      (symbol (proof-view-value view))
                      (name (symbol-name symbol))
                      (number (proof-view-value
                               (proof-view (proof-load-word (+ address 16) machine)
                                           base objects packages machine))))
                 (equal (proof-static-binding number name buckets)
                        (cons (cons number name) symbol)))
             t)
           (proof-home-bindings-p (cdr pending) base objects packages machine buckets)))))

(defun proof-static-p (base objects packages machine)
  (let* ((statics (proof-static-objects objects))
         (size (proof-static-size base machine))
         (package-word (proof-load-word (+ base 8) machine))
         (symbol-word (proof-load-word (+ base 16) machine))
         (symbols (proof-view symbol-word base statics packages machine)))
    (and (<= 80 size) (< size *proof-space-size*)
         (equal (mod base 8) 0) (equal (mod size 8) 0)
         (proof-span-p base size)
         (proof-packages-p packages)
         (proof-object-map-p statics statics nil base packages machine)
         (proof-static-spans-p statics base size machine)
         (proof-value-p *proof-nil* nil base statics packages machine)
         (proof-value-p *proof-t* t base statics packages machine)
         (equal (proof-view package-word base statics packages machine)
                (cons :vector (proof-package-row-views packages)))
         (eq (car symbols) :vector)
         (proof-static-buckets-p (cdr symbols) 0 packages)
         (proof-home-bindings-p statics base statics packages machine (cdr symbols))
         (proof-package-bindings-p packages 0 (cdr symbols)))))

(defun proof-static-initial-p (base objects packages machine)
  (and (equal (proof-dynamic-root base machine) *proof-nil*)
       (equal objects (proof-static-objects objects))
       (proof-static-p base objects packages machine)))

(defun proof-package-number (name packages index)
  (if (atom packages)
      nil
    (if (equal name (proof-package-name (car packages)))
        index
      (proof-package-number name (cdr packages) (+ 1 index)))))

(defun proof-dynamic-bucket (view index count packages)
  (if (equal view (proof-value-view nil))
      (list :entries)
    (let* ((symbol-view (cadr view))
           (hash-view (caddr view))
           (symbol (proof-view-value symbol-view))
           (name (symbol-name symbol))
           (package (proof-package-number (acl2::symbol-package-name symbol)
                                          packages 0)))
      (and (eq (car view) :vector)
           (true-listp view) (equal (len view) 4)
           (proof-value-view-p symbol-view) (symbolp symbol)
           (natp package)
           (proof-value-view-p hash-view)
           (equal (proof-view-value hash-view)
                  (boymoo-model::a64-signed 63 (proof-symbol-hash package name 63)))
           (equal (logand (1- count) (proof-view-value hash-view)) index)
           (let ((tail (proof-dynamic-bucket (cadddr view) index count packages)))
             (and tail (list* :entries symbol (cdr tail))))))))

(defun proof-dynamic-buckets (buckets index count packages)
  (if (atom buckets)
      (and (null buckets) (list :entries))
    (let ((bucket (proof-dynamic-bucket (car buckets) index count packages))
          (rest (proof-dynamic-buckets (cdr buckets) (+ 1 index) count packages)))
      (and bucket rest (cons :entries (append (cdr bucket) (cdr rest)))))))

(defun proof-dynamic-entries (root-view packages)
  (if (equal root-view (proof-value-view nil))
      (list :entries)
    (let* ((buckets (cddr root-view))
           (size (len buckets))
           (count-view (cadr root-view))
           (count (proof-view-value count-view))
           (entries (proof-dynamic-buckets buckets 0 size packages)))
      (and (eq (car root-view) :vector)
           (<= 16 size) (equal (logand size (1- size)) 0)
           (proof-value-view-p count-view) (natp count) (<= count size)
           entries (equal count (len (cdr entries)))
           (no-duplicatesp-eq (cdr entries))
           entries))))

(defun proof-dynamic-symbol-objects-p (pending objects entries base packages machine)
  (if (atom pending)
      t
    (let* ((object (car pending))
           (symbol (and (proof-symbol-object-p object machine)
                        (proof-view-value
                         (proof-object-view object base objects packages machine)))))
      (and (or (not (proof-symbol-object-p object machine))
               (if (eq (proof-object-zone object) :static)
                   (not (member-eq symbol entries))
                 (member-eq symbol entries)))
           (proof-dynamic-symbol-objects-p (cdr pending) objects entries
                                          base packages machine)))))

(defun proof-heap-layout-p (world)
  (let* ((machine (proof-world-machine world))
         (regions (proof-world-regions world))
         (base (proof-heap-base world))
         (static (proof-static-size base machine))
         (low (proof-align-up (+ base static) *proof-runtime-page*))
         (high (+ low *proof-space-size*))
         (end (+ high *proof-space-size*))
         (active (proof-active-floor world))
         (inactive (proof-inactive-floor world))
         (active-end (proof-active-end world))
         (box (proof-box-top world))
         (limit (proof-heap-limit world))
         (cell (proof-cons-floor world))
         (stack (proof-stack-base world))
         (top (proof-stack-top world))
         (stack-limit (proof-stack-limit world))
         (stack-end (proof-stack-end world))
         (machine-base (- (proof-machine-limit world) *proof-machine-margin*))
         (machine-end (+ machine-base *proof-machine-reservation*))
         (sp (boymoo-model::a64-sp machine)))
    (and
     (not (proof-world-stop world))
     (proof-page-size-p (proof-world-page-size world))
     (proof-regions-p regions)
     (<= *proof-heap-prefix* base)
     (<= 80 static) (equal (mod static 8) 0) (equal (mod base 8) 0)
     (or (and (equal active low) (equal inactive high))
         (and (equal active high) (equal inactive low)))
     (equal active-end (+ active *proof-space-size*))
     (equal (proof-inactive-end world) (+ inactive *proof-space-size*))
     (equal (proof-spaces-end world) end)
     (<= active box) (<= box limit) (<= limit cell) (<= cell active-end)
     (equal (mod box 8) 0) (equal (mod limit 8) 0) (equal (mod cell 16) 0)
     (proof-covered-p (- base *proof-heap-prefix*)
                      (+ *proof-heap-prefix* (- end base)) :write regions)
     (equal stack-end (+ stack *proof-value-reservation*))
     ; Twice the reservation fits below 2^64, so that rt:grow, which doubles
     ; the occupied size in 64-bit arithmetic, cannot wrap. The kernels
     ; place the reservation far lower.
     (<= (+ stack (* 2 *proof-value-reservation*)) (expt 2 64))
     (<= stack top) (<= top stack-limit) (<= stack-limit stack-end)
     (equal (mod stack 8) 0) (equal (mod top 8) 0) (equal (mod stack-limit 8) 0)
     (proof-covered-p stack *proof-value-reservation* :write regions)
     (<= machine-base sp) (<= sp machine-end) (equal (mod sp 16) 0)
     (proof-covered-p machine-base *proof-machine-reservation* :write regions)
     (proof-disjoint-p (- base *proof-heap-prefix*) end stack stack-end)
     (proof-disjoint-p (- base *proof-heap-prefix*) end machine-base machine-end)
     (proof-disjoint-p stack stack-end machine-base machine-end))))

(defun proof-external-objects (head fuel world objects)
  (declare (xargs :measure (nfix fuel)))
  (if (equal head 0)
      (list :mappings)
    (and (posp fuel)
         (let* ((address (+ head 24))
                (object (assoc-equal address objects))
                (machine (proof-world-machine world))
                (next (proof-load-word head machine))
                (size (proof-load-word (+ head 8) machine))
                (mark (proof-load-word (+ head 16) machine))
                (header (proof-load-word address machine))
                (end (+ head size)))
           (and object (eq (proof-object-zone object) :external)
                (eq (proof-object-kind object) :header)
                (equal (proof-header-type header) 1)
                (< (proof-header-size header) *proof-space-size*)
                (equal mark 0)
                (equal size (proof-align-up (+ 32 (proof-header-size header))
                                           *proof-runtime-page*))
                (proof-disjoint-p head end (- (proof-heap-base world) *proof-heap-prefix*)
                                  (proof-spaces-end world))
                (proof-disjoint-p head end (proof-stack-base world) (proof-stack-end world))
                (let ((floor (- (proof-machine-limit world) *proof-machine-margin*)))
                  (proof-disjoint-p head end floor (+ floor *proof-machine-reservation*)))
                (member-equal (proof-region head end :rw) (proof-world-regions world))
                (let ((rest (proof-external-objects next (1- fuel) world objects)))
                  (and rest (list* :mappings address (cdr rest)))))))))

(defun proof-heap-object-spans-p (objects external world)
  (if (atom objects)
      t
    (let* ((object (car objects))
           (address (proof-object-address object))
           (kind (proof-object-kind object))
           (size (proof-object-size object (proof-world-machine world))))
      (and (case (proof-object-zone object)
             (:static t)
             (:active
              (if (eq kind :cons)
                  (and (equal (mod address 16) 0)
                       (proof-subspan-p address size (proof-cons-floor world)
                                        (proof-active-end world)))
                (proof-subspan-p address size (proof-active-floor world)
                                 (proof-box-top world))))
             (:external (member-equal address external))
             (otherwise nil))
           (proof-heap-object-spans-p (cdr objects) external world)))))

(defun proof-external-bytes (headers machine)
  (if (atom headers)
      0
    (+ (proof-load-word (- (car headers) 16) machine)
       (proof-external-bytes (cdr headers) machine))))

(defun proof-string-accounting-p (headers world)
  (let* ((mapped (proof-external-bytes headers (proof-world-machine world)))
         (since (proof-string-bytes-since-collection world))
         (budget (proof-string-budget world)))
    (and (< mapped (expt 2 63))
         (<= since mapped)
         (<= *proof-minimum-string-budget* budget)
         (<= budget (max *proof-minimum-string-budget* mapped))
         (equal (mod since *proof-runtime-page*) 0)
         (equal (mod budget *proof-runtime-page*) 0))))

(defun proof-stack-prefix (top world objects packages)
  (let ((lower (proof-stack-base world)))
    (and (natp top)
         (<= lower top) (<= top (proof-stack-top world))
         (equal (mod (- top lower) 8) 0)
         (proof-stack-views (ash (- top lower) -3) lower
                            (proof-heap-base world) objects packages
                            (proof-world-machine world)))))

(defun proof-dynamic-view (world objects packages)
  (let ((base (proof-heap-base world))
        (machine (proof-world-machine world)))
    (proof-view (proof-dynamic-root base machine) base objects packages machine)))

(defun proof-heap-p (world objects packages)
  (let* ((machine (proof-world-machine world))
         (base (proof-heap-base world))
         (external (proof-external-objects (proof-external-head world)
                                           (len objects) world objects))
         (dynamic (proof-dynamic-entries (proof-dynamic-view world objects packages)
                                         packages)))
    (and (proof-heap-layout-p world)
         (proof-static-p base objects packages machine)
         (proof-object-map-p objects objects nil base packages machine)
         external
         (proof-heap-object-spans-p objects (cdr external) world)
         (proof-string-accounting-p (cdr external) world)
         dynamic
         (proof-dynamic-symbol-objects-p objects objects (cdr dynamic)
                                        base packages machine)
         (proof-stack-prefix (proof-stack-top world) world objects packages))))

(defun proof-grow-limit (required world)
  (let ((base (proof-stack-base world))
        (old (proof-stack-limit world))
        (end (proof-stack-end world)))
    (cond ((<= required old) old)
          ((< end required) nil)
          (t (min end (max required (+ base (* 2 (- old base)))))))))

(defun proof-reserved-span-p (kind address bytes world objects)
  (let* ((cells (eq kind :cons))
         (machine (proof-world-machine world))
         (end (+ address bytes)))
    (and (member-eq kind '(:cons :header))
         (proof-span-p address bytes)
         (equal (mod bytes (if cells 16 8)) 0)
         (if cells
             (and (equal address (proof-cons-floor world))
                  (<= end (proof-active-end world)))
           (and (<= (proof-active-floor world) address)
                (equal end (proof-box-top world))))
         (proof-object-disjoint-p address end objects machine))))
