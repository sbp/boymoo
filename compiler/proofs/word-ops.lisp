(in-package "BOYMOO-COMPILER")

(include-book "values")

(logic)
(set-verify-guards-eagerness 0)

(defun model-flag (test)
  (if test 1 0))

(defund model-word-op (op a b)
  (let ((a (model-word a))
        (b (model-word b)))
    (case op
      (:add (model-word (+ a b)))
      (:sub (model-word (- a b)))
      (:mul (model-word (* a b)))
      (:and (logand a b))
      (:or (logior a b))
      (:xor (logxor a b))
      (:shl (model-word (ash a (low-bits b 6))))
      (:shr (ash a (- (low-bits b 6))))
      (:sar (model-word (ash (model-signed a) (- (low-bits b 6)))))
      (:ceq (model-flag (equal a b)))
      (:cne (model-flag (not (equal a b))))
      (:cslt (model-flag (< (model-signed a) (model-signed b))))
      (:csle (model-flag (<= (model-signed a) (model-signed b))))
      (:csgt (model-flag (> (model-signed a) (model-signed b))))
      (:csge (model-flag (>= (model-signed a) (model-signed b))))
      (:cult (model-flag (< a b)))
      (:cule (model-flag (<= a b)))
      (:cugt (model-flag (> a b)))
      (:cuge (model-flag (>= a b)))
      (:ovadd (model-flag (not (signed-byte-p 64 (+ (model-signed a)
                                                     (model-signed b))))))
      (:ovsub (model-flag (not (signed-byte-p 64 (- (model-signed a)
                                                     (model-signed b))))))
      (otherwise nil))))

(assert-event (equal (model-word-op :add #xffffffffffffffff 1) 0))
(assert-event (equal (model-word-op :sar -4 65) #xfffffffffffffffe))
(assert-event (equal (model-word-op :shr -4 65) #x7ffffffffffffffe))
(assert-event (equal (model-word-op :ovadd #x7fffffffffffffff 1) 1))
(assert-event (equal (model-word-op :ovsub #x8000000000000000 1) 1))
(assert-event (equal (model-word-op :cslt -1 0) 1))
(assert-event (equal (model-word-op :cult -1 0) 0))
