(in-package "BOYMOO-PROOFS")

(include-book "instructions")

(logic)
(set-verify-guards-eagerness 0)

(defconst *allocation-example-origin* #x4000)

(defconst *allocation-example-code*
  (boymoo-compiler::a64-bytes
   (append *allocation-runtime-items*
           '((:label "rt:entry") (:label "data:static")))))

(defun allocation-example-load-code (label count machine)
  (let ((offset (allocation-label-offset label)))
    (proof-load-cleared-string
     (subseq *allocation-example-code* offset (+ offset (* 4 count)))
     (+ *allocation-example-origin* offset) machine)))

(defun allocation-example-store-words (words address machine)
  (if (atom words)
      machine
    (allocation-example-store-words
     (cdr words) (+ address 8) (boymoo-model::a64-store 8 address (car words) machine))))

(defun allocation-growth-overflow-example ()
  (let* ((entry "rt:ensure-stack")
         (origin *allocation-example-origin*)
         (address (allocation-code-address entry origin))
         (base #x100000)
         (active #x110000)
         (inactive (+ active *proof-space-size*))
         (heap-end (+ inactive *proof-space-size*))
         (stack (- (expt 2 64) (+ *proof-value-reservation* *proof-runtime-page*)))
         (stack-end (+ stack *proof-value-reservation*))
         (old-limit (+ stack #x30000000))
         (required (+ old-limit 8))
         (machine-base #x300000000)
         (sp (+ machine-base *proof-machine-reservation*))
         (registers (list (cons 8 required)
                          (cons 23 (+ machine-base *proof-machine-margin*))
                          (cons 24 old-limit) (cons 25 stack)
                          (cons 26 (+ active *proof-runtime-page*))
                          (cons 27 active) (cons 28 base) (cons 30 origin)))
         (machine (boymoo-model::a64-state registers sp address 0 nil))
         (machine (boymoo-model::a64-store 8 base 80 machine))
         (machine (allocation-example-store-words
                   (list active inactive inactive inactive heap-end stack stack-end 0 heap-end)
                   (- base 128) machine))
         (machine (allocation-example-load-code entry 13 machine))
         (regions (list (proof-region origin (+ origin *allocation-runtime-code-size*) :rx)
                        (proof-region (- base *proof-heap-prefix*) heap-end :rw)
                        (proof-region stack stack-end :rw)
                        (proof-region machine-base sp :rw)))
         (before (proof-world machine regions 4096 nil nil nil nil nil)))
    (mv-let (why after)
      (proof-run 13 (list origin) before)
      (and (not (proof-heap-layout-p before))
           (equal why :cut)
           (equal (proof-grow-limit required before) stack-end)
           (equal (proof-stack-limit after) required)
           (< required stack-end)))))

(assert-event (allocation-growth-overflow-example))

(defun allocation-collector-count-overflow-example ()
  (let* ((entry "rt:collect-finish")
         (origin *allocation-example-origin*)
         (address (allocation-code-address entry origin))
         (floor #x100000000)
         (end (+ floor *proof-space-size*))
         (live #x10000)
         (request (- (expt 2 64) live))
         (sp #x500000000)
         (metadata #x800000)
         (registers (list (cons 17 metadata) (cons 20 floor) (cons 21 (- end live))))
         (machine (boymoo-model::a64-state registers sp address 0 nil))
         (machine (allocation-example-store-words (list floor end) (+ metadata 24) machine))
         (machine (boymoo-model::a64-store 8 sp request machine))
         (machine (allocation-example-load-code entry 9 machine))
         (regions (list (proof-region origin (+ origin *allocation-runtime-code-size*) :rx)
                        (proof-region metadata (+ metadata 40) :rw)
                        (proof-region sp (+ sp 16) :rw)))
         (before (proof-world machine regions 4096 nil nil nil nil nil))
         (stop (allocation-code-address (proof-resource-label :heap-size) origin))
         (next (+ address 36)))
    (mv-let (why after)
      (proof-run 9 (list stop next) before)
      (and (proof-resource-bound-p :heap-size (+ request live) before)
           (equal why :cut)
           (equal (proof-world-reg 4 after) live)
           (equal (proof-world-reg 5 after) 0)
           (equal (proof-world-pc after) next)))))

(assert-event (allocation-collector-count-overflow-example))
