(in-package "BOYMOO-PROOFS")

(include-book "instructions")
(include-book "memory")
(include-book "alignment")
(include-book "representation")

(local (include-book "arithmetic/top" :dir :system))

(logic)
(set-verify-guards-eagerness 0)

(defconst *allocation-large-size-path* (take 5 *allocation-large-string-code*))
(defconst *allocation-large-round-path* (take 5 (nthcdr 5 *allocation-large-string-code*)))
(defconst *allocation-large-accounting-load-path* (take 2 (nthcdr 10 *allocation-large-string-code*)))
(defconst *allocation-large-map-path* (take 2 (nthcdr 19 *allocation-large-string-code*)))
(defconst *allocation-large-map-test* (nth 21 *allocation-large-string-code*))
(defconst *allocation-large-initialize-path* (nthcdr 21 *allocation-large-string-code*))

(defun allocation-large-string-address (origin index)
  (+ (allocation-code-address "rt:new-large-string" origin) (* 4 index)))

(defun allocation-large-size-target (length origin)
  (if (< length *proof-space-size*)
      (allocation-large-string-address origin 5)
    (allocation-code-address (proof-resource-label :string-size) origin)))

(defthm allocation-large-size-machine-edge
  (let ((length (proof-world-reg 0 before)))
    (implies (and (allocation-code-origin-p origin)
                  (allocation-machine-state-p before)
                  (not (proof-world-stop before))
                  (equal (proof-world-pc before) (allocation-large-string-address origin 0))
                  (equal cut (allocation-path-end *allocation-large-size-path* before)))
             (and (not (proof-world-stop cut))
                  (equal (proof-world-pc cut) (allocation-large-size-target length origin))
                  (equal (proof-world-reg 19 cut) length))))
  :rule-classes nil
  :hints (("Goal" :use ((:instance allocation-length-test-shift (word (proof-world-reg 0 before))))
           :in-theory (disable allocation-unsigned-64-of-sum allocation-unsigned-64-of-difference))))

(defthm allocation-large-size-checked-edge
  (let* ((length (proof-world-reg 0 before))
         (cuts (list (allocation-large-size-target length origin))))
    (implies (and (allocation-code-origin-p origin)
                  (allocation-machine-state-p before)
                  (not (proof-world-stop before))
                  (equal (proof-world-pc before) (allocation-large-string-address origin 0))
                  (allocation-path-ready-p *allocation-large-size-path* cuts before)
                  (equal cut (allocation-path-end *allocation-large-size-path* before)))
             (and (proof-segment-p (len *allocation-large-size-path*) cuts before :cut cut)
                  (implies (<= *proof-space-size* length)
                           (proof-resource-bound-p :string-size length before)))))
  :rule-classes nil
  :hints (("Goal" :use (allocation-large-size-machine-edge
                        (:instance allocation-checked-cut
                         (instructions *allocation-large-size-path*) (world before) (after cut)
                         (cuts (list (allocation-large-size-target (proof-world-reg 0 before) origin)))))
           :in-theory (disable allocation-checked-cut allocation-path-ready-p allocation-path-end
                               allocation-large-size-target proof-segment-p))))

(defun allocation-large-mapping-size (length)
  (proof-align-up (+ 32 length) *proof-runtime-page*))

(defthm allocation-large-rounding-machine-edge
  (let ((length (proof-world-reg 19 before)))
    (implies (and (allocation-code-origin-p origin)
                  (allocation-machine-state-p before)
                  (not (proof-world-stop before))
                  (equal (proof-world-pc before) (allocation-large-string-address origin 5))
                  (< length *proof-space-size*)
                  (equal cut (allocation-path-end *allocation-large-round-path* before)))
             (and (not (proof-world-stop cut))
                  (equal (proof-world-pc cut) (allocation-large-string-address origin 10))
                  (equal (proof-world-reg 19 cut) length)
                  (equal (proof-world-reg 20 cut) (allocation-large-mapping-size length)))))
  :rule-classes nil
  :hints (("Goal"
           :use ((:instance allocation-large-rounding-fits (length (proof-world-reg 19 before))))
           :in-theory (disable allocation-unsigned-64-of-sum allocation-unsigned-64-of-difference
                               allocation-large-rounding-fits proof-align-up))))

(defthm allocation-large-load-accounting
  (implies (and (allocation-code-origin-p origin)
                (allocation-machine-state-p before)
                (not (proof-world-stop before))
                (equal (proof-world-pc before) (allocation-large-string-address origin 10))
                (<= 128 (proof-heap-base before))
                (equal cut (allocation-path-end *allocation-large-accounting-load-path* before)))
           (and (not (proof-world-stop cut))
                (equal (proof-world-pc cut) (allocation-large-string-address origin 12))
                (equal (proof-world-reg 21 cut) (- (proof-heap-base before) 128))
                (equal (proof-world-reg 1 cut) (proof-string-bytes-since-collection before))
                (equal (proof-world-reg 2 cut) (proof-string-budget before))
                (equal (proof-world-reg 19 cut) (proof-world-reg 19 before))
                (equal (proof-world-reg 20 cut) (proof-world-reg 20 before))))
  :rule-classes nil)

(defun allocation-large-collect-p (since size budget)
  (and (not (equal since 0)) (< budget (+ since size))))

(defun allocation-large-budget-path (before)
  (let ((since (proof-world-reg 1 before))
        (size (proof-world-reg 20 before))
        (budget (proof-world-reg 2 before)))
    (take (cond ((equal since 0) 1)
                ((allocation-large-collect-p since size budget) 7)
                (t 4))
          (nthcdr 12 *allocation-large-string-code*))))

(defun allocation-large-budget-target (before origin)
  (if (allocation-large-collect-p (proof-world-reg 1 before) (proof-world-reg 20 before)
                                  (proof-world-reg 2 before))
      (allocation-code-address "rt:collect" origin)
    (allocation-code-address "rt:map-string" origin)))

(defthm allocation-large-budget-machine-edge
  (let ((since (proof-world-reg 1 before))
        (size (proof-world-reg 20 before))
        (budget (proof-world-reg 2 before)))
    (implies (and (allocation-code-origin-p origin)
                  (allocation-machine-state-p before)
                  (not (proof-world-stop before))
                  (equal (proof-world-pc before) (allocation-large-string-address origin 12))
                  (< (+ since size) *allocation-word-modulus*)
                  (equal cut (allocation-path-end (allocation-large-budget-path before) before)))
             (and (not (proof-world-stop cut))
                  (equal (proof-world-pc cut) (allocation-large-budget-target before origin))
                  (equal (proof-world-reg 19 cut) (proof-world-reg 19 before))
                  (equal (proof-world-reg 20 cut) size)
                  (equal (proof-world-reg 21 cut) (proof-world-reg 21 before))
                  (equal (allocation-sp cut) (allocation-sp before))
                  (equal (allocation-memory cut) (allocation-memory before))
                  (if (allocation-large-collect-p since size budget)
                      (and (equal (proof-world-reg 0 cut) 0)
                           (equal (proof-world-reg 1 cut) 0)
                           (equal (proof-world-reg 30 cut) (allocation-large-string-address origin 19)))
                    (equal (proof-world-reg 30 cut) (proof-world-reg 30 before))))))
  :rule-classes nil
  :hints (("Goal" :in-theory (disable allocation-unsigned-64-of-sum
                                     allocation-unsigned-64-of-difference))))

(defthm allocation-large-machine-to-map
  (implies (and (allocation-code-origin-p origin)
                (allocation-machine-state-p before)
                (not (proof-world-stop before))
                (equal (proof-world-pc before) (allocation-code-address "rt:map-string" origin))
                (equal cut (allocation-path-end *allocation-large-map-path* before)))
           (and (not (proof-world-stop cut))
                (equal (proof-world-pc cut) (allocation-code-address "sys:map" origin))
                (equal (proof-world-reg 0 cut) (proof-world-reg 20 before))
                (equal (proof-world-reg 30 cut) (allocation-large-string-address origin 21))
                (equal (allocation-memory cut) (allocation-memory before))))
  :rule-classes nil)

(defthm allocation-large-refused-mapping-edge
  (let ((cuts (list (allocation-code-address (proof-resource-label :mapping) origin))))
    (implies (and (allocation-code-origin-p origin)
                  (allocation-machine-state-p before)
                  (not (proof-world-stop before))
                  (equal (proof-world-pc before) (allocation-large-string-address origin 21))
                  (equal (proof-world-reg 0 before) 0)
                  (allocation-path-ready-p (list *allocation-large-map-test*) cuts before)
                  (equal cut (allocation-path-end (list *allocation-large-map-test*) before)))
             (proof-segment-p 1 cuts before :cut cut)))
  :rule-classes nil
  :hints (("Goal" :use ((:instance allocation-checked-cut
                         (instructions (list *allocation-large-map-test*)) (world before) (after cut)
                         (cuts (list (allocation-code-address (proof-resource-label :mapping) origin)))))
           :in-theory (disable allocation-checked-cut allocation-path-ready-p proof-segment-p))))

(defconst *allocation-large-insertion-path* (take 7 *allocation-large-initialize-path*))
(defconst *allocation-large-header-path* (take 7 (nthcdr 28 *allocation-large-string-code*)))
(defconst *allocation-large-restore-path* (nthcdr 35 *allocation-large-string-code*))

(defun allocation-large-insertion-memory (before)
  (let* ((address (proof-world-reg 0 before))
         (size (proof-world-reg 20 before))
         (metadata (proof-world-reg 21 before))
         (head (allocation-load-word (+ metadata 56) before))
         (since (allocation-load-word (+ metadata 72) before)))
    (allocation-memory
     (allocation-store-word (+ metadata 56) address
       (allocation-store-word (+ address 8) size
         (allocation-store-word address head
           (allocation-store-word (+ metadata 72) (+ since size) before)))))))

(defun allocation-large-insertion-p (before after)
  (let* ((address (proof-world-reg 0 before))
         (size (proof-world-reg 20 before))
         (metadata (proof-world-reg 21 before)))
    (and (equal (proof-world-reg 0 after) address)
         (equal (proof-world-reg 19 after) (proof-world-reg 19 before))
         (equal (proof-world-reg 20 after) size)
         (equal (proof-world-reg 21 after) metadata)
         (equal (proof-heap-base after) (proof-heap-base before))
         (equal (allocation-sp after) (allocation-sp before))
         (equal (proof-external-head after) address)
         (equal (proof-string-bytes-since-collection after)
                (+ (proof-string-bytes-since-collection before) size))
         (equal (proof-string-budget after) (proof-string-budget before))
         (equal (allocation-load-word address after) (proof-external-head before))
         (equal (allocation-load-word (+ address 8) after) size)
         (equal (allocation-load-word (+ address 16) after)
                (allocation-load-word (+ address 16) before))
         (equal (allocation-memory after) (allocation-large-insertion-memory before))
         (equal (proof-world-regions after) (proof-world-regions before))
         (equal (proof-world-replies after) (proof-world-replies before))
         (proof-streams-preserved-p before after))))

(defthm allocation-large-insert-mapping-machine-edge
  (let* ((address (proof-world-reg 0 before))
         (size (proof-world-reg 20 before))
         (base (proof-heap-base before)))
    (implies (and (allocation-code-origin-p origin)
                  (allocation-machine-state-p before)
                  (not (proof-world-stop before))
                  (equal (proof-world-pc before) (allocation-large-string-address origin 21))
                  (posp address) (<= 32 size) (proof-span-p address size)
                  (<= 128 base) (equal (proof-world-reg 21 before) (- base 128))
                  (proof-disjoint-p address (+ address size) (- base 128) base)
                  (< (+ (proof-string-bytes-since-collection before) size) *allocation-word-modulus*)
                  (equal after (allocation-path-end *allocation-large-insertion-path* before)))
             (and (not (proof-world-stop after))
                  (allocation-machine-state-p after)
                  (equal (proof-world-pc after) (allocation-large-string-address origin 28))
                  (allocation-large-insertion-p before after))))
  :rule-classes nil
  :hints (("Goal" :in-theory (disable allocation-unsigned-64-of-sum
                                     allocation-unsigned-64-of-difference))))

(defun allocation-large-header-p (before after)
  (let* ((address (proof-world-reg 0 before))
         (length (proof-world-reg 19 before))
         (header (+ address 24)))
    (and (equal (allocation-load-word header after) (allocation-string-header length))
         (equal (proof-world-reg 0 after)
                (proof-object-word (proof-object header :external :header 0) (proof-heap-base before)))
         (equal (proof-world-reg 1 after) (+ address 32))
         (equal (proof-world-reg 2 after) length)
         (equal (proof-heap-base after) (proof-heap-base before))
         (equal (allocation-sp after) (allocation-sp before))
         (equal (allocation-memory after)
                (allocation-memory (allocation-store-word header (allocation-string-header length) before)))
         (equal (proof-world-regions after) (proof-world-regions before))
         (equal (proof-world-replies after) (proof-world-replies before))
         (proof-streams-preserved-p before after))))

(defthm allocation-large-header-machine-edge
  (implies (and (allocation-code-origin-p origin)
                (allocation-machine-state-p before)
                (not (proof-world-stop before))
                (equal (proof-world-pc before) (allocation-large-string-address origin 28))
                (< (proof-world-reg 19 before) *proof-space-size*)
                (< (+ (proof-world-reg 0 before) 32) *allocation-word-modulus*)
                (equal after (allocation-path-end *allocation-large-header-path* before)))
           (and (not (proof-world-stop after))
                (allocation-machine-state-p after)
                (equal (proof-world-pc after) (allocation-large-string-address origin 35))
                (allocation-large-header-p before after)))
  :rule-classes nil
  :hints (("Goal" :use ((:instance allocation-string-header-fits (length (proof-world-reg 19 before))))
           :in-theory (disable allocation-unsigned-64-of-sum allocation-unsigned-64-of-difference
                               allocation-string-header-fits))))

(defthm allocation-large-restore-machine-return
  (let ((save (allocation-sp before)))
    (implies (and (allocation-machine-state-p before)
                  (not (proof-world-stop before))
                  (natp save) (< (+ save 32) *allocation-word-modulus*)
                  (equal after (allocation-path-end *allocation-large-restore-path* before)))
             (and (not (proof-world-stop after))
                  (equal (proof-world-pc after) (allocation-load-word (+ save 8) before))
                  (equal (proof-world-reg 30 after) (allocation-load-word (+ save 8) before))
                  (equal (proof-world-reg 21 after) (allocation-load-word save before))
                  (equal (proof-world-reg 19 after) (allocation-load-word (+ save 16) before))
                  (equal (proof-world-reg 20 after) (allocation-load-word (+ save 24) before))
                  (equal (allocation-sp after) (+ save 32))
                  (equal (proof-world-reg 0 after) (proof-world-reg 0 before))
                  (equal (proof-world-reg 1 after) (proof-world-reg 1 before))
                  (equal (proof-world-reg 2 after) (proof-world-reg 2 before))
                  (equal (proof-heap-base after) (proof-heap-base before))
                  (equal (allocation-memory after) (allocation-memory before))
                  (equal (proof-world-regions after) (proof-world-regions before))
                  (equal (proof-world-replies after) (proof-world-replies before))
                  (proof-streams-preserved-p before after))))
  :rule-classes nil
  :hints (("Goal" :in-theory (disable allocation-unsigned-64-of-sum allocation-unsigned-64-of-difference))))
