(in-package "BOYMOO-PROOFS")

(include-book "subseq-counts")
(include-book "roots")

(logic)
(set-verify-guards-eagerness 0)

(defconst *sequence-subseq-numeric-offset* (sequence-offset "rt:subseq-numeric"))
(defconst *sequence-subseq-grow-offset* (sequence-offset "rt:ensure-stack"))
(defconst *sequence-subseq-count-offset* (sequence-offset "rt:sequence-count"))
(defconst *sequence-subseq-negation-offset* (sequence-offset "prim:ACL2::UNARY--"))
(defconst *sequence-subseq-addition-offset* (sequence-offset "prim:ACL2::BINARY-+"))

(sequence-defpath *sequence-subseq-numeric-grow-call*
  ("rt:subseq-end-ready" 0 3)
  ("rt:subseq-numeric" 0 2))

(sequence-defpath *sequence-subseq-numeric-start-call*
  ("rt:subseq-numeric" 2 4))

(sequence-defpath *sequence-subseq-negation-call*
  ("rt:subseq-numeric" 6 3))

(sequence-defpath *sequence-subseq-addition-call*
  ("rt:subseq-numeric" 9 4))

(sequence-defpath *sequence-subseq-numeric-size-call*
  ("rt:subseq-numeric" 13 1))

(sequence-defpath *sequence-subseq-numeric-finish*
  ("rt:subseq-numeric" 14 3))

(defthm sequence-subseq-arithmetic-growth-call
  (let* ((machine (proof-world-machine before))
         (required (+ (proof-stack-top before) 16))
         (after (sequence-execute *sequence-subseq-numeric-grow-call* before)))
    (implies
     (and (consp (boymoo-model::a64-registers machine))
          (natp image-base)
          (equal (proof-world-pc before) (+ image-base *sequence-subseq-end-ready-offset*))
          (unsigned-byte-p 64 (+ image-base *sequence-subseq-numeric-offset* 8))
          (unsigned-byte-p 64 required)
          (not (and (oddp (proof-world-reg 6 before)) (oddp (proof-world-reg 7 before)))))
     (and (equal (proof-world-pc after) (+ image-base *sequence-subseq-grow-offset*))
          (equal (proof-world-reg 30 after) (+ image-base *sequence-subseq-numeric-offset* 8))
          (equal (proof-world-reg 8 after) required)
          (proof-register-frame-p 28 '(0 8) before after)
          (equal (proof-world-reg 5 after) (proof-world-reg 5 before))
          (equal (proof-world-reg 6 after) (proof-world-reg 6 before))
          (equal (proof-world-reg 7 after) (proof-world-reg 7 before))
          (equal (proof-world-reg 21 after) (proof-world-reg 21 before))
          (equal (proof-stack-top after) (proof-stack-top before))
          (equal (proof-heap-base after) (proof-heap-base before))
          (equal (cdr after) (cdr before))
          (equal (boymoo-model::a64-sp (proof-world-machine after)) (boymoo-model::a64-sp machine))
          (equal (boymoo-model::a64-memory (proof-world-machine after))
                 (boymoo-model::a64-memory machine)))))
  :hints (("Goal" :in-theory (e/d (sequence-execute boymoo-model::a64-exec-logical)
                                   (oddp evenp))
                  :expand ((:free (limit clobbers first last)
                                  (proof-register-frame-p limit clobbers first last)))))
  :rule-classes nil)

(defthm sequence-subseq-arithmetic-start-count-call
  (let* ((machine (proof-world-machine before))
         (top (proof-stack-top before))
         (source (proof-world-reg 5 before))
         (start (proof-world-reg 6 before))
         (end (proof-world-reg 7 before))
         (after (sequence-execute *sequence-subseq-numeric-start-call* before)))
    (implies
     (and (consp (boymoo-model::a64-registers machine))
          (natp image-base)
          (equal (proof-world-pc before) (+ image-base *sequence-subseq-numeric-offset* 8))
          (unsigned-byte-p 64 (+ image-base *sequence-subseq-numeric-offset* 24))
          (unsigned-byte-p 64 (+ top 16)))
     (and (equal (proof-world-pc after) (+ image-base *sequence-subseq-count-offset*))
          (equal (proof-world-reg 30 after) (+ image-base *sequence-subseq-numeric-offset* 24))
          (equal (proof-world-reg 0 after) start)
          (equal (proof-world-reg 6 after) start)
          (equal (proof-stack-top after) (+ top 16))
          (equal (proof-world-reg 21 after) (proof-world-reg 21 before))
          (equal (proof-heap-base after) (proof-heap-base before))
          (equal (cdr after) (cdr before))
          (equal (boymoo-model::a64-sp (proof-world-machine after)) (boymoo-model::a64-sp machine))
          (equal (boymoo-model::a64-memory (proof-world-machine after))
                 (boymoo-model::a64-write-bytes
                  8 (+ top 8) end
                  (boymoo-model::a64-write-bytes 8 top source (boymoo-model::a64-memory machine)))))))
  :hints (("Goal" :in-theory (enable sequence-execute)))
  :rule-classes nil)

(defthm sequence-subseq-arithmetic-negation-call
  (let* ((machine (proof-world-machine before))
         (after (sequence-execute *sequence-subseq-negation-call* before)))
    (implies
     (and (consp (boymoo-model::a64-registers machine))
          (natp image-base)
          (equal (proof-world-pc before) (+ image-base *sequence-subseq-numeric-offset* 24))
          (unsigned-byte-p 64 (+ image-base *sequence-subseq-numeric-offset* 36)))
     (and (equal (proof-world-pc after) (+ image-base *sequence-subseq-negation-offset*))
          (equal (proof-world-reg 30 after) (+ image-base *sequence-subseq-numeric-offset* 36))
          (proof-register-frame-p 28 '(0 20) before after)
          (equal (proof-world-reg 20 after) (proof-world-reg 0 before))
          (equal (proof-world-reg 0 after) (proof-world-reg 6 before))
          (equal (proof-stack-top after) (proof-stack-top before))
          (equal (proof-world-reg 21 after) (proof-world-reg 21 before))
          (equal (proof-heap-base after) (proof-heap-base before))
          (equal (cdr after) (cdr before))
          (equal (boymoo-model::a64-sp (proof-world-machine after)) (boymoo-model::a64-sp machine))
          (equal (boymoo-model::a64-memory (proof-world-machine after))
                 (boymoo-model::a64-memory machine)))))
  :hints (("Goal" :in-theory (enable sequence-execute)
                  :expand ((:free (limit clobbers first last)
                                  (proof-register-frame-p limit clobbers first last)))))
  :rule-classes nil)

(defthm sequence-subseq-arithmetic-addition-call
  (let* ((machine (proof-world-machine before))
         (slot (- (proof-stack-top before) 8))
         (after (sequence-execute *sequence-subseq-addition-call* before)))
    (implies
     (and (consp (boymoo-model::a64-registers machine))
          (natp image-base) (natp slot)
          (equal (proof-world-pc before) (+ image-base *sequence-subseq-numeric-offset* 36))
          (unsigned-byte-p 64 (+ image-base *sequence-subseq-numeric-offset* 52)))
     (and (equal (proof-world-pc after) (+ image-base *sequence-subseq-addition-offset*))
          (equal (proof-world-reg 30 after) (+ image-base *sequence-subseq-numeric-offset* 52))
          (proof-register-frame-p 28 '(0 1 2) before after)
          (equal (proof-world-reg 0 after) (proof-load-word slot machine))
          (equal (proof-world-reg 1 after) (proof-world-reg 0 before))
          (equal (proof-stack-top after) (proof-stack-top before))
          (equal (proof-world-reg 20 after) (proof-world-reg 20 before))
          (equal (proof-world-reg 21 after) (proof-world-reg 21 before))
          (equal (proof-heap-base after) (proof-heap-base before))
          (equal (cdr after) (cdr before))
          (equal (boymoo-model::a64-sp (proof-world-machine after)) (boymoo-model::a64-sp machine))
          (equal (boymoo-model::a64-memory (proof-world-machine after))
                 (boymoo-model::a64-memory machine)))))
  :hints (("Goal" :in-theory (enable sequence-execute)
                  :expand ((:free (limit clobbers first last)
                                  (proof-register-frame-p limit clobbers first last)))))
  :rule-classes nil)

(defthm sequence-subseq-arithmetic-size-count-call
  (let* ((machine (proof-world-machine before))
         (after (sequence-execute *sequence-subseq-numeric-size-call* before)))
    (implies
     (and (consp (boymoo-model::a64-registers machine))
          (natp image-base)
          (equal (proof-world-pc before) (+ image-base *sequence-subseq-numeric-offset* 52))
          (unsigned-byte-p 64 (+ image-base *sequence-subseq-numeric-offset* 56)))
     (and (equal (proof-world-pc after) (+ image-base *sequence-subseq-count-offset*))
          (equal (proof-world-reg 30 after) (+ image-base *sequence-subseq-numeric-offset* 56))
          (consp (boymoo-model::a64-registers (proof-world-machine after)))
          (proof-register-frame-p 28 nil before after)
          (equal (proof-world-reg 0 after) (proof-world-reg 0 before))
          (equal (proof-stack-top after) (proof-stack-top before))
          (equal (proof-world-reg 20 after) (proof-world-reg 20 before))
          (equal (proof-world-reg 21 after) (proof-world-reg 21 before))
          (equal (proof-heap-base after) (proof-heap-base before))
          (equal (cdr after) (cdr before))
          (equal (boymoo-model::a64-sp (proof-world-machine after)) (boymoo-model::a64-sp machine))
          (equal (boymoo-model::a64-memory (proof-world-machine after))
                 (boymoo-model::a64-memory machine)))))
  :hints (("Goal" :in-theory (enable sequence-execute)
                  :expand ((:free (limit clobbers first last)
                                  (proof-register-frame-p limit clobbers first last)))))
  :rule-classes nil)

(defthm sequence-subseq-arithmetic-finish-effects
  (let* ((machine (proof-world-machine before))
         (slot (- (proof-stack-top before) 16))
         (after (sequence-execute *sequence-subseq-numeric-finish* before)))
    (implies
     (and (consp (boymoo-model::a64-registers machine))
          (natp image-base) (natp slot)
          (equal (proof-world-pc before) (+ image-base *sequence-subseq-numeric-offset* 56))
          (unsigned-byte-p 64 (+ image-base *sequence-subseq-checked-offset*)))
     (and (equal (proof-world-pc after) (+ image-base *sequence-subseq-checked-offset*))
          (equal (proof-world-reg 19 after) (proof-world-reg 0 before))
          (equal (proof-world-reg 20 after) (proof-world-reg 20 before))
          (equal (proof-world-reg 21 after) (proof-world-reg 21 before))
          (equal (proof-world-reg 0 after) (proof-load-word slot machine))
          (equal (proof-stack-top after) slot)
          (equal (proof-heap-base after) (proof-heap-base before))
          (equal (cdr after) (cdr before))
          (equal (boymoo-model::a64-sp (proof-world-machine after)) (boymoo-model::a64-sp machine))
          (equal (boymoo-model::a64-memory (proof-world-machine after))
                 (boymoo-model::a64-memory machine)))))
  :hints (("Goal" :in-theory (enable sequence-execute)))
  :rule-classes nil)
