(in-package "BOYMOO-PROOFS")

(include-book "bounded-entry")
(include-book "expansion-link")
(include-book "source-layout")
(include-book "darwin-kernel")
(include-book "generator-acceptance")

(logic)
(set-verify-guards-eagerness 0)

(local
 (defconst *assembly-echo-program*
   "(target linux)
(package \"COMMON-LISP\" COMMON-LISP::NIL)
(package \"ACL2\" COMMON-LISP::NIL)
(package \"KEYWORD\" COMMON-LISP::NIL)
(package \"ACL2-INPUT-CHANNEL\" COMMON-LISP::NIL)
(package \"ACL2-OUTPUT-CHANNEL\" COMMON-LISP::NIL)
(define COMMON-LISP::NIL (ACL2::ECHO (ACL2::INPUT) ACL2::INPUT))
(entry ACL2::ECHO)
"))

(local
 (defun assembly-check-linux-echo ()
   (let* ((text *assembly-echo-program*)
          (items (assembly-linux-items-from-text text))
          (file (boymoo-compiler::compile-text text))
          (machine (boymoo-model::a64-state nil #xa000 0 0 nil))
          (regions (list (proof-region #x8000 #xa000 :rw)))
          (replies '(#x100000000000 #x200000000000 #x300000000000 #x400000000000 2 0 0 1 1))
          (before (proof-load-linux file machine regions 4096 "Az" replies)))
     (and (equal (length file) 50256)
          (assembly-image-program-p items)
          (proof-elf-p file)
          (proof-linked-image-p items "os:main" *proof-linux-code-base* before)
          (equal (proof-world-pc before) (+ *proof-linux-code-base* 108))
          (mv-let (reason after)
            (proof-run 30000 nil before)
            (and (equal reason '(:exit . 0))
                 (equal (proof-world-stdout after) '(65 122))
                 (not (proof-world-stderr after))
                 (not (proof-world-replies after))))))))

(assert-event (assembly-check-linux-echo))

(local
 (defun assembly-check-address-wrap (rd)
   (let* ((end (expt 2 64))
          (base (- end 4096))
          (pad (coerce (assembly-zero-characters 4088) 'string))
          (items (list (list :image 4088 (list pad))
                       '(:label "entry") (list :adr-far rd "end") '(:label "end"))))
     (mv-let (image offset)
       (boymoo-compiler::a64-assemble-image items "entry")
       (let* ((machine (boymoo-model::a64-state '((2 . 21)) 128 (+ base offset) 9 nil))
              (machine (proof-load-cleared-string
                        (boymoo-compiler::image-string (cdr image)) base machine))
              (before (proof-world machine (list (proof-region base end :rx))
                                   4096 nil nil nil nil nil)))
         (and (assembly-image-program-p items)
              (proof-linked-image-p items "entry" base before)
              (mv-let (reason after)
                (proof-run 2 '(0) before)
                (and (eq reason :cut)
                     (equal (proof-world-pc after) 0)
                     (equal (proof-world-reg 2 after) (if (equal rd 2) 0 21))
                     (equal (boymoo-model::a64-sp (proof-world-machine after)) 128)
                     (equal (boymoo-model::a64-nzcv (proof-world-machine after)) 9)))))))))

(assert-event (and (assembly-check-address-wrap 2)
                   (assembly-check-address-wrap 31)))

(local
 (defconst *assembly-branching-program*
   "(package \"COMMON-LISP\" COMMON-LISP::NIL)
(package \"ACL2\" COMMON-LISP::NIL)
(package \"KEYWORD\" COMMON-LISP::NIL)
(package \"ACL2-INPUT-CHANNEL\" COMMON-LISP::NIL)
(package \"ACL2-OUTPUT-CHANNEL\" COMMON-LISP::NIL)
(define COMMON-LISP::NIL (ACL2::PASS (ACL2::INPUT) (COMMON-LISP::QUOTE \"constant\")))
(define COMMON-LISP::NIL (ACL2::PASS (ACL2::INPUT) ACL2::INPUT))
(define COMMON-LISP::NIL (ACL2::MAIN (ACL2::INPUT) (COMMON-LISP::IF (COMMON-LISP::CONSP ACL2::INPUT) ((COMMON-LISP::LAMBDA (ACL2::N) ACL2::N) (ACL2::BINARY-+ (COMMON-LISP::QUOTE 1) (COMMON-LISP::QUOTE 2))) (ACL2::PASS ACL2::INPUT))))
(entry ACL2::MAIN)
"))

(local
 (defun assembly-check-branching-program ()
   (let* ((text *assembly-branching-program*)
          (linux (concatenate 'string "(target linux)
" text))
          (inputs (assembly-read-compiler-inputs text))
          (linux-inputs (assembly-read-compiler-inputs linux))
          (items (assembly-compiler-input-items inputs))
          (labels (assembly-labels items 0))
          (file (boymoo-compiler::compile-text text))
          (base #x100008000)
          (code-base (+ base *assembly-macho-code-offset*))
          (start (+ code-base (assembly-label-offset "rt:start" labels)))
          (stack #x200004000)
          (machine (boymoo-model::a64-state nil stack 0 0 nil))
          (regions (list (proof-region #x200000000 stack :rw)))
          (world (assembly-compiled-macho-start text base machine regions "Az"))
          (pc (+ code-base 144))
          (padding (+ code-base (assembly-size items))))
     (and (assembly-bounded-compiler-text-p text)
          (assembly-bounded-compiler-text-p linux)
          (assembly-source-layout-input-p text)
          (assembly-source-layout-input-p linux)
          (mv-let (accepted code)
            (assembly-checked-gen-functions (cadr inputs) (car inputs) (caddr inputs) 0 nil)
            (declare (ignore code))
            accepted)
          (assembly-image-program-p items)
          (assembly-image-program-p (assembly-compiler-input-items linux-inputs))
          (equal (length file) 66176)
          (assembly-macho-file-p file)
          (equal (assembly-macho-entry-offset file) #x1090)
          (proof-linked-image-p items "os:main" code-base world)
          (equal (proof-world-pc world) pc)
          (< padding (+ base (assembly-macho-text-size file)))
          (equal (boymoo-model::a64-load 1 padding (proof-world-machine world)) 0)
          (mv-let (reason next)
            (proof-run 1 (list start) world)
            (and (eq reason :cut)
                 (equal (proof-world-pc next) start)
                 (equal (proof-world-reg 30 next) (+ pc 4))))))))

(assert-event (assembly-check-branching-program))

(local
 (defun assembly-check-attachment-input (text terminal)
   (mv-let (accepted lines defs names resolved packages entry target)
     (assembly-checked-text-index text)
     (declare (ignore lines defs names packages target))
     (if terminal
         (and accepted (equal (boymoo-compiler::index-get entry resolved) terminal))
       (not accepted)))))

(assert-event
 (and (mv-let (accepted lines)
        (assembly-checked-read-program *assembly-branching-program*)
        (and accepted (equal lines (boymoo-compiler::read-program *assembly-branching-program*))))
      (mv-let (accepted lines)
        (assembly-checked-read-program "(entry ACL2::MAIN
")
        (and (not accepted) (null lines)))
      (assembly-check-attachment-input "(attach ACL2::A ACL2::B)
(entry ACL2::A)
" "ACL2::B")
      (assembly-check-attachment-input "(attach ACL2::A ACL2::B)
(attach ACL2::B ACL2::A)
(entry ACL2::A)
" nil)
      (assembly-canonical-integer-token-p "-1729" 0 5)
      (not (assembly-canonical-integer-token-p "-0" 0 2))))

(local
 (defun assembly-check-darwin-echo-replies (before)
   (let* ((message "cannot write standard output")
          (success (update-nth 6 '((:ok . 1) (:ok . 1)) before))
          (failure (update-nth 6 (list '(:ok . 1) '(:error . 5)
                                      (cons :ok (length message)) '(:ok . 1))
                               before)))
     (and
      (mv-let (reason after)
        (assembly-darwin-run 1000 nil success)
        (and (equal reason '(:exit . 0))
             (equal (proof-world-stdout after) '(65 122))
             (not (proof-world-stderr after))
             (not (proof-world-replies after))))
      (mv-let (reason after)
        (assembly-darwin-run 1000 nil failure)
        (and (equal reason '(:exit . 2))
             (equal (proof-world-stdout after) '(65))
             (equal (proof-world-stderr after)
                    (append (proof-string-bytes (coerce message 'list)) '(10)))
             (not (proof-world-replies after))))))))

(local
 (defun assembly-check-darwin-echo ()
   (let* ((text (subseq *assembly-echo-program* (length "(target linux)
") nil))
          (file (boymoo-compiler::compile-text text))
          (base #x100008000)
          (code-base (+ base *assembly-macho-code-offset*))
          (stack #x200004000)
          (machine (boymoo-model::a64-state nil stack 0 0 nil))
          (regions (list (proof-region #x200000000 stack :rw)))
          (replies '((:ok . #x100000000000) (:ok . #x200000000000)
                     (:ok . #x300000000000) (:ok . #x400000000000)
                     (:ok . 2) (:ok . 0) (:ok . 0)))
          (world (assembly-load-macho-handoff file base machine regions "Az" replies))
          (mappings (proof-world-regions world))
          (linkedit (+ base (assembly-macho-text-size file)))
          (items (assembly-compiler-input-items (assembly-read-compiler-inputs text)))
          (write (+ code-base (assembly-label-offset "sys:write" (assembly-labels items 0)))))
     (and (assembly-source-layout-input-p text)
          (assembly-image-program-p items)
          (equal (length file) 66176)
          (proof-linked-image-p items "os:main" code-base world)
          (equal (proof-world-pc world) (+ code-base 144))
          (proof-covered-p linkedit 4 :read (assembly-macho-data-regions mappings))
          (not (proof-covered-p linkedit 4 :write (assembly-macho-data-regions mappings)))
          (not (proof-covered-p linkedit 4 :execute mappings))
          (mv-let (reason before)
            (assembly-darwin-run 30000 (list write) world)
            (and (eq reason :cut)
                 (not (proof-world-replies before))
                 (assembly-check-darwin-echo-replies before)))))))

(assert-event (assembly-check-darwin-echo))
