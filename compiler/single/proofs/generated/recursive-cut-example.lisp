(in-package "BOYMOO-PROOFS")

(include-book "frame-cuts")

(logic)
(set-verify-guards-eagerness 0)

(defconst *generated-recursive-cut-example-items*
  '((:label "start")
    (:movz 0 2 0)
    (:bl "recur")
    (:label "done")
    (:b "done")
    (:label "recur")
    (:stp-pre 19 30 31 -16)
    (:cmp 0 0)
    (:b-cond :eq "return")
    (:sub 0 0 1)
    (:label "call")
    (:bl "recur")
    (:label "continuation")
    (:add 0 0 1)
    (:label "return")
    (:ldp-post 19 30 31 16)
    (:ret)))

(defund generated-recursive-cut-example ()
  (let ((base #x1000) (sp #x3000) (items *generated-recursive-cut-example-items*))
    (mv-let (bytes location) (boymoo-compiler::a64-assemble items "start")
      (mv-let (size labels reversed) (boymoo-compiler::a64-layout items 0 nil nil)
        (declare (ignore reversed))
        (let* ((entry (+ base location))
               (call (+ base (boymoo-compiler::a64-offset "call" labels)))
               (continuation (+ base (boymoo-compiler::a64-offset "continuation" labels)))
               (memory (proof-overlay-bytes (proof-string-bytes (coerce bytes 'list)) base nil t))
               (machine (boymoo-model::a64-state nil sp entry 0 memory))
               (regions (list (proof-region base (+ base size) :rx) (proof-region #x2000 sp :rw)))
               (initial (proof-world machine regions 4096 nil nil nil nil nil)))
          (mv-let (ready-reason ready) (proof-run 64 (list call) initial)
            (mv-let (pc-reason pc-cut) (proof-run 64 (list continuation) ready)
              (mv-let (frame-reason frame-cut)
                (generated-frame-run 64 (list (cons continuation (generated-sp ready))) ready)
                (list (list ready-reason (generated-frame-key ready))
                      (list pc-reason (generated-frame-key pc-cut) (proof-world-reg 0 pc-cut))
                      (list frame-reason (generated-frame-key frame-cut) (proof-world-reg 0 frame-cut)))))))))))

(defthm generated-recursive-cutpoint-needs-restored-stack-pointer
  (equal (generated-recursive-cut-example)
         '((:cut (#x101c . #x2ff0))
           (:cut (#x1020 . #x2fe0) 0)
           (:cut (#x1020 . #x2ff0) 1)))
  :rule-classes nil)
