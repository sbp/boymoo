(in-package "BOYMOO-PROOFS")

(include-book "machine")
(include-book "sweep-input")
(include-book "sweep-loop")
(include-book "../foundations/checks")

(logic)
(set-verify-guards-eagerness 0)

(defconst *collection-example-base* #x100000)
(defconst *collection-example-code-base* #x1000000000)
(defconst *collection-example-stack* #x300000000)
(defconst *collection-example-machine-base* #x400000000)

(defconst *collection-example-items*
  (append (collection-slice "sys:release" "sys:read"
                            (boymoo-compiler::linux-system-code))
          (collection-slice "sys:write" "os:main"
                            (boymoo-compiler::linux-system-code))
          (collection-slice "rt:alloc" "rt:new-large-string"
                            (boymoo-compiler::runtime-memory-code))
          (collection-slice "rt:memory" "rt:stack-size"
                            (boymoo-compiler::runtime-stop-code))
          (collection-slice "rt:write-all" "rt:stop-with-datum"
                            (boymoo-compiler::runtime-stop-code))
          '((:label "collection:done") (:ret))))

(defconst *collection-example-layout*
  (mv-let (end labels reversed)
    (boymoo-compiler::a64-layout *collection-example-items* 0 nil nil)
    (list end labels reversed)))

(defun collection-example-label (label)
  (+ *collection-example-code-base*
     (boymoo-compiler::a64-offset label (cadr *collection-example-layout*))))

(defun collection-example-packages ()
  (list (proof-package "COMMON-LISP"
                       (acl2::intern-in-package-of-symbol "ACL2-PKG-WITNESS" nil)
                       t nil)))

(defun collection-example-static ()
  (let ((lines '(("package" "\"COMMON-LISP\"" "COMMON-LISP::NIL"))))
    (mv-let (image constants)
      (boymoo-compiler::data-build lines lines)
      (declare (ignore constants))
      image)))

(defun collection-example-world (label stack-words box-bytes cons-bytes
                                 external regs replies)
  (let* ((base *collection-example-base*)
         (stack *collection-example-stack*)
         (stack-end (+ stack *proof-value-reservation*))
         (machine-base *collection-example-machine-base*)
         (machine-end (+ machine-base *proof-machine-reservation*))
         (static (collection-example-static))
         (active (proof-align-up (+ base (car static)) *proof-runtime-page*))
         (inactive (+ active *proof-space-size*))
         (end (+ inactive *proof-space-size*))
         (code (boymoo-compiler::a64-write
                (caddr *collection-example-layout*) (car *collection-example-layout*)
                (cadr *collection-example-layout*) nil))
         (registers (append regs
                            (list (cons 23 (+ machine-base *proof-machine-margin*))
                                  (cons 24 (+ stack *proof-runtime-page*))
                                  (cons 25 (+ stack (* 8 stack-words)))
                                  (cons 26 (+ active (- *proof-runtime-page* cons-bytes)))
                                  (cons 27 (+ active box-bytes)) (cons 28 base)
                                  (cons 30 (collection-example-label "collection:done")))))
         (machine (boymoo-model::a64-state
                   registers machine-end (collection-example-label label) 0 nil))
         (machine (proof-load-cleared-string
                   (boymoo-compiler::image-string code) *collection-example-code-base* machine))
         (machine (proof-load-cleared-string
                   (boymoo-compiler::image-string (cdr static)) base machine))
         (machine (proof-check-write-words
                   (list (cons 0 active) (cons 8 inactive) (cons 16 (- inactive cons-bytes))
                         (cons 24 inactive) (cons 32 end)
                         (cons 40 stack) (cons 48 stack-end) (cons 56 external)
                         (cons 64 end) (cons 80 *proof-minimum-string-budget*))
                   (- base 128) machine))
         (regions (list (proof-region *collection-example-code-base*
                                      (+ *collection-example-code-base*
                                         (car *collection-example-layout*))
                                      :rx)
                        (proof-region (- base *proof-heap-prefix*) end :rw)
                        (proof-region stack stack-end :rw)
                        (proof-region machine-base machine-end :rw))))
    (proof-world machine regions 4096 nil nil nil replies nil)))

(defun collection-example-add-mapping (head next length world)
  (let* ((bytes (proof-align-up (+ 32 length) *proof-runtime-page*))
         (world (collection-write-word head next world))
         (world (collection-write-word (+ head 8) bytes world))
         (world (collection-write-word (+ head 24) (+ 1 (* 256 length)) world)))
    (update-nth 1
                (cons (proof-region head (+ head bytes) :rw) (proof-world-regions world))
                world)))

(defun collection-unaligned-external-example ()
  (let* ((head #x8008)
         (objects (cons (proof-object (+ head 24) :external :header 0)
                        (proof-check-static-objects *collection-example-base*)))
         (world (collection-example-world "rt:sweep-strings" 0 0 0 head nil '(0)))
         (world (collection-example-add-mapping head 0 0 world)))
    (and (proof-heap-p world objects (collection-example-packages))
         (mv-let (reason after)
           (proof-run 64 (list (collection-example-label "collection:done")) world)
           (and (equal reason :kernel-contract)
                (equal (proof-world-reg 8 after) 215)
                (equal (proof-world-reg 0 after) head)
                (equal (proof-world-reg 1 after) *proof-runtime-page*))))))

(assert-event (collection-unaligned-external-example))

(defun collection-no-frame-space-example ()
  (let* ((world (collection-example-world "rt:collect" 0 0 0 0
                                          '((0 . 8) (1 . 0)) nil))
         (machine (boymoo-model::a64-write-reg
                   31 64 t *collection-example-machine-base* (proof-world-machine world)))
         (world (update-nth 0 machine world))
         (objects (proof-check-static-objects *collection-example-base*)))
    (and (proof-heap-p world objects (collection-example-packages))
         (equal (proof-world-stop (proof-step world)) :fault))))

(assert-event (collection-no-frame-space-example))

(defun collection-noncanonical-memory-key-example ()
  (let ((before (proof-world (boymoo-model::a64-state nil 0 0 0
                                                    '((0 . 7) (3/2 . 0)))
                             nil 4096 nil nil nil nil nil))
        (middle (proof-world (boymoo-model::a64-state nil 0 0 0 '((0 . 7)))
                             nil 4096 nil nil nil nil nil))
        (after (proof-world (boymoo-model::a64-state nil 0 0 0 '((0 . 9)))
                            nil 4096 nil nil nil nil nil)))
    (and (proof-memory-span-agrees-p 1 8 before middle)
         (proof-memory-span-agrees-p 1 8 middle after)
         (not (proof-memory-span-agrees-p 1 8 before after)))))

(assert-event (collection-noncanonical-memory-key-example))

(defconst *collection-example-live-mapping* #x8000)
(defconst *collection-example-dead-mapping* #x500000000)

(defun collection-example-mixed-world (request mode replies)
  (let* ((live *collection-example-live-mapping*)
         (dead *collection-example-dead-mapping*)
         (base *collection-example-base*)
         (stack *collection-example-stack*)
         (world (collection-example-world "rt:collect" 2 40 32 dead
                                          (list (cons 0 request) (cons 1 mode))
                                          replies))
         (world (collection-example-add-mapping dead live 0 world))
         (world (collection-example-add-mapping live 0 1 world))
         (world (collection-write-word (+ live 32) 65 world))
         (box (proof-active-floor world))
         (end (proof-active-end world))
         (first (- end 16))
         (second (- end 32))
         (first-word (- first base))
         (external (boymoo-model::a64-unsigned 64 (- (+ live 26) base)))
         (world (collection-write-word box (+ (* 256 16) 6) world))
         (world (collection-write-word (+ box 8) (- second base) world))
         (world (collection-write-word (+ box 16) (- (+ box 26) base) world))
         (world (collection-write-word (+ box 24) (+ (* 256 3) 1) world))
         (world (collection-write-word (+ box 32) #x434241 world))
         (world (collection-write-word first (- (+ box 2) base) world))
         (world (collection-write-word (+ first 8) external world))
         (world (collection-write-word second external world))
         (world (collection-write-word (+ second 8) *proof-nil* world))
         (world (collection-write-word stack first-word world)))
    (collection-write-word (+ stack 8) first-word world)))

(defun collection-example-mixed-objects (box end dead)
  (append (list (proof-object (- end 16) :active :cons 4)
                (proof-object (- end 32) :active :cons 2)
                (proof-object box :active :header 3)
                (proof-object (+ box 24) :active :header 0)
                (proof-object (+ *collection-example-live-mapping* 24)
                              :external :header 0))
          (if dead
              (list (proof-object (+ *collection-example-dead-mapping* 24)
                                  :external :header 0))
            nil)
          (proof-check-static-objects *collection-example-base*)))

(defun collection-example-mixed-return (mode)
  (let* ((before (collection-example-mixed-world 16 mode '(0 0 0)))
         (floor (proof-inactive-floor before))
         (end (proof-inactive-end before))
         (base *collection-example-base*)
         (stack *collection-example-stack*)
         (live *collection-example-live-mapping*)
         (dead *collection-example-dead-mapping*)
         (first (- (- end 16) base))
         (old (collection-example-mixed-objects (proof-active-floor before)
                                                (proof-active-end before) t))
         (new (collection-example-mixed-objects floor end nil))
         (packages (collection-example-packages))
         (kind (if (equal mode 0) :header :cons)))
    (and (proof-heap-p before old packages)
         (mv-let (reason after)
           (proof-run 512 (list (collection-example-label "collection:done")) before)
           (and (eq reason :cut)
                (proof-collector-return-p kind 16 before after old new packages)
                (equal (proof-world-reg 0 after)
                       (if (eq kind :header) (+ floor 40) (- end 48)))
                (equal (collection-read-word stack after) first)
                (equal (collection-read-word (+ stack 8) after) first)
                (equal (collection-read-word (+ floor 8) after) (- (- end 32) base))
                (equal (collection-read-word (proof-active-floor before) after) 0)
                (equal (collection-read-word (proof-cons-floor before) after) 0)
                (equal (proof-external-head after) live)
                (equal (collection-read-word (+ live 16) after) 0)
                (not (proof-covered-p dead 1 :read (proof-world-regions after)))
                (null (proof-world-replies after)))))))

(assert-event (collection-example-mixed-return 0))
(assert-event (collection-example-mixed-return 1))

(defun collection-example-large-request-stops ()
  (let* ((capacity *proof-space-size*)
         (retained 72)
         (request (+ capacity 8))
         (too-large (collection-example-mixed-world request 0 '(38 1)))
         (too-full (collection-example-mixed-world capacity 0 '(44 1))))
    (and (proof-resource-bound-p :allocation-size request too-large)
         (proof-resource-bound-p :heap-size (+ capacity retained) too-full)
         (proof-resource-observation-p (proof-advance 512 too-large))
         (proof-resource-observation-p (proof-advance 512 too-full)))))

(assert-event (collection-example-large-request-stops))

(defun collection-diagnostic-needs-more-stack-example ()
  (let* ((world (collection-example-world
                 "rt:collect" 0 0 0 0
                 (list (cons 0 (+ 8 *proof-space-size*)) (cons 1 0)) '(38 1)))
         (machine (boymoo-model::a64-write-reg
                   31 64 t (+ *collection-example-machine-base* 80)
                   (proof-world-machine world)))
         (world (update-nth 0 machine world))
         (objects (proof-check-static-objects *collection-example-base*))
         (after (proof-advance 64 world)))
    (and (proof-heap-p world objects (collection-example-packages))
         (proof-resource-bound-p :allocation-size (proof-world-reg 0 world) world)
         (equal (proof-world-stop after) :fault)
         (equal (proof-world-pc after) (+ 4 (collection-example-label "rt:write-all")))
         (equal (proof-world-replies after) '(38 1)))))

(assert-event (collection-diagnostic-needs-more-stack-example))

(defun collection-sweep-snapshot-example ()
  (let* ((original (collection-example-mixed-world 16 0 '(0)))
         (live *collection-example-live-mapping*)
         (dead *collection-example-dead-mapping*)
         (objects (collection-example-mixed-objects (proof-active-floor original)
                                                    (proof-active-end original) t))
         (base (proof-heap-base original))
         (machine (proof-world-machine original))
         (graph (collection-published-object-graph objects base objects machine))
         (work (collection-traverse (collection-published-roots original objects) graph
                                    (proof-inactive-floor original) (proof-inactive-end original)))
         (mappings (proof-external-objects dead (len objects) original objects))
         (records (collection-published-sweep-records (cdr mappings) original work))
         (origin *collection-example-code-base*)
         (link (- base 72))
         (entry (+ origin (collection-linux-offset "rt:sweep-string")))
         (cut (+ origin (collection-linux-offset "rt:sweep-done")))
         (image (mv-let (end labels reversed)
                  (boymoo-compiler::a64-layout *collection-linux-items* 0 nil nil)
                  (boymoo-compiler::image-string (boymoo-compiler::a64-write reversed end labels nil))))
         (machine (proof-load-cleared-string image origin machine))
         (regions (remove-equal (proof-region origin (+ origin (car *collection-example-layout*)) :rx)
                                (proof-world-regions original)))
         (world (update-nth 1 (cons (proof-region origin (+ origin (length image)) :rx) regions)
                            (update-nth 0 machine original)))
         (world (collection-write-word (+ live 16) 1 world))
         (world (collection-write-register 19 link world))
         (world (collection-write-register 22 0 world))
         (world (collection-write-pc entry world))
         (trace (collection-sweep-traversal-trace records origin)))
    (and (equal records (list (list dead *proof-runtime-page* nil)
                              (list live *proof-runtime-page* t)))
         (collection-sweep-loop-invariant-p records origin world)
         (mv-let (reason after)
           (proof-run (len trace) (list cut) world)
           (and (eq reason :cut)
                (collection-sweep-surviving-links-p link records after)
                (equal (proof-world-reg 22 after) *proof-runtime-page*)
                (not (proof-covered-p dead 1 :read (proof-world-regions after)))
                (null (proof-world-replies after)))))))

(assert-event (collection-sweep-snapshot-example))
