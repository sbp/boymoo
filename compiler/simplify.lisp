(in-package "BOYMOO-COMPILER")

(include-book "resolve")

(set-verify-guards-eagerness 0)

(defconst *inline-size* 16)
(defconst *inline-depth* 3)
(defconst *inline-search-limit* 1024)
(defconst *simplify-nil-word* 34)
(defconst *simplify-true-word* 58)

(defun simplify-next-number (numbers next)
  (if (atom numbers)
      next
    (simplify-next-number (cdr numbers) (max next (+ 1 (car numbers))))))

; Collect the outgoing calls, the size, and the first unused variable number.
(mutual-recursion
 (defun simplify-scan (term calls size next)
   (declare (xargs :measure (acl2-count term)))
   (if (atom term)
       (mv calls size next)
     (let ((size (+ 1 size)))
       (case (car term)
         (:var (mv calls size (max next (+ 1 (cadr term)))))
         (:if (simplify-scan-terms (cdr term) calls size next))
         (:let (mv-let (calls size next)
                 (simplify-scan-terms (caddr term) calls size
                                         (simplify-next-number (cadr term) next))
                 (simplify-scan (cadddr term) calls size next)))
         (:call (simplify-scan-terms (caddr term) (cons (cadr term) calls) size next))
         ((:prim :undef) (simplify-scan-terms (caddr term) calls size next))
         (otherwise (mv calls size next))))))
 (defun simplify-scan-terms (terms calls size next)
   (declare (xargs :measure (acl2-count terms)))
   (if (atom terms)
       (mv calls size next)
     (mv-let (calls size next)
       (simplify-scan (car terms) calls size next)
       (simplify-scan-terms (cdr terms) calls size next)))))

(defun simplify-analyze (definitions analysis)
  (if (atom definitions)
      analysis
    (let ((definition (car definitions)))
      (mv-let (calls size next)
        (simplify-scan (caddr definition) nil (length (cadr definition))
                          (simplify-next-number (cadr definition) 0))
        (simplify-analyze (cdr definitions)
                            (table-tree-put (car definition) (list next size calls) analysis))))))

; An inlined function must have no path from its callees back to itself.
; If the traversal uses its full budget, leave the call in place.
(defun simplify-acyclic-p (name pending analysis seen fuel)
  (declare (xargs :measure (nfix fuel)))
  (cond ((atom pending) t)
        ((zp fuel) nil)
        ((equal (car pending) name) nil)
        ((table-tree-get (car pending) seen)
         (simplify-acyclic-p name (cdr pending) analysis seen (- fuel 1)))
        (t (let* ((callee (car pending))
                  (record (table-tree-get callee analysis)))
             (simplify-acyclic-p name (append (caddr record) (cdr pending))
                                   analysis (table-tree-put callee t seen) (- fuel 1))))))

(defun simplify-inlinees (definitions analysis inlinees)
  (if (atom definitions)
      inlinees
    (let* ((definition (car definitions))
           (name (car definition))
           (record (table-tree-get name analysis))
           (inlinees
            (if (and (<= (cadr record) *inline-size*)
                     (simplify-acyclic-p name (caddr record) analysis nil
                                           *inline-search-limit*))
                (table-tree-put name (cons (car record) (cdr definition)) inlinees)
              inlinees)))
      (simplify-inlinees (cdr definitions) analysis inlinees))))

(defun simplify-boolean-word (truth)
  (if truth *simplify-true-word* *simplify-nil-word*))

(defun simplify-immediate-integer-p (word)
  (and (integerp word) (equal (low-bits word 1) 1)))

(defun simplify-signed-word (word)
  (if (< word #x8000000000000000)
      word
    (- word #x10000000000000000)))

(defun simplify-encode-integer (value)
  (if (and (<= (- (ash 1 62)) value) (< value (ash 1 62)))
      (low-bits (+ 1 (* 2 value)) 64)
    nil))

(defun simplify-character-word-p (word)
  (equal (low-bits word 3) 4))

(defun simplify-constant-symbol-p (word)
  (or (equal word *simplify-nil-word*) (equal word *simplify-true-word*)))

; A result of NIL leaves evaluation to the primitive.
(defun simplify-primitive-word (name a b)
  (cond
   ((equal name "COMMON-LISP::CONSP")
    (simplify-boolean-word (equal (low-bits a 3) 0)))
   ((and (member-equal name '("COMMON-LISP::CAR" "COMMON-LISP::CDR"))
         (not (equal (low-bits a 3) 0)))
    *simplify-nil-word*)
   ((equal name "COMMON-LISP::CHARACTERP")
    (simplify-boolean-word (simplify-character-word-p a)))
   ((equal name "COMMON-LISP::CHAR-CODE")
    (if (simplify-character-word-p a) (+ 1 (* 2 (ash a -3))) 1))
   ((equal name "COMMON-LISP::CODE-CHAR")
    (if (and (simplify-immediate-integer-p a) (< a 512)) (* 4 a) 4))
   ((member-equal name '("COMMON-LISP::INTEGERP" "COMMON-LISP::RATIONALP" "ACL2::ACL2-NUMBERP"))
    (cond ((simplify-immediate-integer-p a) *simplify-true-word*)
          ((or (not (equal (low-bits a 3) 2)) (simplify-constant-symbol-p a))
           *simplify-nil-word*)
          (t nil)))
   ((and (member-equal name '("COMMON-LISP::STRINGP" "COMMON-LISP::SYMBOLP"
                              "ACL2::COMPLEX-RATIONALP"))
         (not (equal (low-bits a 3) 2)))
    *simplify-nil-word*)
   ((and (equal name "COMMON-LISP::SYMBOLP") (simplify-constant-symbol-p a))
    *simplify-true-word*)
   ((equal name "COMMON-LISP::EQUAL")
    (cond ((equal a b) *simplify-true-word*)
          ((or (simplify-immediate-integer-p a) (simplify-immediate-integer-p b)
               (simplify-character-word-p a) (simplify-character-word-p b)
               (simplify-constant-symbol-p a) (simplify-constant-symbol-p b))
           *simplify-nil-word*)
          (t nil)))
   ((equal name "ACL2::BAD-ATOM<=") *simplify-nil-word*)
   ((and (equal name "ACL2::UNARY--") (simplify-immediate-integer-p a))
    (simplify-encode-integer (- (ash (simplify-signed-word a) -1))))
   ((and (simplify-immediate-integer-p a) (simplify-immediate-integer-p b))
    (let ((a (ash (simplify-signed-word a) -1))
          (b (ash (simplify-signed-word b) -1)))
      (cond ((equal name "ACL2::BINARY-+") (simplify-encode-integer (+ a b)))
            ((equal name "ACL2::BINARY-*") (simplify-encode-integer (* a b)))
            ((equal name "COMMON-LISP::<") (simplify-boolean-word (< a b)))
            (t nil))))
   (t nil)))

(defun simplify-primitive (name args)
  (let ((word (and (eq (caar args) :const)
                   (or (atom (cdr args)) (eq (caadr args) :const))
                   (not (cddr args))
                   (simplify-primitive-word name (cadar args) (cadadr args)))))
    (if word (list :const word) (list :prim name args))))

(defun simplify-shift-numbers (numbers offset)
  (if (atom numbers)
      nil
    (cons (+ offset (car numbers)) (simplify-shift-numbers (cdr numbers) offset))))

(defun simplify-bind (numbers args aliases)
  (if (atom numbers)
      (mv nil nil aliases)
    (if (member-eq (caar args) '(:var :const))
        (simplify-bind (cdr numbers) (cdr args)
                          (table-tree-put (car numbers) (car args) aliases))
      (mv-let (numbers1 args1 aliases)
        (simplify-bind (cdr numbers) (cdr args) aliases)
        (mv (cons (car numbers) numbers1) (cons (car args) args1) aliases)))))

(defun simplify-let (numbers args body)
  (if (consp numbers) (list :let numbers args body) body))

; Return the test to evaluate, a known outcome, and whether to swap the arms.
(defun simplify-test (test)
  (cond ((eq (car test) :const)
         (mv nil (if (equal (cadr test) *simplify-nil-word*) :no :yes) nil))
        ((and (eq (car test) :if) (eq (car (caddr test)) :const)
              (eq (car (cadddr test)) :const))
         (let ((yes (not (equal (cadr (caddr test)) *simplify-nil-word*)))
               (no (not (equal (cadr (cadddr test)) *simplify-nil-word*))))
           (if (eq yes no)
               (mv (cadr test) (if yes :yes :no) nil)
             (mv (cadr test) nil no))))
        (t (mv test nil nil))))

(defun simplify-variable (number aliases facts)
  (let ((value (or (table-tree-get number aliases) (list :var number))))
    (if (and (eq (car value) :var) (eq (table-tree-get (cadr value) facts) :nil))
        (list :const *simplify-nil-word*)
      value)))

(defun simplify-test-fact (test truth facts)
  (if (eq (car test) :var)
      (table-tree-put (cadr test) (if truth :non-nil :nil) facts)
    facts))

; OFFSET shifts the variable numbers of the source term into a fresh interval.
; NEXT is beyond every interval used in this definition.
(mutual-recursion
 (defun simplify-term (term offset aliases facts inlinees depth next)
   (declare (xargs :measure (make-ord 1 (+ 1 (nfix depth)) (acl2-count term))
                   :ruler-extenders :all))
   (if (atom term)
       (mv term next)
     (case (car term)
       (:var (mv (simplify-variable (+ offset (cadr term)) aliases facts) next))
       (:if
        (mv-let (test next)
          (simplify-term (cadr term) offset aliases facts inlinees depth next)
          (mv-let (test outcome swap)
            (simplify-test test)
            (let* ((known (and (eq (car test) :var) (table-tree-get (cadr test) facts)))
                   (outcome (or outcome (if (eq known :non-nil) :yes nil)))
                   (yes (if swap (cadddr term) (caddr term)))
                   (no (if swap (caddr term) (cadddr term))))
              (if outcome
                  (let ((number next)
                        (evaluate (and test (not (member-eq (car test) '(:var :const))))))
                    (mv-let (body next)
                      (simplify-term (if (eq outcome :yes) yes no) offset aliases facts
                                        inlinees depth (if evaluate (+ 1 next) next))
                      (mv (if evaluate (list :let (list number) (list test) body) body) next)))
                (mv-let (yes next)
                  (simplify-term yes offset aliases (simplify-test-fact test t facts)
                                    inlinees depth next)
                  (mv-let (no next)
                    (simplify-term no offset aliases (simplify-test-fact test nil facts)
                                      inlinees depth next)
                    (mv (list :if test yes no) next))))))))
       (:let
        (mv-let (args next)
          (simplify-terms (caddr term) offset aliases facts inlinees depth next)
          (mv-let (numbers args aliases)
            (simplify-bind (simplify-shift-numbers (cadr term) offset) args aliases)
            (mv-let (body next)
              (simplify-term (cadddr term) offset aliases facts inlinees depth next)
              (mv (simplify-let numbers args body) next)))))
       ((:call :prim :undef)
        (mv-let (args next)
          (simplify-terms (caddr term) offset aliases facts inlinees depth next)
          (let* ((name (cadr term))
                 (inlinee (and (eq (car term) :call) (not (zp depth))
                               (table-tree-get name inlinees))))
            (cond (inlinee
                   (mv-let (numbers args aliases)
                     (simplify-bind (simplify-shift-numbers (cadr inlinee) next)
                                       args aliases)
                     (mv-let (body next)
                       (simplify-term (caddr inlinee) next aliases facts inlinees (- depth 1)
                                         (+ next (car inlinee)))
                       (mv (simplify-let numbers args body) next))))
                  ((eq (car term) :prim) (mv (simplify-primitive name args) next))
                  (t (mv (list (car term) name args) next))))))
       (otherwise (mv term next)))))
 (defun simplify-terms (terms offset aliases facts inlinees depth next)
   (declare (xargs :measure (make-ord 1 (+ 1 (nfix depth)) (acl2-count terms))
                   :ruler-extenders :all))
   (if (atom terms)
       (mv nil next)
     (mv-let (term next)
       (simplify-term (car terms) offset aliases facts inlinees depth next)
       (mv-let (terms next)
         (simplify-terms (cdr terms) offset aliases facts inlinees depth next)
         (mv (cons term terms) next))))))

; These primitives finish with a value in bounded auxiliary space.
(defun simplify-discardable-primitive-p (name)
  (member-equal name
                '("ACL2::ACL2-NUMBERP" "ACL2::BAD-ATOM<=" "ACL2::COMPLEX-RATIONALP"
                  "COMMON-LISP::CAR" "COMMON-LISP::CDR" "COMMON-LISP::CHAR"
                  "COMMON-LISP::CHAR-CODE" "COMMON-LISP::CHARACTERP" "COMMON-LISP::CODE-CHAR"
                  "COMMON-LISP::CONSP" "COMMON-LISP::DENOMINATOR"
                  "COMMON-LISP::IMAGPART" "COMMON-LISP::INTEGERP" "COMMON-LISP::LENGTH"
                  "COMMON-LISP::NUMERATOR" "COMMON-LISP::RATIONALP" "COMMON-LISP::REALPART"
                  "COMMON-LISP::STRINGP" "COMMON-LISP::SYMBOLP")))

(mutual-recursion
 (defun simplify-discardable-p (term)
   (declare (xargs :measure (acl2-count term)))
   (and (consp term)
        (case (car term)
          ((:var :const) t)
          (:prim (and (simplify-discardable-primitive-p (cadr term))
                      (simplify-discardable-list-p (caddr term))))
          (otherwise nil))))
 (defun simplify-discardable-list-p (terms)
   (declare (xargs :measure (acl2-count terms)))
   (or (atom terms)
       (and (simplify-discardable-p (car terms))
            (simplify-discardable-list-p (cdr terms))))))

; Visit the body before the bindings. A use is recorded only in retained code.
(mutual-recursion
 (defun simplify-live-term (term used)
   (declare (xargs :measure (acl2-count term)))
   (if (atom term)
       (mv term used)
     (case (car term)
       (:var (mv term (table-tree-put (cadr term) t used)))
       (:if (mv-let (args used)
              (simplify-live-terms (cdr term) used)
              (mv (cons :if args) used)))
       (:let (mv-let (body used)
               (simplify-live-term (cadddr term) used)
               (mv-let (numbers args used)
                 (simplify-live-bindings (cadr term) (caddr term) used)
                 (mv (simplify-let numbers args body) used))))
       ((:call :prim :undef)
        (mv-let (args used)
          (simplify-live-terms (caddr term) used)
          (mv (list (car term) (cadr term) args) used)))
       (otherwise (mv term used)))))
 (defun simplify-live-terms (terms used)
   (declare (xargs :measure (acl2-count terms)))
   (if (atom terms)
       (mv nil used)
     (mv-let (term used)
       (simplify-live-term (car terms) used)
       (mv-let (terms used)
         (simplify-live-terms (cdr terms) used)
         (mv (cons term terms) used)))))
 (defun simplify-live-bindings (numbers args used)
   (declare (xargs :measure (acl2-count args)))
   (if (atom args)
       (mv nil nil used)
     (if (and (not (table-tree-get (car numbers) used))
              (simplify-discardable-p (car args)))
         (simplify-live-bindings (cdr numbers) (cdr args) used)
       (mv-let (arg used)
         (simplify-live-term (car args) used)
         (mv-let (numbers1 args1 used)
           (simplify-live-bindings (cdr numbers) (cdr args) used)
           (mv (cons (car numbers) numbers1) (cons arg args1) used)))))))

(defun simplify-program (definitions analysis inlinees)
  (if (atom definitions)
      nil
    (let* ((definition (car definitions))
           (name (car definition))
           (next (car (table-tree-get name analysis))))
      (mv-let (term next)
        (simplify-term (caddr definition) 0 nil nil inlinees *inline-depth* next)
        (declare (ignore next))
        (mv-let (term used)
          (simplify-live-term term nil)
          (declare (ignore used))
          (cons (list name (cadr definition) term)
                (simplify-program (cdr definitions) analysis inlinees)))))))

(defun simplify-definitions (definitions)
  (let* ((analysis (simplify-analyze definitions nil))
         (inlinees (simplify-inlinees definitions analysis nil)))
    (simplify-program definitions analysis inlinees)))
