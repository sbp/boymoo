(in-package "BOYMOO-COMPILER")

(include-book "read")

(set-verify-guards-eagerness 0)

(defun text-hash (key)
  (hash-string key 0 (length key) 0))

(defun index-get (key tree)
  (table-get key (text-hash key) 12 tree))

(defun index-set (key value tree)
  (table-put key value (text-hash key) 12 tree))

(defconst *jets*
  '(("COMMON-LISP::ASH" 2 . "jet:COMMON-LISP::ASH")
    ("ACL2::BINARY-LOGXOR" 2 . "jet:ACL2::BINARY-LOGXOR")
    ("COMMON-LISP::LENGTH" 1 . "jet:COMMON-LISP::LENGTH")
    ("COMMON-LISP::CHAR" 2 . "jet:COMMON-LISP::CHAR")
    ("COMMON-LISP::SUBSEQ" 3 . "jet:COMMON-LISP::SUBSEQ")))

(defconst *primitives*
  '(("ACL2::ACL2-NUMBERP" 1 . "prim:ACL2::ACL2-NUMBERP")
    ("ACL2::BAD-ATOM<=" 2 . "prim:ACL2::BAD-ATOM<=")
    ("ACL2::BINARY-*" 2 . "prim:ACL2::BINARY-*")
    ("ACL2::BINARY-+" 2 . "prim:ACL2::BINARY-+")
    ("ACL2::UNARY--" 1 . "prim:ACL2::UNARY--")
    ("ACL2::UNARY-/" 1 . "prim:ACL2::UNARY-/")
    ("COMMON-LISP::<" 2 . "prim:COMMON-LISP::<")
    ("COMMON-LISP::CAR" 1 . "prim:COMMON-LISP::CAR")
    ("COMMON-LISP::CDR" 1 . "prim:COMMON-LISP::CDR")
    ("COMMON-LISP::CHAR-CODE" 1 . "prim:COMMON-LISP::CHAR-CODE")
    ("COMMON-LISP::CHARACTERP" 1 . "prim:COMMON-LISP::CHARACTERP")
    ("COMMON-LISP::CODE-CHAR" 1 . "prim:COMMON-LISP::CODE-CHAR")
    ("COMMON-LISP::COMPLEX" 2 . "prim:COMMON-LISP::COMPLEX")
    ("ACL2::COMPLEX-RATIONALP" 1 . "prim:ACL2::COMPLEX-RATIONALP")
    ("COMMON-LISP::COERCE" 2 . "prim:COMMON-LISP::COERCE")
    ("COMMON-LISP::CONS" 2 . "prim:COMMON-LISP::CONS")
    ("COMMON-LISP::CONSP" 1 . "prim:COMMON-LISP::CONSP")
    ("COMMON-LISP::DENOMINATOR" 1 . "prim:COMMON-LISP::DENOMINATOR")
    ("COMMON-LISP::EQUAL" 2 . "prim:COMMON-LISP::EQUAL")
