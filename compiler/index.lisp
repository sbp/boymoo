(defun declaration-list (x)
  (if (equal x *nil-name*) nil x))

(defun index-definition-line (items defs names seen)
  (if (atom items)
      (mv defs names)
    (let* ((def (car items))
           (name (car def))
           (formals (declaration-list (cadr def))))
      (cond ((or (not (and (stringp name) (symbol-separator name)))
                 (not (and (consp (cddr def)) (not (cdddr def))))
                 (and formals (atom formals)))
             (mv (compiler-error "Invalid definition: ~x0." def) nil))
            ((or (assoc-equal name *primitives*) (equal name *if-name*))
             (mv (compiler-error "A primitive cannot be defined: ~x0." name) nil))
            ((assoc-equal name *jets*)
             (index-definition-line (cdr items) defs names seen))
            ((index-get name seen)
             (mv (compiler-error "A define line defines a function twice: ~x0." name) nil))
            (t
             (let ((seen (if (consp (cdr items)) (index-set name t seen) seen)))
               (if (index-get name names)
                   (index-definition-line (cdr items) defs names seen)
                 (index-definition-line (cdr items) (cons def defs)
                                        (index-set name (length formals) names) seen))))))))

(defun index-definitions (items defs names)
  (index-definition-line items defs names nil))

; The latest definition and attachment of each name are encountered first.
(defun index-lines (lines defs names attachments sources packages entry target)
  (if (atom lines)
      (mv defs names attachments sources packages entry target)
    (let* ((line (car lines))
           (word (car line))
           (name (cadr line)))
      (cond ((and (equal word "define") (consp (cddr line)))
             (mv-let (defs names)
               (index-definitions (reverse-onto (cddr line) nil) defs names)
               (index-lines (cdr lines) defs names attachments sources packages entry target)))
            ((equal word "attach")
             (if (or (consp (cdddr line)) (not (stringp (caddr line))) (not (stringp name))
                     (assoc-equal name *primitives*) (equal name *if-name*))
                 (mv (compiler-error "Invalid attachment: ~x0." line) nil nil nil nil nil nil)
               (if (index-get name attachments)
                   (index-lines (cdr lines) defs names attachments sources packages entry target)
                 (index-lines (cdr lines) defs names
                              (index-set name (caddr line) attachments)
                              (cons name sources) packages entry target))))
            ((and (or (equal word "package") (equal word "hidden-package"))
                  (stringp name) (equal (char name 0) #\")
                  (consp (cddr line)) (not (cdddr line))
                  (or (equal (caddr line) *nil-name*) (consp (caddr line))))
             (index-lines (cdr lines) defs names attachments sources
                          (cons line packages) entry target))
            ((and (equal word "entry") (not entry) (stringp name) (not (cddr line)))
             (index-lines (cdr lines) defs names attachments sources packages name target))
            ((and (not target) (equal line '("target" "linux")))
             (index-lines (cdr lines) defs names attachments sources packages entry :linux))
            (t (mv (compiler-error "Invalid compiler input line: ~x0." line)
                   nil nil nil nil nil nil))))))

(defun resolve-chain (name attachments resolved fuel)
  (declare (xargs :measure (nfix fuel)))
  (let ((cached (index-get name resolved))
        (next (index-get name attachments)))
    (cond ((equal cached :pending) (mv (compiler-error "Attachment cycle: ~x0." name) nil))
          (cached (mv cached resolved))
          ((or (not next) (assoc-equal name *primitives*)
               (equal name *if-name*))
           (mv name resolved))
          ((zp fuel) (mv (compiler-error "Attachment chain is too long: ~x0." name) nil))
          (t (mv-let (target resolved)
               (resolve-chain next attachments
                              (index-set name :pending resolved) (- fuel 1))
               (mv target (index-set name target resolved)))))))

(defun resolve-attachments (sources attachments resolved fuel)
  (if (atom sources)
      resolved
    (mv-let (target resolved)
      (resolve-chain (car sources) attachments resolved fuel)
      (declare (ignore target))
      (resolve-attachments (cdr sources) attachments resolved fuel))))

(defun variable-name-p (name)
  (let ((split (and (stringp name) (symbol-separator name))))
    (and split (not (equal name *nil-name*)) (not (equal name "COMMON-LISP::T"))
         (not (and (equal split 7) (equal (subseq name 0 split) "KEYWORD"))))))

(defun bind-formal (name slot scope)
  (cond ((not (variable-name-p name))
         (compiler-error "Invalid formal variable: ~x0." name))
        ((table-tree-get name scope)
         (compiler-error "Duplicate formal variable: ~x0." name))
        (t (table-tree-put name slot scope))))

(defun bind-formals (formals i scope)
  (if (atom formals)
      scope
    (bind-formals (cdr formals) (+ i 1) (bind-formal (car formals) i scope))))
