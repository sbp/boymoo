(in-package "BOYMOO-MODEL")

(include-book "a64-state")

(logic)
(set-verify-guards-eagerness 0)

(defun a64-match (word mask bits)
  (equal (logand word mask) bits))

(defun a64-ror (width word amount)
  (if (zp width)
      0
    (let* ((word (a64-unsigned width word))
           (amount (mod (nfix amount) width)))
      (a64-unsigned width (logior (ash word (- amount))
                                  (ash word (- width amount)))))))

(defun a64-replicate (count width word)
  (declare (xargs :measure (nfix count)))
  (if (zp count)
      0
    (logior word (ash (a64-replicate (1- count) width word)
                      (nfix width)))))

; The first mask selects the rotated source bits. The second selects
; the destination bits below the top of the field.
(defun a64-decode-bit-masks (width n imms immr immediate)
  (let* ((selector (logior (ash (a64-unsigned 1 n) 6)
                           (logxor 63 (a64-unsigned 6 imms))))
         (size (ash 1 (1- (integer-length selector))))
         (levels (1- size))
         (s (logand imms levels))
         (r (logand immr levels)))
    (if (or (< size 2) (< width size) (and immediate (= s levels)))
        (mv nil 0 0)
      (let ((count (floor width size))
            (diff (logand (- s r) levels)))
        (mv t
            (a64-replicate count size (a64-ror size (a64-ones (1+ s)) r))
            (a64-replicate count size (a64-ones (1+ diff))))))))

(defun a64-data-width (word)
  (if (logbitp 31 word) 64 32))

(defun a64-decode-data (word)
  (let* ((width (a64-data-width word))
         (rd (a64-field word 0 5))
         (rn (a64-field word 5 5))
         (rm (a64-field word 16 5))
         (opc (a64-field word 29 2))
         (shift (a64-field word 22 2))
         (amount (a64-field word 10 6)))
    (cond
     ((a64-match word #x1f000000 #x10000000)
      (list :address rd
            (a64-signed 21 (+ (ash (a64-field word 5 19) 2)
                              (a64-field word 29 2)))
            (logbitp 31 word)))
     ((a64-match word #x1f800000 #x12800000)
      (let ((position (* 16 (a64-field word 21 2))))
        (if (or (= opc 1) (>= position width))
            :undefined
          (list :move-wide opc width rd (a64-field word 5 16) position))))
     ((a64-match word #x1f000000 #x0a000000)
      (let ((invert (logbitp 21 word)))
        (if (or (>= amount width)
                (and invert (not (and (= opc 1) (= rn 31)))))
            :undefined
          (list :logical-reg opc width rd rn rm shift amount invert))))
     ((a64-match word #x1f800000 #x11000000)
      (list :arithmetic-imm opc width rd rn
            (ash (a64-field word 10 12) (if (logbitp 22 word) 12 0))))
     ((a64-match word #x1f200000 #x0b000000)
      (if (or (= shift 3) (>= amount width))
          :undefined
        (list :arithmetic-reg opc width rd rn rm shift amount)))
     ((a64-match word #x1f800000 #x12000000)
      (mv-let (valid wmask tmask)
        (a64-decode-bit-masks width (a64-field word 22 1) amount
                              (a64-field word 16 6) t)
        (declare (ignore tmask))
        (if (or (not valid) (= opc 2))
            :undefined
          (list :logical-imm opc width rd rn wmask))))
     ((a64-match word #x1f800000 #x13000000)
      (let ((immr (a64-field word 16 6))
            (n (a64-field word 22 1)))
        (if (or (and (/= opc 0) (/= opc 2))
                (not (= n (a64-field word 31 1)))
                (>= amount width) (>= immr width))
            :undefined
          (mv-let (valid wmask tmask)
            (a64-decode-bit-masks width n amount immr nil)
            (if valid
                (list :bitfield opc width rd rn immr amount wmask tmask)
              :undefined)))))
     ((a64-match word #x7fe0f000 #x1ac02000)
      (let ((kind (a64-field word 10 2)))
        (if (= kind 3)
            :undefined
          (list :shift-variable kind width rd rn rm))))
     ((a64-match word #xffe0fc00 #x9b007c00)
      (list :multiply rd rn rm))
     ((a64-match word #xffe0fc00 #x9b407c00)
      (list :signed-multiply-high rd rn rm))
     ((a64-match word #xffe08000 #x9b008000)
      (list :multiply-subtract rd rn rm (a64-field word 10 5)))
     ((a64-match word #xffe0f800 #x9ac00800)
      (list :divide rd rn rm (logbitp 10 word)))
     ((a64-match word #xfffffc00 #xdac01000)
      (list :clz rd rn))
     ((a64-match word #xffe00c10 #xfa400000)
      (list :ccmp rn rm (a64-field word 12 4) (a64-field word 0 4)))
     ((a64-match word #x7fe00c00 #x1a800000)
      (list :select width rd rn rm (a64-field word 12 4) nil))
     ((a64-match word #x7fe00c00 #x1a800400)
      (list :select width rd rn rm (a64-field word 12 4) t))
     (t :undefined))))

(defun a64-decode-single (word)
  (let* ((size (a64-field word 30 2))
         (opc (a64-field word 22 2))
         (rn (a64-field word 5 5))
         (rt (a64-field word 0 5))
         (mode (a64-field word 10 2))
         (count (ash 1 size)))
    (cond
     ((or (= size 1) (> opc 1)) :undefined)
     ((a64-match word #x3f000000 #x39000000)
      (list :single opc count rn rt :offset (* count (a64-field word 10 12))))
     ((a64-match word #x3f200000 #x38000000)
      (if (or (and (/= mode 1) (/= mode 3))
              (and (/= rn 31) (= rn rt)))
          :undefined
        (list :single opc count rn rt (if (= mode 1) :post :pre)
              (a64-signed 9 (a64-field word 12 9)))))
     ((a64-match word #x3f200c00 #x38200800)
      (let ((option (a64-field word 13 3)))
        (if (not (logbitp 1 option))
            :undefined
          (list :single opc count rn rt :register (a64-field word 16 5)
                option (if (logbitp 12 word) size 0)))))
     (t :undefined))))

(defun a64-decode-pair (word)
  (let ((mode (a64-field word 23 2))
        (load (logbitp 22 word))
        (rn (a64-field word 5 5))
        (rt (a64-field word 0 5))
        (rt2 (a64-field word 10 5)))
    (if (or (= mode 0)
            (and load (= rt rt2))
            (and (/= mode 2) (/= rn 31) (or (= rn rt) (= rn rt2))))
        :undefined
      (list :pair load rn rt rt2
            (case mode (1 :post) (2 :offset) (otherwise :pre))
            (* 8 (a64-signed 7 (a64-field word 15 7)))))))

(defun a64-decode-branch (word)
  (cond
   ((a64-match word #xffe0001f #xd4000001)
    (list :svc (a64-field word 5 16)))
   ((a64-match word #x7c000000 #x14000000)
    (list :branch (* 4 (a64-signed 26 (a64-field word 0 26)))
          (logbitp 31 word)))
   ((a64-match word #xff000010 #x54000000)
    (list :branch-cond (* 4 (a64-signed 19 (a64-field word 5 19)))
          (a64-field word 0 4)))
   ((a64-match word #x7e000000 #x34000000)
    (list :branch-zero (* 4 (a64-signed 19 (a64-field word 5 19)))
          (a64-data-width word) (a64-field word 0 5) (logbitp 24 word)))
   ((or (a64-match word #xfffffc1f #xd61f0000)
        (a64-match word #xfffffc1f #xd63f0000)
        (a64-match word #xfffffc1f #xd65f0000))
    (list :branch-reg (a64-field word 5 5) (logbitp 21 word)))
   (t :undefined)))

(defun a64-decode (word)
  (if (not (unsigned-byte-p 32 word))
      :undefined
    (case (a64-field word 25 4)
      ((5 8 9 13) (a64-decode-data word))
      ((10 11) (a64-decode-branch word))
      ((4 6 12 14)
       (cond ((a64-match word #x3e000000 #x38000000)
              (a64-decode-single word))
             ((a64-match word #xfe000000 #xa8000000)
              (a64-decode-pair word))
             (t :undefined)))
      (otherwise :undefined))))
