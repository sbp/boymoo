(in-package "BOYMOO-COMPILER")

(include-book "index")

(set-verify-guards-eagerness 0)

; A block pairs its next byte offset with its chunks in reverse order.
; A chunk is a word, a string padded to eight bytes, or an integer datum
; whose tagged word can be wider than an integer of the compiler.
(defun data-word (word block)
  (cons (+ 8 (car block)) (cons word (cdr block))))

(defun data-text (type text block)
  (let* ((size (length text))
         (block (data-word (+ (ash size 8) type) block)))
    (mv (- (car block) 6)
        (cons (+ (car block) (aligned-size size 3)) (cons text (cdr block))))))

(defun data-cell (a d block)
  (mv (car block) (data-word d (data-word a block))))

(defun data-fields (type a b block)
  (let* ((ref (+ (car block) 2))
         (block (data-word (+ (ash 16 8) type) block)))
    (mv ref (data-word b (data-word a block)))))

(defun data-words (words block)
  (if (atom words)
      block
    (data-words (cdr words) (data-word (car words) block))))

(defun data-vector (words block)
  (mv (+ (car block) 2)
      (data-words words (data-word (+ (ash (length words) 11) 6) block))))

; The data state holds the symbol names, the canonical texts of constants,
; the symbol buckets, and the block.
(defun data-block (state-data)
  (cdddr state-data))

(defun data-with-block (block state-data)
  (list* (car state-data) (cadr state-data) (caddr state-data) block))

(defun data-remember (text datum state-data)
  (list* (car state-data) (index-set text datum (cadr state-data)) (cddr state-data)))

(defun bucket-get (bucket bits tree)
  (declare (xargs :measure (nfix bits)))
  (cond ((atom tree) 34)
        ((zp bits) (car tree))
        (t
         (let ((next (- bits 1)))
           (bucket-get bucket next
                       (if (equal (low-bits (ash bucket (- next)) 1) 0)
                           (car tree)
                         (cdr tree)))))))

(defun bucket-set (bucket bits datum tree)
  (declare (xargs :measure (nfix bits)))
  (if (zp bits)
      (list datum)
    (let ((next (- bits 1)))
      (if (equal (low-bits (ash bucket (- next)) 1) 0)
          (cons (bucket-set bucket next datum (car tree)) (cdr tree))
        (cons (car tree) (bucket-set bucket next datum (cdr tree)))))))

(defun data-bucket-add (package name name-ref symbol-ref state-data)
  (let* ((bucket (low-bits (+ (text-hash name) (* 7919 package)) 12))
         (tree (caddr state-data)))
    (mv-let (key block)
      (data-cell (+ 1 (* 2 package)) name-ref (data-block state-data))
      (mv-let (entry block)
        (data-cell key symbol-ref block)
        (mv-let (head block)
          (data-cell entry (bucket-get bucket 12 tree) block)
          (list* (car state-data) (cadr state-data)
                 (bucket-set bucket 12 head tree) block))))))

; An owned name maps to its symbol and name string. An imported name
; has a marker before that pair.
(defun data-intern (package name state-data)
  (let* ((key (cons package name))
         (hash (+ (text-hash name) (* 7919 package)))
         (old (table-get key hash 12 (car state-data))))
    (cond ((eq (car old) :import)
           (mv (compiler-error "A symbol that does not exist, since its package imports one of that name: ~x0."
                               name)
               nil state-data))
          (old (mv (car old) (cdr old) state-data))
          (t
           (mv-let (name-ref block)
             (data-text 1 name (data-block state-data))
             (mv-let (symbol-ref block)
               (data-fields 2 name-ref (+ 1 (* 2 package)) block)
               (let ((state-data
                      (list* (table-put key (cons symbol-ref name-ref) hash 12 (car state-data))
                             (cadr state-data) (caddr state-data) block)))
                 (mv symbol-ref name-ref
                     (data-bucket-add package name name-ref symbol-ref state-data)))))))))

(defun data-symbol (text packages state-data)
  (if (or (not (stringp text)) (equal (char text 0) #\") (equal (char text 0) #\#))
      (mv (compiler-error "Expected a symbol: ~x0." text) state-data)
    (let ((old (index-get text (cadr state-data))))
      (if old
          (mv old state-data)
        (let* ((split (symbol-separator text))
               (package (and split (index-get (decode-symbol-part text 0 split) packages))))
          (if (not package)
              (mv (compiler-error "Symbol has no declared package: ~x0." text) state-data)
            (mv-let (symbol-ref name-ref state-data)
              (data-intern package (decode-symbol-part text (+ split 2) (length text)) state-data)
              (declare (ignore name-ref))
              (mv symbol-ref (data-remember text symbol-ref state-data)))))))))

(defun decimal-value (text i left negative)
  (declare (xargs :measure (nfix left)))
  (if (zp left)
      negative
    (let ((digit (- (char-code (char text i)) 48)))
      (if (or (< digit 0) (< 9 digit))
          (compiler-error "Invalid decimal integer: ~x0." text)
        (decimal-value text (+ i 1) (- left 1)
                       (- (* 10 negative) digit))))))

; Split the magnitude by limb ranges. Suppress leading zero limbs,
; and keep all the low limbs once a high limb has been written.
(defun data-integer-limbs (magnitude width leading fuel tail)
  (declare (xargs :measure (nfix fuel)))
  (cond ((and leading (zp magnitude)) tail)
        ((or (<= width 1) (zp fuel)) (cons magnitude tail))
        (t (let* ((half (ash width -1))
                  (bits (* 32 half))
                  (high (ash magnitude (- bits)))
                  (tail (data-integer-limbs high (- width half) leading
                                            (- fuel 1) tail)))
             (data-integer-limbs (low-bits magnitude bits) half
                                 (and leading (zp high)) (- fuel 1) tail)))))

(defun data-integer-value (text start end)
  (let* ((minus (and (< start end) (equal (char text start) #\-)))
         (start (if minus (+ 1 start) start))
         (left (- end start)))
    (if (or (<= left 0)
            (and (equal (char text start) #\0) (or minus (< 1 left))))
        (compiler-error "Invalid decimal integer: ~x0." text)
      (let ((negative (decimal-value text start left 0)))
        (if minus negative (- negative))))))

(defun data-write-integer (value text-length block)
  (if (and (<= -4611686018427387904 value) (< value 4611686018427387904))
      (mv (cons :integer value) block)
    (let* ((minus (< value 0))
           (magnitude (if minus (- value) value))
           (width (ash (+ text-length 7) -3))
           (limbs (data-integer-limbs magnitude width t text-length nil))
           (header (+ (ash (+ 1 (length limbs)) 11) 3))
           (ref (+ (car block) 2))
           (block (data-word (if minus 1 0) (data-word header block))))
      (mv ref (data-words limbs block)))))

(defun data-integer (text block)
  (let ((end (length text)))
    (data-write-integer (data-integer-value text 0 end) end block)))

(defun data-rational (text block)
  (let* ((end (length text))
         (slash (find-char text 0 end #\/)))
    (if slash
        (let* ((start (+ slash 1))
               (num (data-integer-value text 0 slash))
               (den (data-integer-value text start end)))
          (if (or (equal num 0) (<= den 1)
                  (not (equal (denominator (/ num den)) den)))
              (mv (compiler-error "Invalid fraction: ~x0." text) block)
            (mv-let (num-ref block)
              (data-write-integer num slash block)
              (mv-let (den-ref block)
                (data-write-integer den (- end start) block)
                (data-fields 4 num-ref den-ref block)))))
      (data-integer text block))))

(defun data-number (text block)
  (if (equal (char text 0) #\#)
      (let* ((end (- (length text) 1))
             (space (find-char text 3 (- end 3) #\Space)))
        (if (not (and space (equal (char text 1) #\C)
                      (equal (char text 2) #\() (equal (char text end) #\))))
            (mv (compiler-error "Invalid complex rational: ~x0." text) block)
          (mv-let (real block)
            (data-rational (subseq text 3 space) block)
            (mv-let (imag block)
              (data-rational (subseq text (+ space 1) end) block)
              (if (equal imag '(:integer . 0))
                  (mv (compiler-error "Invalid complex rational: ~x0." text) block)
                (data-fields 5 real imag block))))))
    (data-rational text block)))

(defun data-atom (text packages state-data)
  (let ((old (index-get text (cadr state-data))))
    (if old
        (mv old state-data)
      (let ((c (char text 0)))
        (cond ((and (not (equal c #\")) (not (equal c #\#)) (symbol-separator text))
               (data-symbol text packages state-data))
              ((and (equal c #\#) (equal (char text 1) #\\)
                    (equal (length text) 4))
               (let ((datum (+ 4 (* 8 (hex-byte text 2)))))
                 (mv datum (data-remember text datum state-data))))
              (t
               (mv-let (datum block)
                 (if (equal c #\")
                     (data-text 1 (decode-part text 0 (length text)) (data-block state-data))
                   (data-number text (data-block state-data)))
                 (mv datum (data-remember text datum (data-with-block block state-data))))))))))

(defun data-list-cells (reversed tail block)
  (if (atom reversed)
      (mv tail block)
    (mv-let (datum block)
      (data-cell (car reversed) tail block)
      (data-list-cells (cdr reversed) datum block))))

(mutual-recursion
 (defun data-datum (datum packages state-data)
   (declare (xargs :measure (+ 1 (* 2 (acl2-count datum)))))
   (if (consp datum)
       (data-list-datum datum packages state-data nil)
     (data-atom datum packages state-data)))
 (defun data-list-datum (items packages state-data reversed)
   (declare (xargs :measure (* 2 (acl2-count items))))
   (if (atom items)
       (mv-let (datum block)
         (data-list-cells reversed 34 (data-block state-data))
         (mv datum (data-with-block block state-data)))
     (if (equal (car items) ".")
         (if (and (consp reversed) (consp (cdr items))
                  (stringp (cadr items)) (not (cddr items))
                  (not (equal (cadr items) *nil-name*)))
             (mv-let (tail state-data)
               (data-atom (cadr items) packages state-data)
               (mv-let (datum block)
                 (data-list-cells reversed tail (data-block state-data))
                 (mv datum (data-with-block block state-data))))
           (mv (compiler-error "Invalid dotted list: ~x0." items) state-data))
       (mv-let (datum state-data)
         (data-datum (car items) packages state-data)
         (data-list-datum (cdr items) packages state-data (cons datum reversed)))))))

(defun data-constant (text packages state-data)
  (if (equal (char text 0) #\()
      (let ((old (index-get text (cadr state-data))))
        (if old
            state-data
          (let ((data (read-lines text 0 (length text) nil nil nil (length text))))
            (mv-let (datum state-data)
              (data-datum (car data) packages state-data)
              (data-remember text datum state-data)))))
    (mv-let (datum state-data)
      (data-atom text packages state-data)
      (declare (ignore datum))
      state-data)))

(defun data-note-symbol (text packages state-data)
  (mv-let (datum state-data)
    (data-symbol text packages state-data)
    (declare (ignore datum))
    state-data))

(defun data-formals (formals packages state-data)
  (if (atom formals)
      state-data
    (data-formals (cdr formals) packages
                  (data-note-symbol (car formals) packages state-data))))

(mutual-recursion
 (defun data-term (term packages state-data depth)
   (declare (xargs :measure (+ 1 (* 2 (acl2-count term)))))
   (cond ((< 10000 depth)
          (compiler-error "A term nested more deeply than the runner allows: ~x0." depth))
         ((atom term) (data-note-symbol term packages state-data))
         ((equal (car term) *quote-name*)
          (if (and (stringp (cadr term)) (not (cddr term)))
              (data-constant (cadr term) packages
                             (data-note-symbol *quote-name* packages state-data))
            (compiler-error "Invalid quoted constant: ~x0." term)))
         ((consp (car term))
          (let* ((head (car term))
                 (state-data (data-note-symbol (car head) packages state-data))
                 (state-data (data-formals (declaration-list (cadr head)) packages state-data))
                 (state-data (data-term (caddr head) packages state-data (+ depth 1))))
            (data-terms (cdr term) packages state-data (+ depth 1))))
         (t (data-terms (cdr term) packages
                        (data-note-symbol (car term) packages state-data) (+ depth 1)))))
 (defun data-terms (terms packages state-data depth)
   (declare (xargs :measure (* 2 (acl2-count terms))))
   (if (atom terms)
       state-data
     (data-terms (cdr terms) packages
                 (data-term (car terms) packages state-data depth) depth))))

(defun data-definitions (item packages state-data)
  (if (atom item)
      state-data
    (let* ((definition (car item))
           (state-data (data-note-symbol (car definition) packages state-data))
           (state-data (data-formals (declaration-list (cadr definition)) packages state-data))
           (state-data (data-term (caddr definition) packages state-data 0)))
      (data-definitions (cdr item) packages state-data))))

(defun data-program-symbols (lines packages state-data)
  (if (atom lines)
      state-data
    (let* ((line (car lines))
           (word (car line)))
      (data-program-symbols (cdr lines) packages
                            (cond ((equal word "define")
                                   (mv-let (rulers state-data)
                                     (data-datum (cadr line) packages state-data)
                                     (declare (ignore rulers))
                                     (data-definitions (cddr line) packages state-data)))
                                  ((or (equal word "attach") (equal word "entry"))
                                   (data-formals (cdr line) packages state-data))
                                  (t state-data))))))

(defun data-package-numbers (lines number packages)
  (if (atom lines)
      packages
    (let ((name (decode-part (cadar lines) 0 (length (cadar lines)))))
      (cond ((equal name "") (compiler-error "A package's name is empty: ~x0." name))
            ((index-get name packages)
             (data-package-numbers (cdr lines) number packages))
            (t (data-package-numbers (cdr lines) (+ number 1)
                                     (index-set name number packages)))))))

(defun data-imports (imports number packages common-lisp state-data reversed)
  (if (atom imports)
      (mv-let (ref block)
        (data-list-cells reversed 34 (data-block state-data))
        (mv ref (data-with-block block state-data)))
    (let ((text (car imports)))
      (mv-let (symbol-ref state-data)
        (data-symbol text packages state-data)
        (let* ((split (symbol-separator text))
               (name (decode-symbol-part text (+ 2 split) (length text)))
               (symbol-package (or (index-get (decode-symbol-part text 0 split) packages)
                                   common-lisp))
               (entry (table-get (cons symbol-package name)
                                 (+ (text-hash name) (* 7919 symbol-package)) 12
                                 (car state-data)))
               (key (cons number name))
               (hash (+ (text-hash name) (* 7919 number))))
          (cond ((equal name "ACL2-PKG-WITNESS")
                 (mv (compiler-error "A package may not import: ~x0." name) state-data))
                ((table-get key hash 12 (car state-data))
                 (mv (compiler-error "A package imports two symbols of one name: ~x0." name)
                     state-data))
                (t
                 (data-imports (cdr imports) number packages common-lisp
                               (data-bucket-add
                                number name (cdr entry) symbol-ref
                                (cons (table-put key (cons :import entry) hash 12 (car state-data))
                                      (cdr state-data)))
                               (cons symbol-ref reversed)))))))))

(defun data-package-vectors (names packages declarations state-data reversed)
  (if (atom names)
      (mv-let (ref block)
        (data-vector (reverse-onto reversed nil) (data-block state-data))
        (mv ref (data-with-block block state-data)))
    (let* ((name (car names))
           (number (index-get name packages))
           (declaration (index-get name declarations)))
      (mv-let (name-ref block)
        (data-text 1 name (data-block state-data))
        (mv-let (witness name-word state-data)
          (data-intern number "ACL2-PKG-WITNESS" (data-with-block block state-data))
          (declare (ignore name-word))
          (mv-let (ref block)
            (data-vector (list name-ref (cadr declaration) (if (caddr declaration) witness 34))
                         (data-block state-data))
            (data-package-vectors (cdr names) packages declarations
                                  (data-with-block block state-data) (cons ref reversed))))))))

(defun data-package-declarations (lines packages declared declarations state-data names)
  (if (atom lines)
      (mv declarations state-data (reverse-onto names nil))
    (let* ((line (car lines))
           (name (decode-part (cadr line) 0 (length (cadr line))))
           (imports (caddr line))
           (visible (equal (car line) "package"))
           (old (index-get name declarations)))
      (cond ((and old (not (equal imports (car old))))
             (mv (compiler-error "A package declared again with other imports: ~x0." name)
                 state-data nil))
            (old
             (data-package-declarations
              (cdr lines) packages declared
              (if visible (index-set name (list imports (cadr old) t) declarations)
                declarations)
              state-data names))
            (t
             (let ((number (index-get name packages)))
               (mv-let (imports-ref state-data)
                 (data-imports (declaration-list imports) number declared
                               (index-get "COMMON-LISP" packages) state-data nil)
                 (data-package-declarations
                  (cdr lines) packages (index-set name number declared)
                  (index-set name (list imports imports-ref visible) declarations)
                  state-data (cons name names)))))))))

(defun data-packages (lines number packages state-data reversed)
  (declare (ignore number))
  (mv-let (declarations state-data names)
    (data-package-declarations lines packages nil nil state-data nil)
    (data-package-vectors names packages declarations state-data reversed)))

(defun data-bucket-vector (tree bits block)
  (declare (xargs :measure (nfix bits)))
  (if (zp bits)
      (data-word (if tree (car tree) 34) block)
    (let* ((next (- bits 1))
           (block (data-bucket-vector (car tree) next block)))
      (data-bucket-vector (cdr tree) next block))))

(defun prepend-integer (n bytes)
  (let ((first (+ 1 (* 2 (low-bits n 7)))))
    (cons (code-char first) (prepend-word (ash n -7) 7 bytes))))

(defun data-write-chunks (reversed chars buffered chunks)
  (if (atom reversed)
      (image-flush chars chunks)
    (let* ((chunk (car reversed))
           (text (stringp chunk))
           (size (if text (length chunk) 8))
           (padded (aligned-size size 3))
           (padding (- padded size)))
      (if (< 128 padded)
          (let ((chunks (image-padding padding (image-flush chars chunks))))
            (data-write-chunks (cdr reversed) nil 0 (cons chunk chunks)))
        (let* ((chars (cond (text (prepend-string chunk size (prepend-word 0 padding chars)))
                            ((consp chunk) (prepend-integer (cdr chunk) chars))
                            (t (prepend-word chunk 8 chars))))
               (buffered (+ buffered padded)))
          (if (<= 512 buffered)
              (data-write-chunks (cdr reversed) nil 0 (image-flush chars chunks))
            (data-write-chunks (cdr reversed) chars buffered chunks)))))))

(defun data-write (chunks tail)
  (data-write-chunks chunks nil 0 tail))

(defun data-initial (package)
  (mv-let (nil-name block)
    (data-text 1 "NIL" (cons 80 nil))
    (mv-let (t-name block)
      (data-text 1 "T" block)
      (let* ((names (table-put (cons package "NIL") (cons 34 nil-name)
                              (+ (text-hash "NIL") (* 7919 package)) 12 nil))
             (names (table-put (cons package "T") (cons 58 t-name)
                              (+ (text-hash "T") (* 7919 package)) 12 names))
             (constants (index-set *nil-name* 34 (index-set "COMMON-LISP::T" 58 nil)))
             (state-data (list* names constants nil block))
             (state-data (data-bucket-add package "NIL" nil-name 34 state-data))
             (state-data (data-bucket-add package "T" t-name 58 state-data)))
        (mv nil-name t-name state-data)))))

(defun data-build (lines package-lines)
  (let* ((packages (data-package-numbers package-lines 0 nil))
         (common-lisp (index-get "COMMON-LISP" packages)))
    (if (not common-lisp)
        (mv (compiler-error "No COMMON-LISP package in the input: ~x0." nil) nil)
      (mv-let (nil-name t-name state-data)
        (data-initial common-lisp)
        (mv-let (package-ref state-data)
          (data-packages package-lines 0 packages state-data nil)
          (let* ((state-data (data-program-symbols lines packages state-data))
                 (block (data-block state-data))
                 (bucket-ref (+ (car block) 2))
                 (block (data-bucket-vector (caddr state-data) 12
                                            (data-word (+ (ash 4096 11) 6) block)))
                 (tagged-package (+ 1 (* 2 common-lisp)))
                 (prefix (list (car block) package-ref bucket-ref 34
                               4098 nil-name tagged-package 4098 t-name tagged-package)))
            (mv (cons (car block)
                      (data-write (reverse-onto prefix nil) (data-write (cdr block) nil)))
                (cadr state-data))))))))
