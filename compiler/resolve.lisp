(in-package "BOYMOO-COMPILER")

(include-book "data")

(set-verify-guards-eagerness 0)

; The context contains the arities, resolved attachments, and static datum map.
(defun resolve-call-info (head context)
  (let* ((target (or (index-get head (cadr context)) head))
         (routine (or (assoc-equal target *jets*)
                      (assoc-equal target *primitives*))))
    (mv target
        (if routine (cadr routine) (index-get target (car context)))
        (cddr routine))))

(defun resolve-datum-word (text constants)
  (let ((datum (index-get text constants)))
    (cond ((consp datum) (low-bits (+ 1 (* 2 (cdr datum))) 64))
          (datum (low-bits datum 64))
          (t (compiler-error "No static datum for: ~x0." text)))))

(defun resolve-variable (name scope)
  (or (table-tree-get name scope)
      (compiler-error "Variable outside its scope: ~x0." name)))

(defun resolve-mbe-p (head args)
  (and (equal head "ACL2::RETURN-LAST")
       (equal (caar args) *quote-name*)
       (equal (cadar args) "ACL2::MBE1-RAW")
       (equal (length args) 3)))

(defun resolve-lambda-p (head)
  (and (equal (car head) "COMMON-LISP::LAMBDA")
       (consp (cddr head))
       (not (cdddr head))
       (or (consp (cadr head)) (equal (cadr head) *nil-name*))))

; NEXT is the first unused variable number. Scope maps formal names to numbers.
(mutual-recursion
 (defun resolve-term (term scope context next)
   (declare (xargs :measure (acl2-count term)))
   (if (atom term)
       (mv (list :var (resolve-variable term scope)) next)
     (let ((head (car term))
           (args (cdr term)))
       (cond
        ((equal head *quote-name*)
         (mv (if (and (stringp (car args)) (not (cdr args)))
                 (list :const (resolve-datum-word (car args) (caddr context)))
               (compiler-error "Invalid quoted constant: ~x0." term))
             next))
        ((equal head *if-name*)
         (if (equal (length args) 3)
             (mv-let (operands next)
               (resolve-args args scope context next)
               (mv (cons :if operands) next))
           (mv (compiler-error "A conditional needs three arguments: ~x0." term) next)))
        ((resolve-mbe-p head args)
         (mv-let (exec exec-next)
           (resolve-term (cadr args) scope context next)
           (declare (ignore exec exec-next))
           (resolve-term (caddr args) scope context next)))
        ((consp head)
         (if (resolve-lambda-p head)
             (mv-let (operands numbers body-scope next)
               (resolve-lambda-args args (declaration-list (cadr head))
                                       scope nil context next)
               (mv-let (body next)
                 (resolve-term (caddr head) body-scope context next)
                 (mv (list :let numbers operands body) next)))
           (mv (compiler-error "Invalid lambda: ~x0." head) next)))
        (t
         (mv-let (target expected routine)
           (resolve-call-info head context)
           (if (and expected (not (equal (length args) expected)))
               (mv (compiler-error "Call with the wrong number of arguments: ~x0." head)
                   next)
             (mv-let (operands next)
               (resolve-args args scope context next)
               (mv (cond (routine (list :prim target operands))
                         (expected (list :call target operands))
                         (t (list :undef
                                  (resolve-datum-word target (caddr context))
                                  operands)))
                   next)))))))))
 (defun resolve-args (args scope context next)
   (declare (xargs :measure (acl2-count args)))
   (if (atom args)
       (mv nil next)
     (mv-let (arg next)
       (resolve-term (car args) scope context next)
       (mv-let (rest next)
         (resolve-args (cdr args) scope context next)
         (mv (cons arg rest) next)))))
 (defun resolve-lambda-args (args formals scope body-scope context next)
   (declare (xargs :measure (acl2-count args)))
   (cond ((atom args)
          (if (consp formals)
              (mv (compiler-error "Missing lambda arguments: ~x0." formals)
                  nil body-scope next)
            (mv nil nil body-scope next)))
         ((atom formals)
          (mv (compiler-error "Extra lambda arguments: ~x0." args)
              nil body-scope next))
         (t
          (mv-let (arg number)
            (resolve-term (car args) scope context next)
            (let ((body-scope (bind-formal (car formals) number body-scope)))
              (mv-let (rest numbers body-scope next)
                (resolve-lambda-args (cdr args) (cdr formals) scope body-scope
                                        context (+ number 1))
                (mv (cons arg rest) (cons number numbers) body-scope next))))))))

(defun resolve-formal-numbers (formals number)
  (if (atom formals)
      nil
    (cons number (resolve-formal-numbers (cdr formals) (+ number 1)))))

(defun resolve-definition (definition context)
  (let* ((formals (declaration-list (cadr definition)))
         (scope (bind-formals formals 0 nil)))
    (mv-let (body next)
      (resolve-term (caddr definition) scope context (length formals))
      (declare (ignore next))
      (list (car definition) (resolve-formal-numbers formals 0) body))))

(defun resolve-definitions (definitions context)
  (if (atom definitions)
      nil
    (cons (resolve-definition (car definitions) context)
          (resolve-definitions (cdr definitions) context))))

; The printer gives each definition its own line and writes words in hexadecimal.
(defun l1-hex-chars (n left chars)
  (declare (xargs :measure (nfix left)))
  (if (zp left)
      chars
    (let ((chars (cons (char "0123456789ABCDEF" (low-bits n 4)) chars))
          (high (ash n -4)))
      (if (equal high 0)
          chars
        (l1-hex-chars high (- left 1) chars)))))

(defun l1-string-chars (s i left chars)
  (declare (xargs :measure (nfix left)))
  (if (zp left)
      (cons #\" chars)
    (let* ((c (char s i))
           (chars (if (or (eq c #\") (eq c #\\)) (cons #\\ chars) chars)))
      (l1-string-chars s (+ i 1) (- left 1) (cons c chars)))))

(mutual-recursion
 (defun l1-print-object (x chars)
   (declare (xargs :measure (+ 1 (* 2 (acl2-count x)))))
   (cond ((consp x) (l1-print-items x (cons #\( chars)))
         ((not x) (cons #\) (cons #\( chars)))
         ((stringp x) (l1-string-chars x 0 (length x) (cons #\" chars)))
         ((natp x)
          (reverse-onto (l1-hex-chars x 16 nil) (cons #\x (cons #\# chars))))
         (t (let* ((name (symbol-name x))
                   (name-chars (prepend-string name (length name) nil)))
              (reverse-onto name-chars (cons #\: chars))))))
 (defun l1-print-items (items chars)
   (declare (xargs :measure (* 2 (acl2-count items))))
   (if (atom items)
       (cons #\) chars)
     (let ((chars (l1-print-object (car items) chars)))
       (if (consp (cdr items))
           (l1-print-items (cdr items) (cons #\Space chars))
         (cons #\) chars))))))

(defun l1-print-lines (definitions chars)
  (if (atom definitions)
      chars
    (l1-print-lines (cdr definitions)
                       (cons #\Newline (l1-print-object (car definitions) chars)))))

(defun l1-print (definitions)
  (coerce (reverse-onto (l1-print-lines definitions nil) nil) 'string))
