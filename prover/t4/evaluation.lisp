(in-package "BOYMOO-PROVER")

(set-verify-guards-eagerness 0)

(defconst *t4-evaluation-iff* (proof-sym "IFF" "ACL2"))
(defconst *t4-evaluation-atom* (proof-cl "ATOM"))
(defconst *t4-evaluation-endp* (proof-cl "ENDP"))
(defconst *t4-evaluation-kwote-list* (proof-sym "KWOTE-LST" "ACL2"))
(defconst *t4-evaluation-synp* (proof-sym "SYNP" "ACL2"))

(defun t4-evaluation-make-evaluation-rules (calls spines reapplications functions)
  (list :t4-evaluation-rules calls spines reapplications functions))

(defun t4-evaluation-evaluation-rules-init ()
  (t4-evaluation-make-evaluation-rules nil nil nil nil))

(defun t4-evaluation-evaluation-rules-calls (rules)
  (cadr rules))

(defun t4-evaluation-evaluation-rules-spines (rules)
  (caddr rules))

(defun t4-evaluation-evaluation-rules-reapplications (rules)
  (cadddr rules))

(defun t4-evaluation-evaluation-rules-functions (rules)
  (car (cddddr rules)))

(defun t4-evaluation-register-call-tag (guard shape syntax)
  (if (not (proof-is-call guard *proof-if*))
      nil
    (proof-with-checked-results ((test (proof-term-at guard 1)))
      (and (equal test shape)
        (proof-with-checked-results ((default (proof-term-at guard 3)))
          (and (equal default *proof-false*)
               (proof-is-call (caddr guard) *proof-equal*)
            (let ((comparison (caddr guard)))
              (proof-with-checked-results ((input (proof-term-at comparison 1)))
                (and (equal input (list *library-car* syntax))
                  (proof-with-checked-results ((tag (proof-term-at comparison 2)))
                    (and (proof-is-call tag *proof-quote*)
                      tag)))))))))))

(defun t4-evaluation-register-reapplication-p (equation guard evaluator lists syntax env shape)
  (let* ((selector (list *library-car* syntax))
         (quoted-args (list *t4-evaluation-kwote-list*
                            (list lists (list *library-cdr* syntax) env)))
         (reapplied (list evaluator (list *proof-cons* selector quoted-args) *proof-false*))
         (denied-tag (proof-neg (proof-eq selector (proof-quote *proof-quote*)))))
    (proof-with-checked-results ((result (proof-term-at equation 2)))
      (and (equal result reapplied) (proof-is-call guard *proof-if*)
        (proof-with-checked-results ((test (proof-term-at guard 1)))
          (and (equal test shape)
            (proof-with-checked-results ((default (proof-term-at guard 3)))
              (let ((inner (caddr guard)))
                (and (equal default *proof-false*)
                     (proof-is-call inner *proof-if*)
                     (equal (cddr inner) (list denied-tag *proof-false*))
                     (proof-is-call (cadr inner) *t4-evaluation-synp*))))))))))

(defun t4-evaluation-register-pattern (rules pattern guard equation name evaluator lists)
  (let* ((function (car pattern))
         (syntax (cadr pattern))
         (env (caddr pattern))
         (shape (list *proof-consp* syntax))
         (rule (list name syntax env))
         (calls (t4-evaluation-evaluation-rules-calls rules))
         (spines (t4-evaluation-evaluation-rules-spines rules))
         (reapplications (t4-evaluation-evaluation-rules-reapplications rules))
         (functions (t4-evaluation-evaluation-rules-functions rules))
         (spine (and (equal function lists)
                     (or (equal guard shape) (equal guard (proof-neg shape)))))
         (spines (if spine
                     (table-put spines (list function (equal guard shape)) rule)
                   spines))
         (functions (if (and spine (not (member-equal function functions)))
                        (append functions (list function))
                      functions)))
    (proof-with-checked-results
        ((tag (and (equal function evaluator)
                   (t4-evaluation-register-call-tag guard shape syntax))))
      (let* ((calls (if tag (table-put calls (list function tag) rule) calls))
             (functions (if (and tag (not (member-equal function functions)))
                            (append functions (list function))
                          functions)))
        (proof-with-checked-results
            ((reapply (and (equal function evaluator)
                           (t4-evaluation-register-reapplication-p
                            equation guard evaluator lists syntax env shape))))
          (t4-evaluation-make-evaluation-rules
           calls spines
           (if reapply
               (table-put reapplications (list evaluator lists) rule)
             reapplications)
           functions))))))

(defund t4-evaluation-register-formula (rules record evaluator lists)
  (proof-with-checked-results ((record (proof-list-of-length record 2)))
    (let ((name (car record))
          (formula (cadr record)))
      (if (not (proof-is-call formula *library-implies*))
          rules
        (proof-with-checked-results ((equation (proof-term-at formula 2)))
          (if (not (proof-is-call equation *proof-equal*))
              rules
            (proof-with-checked-results
                ((parts (proof-list-of-length (cdr formula) 2))
                 (pattern (proof-term-at equation 1)))
              (if (and (proof-compound pattern)
                       (equal (len pattern) 3)
                       (not (proof-compound (cadr pattern)))
                       (not (proof-compound (caddr pattern))))
                  (t4-evaluation-register-pattern rules pattern (car parts) equation
                   name evaluator lists)
                rules))))))))

(defun t4-evaluation-register-formulas (rules formulas evaluator lists)
  (declare (xargs :measure (acl2-count formulas)))
  (if (endp formulas)
      rules
    (proof-with-checked-results
        ((rules (t4-evaluation-register-formula rules (car formulas) evaluator lists)))
      (t4-evaluation-register-formulas rules (cdr formulas) evaluator lists))))

(defun t4-evaluation-evaluation-rules-register (rules data)
  (proof-with-checked-results ((data (proof-list-of-length data 2)))
    (let ((functions (car data))
          (formulas (cadr data)))
      (if (not (equal (len functions) 2))
          rules
        (proof-with-checked-results ((evaluator (proof-list-of-length (car functions) 2)))
          (if (not (equal (cadr evaluator) 2))
              rules
            (proof-with-checked-results ((lists (proof-list-of-length (cadr functions) 2)))
              (if (not (equal (cadr lists) 2))
                  rules
                (t4-evaluation-register-formulas rules formulas (car evaluator) (car lists))))))))))

(mutual-recursion
 (defun t4-evaluation-evaluation-rules-syntax-terms (rules formula)
   (declare (xargs :measure (acl2-count formula)))
   (let ((functions (t4-evaluation-evaluation-rules-functions rules)))
     (cond
      ((or (not functions) (not (proof-compound formula))
           (proof-is-call formula *proof-quote*))
       nil)
      ((atom formula) (proof-term-at formula 0))
      ((member-equal (car formula) functions)
       (proof-with-checked-results
           ((syntax (proof-term-at formula 1))
            (rest (t4-evaluation-syntax-arguments rules (cdr formula))))
         (cons syntax rest)))
      (t (t4-evaluation-syntax-arguments rules (cdr formula))))))
 (defun t4-evaluation-syntax-arguments (rules args)
   (declare (xargs :measure (acl2-count args)))
   (if (endp args)
       nil
     (proof-with-checked-results
         ((first (t4-evaluation-evaluation-rules-syntax-terms rules (car args)))
          (rest (t4-evaluation-syntax-arguments rules (cdr args))))
       (append first rest)))))

(defun t4-evaluation-request-p (value)
  (and (consp value) (eq (car value) :t4-evaluation-request)))

(defun t4-evaluation-request-operation (request)
  (cadr request))

(defun t4-evaluation-request-arguments (request)
  (caddr request))

(defun t4-evaluation-request-library (request)
  (cadddr request))

(defund t4-evaluation-reply (operation arguments lib replies)
  (cond ((endp replies) (list :t4-evaluation-request operation arguments lib))
        ((failure-p (car replies)) (car replies))
        (t replies)))

(defmacro t4-evaluation-with-results (bindings result)
  (if (endp bindings)
      result
    (let ((binding (car bindings)))
      `(let (,binding)
         (if (or (failure-p ,(car binding))
                 (t4-evaluation-request-p ,(car binding)))
             ,(car binding)
           (t4-evaluation-with-results ,(cdr bindings) ,result))))))

(defun t4-evaluation-step-right (step)
  (proof-with-checked-results ((first (proof-step-first step)))
    (proof-term-at first 2)))

(defun t4-evaluation-equation-result (step lib evidence)
  (cons step (cons lib evidence)))

(defun t4-evaluation-find-known-tag (calls function datum lib evidence replies)
  (declare (xargs :measure (acl2-count calls)))
  (if (endp calls)
      (cons (t4-evaluation-equation-result nil lib evidence) replies)
    (let* ((key (caar calls))
           (tag (cadr key)))
      (if (equal (car key) function)
          (t4-evaluation-with-results
              ((answer (t4-evaluation-reply :find
                        (list (proof-eq (list *library-car* datum) tag) evidence)
                        lib replies))
               (result (car answer)))
            (if (car result)
                answer
              (t4-evaluation-find-known-tag (cdr calls) function datum
               (cadr result) (cddr result) (cdr answer))))
        (t4-evaluation-find-known-tag (cdr calls) function datum lib evidence replies)))))

(defun t4-evaluation-known-tag (calls function datum lib evidence replies)
  (let ((proof (library-library-proof lib)))
    (cond
     ((proof-is-call datum *proof-cons*)
      (proof-with-checked-results ((tag (library-library-axiom lib "CAR-CONS" (cdr datum))))
        (cons (t4-evaluation-equation-result tag lib evidence) replies)))
     (t
      (proof-with-checked-results
          ((quoted (and (proof-is-call datum *proof-quote*) (proof-term-at datum 1))))
        (if (and quoted (proof-compound quoted))
            (proof-with-checked-results
                ((tag (proof-proof-compute proof (list *library-car* datum) (car quoted))))
              (cons (t4-evaluation-equation-result tag lib evidence) replies))
          (t4-evaluation-find-known-tag calls function datum lib evidence replies)))))))

(defun t4-evaluation-equation-fact (lib rule datum env)
  (proof-proof-fact (library-library-proof lib) (car rule)
   (list (list (cadr rule) datum) (list (caddr rule) env))))

(defun t4-evaluation-call-equation (lib rule datum env cons-step known-tag tag evidence)
  (let* ((proof (library-library-proof lib))
         (shape (list *proof-consp* datum))
         (required (proof-ite shape (proof-eq (list *library-car* datum) tag) *proof-false*)))
    (proof-with-checked-results
        ((fact (t4-evaluation-equation-fact lib rule datum env))
         (condition (t4-division-combine lib (list cons-step known-tag)))
         (literal (proof-step-first condition)))
      (if (not (equal literal required))
          '(:failure "InferenceMismatch" "")
        (proof-with-checked-results ((step (proof-proof-modus-ponens proof fact condition)))
          (t4-evaluation-equation-result step lib evidence))))))

(defun t4-evaluation-equation-denied (lib shape datum evidence replies)
  (let ((denied (proof-neg shape)))
    (if (proof-is-call datum *proof-quote*)
        (t4-evaluation-with-results
            ((answer (t4-evaluation-reply :prove (list denied nil (list *proof-not*)) lib replies)))
          (let ((new-lib (cdar answer)))
            (t4-evaluation-equation-result
             (caar answer) new-lib
             (if (equal lib (t4-structural-evidence-proof evidence))
                 (t4-structural-evidence-with-proof evidence new-lib)
               evidence))))
      (t4-evaluation-with-results
          ((answer (t4-evaluation-reply :find (list denied evidence) lib replies)))
        (car answer)))))

(defun t4-evaluation-spine-equation (rules lib function datum env cons-step evidence replies)
  (let ((entry (assoc-equal (list function (if cons-step t nil))
                            (t4-evaluation-evaluation-rules-spines rules))))
    (if (not entry)
        (t4-evaluation-equation-result nil lib evidence)
      (t4-evaluation-with-results
          ((condition (if cons-step
                          (t4-evaluation-equation-result cons-step lib evidence)
                        (t4-evaluation-equation-denied lib (list *proof-consp* datum)
                         datum evidence replies))))
        (let ((step (car condition))
              (lib (cadr condition))
              (evidence (cddr condition)))
          (if (not step)
              condition
            (proof-with-checked-results
                ((fact (t4-evaluation-equation-fact lib (cdr entry) datum env))
                 (theorem (proof-proof-modus-ponens (library-library-proof lib) fact step)))
              (t4-evaluation-equation-result theorem lib evidence))))))))

(defun t4-evaluation-evaluation-rules-equation (rules lib term evidence replies)
  (let ((head (car term)))
    (if (or (not (equal (len term) 3))
            (not (member-equal head (t4-evaluation-evaluation-rules-functions rules))))
        (t4-evaluation-equation-result nil lib evidence)
      (let ((datum (cadr term))
            (env (caddr term)))
        (t4-evaluation-with-results
            ((answer (t4-evaluation-reply :known (list (list *proof-consp* datum) evidence)
                       lib replies))
             (shape (car answer))
             (cons-step (car shape))
             (lib (cadr shape))
             (evidence (cddr shape))
             (answer (if cons-step
                         (t4-evaluation-known-tag (t4-evaluation-evaluation-rules-calls rules)
                          head datum lib evidence (cdr answer))
                       (cons (t4-evaluation-equation-result nil lib evidence) (cdr answer))))
             (known (caar answer))
             (lib (cadar answer))
             (evidence (cddar answer))
             (tag (and known (t4-evaluation-step-right known))))
          (let ((entry (and known
                            (assoc-equal (list head tag)
                             (t4-evaluation-evaluation-rules-calls rules)))))
            (if entry
                (t4-evaluation-call-equation lib (cdr entry) datum env cons-step known tag evidence)
              (t4-evaluation-spine-equation rules lib head datum env cons-step evidence
               (cdr answer)))))))))

(defun t4-evaluation-evaluation-rules-reapply (rules lib term list-evaluator cons-step distinct replies)
  (proof-with-checked-results ((term (proof-list-of-length term 3)))
    (let* ((key (list (car term) list-evaluator))
           (entry (assoc-equal key (t4-evaluation-evaluation-rules-reapplications rules))))
      (if (not entry)
          '(:failure "MissingProofInput" "")
        (t4-evaluation-with-results
            ((fact (t4-evaluation-equation-fact lib (cdr entry) (cadr term) (caddr term)))
             (first (proof-step-first fact))
             (guard (proof-term-at first 1))
             (inner (proof-term-at guard 2))
             (hint (proof-term-at inner 1))
             (answer (t4-evaluation-reply :prove (list hint nil (list *t4-evaluation-synp*))
                       lib replies))
             (lib (cdar answer))
             (condition (t4-division-combine lib (list cons-step (caar answer) distinct)))
             (step (proof-proof-modus-ponens (library-library-proof lib) fact condition)))
          (cons step lib))))))

(defun t4-evaluation-evaluation-fold-choose (equation condition lib)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((right (t4-evaluation-step-right equation))
         (selected (proof-proof-select proof right condition)))
      (proof-proof-chain proof equation (list selected)))))

(defun t4-evaluation-evaluation-fold-endp (term evidence nonempty lib replies)
  (let* ((test (list *t4-evaluation-endp* term))
         (goal (if nonempty (proof-neg test) test))
         (definitions (list *t4-evaluation-endp* *t4-evaluation-atom* *proof-not*)))
    (t4-evaluation-reply :prove (list goal (list evidence) definitions) lib replies)))

(defun t4-evaluation-evaluation-fold-evaluation (call tests lib replies)
  (t4-evaluation-with-results
      ((answer (t4-evaluation-reply :evaluation (list call tests) lib replies)))
    (if (caar answer)
        answer
      '(:failure "SearchMiss" ""))))

(defun t4-evaluation-evaluation-fold-at-nil (term lib replies)
  (let ((definitions (list *t4-evaluation-endp* *t4-evaluation-atom* *proof-not*)))
    (t4-evaluation-with-results
        ((opened (proof-proof-unfold (library-library-proof lib) term))
         (answer (t4-evaluation-reply :prove
                   (list (list *t4-evaluation-endp* *proof-false*) nil definitions)
                   lib replies))
         (lib (cdar answer))
         (step (t4-evaluation-evaluation-fold-choose opened (caar answer) lib)))
      (cons (cons step lib) (cdr answer)))))

(defun t4-evaluation-evaluation-fold-lift (step a b lib)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((a (proof-proof-symmetric proof a))
         (step (proof-proof-rewrite proof step a '(1 1)))
         (b (proof-proof-symmetric proof b))
         (step (proof-proof-rewrite proof step b '(1 2))))
      (proof-proof-tidy proof step))))

(defun t4-evaluation-rewrite-reflexive (lib term equation place)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results ((step (proof-proof-reflexive proof term)))
      (proof-proof-rewrite proof step equation place))))

(defun t4-evaluation-fold-absent (lib left right obj shape atom printed replies)
  (t4-evaluation-with-results
      ((test (t4-evaluation-evaluation-fold-endp obj atom nil lib replies))
       (lib (cdar test))
       (no-syntax (t4-evaluation-evaluation-fold-choose printed (caar test) lib))
       (base-left (t4-evaluation-rewrite-reflexive lib left no-syntax '(1 2 1)))
       (term (t4-evaluation-step-right base-left))
       (primitive (t4-evaluation-evaluation-fold-evaluation term nil lib (cdr test)))
       (lib (cdar primitive))
       (term (t4-evaluation-step-right (caar primitive)))
       (reduced (t4-evaluation-reply :simplify (list term nil nil) lib (cdr primitive)))
       (lib (cdar reduced))
       (proof (library-library-proof lib))
       (base-left (proof-proof-chain proof base-left (list (caar primitive) (caar reduced))))
       (base-list (t4-evaluation-evaluation-fold-evaluation (cadr right) (list (list shape nil))
                   lib (cdr reduced)))
       (lib (cdar base-list))
       (base-right (t4-evaluation-rewrite-reflexive lib right (caar base-list) '(1 2 1)))
       (term (t4-evaluation-step-right base-right))
       (at-nil (t4-evaluation-evaluation-fold-at-nil term lib (cdr base-list)))
       (lib (cdar at-nil))
       (proof (library-library-proof lib))
       (base-right (proof-proof-chain proof base-right (list (caar at-nil))))
       (left (t4-evaluation-step-right base-left))
       (right (t4-evaluation-step-right base-right))
       (proved (t4-evaluation-reply :prove
                 (list (list *t4-evaluation-iff* left right) nil (list *t4-evaluation-iff*))
                 lib (cdr at-nil)))
       (lib (cdar proved))
       (absent (t4-evaluation-evaluation-fold-lift (caar proved) base-left base-right lib)))
    (cons (cons absent lib) (cdr proved))))

(defun t4-evaluation-fold-rewrite-selectors (lib pair folds)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((head (library-library-axiom lib "CAR-CONS" (cdr pair)))
         (folds (proof-proof-rewrite-first proof folds head))
         (tail (library-library-axiom lib "CDR-CONS" (cdr pair))))
      (proof-proof-rewrite-first proof folds tail))))

(defun t4-evaluation-fold-singleton-branch (lib h short sign replies)
  (proof-with-checked-results
      ((assumed (proof-proof-assume (library-library-proof lib) h sign)))
    (t4-evaluation-reply :prove (list short (list assumed) (list *t4-evaluation-iff*))
     lib replies)))

(defun t4-evaluation-fold-singleton (lib left h rest nonempty folds folded-tail list-eval env replies)
  (let* ((proof (library-library-proof lib))
         (rest-shape (list *proof-consp* rest)))
    (t4-evaluation-with-results
        ((assumed (proof-proof-assume proof rest-shape nil))
         (endp (t4-evaluation-evaluation-fold-endp rest assumed nil lib replies))
         (lib (cdar endp))
         (one (t4-evaluation-evaluation-fold-choose nonempty (caar endp) lib))
         (one-left (t4-evaluation-rewrite-reflexive lib left one '(1 2 1)))
         (tail-nil (t4-evaluation-evaluation-fold-evaluation (list list-eval rest env)
                    (list (list rest-shape nil)) lib (cdr endp)))
         (lib (cdar tail-nil))
         (empty-fold (t4-evaluation-rewrite-reflexive lib folded-tail (caar tail-nil) '(1 2 1)))
         (term (t4-evaluation-step-right empty-fold))
         (at-nil (t4-evaluation-evaluation-fold-at-nil term lib (cdr tail-nil)))
         (lib (cdar at-nil))
         (proof (library-library-proof lib))
         (empty-fold (proof-proof-chain proof empty-fold (list (caar at-nil))))
         (one-right (proof-proof-rewrite-first proof folds empty-fold))
         (left (t4-evaluation-step-right one-left))
         (right (t4-evaluation-step-right one-right))
         (short (list *t4-evaluation-iff* left right))
         (yes (t4-evaluation-fold-singleton-branch lib h short t (cdr at-nil)))
         (lib (cdar yes))
         (no (t4-evaluation-fold-singleton-branch lib h short nil (cdr yes)))
         (lib (cdar no))
         (one-result (proof-proof-cases (library-library-proof lib) h (caar yes) (caar no)))
         (step (t4-evaluation-evaluation-fold-lift one-result one-left one-right lib)))
      (cons (cons step lib) (cdr no)))))

(defun t4-evaluation-evaluation-fold-argument (sign lib h expansion folds ih replies)
  (let ((proof (library-library-proof lib)))
    (t4-evaluation-with-results
        ((test (proof-proof-assume proof h sign))
         (a (proof-proof-select proof expansion test))
         (target (t4-evaluation-step-right folds))
         (b (proof-proof-select proof target test))
         (left (t4-evaluation-step-right a))
         (right (t4-evaluation-step-right b))
         (claim (list *t4-evaluation-iff* left right))
         (hypothesis (proof-step-first ih))
         (proved (if (equal claim hypothesis)
                     (cons (cons ih lib) replies)
                   (t4-evaluation-reply :prove
                    (list claim (list test) (list *t4-evaluation-iff*)) lib replies)))
         (lib (cdar proved))
         (step (t4-evaluation-evaluation-fold-lift (caar proved) a b lib)))
      (cons (cons step lib) (cdr proved)))))

(defun t4-evaluation-fold-multiple (lib formula left obj rest h nonempty folds or-p replies)
  (let* ((proof (library-library-proof lib))
         (rest-shape (list *proof-consp* rest))
         (tail-value (list (car left) (list (caadr left) rest) (caddr left)))
         (expansion (if or-p
                        (proof-ite h h tail-value)
                      (proof-ite h tail-value *proof-false*)))
         (bindings (list (list obj rest))))
    (t4-evaluation-with-results
        ((assumed (proof-proof-assume proof rest-shape t))
         (endp (t4-evaluation-evaluation-fold-endp rest assumed t lib replies))
         (lib (cdar endp))
         (longer (t4-evaluation-evaluation-fold-choose nonempty (caar endp) lib))
         (long-left (t4-evaluation-rewrite-reflexive lib left longer '(1 2 1)))
         (value (t4-evaluation-step-right long-left))
         (first (t4-evaluation-reply :fact-proof
                   (list (list *t4-evaluation-iff* value expansion)) lib (cdr endp))))
      (if (not (caar first))
          '(:failure "SearchMiss" "")
        (t4-evaluation-with-results
            ((lib (cdar first))
             (proof (library-library-proof lib))
             (smaller (library-library-builtin lib 3 obj))
             (less (proof-step-first smaller))
             (instance (proof-subst formula (list (cons obj rest))))
             (guard (proof-ite less instance *proof-true*))
             (assumed (proof-proof-assume proof guard t))
             (ih (proof-proof-prove-if proof assumed smaller))
             (yes (t4-evaluation-evaluation-fold-argument t lib h expansion folds ih (cdr first)))
             (lib (cdar yes))
             (no (t4-evaluation-evaluation-fold-argument nil lib h expansion folds ih (cdr yes)))
             (lib (cdar no))
             (proof (library-library-proof lib))
             (comparison (proof-proof-cases proof h (caar yes) (caar no)))
             (antecedent (t4-division-combine lib (list (caar first) comparison)))
             (premise (proof-step-first antecedent))
             (fold-value (t4-evaluation-step-right folds))
             (thesis (list *t4-evaluation-iff* value fold-value))
             (law (t4-evaluation-reply :fact-proof
                    (list (list *library-implies* premise thesis)) lib (cdr no))))
          (if (not (caar law))
              '(:failure "SearchMiss" "")
            (t4-evaluation-with-results
                ((lib (cdar law))
                 (proof (library-library-proof lib))
                 (step (proof-proof-modus-ponens proof (caar law) antecedent))
                 (multiple (t4-evaluation-evaluation-fold-lift step long-left folds lib)))
              (list multiple lib bindings))))))))

(defun t4-evaluation-fold-present (lib formula left right obj rest list-eval shape cons-step printed absent replies)
  (t4-evaluation-with-results
      ((test (t4-evaluation-evaluation-fold-endp obj cons-step t lib replies))
       (lib (cdar test))
       (nonempty (t4-evaluation-evaluation-fold-choose printed (caar test) lib))
       (evaluated (t4-evaluation-evaluation-fold-evaluation (cadr right)
                   (list (list shape t)) lib (cdr test)))
       (lib (cdar evaluated))
       (pair (t4-evaluation-step-right (caar evaluated))))
    (if (not (proof-is-call pair *proof-cons*))
        '(:failure "SearchMiss" "")
      (t4-evaluation-with-results
          ((proof (library-library-proof lib))
           (folds (t4-evaluation-rewrite-reflexive lib right (caar evaluated) '(1 2 1)))
           (term (t4-evaluation-step-right folds))
           (opened (proof-proof-unfold proof term))
           (shape-pair (proof-proof-fact proof "consp-cons"
                        (seq-zip (list *library-x* *library-y*) (cdr pair))))
           (test (t4-evaluation-evaluation-fold-endp pair shape-pair t lib (cdr evaluated)))
           (lib (cdar test))
           (chosen (t4-evaluation-evaluation-fold-choose opened (caar test) lib))
           (folds (proof-proof-chain (library-library-proof lib) folds (list chosen)))
           (folds (t4-evaluation-fold-rewrite-selectors lib pair folds))
           (parts (proof-list-of-length (cdr pair) 2))
           (h (car parts))
           (folded-tail (list (car right) (cadr parts)))
           (or-result (proof-ite h *proof-true* folded-tail))
           (and-result (proof-ite h folded-tail *proof-false*))
           (value (t4-evaluation-step-right folds)))
        (if (and (not (equal value or-result)) (not (equal value and-result)))
            '(:failure "SearchMiss" "")
          (t4-evaluation-with-results
              ((rest-shape (list *proof-consp* rest))
               (singleton (t4-evaluation-fold-singleton lib left h rest nonempty folds folded-tail
                           list-eval (caddr left) (cdr test)))
               (lib (cdar singleton))
               (multiple (t4-evaluation-fold-multiple lib formula left obj rest h nonempty
                          folds (equal value or-result) (cdr singleton)))
               (lib (cadr multiple))
               (proof (library-library-proof lib))
               (long-or-short (proof-proof-cases proof rest-shape (car multiple) (caar singleton)))
               (cases (proof-proof-cases proof shape long-or-short absent))
               (ordinal (library-library-builtin lib 1 obj))
               (inducted (proof-proof-induct proof ordinal cases formula
                          (t4-structural-count obj) (list (caddr multiple)))))
            (cons inducted lib)))))))

(defun t4-evaluation-fold-branches (lib formula left right obj rest list-eval printed replies)
  (let ((shape (list *proof-consp* obj)))
    (t4-evaluation-with-results
        ((arithmetic (t4-evaluation-reply :use-arithmetic nil lib replies))
         (lib (car arithmetic))
         (proof (library-library-proof lib))
         (cons-step (proof-proof-assume proof shape t))
         (atom (proof-proof-assume proof shape nil))
         (absent (t4-evaluation-fold-absent lib left right obj shape atom printed (cdr arithmetic))))
      (t4-evaluation-fold-present (cdar absent) formula left right obj rest list-eval
       shape cons-step printed (caar absent) (cdr absent)))))

(defun t4-evaluation-fold-shape (lib formula left right syntax obj list-eval replies)
  (let ((rest (list *library-cdr* obj)))
    (proof-with-checked-results
        ((printed (proof-proof-unfold (library-library-proof lib) syntax))
         (top (t4-evaluation-step-right printed))
         (first-test (and (proof-is-call top *proof-if*) (proof-term-at top 1)))
         (inner (and (equal first-test (list *t4-evaluation-endp* obj)) (proof-term-at top 3)))
         (second-test (and (proof-is-call inner *proof-if*) (proof-term-at inner 1)))
         (singleton (and (equal second-test (list *t4-evaluation-endp* rest))
                         (proof-term-at inner 2))))
      (if (not (equal singleton (list *library-car* obj)))
          (cons nil lib)
        (proof-with-checked-results ((reduced (proof-term-at inner 3)))
          (if (and (proof-compound reduced)
                   (equal (cdr reduced) (list singleton (list (car syntax) rest))))
              (t4-evaluation-fold-branches lib formula left right obj rest list-eval printed replies)
            (cons nil lib)))))))

(defun t4-evaluation-evaluation-fold (lib formula rules replies)
  (if (not (proof-is-call formula *t4-evaluation-iff*))
      (cons nil lib)
    (proof-with-checked-results ((parts (proof-list-of-length (cdr formula) 2)))
      (let* ((left (car parts))
             (right (cadr parts))
             (syntax (cadr left))
             (functions (t4-evaluation-evaluation-rules-functions rules)))
        (if (not (and (proof-compound left)
                      (equal (len left) 3)
                      (member-equal (car left) functions)
                      (proof-compound syntax)
                      (equal (len syntax) 2)
                      (proof-compound right)
                      (equal (len right) 2)))
            (cons nil lib)
          (let* ((obj (cadr syntax))
                 (env (caddr left))
                 (definitions (proof-proof-definitions (library-library-proof lib)))
                 (list-call (cadr right)))
            (if (or (proof-compound obj)
                    (not (assoc-equal (car syntax) definitions))
                    (not (assoc-equal (car right) definitions))
                    (not (proof-compound list-call)))
                (cons nil lib)
              (proof-with-checked-results ((list-eval (proof-term-at list-call 0)))
                (if (and (member-equal list-eval functions)
                         (equal (cdr list-call) (list obj env)))
                    (t4-evaluation-fold-shape lib formula left right syntax obj list-eval replies)
                  (cons nil lib))))))))))
