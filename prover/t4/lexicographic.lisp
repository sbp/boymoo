         (proof (library-library-proof lib)))
    (proof-with-checked-results
     ((yes (proof-proof-assume proof test t))
      (no (proof-proof-assume proof test nil))
      (pair (t4-ordinals-ordinals-simplify lib term (list yes) definitions))
      (lib (cdr pair))
      (atom-case (t4-ordinals-ordinals-simplify lib term (list no) definitions))
      (lib (cdr atom-case))
      (proof (library-library-proof lib))
      (proper (list *t4-lexicographic-fix-list* x))
      (result (t4-lexicographic-lexicographic-branch-value lib proper yes))
      (value (proof-rewritten-term result))
      (fields (proof-list-of-length value 3))
      (cons-proof (proof-proof-fact
                   proof "consp-cons" (list (list x (cadr fields)) (list *library-y* (caddr fields)))))
      (cons-proof (library-library-transport-argument lib cons-proof result 1))
      (nat (list *library-natp* proper))
      (claim (list *t4-lexicographic-lex-type* proper))
      (nat-yes (proof-proof-assume proof nat t))
      (pair-yes (t4-ordinals-ordinals-prove lib claim (list nat-yes) type-definitions))
      (lib (cdr pair-yes))
      (proof (library-library-proof lib))
      (nat-no (proof-proof-assume proof nat nil))
      (typed (library-library-cite lib "LEX-FIX-LIST-TYPE" (list x) nil))
      (pair-no (t4-ordinals-ordinals-prove lib claim (list nat-no cons-proof typed) type-definitions))
      (lib (cdr pair-no))
      (proof (library-library-proof lib))
      (pair-proof (proof-proof-cases proof nat (car pair-yes) (car pair-no)))
      (pair-proof (library-library-transport-argument lib pair-proof (car pair) 1))
      (natural (t4-ordinals-ordinals-natural lib (list *library-nfix* x)))
      (nfix-equal (t4-lexicographic-lexicographic-nfix-equal lib x))
      (nat (library-library-transport-argument lib natural nfix-equal 1))
      (atom-proof (t4-ordinals-ordinals-prove lib
                    (list *t4-lexicographic-lex-type* (list *t4-lexicographic-fix* x))
