(defun t4-lexicographic-lex-parts-with-library (lib obj lex-proof cons-proof)
  (let ((proof (library-library-proof lib))
        (nat (list *library-natp* obj))
        (definitions (list *t4-lexicographic-lex-type*)))
    (proof-with-checked-results
     ((literal (proof-step-first cons-proof))
      (head (proof-term-at literal 0)))
     (if (equal head *proof-not*)
         (proof-with-checked-results
          ((not-nat (proof-proof-assume proof nat nil))
           (simplified (t4-ordinals-ordinals-simplify-first lib lex-proof (list cons-proof not-nat)
                                                       definitions))
           (lib (cdr simplified))
           (step (proof-proof-front (library-library-proof lib) (car simplified) nat)))
          (cons step lib))
       (proof-with-checked-results
        ((supported (proof-proof-assume proof nat t))
         (integral (library-library-cite lib "NATURAL-INTEGER" (list obj) (list supported)))
         (number (proof-proof-fact proof "rationalp-acl2-numberp" (list (list *library-x* obj))))
         (rational (library-library-axiom lib "INTEGER-IMPLIES-RATIONAL" (list obj)))
         (type (t4-ordinals-ordinals-type-of lib obj (list integral)))
         (rational (proof-proof-modus-ponens proof rational type))
         (numeric (proof-proof-modus-ponens proof number rational))
         (nonnumber (proof-proof-fact proof "consp-not-acl2-numberp" (list (list *library-x* obj))))
         (nonnumeric (proof-proof-modus-ponens proof nonnumber cons-proof))
         (no-nat (proof-proof-cut proof numeric nonnumeric))
         (no-nat (proof-proof-front proof no-nat (proof-neg nat))))
        (t4-ordinals-ordinals-simplify-first lib lex-proof (list cons-proof no-nat) definitions))))))

(defun t4-lexicographic-lexicographic-lex-parts (lib obj lex-proof cons-proof)
  (proof-with-checked-results
   ((result (t4-lexicographic-lex-parts-with-library lib obj lex-proof cons-proof)))
   (car result)))

(defun t4-lexicographic-lexicographic-lex-order-impossible (positive negative lib claim)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
     ((contradiction (proof-proof-cut proof positive negative)))
     (proof-proof-subsume proof contradiction (cons claim (proof-step-clause contradiction))))))

(defun t4-lexicographic-lexicographic-lex-order (lib)
  (let* ((x *library-x*)
         (y *library-y*)
         (encode-x (list *t4-lexicographic-encode* x))
         (encode-y (list *t4-lexicographic-encode* y))
         (lx (list *library-len* x))
         (ly (list *library-len* y))
         (ex (list *proof-consp* x))
         (ey (list *proof-consp* y))
         (claim (list *proof-ordinal-less* encode-x encode-y))
         (length-lt (library-lt lx ly))
         (proof (library-library-proof lib)))
    (proof-with-checked-results
     ((yes-x (proof-proof-assume proof ex t))
      (no-x (proof-proof-assume proof ex nil))
      (yes-y (proof-proof-assume proof ey t))
      (no-y (proof-proof-assume proof ey nil))
      (px (t4-lexicographic-lexicographic-branch-value lib encode-x yes-x))
      (py (t4-lexicographic-lexicographic-branch-value lib encode-y yes-y))
      (ax (t4-lexicographic-lexicographic-branch-value lib encode-x no-x))
      (ay (t4-lexicographic-lexicographic-branch-value lib encode-y no-y))
      (length-proof (proof-proof-assume proof length-lt t))
      (left-block (proof-rewritten-term px))
      (right-block (proof-rewritten-term py))
      (lx-zero (t4-lexicographic-lexicographic-branch-value lib lx no-x))
      (ly-zero (t4-lexicographic-lexicographic-branch-value lib ly no-y))
      (shorter-block (t4-ordinals-ordinals-order-blocks lib left-block right-block length-proof nil nil))
      (lib (cdr shorter-block))
      (shorter-block (t4-lexicographic-lexicographic-lex-order-transport (car shorter-block) px py lib))
      (ax-term (proof-rewritten-term ax))
      (finite-left (t4-ordinals-ordinals-finite-below-block lib ax-term right-block))
      (lib (cdr finite-left))
      (finite-left (t4-lexicographic-lexicographic-lex-order-transport (car finite-left) ax py lib))
      (proof (library-library-proof lib))
      (length-under-zero (proof-proof-rewrite proof length-proof ly-zero '(1 2)))
      (natural-lx (t4-ordinals-ordinals-natural lib lx))
      (length-nonneg (library-library-cite lib "NATURAL-NONNEGATIVE" (list lx) (list natural-lx)))
      (shorter-pair (proof-proof-cases proof ex shorter-block finite-left))
      (shorter-empty (t4-lexicographic-lexicographic-lex-order-impossible
                      length-under-zero length-nonneg lib claim))
      (shorter (proof-proof-cases proof ey shorter-pair shorter-empty))
      (lless (list *t4-lexicographic-l-less* x y))
      (lless-fact (proof-proof-assume proof lless t))
      (lless-view (proof-proof-unfold proof lless))
      (opened (proof-proof-rewrite proof lless-fact lless-view '(1)))
      (length-not-lt (proof-proof-assume proof length-lt nil))
      (same-length (proof-proof-prove-if proof opened length-not-lt))
      (same-length (proof-proof-conjunct proof same-length))
      (lengths-equal (car same-length))
      (order (cadr same-length))
      (length-eq-term (proof-step-first lengths-equal))
      (length-eq-view (proof-proof-unfold proof length-eq-term))
      (lengths-equal (proof-proof-rewrite proof lengths-equal length-eq-view '(1)))
      (left-zero (proof-proof-rewrite proof lengths-equal lx-zero '(1 1)))
      (right-zero (proof-proof-rewrite proof lengths-equal ly-zero '(1 2)))
      (positive-y (t4-lexicographic-lexicographic-length-positive lib y yes-y))
      (unequal-y (t4-ordinals-ordinals-distinct lib positive-y nil))
      (left-empty (t4-lexicographic-lexicographic-lex-order-impossible left-zero unequal-y lib claim))
      (positive-x (t4-lexicographic-lexicographic-length-positive lib x yes-x))
      (right-unequal (t4-ordinals-ordinals-distinct lib positive-x nil))
      (right-zero-reversed (proof-proof-symmetric proof right-zero))
      (right-empty (t4-lexicographic-lexicographic-lex-order-impossible
                    right-zero-reversed right-unequal lib claim))
      (lex-x-term (list *t4-lexicographic-lex-type* x))
      (lex-y-term (list *t4-lexicographic-lex-type* y))
      (lex-x (proof-proof-assume proof lex-x-term t))
      (lex-y (proof-proof-assume proof lex-y-term t))
      (nat-x (t4-lexicographic-lex-parts-with-library lib x lex-x no-x))
      (lib (cdr nat-x))
      (nat-y (t4-lexicographic-lex-parts-with-library lib y lex-y no-y))
      (lib (cdr nat-y))
      (proof (library-library-proof lib))
      (atom-view (proof-proof-unfold proof (list *t4-structural-atom* x)))
      (atom-x (proof-proof-transport proof no-x atom-view))
      (int-x (library-library-cite lib "NATURAL-INTEGER" (list x) (list (car nat-x))))
      (int-y (library-library-cite lib "NATURAL-INTEGER" (list y) (list (car nat-y))))
      (numeric (proof-proof-prove-if proof order atom-x))
      (finite-order (library-library-cite lib "FINITE-ORDER" (list x y) (list int-x int-y)))
      (numeric (proof-proof-transport proof numeric finite-order))
      (fx (t4-lexicographic-lexicographic-branch-value lib (list *library-nfix* x) (car nat-x)))
      (fy (t4-lexicographic-lexicographic-branch-value lib (list *library-nfix* y) (car nat-y)))
      (left (proof-proof-chain proof ax (list fx)))
      (right (proof-proof-chain proof ay (list fy)))
      (finite-pair (t4-lexicographic-lexicographic-lex-order-transport numeric left right lib))
      (nonatom-x (t4-ordinals-ordinals-prove lib (proof-neg (list *t4-structural-atom* x))
                                        (list yes-x) (list *t4-structural-atom* *proof-not*)))
      (lib (cdr nonatom-x))
      (proof (library-library-proof lib))
      (dless (proof-proof-prove-if proof order (car nonatom-x)))
      (lemma (library-library-cite lib "LEX-DIGIT-ORDER" (list x y) nil))
      (statement (proof-step-first lemma))
      (hyp-term (proof-term-at statement 1))
      (list-x (t4-lexicographic-lex-parts-with-library lib x lex-x yes-x))
      (lib (cdr list-x))
      (list-y (t4-lexicographic-lex-parts-with-library lib y lex-y yes-y))
      (lib (cdr list-y))
      (digit-hyp (t4-ordinals-ordinals-prove lib hyp-term
                   (list (car list-x) (car list-y) lengths-equal dless) nil))
      (lib (cdr digit-hyp))
      (proof (library-library-proof lib))
      (equal-blocks (proof-proof-modus-ponens proof lemma (car digit-hyp)))
      (equal-cons-x (proof-proof-cases proof ey equal-blocks right-empty))
      (equal-atom-x (proof-proof-cases proof ey left-empty finite-pair))
      (equal-length (proof-proof-cases proof ex equal-cons-x equal-atom-x))
      (step (proof-proof-cases proof length-lt shorter equal-length))
      (lex-x-term (proof-step-first lex-x))
      (lex-y-term (proof-step-first lex-y)))
     (library-library-lemma lib "LEX-ORDER" claim step
                            (list (proof-neg lex-x-term) (proof-neg lex-y-term) (proof-neg lless))))))

(defun t4-lexicographic-lexicographic-build-embedding (lib)
