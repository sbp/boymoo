     ((yes (proof-proof-assume proof test t))
      (no (proof-proof-assume proof test nil))
      (descent (library-library-builtin lib 3 x))
      (descent-term (proof-step-first descent))
      (ih (proof-proof-assume proof (proof-ite descent-term smaller *proof-true*) t))
      (ih (proof-proof-prove-if proof ih descent))
