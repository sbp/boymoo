      (dless (car result))
      (result (t4-structural-evidence-require (cdr result) length-claim))
      (length-eq (car result))
      (evidence (cdr result))
      (dless-definition (proof-proof-unfold proof smaller))
      (opened (proof-proof-rewrite proof dless dless-definition '(1)))
      (opened (proof-proof-prove-if proof opened cons-x))
      (opened (proof-proof-prove-if proof opened cons-y))
