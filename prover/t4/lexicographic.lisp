(defun t4-lexicographic-first-order-test (tests)
  (if (endp tests)
      '(:failure "failure" "")
    (proof-with-checked-results
     ((pair (proof-list-of-length (car tests) 2)))
     (if (cadr pair)
         (proof-with-checked-results
          ((head (proof-term-at (car pair) 0)))
          (if (equal head *t4-lexicographic-l-less*)
              (car pair)
            (t4-lexicographic-first-order-test (cdr tests))))
       (t4-lexicographic-first-order-test (cdr tests))))))

(defun t4-lexicographic-lexicographic-do-descent (lib goal call)
  (proof-with-checked-results
   ((goal (proof-list-of-length goal 3))
    (left-part (proof-list-of-length (cadr goal) 2))
    (right-part (proof-list-of-length (caddr goal) 2))
    (test (t4-lexicographic-first-order-test (termination-call-tests call)))
    (operands (proof-list-of-length (cdr test) 2))
    (lhs (car operands))
    (rhs (cadr operands))
    (old (proof-term-at rhs 1))
    (branches (if (integerp old)
                  '(:failure "MalformedCandidate" "")
                (proof-list-of-length (cdr old) 3))))
   (let ((p (car branches))
         (yes (cadr branches))
         (no (caddr branches))
         (left (cadr left-part))
         (right (cadr right-part))
         (proof (library-library-proof lib)))
     (if (and (equal yes (proof-ite p no *proof-false*))
              (equal lhs left)
              (equal (list *t4-lexicographic-lex-fix* no) right))
         (proof-with-checked-results
          ((old-true (proof-proof-if-true proof old))
           (yes-true (proof-proof-if-true proof yes))
           (true-case (proof-proof-chain proof old-true (list yes-true)))
           (old-false (proof-proof-if-false proof old))
           (sameness (proof-proof-cases proof p true-case old-false))
           (assumed (proof-proof-assume proof test t))
           (less (proof-proof-rewrite proof assumed sameness '(1 2 1)))
           (left-args (if (integerp lhs) '(:failure "MalformedCandidate" "")
                        (cdr lhs)))
           (type-left (library-library-cite lib "LEX-FIX-TYPE" left-args nil))
           (type-right (library-library-cite lib "LEX-FIX-TYPE" (cdr right) nil)))
          (library-library-cite lib "LEX-ORDER" (list left right) (list type-left type-right less)))
       '(:failure "InferenceMismatch" "")))))
