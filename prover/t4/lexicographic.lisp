      (case-step (proof-proof-cases proof test good bad))
      (step (proof-proof-induct proof ordinal case-step formula (t4-structural-count x)
                                (list (list (list x tail))))))
     (library-library-lemma lib "LEX-FIX-LIST-TYPE" formula step nil))))

(defun t4-lexicographic-lexicographic-fix-type (lib)
