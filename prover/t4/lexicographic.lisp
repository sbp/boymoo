      (block-x (proof-rewritten-term value-x))
      (block-y (proof-rewritten-term value-y))
      (cx (list *library-car* x))
      (cy (list *library-car* y))
      (nx (list *library-nfix* cx))
      (ny (list *library-nfix* cy))
      (fix-x (t4-lexicographic-lexicographic-branch-value lib nx (caar fields-x)))
      (fix-y (t4-lexicographic-lexicographic-branch-value lib ny (caar fields-y)))
      (head-less (library-lt cx cy))
