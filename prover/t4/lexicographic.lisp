(defun t4-lexicographic-conjunction (terms)
  (cond ((endp terms) '(:failure "MalformedCandidate" ""))
        ((endp (cdr terms)) (car terms))
        (t (proof-ite (car terms)
                      (t4-lexicographic-conjunction (cdr terms))
                      *proof-false*))))

(defun t4-lexicographic-lexicographic-branch-value (lib term test-proof)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
     ((opened (proof-proof-unfold proof term))
      (body (proof-rewritten-term opened))
      (selected (proof-proof-select proof body test-proof)))
     (proof-proof-chain proof opened (list selected)))))

(defun t4-lexicographic-lexicographic-length-positive (lib obj cons-proof)
  (let ((length (list *library-len* (list *library-cdr* obj))))
    (proof-with-checked-results
     ((natural (t4-ordinals-ordinals-natural lib length))
      (bottom (library-library-cite lib "NATURAL-NONNEGATIVE" (list length) (list natural)))
      (shorter (library-library-cite lib "LEN-CDR-LESS" (list obj) (list cons-proof)))
      (result (t4-structural-structural-comparison-chain lib bottom shorter)))
     (car result))))

(defun t4-lexicographic-lexicographic-encodings (lib)
  (let* ((x *library-x*)
         (tail (list *library-cdr* x))
         (cons-test (list *proof-consp* x))
         (measure (t4-structural-count x))
         (current (list *t4-lexicographic-encode* x))
         (child (list *t4-lexicographic-encode* tail))
         (fixed (list *library-nfix* (list *library-car* x)))
         (coeff (library-plus *proof-one* fixed))
         (length (list *library-len* x))
         (block (list *t4-ordinals-make* length coeff child))
         (finite (list *library-nfix* x))
         (formals (list x))
         (definition (proof-ite cons-test block finite))
         (name *t4-lexicographic-encode*))
    (proof-with-checked-results
     ((proof (proof-proof-add-definition (library-library-proof lib) name formals definition))
      (lib (library-library-with-proof lib proof))
      (source (proof-line "define" (list (list *proof-if*) (list name formals definition))))
      (lib (library-library-with-entries
            lib (append (library-library-entries lib) (list (list "define" name nil source)))))
      (descent (library-library-builtin lib 3 x))
      (ordinal (library-library-builtin lib 1 x))
      (descent-term (proof-step-first descent))
      (decrease (proof-proof-subsume proof descent (list (proof-neg cons-test) descent-term)))
      (entry (proof-proof-entry "measure" name (list name measure) (list ordinal decrease)))
      (lib (library-library-with-entries lib (append (library-library-entries lib) (list entry))))
      (yes (proof-proof-assume proof cons-test t))
      (no (proof-proof-assume proof cons-test nil))
      (as-block (t4-lexicographic-lexicographic-branch-value lib current yes))
      (as-finite (t4-lexicographic-lexicographic-branch-value lib current no))
      (expt (list *t4-ordinals-exponent* current))
      (view (t4-ordinals-ordinals-constructor-view lib *t4-ordinals-exponent* block))
      (lib (cdr view))
      (proof (library-library-proof lib))
      (reverse-block (proof-proof-symmetric proof as-block))
      (yes-expt (proof-proof-rewrite proof (car view) reverse-block '(1 1 1)))
      (finite-int (t4-ordinals-ordinals-type-of lib finite nil))
      (is-finite (library-library-cite lib "INTEGER-FINITE" (list finite) (list finite-int)))
      (no-expt (t4-lexicographic-lexicographic-branch-value
                lib (list *t4-ordinals-exponent* finite) is-finite))
      (reverse-finite (proof-proof-symmetric proof as-finite))
      (no-expt (proof-proof-rewrite proof no-expt reverse-finite '(1 1 1)))
      (empty-length (t4-lexicographic-lexicographic-branch-value lib length no))
      (no-expt (library-library-transport-argument lib no-expt empty-length 2))
      (exponents (proof-proof-cases proof cons-test yes-expt no-expt))
      (lib (library-library-lemma lib "LEX-EXPONENT" (proof-eq expt length) exponents nil))
      (proof (library-library-proof lib))
      (formula (list *proof-ordinalp* current))
      (rest-ord (list *proof-ordinalp* child))
      (ih (proof-proof-assume proof (proof-ite descent-term rest-ord *proof-true*) t))
      (rest-ordinal (proof-proof-prove-if proof ih descent))
      (length-smaller (library-library-cite lib "LEN-CDR-LESS" (list x) (list yes)))
      (comparison (library-library-ordinal-comparison lib (list *library-len* tail) length))
      (exp-order (proof-proof-transport proof length-smaller comparison))
      (tail-expt (library-library-cite lib "LEX-EXPONENT" (list tail) nil))
      (exp-order (library-library-transport-argument lib exp-order tail-expt 1))
      (exp-positive (t4-lexicographic-lexicographic-length-positive lib x yes))
      (fixed-nat (t4-ordinals-ordinals-natural lib fixed))
      (nonneg (library-library-cite lib "NATURAL-NONNEGATIVE" (list fixed) (list fixed-nat)))
      (fixed-int (t4-ordinals-ordinals-type-of lib fixed nil))
      (coeff-positive (library-library-cite lib "POSITIVE-ONE-PLUS" (list fixed) (list fixed-int nonneg)))
      (exp-natural (t4-ordinals-ordinals-natural lib length))
      (yes-ord (t4-ordinals-ordinals-make-ordinal
                lib block exp-natural exp-positive coeff-positive rest-ordinal exp-order nil))
      (lib (cdr yes-ord))
      (yes-ord (library-library-transport-argument lib (car yes-ord) as-block 1))
      (finite-ordinal (library-library-cite lib "NFIX-ORDINAL" (list x) nil))
      (no-ord (library-library-transport-argument lib finite-ordinal as-finite 1))
      (proof (library-library-proof lib))
      (case-step (proof-proof-cases proof cons-test yes-ord no-ord))
      (step (proof-proof-induct proof ordinal case-step formula measure (list (list (list x tail))))))
     (library-library-lemma lib "LEX-ORDINAL" formula step nil))))

