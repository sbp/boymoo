(defun t4-lexicographic-lexicographic-tail-lengths-equal (lib same-length cons-x cons-y)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
     ((literal-x (proof-step-first cons-x))
      (x (proof-term-at literal-x 1))
      (literal-y (proof-step-first cons-y))
      (y (proof-term-at literal-y 1))
      (len-x (list *library-len* x))
      (len-y (list *library-len* y))
      (value-x (t4-lexicographic-lexicographic-branch-value lib len-x cons-x))
      (a (proof-rewritten-term value-x))
      (value-y (t4-lexicographic-lexicographic-branch-value lib len-y cons-y))
      (b (proof-rewritten-term value-y))
      (value-x (t4-lexicographic-lexicographic-branch-value lib len-x cons-x))
      (expanded (proof-proof-rewrite proof same-length value-x '(1 1)))
      (value-y (t4-lexicographic-lexicographic-branch-value lib len-y cons-y))
      (expanded (proof-proof-rewrite proof expanded value-y '(1 2)))
      (diff-a (library-diff a *proof-one*))
      (reflexive (proof-proof-reflexive proof diff-a))
      (delta (proof-proof-rewrite proof reflexive expanded '(1 2 1)))
      (a-tail (proof-term-at a 2))
      (a-equal (library-library-linear-equal lib diff-a a-tail nil))
      (a-equal (proof-proof-symmetric proof a-equal))
      (b-tail (proof-term-at b 2))
      (b-equal (library-library-linear-equal lib (library-diff b *proof-one*) b-tail nil)))
     (proof-proof-chain proof a-equal (list delta b-equal)))))

