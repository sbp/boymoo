(in-package "BOYMOO-PROVER")
(set-verify-guards-eagerness 0)

(defconst *t4-mvmeta-transform* (proof-sym "MV-NTH-EVAL-FN" "ACL2"))
(defconst *t4-mvmeta-transform-step* (proof-sym "MV-NTH-EVAL-REC" "ACL2"))
(defconst *t4-mvmeta-transform-correct* (proof-sym "EVAL-FOR-MV-NTH-REC-THM" "ACL2"))

(defun t4-mvmeta-request-p (value)
  (and (consp value) (eq (car value) :call)))

(defund t4-mvmeta-interrupted-p (value)
  (or (failure-p value) (t4-mvmeta-request-p value)))

(defmacro t4-mvmeta-with-library (bindings result)
  (if (endp bindings)
      result
    (let* ((binding (car bindings))
           (name (car binding))
           (form (cadr binding))
           (rest `(t4-mvmeta-with-library ,(cdr bindings) ,result)))
      (if (caddr binding)
          `(let* ((mvmeta-result ,form)
                  (,name (if (failure-p mvmeta-result) mvmeta-result
                           (car mvmeta-result)))
                  (lib (if (failure-p mvmeta-result) lib (cdr mvmeta-result))))
             (if (t4-mvmeta-interrupted-p ,name) (cons ,name lib) ,rest))
        `(let ((,name ,form))
           (if (t4-mvmeta-interrupted-p ,name) (cons ,name lib) ,rest))))))

(defun t4-mvmeta-request (kind lib args replies)
  (let* ((request (list* :call kind lib args))
         (reply (assoc-equal request replies)))
    (if reply (cdr reply) (cons request lib))))

(defund t4-mvmeta-right (equation)
  (proof-with-checked-results ((literal (proof-step-first equation)))
    (proof-term-at literal 2)))

(defun t4-mvmeta-choose (lib equation premise)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((conditional (t4-mvmeta-right equation))
         (selected (proof-proof-select proof conditional premise)))
      (proof-proof-chain proof equation (list selected)))))

(defun t4-mvmeta-index-selector-with-replies (lib term shape index-test replies)
  (t4-mvmeta-with-library
      ((opening (proof-proof-unfold (library-library-proof lib) term))
       (body (t4-mvmeta-right opening))
       (test (proof-term-at body 1))
       (shape-term (proof-step-first shape))
       (datum (proof-term-at term 2))
       (cons-p (equal shape-term (list *proof-consp* datum)))
       (selected
        (let ((goal (if cons-p (proof-neg test) test))
              (evidence (list shape))
              (definitions (list *t4-results-atom* *t4-results-endp* *proof-not*)))
          (if (eq replies :ordinals)
              (t4-ordinals-ordinals-prove lib goal evidence definitions)
            (t4-mvmeta-request :prove lib (list goal evidence definitions) replies)))
        :library)
       (equation (t4-mvmeta-choose lib opening selected)))
    (if (not cons-p)
        (cons equation lib)
      (t4-mvmeta-with-library ((equation (t4-mvmeta-choose lib equation index-test)))
        (if (proof-is-call datum *proof-cons*)
            (t4-mvmeta-with-library
                ((signed (proof-step-first index-test))
                 (selector (if (equal signed (list *t4-results-zp* (cadr term)))
                               "CAR-CONS" "CDR-CONS"))
                 (axiom (library-library-axiom lib selector (cdr datum))))
              (cons (proof-proof-rewrite-first (library-library-proof lib) equation axiom) lib))
          (cons equation lib))))))

(defun t4-mvmeta-index-selector-with-library (lib term shape index-test)
  (t4-mvmeta-index-selector-with-replies lib term shape index-test :ordinals))

(defun t4-mvmeta-index-selector (lib term shape index-test)
  (car (t4-mvmeta-index-selector-with-library lib term shape index-test)))

(defun t4-mvmeta-index-equivalence-case (sign positive lib shape stop left right hypothesis replies)
  (let ((proof (library-library-proof lib)))
    (t4-mvmeta-with-library
        ((known (proof-proof-assume proof shape sign))
         (test (proof-proof-assume proof stop positive))
         (a (t4-mvmeta-index-selector-with-replies lib left known test replies) :library)
         (b (t4-mvmeta-index-selector-with-replies lib right known test replies) :library)
         (a-right (t4-mvmeta-right a))
         (b-right (t4-mvmeta-right b))
         (proof (library-library-proof lib))
         (middle (if (equal a-right b-right) (proof-proof-reflexive proof a-right) hypothesis))
         (reversed (proof-proof-symmetric proof b)))
      (cons (proof-proof-chain proof a (list middle reversed)) lib))))

(defun t4-mvmeta-index-equivalence-with-replies (lib index value replies)
  (let ((name "LIST-INDEX-EQUIVALENCE")
        (proof (library-library-proof lib)))
    (if (assoc-equal (proof-sym "SELF-LIST-INDEX-EQUIVALENCE" "ACL2")
                     (proof-proof-facts proof))
        (cons (library-library-cite lib name (list value index) nil) lib)
      (let* ((x *library-x*)
             (y *library-y*)
             (left (list *t4-results-nth* y x))
             (right (list *t4-results-mv-nth* y x))
             (claim (proof-eq left right))
             (shape (list *proof-consp* x))
             (stop (list *t4-results-zp* y))
             (smaller-index (library-plus *proof-neg-one* y))
             (tail (list *library-cdr* x))
             (binding (list (list y smaller-index) (list x tail))))
        (t4-mvmeta-with-library
            ((decrease (library-library-builtin lib 3 x))
             (decrease-term (proof-step-first decrease))
             (induction-term (proof-subst claim (list (cons y smaller-index) (cons x tail))))
             (conditional (proof-ite decrease-term induction-term *proof-true*))
             (assumed (proof-proof-assume proof conditional t))
             (hypothesis (proof-proof-prove-if proof assumed decrease))
             (yes (t4-mvmeta-index-equivalence-case t t lib shape stop left right hypothesis
                                                   replies)
                  :library)
             (later (t4-mvmeta-index-equivalence-case t nil lib shape stop left right hypothesis
                                                     replies)
                    :library)
             (cons-case (proof-proof-cases (library-library-proof lib) stop yes later))
             (no (t4-mvmeta-index-equivalence-case nil nil lib shape stop left right hypothesis
                                                  replies)
                 :library)
             (proof (library-library-proof lib))
             (result (proof-proof-cases proof shape cons-case no))
             (ordinal (library-library-builtin lib 1 x))
             (induction (proof-proof-induct proof ordinal result claim
                                            (t4-structural-count x) (list binding)))
             (updated (library-library-lemma lib name claim induction nil)))
          (cons (library-library-cite updated name (list value index) nil) updated))))))

(defun t4-mvmeta-index-equivalence (lib index value)
  (t4-mvmeta-index-equivalence-with-replies lib index value :ordinals))

(defund t4-mvmeta-evaluate-pair (lib equation pair)
  (if (proof-is-call pair *proof-cons*)
      (let ((proof (library-library-proof lib)))
        (proof-with-checked-results
            ((car-cons (library-library-axiom lib "CAR-CONS" (cdr pair)))
             (equation (proof-proof-rewrite-first proof equation car-cons))
             (cdr-cons (library-library-axiom lib "CDR-CONS" (cdr pair))))
          (proof-proof-rewrite-first proof equation cdr-cons)))
    equation))

(defun t4-mvmeta-evaluate-pairs (lib equation pairs)
  (declare (xargs :measure (acl2-count pairs)))
  (if (endp pairs)
      (proof-proof-tidy (library-library-proof lib) equation)
    (proof-with-checked-results
        ((equation (t4-mvmeta-evaluate-pair lib equation (car pairs))))
      (t4-mvmeta-evaluate-pairs lib equation (cdr pairs)))))

(defun t4-mvmeta-evaluate (lib call evidence replies)
  (t4-mvmeta-with-library
      ((answer (t4-mvmeta-request :evaluate lib (list call evidence) replies) :library)
       (equation (car answer)))
    (if (not equation)
        (cons '(:failure "SearchMiss" "") lib)
      (t4-mvmeta-with-library
          ((datum (proof-term-at call 1))
           (pairs (if (proof-is-call datum *proof-cons*)
                      (proof-with-checked-results ((tail (proof-term-at datum 2)))
                        (list datum tail))
                    nil))
           (result (t4-mvmeta-evaluate-pairs lib equation pairs)))
        (cons (list result (cadr answer)) lib)))))

(defun t4-mvmeta-recursive-input (formula)
  (if (not (proof-is-call formula *library-implies*))
      nil
    (proof-with-checked-results ((goal (proof-term-at formula 2)))
      (if (not (proof-is-call goal *proof-equal*))
          nil
        (proof-with-checked-results
            ((antecedent-and-goal (proof-list-of-length (cdr formula) 2))
             (goal-parts (proof-list-of-length goal 3)))
          (let ((guard (car antecedent-and-goal))
                (evaluation (cadr goal-parts))
                (after (caddr goal-parts)))
            (if (and (proof-is-call after *t4-results-mv-nth*) (proof-compound evaluation))
                (proof-with-checked-results ((transformer (proof-term-at evaluation 1)))
                  (if (proof-is-call transformer *t4-mvmeta-transform-step*)
                      (proof-with-checked-results
                          ((evaluation (proof-list-of-length evaluation 3))
                           (transformer (proof-list-of-length transformer 4)))
                        (let* ((evaluator (car evaluation))
                               (env (caddr evaluation))
                               (n (cadr transformer))
                               (term (caddr transformer))
                               (original (cadddr transformer))
                               (before (list evaluator term env)))
                          (and (equal guard (proof-eq (list evaluator original env) after))
                               (equal after (list *t4-results-mv-nth* n before))
                               (not (or (proof-compound n) (proof-compound term)
                                        (proof-compound original)))
                               (list guard after transformer evaluator env n term original before))))
                    nil))
              nil)))))))

(defun t4-mvmeta-recursive-selected (lib value target new-index data zp made
                                        context replies evidence)
  (let ((evaluator (nth 0 context))
        (env (nth 1 context))
        (original (nth 2 context))
        (guard (nth 3 context))
        (small-n (nth 4 context))
        (small-term (nth 5 context))
        (condition (nth 6 context))
        (decrease (nth 7 context)))
    (t4-mvmeta-with-library
        ((known (t4-mvmeta-request :known lib (list (list *proof-consp* data) evidence) replies)
                :library)
         (pair (car known)))
      (if (not pair)
          (cons '(:failure "SearchMiss" "") lib)
        (t4-mvmeta-with-library
            ((branch (t4-mvmeta-index-selector-with-replies lib new-index pair zp replies)
                     :library)
             (proof (library-library-proof lib))
             (selected (proof-proof-chain proof target (list branch))))
          (cond
           ((proof-is-call value *proof-cons*)
            (t4-mvmeta-with-library ((reversed (proof-proof-symmetric proof selected)))
              (cons (proof-proof-chain proof made (list reversed)) lib)))
           ((equal value (list *t4-mvmeta-transform-step* small-n small-term original))
            (t4-mvmeta-with-library
                ((conditional (proof-proof-assume proof condition t))
                 (discharged (proof-proof-discharge proof decrease zp))
                 (smaller (proof-proof-prove-if proof conditional discharged))
                 (assumption (proof-proof-assume proof guard t))
                 (premise (proof-proof-rewrite proof assumption selected '(1 2)))
                 (used (proof-proof-modus-ponens proof smaller premise))
                 (reversed (proof-proof-symmetric proof selected)))
              (cons (proof-proof-chain proof used (list reversed)) lib)))
           (t (t4-mvmeta-with-library ((selected-value (t4-mvmeta-right selected)))
                (cons (if (equal selected-value (list evaluator value env))
                          (proof-proof-symmetric proof selected)
                        '(:failure "SearchMiss" ""))
                      lib)))))))))

(defun t4-mvmeta-recursive-transformer-branch (value tests lib context replies)
  (let ((evaluator (nth 0 context))
        (env (nth 1 context))
        (original (nth 2 context))
        (guard (nth 3 context))
        (before (nth 8 context))
        (after (nth 9 context))
        (n (nth 10 context)))
    (if (equal value original)
        (cons (proof-proof-assume (library-library-proof lib) guard t) lib)
      (t4-mvmeta-with-library
          ((evidence (t4-structural-evidence-init lib tests nil))
           (old (t4-mvmeta-evaluate lib before evidence replies) :library)
           (proof (library-library-proof lib))
           (reflexive (proof-proof-reflexive proof after))
           (target (proof-proof-rewrite proof reflexive (car old) '(1 2 2)))
           (new-index (t4-mvmeta-right target))
           (data (proof-term-at new-index 2))
           (empty (list *t4-results-zp* n))
           (found (t4-structural-evidence-find (cadr old) empty))
           (tested (if (car found) found
                     (t4-structural-evidence-require (cdr found) (proof-neg empty)))))
        (let ((zp (car tested))
              (evidence (cdr tested)))
          (if (proof-is-call value *proof-cons*)
              (t4-mvmeta-with-library
                  ((made (t4-mvmeta-evaluate lib (list evaluator value env) evidence replies)
                         :library)
                   (proof (library-library-proof lib))
                   (rhs (t4-mvmeta-right (car made)))
                   (equation (if (proof-is-call rhs *termination-return-last*)
                                 (proof-with-checked-results ((opened (proof-proof-unfold proof rhs)))
                                   (proof-proof-chain proof (car made) (list opened)))
                               (car made)))
                   (rhs (t4-mvmeta-right equation)))
                (if (equal rhs (list *t4-results-nth* n data))
                    (t4-mvmeta-with-library
                        ((equivalence (t4-mvmeta-index-equivalence-with-replies lib n data replies)
                                      :library)
                         (proof (library-library-proof lib))
                         (made (proof-proof-chain proof equation (list equivalence)))
                         (reversed (proof-proof-symmetric proof target)))
                      (cons (proof-proof-chain proof made (list reversed)) lib))
                  (t4-mvmeta-recursive-selected lib value target new-index data zp equation
                                               context replies (cadr made))))
            (t4-mvmeta-recursive-selected lib value target new-index data zp nil
                                         context replies evidence)))))))

(defun t4-mvmeta-projection-transformer-visit (value tests lib context replies)
  (let ((original (nth 0 context))
        (left (nth 1 context))
        (env (nth 2 context)))
    (cond
     ((equal value original)
      (cons (proof-proof-reflexive (library-library-proof lib) left) lib))
     ((not (proof-is-call value *t4-mvmeta-transform-step*))
      (cons '(:failure "SearchMiss" "") lib))
     (t
      (t4-mvmeta-with-library ((parts (proof-list-of-length value 4)))
        (let ((n (cadr parts))
              (term (caddr parts)))
          (if (not (equal (cadddr parts) original))
              (cons '(:failure "SearchMiss" "") lib)
            (t4-mvmeta-with-library
                ((evidence (t4-structural-evidence-init lib tests nil))
                 (first (t4-mvmeta-evaluate lib left evidence replies) :library)
                 (rhs (t4-mvmeta-right (car first)))
                 (index (proof-term-at rhs 1))
                 (computed (t4-mvmeta-evaluate lib index (cadr first) replies) :library)
                 (proof (library-library-proof lib))
                 (evaluated (proof-proof-rewrite-first proof (car first) (car computed)))
                 (bindings
                  (list (list (proof-sym "N" "ACL2") n)
                        (list (proof-sym "TERM" "ACL2") term)
                        (list *library-x* original)
                        (list (proof-sym "A" "ACL2") env)))
                 (correctness (proof-proof-fact proof *t4-mvmeta-transform-correct* bindings))
                 (result (proof-proof-modus-ponens proof correctness evaluated))
                 (reversed (proof-proof-symmetric proof result)))
              (cons (proof-proof-chain proof evaluated (list reversed)) lib)))))))))

(defun t4-mvmeta-by-value (n lib value template tests method context replies)
  (declare (xargs :measure (nfix n)))
  (cond
   ((not (o< (nfix (1- n)) (nfix n)))
    (cons '(:failure "Fuel" "t4-mvmeta-by-value") lib))
   ((proof-is-call value *proof-if*)
    (t4-mvmeta-with-library
        ((branches (proof-list-of-length (cdr value) 3))
         (test (car branches))
         (yes (t4-mvmeta-by-value (1- n) lib (cadr branches) template
                                (append tests (list (list test t))) method context replies)
              :library)
         (no (t4-mvmeta-by-value (1- n) lib (caddr branches) template
                               (append tests (list (list test nil))) method context replies)
             :library)
         (proof (library-library-proof lib))
         (if-true (proof-proof-if-true proof value))
         (true-equality (proof-proof-symmetric proof if-true))
         (yes-proof (proof-proof-rewrite-result proof yes true-equality template *proof-result*))
         (if-false (proof-proof-if-false proof value))
         (false-equality (proof-proof-symmetric proof if-false))
         (no-proof (proof-proof-rewrite-result proof no false-equality template *proof-result*)))
      (cons (proof-proof-cases proof test yes-proof no-proof) lib)))
   ((and (proof-compound value) (not (consp value)))
    (cons '(:failure "failure" "") lib))
   ((and (proof-compound value) (proof-compound (car value)))
    (t4-mvmeta-with-library
        ((equality (proof-proof-beta (library-library-proof lib) value))
         (opened (t4-mvmeta-right equality))
         (step (t4-mvmeta-by-value (1- n) lib opened template tests method context replies)
               :library)
         (proof (library-library-proof lib))
         (reversed (proof-proof-symmetric proof equality)))
      (cons (proof-proof-rewrite-result proof step reversed template *proof-result*) lib)))
   (t
    (t4-mvmeta-with-library
        ((step (if (eq method :recursive)
                   (t4-mvmeta-recursive-transformer-branch value tests lib context replies)
                 (t4-mvmeta-projection-transformer-visit value tests lib context replies))
               :library)
         (literal (proof-step-first step))
         (expected (proof-subst template (list (cons *proof-result* value)))))
      (cons (if (equal literal expected) step '(:failure "InferenceMismatch" "")) lib)))))

(defun t4-mvmeta-recursive-transformer-with-replies (lib formula replies)
  (t4-mvmeta-with-library ((input (t4-mvmeta-recursive-input formula)))
    (if (not input)
        (cons nil lib)
      (let ((guard (nth 0 input))
            (after (nth 1 input))
            (transformer (nth 2 input))
            (evaluator (nth 3 input))
            (env (nth 4 input))
            (n (nth 5 input))
            (term (nth 6 input))
            (original (nth 7 input))
            (before (nth 8 input)))
        (t4-mvmeta-with-library
            ((arithmetic (t4-mvmeta-request :arithmetic lib nil replies) :library)
             (proof (library-library-proof lib))
             (equation (proof-proof-unfold proof transformer))
             (template (proof-eq (list evaluator *proof-result* env) after))
             (small-n (library-plus *proof-neg-one* n))
             (small-term (list *library-car* (list *library-cdr* (list *library-cdr* term))))
             (bindings (list (list n small-n) (list term small-term)))
             (decrease (library-library-builtin lib 9 n))
             (decrease-term (proof-step-first decrease))
             (substitution (table-put (list (cons n small-n)) term small-term))
             (induction-term (proof-subst formula substitution))
             (condition (proof-ite decrease-term induction-term *proof-true*))
             (rhs (t4-mvmeta-right equation))
             (context (list evaluator env original guard small-n small-term condition decrease
                            before after n))
             (result (t4-mvmeta-by-value 1000000 lib rhs template nil :recursive context replies)
                     :library)
             (proof (library-library-proof lib))
             (reverse-equation (proof-proof-symmetric proof equation))
             (lifted (proof-proof-rewrite-result proof result reverse-equation template *proof-result*))
             (cases (t4-ordinals-ordinals-imply lib guard lifted))
             (ordinal (library-library-builtin lib 1 n)))
          (cons (proof-proof-induct proof ordinal cases formula (t4-structural-count n)
                                    (list bindings))
                lib))))))

(defun t4-mvmeta-recursive-transformer (lib formula)
  (t4-mvmeta-recursive-transformer-with-replies lib formula nil))

(defun t4-mvmeta-projection-input (lib formula)
  (if (not (proof-is-call formula *proof-equal*))
      nil
    (proof-with-checked-results ((sides (proof-list-of-length (cdr formula) 2)))
      (let ((left (car sides))
            (right (cadr sides)))
        (if (and (proof-compound left) (equal (len left) 3)
                 (proof-is-call right (car left)))
            (proof-with-checked-results ((argument (proof-term-at right 1)))
              (if (equal argument (list *t4-mvmeta-transform* (cadr left)))
                  (proof-with-checked-results ((env (proof-term-at right 2)))
                    (and (equal env (caddr left))
                         (assoc-equal *t4-mvmeta-transform-correct*
                                      (proof-proof-facts (library-library-proof lib)))
                         (list left argument)))
                nil))
          nil)))))

(defun t4-mvmeta-projection-transformer-with-replies (lib formula replies)
  (t4-mvmeta-with-library ((input (t4-mvmeta-projection-input lib formula)))
    (if (not input)
        (cons nil lib)
      (let* ((left (car input))
             (env (caddr left))
             (proof (library-library-proof lib)))
        (t4-mvmeta-with-library
            ((root (proof-proof-unfold proof (cadr input)))
             (template (proof-eq left (list (car left) *proof-result* env)))
             (rhs (t4-mvmeta-right root))
             (step (t4-mvmeta-by-value 1000000 lib rhs template nil :projection
                                       (list (cadr left) left env) replies)
                   :library)
             (proof (library-library-proof lib))
             (reversed (proof-proof-symmetric proof root)))
          (cons (proof-proof-rewrite-result proof step reversed template *proof-result*) lib))))))

(defun t4-mvmeta-projection-transformer (lib formula)
  (t4-mvmeta-projection-transformer-with-replies lib formula nil))
