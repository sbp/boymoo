(in-package "BOYMOO-PROVER")

(set-verify-guards-eagerness 0)

(defconst *t4-division-quotient* (proof-sym "NONNEGATIVE-INTEGER-QUOTIENT" "ACL2"))
(defconst *t4-division-floor* (proof-cl "FLOOR"))
(defconst *t4-division-numerator* (proof-cl "NUMERATOR"))
(defconst *t4-division-denominator* (proof-cl "DENOMINATOR"))
(defconst *t4-division-reciprocal* (proof-sym "UNARY-/" "ACL2"))
(defconst *t4-division-fix* (proof-sym "FIX" "ACL2"))
(defconst *t4-division-ifix* (proof-sym "IFIX" "ACL2"))
(defconst *t4-division-acl2-nfix* (proof-sym "NFIX" "ACL2"))
(defconst *t4-division-numeric-equal* (proof-cl "="))

(defun t4-division-conjunction (terms)
  (cond ((endp terms) '(:failure "failure" ""))
        ((endp (cdr terms)) (car terms))
        (t (proof-ite (car terms) (t4-division-conjunction (cdr terms))
                      *proof-false*))))

(defun t4-division-pieces-loop (n proof step)
  (declare (xargs :measure (nfix n)))
  (if (not (o< (nfix (1- n)) (nfix n)))
      '(:failure "fuel" "t4-division-pieces-loop")
    (proof-with-checked-results ((literal (proof-step-first step)))
      (if (not (proof-compound literal))
          (list step)
        (proof-with-checked-results ((head (proof-term-at literal 0)))
          (if (not (equal head *proof-if*))
              (list step)
            (proof-with-checked-results ((otherwise (proof-term-at literal 3)))
              (if (not (equal otherwise *proof-false*))
                  (list step)
                (proof-with-checked-results
                    ((parts (proof-proof-conjunct proof step))
                     (rest (t4-division-pieces-loop (1- n) proof (cadr parts))))
                  (cons (car parts) rest))))))))))

(defun t4-division-pieces (lib proof)
  (t4-division-pieces-loop 1000000 (library-library-proof lib) proof))

(defun t4-division-combine (lib proofs)
  (cond ((endp proofs) '(:failure "failure" ""))
        ((endp (cdr proofs)) (car proofs))
        (t (let ((proof (library-library-proof lib))
                 (condition (car proofs)))
             (proof-with-checked-results
                 ((result (t4-division-combine lib (cdr proofs)))
                  (first (proof-step-first condition))
                  (branch (proof-step-first result))
                  (term (proof-ite first branch *proof-false*))
                  (selection (proof-proof-select proof term condition)))
               (proof-proof-transport proof result selection))))))

(defun t4-division-times (a b)
  (list *proof-times* a b))

(defun t4-division-step-at (step index)
  (proof-with-checked-results ((literal (proof-step-first step)))
    (proof-term-at literal index)))

(defun t4-division-fact-present-p (lib name)
  (assoc-equal (proof-sym (concatenate 'string "SELF-" name) "ACL2")
               (proof-proof-facts (library-library-proof lib))))

(mutual-recursion
 (defun t4-division-type-of (lib term evidence)
   (declare (xargs :measure (acl2-count term)))
   (if (proof-is-call term *library-nfix*)
       (library-library-cite lib "NFIX-INTEGER" (cdr term) nil)
     (proof-with-checked-results
         ((known (library-type-evidence (library-integer term) evidence)))
       (cond
        (known known)
        ((or (proof-is-call term *proof-plus*) (proof-is-call term *proof-times*))
         (proof-with-checked-results ((parts (t4-division-type-arguments lib (cdr term) evidence)))
           (library-library-cite lib
                                 (if (equal (car term) *proof-plus*) "INTEGER-SUM" "INTEGER-PRODUCT")
                                 (cdr term) parts)))
        ((proof-is-call term *proof-minus*)
         (if (consp (cdr term))
             (proof-with-checked-results ((part (t4-division-type-of lib (cadr term) evidence)))
               (library-library-cite lib "INTEGER-NEGATION" (cdr term) (list part)))
           '(:failure "failure" "")))
        (t (library-library-type-of lib term evidence))))))
 (defun t4-division-type-arguments (lib terms evidence)
   (declare (xargs :measure (acl2-count terms)))
   (if (endp terms)
       nil
     (proof-with-checked-results
         ((first (t4-division-type-of lib (car terms) evidence))
          (rest (t4-division-type-arguments lib (cdr terms) evidence)))
       (cons first rest)))))

(defun t4-division-rational (lib term evidence)
  (proof-with-checked-results
      ((axiom (library-library-axiom lib "INTEGER-IMPLIES-RATIONAL" (list term)))
       (typed (t4-division-type-of lib term evidence)))
    (proof-proof-modus-ponens (library-library-proof lib) axiom typed)))

(defun t4-division-number (lib term evidence)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((fact (proof-proof-fact proof "rationalp-acl2-numberp" (list (list *library-x* term))))
         (rational (t4-division-rational lib term evidence)))
      (proof-proof-modus-ponens proof fact rational))))

(defun t4-division-comparison (lib a b integers)
  (proof-with-checked-results
      ((a-type (t4-division-type-of lib a integers))
       (b-type (t4-division-type-of lib b integers)))
    (library-library-cite lib "LESS-DIFFERENCE" (list a b) (list a-type b-type))))

(defun t4-division-less-from-difference (lib a b positive-difference integers)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((compare (t4-division-comparison lib a b integers))
         (term (t4-division-step-at positive-difference 2))
         (delta (library-library-linear-equal lib (library-diff b a) term integers))
         (compare (proof-proof-rewrite proof compare delta '(1 2 2))))
      (proof-proof-transport proof positive-difference compare))))

(defun t4-division-imply (lib antecedent consequent)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((goal (proof-step-first consequent))
         (equation (proof-proof-unfold proof (list *library-implies* antecedent goal)))
         (body (t4-division-step-at equation 2))
         (assumed (proof-proof-assume proof antecedent t))
         (outer (proof-proof-select proof body assumed))
         (inner (proof-term-at body 2))
         (inner (proof-proof-select proof inner consequent))
         (yes (proof-proof-chain proof equation (list outer inner)))
         (otherwise (proof-proof-if-false proof body))
         (no (proof-proof-chain proof equation (list otherwise)))
         (yes (proof-proof-true-from-eq proof yes))
         (no (proof-proof-true-from-eq proof no)))
      (proof-proof-cases proof antecedent yes no))))

(defun t4-division-distinct (lib strict integers)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((literal (proof-step-first strict))
         (parts (proof-list-of-length literal 3)))
      (let* ((a (cadr parts))
             (b (caddr parts))
             (equality (proof-eq a b))
             (difference (library-diff b b)))
        (proof-with-checked-results
            ((assumed (proof-proof-assume proof equality t))
             (reflexive (proof-proof-rewrite proof strict assumed '(1 1)))
             (typed (t4-division-type-of lib b integers))
             (delta (library-library-linear-equal lib difference *proof-zero* (list typed)))
             (axiom (library-library-axiom lib "<-ON-OTHERS" (list b b)))
             (zero (proof-proof-reflexive proof (library-lt difference *proof-zero*)))
             (zero (proof-proof-rewrite proof zero delta '(1 2 1)))
             (false (proof-proof-constant proof (library-lt *proof-zero* *proof-zero*)))
             (reduction (proof-proof-chain proof axiom (list zero false)))
             (result (proof-proof-rewrite proof reflexive reduction '(1)))
             (result (proof-proof-tidy proof result)))
          (proof-proof-front proof result (proof-neg equality)))))))

(defun t4-division-derive-weak-distinct (lib weak distinct ints)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((literal (proof-step-first weak))
         (parts (proof-list-of-length literal 2))
         (order (proof-list-of-length (cadr parts) 3)))
      (let* ((b (cadr order))
             (a (caddr order))
             (delta (library-diff b a))
             (delta-zero (proof-eq delta *proof-zero*))
             (sum (library-plus delta a))
             (positive (library-positive delta)))
        (proof-with-checked-results
            ((delta-int (t4-division-type-of lib delta ints))
             (reflexive (proof-proof-reflexive proof sum))
             (same-delta (proof-proof-assume proof delta-zero t))
             (exposed (proof-proof-rewrite proof reflexive same-delta '(1 2 1)))
             (linear (library-library-linear-equal lib sum b ints))
             (linear (proof-proof-symmetric proof linear))
             (a-type (proof-term-at ints 0))
             (zero-left (library-library-cite lib "ADD-ZERO-LEFT" (list a) (list a-type)))
             (same (proof-proof-chain proof linear (list exposed zero-left)))
             (equality (proof-proof-symmetric proof same))
             (unequal (proof-proof-cut proof equality distinct))
             (unequal-delta (proof-proof-front proof unequal (proof-neg delta-zero)))
             (axiom (library-library-axiom lib "<-ON-OTHERS" (list b a)))
             (nonnegative-delta (proof-proof-rewrite proof weak axiom '(1 1)))
             (delta-types (append ints (list delta-int)))
             (negativity (t4-division-comparison lib delta *proof-zero* delta-types))
             (normal (library-library-linear-equal
                      lib (library-diff *proof-zero* delta) (library-minus delta) delta-types))
             (negativity (proof-proof-rewrite proof negativity normal '(1 2 2)))
             (no-negative (proof-proof-rewrite proof nonnegative-delta negativity '(1 1)))
             (trichotomy (library-library-axiom lib "TRICHOTOMY" (list delta)))
             (three (proof-proof-conjunct proof trichotomy))
             (number (t4-division-number lib delta (list delta-int)))
             (three (proof-proof-modus-ponens proof (car three) number))
             (not-positive (proof-proof-assume proof positive nil))
             (remaining (proof-proof-simplify-first proof three (list not-positive unequal-delta) nil))
             (positive-delta (proof-proof-cut proof remaining no-negative))
             (positive-delta (proof-proof-front proof positive-delta positive))
             (comparison (t4-division-comparison lib a b ints)))
          (proof-proof-transport proof positive-delta comparison))))))

(defun t4-division-weak-distinct-lemma (lib)
  (let* ((proof (library-library-proof lib))
         (x *library-x*)
         (y *library-y*)
         (xy (library-lt y x))
         (unequal (proof-eq x y)))
    (proof-with-checked-results
        ((ints (library-library-ints lib (list x y)))
         (weak (proof-proof-assume proof xy nil))
         (distinct (proof-proof-assume proof unequal nil))
         (step (t4-division-derive-weak-distinct lib weak distinct ints))
         (x-type (proof-step-first (car ints)))
         (y-type (proof-step-first (cadr ints))))
      (library-library-lemma lib "WEAK-DISTINCT-LESS" (library-lt x y) step
                             (list (proof-neg x-type) (proof-neg y-type) xy unequal)))))

(defun t4-division-weak-distinct (lib weak distinct evidence)
  (proof-with-checked-results
      ((literal (proof-step-first weak))
       (parts (proof-list-of-length literal 2))
       (order (proof-list-of-length (cadr parts) 3))
       (lib (if (t4-division-fact-present-p lib "WEAK-DISTINCT-LESS")
                lib
              (t4-division-weak-distinct-lemma lib))))
    (let ((a (caddr order))
          (b (cadr order)))
      (proof-with-checked-results
          ((a-type (t4-division-type-of lib a evidence))
           (b-type (t4-division-type-of lib b evidence))
           (step (library-library-cite lib "WEAK-DISTINCT-LESS" (list a b)
                                       (list a-type b-type weak distinct))))
        (cons step lib)))))

(defun t4-division-one-product (lib typed)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((x (t4-division-step-at typed 1))
         (identity (library-library-axiom lib "UNICITY-OF-1" (list x)))
         (type-of-x (t4-division-number lib x (list typed)))
         (simplified (proof-proof-simplify proof (list *t4-division-fix* x)
                                           (list type-of-x) (list *t4-division-fix*))))
      (proof-proof-chain proof identity (list simplified)))))

(defun t4-division-zero-product-lemma (lib)
  (let* ((proof (library-library-proof lib))
         (x *library-x*)
         (zero (t4-division-times x *proof-zero*))
         (left (library-diff zero zero))
         (right (library-diff (library-plus zero zero) zero)))
    (proof-with-checked-results
        ((ints (library-library-ints lib (list x)))
         (expansion (library-library-axiom lib "DISTRIBUTIVITY" (list x *proof-zero* *proof-zero*)))
         (constant (proof-proof-constant proof (library-plus *proof-zero* *proof-zero*)))
         (expansion (proof-proof-rewrite proof expansion constant '(1 1 2)))
         (identity (proof-proof-reflexive proof left))
         (difference (proof-proof-rewrite proof identity expansion '(1 2 1)))
         (left-equal (library-library-linear-equal lib left *proof-zero* ints))
         (left-equal (proof-proof-symmetric proof left-equal))
         (right-equal (library-library-linear-equal lib right zero ints))
         (cancellation (proof-proof-chain proof left-equal (list difference right-equal)))
         (result (proof-proof-symmetric proof cancellation)))
      (library-library-lemma lib "INTEGER-TIMES-ZERO" (proof-eq zero *proof-zero*) result
                             (list (proof-neg (library-integer x)))))))

(defun t4-division-zero-product (lib typed)
  (proof-with-checked-results
      ((lib (if (t4-division-fact-present-p lib "INTEGER-TIMES-ZERO")
                lib
              (t4-division-zero-product-lemma lib)))
       (x (t4-division-step-at typed 1))
       (step (library-library-cite lib "INTEGER-TIMES-ZERO" (list x) (list typed))))
    (cons step lib)))

(defun t4-division-product-difference (lib d a b integers)
  (let* ((proof (library-library-proof lib))
         (delta (library-diff b a))
         (goal (library-diff (t4-division-times d b) (t4-division-times d a))))
    (proof-with-checked-results
        ((expanded (library-library-axiom lib "DISTRIBUTIVITY" (list d delta a)))
         (normal (library-library-linear-equal lib (library-plus delta a) b integers))
         (expanded (proof-proof-rewrite proof expanded normal '(1 1 2)))
         (identity (proof-proof-reflexive proof goal))
         (step (proof-proof-rewrite proof identity expanded '(1 2 1)))
         (value (t4-division-step-at step 2))
         (normal (library-library-linear-equal lib value (t4-division-times d delta) integers)))
      (proof-proof-chain proof step (list normal)))))

(defun t4-division-derive-product-order (lib d a b integers positive-d order strict)
  (let* ((proof (library-library-proof lib))
         (delta (library-diff b a))
         (product (t4-division-times d delta))
         (left (t4-division-times d a))
         (right (t4-division-times d b)))
    (proof-with-checked-results
        ((typed-delta (t4-division-type-of lib delta integers))
         (typed-d (t4-division-type-of lib d integers)))
      (if strict
          (proof-with-checked-results
              ((comparison (t4-division-comparison lib a b integers))
               (positive-delta (proof-proof-rewrite proof order comparison '(1)))
               (d-rational (t4-division-rational lib d (list typed-d)))
               (delta-rational (t4-division-rational lib delta (list typed-delta)))
               (positive-product (library-library-cite
                                  lib "POSITIVE-PRODUCT" (list d delta)
                                  (list d-rational delta-rational positive-d positive-delta)))
               (difference (t4-division-product-difference lib d a b integers))
               (difference (proof-proof-symmetric proof difference))
               (bound (proof-proof-rewrite proof positive-product difference '(1 2)))
               (result (t4-division-less-from-difference lib left right bound integers)))
            (cons result lib))
        (proof-with-checked-results
            ((axiom (library-library-axiom lib "<-ON-OTHERS" (list b a)))
             (nonnegative-delta (proof-proof-rewrite proof order axiom '(1 1)))
             (test (proof-eq *proof-zero* delta))
             (assumed (proof-proof-assume proof test t))
             (zero (proof-proof-symmetric proof assumed))
             (identity (proof-proof-reflexive proof product))
             (equality (proof-proof-rewrite proof identity zero '(1 2 2)))
             (product-zero (t4-division-zero-product lib typed-d))
             (lib (cdr product-zero))
             (proof (library-library-proof lib))
             (equality (proof-proof-chain proof equality (list (car product-zero))))
             (zero (library-library-axiom lib "ZERO" nil))
             (equality (proof-proof-symmetric proof equality))
             (zero-branch (proof-proof-rewrite proof zero equality '(1 1 1)))
             (assumed (proof-proof-assume proof test nil))
             (positive-delta (t4-division-weak-distinct lib nonnegative-delta assumed (list typed-delta)))
             (lib (cdr positive-delta))
             (proof (library-library-proof lib))
             (d-rational (t4-division-rational lib d (list typed-d)))
             (delta-rational (t4-division-rational lib delta (list typed-delta)))
             (positive-product (library-library-cite
                                lib "POSITIVE-PRODUCT" (list d delta)
                                (list d-rational delta-rational positive-d (car positive-delta))))
             (product-type (t4-division-type-of lib product integers))
             (positive-branch (library-library-cite lib "POSITIVE-NONNEGATIVE" (list product)
                                                    (list product-type positive-product)))
             (bound (proof-proof-cases proof test zero-branch positive-branch))
             (difference (t4-division-product-difference lib d a b integers))
             (difference (proof-proof-symmetric proof difference))
             (bound (proof-proof-rewrite proof bound difference '(1 1 1)))
             (result (library-library-weak-from-difference lib left right bound integers)))
          (cons result lib))))))

(defun t4-division-product-order-lemma (lib name strict)
  (let* ((proof (library-library-proof lib))
         (x *library-x*)
         (y *library-y*)
         (z *library-z*)
         (test (if strict (library-lt y z) (library-lt z y)))
         (left (t4-division-times x y))
         (right (t4-division-times x z)))
    (proof-with-checked-results
        ((types (library-library-ints lib (list x y z)))
         (positive-x (proof-proof-assume proof (library-positive x) t))
         (premise (proof-proof-assume proof test strict))
         (derived (t4-division-derive-product-order lib x y z types positive-x premise strict))
         (x-type (proof-step-first (car types)))
         (y-type (proof-step-first (cadr types)))
         (z-type (proof-step-first (caddr types))))
      (library-library-lemma
       (cdr derived) name (if strict (library-lt left right) (library-le left right))
       (car derived)
       (list (proof-neg x-type) (proof-neg y-type) (proof-neg z-type)
             (proof-neg (library-positive x)) (if strict (proof-neg test) test))))))

(defun t4-division-product-order (lib d a b integers positive-d order strict)
  (let ((name (if strict "INTEGER-PRODUCT-LESS" "INTEGER-PRODUCT-WEAK")))
    (proof-with-checked-results
        ((lib (if (t4-division-fact-present-p lib name)
                  lib
                (t4-division-product-order-lemma lib name strict)))
         (typed (t4-division-type-arguments lib (list d a b) integers))
         (step (library-library-cite lib name (list d a b)
                                     (append typed (list positive-d order)))))
      (cons step lib))))

(defun t4-division-cancel-product-order (lib d a b ints positive-d strict)
  (let ((target (library-lt a b)))
    (proof-with-checked-results
        ((assumed (proof-proof-assume (library-library-proof lib) target nil))
         (opposite (t4-division-product-order lib d b a ints positive-d assumed nil))
         (lib (cdr opposite))
         (proof (library-library-proof lib))
         (cut (proof-proof-cut proof strict (car opposite)))
         (step (proof-proof-front proof cut target)))
      (cons step lib))))

(defun t4-division-positive-nonzero (lib typed holds)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((x (t4-division-step-at typed 1))
         (equal (proof-eq x *proof-zero*))
         (distinct (t4-division-distinct lib holds (list typed)))
         (assumed (proof-proof-assume proof equal t))
         (assumed (proof-proof-symmetric proof assumed))
         (step (proof-proof-cut proof assumed distinct)))
      (proof-proof-front proof step (proof-neg equal)))))

(defun t4-division-inverse-product (lib typed-factor typed-value positive-factor)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((factor (t4-division-step-at typed-factor 1))
         (value (t4-division-step-at typed-value 1))
         (reciprocal (list *t4-division-reciprocal* factor))
         (shape (library-library-axiom lib "ASSOCIATIVITY-OF-*" (list factor reciprocal value)))
         (shape (proof-proof-symmetric proof shape))
         (number (t4-division-number lib factor (list typed-factor)))
         (neq (t4-division-positive-nonzero lib typed-factor positive-factor))
         (guard (t4-division-combine lib (list number neq)))
         (inv-axiom (library-library-axiom lib "INVERSE-OF-*" (list factor)))
         (inverse (proof-proof-modus-ponens proof inv-axiom guard))
         (step (proof-proof-rewrite proof shape inverse '(1 2 1)))
         (one (t4-division-one-product lib typed-value)))
      (proof-proof-chain proof step (list one)))))

(defun t4-division-quotient-assumptions (n divisor)
  (t4-division-conjunction
   (list (library-integer n) (library-integer divisor)
         (library-nonnegative n) (library-positive divisor))))

(defun t4-division-quotient-property (n divisor value)
  (t4-division-conjunction
   (list (library-integer value) (library-nonnegative value)
         (library-le (t4-division-times divisor value) n))))

(defun t4-division-quotient-base (lib i-d nonnegative-n body view template)
  (proof-with-checked-results
      ((zero (t4-division-zero-product lib i-d))
       (lib (cdr zero))
       (proof (library-library-proof lib))
       (symmetric (proof-proof-symmetric proof (car zero)))
       (zero-branch (proof-proof-rewrite proof nonnegative-n symmetric '(1 1 2)))
       (zero-type (t4-division-type-of lib *proof-zero* nil))
       (zero-axiom (library-library-axiom lib "ZERO" nil))
       (base (t4-division-combine lib (list zero-type zero-axiom zero-branch)))
       (selected (proof-proof-if-true proof body))
       (selected (proof-proof-chain proof view (list selected)))
       (selected (proof-proof-symmetric proof selected))
       (step (proof-proof-rewrite-result proof base selected template *proof-result*)))
    (cons step lib)))

(defun t4-division-quotient-recursive
    (lib n divisor smaller qsmaller claim i-n i-d positive-d body view template)
  (let* ((proof (library-library-proof lib))
         (integers (list i-n i-d))
         (less-d (library-lt n divisor))
         (next-value (library-plus *proof-one* qsmaller))
         (old-product (t4-division-times divisor qsmaller)))
    (proof-with-checked-results
        ((at-least (proof-proof-assume proof less-d nil))
         (order (library-library-axiom lib "<-ON-OTHERS" (list n divisor)))
         (nonnegative-smaller (proof-proof-rewrite proof at-least order '(1 1)))
         (i-smaller (t4-division-type-of lib smaller integers))
         (i-zero (t4-division-type-of lib *proof-zero* nil))
         (positive-n (library-library-cite lib "LESS-THEN-WEAK" (list *proof-zero* divisor n)
                                          (list i-zero i-d i-n positive-d at-least)))
         (delta (library-library-linear-equal lib (library-diff n smaller) divisor integers))
         (delta (proof-proof-symmetric proof delta))
         (delta-positive (proof-proof-rewrite proof positive-d delta '(1 2)))
         (step-less (t4-division-less-from-difference lib smaller n delta-positive integers))
         (decreases (library-library-cite lib "NFIX-DECREASE" (list smaller n)
                                         (list i-smaller i-n positive-n step-less)))
         (condition (proof-step-first decreases))
         (substituted (proof-subst claim (list (cons n smaller))))
         (hypothesis (proof-proof-assume proof (proof-ite condition substituted *proof-true*) t))
         (ih (proof-proof-prove-if proof hypothesis decreases))
         (smaller-guard (t4-division-combine lib (list i-smaller i-d nonnegative-smaller positive-d)))
         (ih (proof-proof-modus-ponens proof ih smaller-guard))
         (bounds (t4-division-pieces lib ih))
         (bounds (proof-list-of-length bounds 3))
         (qtype (car bounds))
         (qnonnegative (cadr bounds))
         (qbound (caddr bounds))
         (types (append integers (list qtype)))
         (next-type (t4-division-type-of lib next-value types))
         (positive-next (library-library-cite lib "POSITIVE-ONE-PLUS" (list qsmaller)
                                             (list qtype qnonnegative)))
         (next-nonnegative (library-library-cite lib "POSITIVE-NONNEGATIVE" (list next-value)
                                                (list next-type positive-next)))
