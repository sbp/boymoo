(defun t4-division-floor-open (n proof opened)
  (declare (xargs :measure (nfix n)))
  (if (not (o< (nfix (1- n)) (nfix n)))
      '(:failure "fuel" "t4-division-floor-open")
    (proof-with-checked-results
        ((source (t4-division-step-at opened 2))
