(in-package "BOYMOO-PROVER")
(set-verify-guards-eagerness 0)

(defconst *t4-record-laws-bad-field* (proof-sym "BAD-FIELD" "ACL2"))

(defmacro t4-record-laws-inherited (method records &rest args)
  `(library-inherited ,method (t4-records-records-lib ,records) ,@args))

(defmacro t4-record-laws-with (bindings body)
  `(t4-constructors-with ,bindings ,body (t4-records-records-lib records)))

(defun t4-record-laws-from-assoc (lib equation)
  (proof-with-checked-results
      ((left (t4-constructors-first equation 1))
       (value (list *library-cdr* left))
       (reflexive (library-inherited proof-proof-reflexive lib value))
       (step (library-inherited proof-proof-rewrite lib reflexive equation '(1 2 1)))
       (right (t4-constructors-first equation 2)))
    (if (equal right *proof-false*)
        (proof-with-checked-results
            ((computed (library-inherited proof-proof-compute lib
                                           (list *library-cdr* *proof-false*) *proof-nil*)))
          (library-inherited proof-proof-chain lib step (list computed)))
      step)))

(defun t4-record-laws-through-reads (lib agreement left right)
  (proof-with-checked-results
      ((first (library-inherited proof-proof-rewrite lib agreement left '(1 1)))
       (second (library-inherited proof-proof-rewrite lib first right '(1 2))))
    (library-inherited proof-proof-tidy lib second)))

(defun t4-record-laws-pair-equality (lib left right heads tails)
  (proof-with-checked-results
      ((a (t4-constructors-first left 1))
       (b (t4-constructors-first right 1))
       (decompose-a (library-library-axiom lib "CAR-CDR-ELIM" (list a)))
       (to-a (library-inherited proof-proof-modus-ponens lib decompose-a left))
       (from-a (library-inherited proof-proof-symmetric lib to-a))
       (decompose-b (library-library-axiom lib "CAR-CDR-ELIM" (list b)))
       (to-b (library-inherited proof-proof-modus-ponens lib decompose-b right))
       (proof (library-inherited proof-proof-rewrite lib from-a heads '(1 2 1)))
       (proof (library-inherited proof-proof-rewrite lib proof tails '(1 2 2))))
    (library-inherited proof-proof-chain lib proof (list to-b))))

(defun t4-record-laws-derive-extensionality-at-head (key record shape found records)
  (t4-record-laws-with
      (((unfolded records)
        (t4-records-records-unfold-side records (list *t4-records-assoc* key record) shape t))
       (selected (t4-records-records-choose records unfolded found))
       (step (t4-record-laws-from-assoc (t4-records-records-lib records) selected)))
    (cons step records)))

(defun t4-record-laws-derive-extensionality-atomic (key record shape records)
  (t4-record-laws-with
      (((unfolded records)
        (t4-records-records-unfold-side records (list *t4-records-assoc* key record) shape nil))
       (step (t4-record-laws-from-assoc (t4-records-records-lib records) unfolded)))
    (cons step records)))

(defun t4-record-laws-derive-extensionality-from-read (view a b lib agreement)
  (proof-with-checked-results
      ((agreement (library-inherited proof-proof-rewrite-first lib agreement view)))
    (t4-record-laws-through-reads lib agreement a b)))

(defun t4-record-laws-derive-extensionality-impossible (contradiction lib equality)
  (library-inherited proof-proof-subsume lib contradiction
                     (cons equality (proof-step-clause contradiction))))

(defun t4-record-laws-derive-extensionality-different-values
    (view a b nonzero left-value lib agreement equality)
  (proof-with-checked-results
      ((values-step (t4-record-laws-derive-extensionality-from-read view a b lib agreement))
       (values-step (if left-value values-step
                      (library-inherited proof-proof-symmetric lib values-step)))
       (contradiction (library-inherited proof-proof-rewrite lib nonzero values-step '(1)))
       (contradiction (library-inherited proof-proof-tidy lib contradiction)))
    (t4-record-laws-derive-extensionality-impossible contradiction lib equality)))

(defun t4-record-laws-derive-extensionality (records)
  (t4-record-laws-with
      ((bad-field (list *t4-record-laws-bad-field* *library-x* *library-y*))
       (equality (proof-eq *library-x* *library-y*))
       (agree (proof-eq (t4-records-field bad-field *library-x*)
                        (t4-records-field bad-field *library-y*)))
       (antecedent (proof-ite (list *t4-records-record* *library-x*)
                              (proof-ite (list *t4-records-record* *library-y*) agree *proof-false*)
                              *proof-false*))
       (formula (list *library-implies* antecedent equality))
       (given (t4-record-laws-inherited proof-proof-assume records antecedent t))
       (typed (t4-record-laws-inherited proof-proof-conjunct records given))
       (typed-x (car typed))
       (rest (cadr typed))
       (typed (t4-record-laws-inherited proof-proof-conjunct records rest))
       (typed-y (car typed))
       (agreement (cadr typed))
       (x-shape (list *proof-consp* *library-x*))
       (y-shape (list *proof-consp* *library-y*))
       (x-cons (t4-record-laws-inherited proof-proof-assume records x-shape t))
       (x-atom (t4-record-laws-inherited proof-proof-assume records x-shape nil))
       (y-cons (t4-record-laws-inherited proof-proof-assume records y-shape t))
       (y-atom (t4-record-laws-inherited proof-proof-assume records y-shape nil))
       (kx (t4-records-first-key *library-x*))
       (ky (t4-records-first-key *library-y*))
       (tx (list *library-cdr* *library-x*))
       (ty (list *library-cdr* *library-y*))
       ((parts-x records) (t4-records-records-components records typed-x x-cons))
       ((parts-y records) (t4-records-records-components records typed-y y-cons))
       (hx (car parts-x))
       (vx (cadr parts-x))
       (rx (caddr parts-x))
       (ox (cadddr parts-x))
       (hy (car parts-y))
       (vy (cadr parts-y))
       (ry (caddr parts-y))
       (oy (cadddr parts-y))
       ((empty-x records) (t4-records-records-unfold-side records bad-field x-atom nil))
       ((empty-y records) (t4-records-records-unfold-side records bad-field x-cons t))
       ((empty-y-test records)
        (t4-records-prove records (list *t4-records-endp* *library-y*) (list y-atom)
                          (list *t4-records-endp* *t4-records-atom* *proof-not*)))
       (empty-y (t4-records-records-choose records empty-y empty-y-test))
       ((nil-x records) (t4-records-records-record-atom records typed-x x-atom))
       ((nil-y records) (t4-records-records-record-atom records typed-y y-atom))
       (nil-y-back (t4-record-laws-inherited proof-proof-symmetric records nil-y))
       (both-empty (t4-record-laws-inherited proof-proof-chain records nil-x (list nil-y-back)))
       ((atomic-x records) (t4-record-laws-derive-extensionality-atomic ky *library-x* x-atom records))
       (refl-y (t4-record-laws-inherited proof-proof-reflexive records ky))
       ((read-y records) (t4-record-laws-derive-extensionality-at-head ky *library-y* y-cons refl-y records))
       (only-y (t4-record-laws-derive-extensionality-different-values
                empty-x atomic-x read-y vy nil (t4-records-records-lib records) agreement equality))
       (refl-x (t4-record-laws-inherited proof-proof-reflexive records kx))
       ((read-x records) (t4-record-laws-derive-extensionality-at-head kx *library-x* x-cons refl-x records))
       ((atomic-y records) (t4-record-laws-derive-extensionality-atomic kx *library-y* y-atom records))
       (only-x (t4-record-laws-derive-extensionality-different-values
                empty-y read-x atomic-y vx t (t4-records-records-lib records) agreement equality))
       (head-test (proof-eq (list *library-car* *library-x*) (list *library-car* *library-y*)))
       ((nonempty records) (t4-records-records-unfold-side records bad-field x-cons t))
       ((nonempty-test records)
        (t4-records-prove records (proof-neg (list *t4-records-endp* *library-y*)) (list y-cons)
                          (list *t4-records-endp* *t4-records-atom* *proof-not*)))
       (nonempty (t4-records-records-choose records nonempty nonempty-test))
       (same (t4-record-laws-inherited proof-proof-assume records head-test t))
       (descend (t4-records-records-choose records nonempty same))
       (lookup (t4-constructors-first descend 2))
       (seek (proof-eq lookup kx))
       (match-step (t4-record-laws-inherited proof-proof-assume records seek t))
       (refl (t4-record-laws-inherited proof-proof-reflexive records kx))
       (key-same (t4-record-laws-inherited proof-proof-rewrite records refl same '(1 2 1)))
       (back (t4-record-laws-inherited proof-proof-symmetric records match-step))
       (head-x (t4-record-laws-inherited proof-proof-rewrite records ox back '(1 3 1)))
       (chain (t4-record-laws-inherited proof-proof-chain records match-step (list key-same)))
       (back (t4-record-laws-inherited proof-proof-symmetric records chain))
       (head-y (t4-record-laws-inherited proof-proof-rewrite records oy back '(1 3 1)))
       ((absent-x records) (t4-records-records-missing-below records lookup tx rx head-x))
       (absent-x (t4-record-laws-from-assoc (t4-records-records-lib records) absent-x))
       ((absent-y records) (t4-records-records-missing-below records lookup ty ry head-y))
       (absent-y (t4-record-laws-from-assoc (t4-records-records-lib records) absent-y))
       (back (t4-record-laws-inherited proof-proof-symmetric records absent-y))
       (both-miss (t4-record-laws-inherited proof-proof-chain records absent-x (list back)))
       (missed-x (t4-record-laws-inherited proof-proof-assume records seek nil))
       (missed-y (t4-record-laws-inherited proof-proof-rewrite records missed-x key-same '(1 1 2)))
       ((skip-x records)
        (t4-record-laws-derive-extensionality-at-head lookup *library-x* x-cons missed-x records))
       ((skip-y records)
        (t4-record-laws-derive-extensionality-at-head lookup *library-y* y-cons missed-y records))
       (tail-reads (t4-record-laws-derive-extensionality-from-read
                    descend skip-x skip-y (t4-records-records-lib records) agreement))
       (tail-agreement (t4-record-laws-inherited proof-proof-cases records seek both-miss tail-reads))
       (bindings (list (list *library-x* tx) (list *library-y* ty)))
       (decrease (library-library-builtin (t4-records-records-lib records) 3 *library-x*))
       (decrease-test (proof-step-first decrease))
       (recursive (proof-subst formula (list (cons *library-x* tx) (cons *library-y* ty))))
       (condition (proof-ite decrease-test recursive *proof-true*))
       (inductive (t4-record-laws-inherited proof-proof-assume records condition t))
       (smaller (t4-record-laws-inherited proof-proof-discharge records decrease x-cons))
       (hypothesis (t4-record-laws-inherited proof-proof-prove-if records inductive smaller))
       (premises (t4-division-combine (t4-records-records-lib records) (list rx ry tail-agreement)))
       (tails (t4-record-laws-inherited proof-proof-modus-ponens records hypothesis premises))
       (equal-heads (t4-record-laws-pair-equality
                     (t4-records-records-lib records) x-cons y-cons same tails))
       (diff-step (t4-record-laws-inherited proof-proof-assume records head-test nil))
       (different (t4-records-records-choose records nonempty diff-step))
       (key-order (list *t4-records-before* kx ky))
       (before (t4-record-laws-inherited proof-proof-assume records key-order t))
       (after (t4-record-laws-inherited proof-proof-assume records key-order nil))
       (refl-x (t4-record-laws-inherited proof-proof-reflexive records kx))
       ((x-hit records) (t4-record-laws-derive-extensionality-at-head kx *library-x* x-cons refl-x records))
       (refl-y (t4-record-laws-inherited proof-proof-reflexive records ky))
       ((y-hit records) (t4-record-laws-derive-extensionality-at-head ky *library-y* y-cons refl-y records))
       (bound (t4-records-records-weaken-order records before *library-y*))
       ((y-miss records) (t4-records-records-missing-below records kx *library-y* typed-y bound))
       (y-miss (t4-record-laws-from-assoc (t4-records-records-lib records) y-miss))
       (view (t4-records-records-choose records different before))
       (earlier (t4-record-laws-derive-extensionality-different-values
                 view x-hit y-miss vx t (t4-records-records-lib records) agreement equality))
       (same-key (proof-eq kx ky))
       (key-matched (t4-record-laws-inherited proof-proof-assume records same-key t))
       (key-distinct (t4-record-laws-inherited proof-proof-assume records same-key nil))
       (other (t4-records-records-choose records different after))
       (other-order (t4-records-records-reverse-order records after key-distinct))
       (bound (t4-records-records-weaken-order records other-order *library-x*))
       ((x-miss records) (t4-records-records-missing-below records ky *library-x* typed-x bound))
       (x-miss (t4-record-laws-from-assoc (t4-records-records-lib records) x-miss))
       (later (t4-record-laws-derive-extensionality-different-values
               other x-miss y-hit vy nil (t4-records-records-lib records) agreement equality))
       (matched-back (t4-record-laws-inherited proof-proof-symmetric records key-matched))
       ((matched-x records)
        (t4-record-laws-derive-extensionality-at-head ky *library-x* x-cons matched-back records))
       (same-value (t4-record-laws-derive-extensionality-from-read
                    other matched-x y-hit (t4-records-records-lib records) agreement))
       (same-pair (t4-record-laws-pair-equality (t4-records-records-lib records)
                                              hx hy key-matched same-value))
       (contradiction (t4-record-laws-inherited proof-proof-cut records same-pair diff-step))
       (no-difference (t4-record-laws-derive-extensionality-impossible
                       contradiction (t4-records-records-lib records) equality))
       (same-key-cases (t4-record-laws-inherited proof-proof-cases records same-key no-difference later))
       (unequal-heads (t4-record-laws-inherited proof-proof-cases records key-order earlier same-key-cases))
       (both (t4-record-laws-inherited proof-proof-cases records head-test equal-heads unequal-heads))
       (yes-y (t4-record-laws-inherited proof-proof-cases records y-shape both only-x))
       (no-y (t4-record-laws-inherited proof-proof-cases records y-shape only-y both-empty))
       (cases (t4-record-laws-inherited proof-proof-cases records x-shape yes-y no-y))
       (ordinal (library-library-builtin (t4-records-records-lib records) 1 *library-x*))
       (under (t4-ordinals-ordinals-imply (t4-records-records-lib records) antecedent cases))
       (step (t4-record-laws-inherited proof-proof-induct records ordinal under formula
                                      (t4-structural-count *library-x*) (list bindings)))
       (lib (library-library-lemma (t4-records-records-lib records)
                                   "RECORD-EQUAL-AT-BAD-FIELD" formula step nil)))
    (t4-records-records-init lib)))

(defun t4-record-laws-extensional (records left right valid-left valid-right agreement)
  (let ((name "RECORD-EQUAL-AT-BAD-FIELD"))
    (t4-record-laws-with
        ((records (if (t4-records-records-has records name)
                      records
                    (t4-record-laws-derive-extensionality records)))
         (fact (t4-records-records-use records name (list left right) nil))
         (together (t4-division-combine (t4-records-records-lib records)
                                       (list valid-left valid-right agreement)))
         (step (t4-record-laws-inherited proof-proof-modus-ponens records fact together)))
      (cons step records))))

(defun t4-record-laws-record-sufficiency-read (records key obj valid)
  (t4-record-laws-with
      (((view records) (t4-records-records-get-view records key obj))
       ((decoders records) (t4-records-records-decoders records obj valid nil))
       (field-view (t4-records-records-field-view records key (car decoders)))
       (step (t4-record-laws-inherited proof-proof-chain records view (list field-view))))
    (cons step records)))

(defun t4-record-laws-record-sufficiency-cases
    (records left right valid-left valid-right actual same same-read replies)
  (let ((lib (t4-records-records-lib records)))
    (t4-constructors-with-library
        ((same-proof (library-inherited proof-proof-assume lib same t))
         ((yes lib replies) (t4-constructors-query :boolean-true (list same-proof) lib replies))
         ((same-truth lib replies) (t4-constructors-query :boolean-true (list same-read) lib replies))
         (back (library-inherited proof-proof-symmetric lib same-truth))
         (yes (library-inherited proof-proof-chain lib yes (list back)))
         (different (library-inherited proof-proof-assume lib same nil))
         (agree (library-inherited proof-proof-assume lib actual t))
         (records (t4-records-records-init lib)))
      (t4-record-laws-with
          (((consequence records) (t4-record-laws-extensional records left right valid-left valid-right agree))
           (conflict (t4-record-laws-inherited proof-proof-cut records consequence different))
           (distinguish (t4-record-laws-inherited proof-proof-front records conflict (proof-neg actual)))
           (first-nil (t4-records-records-nil-from-denial records different))
           (second-nil (t4-records-records-nil-from-denial records distinguish))
           (back (t4-record-laws-inherited proof-proof-symmetric records second-nil))
           (no (t4-record-laws-inherited proof-proof-chain records first-nil (list back)))
           (step (t4-record-laws-inherited proof-proof-cases records same yes no)))
        (cons step records)))))

(defun t4-record-laws-record-sufficiency-proof (records premise result left right replies)
  (t4-record-laws-with
      ((assume (t4-record-laws-inherited proof-proof-assume records premise t))
       (valid (t4-record-laws-inherited proof-proof-conjunct records assume))
       (valid-left (car valid))
       (valid-right (cadr valid))
       (key (list *t4-record-laws-bad-field* left right))
       (original (t4-record-laws-inherited proof-proof-beta records (caddr result)))
       ((first records) (t4-record-laws-record-sufficiency-read records key left valid-left))
       ((second records) (t4-record-laws-record-sufficiency-read records key right valid-right))
       (normalized (t4-record-laws-inherited proof-proof-rewrite records original first '(1 2 1)))
       (normalized (t4-record-laws-inherited proof-proof-rewrite records normalized second '(1 2 2)))
       (actual (t4-constructors-first normalized 2))
       (same (cadr result))
       (reads (proof-list-of-length (cdr actual) 2))
       (left-read (car reads))
       (right-read (cadr reads))
       (refl (t4-record-laws-inherited proof-proof-reflexive records left-read))
       (same-proof (t4-record-laws-inherited proof-proof-assume records same t))
       (same-read (t4-record-laws-inherited proof-proof-rewrite records refl same-proof '(1 2 1 2)))
       (same-literal (proof-step-first same-read)))
    (if (not (and (equal same-literal actual)
                  (equal right-read (t4-records-field key right))))
        '(:failure "InferenceMismatch" "")
      (t4-record-laws-with
          (((both records)
            (t4-record-laws-record-sufficiency-cases
             records left right valid-left valid-right actual same same-read replies))
           (lib (t4-records-records-lib records))
           (back (library-inherited proof-proof-symmetric lib normalized))
           (proof (library-inherited proof-proof-rewrite lib both back '(1 2)))
           (step (t4-ordinals-ordinals-imply lib premise proof)))
        (cons step lib)))))

(defun t4-record-laws-record-sufficiency-attempt (lib formula replies)
  (if (not (proof-is-call formula *library-implies*))
      (cons nil lib)
    (t4-constructors-with-library ((result (t4-constructors-at formula 2)))
      (if (not (proof-is-call result *proof-equal*))
          (cons nil lib)
        (t4-constructors-with-library ((same (t4-constructors-at result 1)))
          (if (not (proof-is-call same *proof-equal*))
              (cons nil lib)
            (t4-constructors-with-library
                ((parts (proof-list-of-length (cdr formula) 2))
                 (sides (proof-list-of-length same 3))
                 (premise (car parts))
                 (left (cadr sides))
                 (right (caddr sides)))
              (if (not (equal premise (proof-ite (list *t4-records-record* left)
                                                  (list *t4-records-record* right) *proof-false*)))
                  (cons nil lib)
                (t4-constructors-with-library
                    ((application (t4-constructors-at result 2))
                     (lambda-head (and (proof-compound application)
                                       (t4-constructors-at application 0))))
                  (if (and (proof-compound application) (proof-compound lambda-head))
                      (t4-constructors-with-library
                          (((ignored lib replies) (t4-constructors-query :use-arithmetic nil lib replies)))
                        (t4-record-laws-record-sufficiency-proof
                         (t4-records-records-init lib) premise result left right replies))
                    (cons nil lib)))))))))))

(defun t4-record-laws-record-update-law-initial (n term)
  (declare (xargs :measure (nfix n)))
  (cond
   ((not (acl2::o< (nfix (1- n)) (nfix n))) '(:failure "Fuel" "t4-record-laws-record-update-law-initial"))
   ((not (proof-is-call term *t4-records-set*)) term)
   (t (t4-constructors-with ((record (t4-constructors-at term 3)))
        (t4-record-laws-record-update-law-initial (1- n) record)))))

(defun t4-record-laws-record-update-law-arguments (term)
  (if (integerp term)
      '(:failure "failure" "")
    (proof-list-of-length (cdr term) 3)))

(defun t4-record-laws-record-update-law-writes (n term records obj base backing typed-base backing-allowed)
  (declare (xargs :measure (nfix n)))
  (cond
   ((not (acl2::o< (nfix (1- n)) (nfix n))) '(:failure "Fuel" "t4-record-laws-record-update-law-writes"))
   ((equal term obj)
    (t4-record-laws-with
        (((reconstructed records) (t4-records-records-reconstruct records obj))
         (step (t4-record-laws-inherited proof-proof-symmetric records reconstructed)))
      (cons (list step base typed-base) records)))
   (t
    (t4-record-laws-with
        ((parts (t4-record-laws-record-update-law-arguments term))
         (key (car parts))
         (value (cadr parts))
         (before (caddr parts))
         ((prior records) (t4-record-laws-record-update-law-writes
                           (1- n) before records obj base backing typed-base backing-allowed))
         (earlier (car prior))
         (fields (cadr prior))
         (typed (caddr prior))
         ((types records) (t4-records-records-packed-types records fields backing typed backing-allowed))
         (changes (list (list 1 earlier)))
         (field-view (t4-records-records-change-args records (list *t4-records-fields* before) changes))
         (f (t4-record-laws-inherited proof-proof-chain records field-view (list (car types))))
         (backing-view (t4-records-records-change-args records (list *t4-records-backing* before) changes))
         (b (t4-record-laws-inherited proof-proof-chain records backing-view (list (cadr types))))
         ((viewed records) (t4-records-records-set-view records key value before))
         (reduced (t4-record-laws-inherited proof-proof-rewrite records viewed f '(1 2 1 3)))
         (reduced (t4-record-laws-inherited proof-proof-rewrite records reduced b '(1 2 2)))
         (step (t4-record-laws-inherited proof-proof-tidy records reduced))
         (updated (list *t4-records-update* key value fields))
         ((typed records) (t4-records-records-typed-update records key value fields typed)))
      (cons (list step updated typed) records)))))

(defun t4-record-laws-record-update-law-read-term (n term records base query typed-base)
  (declare (xargs :measure (nfix n)))
  (cond
   ((not (acl2::o< (nfix (1- n)) (nfix n))) '(:failure "Fuel" "t4-record-laws-record-update-law-read-term"))
   ((equal term base)
    (t4-record-laws-with
        ((step (t4-record-laws-inherited proof-proof-reflexive records (t4-records-field query base))))
      (cons (list step typed-base) records)))
   (t
    (t4-record-laws-with
        ((parts (t4-record-laws-record-update-law-arguments term))
         (key (car parts))
         (value (cadr parts))
         (before (caddr parts))
         ((prior records) (t4-record-laws-record-update-law-read-term (1- n) before records base query typed-base))
         (earlier (car prior))
         (old-type (cadr prior))
         ((viewed records) (t4-records-records-update-view records query key value before old-type))
         (reduced (t4-record-laws-inherited proof-proof-rewrite records viewed earlier '(1 2 3)))
         (step (t4-record-laws-inherited proof-proof-tidy records reduced))
         ((typed records) (t4-records-records-typed-update records key value before old-type)))
      (cons (list step typed) records)))))

(defun t4-record-laws-record-update-law-find-key (view conditions records value query)
  (declare (xargs :measure (acl2-count conditions)))
  (if (endp conditions)
      view
    (t4-constructors-with ((condition (cdar conditions))
                           (literal (proof-step-first condition))
                           (matches
                            (and (proof-is-call literal *proof-equal*)
                                 (t4-constructors-with ((key (t4-constructors-at value 1 1)))
                                   (equal (cdr literal) (list query key))))))
      (if matches
          (t4-constructors-with ((back (t4-record-laws-inherited proof-proof-symmetric records condition)))
            (t4-record-laws-inherited proof-proof-rewrite records view back '(1 2 1 1)))
        (t4-record-laws-record-update-law-find-key view (cdr conditions) records value query)))))

(defun t4-record-laws-record-update-law-open-get (view value records obj)
  (if (not (proof-is-call value *t4-records-get*))
      (cons view records)
    (t4-record-laws-with ((argument (t4-constructors-at value 2)))
      (if (not (equal argument obj))
          (cons view records)
        (t4-record-laws-with
            ((key (t4-constructors-at value 1))
             ((opening records) (t4-records-records-get-view records key obj))
             (step (t4-record-laws-inherited proof-proof-chain records view (list opening))))
          (cons step records))))))

(defun t4-record-laws-record-update-law-at-key (view assumed records obj query)
  (t4-record-laws-with
      ((value (t4-constructors-first view 2))
       ((view records) (t4-record-laws-record-update-law-open-get view value records obj))
       (value (t4-constructors-first view 2))
       (lookup (and (proof-is-call value *library-cdr*) (t4-constructors-at value 1)))
       (step (if (proof-is-call lookup *t4-records-assoc*)
                 (t4-record-laws-record-update-law-find-key view assumed records value query)
               view)))
    (cons step records)))

(defun t4-record-laws-record-update-law-opposite (a b assumed records query guard)
  (t4-constructors-with
      ((test (and (proof-is-call guard *proof-not*) (t4-constructors-at guard 1))))
    (if (not (proof-is-call test *proof-equal*))
        '(:failure "SearchMiss" "")
      (t4-constructors-with
          ((keys (proof-list-of-length (cdr test) 2))
           (ma (table-get assumed (proof-eq query (car keys)) nil))
           (mb (table-get assumed (proof-eq query (cadr keys)) nil))
           (ma-first (and ma mb (proof-step-first ma)))
           (mb-first (and (proof-is-call ma-first *proof-equal*) (proof-step-first mb))))
        (if (not (proof-is-call mb-first *proof-equal*))
            '(:failure "SearchMiss" "")
          (t4-constructors-with
              ((reverse (t4-record-laws-inherited proof-proof-symmetric records ma))
               (chained (t4-record-laws-inherited proof-proof-chain records reverse (list mb)))
               (assumption (t4-record-laws-inherited proof-proof-assume records guard t))
               (contradiction (t4-record-laws-inherited proof-proof-cut records chained assumption))
               (left (t4-constructors-first a 1))
               (right (t4-constructors-first b 1)))
            (t4-record-laws-inherited proof-proof-subsume records contradiction
                                      (cons (proof-eq left right) (proof-step-clause contradiction)))))))))

(defun t4-record-laws-record-update-law-chain (records a b)
  (t4-constructors-with ((back (t4-record-laws-inherited proof-proof-symmetric records b))
                         (step (t4-record-laws-inherited proof-proof-chain records a (list back))))
    (cons step records)))

(defun t4-record-laws-record-update-law-compare-values (a b assumed records obj query guard)
  (t4-record-laws-with
      (((a records) (t4-record-laws-record-update-law-at-key a assumed records obj query))
       ((b records) (t4-record-laws-record-update-law-at-key b assumed records obj query))
       (left (t4-constructors-first a 2))
       (right (t4-constructors-first b 2)))
    (if (equal left right)
        (t4-record-laws-record-update-law-chain records a b)
      (t4-record-laws-with
          ((step (t4-record-laws-record-update-law-opposite a b assumed records query guard)))
        (cons step records)))))

(defun t4-record-laws-record-update-law-compare-branch-selected (view records known test)
  (t4-constructors-with
      ((value (t4-constructors-first view 2))
       (condition (and (proof-is-call value *proof-if*) (t4-constructors-at value 1))))
    (if (and (proof-is-call value *proof-if*) (equal condition test))
        (t4-records-records-choose records view known)
      view)))

(mutual-recursion
 (defun t4-record-laws-record-update-law-compare (n a b assumed records obj query guard)
   (declare (xargs :measure (nfix n)))
   (if (not (acl2::o< (nfix (1- n)) (nfix n)))
       '(:failure "Fuel" "t4-record-laws-record-update-law-compare")
     (t4-record-laws-with ((left (t4-constructors-first a 2))
                            (right (t4-constructors-first b 2)))
       (if (equal left right)
           (t4-record-laws-record-update-law-chain records a b)
         (let ((undecided (cond ((proof-is-call left *proof-if*) left)
                                ((proof-is-call right *proof-if*) right)
                                (t nil))))
           (if (not undecided)
               (t4-record-laws-record-update-law-compare-values a b assumed records obj query guard)
             (t4-record-laws-with
                 ((test (t4-constructors-at undecided 1))
                  (key (and (proof-is-call test *proof-equal*) (t4-constructors-at test 1))))
               (if (not (and (proof-is-call test *proof-equal*) (equal key query) (< (len assumed) 6)))
                   '(:failure "SearchMiss" "")
                 (let ((known (assoc-equal test assumed)))
                   (if known
                       (t4-record-laws-record-update-law-compare-branch
                        (1- n) (cdr known) assumed a b records obj query guard test)
                     (t4-record-laws-with
                         ((yes (t4-record-laws-inherited proof-proof-assume records test t))
                          (no (t4-record-laws-inherited proof-proof-assume records test nil))
                          ((yes records)
                           (t4-record-laws-record-update-law-compare-branch
                            (1- n) yes (table-put assumed test yes) a b records obj query guard test))
                          ((no records)
                           (t4-record-laws-record-update-law-compare-branch
                            (1- n) no (table-put assumed test no) a b records obj query guard test))
                          (step (t4-record-laws-inherited proof-proof-cases records test yes no)))
                       (cons step records))))))))))))
 (defun t4-record-laws-record-update-law-compare-branch (n known cases a b records obj query guard test)
   (declare (xargs :measure (nfix n)))
   (if (not (acl2::o< (nfix (1- n)) (nfix n)))
       '(:failure "Fuel" "t4-record-laws-record-update-law-compare-branch")
     (t4-record-laws-with
         ((a (t4-record-laws-record-update-law-compare-branch-selected a records known test))
          (b (t4-record-laws-record-update-law-compare-branch-selected b records known test)))
       (t4-record-laws-record-update-law-compare (1- n) a b cases records obj query guard)))))

(defun t4-record-laws-record-update-law-proof (records left right obj guard)
  (t4-record-laws-with
      ((base (list *t4-records-fields* obj))
       (backing (list *t4-records-backing* obj))
       ((types records) (t4-records-records-decoded-types records obj))
       (typed-base (car types))
       (backing-allowed (cadr types))
       ((left-result records)
        (t4-record-laws-record-update-law-writes 1000000 left records obj base backing typed-base backing-allowed))
       (left-eq (car left-result))
       (fields-a (cadr left-result))
       (valid-a (caddr left-result))
       ((right-result records)
        (t4-record-laws-record-update-law-writes 1000000 right records obj base backing typed-base backing-allowed))
       (right-eq (car right-result))
       (fields-b (cadr right-result))
       (valid-b (caddr right-result))
       (query (list *t4-record-laws-bad-field* fields-a fields-b))
       ((read-a records)
        (t4-record-laws-record-update-law-read-term 1000000 fields-a records base query typed-base))
       ((read-b records)
        (t4-record-laws-record-update-law-read-term 1000000 fields-b records base query typed-base))
       ((comparison records)
        (t4-record-laws-record-update-law-compare 1000000 (car read-a) (car read-b) nil records obj query guard))
       ((fields-equal records)
        (t4-record-laws-extensional records fields-a fields-b valid-a valid-b comparison))
       (lib (t4-records-records-lib records))
       (left (library-inherited proof-proof-rewrite lib left-eq fields-equal '(1 2 1)))
       (right (library-inherited proof-proof-symmetric lib right-eq))
       (proof (library-inherited proof-proof-chain lib left (list right)))
       (step (if (and (not (eq guard :none)) guard)
                 (t4-ordinals-ordinals-imply lib guard proof)
               proof)))
    (cons step lib)))

(defun t4-record-laws-record-update-law-shape-p (left right obj)
  (if (proof-is-call right *t4-records-set*)
      t
    (t4-constructors-with ((value (t4-constructors-at left 2))
                           (key (t4-constructors-at left 1)))
      (equal value (list *t4-records-get* key obj)))))

(defun t4-record-laws-record-update-law-attempt (lib formula replies)
  (t4-constructors-with-library ((parts (t4-constructors-implied formula)))
    (let ((guard (car parts))
          (claim (cadr parts)))
      (if (not (proof-is-call claim *proof-equal*))
          (cons nil lib)
        (t4-constructors-with-library ((left (t4-constructors-at claim 1)))
          (if (not (proof-is-call left *t4-records-set*))
              (cons nil lib)
            (t4-constructors-with-library
                ((parts (proof-list-of-length (cdr claim) 2))
                 (right (cadr parts))
                 (obj (t4-record-laws-record-update-law-initial 1000000 left))
                 (right-obj (t4-record-laws-record-update-law-initial 1000000 right)))
              (if (or (not (equal obj right-obj)) (proof-compound obj)
                      (and (not (eq guard :none)) (not (proof-is-call guard *proof-not*))))
                  (cons nil lib)
                (t4-constructors-with-library ((matches (t4-record-laws-record-update-law-shape-p left right obj)))
                  (if matches
                      (t4-constructors-with-library
                          (((ignored lib replies) (t4-constructors-query :use-arithmetic nil lib replies)))
                        (t4-record-laws-record-update-law-proof (t4-records-records-init lib) left right obj guard))
                    (cons nil lib)))))))))))

(defun t4-record-laws-record-sufficiency (lib formula replies)
  (t4-constructors-finish (t4-record-laws-record-sufficiency-attempt lib formula replies) lib nil))

(defun t4-record-laws-record-sufficiency-with-library (lib formula replies)
  (t4-constructors-finish (t4-record-laws-record-sufficiency-attempt lib formula replies) lib t))

(defun t4-record-laws-record-update-law (lib formula replies)
  (t4-constructors-finish (t4-record-laws-record-update-law-attempt lib formula replies) lib nil))

(defun t4-record-laws-record-update-law-with-library (lib formula replies)
  (t4-constructors-finish (t4-record-laws-record-update-law-attempt lib formula replies) lib t))
