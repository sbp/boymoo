                 (right (caddr equation)))
             (if (or (not (proof-is-call left *t4-hash-lists-hons-sublis*))
                     (not (proof-is-call right *t4-hash-lists-sublis*))
                     (not (equal (cdr left) (cdr right))))
                 (list nil lib replies)
               (t4-hash-lists-with-results
                ((arguments (proof-list-of-length (cdr left) 2))
                 (guard-table (proof-term-at guard 1)))
                (let ((table (car arguments))
                      (obj (cadr arguments)))
                  (if (or (not (equal guard-table table)) (proof-compound obj))
                      (list nil lib replies)
                    (t4-hash-lists-substitution-map-proof lib formula guard left right
                                                         table obj replies)))))))))))))

(defun t4-hash-lists-membership-tests-ordinary (lib actual ordinary replies)
  (let ((proof (library-library-proof lib)))
    (t4-hash-lists-with-results
     ((call (proof-proof-unfold proof actual))
      (value (t4-hash-lists-step-at call '(2)))
      (logical :context (t4-hash-lists-logical lib value replies))
      (shown (proof-proof-chain proof call (list logical)))
      (value (t4-hash-lists-step-at shown '(2))))
     (if (not (equal value ordinary))
         (list '(:failure "inference-mismatch" "") lib replies)
       (t4-hash-lists-with-results
        ((same :context (t4-hash-lists-iff-value lib ordinary ordinary nil replies))
         (right (proof-proof-reflexive proof ordinary)))
        (list (t4-hash-lists-iff-rewrite lib same shown right) lib replies))))))

(defun t4-hash-lists-membership-tests-lookup (lib actual ordinary replies)
  (t4-hash-lists-with-results
   ((lookup (proof-list-of-length actual 3))
    (put (proof-list-of-length (caddr lookup) 4)))
   (let ((key (cadr lookup))
         (values (cadr put))
         (flag (caddr put))
         (table (cadddr put)))
     (if (not (and (equal (cdr ordinary) (list key values))
                   (equal flag *proof-true*)
                   (proof-is-call table *proof-quote*)))
         (list '(:failure "inference-mismatch" "") lib replies)
       (t4-hash-lists-with-results
        ((bindings (list (list *library-x* key) (list *library-y* values)
                         (list (proof-sym "A" "ACL2") table)))
         (atom :context (t4-hash-lists-prove lib (list *t4-structural-atom* table) nil
                                             (list *t4-structural-atom* *proof-not*) replies))
         (fact (proof-proof-fact proof (proof-sym "HONS-ASSOC-EQUAL-HONS-PUT-LIST" "ACL2") bindings))
         (binding-test (proof-proof-modus-ponens proof fact atom))
         (value (t4-hash-lists-step-at binding-test '(2)))
         (logical :context (t4-hash-lists-logical lib value replies))
         (decoded (proof-proof-rewrite proof binding-test logical '(1 2)))
         (unfolded (proof-proof-unfold proof actual))
         (reversed (proof-proof-symmetric proof unfolded)))
        (list (proof-proof-rewrite proof decoded reversed '(1 1)) lib replies))))))

(defun t4-hash-lists-membership-tests (lib actual ordinary replies)
  (cond ((not (proof-is-call ordinary *t4-hash-lists-member*))
         (list '(:failure "search-miss" "") lib replies))
        ((proof-is-call actual *t4-hash-lists-hons-member*)
         (t4-hash-lists-membership-tests-ordinary lib actual ordinary replies))
        ((not (proof-is-call actual *t4-hash-lists-get*))
         (list '(:failure "search-miss" "")
               lib replies))
        (t (t4-hash-lists-with-results ((put (proof-term-at actual 2)))
            (if (proof-is-call put *t4-hash-lists-put*)
                (t4-hash-lists-membership-tests-lookup lib actual ordinary replies)
              (list '(:failure "search-miss" "")
                    lib replies))))))

(defun t4-hash-lists-parallel-list-scan-branch (holds lib test tested ordinary lhs rhs ih)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
     ((first (proof-proof-assume proof test holds))
      (second (if holds
                  (t4-syntax-lists-iff-forward lib tested first)
                (proof-with-checked-results
                 ((term (t4-hash-lists-step-at tested nil))
                  (equation (proof-proof-unfold proof term))
                  (rewritten (proof-proof-rewrite proof tested equation '(1)))
                  (reduced (proof-proof-prove-if proof rewritten first))
                  (denied (proof-proof-unfold proof (proof-neg ordinary))))
                 (proof-proof-transport proof reduced denied))))
      (got (t4-syntax-lists-choose lib lhs first))
      (want (t4-syntax-lists-choose lib rhs second))
      (left (t4-hash-lists-step-at got '(2)))
      (right (t4-hash-lists-step-at want '(2)))
      (got (if (equal left right) got (t4-hash-lists-rewrite-output lib got (list ih))))
      (reversed (proof-proof-symmetric proof want)))
     (proof-proof-chain proof got (list reversed)))))

(defun t4-hash-lists-parallel-list-scan (lib left right obj replies)
  (let* ((proof (library-library-proof lib))
         (statement (proof-eq left right))
         (shape (list *proof-consp* obj)))
    (t4-hash-lists-with-results
     ((cons-shape (proof-proof-assume proof shape t))
      (atom-shape (proof-proof-assume proof shape nil))
      (nil-left :context (t4-hash-lists-spine lib left atom-shape replies))
      (nil-right :context (t4-hash-lists-spine lib right atom-shape replies))
      (reversed (proof-proof-symmetric proof nil-right))
      (empty (proof-proof-chain proof nil-left (list reversed)))
      (lhs :context (t4-hash-lists-spine lib left cons-shape replies))
      (rhs :context (t4-hash-lists-spine lib right cons-shape replies))
      (test (t4-hash-lists-step-at lhs '(2 1)))
      (ordinary (t4-hash-lists-step-at rhs '(2 1)))
      (tested :context (t4-hash-lists-membership-tests lib test ordinary replies))
      (hypothesis (t4-syntax-lists-recur lib statement obj *library-cdr* 3))
      (yes (t4-hash-lists-parallel-list-scan-branch t lib test tested ordinary lhs rhs (car hypothesis)))
      (no (t4-hash-lists-parallel-list-scan-branch nil lib test tested ordinary lhs rhs (car hypothesis)))
      (branch-pair (proof-proof-cases proof test yes no))
      (cases (proof-proof-cases proof shape branch-pair empty))
      (ordinal (library-library-builtin lib 1 obj)))
     (list (proof-proof-induct proof ordinal cases statement (t4-structural-count obj)
                               (list (cadr hypothesis)))
           lib replies))))

(defun t4-hash-lists-hash-set-operation-prove-leg
    (holds lib branches unfolding test standard obj desired replies)
  (let ((proof (library-library-proof lib)))
    (t4-hash-lists-with-results
     ((branch (if holds (car branches) (cadr branches)))
      (assumed (proof-proof-assume proof test holds))
      (chosen (t4-syntax-lists-choose lib unfolding assumed))
      (view (proof-proof-chain proof chosen (list branch)))
      (fast-or-slow (t4-hash-lists-step-at view '(2)))
      (scan-name (t4-hash-lists-term-at fast-or-slow '(0 2)))
      (name (if (stringp scan-name)
                (concatenate 'string "LIST-SCAN-AGREEMENT-" scan-name)
              '(:failure "failure" "")))
      (fact-name (t4-hash-lists-self-name name))
      (lemma :context
             (if (assoc-equal fact-name (proof-proof-facts proof))
                 (list nil lib replies)
               (t4-hash-lists-with-results
                ((step :context (t4-hash-lists-parallel-list-scan lib fast-or-slow standard obj replies))
                 (term (t4-hash-lists-step-at step nil))
                 (lib (library-library-lemma lib name term step nil)))
                (list nil lib replies))))
      (fact (proof-proof-fact proof fact-name nil))
      (reversed (proof-proof-symmetric proof desired)))
     (list (proof-proof-chain proof view (list fact reversed)) lib replies))))

(defun t4-hash-lists-logical-branches (lib terms replies)
  (declare (xargs :measure (acl2-count terms)))
  (if (endp terms)
      (list nil lib replies)
    (t4-hash-lists-with-results
     ((step :context (t4-hash-lists-logical lib (car terms) replies))
      (rest :context (t4-hash-lists-logical-branches lib (cdr terms) replies)))
     (list (cons step rest) lib replies))))

(defun t4-hash-lists-recursive-scan-p (term obj recursive)
  (and (proof-compound term) (equal (len term) 3)
       (equal (cadr term) obj) (member-equal (car term) recursive)))

(defun t4-hash-lists-hash-set-operation-proof
    (lib specification obj other recursive unfolding alternatives replies)
  (t4-hash-lists-with-results
   ((test (proof-term-at alternatives 1))
    (branches :context (t4-hash-lists-logical-branches lib (cddr alternatives) replies))
    (values (proof-list-of-length branches 2))
    (fast (t4-hash-lists-step-at (car values) '(2)))
    (slow (t4-hash-lists-step-at (cadr values) '(2))))
   (if (or (not (t4-hash-lists-recursive-scan-p fast obj recursive))
           (not (t4-hash-lists-recursive-scan-p slow obj recursive))
           (not (equal (caddr slow) other))
           (not (proof-is-call (caddr fast) *t4-hash-lists-put*)))
       (list nil lib replies)
     (t4-hash-lists-with-results ((keys (proof-term-at (caddr fast) 1)))
      (if (not (equal keys other))
          (list nil lib replies)
        (t4-hash-lists-with-results
         ((desired :context (t4-hash-lists-logical lib specification replies))
          (standard (t4-hash-lists-step-at desired '(2))))
         (if (not (and (proof-compound standard)
                       (equal (len standard) 3)
                       (equal (cdr standard) (list obj other))
                       (assoc-equal (car standard) (proof-proof-definitions proof))))
             (list nil lib replies)
           (t4-hash-lists-with-results
            ((arithmetic :context (t4-hash-lists-operation :use-arithmetic nil lib replies))
             (yes :context (t4-hash-lists-hash-set-operation-prove-leg
                            t lib branches unfolding test standard obj desired replies))
             (no :context (t4-hash-lists-hash-set-operation-prove-leg
                           nil lib branches unfolding test standard obj desired replies)))
            (list (proof-proof-cases proof test yes no) lib replies)))))))))

(defun t4-hash-lists-hash-set-operation-visit (lib formula recursive replies)
  (let ((proof (library-library-proof lib)))
    (if (not (proof-is-call formula *proof-equal*))
        (list nil lib replies)
      (t4-hash-lists-with-results ((terms (proof-list-of-length (cdr formula) 2)))
       (let ((caller (car terms))
             (specification (cadr terms)))
         (if (or (not (proof-compound caller)) (not (equal (len caller) 3))
                 (not (assoc-equal (car caller) (proof-proof-definitions proof)))
                 (proof-compound (cadr caller)) (proof-compound (caddr caller))
                 (not (assoc-equal (proof-sym "HONS-ASSOC-EQUAL-HONS-PUT-LIST" "ACL2")
                                   (proof-proof-facts proof))))
             (list nil lib replies)
           (t4-hash-lists-with-results
            ((unfolding (proof-proof-unfold proof caller))
             (alternatives (t4-hash-lists-step-at unfolding '(2))))
            (if (proof-is-call alternatives *proof-if*)
                (t4-hash-lists-hash-set-operation-proof lib specification (cadr caller)
                                                       (caddr caller) recursive unfolding
                                                       alternatives replies)
              (list nil lib replies)))))))))

(defun t4-hash-lists-query (tactic lib formula recursive replies)
  (let* ((result (case tactic
                   (:put-membership (t4-hash-lists-put-membership-visit lib formula replies))
                   (:duplicate-membership (t4-hash-lists-duplicate-membership-visit lib formula replies))
                   (:substitution-map (t4-hash-lists-substitution-map-visit lib formula replies))
                   (:hash-set-operation (t4-hash-lists-hash-set-operation-visit
                                         lib formula recursive replies))
                   (otherwise (list '(:failure "search-miss" "") lib replies))))
         (value (car result)))
    (if (t4-hash-lists-request-p value)
        value
      (cons value (cadr result)))))

