(in-package "BOYMOO-PROVER")
(set-verify-guards-eagerness 0)

(defconst *t4-hash-lists-assoc* (proof-sym "ASSOC-EQUAL" "ACL2"))
(defconst *t4-hash-lists-hons-assoc* (proof-sym "HONS-ASSOC-EQUAL" "ACL2"))
(defconst *t4-hash-lists-get* (proof-sym "HONS-GET" "ACL2"))
(defconst *t4-hash-lists-acons* (proof-sym "HONS-ACONS" "ACL2"))
(defconst *t4-hash-lists-put* (proof-sym "HONS-PUT-LIST" "ACL2"))
(defconst *t4-hash-lists-hons-equal* (proof-sym "HONS-EQUAL" "ACL2"))
(defconst *t4-hash-lists-alist* (proof-sym "ALISTP" "ACL2"))
(defconst *t4-hash-lists-member* (proof-sym "MEMBER-EQUAL" "ACL2"))
(defconst *t4-hash-lists-hons-member* (proof-sym "HONS-MEMBER-EQUAL" "ACL2"))
(defconst *t4-hash-lists-dups* (proof-sym "HONS-DUPS-P" "ACL2"))
(defconst *t4-hash-lists-dups-loop* (proof-sym "HONS-DUPS-P1" "ACL2"))
(defconst *t4-hash-lists-nodups* (proof-sym "NO-DUPLICATESP-EQUAL" "ACL2"))
(defconst *t4-hash-lists-hons-sublis* (proof-sym "HONS-SUBLIS-AUX" "ACL2"))
(defconst *t4-hash-lists-sublis* (proof-cl "SUBLIS"))
(defconst *t4-hash-lists-hits* (proof-sym "T4-ANY-KEY-IN-ALIST" "ACL2"))

(defun t4-hash-lists-request-p (value)
  (eq (car value) :t4-request))

; A computation carries the value, the Library, and the unused replies.
(defmacro t4-hash-lists-with-results (bindings result)
  (if (endp bindings)
      result
    (let ((name (caar bindings))
          (form (cadar bindings))
          (body `(t4-hash-lists-with-results ,(cdr bindings) ,result)))
      (if (eq form :context)
          `(let* ((computation ,(caddar bindings))
                  (,name (car computation)))
             (if (or (failure-p ,name) (t4-hash-lists-request-p ,name))
                 computation
               (let* ((lib (cadr computation))
                      (replies (caddr computation))
                      (proof (library-library-proof lib)))
                 (declare (ignorable lib replies proof))
                 ,body)))
        `(let ((,name ,form))
           (if (failure-p ,name)
               (list ,name lib replies)
             ,body))))))

(defun t4-hash-lists-operation (operation arguments lib replies)
  (if (endp replies)
      (list (list :t4-request operation arguments lib) lib nil)
    (let ((reply (car replies)))
      (if (failure-p reply)
          (list reply lib (cdr replies))
        (list (car reply) (cdr reply) (cdr replies))))))

(defun t4-hash-lists-syntax-result (result lib replies)
  (if (failure-p result)
      (list result lib replies)
    (list (car result) (cdr result) replies)))

(defun t4-hash-lists-term-at (term indexes)
  (declare (xargs :measure (acl2-count indexes)))
  (if (endp indexes)
      term
    (proof-with-checked-results ((part (proof-term-at term (car indexes))))
      (t4-hash-lists-term-at part (cdr indexes)))))

(defun t4-hash-lists-step-at (step indexes)
  (if (null step)
      '(:failure "failure" "")
    (proof-with-checked-results ((first (proof-step-first step)))
      (t4-hash-lists-term-at first indexes))))

(defun t4-hash-lists-self-name (name)
  (proof-sym (concatenate 'string "SELF-" name) "ACL2"))

(defun t4-hash-lists-known (lib term extra replies)
  (t4-hash-lists-with-results
   ((evidence (t4-structural-evidence-init lib nil extra))
    (result :context (t4-hash-lists-operation :known (list term evidence) lib replies)))
   (list (car result) lib replies)))

(defun t4-hash-lists-fact-proof (lib term extra replies)
  (t4-hash-lists-with-results
   ((evidence (t4-structural-evidence-init lib nil extra))
    (result :context (t4-hash-lists-operation :fact-proof (list term evidence) lib replies)))
   (list (car result) lib replies)))

(defun t4-hash-lists-prove (lib term premises definitions replies)
  (t4-hash-lists-operation :prove (list term premises definitions) lib replies))

(defun t4-hash-lists-simplify (lib term premises definitions replies)
  (t4-hash-lists-operation :simplify (list term premises definitions) lib replies))

(defun t4-hash-lists-syntax-call (kind lib first second replies)
  (case kind
    (:spine (t4-syntax-lists-spine-with-replies lib first second replies))
    (:constructed-view (t4-syntax-lists-constructed-view-with-replies lib first second replies))
    (otherwise (t4-syntax-lists-iff-transitive lib first second replies))))

; Each syntax recipe here asks for one proof, either a shape or an equivalence law.
(defun t4-hash-lists-syntax-proof (kind lib first second replies)
  (let ((initial-lib lib))
    (t4-hash-lists-with-results
     ((result (t4-hash-lists-syntax-call kind lib first second nil)))
     (let ((request (car result))
           (lib (cdr result)))
       (if (not (t4-syntax-lists-request-p request))
           (list request lib replies)
         (let ((operation (cadr request))
               (arguments (caddr request)))
           (t4-hash-lists-with-results
            ((answer :context (if (eq operation :fact-proof)
                                  (t4-hash-lists-fact-proof lib (car arguments)
                                                           (cadr arguments) replies)
                                (t4-hash-lists-operation operation arguments lib replies))))
            (t4-hash-lists-syntax-result
             (t4-hash-lists-syntax-call kind initial-lib first second (list (cons answer lib)))
             lib replies))))))))

(defun t4-hash-lists-spine (lib call shape replies)
  (t4-hash-lists-syntax-proof :spine lib call shape replies))

(defun t4-hash-lists-constructed-view (lib call pair replies)
  (t4-hash-lists-syntax-proof :constructed-view lib call pair replies))

(defun t4-hash-lists-iff-transitive (lib first second replies)
  (t4-hash-lists-syntax-proof :iff-transitive lib first second replies))

(defun t4-hash-lists-transport-known (proof step equality)
  (if step
      (proof-proof-transport proof step equality)
    (let ((reverse (proof-proof-symmetric proof equality)))
      (if (failure-p reverse)
          reverse
        '(:failure "failure" "")))))

(defun t4-hash-lists-logical (lib term replies)
  (t4-hash-lists-with-results
   ((simplified :context (t4-hash-lists-simplify lib term nil
                                               (list *termination-return-last*) replies)))
   (list (or simplified (proof-proof-reflexive proof term)) lib replies)))

(defun t4-hash-lists-iff-value (lib left right premises replies)
  (let ((claim (list *t4-syntax-lists-iff* left right)))
    (t4-hash-lists-with-results
     ((reflexive :context (if (equal left right)
                              (t4-hash-lists-fact-proof lib claim nil replies)
                            (list nil lib replies))))
     (if reflexive
         (list reflexive lib replies)
       (t4-hash-lists-prove lib claim premises
                            (list *t4-syntax-lists-iff* *proof-not*) replies)))))

(defun t4-hash-lists-iff-rewrite (lib step left right)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
     ((reverse-left (proof-proof-symmetric proof left))
      (step (proof-proof-rewrite proof step reverse-left '(1 1)))
      (reverse-right (proof-proof-symmetric proof right))
      (step (proof-proof-rewrite proof step reverse-right '(1 2))))
     (proof-proof-tidy proof step))))

(defun t4-hash-lists-update-lookup (lib lookup replies)
  (let ((proof (library-library-proof lib)))
    (t4-hash-lists-with-results ((parts (proof-list-of-length lookup 3)))
     (let ((operator (car parts))
           (extension (caddr parts)))
       (if (not (and (member-equal operator
                                   (list *t4-hash-lists-get* *t4-hash-lists-hons-assoc*))
                     (proof-is-call extension *t4-hash-lists-acons*)))
           (list '(:failure "inference-mismatch" "") lib replies)
         (t4-hash-lists-with-results
          ((entry (proof-proof-unfold proof extension))
           (listed (t4-hash-lists-step-at entry '(2)))
           (starting (if (equal operator *t4-hash-lists-get*)
                         (proof-proof-unfold proof lookup)
                       (proof-proof-reflexive proof lookup)))
           (current (proof-proof-rewrite proof starting entry '(1 2 2)))
           (call (t4-hash-lists-step-at current '(2)))
           (chosen :context (t4-hash-lists-constructed-view lib call listed replies))
           (pair (proof-term-at listed 1))
           (test (t4-hash-lists-step-at chosen '(2 1)))
           (pair-cons :context (t4-hash-lists-known lib (list *proof-consp* pair) nil replies))
           (head-is-pair (if pair-cons
                             (proof-proof-select proof test pair-cons)
                           (t4-hash-lists-step-at nil nil)))
           (chosen (proof-proof-rewrite proof chosen head-is-pair '(1 2 1)))
           (test (t4-hash-lists-step-at chosen '(2 1)))
           (reduced :context (t4-hash-lists-simplify lib test nil
                                                   (list *t4-hash-lists-hons-equal*) replies))
           (chosen (if reduced
                       (proof-proof-rewrite proof chosen reduced '(1 2 1))
                     (t4-hash-lists-step-at nil nil))))
          (list (proof-proof-chain proof current (list chosen)) lib replies)))))))

(defun t4-hash-lists-iff-truth-of-if-side (lib test value sign known replies)
  (let ((proof (library-library-proof lib)))
    (t4-hash-lists-with-results
     ((premise (proof-proof-assume proof test sign))
      (branch (proof-proof-select proof value premise))
      (term (t4-hash-lists-step-at branch '(2)))
      (proved :context (t4-hash-lists-prove lib term
                                           (if known (list premise known) (list premise))
                                           nil replies)))
     (list (proof-proof-transport proof proved branch) lib replies))))

(defun t4-hash-lists-iff-truth-of-if (lib test yes no otherwise replies)
  (let ((value (proof-ite test yes no)))
    (t4-hash-lists-with-results
     ((yes-step :context (t4-hash-lists-iff-truth-of-if-side lib test value t nil replies))
      (no-step :context (t4-hash-lists-iff-truth-of-if-side lib test value nil otherwise replies)))
     (list (proof-proof-cases proof test yes-step no-step) lib replies))))

(defun t4-hash-lists-if-same (lib term)
  (let ((proof (library-library-proof lib)))
    (if (not (proof-is-call term *proof-if*))
        '(:failure "inference-mismatch" "")
      (proof-with-checked-results
       ((yes (proof-term-at term 2))
        (no (proof-term-at term 3)))
       (if (not (equal yes no))
           '(:failure "inference-mismatch" "")
         (proof-with-checked-results
          ((test (proof-term-at term 1))
           (yes-step (proof-proof-if-true proof term))
           (no-step (proof-proof-if-false proof term)))
          (proof-proof-cases proof test yes-step no-step)))))))

(defun t4-hash-lists-reverse-test (lib evidence)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results ((first (t4-hash-lists-step-at evidence nil)))
      (if (proof-is-call first *proof-equal*)
          (proof-proof-symmetric proof evidence)
        (proof-with-checked-results
         ((negative (proof-list-of-length first 2))
          (parts (proof-list-of-length (cadr negative) 3))
          (test (proof-eq (caddr parts) (cadr parts)))
          (assumed (proof-proof-assume proof test t))
          (reversed (proof-proof-symmetric proof assumed))
          (cut (proof-proof-cut proof reversed evidence)))
         (proof-proof-front proof cut (proof-neg test)))))))

(defun t4-hash-lists-rewrite-output (lib equation comparisons)
  (declare (xargs :measure (acl2-count comparisons)))
  (if (endp comparisons)
      equation
    (let ((proof (library-library-proof lib)))
      (proof-with-checked-results
       ((right (t4-hash-lists-step-at equation '(2)))
        (slot (t4-hash-lists-step-at (car comparisons) '(1)))
        (equation (proof-proof-rewrite-result proof equation (car comparisons)
                                              (proof-eq *proof-false* right) slot)))
       (t4-hash-lists-rewrite-output lib equation (cdr comparisons))))))

(defun t4-hash-lists-insertion-lookup (unchanged lib own old-test old match assumes-match replies)
  (let ((proof (library-library-proof lib)))
    (if unchanged
        (t4-hash-lists-with-results
         ((first (t4-hash-lists-step-at own nil))
          (unfolded (proof-proof-unfold proof first))
          (own (proof-proof-rewrite proof own unfolded '(1)))
          (reverse-match (proof-proof-symmetric proof assumes-match))
          (present (proof-proof-rewrite proof own reverse-match '(1 1)))
          (same-tail (proof-proof-reflexive proof old)))
         (list (list present same-tail) lib replies))
      (t4-hash-lists-with-results
       ((updated :context (t4-hash-lists-update-lookup lib old-test replies))
        (present (t4-syntax-lists-choose lib updated assumes-match))
        (right (t4-hash-lists-step-at present '(2)))
        (pair :context (t4-hash-lists-known lib right nil replies))
        (present (t4-hash-lists-transport-known proof pair present))
        (miss (proof-proof-assume proof match nil))
        (same-tail (t4-syntax-lists-choose lib updated miss)))
       (list (list present same-tail) lib replies)))))

(defun t4-hash-lists-put-membership-lemma-branch
    (unchanged lib redundant next-table viewed lookup keys table inserted smaller
               formula old match cons-member cons-shape right replies)
  (let ((proof (library-library-proof lib)))
    (t4-hash-lists-with-results
     ((condition (proof-proof-assume proof redundant unchanged))
      (selected (proof-proof-select proof next-table condition))
      (enlarged (proof-proof-rewrite proof viewed selected '(1 2 3)))
      (initial (proof-proof-reflexive proof lookup))
      (left (proof-proof-rewrite proof initial enlarged '(1 2 2)))
      (tail (list *library-cdr* keys))
      (key-binding (list keys tail))
      (substitution (if unchanged (list key-binding)
                      (list key-binding (list table inserted))))
      (smaller-term (t4-hash-lists-step-at smaller nil))
      (bindings (if unchanged (list (cons keys tail))
                  (list (cons keys tail) (cons table inserted))))
      (recursive-formula (proof-subst formula bindings))
      (hypothesis (proof-ite smaller-term recursive-formula *proof-true*))
      (assumed (proof-proof-assume proof hypothesis t))
      (induction (proof-proof-prove-if proof assumed smaller))
      (old-test (t4-hash-lists-step-at induction '(2 3)))
      (own (if unchanged
               (proof-with-checked-results ((conjuncts (proof-proof-conjunct proof condition)))
                 (car conjuncts))
             nil))
      (assumes-match (proof-proof-assume proof match t))
      (lookups :context (t4-hash-lists-insertion-lookup unchanged lib own old-test old match
                                                       assumes-match replies))
      (induction-test (t4-hash-lists-step-at induction '(2 1)))
      (extended-found :context
                      (t4-hash-lists-iff-truth-of-if lib induction-test *proof-true* old-test
                                                    (car lookups) replies))
      (matched (t4-syntax-lists-choose lib cons-member assumes-match))
      (left-member :context (t4-hash-lists-known lib keys (list cons-shape) replies))
      (known-member (t4-hash-lists-transport-known proof left-member matched))
      (right-eq (proof-proof-reflexive proof right))
      (right-present (t4-syntax-lists-choose lib right-eq known-member))
      (found (t4-hash-lists-step-at extended-found nil))
      (found-iff :context (t4-hash-lists-iff-value lib found *proof-true*
                                                  (list extended-found) replies))
      (match-proof :context (t4-hash-lists-iff-transitive lib induction found-iff replies))
      (yes (t4-hash-lists-iff-rewrite lib match-proof left right-present))
      (assumes-miss (proof-proof-assume proof match nil))
      (missed (t4-syntax-lists-choose lib cons-member assumes-miss))
      (right-eq (proof-proof-reflexive proof right))
      (right-absent (proof-proof-rewrite proof right-eq missed '(1 2 1)))
      (induction (if unchanged induction
                   (proof-proof-rewrite proof induction (cadr lookups) '(1 2 3))))
      (no (t4-hash-lists-iff-rewrite lib induction left right-absent))
      (cases (proof-proof-cases proof match yes no)))
     (list (cons cases substitution) lib replies))))

(defun t4-hash-lists-redundant-insertion (view-call next-table keys table inserted current)
  (cond ((not (equal (take 3 view-call)
                     (list *t4-hash-lists-put* (list *library-cdr* keys) *proof-true*)))
         '(:failure "inference-mismatch" ""))
        ((integerp next-table)
         '(:failure "failure" ""))
        ((not (equal (cddr next-table) (list table inserted)))
         '(:failure "inference-mismatch" ""))
        (t (proof-with-checked-results ((redundant (proof-term-at next-table 1)))
             (if (not (proof-is-call redundant *proof-if*))
                 '(:failure "inference-mismatch" "")
               (proof-with-checked-results ((lookup (proof-term-at redundant 1)))
                 (if (not (equal lookup (list *t4-hash-lists-get* current table)))
                     '(:failure "inference-mismatch" "")
                   (proof-with-checked-results ((nil-branch (proof-term-at redundant 3)))
                     (if (equal nil-branch *proof-false*) redundant
                       '(:failure "inference-mismatch" ""))))))))))

(defun t4-hash-lists-put-membership-lemma (lib replies)
  (let* ((proof (library-library-proof lib))
         (key *library-x*)
         (keys *library-y*)
         (table *library-z*)
         (put (list *t4-hash-lists-put* keys *proof-true* table))
         (lookup (list *t4-hash-lists-hons-assoc* key put))
         (member (list *t4-hash-lists-member* key keys))
         (old (list *t4-hash-lists-hons-assoc* key table))
         (right (proof-ite member *proof-true* old))
         (formula (list *t4-syntax-lists-iff* lookup right))
         (shape (list *proof-consp* keys)))
    (t4-hash-lists-with-results
     ((cons-shape (proof-proof-assume proof shape t))
      (atom-shape (proof-proof-assume proof shape nil))
      (nil-put :context (t4-hash-lists-spine lib put atom-shape replies))
      (nil-member :context (t4-hash-lists-spine lib member atom-shape replies))
      (initial (proof-proof-reflexive proof lookup))
      (unfolded-atom (proof-proof-rewrite proof initial nil-put '(1 2 2)))
      (initial (proof-proof-reflexive proof right))
      (rhs (proof-proof-rewrite proof initial nil-member '(1 2 1)))
      (not-nil (proof-proof-not-nil proof))
      (rhs (t4-syntax-lists-choose lib rhs not-nil))
      (old-iff :context (t4-hash-lists-iff-value lib old old nil replies))
      (no (t4-hash-lists-iff-rewrite lib old-iff unfolded-atom rhs))
      (viewed :context (t4-hash-lists-spine lib put cons-shape replies))
      (viewed-rhs (t4-hash-lists-step-at viewed '(2)))
      (logical :context (t4-hash-lists-logical lib viewed-rhs replies))
      (viewed (proof-proof-chain proof viewed (list logical)))
      (value (proof-ite (list *proof-consp* *proof-true*)
                        (list *library-car* *proof-true*) *proof-true*))
      (simple :context (t4-hash-lists-simplify lib value nil nil replies))
      (viewed-rhs (t4-hash-lists-step-at viewed '(2)))
      (viewed (proof-proof-rewrite-result proof viewed simple
                                          (proof-eq *proof-false* viewed-rhs) value))
      (view-call (t4-hash-lists-step-at viewed '(2)))
      (cons-member :context (t4-hash-lists-spine lib member cons-shape replies))
      (current (list *library-car* keys))
      (match (proof-eq key current))
      (next-table (proof-term-at view-call 3))
      (inserted (list *t4-hash-lists-acons* current *proof-true* table))
      (redundant (t4-hash-lists-redundant-insertion view-call next-table keys table inserted current))
      (smaller (library-library-builtin lib 3 keys))
      (unchanged :context (t4-hash-lists-put-membership-lemma-branch
                           t lib redundant next-table viewed lookup keys table inserted smaller
                           formula old match cons-member cons-shape right replies))
      (changed :context (t4-hash-lists-put-membership-lemma-branch
                         nil lib redundant next-table viewed lookup keys table inserted smaller
                         formula old match cons-member cons-shape right replies))
      (yes (proof-proof-cases proof redundant (car unchanged) (car changed)))
      (cases (proof-proof-cases proof shape yes no))
      (ordinal (library-library-builtin lib 1 keys))
      (prove (proof-proof-induct proof ordinal cases formula (t4-structural-count keys)
                                  (list (cdr unchanged) (cdr changed))))
      (lib (library-library-lemma lib "ASSOC-MEMBERSHIP-OF-KEY-INSERTIONS" formula prove nil)))
     (list nil lib replies))))

(defun t4-hash-lists-put-membership-reduce (sign lib test boolean replies)
  (let ((proof (library-library-proof lib)))
    (t4-hash-lists-with-results
     ((assumed (proof-proof-assume proof test sign))
      (selected (proof-proof-select proof boolean assumed))
      (right (t4-hash-lists-step-at selected '(2)))
      (direct :context (t4-hash-lists-iff-value lib right test (list assumed) replies))
      (reverse-select (proof-proof-symmetric proof selected)))
     (list (proof-proof-rewrite proof direct reverse-select '(1 1)) lib replies))))

(defun t4-hash-lists-put-membership-proof (lib guard key keys table member replies)
  (let ((name "ASSOC-MEMBERSHIP-OF-KEY-INSERTIONS"))
    (t4-hash-lists-with-results
     ((arithmetic :context (t4-hash-lists-operation :use-arithmetic nil lib replies))
      (lemma :context (if (assoc-equal (t4-hash-lists-self-name name) (proof-proof-facts proof))
                          (list nil lib replies)
                        (t4-hash-lists-put-membership-lemma lib replies)))
      (accumulated (library-library-cite lib name (list key keys table) nil))
      (assumed (proof-proof-assume proof guard t))
      (evidence (t4-structural-evidence-init lib nil (list assumed)))
      (absent (t4-structural-evidence-require evidence (proof-neg (list *proof-consp* table))))
      (initial :context (t4-hash-lists-spine lib (list *t4-hash-lists-hons-assoc* key table)
                                             (car absent) replies))
      (branch (proof-proof-rewrite proof accumulated initial '(1 2 3)))
      (boolean (t4-hash-lists-step-at branch '(2)))
      (test (proof-term-at boolean 1))
      (yes :context (t4-hash-lists-put-membership-reduce t lib test boolean replies))
      (no :context (t4-hash-lists-put-membership-reduce nil lib test boolean replies))
      (cases (proof-proof-cases proof test yes no))
      (step :context (t4-hash-lists-iff-transitive lib branch cases replies))
      (reverse-member (proof-proof-symmetric proof member))
      (step (proof-proof-rewrite proof step reverse-member '(1 2))))
     (list (t4-ordinals-ordinals-imply lib guard step) lib replies))))

(defun t4-hash-lists-put-membership-visit (lib formula replies)
  (if (not (proof-is-call formula *library-implies*))
      (list nil lib replies)
    (t4-hash-lists-with-results ((guard (proof-term-at formula 1)))
     (if (not (proof-is-call guard *t4-structural-atom*))
         (list nil lib replies)
       (t4-hash-lists-with-results ((claim (proof-term-at formula 2)))
        (if (not (proof-is-call claim *t4-syntax-lists-iff*))
            (list nil lib replies)
          (t4-hash-lists-with-results
           ((parts (proof-list-of-length (cdr formula) 2))
            (equivalence (proof-list-of-length (cadr parts) 3)))
           (let ((lookup (cadr equivalence))
                 (after (caddr equivalence)))
             (if (not (proof-is-call lookup *t4-hash-lists-hons-assoc*))
                 (list nil lib replies)
               (t4-hash-lists-with-results ((put (proof-term-at lookup 2)))
                (if (not (proof-is-call put *t4-hash-lists-put*))
                    (list nil lib replies)
                  (t4-hash-lists-with-results
                   ((arguments (proof-list-of-length (cdr lookup) 2))
                    (inserted (proof-list-of-length (cadr arguments) 4)))
                   (let ((key (car arguments))
                         (keys (cadr inserted))
                         (value (caddr inserted))
                         (table (cadddr inserted)))
                     (if (or (not (equal value *proof-true*))
                             (not (equal guard (list *t4-structural-atom* table))))
                         (list nil lib replies)
                       (t4-hash-lists-with-results
                        ((member :context (t4-hash-lists-logical lib after replies))
                         (actual (t4-hash-lists-step-at member '(2))))
                        (if (not (equal actual (list *t4-hash-lists-member* key keys)))
                            (list nil lib replies)
                          (t4-hash-lists-put-membership-proof lib guard key keys table member
                                                              replies)))))))))))))))))

(defun t4-hash-lists-hits-extension-compare (known lib head-left old-head head-right old-lookup hypothesis)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
     ((lhs (t4-syntax-lists-choose lib head-left known))
