(in-package "BOYMOO-PROVER")

(set-verify-guards-eagerness 0)

(defun t4-ranges-request-p (value)
  (and (consp value) (eq (car value) :call) (eq (cadr value) :require)))

(defun t4-ranges-range-descent-queries (goal formals)
  (proof-with-checked-results
      ((parameters (if (integerp formals)
                       '(:failure "malformed-candidate" "")
                     (proof-list-of-length (take (min 3 (len formals)) formals) 3)))
       (goal-parts (proof-list-of-length goal 3)))
    (let ((i (car parameters))
          (j (cadr parameters))
          (k (caddr parameters)))
      (list (library-integer i) (library-integer j) (library-integer k)
            (library-positive k) (proof-neg (library-lt j i))))))

(defun t4-ranges-collect (queries replies)
  (cond ((endp queries) nil)
        ((endp replies) (list :call :require (car queries)))
        ((failure-p (car replies)) (car replies))
        (t (let ((rest (t4-ranges-collect (cdr queries) (cdr replies))))
             (if (or (failure-p rest) (t4-ranges-request-p rest))
                 rest
               (cons (car replies) rest))))))

(defun t4-ranges-next-difference (after)
  (if (and (not (integerp after)) (equal (len (cdr after)) 2))
      (library-diff (cadr after) (caddr after))
    '(:failure "malformed-candidate" "")))

(defun t4-ranges-range-descent (lib goal evidence formals)
  (proof-with-checked-results
      ((queries (t4-ranges-range-descent-queries goal formals))
       (steps (t4-ranges-collect queries evidence)))
    (if (t4-ranges-request-p steps)
        steps
      (let* ((proof (library-library-proof lib))
             (after (cadr goal))
             (before (caddr goal))
             (i (car formals))
             (j (cadr formals))
             (ints (list (car steps) (cadr steps) (caddr steps)))
             (advance (cadddr steps))
             (inside (car (cddddr steps))))
        (proof-with-checked-results
            ((below-limit (library-library-cite lib "LESS-THAN-NEXT" (list j i)
                                                 (list (cadr ints) (car ints) inside)))
             (endpoints (if (integerp before)
                            '(:failure "malformed-candidate" "")
                          (proof-list-of-length (cdr before) 2)))
             (upper (car endpoints))
             (lower (cadr endpoints))
             (old (library-diff upper lower))
             (new (t4-ranges-next-difference after))
             (comparison (library-library-comparison lib lower upper ints))
             (positive-old (proof-proof-rewrite proof below-limit comparison '(1)))
             (decrease (library-library-less-from-difference lib new old advance ints))
             (new-type (library-library-type-of lib new ints))
             (old-type (library-library-type-of lib old ints))
             (step (library-library-cite lib "NFIX-DECREASE" (list new old)
                                         (list new-type old-type positive-old decrease)))
             (before-head (proof-term-at before 0))
             (after-head (proof-term-at after 0)))
          (if (not (and (equal before-head after-head)
                        (equal after-head *library-gap*)))
              '(:failure "inference-mismatch" "")
            (proof-with-checked-results
                ((literal (proof-step-first step))
                 (head (proof-term-at literal 0)))
              (if (not (equal head *proof-ordinal-less*))
                  '(:failure "inference-mismatch" "")
                (proof-with-checked-results
                    ((opened (proof-proof-unfold proof after))
                     (first (library-library-transport-argument lib step opened 1))
                     (opened (proof-proof-unfold proof before)))
                  (library-library-transport-argument lib first opened 2))))))))))
