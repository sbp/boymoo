(in-package "BOYMOO-PROVER")

(set-verify-guards-eagerness 0)

(defconst *t3-book-lambdas-pseudo-lambda* (proof-sym "PSEUDO-LAMBDAP" "ACL2"))
(defconst *t3-book-lambdas-logic-fns* (proof-sym "LOGIC-FNSP" "ACL2"))
(defconst *t3-book-lambdas-logic-list* (proof-sym "LOGIC-FNS-LISTP" "ACL2"))
(defconst *t3-book-lambdas-real-term* (proof-sym "TERMP" "ACL2"))
(defconst *t3-book-lambdas-real-list* (proof-sym "TERM-LISTP" "ACL2"))
(defconst *t3-book-lambdas-arglist* (proof-sym "ARGLISTP" "ACL2"))
(defconst *t3-book-lambdas-w* (proof-sym "W" "ACL2"))
(defconst *t3-book-lambdas-construct* (proof-sym "PSEUDO-TERMP-OF-CONS-WHEN-PSEUDO-LAMBDAP" "ACL2"))
(defconst *t3-book-lambdas-symbolp* (proof-cl "SYMBOLP"))
(defconst *t3-book-lambdas-stringp* (proof-cl "STRINGP"))
(defconst *t3-book-lambdas-length* (proof-cl "LENGTH"))
(defconst *t3-book-lambdas-definitions* (append *t3-book-spines-guards* (list (proof-cl "="))))
(defconst *t3-book-lambdas-extract-real* (proof-sym "LAMBDAP-WHEN-TERMP" "ACL2"))
(defconst *t3-book-lambdas-construct-real* (proof-sym "TERMP-WHEN-LAMBDAP" "ACL2"))
(defconst *t3-book-lambdas-proper-length* "T3-LENGTH-PROPER-LIST")
(defconst *t3-book-lambdas-booleanp* *t3-book-lemmas-booleanp*)

(defun t3-book-lambdas-inspect (lib call evidence)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
     ((equation (proof-proof-unfold proof call))
      (right (proof-rewritten-term equation))
      (opened (t3-book-spines-constructor-form lib right evidence *t3-book-lambdas-definitions*)))
     (proof-proof-chain proof equation (list opened)))))

(defun t3-book-lambdas-required (lib formula facts)
  (declare (xargs :measure (acl2-count formula)))
  (let ((proof (library-library-proof lib))
        (known (cdr (assoc-equal formula facts))))
    (cond
     ((equal formula *proof-true*) (proof-proof-prove proof *proof-true* nil nil))
     (known known)
     ((proof-is-call formula *proof-equal*)
      (proof-with-checked-results
       ((right (proof-term-at formula 2))
        (left (proof-term-at formula 1)))
       (let ((swapped (cdr (assoc-equal (proof-eq right left) facts))))
         (if swapped
             (proof-proof-symmetric proof swapped)
           '(:failure "unsupported" "")))))
     ((and (consp formula) (proof-is-call formula *proof-if*))
      (proof-with-checked-results ((no (proof-term-at formula 3)))
        (if (equal no *proof-false*)
            (proof-with-checked-results
             ((test (t3-book-lambdas-required lib (cadr formula) facts))
              (yes (t3-book-lambdas-required lib (caddr formula) facts)))
             (t3-scan-typed-pair lib test yes))
          '(:failure "unsupported" ""))))
     (t '(:failure "unsupported" "")))))

(defun t3-book-lambdas-not-symbol (lib cons)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
     ((literal (proof-step-first cons))
      (value (proof-term-at literal 1))
      (rule (proof-proof-fact proof "consp-not-symbolp" (list (list *library-x* value)))))
     (proof-proof-modus-ponens proof rule cons))))

(defun t3-book-lambdas-present-operator (lib operator facts)
  (let ((proof (library-library-proof lib))
        (test (list *proof-consp* operator)))
    (proof-with-checked-results
     ((enough (t3-book-lambdas-required lib (proof-eq (list *library-len* operator) (proof-quote 3)) facts))
      (absent (proof-proof-assume proof test nil))
      (length (t3-book-halves-length-cons lib operator absent))
      (reduced (proof-proof-rewrite proof enough length '(1 1)))
      (reduced (t3-logic-libraryproofs-simplify-first lib reduced nil nil)))
     (proof-proof-front proof reduced test))))

(defun t3-book-lambdas-record-facts (steps facts)
  (if (endp steps)
      facts
    (proof-with-checked-results ((literal (proof-step-first (car steps))))
      (t3-book-lambdas-record-facts (cdr steps) (table-put facts literal (car steps))))))

(defun t3-book-lambdas-pseudo-lambda-from-term (lib typed present excludes-quote nonsymbol target)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
     ((evidence (t3-logic-evidence-init lib nil (list present excludes-quote) nil))
      (original (t3-book-substitution-original-arguments lib typed evidence))
      (literal (proof-step-first typed))
      (source (t3-book-lambdas-inspect lib literal (list present excludes-quote nonsymbol (cadar original))))
      (fields (proof-proof-rewrite proof typed source '(1)))
      (fields (proof-proof-tidy proof fields))
      (components (t3-book-associations-components lib fields))
      (facts (t3-book-lambdas-record-facts components nil))
      (goal (t3-book-lambdas-inspect lib target nil))
      (right (proof-rewritten-term goal))
      (known (t3-book-lambdas-required lib right facts)))
     (proof-proof-transport proof known goal))))

(defun t3-book-lambdas-extract-lambda (lib name formula)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
     ((premise (proof-term-at formula 1))
      (accepted (proof-proof-assume proof premise t))
      (parts (t3-book-associations-components lib accepted))
      (parts (proof-list-of-length parts 3))
      (literal (proof-step-first (caddr parts)))
      (head (proof-term-at literal 1))
      (excludes-quote (t3-book-evaluators-quote-excluded lib head (caddr parts)))
      (nonsymbol (t3-book-lambdas-not-symbol lib (caddr parts)))
      (target (proof-term-at formula 2))
      (result (t3-book-lambdas-pseudo-lambda-from-term lib (car parts) (cadr parts) excludes-quote nonsymbol target))
      (step (t3-book-lemmas-implication lib formula result)))
     (proof-proof-entry "theorem" name (list name) (list step)))))

(defun t3-book-lambdas-open-application (lib target)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
     ((value (proof-term-at target 1))
      (equation (proof-proof-unfold proof target))
      (car-value (t3-logic-libraryproofs-constant lib (list *library-car* value)))
      (cdr-value (t3-logic-libraryproofs-constant lib (list *library-cdr* value))))
     (t3-book-spines-replace-value lib equation (list car-value cdr-value)))))

(defun t3-book-lambdas-construct-lambda (lib name formula)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
     ((premise (proof-term-at formula 1))
      (accepted (proof-proof-assume proof premise t))
      (parts (t3-book-associations-components lib accepted))
      (parts (proof-list-of-length parts 3))
      (typed (car parts))
      (literal (proof-step-first typed))
      (head (proof-term-at literal 1))
      (expanded (t3-book-lambdas-inspect lib literal nil))
      (fields (proof-proof-rewrite proof typed expanded '(1)))
      (fields (proof-proof-tidy proof fields))
      (components (t3-book-associations-components lib fields))
      (facts (t3-book-lambdas-record-facts (append components (list (caddr parts))) nil))
      (operator (t3-book-lambdas-present-operator lib head facts))
      (excludes-quote (t3-book-evaluators-quote-excluded lib head operator))
      (nonsymbol (t3-book-lambdas-not-symbol lib operator))
      (target (proof-term-at formula 2))
      (opened (t3-book-lambdas-open-application lib target))
      (right (proof-rewritten-term opened))
      (normalized (t3-book-spines-constructor-form lib right (list excludes-quote nonsymbol (cadr parts))
                                                  *t3-book-lambdas-definitions*))
      (goal (proof-proof-chain proof opened (list normalized)))
      (right (proof-rewritten-term goal))
      (required (t3-book-lambdas-required lib right facts))
      (result (proof-proof-transport proof required goal))
      (step (t3-book-lemmas-implication lib formula result)))
     (proof-proof-entry "theorem" name (list name) (list step)))))

(defund t3-book-lambdas-rewrite-check (lib value equation branch position)
  (if (not branch)
      equation
    (let ((proof (library-library-proof lib)))
      (proof-with-checked-results
       ((previous (or equation (proof-proof-reflexive proof value))))
       (proof-proof-rewrite proof previous branch (list 1 2 position))))))

(mutual-recursion
 (defun t3-book-lambdas-normalize-checks-run (n lib value evidence)
   (declare (xargs :measure (nfix n)))
   (if (zp n)
       '(:failure "fuel" "t3-book-lambdas-normalize-checks")
     (proof-with-checked-results
      ((equation (t3-logic-libraryproofs-normalize lib value evidence *t3-book-lambdas-definitions*))
       (current (if equation (proof-rewritten-term equation) value)))
      (if (not (proof-is-call current *proof-if*))
          equation
        (proof-with-checked-results
         ((equation (t3-book-lambdas-normalize-checks-branches
                     (1- n) lib value current evidence '(1 2 3) equation)))
         (and equation
              (proof-with-checked-results
               ((right (proof-rewritten-term equation))
                (normalized (t3-logic-libraryproofs-normalize lib right evidence *t3-book-lambdas-definitions*)))
               (proof-proof-chain (library-library-proof lib) equation (list normalized)))))))))
 (defun t3-book-lambdas-normalize-checks-branches (n lib value current evidence positions equation)
   (declare (xargs :measure (nfix n)))
   (cond
    ((zp n) '(:failure "fuel" "t3-book-lambdas-normalize-checks"))
    ((endp positions) equation)
    (t
     (let ((position (car positions)))
       (proof-with-checked-results
        ((branch (proof-term-at current position))
         (branch (t3-book-lambdas-normalize-checks-run (1- n) lib branch evidence))
         (equation (t3-book-lambdas-rewrite-check lib value equation branch position)))
        (t3-book-lambdas-normalize-checks-branches (1- n) lib value current
                                                   evidence (cdr positions) equation)))))))

(defun t3-book-lambdas-normalize-checks (lib value evidence)
  (t3-book-lambdas-normalize-checks-run 1000000 lib value evidence))

(defund t3-book-lambdas-conditional-proof-parts (lib step)
  (proof-with-checked-results ((literal (proof-step-first step)))
    (and (proof-is-call literal *proof-if*)
         (proof-with-checked-results ((no (proof-term-at literal 3)))
           (and (equal no *proof-false*) (proof-proof-conjunct (library-library-proof lib) step))))))

(defun t3-book-lambdas-conditions-run (n lib step)
  (declare (xargs :measure (nfix n)))
  (if (zp n)
      '(:failure "fuel" "t3-book-lambdas-conditions")
    (proof-with-checked-results ((parts (t3-book-lambdas-conditional-proof-parts lib step)))
      (if (not parts)
          (list step)
        (proof-with-checked-results
         ((first (t3-book-lambdas-conditions-run (1- n) lib (car parts)))
          (rest (t3-book-lambdas-conditions-run (1- n) lib (cadr parts))))
         (append first rest))))))

(defun t3-book-lambdas-conditions (lib proof)
  (t3-book-lambdas-conditions-run 1000000 lib proof))

(defun t3-book-lambdas-proper-length (lib)
  (let ((proof (library-library-proof lib))
        (proper (list *t3-book-lemmas-true-listp* *library-x*))
        (cons (list *proof-consp* *library-x*))
        (value (list *t3-book-lambdas-length* *library-x*)))
    (proof-with-checked-results
     ((known (proof-proof-assume proof proper t))
      (present (proof-proof-assume proof cons t))
      (absent (proof-proof-assume proof cons nil))
      (rule (proof-proof-fact proof "consp-not-stringp" nil))
      (different (proof-proof-modus-ponens proof rule present))
      (alternate (t3-book-spines-shallow lib proper (list absent)))
      (nil-case (proof-proof-rewrite proof known alternate '(1)))
      (nil-case (proof-proof-tidy proof nil-case))
      (nil-not-string (t3-logic-libraryproofs-prove-formula
                       lib (proof-neg (list *t3-book-lambdas-stringp* *proof-false*))
                       (list *proof-not*) nil))
      (nil-case (proof-proof-symmetric proof nil-case))
      (absent-type (proof-proof-rewrite proof nil-not-string nil-case '(1 1 1)))
      (yes (t3-book-spines-shallow lib value (list different)))
      (no (t3-book-spines-shallow lib value (list absent-type)))
      (step (proof-proof-cases proof cons yes no))
      (claim (proof-step-first step)))
     (library-library-lemma lib *t3-book-lambdas-proper-length* claim step (list (proof-neg proper))))))

(defun t3-book-lambdas-term-list-proper (lib proof)
  (let ((rules (library-library-proof lib)))
    (proof-with-checked-results
     ((literal (proof-step-first proof))
      (parts (proof-list-of-length literal 3))
      (type-rule (proof-proof-fact rules (proof-sym "TERM-LISTP-IMPLIES-PSEUDO-TERM-LISTP" "ACL2")
                                  (list (list *library-x* (cadr parts))
                                        (list *t3-book-lambdas-w* (caddr parts)))))
      (pseudo-types (proof-proof-modus-ponens rules type-rule proof))
      (proper-rule (library-library-axiom lib "PSEUDO-TERM-LISTP-FORWARD-TO-TRUE-LISTP" (list (cadr parts)))))
     (proof-proof-modus-ponens rules proper-rule pseudo-types))))

(defun t3-book-lambdas-arglist-proper (lib typed)
  (let ((rules (library-library-proof lib))
        (template (list *library-implies* (list *t3-book-lambdas-arglist* *library-x*)
                        (list *t3-book-lemmas-true-listp* *library-x*))))
    (proof-with-checked-results ((proof (t3-book-lemmas-implies-proper-list lib template nil)))
      (if (not proof)
          '(:failure "unsupported" "")
        (proof-with-checked-results
         ((literal (proof-step-first typed))
          (value (proof-term-at literal 1))
          (specialized (proof-proof-instantiate rules proof (list (list *library-x* value)))))
         (proof-proof-modus-ponens rules specialized typed))))))

(defun t3-book-lambdas-get-fact (facts literal)
  (let ((entry (assoc-equal literal facts)))
    (if entry
        (cdr entry)
      '(:failure "missing-proof-input" ""))))

(defun t3-book-lambdas-rewrite-fields (proof fields exact marker facts)
  (if (endp fields)
      facts
    (proof-with-checked-results
     ((literal (proof-step-first (car fields)))
      (step (proof-proof-rewrite-result proof (car fields) exact literal marker))
      (claim (proof-step-first step)))
     (t3-book-lambdas-rewrite-fields proof (cdr fields) exact marker (table-put facts claim step)))))

(defun t3-book-lambdas-extract-real-lambda (lib name formula)
  (proof-with-checked-results
   ((lib (t3-book-lambdas-proper-length lib))
    (proof (library-library-proof lib))
    (premise (proof-term-at formula 1))
    (accepted (proof-proof-assume proof premise t))
    (parts (t3-book-associations-components lib accepted))
    (parts (proof-list-of-length parts 3))
    (literal (proof-step-first (caddr parts)))
    (head (proof-term-at literal 1))
    (nonsymbol (t3-book-lambdas-not-symbol lib (caddr parts)))
    (excludes-quote (t3-book-evaluators-quote-excluded lib head (caddr parts)))
    (term (proof-step-first (car parts)))
    (opened (proof-proof-unfold proof term))
    (right (proof-rewritten-term opened))
    (normalized (t3-book-lambdas-normalize-checks lib right
                                                  (list (cadr parts) (caddr parts) nonsymbol excludes-quote)))
    (opened (proof-proof-chain proof opened (list normalized)))
    (typed (proof-proof-rewrite proof (car parts) opened '(1)))
    (typed (proof-proof-tidy proof typed))
    (fields (t3-book-lambdas-conditions lib typed))
    (facts (t3-book-lambdas-record-facts fields nil))
    (proper (t3-book-lambdas-get-fact facts (list *t3-book-lemmas-true-listp* head)))
    (exact (library-library-cite lib *t3-book-lambdas-proper-length* (list head) (list proper)))
    (literal (proof-step-first exact))
    (marker (proof-term-at literal 1))
    (facts (t3-book-lambdas-rewrite-fields proof fields exact marker facts))
    (target (proof-term-at formula 2))
    (goal (t3-book-lambdas-inspect lib target nil))
    (right (proof-rewritten-term goal))
    (required (t3-book-lambdas-required lib right facts))
    (result (proof-proof-transport proof required goal))
    (step (t3-book-lemmas-implication lib formula result))
    (entry (proof-proof-entry "theorem" name (list name) (list step))))
   (cons entry lib)))

(defun t3-book-lambdas-length-equalities (lib proper)
  (if (endp proper)
      nil
    (proof-with-checked-results
     ((literal (proof-step-first (car proper)))
      (value (proof-term-at literal 1))
      (equation (library-library-cite lib *t3-book-lambdas-proper-length* (list value) (list (car proper))))
      (rest (t3-book-lambdas-length-equalities lib (cdr proper))))
     (cons equation rest))))

(defun t3-book-lambdas-lengths-in-application (lib head arguments target source facts)
  (proof-with-checked-results ((operator (proof-term-at target 0)))
    (if (not (equal operator *t3-book-lambdas-real-term*))
        source
      (proof-with-checked-results
       ((args (list *library-car* (list *library-cdr* head)))
        (typed (t3-book-lambdas-get-fact facts (list *t3-book-lambdas-arglist* args)))
        (formal (t3-book-lambdas-arglist-proper lib typed))
        (listed (t3-book-lambdas-term-list-proper lib arguments))
        (head-type (t3-book-lambdas-get-fact facts (list *t3-book-lemmas-true-listp* head)))
        (equalities (t3-book-lambdas-length-equalities lib (list head-type formal listed))))
       (t3-book-spines-replace-value lib source equalities)))))

(defun t3-book-lambdas-application-with-lambda (lib typed arguments arity target)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
     ((literal (proof-step-first typed))
      (head (proof-term-at literal 1))
      (opened (t3-book-lambdas-inspect lib literal nil))
      (fields (proof-proof-rewrite proof typed opened '(1)))
      (fields (proof-proof-tidy proof fields))
      (conditions (t3-book-lambdas-conditions lib fields))
      (facts (t3-book-lambdas-record-facts (append conditions (list arity arguments)) nil))
      (operator (t3-book-lambdas-present-operator lib head facts))
      (literal (proof-step-first operator))
      (facts (table-put facts literal operator))
      (nonsymbol (t3-book-lambdas-not-symbol lib operator))
      (excludes-quote (t3-book-evaluators-quote-excluded lib head operator))
      (source (t3-book-lambdas-open-application lib target))
      (source (t3-book-lambdas-lengths-in-application lib head arguments target source facts))
      (right (proof-rewritten-term source))
      (normalized (t3-book-lambdas-normalize-checks lib right (list operator nonsymbol excludes-quote arguments)))
      (equation (proof-proof-chain proof source (list normalized)))
      (right (proof-rewritten-term equation))
      (required (t3-book-lambdas-required lib right facts)))
     (proof-proof-transport proof required equation))))

(defun t3-book-lambdas-construct-real-lambda (lib name formula)
  (proof-with-checked-results
   ((lib (t3-book-lambdas-proper-length lib))
    (premise (proof-term-at formula 1))
    (accepted (proof-proof-assume (library-library-proof lib) premise t))
    (parts (t3-book-associations-components lib accepted))
    (parts (proof-list-of-length parts 3))
    (target (proof-term-at formula 2))
    (proof (t3-book-lambdas-application-with-lambda lib (car parts) (cadr parts) (caddr parts) target))
    (step (t3-book-lemmas-implication lib formula proof))
    (entry (proof-proof-entry "theorem" name (list name) (list step))))
   (cons entry lib)))

(defund t3-book-lambdas-returned-boolean-leaf (value tests lib call earlier measure original substitutions)
  (let ((proof (library-library-proof lib)))
    (if (member-equal value (list *proof-true* *proof-false*))
        (proof-with-checked-results
         ((step (t3-logic-libraryproofs-prove lib (list *t3-book-lambdas-booleanp* value) nil
                                             (list *t3-book-lambdas-booleanp* (proof-cl "EQ")))))
         (cons step substitutions))
      (proof-with-checked-results ((head (proof-term-at value 0)))
        (let ((lemma (assoc-equal head earlier)))
          (cond
           (lemma
            (proof-with-checked-results ((step (library-library-cite lib (cdr lemma) (cdr value) nil)))
              (cons step substitutions)))
           ((or (not (proof-is-call value (car call))) (not (equal (cddr value) (cddr call))))
            '(:failure "unsupported" ""))
           (t
            (proof-with-checked-results ((child (proof-term-at value 1)))
              (let* ((existing (assoc-equal child substitutions))
                     (pairs (if existing (cdr existing) (list (list (cadr call) child))))
                     (substitutions (if existing substitutions (table-put substitutions child pairs)))
                     (child-measure (list *library-count* child)))
                (proof-with-checked-results
                 ((evidence (t3-logic-evidence-init lib tests nil nil))
                  (descent (t3-size-count-descent lib child-measure measure evidence))
                  (instance (proof-subst original (proof-bindings-table pairs nil)))
                  (hypothesis (proof-ite (list *proof-ordinal-less* child-measure measure) instance *proof-true*))
                  (hypothesis (proof-proof-assume proof hypothesis t))
                  (step (proof-proof-prove-if proof hypothesis (car descent))))
                 (cons step substitutions)))))))))))

(defun t3-book-lambdas-returned-boolean-leaves (requests lib call earlier measure original substitutions)
  (declare (xargs :measure (acl2-count requests)))
  (if (endp requests)
      (cons nil substitutions)
    (let* ((request (car requests))
           (result (t3-book-lambdas-returned-boolean-leaf (car request) (cadr request)
                                                          lib call earlier measure original substitutions)))
      (if (failure-p result)
          (cons (list (cons request result)) substitutions)
        (let ((rest (t3-book-lambdas-returned-boolean-leaves (cdr requests) lib call earlier
                                                            measure original (cdr result))))
          (cons (cons (cons request (car result)) (car rest)) (cdr rest)))))))

(defun t3-book-lambdas-returned-boolean (lib call earlier)
  (let ((proof (library-library-proof lib))
        (original (list *t3-book-lambdas-booleanp* call))
        (template (list *t3-book-lambdas-booleanp* *proof-result*)))
    (proof-with-checked-results
     ((variable (proof-term-at call 1))
      (measure (list *library-count* variable))
      (opened (proof-proof-unfold proof call))
      (right (proof-rewritten-term opened))
      (requests (t3-logic-libraryproofs-by-value-leaves lib right nil))
      (leaves (t3-book-lambdas-returned-boolean-leaves requests lib call earlier measure original nil))
      (returns (t3-logic-libraryproofs-by-value lib right template (car leaves) nil))
      (result (library-library-transport-argument lib returns opened 1)))
     (if (endp (cdr leaves))
         result
       (proof-with-checked-results ((ordinal (library-library-builtin lib 1 variable)))
         (proof-proof-induct proof ordinal result original measure (table-values (cdr leaves))))))))

(defun t3-book-lambdas-lambda-boolean (lib name formula)
  (let ((list-rule "T3-LOGIC-FNS-LISTP-BOOLEAN")
        (term-rule "T3-LOGIC-FNSP-BOOLEAN"))
    (proof-with-checked-results
     ((typed-list (t3-book-lambdas-returned-boolean lib (list *t3-book-lambdas-logic-list* *library-x* *library-y*) nil))
      (claim (proof-step-first typed-list))
      (lib (library-library-lemma lib list-rule claim typed-list nil))
      (typed-term (t3-book-lambdas-returned-boolean lib (list *t3-book-lambdas-logic-fns* *library-x* *library-y*)
                                                   (list (cons *t3-book-lambdas-logic-list* list-rule))))
      (claim (proof-step-first typed-term))
      (lib (library-library-lemma lib term-rule claim typed-term nil))
      (proof (library-library-proof lib))
      (beta (proof-proof-beta proof formula))
      (right (proof-rewritten-term beta))
      (term (proof-term-at right 1))
      (head (t3-book-spines-shallow lib term nil))
      (right (proof-rewritten-term head))
      (result (library-library-cite lib term-rule (cdr right) nil))
      (result (library-library-transport-argument lib result head 1))
      (result (proof-proof-transport proof result beta))
      (entry (proof-proof-entry "theorem" name (list name) (list result))))
     (cons entry lib))))
