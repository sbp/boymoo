(in-package "BOYMOO-PROVER")
(set-verify-guards-eagerness 0)

(defconst *t3-book-halves-aux* (proof-sym "HALVE-LIST-AUX" "SET"))
(defconst *t3-book-halves-halve* (proof-sym "HALVE-LIST$INLINE" "SET"))
(defconst *t3-book-halves-mv-nth* (proof-sym "MV-NTH" "ACL2"))
(defconst *t3-book-halves-zp* (proof-sym "ZP" "ACL2"))

(defun t3-book-halves-length-cons (lib value cons-step)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
     ((opened (proof-proof-unfold proof (list *library-len* value)))
      (first (proof-step-first opened))
      (body (proof-term-at first 2))
      (selected (if cons-step
                    (proof-proof-select proof body cons-step)
                  (t3-logic-libraryproofs-normalize lib body nil nil))))
     (proof-proof-chain proof opened (list selected)))))

(defun t3-book-halves-length-weak (lib)
  (let* ((proof (library-library-proof lib))
         (whole (list *library-len* *library-x*))
         (tail (list *library-len* (list *library-cdr* *library-x*)))
         (test (list *proof-consp* *library-x*)))
    (proof-with-checked-results
     ((cons-step (proof-proof-assume proof test t))
      (evidence (t3-logic-evidence-init lib nil (list cons-step) nil))
      (strict (t3-size-length-tail lib *library-x* evidence))
      (yes (library-library-as-weak lib (car strict)))
      (atom-step (proof-proof-assume proof test nil))
      (completion (library-library-axiom lib "COMPLETION-OF-CDR" (list *library-x*)))
      (first (proof-step-first completion))
      (body (proof-term-at first 2))
      (selected (proof-proof-select proof body atom-step))
      (cdr-nil (proof-proof-chain proof completion (list selected)))
      (last (proof-proof-reflexive proof tail))
      (last (proof-proof-rewrite proof last cdr-nil '(1 2 1)))
      (empty-length (t3-logic-libraryproofs-simplify lib (list *library-len* *proof-false*) nil
                                                   (list *library-len*)))
      (last (proof-proof-chain proof last (list empty-length)))
      (first (t3-logic-libraryproofs-simplify lib whole (list atom-step) (list *library-len*)))
      (zero-type (t3-logic-libraryproofs-type-of lib *proof-zero* nil))
      (no (library-library-cite lib "WEAK-REFLEXIVE" (list *proof-zero*) (list zero-type)))
      (first (proof-proof-symmetric proof first))
      (no (proof-proof-rewrite proof no first '(1 1 1)))
      (last (proof-proof-symmetric proof last))
      (no (proof-proof-rewrite proof no last '(1 1 2)))
      (no (proof-proof-tidy proof no))
      (result (proof-proof-cases proof test yes no)))
     (library-library-lemma lib "T3-LEN-CDR-WEAK" (library-le tail whole) result nil))))

(defun t3-book-halves-split-bound-terminal (lib value index fixed-index)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
     ((selector (t3-logic-libraryproofs-normalize
                 lib (list *t3-book-halves-mv-nth* fixed-index value) nil
                 (list *t3-book-halves-mv-nth* *t3-book-halves-zp* *t3-logic-atom* *proof-not*)))
      (first (if selector (proof-step-first selector)
               '(:failure "failure" "")))
      (selected (proof-term-at first 2))
      (lower (list *library-len* selected))
      (bound
       (if (and index (not (equal index 0)))
           (proof-with-checked-results
            ((lower-type (t3-logic-libraryproofs-type-of lib lower nil)))
            (library-library-cite lib "WEAK-REFLEXIVE" (list lower) (list lower-type)))
         (let ((tail (list *library-len* (list *library-cdr* *library-x*))))
           (proof-with-checked-results
            ((natural (t3-logic-libraryproofs-natural lib tail))
             (nonnegative (library-library-cite lib "NATURAL-NONNEGATIVE" (list tail)
                                                (list natural))))
            (t3-size-sum-at-least lib lower nonnegative nil t)))))
      (reversed (proof-proof-symmetric proof selector))
      (result (proof-proof-rewrite proof bound reversed '(1 1 2 1))))
     (proof-proof-tidy proof result))))

(defun t3-book-halves-split-bound-progress (lib next-fast added evidence)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
     ((weak (library-library-cite lib "T3-LEN-CDR-WEAK" (list next-fast) nil))
      (progress (t3-size-shift lib weak (list *library-len* added) t nil))
      (fresh (t3-book-halves-length-cons lib added nil))
      (progress (proof-proof-rewrite proof progress fresh '(1 1 1 1)))
      (expressed (library-plus (list *library-len* *library-z*)
                               (library-plus *proof-one* (list *library-len* next-fast))))
      (first (proof-step-first progress))
      (inner (proof-term-at first 1))
      (left (proof-term-at inner 1))
      (identity (library-library-linear-equal lib left expressed nil))
      (progress (proof-proof-rewrite proof progress identity '(1 1 1)))
      (tail (list *library-cdr* *library-x*))
      (cons-step (t3-logic-evidence-require evidence (list *proof-consp* tail)))
      (tail (t3-book-halves-length-cons lib tail (car cons-step)))
      (reversed (proof-proof-symmetric proof tail))
      (result (proof-proof-rewrite proof progress reversed '(1 1 1 2))))
     (proof-proof-tidy proof result))))

(defun t3-book-halves-split-bound-leaf (value tests lib index fixed-index measure
                                            next-fast added formula pairs)
  (proof-with-checked-results
   ((head (proof-term-at value 0)))
   (if (not (equal head *t3-book-halves-aux*))
       (t3-book-halves-split-bound-terminal lib value index fixed-index)
     (let ((proof (library-library-proof lib))
           (reduced-measure (list *library-count* next-fast)))
       (proof-with-checked-results
        ((evidence (t3-logic-evidence-init lib tests nil nil))
         (descent (t3-size-count-descent lib reduced-measure measure evidence))
         (statement (proof-subst formula (proof-bindings-table pairs nil)))
         (guarded (proof-ite (list *proof-ordinal-less* reduced-measure measure)
                             statement *proof-true*))
         (hypothesis (proof-proof-assume proof guarded t))
         (induction (proof-proof-prove-if proof hypothesis (car descent)))
         (progress (if (and index (not (equal index 0)))
                       (library-library-cite lib "T3-LEN-CDR-WEAK" (list *library-y*) nil)
                     (t3-book-halves-split-bound-progress lib next-fast added (cdr descent)))))
        (t3-size-chain lib induction progress nil))))))

(defun t3-book-halves-split-bound-leaves (requests lib index fixed-index measure
                                                 next-fast added formula pairs)
  (if (endp requests)
      nil
    (let* ((request (car requests))
           (step (t3-book-halves-split-bound-leaf (car request) (cadr request) lib index
                                                 fixed-index measure next-fast added formula pairs)))
      (cons (cons request step)
            (if (failure-p step)
                nil
              (t3-book-halves-split-bound-leaves (cdr requests) lib index fixed-index measure
                                                 next-fast added formula pairs))))))

(defun t3-book-halves-split-bound (lib index)
  (let* ((proof (library-library-proof lib))
         (split (list *t3-book-halves-aux* *library-y* *library-x* *library-z*))
         (tail (list *library-cdr* *library-x*))
         (next-fast (list *library-cdr* tail))
         (next-slow (list *library-cdr* *library-y*))
         (added (list *proof-cons* (list *library-car* *library-y*) *library-z*))
         (pairs (list (list *library-x* next-fast) (list *library-y* next-slow)
                      (list *library-z* added)))
         (measure (list *library-count* *library-x*))
         (fixed-index (proof-quote index))
         (view (list *library-len* (list *t3-book-halves-mv-nth* fixed-index *proof-result*)))
         (upper (if (and index (not (equal index 0)))
                    (list *library-len* *library-y*)
                  (library-plus (list *library-len* *library-z*) (list *library-len* tail))))
         (template (library-le view upper)))
    (proof-with-checked-results
     ((formula (proof-subst template (list (cons *proof-result* split))))
      (opened (proof-proof-unfold proof split))
      (first (proof-step-first opened))
      (body (proof-term-at first 2))
      (requests (t3-logic-libraryproofs-by-value-leaves lib body nil))
      (leaves (t3-book-halves-split-bound-leaves requests lib index fixed-index measure
                                               next-fast added formula pairs))
      (cases (t3-logic-libraryproofs-by-value lib body template leaves nil))
      (reversed (proof-proof-symmetric proof opened))
      (cases (proof-proof-rewrite-result proof cases reversed template *proof-result*))
      (ordinal (library-library-builtin lib 1 *library-x*))
      (result (proof-proof-induct proof ordinal cases formula measure (list pairs))))
     (library-library-lemma lib (concatenate 'string "T3-HALVE-BOUND-" (decimal-text index))
                            formula result nil))))

(defun t3-book-halves-public-bound (lib index opened cons-step tail-cons)
  (let ((proof (library-library-proof lib)))
    (if (equal index 0)
        (let ((tail-length (list *library-len* (list *library-cdr* *library-x*))))
          (proof-with-checked-results
           ((bound (library-library-cite lib "T3-HALVE-BOUND-0"
                                         (list *library-x* *library-x* *proof-false*) nil))
            (zero (t3-logic-libraryproofs-simplify lib (list *library-len* *proof-false*) nil
                                                 (list *library-len*)))
            (upper (proof-proof-rewrite proof bound zero '(1 1 1 1)))
            (length-type (t3-logic-libraryproofs-type-of lib tail-length nil))
            (simpler (library-library-cite lib "ADD-ZERO-LEFT" (list tail-length)
                                           (list length-type)))
            (bound (proof-proof-rewrite proof upper simpler '(1 1 1)))
            (bound (proof-proof-tidy proof bound)))
           (cons bound opened)))
      (proof-with-checked-results
       ((first (proof-step-first opened))
        (right (proof-term-at first 2))
        (second (proof-proof-unfold proof right))
        (first (proof-step-first second))
        (right (proof-term-at first 2))
        (branch (t3-logic-libraryproofs-normalize lib right (list cons-step tail-cons)
                                                  (list *t3-logic-atom* *proof-not*)))
        (equivalent (proof-proof-chain proof opened (list second branch)))
        (first (proof-step-first equivalent))
        (right (proof-term-at first 2))
        (args (proof-list-of-length right 4))
        (bound (library-library-cite lib "T3-HALVE-BOUND-1"
                                      (list (caddr args) (cadr args) (cadddr args)) nil)))
       (cons bound equivalent)))))

(defun t3-book-halves-public-lemma (lib index opened cons-step tail-cons decrease cons-test tail-test)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
     ((bound (t3-book-halves-public-bound lib index opened cons-step tail-cons))
      (result (t3-size-chain lib (car bound) decrease nil))
      (reversed (proof-proof-symmetric proof (cdr bound)))
      (result (proof-proof-rewrite proof result reversed '(1 1 1 2)))
      (result (proof-proof-tidy proof result))
      (goal (library-lt (list *library-len*
                              (list *t3-book-halves-mv-nth* (proof-quote index)
                                    (list *t3-book-halves-halve* *library-x*)))
                        (list *library-len* *library-x*))))
     (library-library-lemma lib (concatenate 'string "T3-HALVE-LESS-" (decimal-text index))
                            goal result (list (proof-neg cons-test) (proof-neg tail-test))))))

(defun t3-book-halves-halves (lib)
  (proof-with-checked-results
   ((lib (t3-book-halves-length-weak lib))
    (lib (t3-book-halves-split-bound lib 0))
    (lib (t3-book-halves-split-bound lib 1))
    (proof (library-library-proof lib))
    (opened (proof-proof-unfold proof (list *t3-book-halves-halve* *library-x*)))
    (cons-test (list *proof-consp* *library-x*))
    (tail-test (list *proof-consp* (list *library-cdr* *library-x*)))
    (cons-step (proof-proof-assume proof cons-test t))
    (tail-cons (proof-proof-assume proof tail-test t))
    (evidence (t3-logic-evidence-init lib nil (list cons-step) nil))
    (decrease (t3-size-length-tail lib *library-x* evidence))
    (lib (t3-book-halves-public-lemma lib 0 opened cons-step tail-cons (car decrease)
                                     cons-test tail-test)))
   (t3-book-halves-public-lemma lib 1 opened cons-step tail-cons (car decrease) cons-test tail-test)))
