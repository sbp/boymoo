(in-package "BOYMOO-PROVER")
(set-verify-guards-eagerness 0)

(defconst *t3-book-defpun-step* (proof-sym "DEFPUN-ST" "ACL2"))
(defconst *t3-book-defpun-test* (proof-sym "DEFPUN-TEST" "ACL2"))
(defconst *t3-book-defpun-base* (proof-sym "DEFPUN-BASE" "ACL2"))
(defconst *t3-book-defpun-iterate* (proof-sym "DEFPUN-STN" "ACL2"))
(defconst *t3-book-defpun-bounded* (proof-sym "DEFPUN-FN" "ACL2"))
(defconst *t3-book-defpun-result* (proof-sym "DEFPUN-F" "ACL2"))
(defconst *t3-book-defpun-choose* (proof-sym "FCH" "ACL2"))
(defconst *t3-book-defpun-n* (proof-sym "N" "ACL2"))
(defconst *t3-book-defpun-m* (proof-sym "M" "ACL2"))
(defconst *t3-book-defpun-agreement* (proof-sym "SELF-T3-DEFPUN-BOUND-AGREEMENT" "ACL2"))

(defun t3-book-defpun-iteration-test (state-term clock)
  (list *t3-book-defpun-test* (list *t3-book-defpun-iterate* state-term clock)))

(defun t3-book-defpun-open-under (lib call evidence)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((opened (proof-proof-unfold proof call))
         (body (proof-rewritten-term opened))
         (normalized (t3-logic-libraryproofs-normalize lib body evidence nil)))
      (proof-proof-chain proof opened (list normalized)))))

(defun t3-book-defpun-conjunction (lib first second)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((left (proof-step-first first))
         (right (proof-step-first second))
         (selected (proof-proof-select proof (proof-ite left right *proof-false*) first)))
      (proof-proof-transport proof second selected))))

(defun t3-book-defpun-terminal-result (lib state-term clock stopped)
  (let ((proof (library-library-proof lib))
        (test (list *t3-logic-zp* clock))
        (call (list *t3-book-defpun-bounded* state-term clock)))
    (proof-with-checked-results
        ((zero (proof-proof-assume proof test t))
         (yes (t3-book-defpun-open-under lib call (list stopped zero)))
         (positive (proof-proof-assume proof test nil))
         (no (t3-book-defpun-open-under lib call (list stopped positive))))
      (proof-proof-cases proof test yes no))))

(defun t3-book-defpun-impossible (lib contradiction goal)
  (proof-proof-subsume (library-library-proof lib) contradiction
                      (proof-unique (cons goal (proof-step-clause contradiction)))))

(defun t3-book-defpun-agreement-zero (clock step lib x waiting goal)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((zero (proof-proof-assume proof (list *t3-logic-zp* clock) t))
         (opened (t3-book-defpun-open-under lib (list *t3-book-defpun-iterate* x clock)
                                            (list zero)))
         (rewritten (proof-proof-rewrite proof step opened '(1 1)))
         (actual (proof-proof-tidy proof rewritten))
         (contradiction (proof-proof-cut proof actual waiting)))
      (t3-book-defpun-impossible lib contradiction goal))))

(defun t3-book-defpun-agreement-forward (clock reached-at positive lib x)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((opened (t3-book-defpun-open-under lib (list *t3-book-defpun-iterate* x clock)
                                            (list positive)))
         (rewritten (proof-proof-rewrite proof reached-at opened '(1 1))))
      (proof-proof-tidy proof rewritten))))

(defun t3-book-defpun-agreement (lib)
  (let* ((proof (library-library-proof lib))
         (x *library-x*)
         (n *t3-book-defpun-n*)
         (m *t3-book-defpun-m*)
         (left (list *t3-book-defpun-bounded* x n))
         (right (list *t3-book-defpun-bounded* x m))
         (both-stop (proof-ite (t3-book-defpun-iteration-test x n)
                               (t3-book-defpun-iteration-test x m)
                               *proof-false*))
         (goal (proof-eq left right))
         (formula (list *library-implies* both-stop goal))
         (test (list *t3-book-defpun-test* x))
         (zp-n (list *t3-logic-zp* n))
         (zp-m (list *t3-logic-zp* m)))
    (proof-with-checked-results
        ((assumed (proof-proof-assume proof both-stop t))
         (stopping (proof-proof-conjunct proof assumed))
         (reached (proof-proof-assume proof test t))
         (waiting (proof-proof-assume proof test nil))
         (terminal-left (t3-book-defpun-terminal-result lib x n reached))
         (terminal-right (t3-book-defpun-terminal-result lib x m reached))
         (reversed (proof-proof-symmetric proof terminal-right))
         (yes (proof-proof-chain proof terminal-left (list reversed)))
         (positive-n (proof-proof-assume proof zp-n nil))
         (positive-m (proof-proof-assume proof zp-m nil)))
      (let* ((next-arguments (list (list *t3-book-defpun-step* x)
                       (library-plus *proof-neg-one* n)
                       (library-plus *proof-neg-one* m)))
             (pairs (seq-zip (list x n m) next-arguments))
             (measure (list *library-count* n))
             (smaller (list *proof-ordinal-less* (list *library-count* (cadr next-arguments)) measure)))
        (proof-with-checked-results
            ((substituted (proof-subst formula (proof-bindings-table pairs nil)))
             (condition (proof-proof-assume proof (proof-ite smaller substituted *proof-true*) t))
             (decrease (library-library-builtin lib 9 n))
             (induction (proof-proof-prove-if proof condition decrease))
             (left-forward (t3-book-defpun-agreement-forward n (car stopping) positive-n lib x))
             (right-forward (t3-book-defpun-agreement-forward m (cadr stopping) positive-m lib x))
             (following (t3-book-defpun-conjunction lib left-forward right-forward))
             (computed-left (t3-book-defpun-open-under lib left (list waiting positive-n)))
             (computed-right (t3-book-defpun-open-under lib right (list waiting positive-m)))
             (next-value (proof-proof-modus-ponens proof induction following))
             (reversed (proof-proof-symmetric proof computed-right))
             (step (proof-proof-chain proof computed-left (list next-value reversed)))
             (zero-n (t3-book-defpun-agreement-zero n (car stopping) lib x waiting goal))
             (zero-m (t3-book-defpun-agreement-zero m (cadr stopping) lib x waiting goal))
             (case-m (proof-proof-cases proof zp-m zero-m step))
             (case-n (proof-proof-cases proof zp-n zero-n case-m))
             (case-proof (proof-proof-cases proof test yes case-n))
             (ordinal (library-library-builtin lib 1 n))
             (consequent (t3-book-lemmas-implication lib formula case-proof))
             (concluded (proof-proof-induct proof ordinal consequent formula measure (list pairs))))
          (library-library-lemma lib "T3-DEFPUN-BOUND-AGREEMENT" formula concluded nil))))))

(defun t3-book-defpun-chosen (lib state-term clock stops)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((choice (proof-proof-fact proof *t3-book-defpun-choose*
                                  (list (list *library-x* state-term) (list *t3-book-defpun-n* clock)))))
      (proof-proof-modus-ponens proof choice stops))))

(defun t3-book-defpun-preceding-clock (lib state-term clock later positive)
  (let* ((proof (library-library-proof lib))
         (test (list *t3-logic-zp* clock)))
    (if (not positive)
        (proof-with-checked-results
            ((current (t3-logic-libraryproofs-normalize
                       lib (list *t3-book-defpun-iterate* state-term *proof-one*) nil
                       (list *t3-book-defpun-iterate* *t3-logic-zp* *proof-not*)))
             (zero (proof-proof-assume proof test t))
             (following (t3-book-defpun-open-under
                        lib (list *t3-book-defpun-iterate* (list *t3-book-defpun-step* state-term)
                                  clock)
                        (list zero)))
             (reversed (proof-proof-symmetric proof following))
             (equation (proof-proof-chain proof current (list reversed)))
             (stops (library-library-transport-argument lib later equation 1)))
          (t3-book-defpun-chosen lib state-term *proof-one* stops))
      (proof-with-checked-results
          ((evidence (t3-logic-evidence-init lib (list (list test nil)) nil (list *t3-logic-zp*)))
           (number-and-evidence (t3-logic-evidence-integer evidence clock)))
        (let ((number (car number-and-evidence))
              (evidence (cdr number-and-evidence))
              (advanced (library-plus *proof-one* clock)))
          (proof-with-checked-results
              ((is-integer (t3-logic-libraryproofs-type-of lib advanced (list number)))
               (below (t3-arithmetic-integer-comparison lib *proof-zero* advanced evidence))
               (not-zero (t3-logic-libraryproofs-prove
                          lib (proof-neg (list *t3-logic-zp* advanced))
                          (list is-integer (car below)) (list *t3-logic-zp* *proof-not*)))
               (opened (t3-book-defpun-open-under lib (list *t3-book-defpun-iterate* state-term advanced)
                                                  (list not-zero)))
               (same (library-library-linear-equal
                      lib (library-plus *proof-neg-one* advanced) clock (list number)))
               (rewritten (proof-proof-rewrite proof opened same '(1 2 2)))
               (equation (proof-proof-tidy proof rewritten))
               (stops (library-library-transport-argument lib later equation 1)))
            (t3-book-defpun-chosen lib state-term advanced stops)))))))

(defun t3-book-defpun-recursion-equation (state-term)
  (proof-eq (list *t3-book-defpun-result* state-term)
            (proof-ite (list *t3-book-defpun-test* state-term)
                       (list *t3-book-defpun-base* state-term)
                       (list *t3-book-defpun-result* (list *t3-book-defpun-step* state-term)))))

(defun t3-book-defpun-defpun (lib name formula)
  (proof-with-checked-results
      ((parts (proof-list-of-length formula 3))
       (before-parts (proof-list-of-length (cadr parts) 2))
       (branches (proof-list-of-length (caddr parts) 4))
       (following (proof-term-at (cadddr branches) 1))
       (lib (t3-book-defpun-agreement lib)))
    (let* ((before (cadr parts))
           (rhs (caddr parts))
           (x (cadr before-parts))
           (test (cadr branches))
           (after (cadddr branches))
           (proof (library-library-proof lib))
           (n (list *t3-book-defpun-choose* x))
           (m (list *t3-book-defpun-choose* following))
           (now (t3-book-defpun-iteration-test x n))
           (then (t3-book-defpun-iteration-test following m)))
      (proof-with-checked-results
          ((stop (proof-proof-assume proof test t))
           (wait (proof-proof-assume proof test nil))
           (zero (t3-logic-libraryproofs-normalize
                  lib (list *t3-book-defpun-iterate* x *proof-zero*) nil
                  (list *t3-book-defpun-iterate* *t3-logic-zp* *proof-not*)))
           (stops (library-library-transport-argument lib stop zero 1))
           (valid (t3-book-defpun-chosen lib x *proof-zero* stops))
           (started (t3-book-defpun-open-under lib before (list valid)))
           (terminal (t3-book-defpun-terminal-result lib x n stop))
           (true-branch (proof-proof-if-true proof rhs))
           (reversed (proof-proof-symmetric proof true-branch))
           (finished (proof-proof-chain proof started (list terminal reversed)))
           (stopping-now (proof-proof-assume proof now t))
           (assumed-zero (proof-proof-assume proof (list *t3-logic-zp* n) t))
           (zero-n (t3-book-defpun-open-under lib (list *t3-book-defpun-iterate* x n)
                                             (list assumed-zero)))
           (rewritten (proof-proof-rewrite proof stopping-now zero-n '(1 1)))
           (false-stop (proof-proof-tidy proof rewritten))
           (contradiction (proof-proof-cut proof false-stop wait))
           (positive (proof-proof-front proof contradiction (proof-neg (list *t3-logic-zp* n)))))
        (let ((n-minus (library-plus *proof-neg-one* n)))
          (proof-with-checked-results
              ((next-time (t3-book-defpun-open-under lib (list *t3-book-defpun-iterate* x n)
                                                    (list positive)))
               (rewritten (proof-proof-rewrite proof stopping-now next-time '(1 1)))
               (proves-next (proof-proof-tidy proof rewritten))
               (valid-next (t3-book-defpun-chosen lib following n-minus proves-next))
               (agreement-at-next (proof-proof-fact
                                   proof *t3-book-defpun-agreement*
                                   (list (list *library-x* following)
                                         (list *t3-book-defpun-n* n-minus)
                                         (list *t3-book-defpun-m* m))))
               (both-stop (t3-book-defpun-conjunction lib proves-next valid-next))
               (same (proof-proof-modus-ponens proof agreement-at-next both-stop))
               (left-start (t3-book-defpun-open-under lib before (list stopping-now)))
               (left-next (t3-book-defpun-open-under lib (list *t3-book-defpun-bounded* x n)
                                                    (list wait positive)))
               (left (proof-proof-chain proof left-start (list left-next)))
               (right-start (proof-proof-if-false proof rhs))
               (right-next (t3-book-defpun-open-under lib after (list valid-next)))
               (right (proof-proof-chain proof right-start (list right-next)))
               (reversed (proof-proof-symmetric proof right))
               (progresses (proof-proof-chain proof left (list same reversed)))
               (not-now (proof-proof-assume proof now nil))
               (not-then (proof-proof-assume proof then nil))
               (left (t3-book-defpun-open-under lib before (list not-now)))
               (false-branch (proof-proof-if-false proof rhs))
               (right (t3-book-defpun-open-under lib after (list not-then)))
               (right (proof-proof-chain proof false-branch (list right)))
               (reversed (proof-proof-symmetric proof right))
               (no-result (proof-proof-chain proof left (list reversed)))
               (later (proof-proof-assume proof then t))
               (zero (t3-book-defpun-preceding-clock lib x m later nil))
               (nonzero (t3-book-defpun-preceding-clock lib x m later t))
               (exists-now (proof-proof-cases proof (list *t3-logic-zp* m) zero nonzero))
               (contradiction (proof-proof-cut proof exists-now not-now))
               (impossible-case (t3-book-defpun-impossible lib contradiction formula))
               (then-case (proof-proof-cases proof then impossible-case no-result))
               (waits (proof-proof-cases proof now progresses then-case))
               (concluded (proof-proof-cases proof test finished waits))
               (entry (proof-proof-entry "theorem" name (list name) (list concluded))))
            (cons entry lib)))))))
