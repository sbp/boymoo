(in-package "BOYMOO-PROVER")
(set-verify-guards-eagerness 0)

(defconst *t3-book-term-order-order* (proof-sym "TERM-ORDER" "ACL2"))
(defconst *t3-book-term-order-lexorder* (proof-sym "LEXORDER" "ACL2"))
(defconst *t3-book-term-order-laws* '("REFLEXIVE" "ANTI-SYMMETRIC" "TRANSITIVE" "TOTAL"))

(defun t3-book-term-order-call (lib law args)
  (proof-proof-fact (library-library-proof lib)
                    (proof-sym (concatenate 'string "SELF-T3-TERM-ORDER-" law) "ACL2")
                    (seq-zip (list *library-x* *library-y* *library-z*) args)))

(defun t3-book-term-order-number-chain (lib left right)
  (proof-with-checked-results
   ((left-term (proof-step-first left))
    (right-term (proof-step-first right)))
   (let ((strict-left (proof-is-call left-term *proof-less*))
         (strict-right (proof-is-call right-term *proof-less*)))
     (proof-with-checked-results
      ((left-comparison (if strict-left left-term (proof-term-at left-term 1)))
       (left-args (proof-list-of-length (cdr left-comparison) 2))
       (right-comparison (if strict-right right-term (proof-term-at right-term 1)))
       (right-args (proof-list-of-length (cdr right-comparison) 2)))
      (library-library-cite
       lib
       (cond (strict-left "T3-OBJECT-LESS-THEN-WEAK")
             (strict-right "T3-OBJECT-WEAK-THEN-LESS")
             (t "T3-OBJECT-WEAK-TRANSITIVE"))
       (list (if strict-left (car left-args) (cadr left-args))
             (if strict-left (cadr left-args) (car left-args))
             (if strict-right (cadr right-args) (car right-args)))
       (list left right))))))

(defun t3-book-term-order-lexicographic-layer-init (lib key relation prefix following-prefix)
  (list :t3-lexicographic-layer lib key relation prefix following-prefix))

(defun t3-book-term-order-lexicographic-layer-lib (layer)
  (cadr layer))

(defun t3-book-term-order-lexicographic-layer-key (layer)
  (caddr layer))

(defun t3-book-term-order-lexicographic-layer-relation (layer)
  (cadddr layer))

(defun t3-book-term-order-lexicographic-layer-prefix (layer)
  (nth 4 layer))

(defun t3-book-term-order-lexicographic-layer-following-prefix (layer)
  (nth 5 layer))

(defun t3-book-term-order-lexicographic-layer-leading (layer x y)
  (let ((key (t3-book-term-order-lexicographic-layer-key layer)))
    (library-lt (list key x) (list key y))))

(defun t3-book-term-order-lexicographic-layer-equation (layer x y evidence)
  (let ((lib (t3-book-term-order-lexicographic-layer-lib layer))
        (relation (t3-book-term-order-lexicographic-layer-relation layer)))
    (proof-with-checked-results
     ((opened (proof-proof-unfold (library-library-proof lib) (list relation x y))))
     (t3-book-numeric-order-select lib opened evidence))))

(defun t3-book-term-order-lexicographic-layer-tail (layer law args)
  (let ((lib (t3-book-term-order-lexicographic-layer-lib layer))
        (prefix (t3-book-term-order-lexicographic-layer-following-prefix layer)))
    (proof-proof-fact (library-library-proof lib)
                      (proof-sym (concatenate 'string prefix law) "ACL2")
                      (seq-zip (list *library-x* *library-y* *library-z*) args))))

(defun t3-book-term-order-lexicographic-layer-anti-less (layer strict)
  (proof-with-checked-results ((literal (proof-step-first strict)))
    (library-library-cite (t3-book-term-order-lexicographic-layer-lib layer)
                          "T3-OBJECT-LESS-TO-WEAK" (cdr literal) (list strict))))

(defun t3-book-term-order-lexicographic-layer-weak-bound (layer before x y)
  (let ((proof (library-library-proof (t3-book-term-order-lexicographic-layer-lib layer))))
    (proof-with-checked-results
     ((strict (proof-proof-assume proof (t3-book-term-order-lexicographic-layer-leading layer y x) t))
      (weak (t3-book-term-order-lexicographic-layer-anti-less layer strict))
      (failed (t3-book-term-order-lexicographic-layer-equation layer x y (list weak strict)))
      (contradiction (proof-proof-rewrite proof before failed '(1)))
      (contradiction (proof-proof-tidy proof contradiction))
      (strict-term (proof-step-first strict)))
     (proof-proof-front proof contradiction (proof-neg strict-term)))))

(defun t3-book-term-order-lexicographic-layer-antisymmetry (layer)
  (let* ((lib (t3-book-term-order-lexicographic-layer-lib layer))
         (proof (library-library-proof lib))
         (relation (t3-book-term-order-lexicographic-layer-relation layer))
         (x *library-x*)
         (y *library-y*)
         (a (list relation x y))
         (b (list relation y x))
         (goal (proof-eq x y))
         (guard (proof-ite a b *proof-false*)))
    (proof-with-checked-results
     ((assumed (proof-proof-assume proof guard t))
      (parts (proof-proof-conjunct proof assumed))
      (forward (t3-book-term-order-lexicographic-layer-leading layer x y))
      (backward (t3-book-term-order-lexicographic-layer-leading layer y x))
      (x-less (proof-proof-assume proof forward t))
      (y-less (proof-proof-assume proof backward t))
      (x-not (proof-proof-assume proof forward nil))
      (y-not (proof-proof-assume proof backward nil))
      (x-weak (t3-book-term-order-lexicographic-layer-anti-less layer x-less))
      (failed-yx (t3-book-term-order-lexicographic-layer-equation layer y x (list x-weak x-less)))
      (y-weak (t3-book-term-order-lexicographic-layer-anti-less layer y-less))
      (failed-xy (t3-book-term-order-lexicographic-layer-equation layer x y (list y-weak y-less)))
      (first (proof-proof-rewrite proof (cadr parts) failed-yx '(1)))
      (first (proof-proof-tidy proof first))
      (first (t3-book-permutations-consequence lib first goal))
      (second (proof-proof-rewrite proof (car parts) failed-xy '(1)))
      (second (proof-proof-tidy proof second))
      (second (t3-book-permutations-consequence lib second goal))
      (p (t3-book-term-order-lexicographic-layer-equation layer x y (list x-not y-not)))
      (p (proof-proof-rewrite proof (car parts) p '(1)))
      (p (proof-proof-tidy proof p))
      (q (t3-book-term-order-lexicographic-layer-equation layer y x (list y-not x-not)))
      (q (proof-proof-rewrite proof (cadr parts) q '(1)))
      (q (proof-proof-tidy proof q))
      (tail (t3-book-term-order-lexicographic-layer-tail layer "ANTI-SYMMETRIC" (list x y)))
      (both (t3-book-permutations-conjunction lib p q))
      (tied (proof-proof-modus-ponens proof tail both))
      (case-proof (proof-proof-cases proof backward second tied))
      (case-proof (proof-proof-cases proof forward first case-proof)))
     (t3-book-lemmas-implication lib (list *library-implies* guard goal) case-proof))))

(defun t3-book-term-order-lexicographic-layer-transitivity-strict (proof layer)
  (let ((lib (t3-book-term-order-lexicographic-layer-lib layer)))
    (proof-with-checked-results
     ((equation (t3-book-term-order-lexicographic-layer-equation
                 layer *library-x* *library-z* (list proof))))
     (proof-proof-true-from-eq (library-library-proof lib) equation))))

(defun t3-book-term-order-lexicographic-layer-transitivity (layer)
  (let* ((lib (t3-book-term-order-lexicographic-layer-lib layer))
         (proof (library-library-proof lib))
         (relation (t3-book-term-order-lexicographic-layer-relation layer))
         (x *library-x*)
         (y *library-y*)
         (z *library-z*)
         (a (list relation x y))
         (b (list relation y z))
         (goal (list relation x z))
         (guard (proof-ite a b *proof-false*)))
    (proof-with-checked-results
     ((assumed (proof-proof-assume proof guard t))
      (parts (proof-proof-conjunct proof assumed))
      (weak-xy (t3-book-term-order-lexicographic-layer-weak-bound layer (car parts) x y))
      (weak-yz (t3-book-term-order-lexicographic-layer-weak-bound layer (cadr parts) y z))
      (xy (t3-book-term-order-lexicographic-layer-leading layer x y))
      (yz (t3-book-term-order-lexicographic-layer-leading layer y z))
      (xz (t3-book-term-order-lexicographic-layer-leading layer x z))
      (xy-yes (proof-proof-assume proof xy t))
      (first (t3-book-term-order-number-chain lib xy-yes weak-yz))
      (first (t3-book-term-order-lexicographic-layer-transitivity-strict first layer))
      (yz-yes (proof-proof-assume proof yz t))
      (second (t3-book-term-order-number-chain lib weak-xy yz-yes))
      (second (t3-book-term-order-lexicographic-layer-transitivity-strict second layer))
      (xy-no (proof-proof-assume proof xy nil))
      (same-xy (t3-book-term-order-lexicographic-layer-equation layer x y (list xy-no weak-xy)))
      (same-xy (proof-proof-rewrite proof (car parts) same-xy '(1)))
      (same-xy (proof-proof-tidy proof same-xy))
      (yz-no (proof-proof-assume proof yz nil))
      (same-yz (t3-book-term-order-lexicographic-layer-equation layer y z (list yz-no weak-yz)))
      (same-yz (proof-proof-rewrite proof (cadr parts) same-yz '(1)))
      (same-yz (proof-proof-tidy proof same-yz))
      (tail (t3-book-term-order-lexicographic-layer-tail layer "TRANSITIVE" (list x y z)))
      (both (t3-book-permutations-conjunction lib same-xy same-yz))
      (tail (proof-proof-modus-ponens proof tail both))
      (xz-no (proof-proof-assume proof xz nil))
      (weak-xz (t3-book-term-order-number-chain lib weak-xy weak-yz))
      (end (t3-book-term-order-lexicographic-layer-equation layer x z (list xz-no weak-xz)))
      (xz-yes (proof-proof-assume proof xz t))
      (strict (t3-book-term-order-lexicographic-layer-transitivity-strict xz-yes layer))
      (transported (proof-proof-transport proof tail end))
      (tied (proof-proof-cases proof xz strict transported))
      (second (proof-proof-cases proof yz second tied))
      (cases (proof-proof-cases proof xy first second)))
     (t3-book-lemmas-implication lib (list *library-implies* guard goal) cases))))

(defun t3-book-term-order-lexicographic-layer-totality (layer)
  (let* ((lib (t3-book-term-order-lexicographic-layer-lib layer))
         (proof (library-library-proof lib))
         (relation (t3-book-term-order-lexicographic-layer-relation layer))
         (x *library-x*)
         (y *library-y*)
         (test (list relation x y))
         (goal (list relation y x)))
    (proof-with-checked-results
     ((denied (proof-proof-assume proof (proof-neg test) t))
      (forward (t3-book-term-order-lexicographic-layer-leading layer x y))
      (backward (t3-book-term-order-lexicographic-layer-leading layer y x))
      (forward-yes (proof-proof-assume proof forward t))
      (first (t3-book-term-order-lexicographic-layer-equation layer x y (list forward-yes)))
      (first (proof-proof-true-from-eq proof first))
      (impossible (proof-proof-cut proof first denied))
      (impossible (t3-book-permutations-consequence lib impossible goal))
      (backward-yes (proof-proof-assume proof backward t))
      (reverse-proof (t3-book-term-order-lexicographic-layer-equation layer y x (list backward-yes)))
      (reverse-proof (proof-proof-true-from-eq proof reverse-proof))
      (a (proof-proof-assume proof forward nil))
      (b (proof-proof-assume proof backward nil))
      (fail-tail (t3-book-term-order-lexicographic-layer-equation layer x y (list a b)))
      (fail-tail (proof-proof-rewrite proof denied fail-tail '(1 1)))
      (fail-tail (proof-proof-tidy proof fail-tail))
      (total (t3-book-term-order-lexicographic-layer-tail layer "TOTAL" (list x y)))
      (tail (proof-proof-modus-ponens proof total fail-tail))
      (opening (t3-book-term-order-lexicographic-layer-equation layer y x (list b a)))
      (tied (proof-proof-transport proof tail opening))
      (reverse-case (proof-proof-cases proof backward reverse-proof tied))
      (cases (proof-proof-cases proof forward impossible reverse-case)))
     (t3-book-lemmas-implication lib (list *library-implies* (proof-neg test) goal) cases))))

(defund t3-book-term-order-add-law (lib name step)
  (proof-with-checked-results ((claim (proof-step-first step)))
    (library-library-lemma lib name claim step nil)))

(defun t3-book-term-order-add-layer-laws (laws proofs lib prefix)
  (declare (xargs :measure (acl2-count laws)))
  (if (or (endp laws) (endp proofs))
      lib
    (proof-with-checked-results
     ((lib (t3-book-term-order-add-law lib (concatenate 'string prefix (car laws)) (car proofs))))
     (t3-book-term-order-add-layer-laws (cdr laws) (cdr proofs) lib prefix))))

(defun t3-book-term-order-lexicographic-layer-build (layer)
  (let* ((lib (t3-book-term-order-lexicographic-layer-lib layer))
         (proof (library-library-proof lib))
         (key (t3-book-term-order-lexicographic-layer-key layer))
         (relation (t3-book-term-order-lexicographic-layer-relation layer))
         (prefix (t3-book-term-order-lexicographic-layer-prefix layer))
         (following-prefix (t3-book-term-order-lexicographic-layer-following-prefix layer))
         (x *library-x*))
    (proof-with-checked-results
     ((same (library-library-cite lib "T3-OBJECT-WEAK-REFLEXIVE" (list (list key x)) nil))
      (reflexive (t3-book-term-order-lexicographic-layer-tail layer "REFLEXIVE" (list x)))
      (opening (t3-book-term-order-lexicographic-layer-equation layer x x (list same)))
      (reflexive (proof-proof-transport proof reflexive opening))
      (antisymmetry (t3-book-term-order-lexicographic-layer-antisymmetry layer))
      (transitivity (t3-book-term-order-lexicographic-layer-transitivity layer))
      (totality (t3-book-term-order-lexicographic-layer-totality layer))
      (lib (t3-book-term-order-add-layer-laws *t3-book-term-order-laws*
                                              (list reflexive antisymmetry transitivity totality)
                                              lib prefix)))
     (t3-book-term-order-lexicographic-layer-init lib key relation prefix following-prefix))))

(defund t3-book-term-order-next-key (body)
  (proof-with-checked-results
   ((branch (and (proof-is-call body *proof-if*) (proof-term-at body 2))))
   (if (not (equal branch *proof-true*))
       (if (equal body (list *t3-book-term-order-lexorder* *library-x* *library-y*))
           nil
         '(:failure "unproved" ""))
     (proof-with-checked-results
      ((first (proof-term-at body 1))
       (second (proof-term-at body 3))
       (otherwise (and (proof-is-call first *proof-less*)
                       (proof-is-call second *proof-if*)
                       (proof-term-at second 2))))
      (if (not (equal otherwise *proof-false*))
          '(:failure "unproved" "")
        (proof-with-checked-results
         ((args (proof-list-of-length (cdr first) 2))
          (reversed-test (proof-term-at second 1)))
         (let ((x (car args))
               (y (cadr args))
               (error '(:failure "unproved" "")))
           (if (not (equal reversed-test (library-lt y x)))
               error
             (proof-with-checked-results
              ((other-key (proof-subst x (list (cons *library-x* *library-y*)))))
              (if (equal other-key y)
                  (proof-with-checked-results ((tail (proof-term-at second 3)))
                    (cons x tail))
                error))))))))))

(defun t3-book-term-order-projection-keys-loop (n body keys)
  (declare (xargs :measure (nfix n)))
  (if (zp n)
      '(:failure "fuel" "t3-book-term-order-projection-keys")
    (proof-with-checked-results ((next (t3-book-term-order-next-key body)))
      (cond (next (t3-book-term-order-projection-keys-loop (1- n) (cdr next) (cons (car next) keys)))
            (keys (reverse keys))
            (t '(:failure "unproved" ""))))))

(defun t3-book-term-order-projection-keys (body)
  (t3-book-term-order-projection-keys-loop 1000000 body nil))

(defund t3-book-term-order-add-lexorder-law (lib law)
  (let ((name (concatenate 'string "LEXORDER-" law)))
    (proof-with-checked-results
     ((step (proof-proof-fact (library-library-proof lib) (proof-sym name "ACL2") nil)))
     (t3-book-term-order-add-law lib (concatenate 'string "T3-" name) step))))

(defun t3-book-term-order-add-lexorder-laws (laws lib)
  (declare (xargs :measure (acl2-count laws)))
  (if (endp laws)
      lib
    (proof-with-checked-results ((lib (t3-book-term-order-add-lexorder-law lib (car laws))))
      (t3-book-term-order-add-lexorder-laws (cdr laws) lib))))

(defund t3-book-term-order-build-layer (indexed-key lib folded following prefix)
  (let* ((label (decimal-text (car indexed-key)))
         (value (cadr indexed-key))
         (key (proof-sym (concatenate 'string "SELF-T3-TERM-KEY-" label) "ACL2"))
         (relation (proof-sym (concatenate 'string "SELF-T3-TERM-COMPARE-" label) "ACL2"))
         (x *library-x*)
         (y *library-y*)
         (a (list key x))
         (b (list key y)))
    (proof-with-checked-results
     ((lib (library-library-definition lib key (list x) value))
      (proof (library-library-proof lib))
      (first (proof-proof-unfold proof a))
      (first (proof-proof-symmetric proof first))
      (second (proof-proof-unfold proof b))
      (second (proof-proof-symmetric proof second))
      (folded (t3-book-spines-replace-value lib folded (list first second)))
      (lib (library-library-definition lib relation (list x y)
                                       (proof-ite (library-lt a b) *proof-true*
                                                  (proof-ite (library-lt b a) *proof-false*
                                                             (list following x y)))))
      (proof (library-library-proof lib))
      (opening (proof-proof-unfold proof (list relation x y)))
      (opening (proof-proof-symmetric proof opening))
      (folded (t3-book-spines-replace-value lib folded (list opening)))
      (current (concatenate 'string "T3-TERM-COMPARE-" label "-"))
      (layer (t3-book-term-order-lexicographic-layer-init
              lib key relation current (concatenate 'string "SELF-" prefix)))
      (layer (t3-book-term-order-lexicographic-layer-build layer)))
     (list (t3-book-term-order-lexicographic-layer-lib layer) folded relation current))))

(defun t3-book-term-order-build-layers (keys lib folded following prefix)
  (declare (xargs :measure (acl2-count keys)))
  (if (endp keys)
      (list lib folded following prefix)
    (proof-with-checked-results
     ((next (t3-book-term-order-build-layer (car keys) lib folded following prefix)))
     (t3-book-term-order-build-layers (cdr keys) (car next) (cadr next) (caddr next) (cadddr next)))))

(defund t3-book-term-order-rewrite-law-at (pair proof step folded)
  (proof-with-checked-results
   ((replacement (proof-proof-instantiate
                  proof folded (list (list *library-x* (car pair)) (list *library-y* (cadr pair)))))
    (replacement (proof-proof-symmetric proof replacement)))
   (proof-proof-rewrite-first proof step replacement)))

(defun t3-book-term-order-rewrite-law (pairs proof step folded)
  (declare (xargs :measure (acl2-count pairs)))
  (if (endp pairs)
      step
    (proof-with-checked-results ((step (t3-book-term-order-rewrite-law-at (car pairs) proof step folded)))
     (t3-book-term-order-rewrite-law (cdr pairs) proof step folded))))

(defund t3-book-term-order-add-order-law (lib law folded prefix)
  (let ((proof (library-library-proof lib))
        (x *library-x*)
        (y *library-y*)
        (z *library-z*))
    (proof-with-checked-results
     ((step (proof-proof-fact proof (proof-sym (concatenate 'string "SELF-" prefix law) "ACL2") nil))
      (step (t3-book-term-order-rewrite-law (list (list x x) (list x y) (list y x)
                                               (list y z) (list x z))
                                           proof step folded)))
     (t3-book-term-order-add-law lib (concatenate 'string "T3-TERM-ORDER-" law) step))))

(defun t3-book-term-order-add-order-laws (laws lib folded prefix)
  (declare (xargs :measure (acl2-count laws)))
  (if (endp laws)
      lib
    (proof-with-checked-results ((lib (t3-book-term-order-add-order-law lib (car laws) folded prefix)))
      (t3-book-term-order-add-order-laws (cdr laws) lib folded prefix))))

(defun t3-book-term-order-build (lib)
  (let ((x *library-x*)
        (y *library-y*))
    (proof-with-checked-results
     ((lib (t3-book-numeric-order-build lib))
      (proof (library-library-proof lib))
      (order (proof-proof-unfold proof (list *t3-book-term-order-order* x y)))
      (order-body (proof-rewritten-term order))
      (opened (proof-proof-unfold proof order-body))
      (opened-body (proof-rewritten-term opened))
      (normalized (t3-logic-libraryproofs-normalize lib opened-body nil nil))
      (expanded (proof-proof-chain proof order (list opened normalized)))
      (expanded-body (proof-rewritten-term expanded))
      (keys (t3-book-term-order-projection-keys expanded-body))
      (lex (proof-proof-fact proof (proof-sym "LEXORDER-TOTAL" "ACL2") nil))
      (denied (proof-proof-assume proof
                                  (proof-neg (list *t3-book-term-order-lexorder* x y)) t))
      (denial (proof-step-first denied))
      (total (proof-proof-prove-if proof lex denied))
      (total (t3-book-lemmas-implication
              lib (list *library-implies* denial (list *t3-book-term-order-lexorder* y x)) total))
      (claim (proof-step-first total))
      (lib (library-library-lemma lib "T3-LEXORDER-TOTAL" claim total nil))
      (lib (t3-book-term-order-add-lexorder-laws (seq-slice *t3-book-term-order-laws* 0 -1) lib))
      (layers (t3-book-term-order-build-layers (reverse (seq-numbered keys 0))
                                               lib expanded *t3-book-term-order-lexorder* "T3-LEXORDER-"))
      (final-body (proof-rewritten-term (cadr layers))))
     (if (equal final-body (list (caddr layers) x y))
         (t3-book-term-order-add-order-laws *t3-book-term-order-laws*
                                            (car layers) (cadr layers) (cadddr layers))
       '(:failure "unproved" "")))))
