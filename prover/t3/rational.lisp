(in-package "BOYMOO-PROVER")

(set-verify-guards-eagerness 0)

(defconst *t3-rational-abs* (proof-sym "INTEGER-ABS" "ACL2"))
(defconst *t3-rational-numerator* (proof-cl "NUMERATOR"))
(defconst *t3-rational-denominator* (proof-cl "DENOMINATOR"))
(defconst *t3-rational-reciprocal* (proof-sym "UNARY-/" "ACL2"))

(defun t3-rational-value (step)
  (if (not step)
      '(:failure "failure" "")
    (proof-with-checked-results ((literal (proof-step-first step)))
      (proof-term-at literal 2))))

(defun t3-rational-product-zero (lib)
  (let* ((proof (library-library-proof lib))
         (product (list *proof-times* *library-x* *proof-zero*))
         (minus-product (library-minus product))
         (zeros (library-plus *proof-zero* *proof-zero*)))
    (proof-with-checked-results
     ((doubled (library-library-axiom lib "DISTRIBUTIVITY"
                                    (list *library-x* *proof-zero* *proof-zero*)))
      (zero (proof-proof-compute proof zeros 0))
      (doubled (proof-proof-rewrite proof doubled zero '(1 1 2)))
      (commutes (library-library-axiom lib "COMMUTATIVITY-OF-+" (list minus-product product)))
      (cancels (library-library-axiom lib "INVERSE-OF-+" (list product)))
      (inverse (proof-proof-chain proof commutes (list cancels)))
      (back (proof-proof-symmetric proof inverse))
      (reduced (proof-proof-rewrite proof back doubled '(1 2 2)))
      (associated (library-library-axiom lib "ASSOCIATIVITY-OF-+"
                                         (list minus-product product product)))
      (sum-step (proof-proof-symmetric proof associated))
      (reduced (proof-proof-chain proof reduced (list sum-step)))
      (reduced (proof-proof-rewrite proof reduced inverse '(1 2 1)))
      (identity (library-library-axiom lib "UNICITY-OF-0" (list product)))
      (reduced (proof-proof-chain proof reduced (list identity)))
      (closure (library-library-axiom lib "CLOSURE" (list *library-x* *proof-zero*)))
      (closure (proof-proof-conjunct proof closure))
      (numeric (proof-proof-conjunct proof (cadr closure)))
      (value (t3-rational-value reduced))
      (fixed (t3-book-spines-library-simplify lib value (list (car numeric))
                                            (list (proof-sym "FIX" "ACL2"))))
      (reduced (proof-proof-chain proof reduced (list fixed)))
      (step (proof-proof-symmetric proof reduced)))
     (library-library-lemma lib "T3-PRODUCT-ZERO" (proof-eq product *proof-zero*) step nil))))

(defun t3-rational-abs-facts (lib)
  (let* ((proof (library-library-proof lib))
         (size (list *t3-rational-abs* *library-x*))
         (sign (library-lt *library-x* *proof-zero*))
         (definitions (list *t3-rational-abs*))
         (zero (proof-eq *library-x* *proof-zero*)))
    (proof-with-checked-results
     ((integers (library-library-ints lib (list *library-x*)))
      (negative (proof-proof-assume proof sign t))
      (nonnegative (proof-proof-assume proof sign nil))
      (left (t3-book-spines-library-simplify lib size (list (car integers) negative) definitions))
      (right (t3-book-spines-library-simplify lib size (list (car integers) nonnegative) definitions))
      (ix (proof-step-first (car integers)))
      (negative-integer (t3-logic-libraryproofs-type-of lib (library-minus *library-x*) integers))
      (int-left (library-library-transport-argument lib negative-integer left 1))
      (int-right (library-library-transport-argument lib (car integers) right 1))
      (integer-step (proof-proof-cases proof sign int-left int-right))
      (lib (library-library-lemma lib "T3-ABS-INTEGER" (library-integer size) integer-step
                                  (list (proof-neg ix))))
      (nonzero (proof-proof-assume (library-library-proof lib) zero nil))
      (compare (library-library-comparison lib *library-x* *proof-zero* integers))
      (negative-integer (t3-logic-libraryproofs-type-of lib (library-minus *library-x*) integers))
      (delta (library-library-cite lib "ADD-ZERO-LEFT" (list (library-minus *library-x*))
                                  (list negative-integer)))
      (compare (proof-proof-rewrite (library-library-proof lib) compare delta '(1 2 2)))
      (negative (proof-proof-rewrite (library-library-proof lib) negative compare '(1)))
      (positive-left (library-library-transport-argument lib negative left 2))
      (positive-right (library-library-cite lib "T3-POSITIVE-FROM-NONZERO" (list *library-x*)
                                           (list (car integers) nonnegative nonzero)))
      (positive-right (library-library-transport-argument lib positive-right right 2))
      (positive-step (proof-proof-cases (library-library-proof lib) sign
                                      positive-left positive-right)))
     (library-library-lemma lib "T3-ABS-POSITIVE" (library-positive size) positive-step
                            (list (proof-neg ix) zero)))))

(defun t3-rational-count-branch (lib term rational integral)
  (let ((proof (t3-book-spines-proof lib))
        (cons-term (list *proof-consp* term))
        (bindings (list (list *library-x* term))))
    (proof-with-checked-results
     ((rational-number (proof-proof-fact proof "rationalp-acl2-numberp" bindings))
      (number (proof-proof-modus-ponens proof rational-number rational))
      (if-cons (proof-proof-fact proof "consp-not-acl2-numberp" bindings))
      (cons-step (proof-proof-assume proof cons-term t))
      (nonnumber (proof-proof-modus-ponens proof if-cons cons-step))
      (contradiction (proof-proof-cut proof number nonnumber))
      (atom-step (proof-proof-front proof contradiction (proof-neg cons-term))))
     (t3-book-spines-library-simplify lib (list *library-count* term)
                                     (list atom-step rational integral) (list *library-count*)))))

(defun t3-rational-count-component
    (lib part component equation total positive-other integers conditions)
  (let ((before (list *library-count* *library-x*))
        (after (list *library-count* component)))
    (proof-with-checked-results
     ((smaller (t3-rational-value equation))
      (larger (t3-rational-value total))
      (strict (library-library-less-from-difference lib smaller larger positive-other integers))
      (strict (library-library-transport-argument lib strict equation 1))
      (strict (library-library-transport-argument lib strict total 2))
      (ordinal (library-library-ordinal-comparison lib after before))
      (proof (proof-proof-transport (library-library-proof lib) strict ordinal)))
     (library-library-lemma lib (concatenate 'string "T3-COUNT-" part)
                            (list *proof-ordinal-less* after before) proof conditions))))

(defun t3-rational-rational-counts (lib)
  (proof-with-checked-results
   ((lib (t3-rational-product-zero lib))
    (lib (t3-rational-abs-facts lib)))
   (let* ((proof (library-library-proof lib))
          (rational-term (list *library-rationalp* *library-x*))
          (integer-term (library-integer *library-x*))
          (numerator (list *t3-rational-numerator* *library-x*))
          (denominator (list *t3-rational-denominator* *library-x*))
          (conditions (list (proof-neg rational-term) integer-term)))
     (proof-with-checked-results
      ((rational (proof-proof-assume proof rational-term t))
       (not-integer (proof-proof-assume proof integer-term nil))
       (axiom (library-library-axiom lib "RATIONAL-IMPLIES1" (list *library-x*)))
       (formula (proof-proof-modus-ponens proof axiom rational))
       (parts (proof-proof-conjunct proof formula))
       (int-den (car parts))
       (parts (proof-proof-conjunct proof (cadr parts)))
       (int-num (car parts))
       (pos-den (cadr parts))
       (int-mag (library-library-cite lib "T3-ABS-INTEGER" (list numerator) (list int-num)))
       (den-bound (library-library-cite lib "POSITIVE-NONNEGATIVE" (list denominator)
                                       (list int-den pos-den)))
       (den-abs (t3-book-spines-library-simplify lib (list *t3-rational-abs* denominator)
                                               (list int-den den-bound) (list *t3-rational-abs*)))
       (num-rational (t3-logic-libraryproofs-rational lib numerator (list int-num)))
       (num-count (t3-rational-count-branch lib numerator num-rational int-num))
       (den-rational (t3-logic-libraryproofs-rational lib denominator (list int-den)))
       (den-count (t3-rational-count-branch lib denominator den-rational int-den))
       (den-count (proof-proof-chain proof den-count (list den-abs)))
       (total (t3-rational-count-branch lib *library-x* rational not-integer))
       (zero-num (proof-proof-assume proof (proof-eq numerator *proof-zero*) t))
       (axiom (library-library-axiom lib "RATIONAL-IMPLIES2" (list *library-x*)))
       (representation (proof-proof-modus-ponens proof axiom rational))
       (representation (proof-proof-rewrite proof representation zero-num '(1 1 2)))
       (zero (library-library-cite lib "T3-PRODUCT-ZERO"
                                  (list (list *t3-rational-reciprocal* denominator)) nil))
       (zero-x (proof-proof-rewrite proof representation zero '(1 1)))
       (int-zero (t3-logic-libraryproofs-type-of lib *proof-zero* nil))
       (impossible (proof-proof-rewrite proof int-zero zero-x '(1 1)))
       (contradiction (proof-proof-cut proof impossible not-integer))
       (nonzero (proof-proof-front proof contradiction
                                  (proof-neg (proof-eq numerator *proof-zero*))))
       (pos-mag (library-library-cite lib "T3-ABS-POSITIVE" (list numerator) (list int-num nonzero)))
       (lib (t3-rational-count-component lib "NUMERATOR" numerator num-count total pos-den
                                        (list int-mag int-den) conditions)))
      (t3-rational-count-component lib "DENOMINATOR" denominator den-count total pos-mag
                                   (list int-mag int-den) conditions)))))

(defun t3-rational-rational-descent (lib smaller larger evidence)
  (proof-with-checked-results
   ((child (proof-term-at smaller 1))
    (parent (proof-term-at larger 1)))
   (cond
    ((integerp child) '(:failure "failure" ""))
    ((not (equal (cdr child) (list parent))) (cons nil (cons lib evidence)))
    ((not (member-equal (car child) (list *t3-rational-numerator* *t3-rational-denominator*)))
     (cons nil (cons lib evidence)))
    (t
     (let* ((facts (proof-proof-facts (library-library-proof lib)))
            (lemma (proof-sym "SELF-T3-COUNT-NUMERATOR" "ACL2"))
            (label (if (equal (car child) *t3-rational-numerator*)
                       "T3-COUNT-NUMERATOR"
                     "T3-COUNT-DENOMINATOR")))
       (proof-with-checked-results
        ((updated (if (assoc-equal lemma facts) lib (t3-rational-rational-counts lib)))
         (evidence (if (equal (t3-logic-evidence-lib evidence) lib)
                       (t3-logic-evidence-with-lib evidence updated)
                     evidence))
         (rational (t3-logic-evidence-require evidence (list *library-rationalp* parent)))
         (noninteger (t3-logic-evidence-require (cdr rational)
                                               (proof-neg (library-integer parent))))
         (step (library-library-cite updated label (list parent) (list (car rational) (car noninteger)))))
        (cons step (cons updated (cdr noninteger)))))))))
