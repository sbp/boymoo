(defun t3-book-sorted-lists-sorted-permutation (lib)
  (proof-with-checked-results
      ((permutations (t3-book-permutations-permutations-init lib))
       (lib (t3-book-sorted-lists-minimum lib)))
    (let* ((permutations (t3-book-permutations-permutations-with-lib permutations lib))
           (proof (library-library-proof lib))
           (x *library-x*)
           (y *library-y*)
           (cons (t3-book-permutations-permutations-cons permutations))
           (atom (t3-book-permutations-permutations-atom permutations))
           (hypothesis (proof-ite
                        (list *t3-book-sorted-lists-true-listp* x)
                        (proof-ite
                         (list *t3-book-sorted-lists-true-listp* y)
                         (proof-ite
                          (list *t3-book-sorted-lists-ordered* x)
                          (proof-ite (list *t3-book-sorted-lists-ordered* y)
                                     (list *t3-book-permutations-perm* x y) *proof-false*)
                          *proof-false*)
                         *proof-false*)
                        *proof-false*))
           (formula (list *library-implies* hypothesis (proof-eq x y))))
      (proof-with-checked-results
          ((assumed (proof-proof-assume proof hypothesis t))
           (parts (t3-book-sorted-lists-split lib assumed 5))
           (proper-x (nth 0 parts))
           (proper-y (nth 1 parts))
           (ordered-x (nth 2 parts))
           (ordered-y (nth 3 parts))
           (perm-xy (nth 4 parts))
           (base-y (t3-book-permutations-permutations-perm-parts permutations perm-xy atom))
           (nil-x (t3-book-sorted-lists-rewrite-shallow lib proper-x (list atom)))
           (nil-y (t3-book-sorted-lists-rewrite-shallow lib proper-y (list base-y)))
           (nil-y-back (proof-proof-symmetric proof nil-y))
           (base (proof-proof-chain proof nil-x (list nil-y-back)))
           (parts (t3-book-permutations-permutations-perm-parts permutations perm-xy cons))
           (first (car parts))
           (rest (cadr parts))
           (y-cons (t3-book-sorted-lists-cons-from-member lib first))
           (laws (t3-book-sorted-lists-permutation-laws lib x y))
           (reversed (proof-proof-modus-ponens proof (caddr laws) perm-xy))
           (parts (t3-book-permutations-permutations-perm-parts permutations reversed y-cons))
           (second (car parts))
           (head-x (list *library-car* x))
           (head-y (list *library-car* y))
           (minimum-name (proof-sym "SELF-T3-ORDERED-MINIMUM" "ACL2"))
           (lower-x (proof-proof-fact proof minimum-name (list (list *t3-book-permutations-a* head-y))))
           (lower-y (proof-proof-fact proof minimum-name
                                      (list (list x y) (list *t3-book-permutations-a* head-x))))
           (properties-x (t3-book-sorted-lists-combine lib (list ordered-x second)))
           (before (proof-proof-modus-ponens proof lower-x properties-x))
           (properties-y (t3-book-sorted-lists-combine lib (list ordered-y first)))
           (after (proof-proof-modus-ponens proof lower-y properties-y))
           (antisymmetry (t3-book-term-order-call lib "ANTI-SYMMETRIC" (list head-x head-y)))
           (both (t3-book-sorted-lists-combine lib (list before after)))
           (equal-heads (proof-proof-modus-ponens proof antisymmetry both))
           (remove-y (t3-book-spines-shallow lib (list *t3-book-permutations-remove* head-x y)
                                             (list y-cons equal-heads)))
           (tails (proof-proof-rewrite proof rest remove-y '(1 2)))
           (tails (proof-proof-tidy proof tails))
           (proper-tail-x (t3-book-sorted-lists-rewrite-shallow lib proper-x (list cons)))
           (proper-tail-y (t3-book-sorted-lists-rewrite-shallow lib proper-y (list y-cons)))
           (less (list (list x (list *library-cdr* x)) (list y (list *library-cdr* y))))
           (ordered-tail-x (t3-book-sorted-lists-ordered-tail lib ordered-x cons))
           (ordered-tail-y (t3-book-sorted-lists-ordered-tail lib ordered-y y-cons))
           (narrower (t3-book-sorted-lists-combine
                      lib (list proper-tail-x proper-tail-y ordered-tail-x ordered-tail-y tails)))
           (induction (t3-book-permutations-permutations-hypothesis permutations formula less))
           (equal-tails (proof-proof-modus-ponens proof induction narrower))
           (elim-x (library-library-axiom lib "CAR-CDR-ELIM" (list x)))
           (opened (proof-proof-modus-ponens proof elim-x cons))
           (opened (proof-proof-symmetric proof opened))
           (elim-y (library-library-axiom lib "CAR-CDR-ELIM" (list y)))
           (closed (proof-proof-modus-ponens proof elim-y y-cons))
           (replaced (t3-book-spines-replace-value lib opened (list equal-heads equal-tails)))
           (step (proof-proof-chain proof replaced (list closed)))
           (result (t3-book-permutations-permutations-induct permutations formula less step base)))
        (library-library-lemma lib "T3-SORTED-PERMUTATION-UNIQUE" formula result nil)))))

(defun t3-book-sorted-lists-ordered-perms (lib name formula)
  (proof-with-checked-results
      ((lib (t3-book-term-order-build lib))
       (lib (t3-book-sorted-lists-sorted-permutation lib))
       (arguments (proof-list-of-length (cdr formula) 2))
       (parts (proof-list-of-length (cdr (cadr arguments)) 2))
       (same (car parts))
       (perm (cadr parts))
       (sides (proof-list-of-length same 3)))
    (let ((proof (library-library-proof lib))
          (a (cadr sides))
          (b (caddr sides)))
      (proof-with-checked-results
          ((guard (proof-proof-assume proof (car arguments) t))
           (properties (t3-book-sorted-lists-split lib guard 4))
           (known (proof-proof-fact proof (proof-sym "SELF-T3-SORTED-PERMUTATION-UNIQUE" "ACL2")
                                    (list (list *library-x* a) (list *library-y* b))))
           (accepted (proof-proof-assume proof perm t))
           (condition (t3-book-sorted-lists-combine lib (append properties (list accepted))))
           (identical (proof-proof-modus-ponens proof known condition))
           (laws (t3-book-sorted-lists-permutation-laws lib a b))
           (is-true (library-library-cite lib "T3-BOOLEAN-TRUE" (list perm)
                                          (list (car laws) accepted)))
           (known-same (t3-book-lemmas-true-equality lib identical))
           (is-true-back (proof-proof-symmetric proof is-true))
           (yes (proof-proof-chain proof known-same (list is-true-back)))
           (denied (proof-proof-assume proof perm nil))
           (assumed-same (proof-proof-assume proof same t))
           (would-permute (proof-proof-rewrite proof (cadr laws) assumed-same '(1 2)))
           (would-permute (proof-proof-tidy proof would-permute))
           (contradiction (proof-proof-cut proof would-permute denied))
           (differs (proof-proof-front proof contradiction (proof-neg same)))
           (false-same (t3-book-lemmas-nil-value lib differs))
           (false-perm (t3-book-lemmas-nil-value lib denied))
           (false-perm-back (proof-proof-symmetric proof false-perm))
           (no (proof-proof-chain proof false-same (list false-perm-back)))
           (cases (proof-proof-cases proof perm yes no))
           (step (t3-book-lemmas-implication lib formula cases))
           (entry (proof-proof-entry "theorem" name (list name) (list step))))
        (cons entry lib)))))

(defun t3-book-sorted-lists-head-lower (bound sequence)
  (list *library-implies* (list *proof-consp* sequence)
        (list *t3-book-term-order-order* bound (list *library-car* sequence))))

(defun t3-book-sorted-lists-head-of-merge-observe (bound guards cons lib merged nonempty)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((opened (t3-book-spines-shallow lib merged guards))
         (known (or cons
                    (proof-with-checked-results
                        ((rewritten (proof-proof-rewrite proof nonempty opened '(1 1))))
                      (proof-proof-tidy proof rewritten))))
         (first (t3-book-merges-through lib (list *library-car* *proof-result*) opened))
         (selected (proof-rewritten-term first))
         (constant (t3-logic-libraryproofs-constant lib selected))
         (first (proof-proof-chain proof first (list constant)))
         (step (proof-proof-modus-ponens proof bound known)))
      (library-library-transport-argument lib step first 2))))

(defun t3-book-sorted-lists-head-of-merge (lib)
  (let* ((proof (library-library-proof lib))
         (bound *t3-book-permutations-b*)
         (merged (list *t3-book-merges-merge* *library-x* *library-y*))
         (guard (proof-ite (t3-book-sorted-lists-head-lower bound *library-x*)
                           (proof-ite (t3-book-sorted-lists-head-lower bound *library-y*)
                                      (list *proof-consp* merged) *proof-false*)
                           *proof-false*))
         (goal (list *t3-book-term-order-order* bound (list *library-car* merged)))
         (formula (list *library-implies* guard goal)))
    (proof-with-checked-results
        ((assumed (proof-proof-assume proof guard t))
         (parts (t3-book-sorted-lists-split lib assumed 3))
         (low-x (car parts))
         (low-y (cadr parts))
         (nonempty (caddr parts))
         (merge (t3-book-merges-merge-init lib formula))
         (x (proof-proof-assume proof (list *proof-consp* *library-x*) t))
         (y (proof-proof-assume proof (list *proof-consp* *library-y*) t))
         (x-term (proof-step-first x))
         (absent-x (proof-proof-assume proof x-term nil))
         (y-term (proof-step-first y))
         (absent-y (proof-proof-assume proof y-term nil))
         (one (t3-book-sorted-lists-head-of-merge-observe low-x (list x absent-y) nil lib merged nonempty))
         (two (t3-book-sorted-lists-head-of-merge-observe low-y (list absent-x) nil lib merged nonempty))
         (decision (t3-book-merges-merge-decision merge))
         (taken (proof-proof-assume proof decision t))
         (left (t3-book-sorted-lists-head-of-merge-observe low-x (list x y taken) x lib merged nonempty))
         (rejected (proof-proof-assume proof decision nil))
         (right (t3-book-sorted-lists-head-of-merge-observe low-y (list x y rejected) y lib merged nonempty))
         (step (proof-proof-cases proof decision left right))
         (step (proof-proof-cases proof y-term step one))
         (case (proof-proof-cases proof x-term step two))
         (result (t3-book-lemmas-implication lib formula case)))
      (library-library-lemma lib "T3-MERGE-HEAD-LOWER" formula result nil))))

(defun t3-book-sorted-lists-merge-ordered-base (branch evidence lib merge left right)
  (let ((ordered (if (eql branch 0) right left)))
    (proof-with-checked-results
        ((equation (t3-book-spines-shallow lib (t3-book-merges-merge-call merge) evidence)))
      (library-library-transport-argument lib ordered equation 1))))

(defun t3-book-sorted-lists-merge-ordered-step (branch evidence induction lib merge left right)
  (let* ((proof (library-library-proof lib))
         (left-branch (eql branch 0))
         (old (if left-branch *library-x* *library-y*))
         (other (if left-branch *library-y* *library-x*))
         (old-cons (nth branch evidence))
         (tail (list *library-cdr* old))
         (head (list *library-car* old))
         (ordered (if left-branch left right)))
    (proof-with-checked-results
        ((tail-ordered (t3-book-sorted-lists-ordered-tail lib ordered old-cons))
         (proved (t3-book-sorted-lists-combine
                  lib (if left-branch (list tail-ordered right) (list left tail-ordered))))
         (remaining (proof-proof-modus-ponens proof induction proved))
         (literal (proof-step-first remaining))
         (rest (proof-term-at literal 1))
         (opened (t3-book-spines-shallow lib (t3-book-merges-merge-call merge) evidence))
         (new-list (list *proof-cons* head rest))
         (tail-present (proof-proof-assume proof (list *proof-consp* tail) t))
         (links (t3-book-sorted-lists-ordered-links lib ordered old-cons tail-present))
         (bound-tail (t3-book-lemmas-implication lib (t3-book-sorted-lists-head-lower head tail)
                                                (car links)))
         (upper (car (last evidence)))
         (upper (if (eql branch 1)
                    (proof-with-checked-results
                        ((total (t3-book-term-order-call
                                 lib "TOTAL"
                                 (list (list *library-car* *library-x*)
                                       (list *library-car* *library-y*)))))
                      (proof-proof-modus-ponens proof total upper))
                  upper))
         (bound-other (t3-book-lemmas-implication lib (t3-book-sorted-lists-head-lower head other)
                                                 upper))
         (bounds (if left-branch (list bound-tail bound-other) (list bound-other bound-tail)))
         (rest-x (proof-term-at rest 1))
         (rest-y (proof-term-at rest 2))
         (known (proof-proof-fact
                 proof (proof-sym "SELF-T3-MERGE-HEAD-LOWER" "ACL2")
                 (list (list *t3-book-permutations-b* head)
                       (list *library-x* rest-x) (list *library-y* rest-y))))
         (test (list *proof-consp* rest))
         (present (proof-proof-assume proof test t))
         (guard (t3-book-sorted-lists-combine lib (append bounds (list present))))
         (result (proof-proof-modus-ponens proof known guard))
         (structured (t3-book-spines-shallow lib (list *t3-book-sorted-lists-ordered* new-list)
                                             (list present)))
         (cons-case (t3-book-sorted-lists-combine lib (list result remaining)))
         (yes (proof-proof-transport proof cons-case structured))
         (absent (proof-proof-assume proof test nil))
         (empty (t3-book-spines-shallow lib (list *t3-book-sorted-lists-ordered* new-list)
                                        (list absent)))
         (no (proof-proof-true-from-eq proof empty))
         (cases (proof-proof-cases proof test yes no)))
      (library-library-transport-argument lib cases opened 1))))

(defun t3-book-sorted-lists-merge-ordered-next (merge left right base recursive)
  (let ((result (t3-book-merges-merge-prove merge base recursive t)))
    (if (not (and (consp result) (eq (car result) :t3-book-merges-call)))
        (list :done result)
      (let* ((args (caddr result))
             (lib (cadddr result))
             (branch (car args))
             (evidence (cadr args)))
        (if (eq (cadr result) :base)
            (proof-with-checked-results
                ((step (t3-book-sorted-lists-merge-ordered-base branch evidence lib merge left right)))
              (list :pending (table-put base args step) recursive))
          (proof-with-checked-results
              ((step (t3-book-sorted-lists-merge-ordered-step
                      branch evidence (caddr args) lib merge left right)))
            (list :pending base (table-put recursive args step))))))))

(defun t3-book-sorted-lists-merge-ordered-cases (n merge left right progress)
  (declare (xargs :measure (nfix n)))
  (cond ((zp n) '(:failure "Fuel" "t3-book-sorted-lists-merge-ordered-cases"))
        ((failure-p progress) progress)
        ((eq (car progress) :done) (cadr progress))
        (t (t3-book-sorted-lists-merge-ordered-cases
            (1- n) merge left right
            (t3-book-sorted-lists-merge-ordered-next
             merge left right (cadr progress) (caddr progress))))))

