(in-package "BOYMOO-PROVER")
(set-verify-guards-eagerness 0)

(defconst *t3-book-sorted-lists-ordered* (proof-sym "TERM-ORDEREDP" "ACL2"))
(defconst *t3-book-sorted-lists-true-listp* *t3-book-lemmas-true-listp*)

(defun t3-book-sorted-lists-combine (lib proofs)
  (cond ((endp proofs) '(:failure "MissingProofInput" ""))
        ((endp (cdr proofs)) (car proofs))
        (t
         (proof-with-checked-results ((rest (t3-book-sorted-lists-combine lib (cdr proofs))))
           (t3-book-permutations-conjunction lib (car proofs) rest)))))

(defun t3-book-sorted-lists-split (lib step count)
  (declare (xargs :measure (nfix count)))
  (if (and (integerp count) (< 1 count))
      (proof-with-checked-results
          ((parts (proof-proof-conjunct (library-library-proof lib) step))
           (rest (t3-book-sorted-lists-split lib (cadr parts) (1- count))))
        (cons (car parts) rest))
    (list step)))

(defun t3-book-sorted-lists-cons-from-member (lib step)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((literal (proof-step-first step))
         (source (proof-term-at literal 2)))
      (let ((result (list *proof-consp* source)))
        (proof-with-checked-results
            ((atom (proof-proof-assume proof result nil))
             (empty (t3-book-spines-shallow lib literal (list atom)))
             (rewritten (proof-proof-rewrite proof step empty '(1)))
             (tidied (proof-proof-tidy proof rewritten)))
          (proof-proof-front proof tidied result))))))

(defun t3-book-sorted-lists-ordered-links (lib step cons tail-cons)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((literal (proof-step-first step))
         (opened (t3-book-spines-shallow lib literal (list cons tail-cons)))
         (rewritten (proof-proof-rewrite proof step opened '(1)))
         (tidied (proof-proof-tidy proof rewritten)))
      (proof-proof-conjunct proof tidied))))

(defun t3-book-sorted-lists-ordered-tail (lib step cons)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((literal (proof-step-first step))
         (value (proof-term-at literal 1)))
      (let* ((tail (list *library-cdr* value))
             (test (list *proof-consp* tail)))
        (proof-with-checked-results
            ((present (proof-proof-assume proof test t))
             (parts (t3-book-sorted-lists-ordered-links lib step cons present))
             (absent (proof-proof-assume proof test nil))
             (empty (t3-book-spines-shallow lib (list *t3-book-sorted-lists-ordered* tail)
                                          (list absent)))
             (no (proof-proof-true-from-eq proof empty)))
          (proof-proof-cases proof test (cadr parts) no))))))

(defun t3-book-sorted-lists-minimum (lib)
  (proof-with-checked-results
      ((permutations (t3-book-permutations-permutations-init lib)))
    (let* ((proof (library-library-proof lib))
           (head (t3-book-permutations-permutations-head permutations))
           (tail (t3-book-permutations-permutations-tail permutations))
           (cons (t3-book-permutations-permutations-cons permutations))
           (test (proof-eq *t3-book-permutations-a* head))
           (member (list *t3-book-permutations-member* *t3-book-permutations-a* *library-x*))
           (guard (proof-ite (list *t3-book-sorted-lists-ordered* *library-x*)
                             member *proof-false*))
           (goal (list *t3-book-term-order-order* head *t3-book-permutations-a*))
           (formula (list *library-implies* guard goal)))
      (proof-with-checked-results
          ((assumed (proof-proof-assume proof guard t))
           (parts (proof-proof-conjunct proof assumed))
           (ordered (car parts))
           (present (cadr parts))
           (member-cons (t3-book-sorted-lists-cons-from-member lib present))
           (absent (t3-book-permutations-permutations-atom permutations))
           (contradiction (proof-proof-cut proof member-cons absent))
           (base (t3-book-permutations-consequence lib contradiction goal))
           (same (proof-proof-assume proof test t))
           (same (proof-proof-symmetric proof same))
           (identity (t3-book-term-order-call lib "REFLEXIVE" (list head)))
           (reflexive (proof-proof-rewrite proof identity same '(1 2)))
           (reflexive (proof-proof-tidy proof reflexive))
           (denied (proof-proof-assume proof test nil))
           (opened (t3-book-spines-shallow lib member (list cons denied)))
           (tail-member (proof-proof-rewrite proof present opened '(1)))
           (tail-member (proof-proof-tidy proof tail-member))
           (tail-is-cons (t3-book-sorted-lists-cons-from-member lib tail-member))
           (links (t3-book-sorted-lists-ordered-links lib ordered cons tail-is-cons))
           (pairs (list (list *library-x* tail)))
           (induction (t3-book-permutations-permutations-hypothesis permutations formula pairs))
           (tail-facts (t3-book-sorted-lists-combine lib (list (cadr links) tail-member)))
           (tail-min (proof-proof-modus-ponens proof induction tail-facts))
           (theorem (t3-book-term-order-call
                     lib "TRANSITIVE" (list head (list *library-car* tail) *t3-book-permutations-a*)))
           (both (t3-book-sorted-lists-combine lib (list (car links) tail-min)))
           (later (proof-proof-modus-ponens proof theorem both))
           (step (proof-proof-cases proof test reflexive later))
           (result (t3-book-permutations-permutations-induct permutations formula pairs step base)))
        (library-library-lemma lib "T3-ORDERED-MINIMUM" formula result nil)))))

(defun t3-book-sorted-lists-permutation-laws (lib x y)
  (proof-with-checked-results
      ((axioms (proof-proof-fact
                (library-library-proof lib) *t3-book-permutations-theorem*
                (list (list *library-x* x) (list *library-y* y))))
       (parts (t3-book-sorted-lists-split lib axioms 4)))
    (list (car parts) (cadr parts) (caddr parts))))

