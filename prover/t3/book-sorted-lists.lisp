(defun t3-book-sorted-lists-ordered-sort-next (lib formula base recursive)
  (let ((result (t3-book-merges-sort-induction lib formula base recursive nil)))
    (if (not (and (consp result) (eq (car result) :t3-book-merges-call)))
        (list :done result)
      (let ((args (caddr result))
            (callback-lib (cadddr result)))
        (if (eq (cadr result) :base)
            (proof-with-checked-results
                ((step (t3-book-sorted-lists-ordered-sort-base (car args) callback-lib)))
              (list :pending (table-put base args step) recursive))
          (proof-with-checked-results
              ((step (t3-book-sorted-lists-ordered-sort-recursive
                      (car args) (cadr args) (caddr args) (cadddr args) callback-lib)))
            (list :pending base (table-put recursive args step))))))))

(defun t3-book-sorted-lists-ordered-sort-cases (n lib formula progress)
  (declare (xargs :measure (nfix n)))
  (cond ((zp n) '(:failure "Fuel" "t3-book-sorted-lists-ordered-sort-cases"))
        ((failure-p progress) progress)
        ((eq (car progress) :done) (cadr progress))
        (t (t3-book-sorted-lists-ordered-sort-cases
            (1- n) lib formula
            (t3-book-sorted-lists-ordered-sort-next
             lib formula (cadr progress) (caddr progress))))))

(defun t3-book-sorted-lists-ordered-sort (lib name formula)
  (proof-with-checked-results
      ((lib (t3-book-term-order-build lib))
       (lib (t3-book-sorted-lists-merge-ordered lib))
       (induction (t3-book-sorted-lists-ordered-sort-cases 1000000 lib formula '(:pending nil nil)))
       (entry (proof-proof-entry "theorem" name (list name) (list (car induction)))))
    (cons entry (cdr induction))))
