(in-package "BOYMOO-PROVER")
(set-verify-guards-eagerness 0)

(defconst *t3-formatting-fmt-tilde* (proof-sym "FMT-TILDE-S1" "ACL2"))
(defconst *t3-formatting-margin* (proof-sym "FMT-HARD-RIGHT-MARGIN" "ACL2"))
(defconst *t3-formatting-fmt-predicates*
  (list (proof-sym "FMT-STATE-P" "ACL2")
        (proof-sym "SMALL-NAT-GUARD" "ACL2")
        (proof-sym "FIXNAT-GUARD" "ACL2")
        (proof-sym "UNSIGNED-BYTE-P" "ACL2")
        (proof-sym "INTEGER-RANGE-P" "ACL2")))

(defun t3-formatting-formatting-measure (index end column)
  (t3-size-ordinal-with-phase
   (library-plus *proof-one* (list *library-gap* end index))
   (proof-ite (proof-eq column *proof-zero*) *proof-zero* *proof-one*)))

(defun t3-formatting-right-margin-test (facts column)
  (if (endp facts)
      nil
    (let ((test (caar facts)))
      (proof-with-checked-results
       ((right (and (proof-is-call test *proof-less*) (proof-term-at test 2))))
       (if (and (proof-is-call test *proof-less*) (equal right column)
                (proof-is-call (cadr test) *t3-formatting-margin*))
           (cdar facts)
         (t3-formatting-right-margin-test (cdr facts) column))))))

(defun t3-formatting-nonzero-column (lib phase evidence)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
     ((test (proof-term-at phase 1))
      (column (proof-term-at test 1))
      (evidence (t3-logic-evidence-expand evidence))
      (strict (t3-formatting-right-margin-test (t3-logic-evidence-facts evidence) column)))
     (if (not strict)
         '(:failure "Unsupported" "")
       (proof-with-checked-results
        ((first (proof-step-first strict))
         (margin (proof-term-at first 1))
         (opened (t3-logic-libraryproofs-normalize lib margin nil (list *t3-formatting-margin*)))
         (below (proof-proof-rewrite proof strict opened '(1 1)))
         (equality (proof-step-first opened))
         (margin-value (proof-term-at equality 2))
         (other (t3-logic-evidence-init lib (t3-logic-evidence-tests evidence) nil
                                        *t3-formatting-fmt-predicates*))
         (zero-type (t3-logic-libraryproofs-type-of lib *proof-zero* nil))
         (margin-type (t3-logic-evidence-integer other margin-value))
         (column-type (t3-logic-evidence-integer (cdr margin-type) column))
         (nonnegative (t3-logic-evidence-nonnegative (cdr column-type) margin-value))
         (positive (library-library-cite lib "WEAK-THEN-LESS"
                                         (list *proof-zero* margin-value column)
                                         (list zero-type (car margin-type) (car column-type)
                                               (car nonnegative) below)))
         (nonzero (t3-rational-order-nonzero-from-positive lib positive)))
        (cons nonzero evidence))))))

(defun t3-formatting-descent-by-phase (lib smaller larger evidence)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
     ((after-phase (proof-term-at smaller 3))
      (before-phase (proof-term-at larger 3))
      (not-zero (t3-formatting-nonzero-column lib before-phase evidence))
      (opened (proof-proof-select proof before-phase (car not-zero)))
      (comparison (t3-logic-libraryproofs-prove lib (library-lt after-phase *proof-one*) nil nil))
      (strict (library-library-transport-argument lib comparison opened 2))
      (result (t3-size-phase-descent lib smaller larger strict)))
     (list (car result) (cdr result)
           (if (equal lib (t3-logic-evidence-lib (cdr not-zero)))
               (t3-logic-evidence-with-lib (cdr not-zero) (cdr result))
             (cdr not-zero))))))

(defun t3-formatting-descent-by-gap (lib smaller larger evidence new-size old-size)
  (proof-with-checked-results
   ((start (proof-term-at new-size 2))
    (scanned (t3-scan-infer-scan-result lib start evidence))
    (lib (car scanned))
    (proof (library-library-proof lib))
    (smaller-gap (t3-arithmetic-gap-descent lib new-size old-size (cdr scanned)))
    (new-type (t3-logic-libraryproofs-type-of lib new-size nil))
    (old-type (t3-logic-libraryproofs-type-of lib old-size nil))
    (order (library-library-cite lib "FINITE-ORDER" (list new-size old-size)
                                 (list new-type old-type)))
    (size-bound (proof-proof-rewrite proof (car smaller-gap) order '(1)))
    (bound (t3-size-shift lib size-bound *proof-one* t nil))
    (result (t3-size-coefficient-descent lib smaller larger bound)))
   (list (car result) (cdr result)
         (if (equal lib (t3-logic-evidence-lib (cdr smaller-gap)))
             (t3-logic-evidence-with-lib (cdr smaller-gap) (cdr result))
           (cdr smaller-gap)))))

(defun t3-formatting-formatting-descent (lib smaller larger evidence)
  (proof-with-checked-results
   ((new-coefficient (proof-term-at smaller 2))
    (new-size (proof-term-at new-coefficient 2))
    (old-coefficient (proof-term-at larger 2))
    (old-size (proof-term-at old-coefficient 2)))
   (if (equal new-size old-size)
       (t3-formatting-descent-by-phase lib smaller larger evidence)
     (t3-formatting-descent-by-gap lib smaller larger evidence new-size old-size))))
