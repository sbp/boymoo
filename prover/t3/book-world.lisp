(in-package "BOYMOO-PROVER")
(set-verify-guards-eagerness 0)

(defconst *t3-book-world-plist-world* (proof-sym "PLIST-WORLDP" "ACL2"))
(defconst *t3-book-world-fgetprop* (proof-sym "FGETPROP" "ACL2"))
(defconst *t3-book-world-symbol-list* (proof-sym "SYMBOL-LISTP" "ACL2"))
(defconst *t3-book-world-hard-error* (proof-sym "HARD-ERROR" "ACL2"))
(defconst *t3-book-world-w* (proof-sym "W" "ACL2"))
(defconst *t3-book-world-symbolp* (proof-cl "SYMBOLP"))
(defconst *t3-book-world-default* "T3-FGETPROP-OF-NONSYMBOL")

(defun t3-book-world-component (facts term)
  (let ((entry (assoc-equal term facts)))
    (if entry
        (cdr entry)
      '(:failure "MissingProofInput" ""))))

(defun t3-book-world-world-nonsymbol (lib)
  (let* ((proof (library-library-proof lib))
         (w *t3-book-world-w*)
         (predicate (list *t3-book-world-plist-world* w))
         (lookup (list *t3-book-world-fgetprop* *library-x* *library-y* *library-z* w)))
    (proof-with-checked-results
        ((typed (proof-proof-assume proof predicate t))
         (not-symbol (proof-proof-assume
                      proof (proof-neg (list *t3-book-world-symbolp* *library-x*)) t))
         (not-symbol-term (proof-step-first not-symbol))
         (inner (proof-ite not-symbol-term (proof-eq lookup *library-z*) *proof-true*))
         (formula (proof-ite predicate inner *proof-true*))
         (test (list *proof-consp* w))
         (present (proof-proof-assume proof test t))
         (typed-term (proof-step-first typed))
         (typed-opened (t3-book-spines-shallow lib typed-term (list present)))
         (rewritten (proof-proof-rewrite proof typed typed-opened '(1)))
         (reduced (proof-proof-tidy proof rewritten))
         (components (t3-book-associations-components lib reduced))
         (facts (t3-book-associations-component-facts components nil))
         (key (list *library-car* (list *library-car* w)))
         (key-symbol (t3-book-world-component facts (list *t3-book-world-symbolp* key)))
         (comparison (proof-eq *library-x* key))
         (equal-test (proof-proof-assume proof comparison t))
         (equal-symbol (library-library-transport-argument lib key-symbol equal-test 1))
         (conflict (proof-proof-cut proof equal-symbol not-symbol))
         (mismatch (proof-proof-front proof conflict (proof-neg comparison)))
         (opened (t3-book-spines-shallow lib lookup (list present mismatch)))
         (tail (list *library-cdr* w))
         (pairs (list (list w tail)))
         (measure (list *library-count* w))
         (builtin (library-library-builtin lib 3 w))
         (decrease (proof-proof-discharge proof builtin present))
         (decrease-term (proof-step-first decrease))
         (child (proof-subst formula (list (cons w tail))))
         (ih (proof-proof-assume proof (proof-ite decrease-term child *proof-true*) t))
         (ih-decreased (proof-proof-prove-if proof ih decrease))
         (tail-typed (t3-book-world-component facts (list *t3-book-world-plist-world* tail)))
         (ih-world (proof-proof-prove-if proof ih-decreased tail-typed))
         (ih-result (proof-proof-prove-if proof ih-world not-symbol))
         (yes (proof-proof-chain proof opened (list ih-result)))
         (absent (proof-proof-assume proof test nil))
         (no (t3-book-spines-shallow lib lookup (list absent)))
         (step (proof-proof-cases proof test yes no))
         (inner-step (t3-scan-conclusion lib inner step))
         (case-step (t3-scan-conclusion lib formula inner-step))
         (ordinal (library-library-builtin lib 1 w))
         (result (proof-proof-induct proof ordinal case-step formula measure (list pairs))))
      (library-library-lemma lib *t3-book-world-default* formula result nil))))

(defun t3-book-world-macro-symbol (lib name formula)
  (proof-with-checked-results
      ((lib (t3-book-world-world-nonsymbol lib))
       (proof (library-library-proof lib))
       (test (proof-term-at formula 1))
       (assumption (proof-proof-assume proof test t))
       (premises (proof-proof-conjunct proof assumption))
       (target (proof-term-at formula 2))
       (non-symbol (proof-proof-assume proof target nil))
       (subject (proof-term-at target 1))
       (world-term (proof-step-first (cadr premises)))
       (world (proof-term-at world-term 1))
       (rule (proof-proof-fact
              proof (proof-sym (concatenate 'string "SELF-" *t3-book-world-default*) "ACL2")
              (list (list *library-x* subject)
                    (list *library-y* (proof-quote (proof-sym "MACRO-ARGS" "ACL2")))
                    (list *library-z* *proof-true*)
                    (list *t3-book-world-w* world))))
       (world-rule (proof-proof-prove-if proof rule (cadr premises)))
       (default (proof-proof-prove-if proof world-rule non-symbol))
       (recognized (proof-step-first (car premises)))
       (expanded (t3-book-spines-shallow lib recognized nil))
       (expanded (t3-book-spines-replace-value lib expanded (list default)))
       (value (proof-rewritten-term expanded))
       (normalized (t3-logic-libraryproofs-normalize lib value nil nil))
       (expanded (proof-proof-chain proof expanded (list normalized)))
       (impossible (proof-proof-rewrite proof (car premises) expanded '(1)))
       (impossible (proof-proof-tidy proof impossible))
       (result (proof-proof-front proof impossible target))
       (implication (t3-book-lemmas-implication lib formula result))
       (entry (proof-proof-entry "theorem" name (list name) (list implication))))
    (cons entry lib)))

(defun t3-book-world-signed-list-evidence (lib variable hypothesis evidence)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((found (t3-logic-evidence-find evidence (list *proof-consp* variable))))
      (if (not (car found))
          (cdr found)
        (proof-with-checked-results
            ((builtin (library-library-builtin lib 3 variable))
             (descent (proof-proof-discharge proof builtin (car found)))
             (known (proof-proof-prove-if proof hypothesis descent))
             (literal (proof-step-first known)))
          (t3-logic-evidence-with-facts
           (cdr found)
           (table-put (t3-logic-evidence-facts (cdr found)) literal known)))))))

(defun t3-book-world-signed-list-leaf (value tests lib variable hypothesis predicate element-type)
  (proof-with-checked-results
      ((evidence (t3-logic-evidence-init lib tests nil nil))
       (evidence (t3-book-world-signed-list-evidence lib variable hypothesis evidence)))
    (if (proof-is-call value *t3-book-world-hard-error*)
        (proof-with-checked-results
            ((error-equation (proof-proof-unfold (library-library-proof lib) value))
             (result-term (proof-rewritten-term error-equation))
             (result (t3-book-character-lists-element-list lib predicate element-type
                                                          result-term evidence)))
          (library-library-transport-argument lib result error-equation 1))
      (t3-book-character-lists-element-list lib predicate element-type value evidence))))

(defun t3-book-world-signed-list-by-value
    (n value tests lib variable hypothesis predicate element-type)
  (declare (xargs :measure (nfix n)))
  (let ((proof (library-library-proof lib))
        (template (list predicate *proof-result*)))
    (cond
     ((zp n) '(:failure "Fuel" "t3-book-world-signed-list-by-value"))
     ((proof-is-call value *proof-if*)
      (proof-with-checked-results
          ((branches (proof-list-of-length (cdr value) 3))
           (yes (t3-book-world-signed-list-by-value
                 (1- n) (cadr branches) (append tests (list (list (car branches) t)))
                 lib variable hypothesis predicate element-type))
           (no (t3-book-world-signed-list-by-value
                (1- n) (caddr branches) (append tests (list (list (car branches) nil)))
                lib variable hypothesis predicate element-type)))
        (proof-by-value-join proof value template yes no)))
     (t
      (proof-with-checked-results ((opened (t3-logic-by-value-unfold proof value)))
        (if opened
            (proof-with-checked-results
                ((body (proof-rewritten-term opened))
                 (result (t3-book-world-signed-list-by-value
                          (1- n) body tests lib variable hypothesis predicate element-type))
                 (reverse-opening (proof-proof-symmetric proof opened)))
              (proof-proof-rewrite-result proof result reverse-opening template *proof-result*))
          (proof-with-checked-results
              ((step (t3-book-world-signed-list-leaf value tests lib variable hypothesis
                                                     predicate element-type)))
            (t3-logic-by-value-check-leaf step value template))))))))

(defun t3-book-world-signed-list (lib goal element-type)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((parts (proof-list-of-length goal 2))
         (variable (t3-book-spines-map-parameter lib (cadr parts))))
      (if (not variable)
          '(:failure "Unsupported" "")
        (let* ((tail (list *library-cdr* variable))
               (measure (list *library-count* variable))
               (pairs (list (list variable tail)))
               (smaller (list *proof-ordinal-less* (list *library-count* tail) measure)))
          (proof-with-checked-results
              ((child (proof-subst goal (list (cons variable tail))))
               (hypothesis (proof-proof-assume proof (proof-ite smaller child *proof-true*) t))
               (opened (proof-proof-unfold proof (cadr parts)))
               (body (proof-rewritten-term opened))
               (proved (t3-book-world-signed-list-by-value
                        1000000 body nil lib variable hypothesis (car parts) element-type))
               (case-step (library-library-transport-argument lib proved opened 1))
               (ordinal (library-library-builtin lib 1 variable)))
            (proof-proof-induct proof ordinal case-step goal measure (list pairs))))))))

(defun t3-book-world-required-symbols (lib name formula)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((beta (proof-proof-beta proof formula))
         (goal (proof-rewritten-term beta))
         (result (t3-book-world-signed-list lib goal *t3-book-world-symbolp*))
         (step (proof-proof-transport proof result beta)))
      (proof-proof-entry "theorem" name (list name) (list step)))))
