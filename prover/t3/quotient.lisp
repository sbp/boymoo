(in-package "BOYMOO-PROVER")
(set-verify-guards-eagerness 0)

(defconst *t3-quotient-niq* (proof-sym "NONNEGATIVE-INTEGER-QUOTIENT" "ACL2"))
(defconst *t3-quotient-print-base* (proof-sym "PRINT-BASE-P" "ACL2"))
(defconst *t3-quotient-quotient-lemma* (proof-sym "SELF-T3-NONNEGATIVE-QUOTIENT" "ACL2"))
(defconst *t3-quotient-quotient-interval* (proof-sym "SELF-T3-NONNEGATIVE-QUOTIENT-INTERVAL" "ACL2"))
(defconst *t3-quotient-print-base-lemma* (proof-sym "SELF-T3-PRINT-BASE-RANGE" "ACL2"))

(defun t3-quotient-product (term scale)
  (list *proof-times* scale term))

(defun t3-quotient-division-inputs (numerator denominator)
  (proof-ite (list *library-natp* numerator)
             (proof-ite (library-integer denominator)
                        (library-positive denominator) *proof-false*)
             *proof-false*))

(defun t3-quotient-quotient-claim (numerator denominator value interval)
  (let* ((order (library-le (t3-quotient-product value denominator) numerator))
         (order (if interval
                    (proof-ite order
                               (library-lt numerator
                                           (t3-quotient-product
                                            (library-plus *proof-one* value) denominator))
                               *proof-false*)
                  order))
         (result (proof-ite (list *library-natp* value) order *proof-false*)))
    (proof-ite (t3-quotient-division-inputs numerator denominator) result *proof-true*)))

(defun t3-quotient-step-first (step)
  (if step
      (proof-step-first step)
    '(:failure "failure" "")))

(defun t3-quotient-right-side (step)
  (proof-with-checked-results ((literal (t3-quotient-step-first step)))
    (proof-term-at literal 2)))

(defun t3-quotient-mul-one (lib value typed)
  (proof-with-checked-results
      ((commutes (library-library-axiom lib "COMMUTATIVITY-OF-*" (list value *proof-one*)))
       (unit (library-library-cite lib "T3-RAT-MUL-UNIT" (list value) (list typed))))
    (proof-proof-chain (library-library-proof lib) commutes (list unit))))

(defun t3-quotient-add-product (lib scale offset typed)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((split (library-library-axiom lib "DISTRIBUTIVITY" (list scale *proof-one* offset)))
         (unit (t3-quotient-mul-one lib scale typed))
         (split (proof-proof-rewrite proof split unit '(1 2 1)))
         (commutes (library-library-axiom
                    lib "COMMUTATIVITY-OF-+" (list scale (t3-quotient-product offset scale)))))
      (proof-proof-chain proof split (list commutes)))))

(defun t3-quotient-quotient-base-upper (lib guard ix iy positive-y)
  (let ((proof (library-library-proof lib))
        (y *library-y*)
        (nfix (proof-sym "NFIX" "ACL2"))
        (ifix (proof-sym "IFIX" "ACL2"))
        (sum (library-plus *proof-one* *proof-zero*)))
    (proof-with-checked-results
        ((nonnegative (library-library-cite lib "POSITIVE-NONNEGATIVE" (list y) (list iy positive-y)))
         (nonzero (t3-rational-order-nonzero-from-positive lib positive-y))
         (decision (t3-logic-libraryproofs-normalize
                    lib guard (list ix iy nonnegative nonzero)
                    (list ifix nfix (proof-cl "=") *proof-not*)))
         (edge (proof-proof-assume proof guard t))
         (edge (if decision
                   (proof-proof-rewrite proof edge decision '(1))
                 (t3-quotient-step-first decision)))
         (zero-plus (proof-proof-compute proof sum 1))
         (unit (proof-proof-reflexive proof (t3-quotient-product sum y)))
         (unit (proof-proof-rewrite proof unit zero-plus '(1 2 2)))
         (typed (t3-logic-libraryproofs-rational lib y (list iy)))
         (one (t3-quotient-mul-one lib y typed))
         (unit (proof-proof-chain proof unit (list one))))
      (library-library-transport-argument lib edge unit 2))))

(defun t3-quotient-quotient-induction-zero (tests lib interval ix iy positive-y x-nonnegative claim)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((zero (library-library-cite lib "T3-PRODUCT-ZERO" (list *library-y*) nil))
         (zero (proof-proof-symmetric proof zero))
         (bound (proof-proof-rewrite proof x-nonnegative zero '(1 1 2)))
         (bound (if interval
                    (proof-with-checked-results
                        ((test (proof-term-at (last tests) 0))
                         (guard (proof-term-at test 0))
                         (upper (t3-quotient-quotient-base-upper lib guard ix iy positive-y)))
                      (t3-scan-typed-pair lib bound upper))
                  bound))
         (natural (t3-logic-libraryproofs-natural lib *proof-zero*))
         (pair (t3-scan-typed-pair lib natural bound)))
      (t3-scan-conclusion lib claim pair))))

(defun t3-quotient-quotient-induction-upper
    (lib child-call remaining ir iy it child-upper total typed-y bound)
  (let* ((proof (library-library-proof lib))
         (y *library-y*)
         (offset (library-plus *proof-one* child-call))
         (next-product (t3-quotient-product offset y)))
    (proof-with-checked-results
        ((pt (t3-logic-libraryproofs-type-of lib next-product (list iy it)))
         (upper (library-library-cite lib "LESS-SHIFT" (list remaining next-product y)
                                      (list ir pt iy child-upper)))
         (upper (proof-proof-rewrite proof upper total '(1 1)))
         (distribute (t3-quotient-add-product lib y offset typed-y))
         (upper (library-library-transport-argument lib upper distribute 2)))
      (t3-scan-typed-pair lib bound upper))))

(defun t3-quotient-quotient-induction-recursive
    (child-call tests lib formula interval typed known claim ifix)
  (let ((proof (library-library-proof lib))
        (x *library-x*)
        (y *library-y*)
        (ix (car known))
        (iy (cadr known))
        (positive-y (caddr known)))
    (proof-with-checked-results
        ((remaining (proof-term-at child-call 1))
         (bindings (list (list x remaining)))
         (evidence (t3-logic-evidence-init lib tests known nil))
         (bound-y (t3-logic-evidence-require evidence
                                              (proof-neg (library-lt (list ifix x) y))))
         (raw (t3-logic-libraryproofs-normalize lib (list ifix x) (list ix) (list ifix)))
         (bound-y (if raw
                      (proof-proof-rewrite proof (car bound-y) raw '(1 1 1))
                    (t3-quotient-step-first raw)))
         (iz (t3-logic-libraryproofs-type-of lib *proof-zero* nil))
         (positive-x (library-library-cite lib "LESS-THEN-WEAK" (list *proof-zero* y x)
                                           (list iz iy ix positive-y bound-y)))
         (less (library-library-axiom lib "<-ON-OTHERS" (list x y)))
         (nonnegative-child (proof-proof-rewrite proof bound-y less '(1 1)))
         (ir (t3-logic-libraryproofs-type-of lib remaining known))
         (nr (library-library-cite lib "NATURAL-FROM-BOUNDS" (list remaining)
                                   (list ir nonnegative-child)))
         (lesser (library-library-less-from-difference lib remaining x positive-y known))
         (smaller (library-library-cite lib "NFIX-DECREASE" (list remaining x)
                                        (list ir ix positive-x lesser)))
         (smaller-claim (proof-step-first smaller))
         (instance (proof-subst formula (list (cons x remaining))))
         (ih (proof-proof-assume proof (proof-ite smaller-claim instance *proof-true*) t))
         (hypothesis (proof-proof-prove-if proof ih smaller))
         (types (t3-scan-typed-pair lib nr typed))
         (applied (proof-proof-prove-if proof hypothesis types))
         (parts (proof-proof-conjunct proof applied))
         (nat-child (car parts))
         (bounds (if interval
                     (proof-proof-conjunct proof (cadr parts))
                   (list (cadr parts) nil)))
         (nat-one (t3-logic-libraryproofs-natural lib *proof-one*))
         (natural (library-library-cite lib "NATURAL-SUM" (list *proof-one* child-call)
                                        (list nat-one nat-child)))
         (it (library-library-cite lib "NATURAL-INTEGER" (list child-call) (list nat-child)))
         (product-child (t3-quotient-product child-call y))
         (pt (t3-logic-libraryproofs-type-of lib product-child (list iy it)))
         (typed-y (t3-logic-libraryproofs-rational lib y (list iy)))
         (total (library-library-linear-equal lib (library-plus remaining y) x known))
         (distribute (t3-quotient-add-product lib y child-call typed-y))
         (advance (library-library-cite lib "T3-WEAK-SHIFT" (list product-child remaining y)
                                        (list pt ir iy (car bounds))))
         (advance (proof-proof-rewrite proof advance total '(1 1 1)))
         (reversed (proof-proof-symmetric proof distribute))
         (bound (proof-proof-rewrite proof advance reversed '(1 1 2)))
         (bound (if interval
                    (t3-quotient-quotient-induction-upper
                     lib child-call remaining ir iy it (cadr bounds) total typed-y bound)
                  bound))
         (pair (t3-scan-typed-pair lib natural bound))
         (step (t3-scan-conclusion lib claim pair)))
      (cons step (list bindings)))))

(defun t3-quotient-quotient-induction-leaf (value tests lib formula interval typed known ifix)
  (let ((claim (t3-quotient-quotient-claim *library-x* *library-y* value interval)))
    (cond
     ((equal value *proof-zero*)
      (proof-with-checked-results
          ((step (t3-quotient-quotient-induction-zero
                  tests lib interval (car known) (cadr known) (caddr known) (fifth known) claim)))
        (cons step nil)))
     ((not (proof-is-call value *proof-plus*)) '(:failure "ProofMismatch" ""))
     (t
      (proof-with-checked-results ((one (proof-term-at value 1)))
        (if (not (equal one *proof-one*))
            '(:failure "ProofMismatch" "")
          (proof-with-checked-results ((child-call (proof-term-at value 2)))
            (if (proof-is-call child-call *t3-quotient-niq*)
                (t3-quotient-quotient-induction-recursive
                 child-call tests lib formula interval typed known claim ifix)
              '(:failure "ProofMismatch" "")))))))))

(defun t3-quotient-quotient-induction-leaves (requests lib formula interval typed known ifix)
  (if (endp requests)
      nil
    (proof-with-checked-results
        ((leaf (t3-quotient-quotient-induction-leaf
                (caar requests) (cadar requests) lib formula interval typed known ifix))
         (rest (t3-quotient-quotient-induction-leaves
                (cdr requests) lib formula interval typed known ifix)))
      (cons (cons (cons (car requests) (car leaf)) (car rest))
            (append (cdr leaf) (cdr rest))))))

(defun t3-quotient-quotient-induction (lib interval)
  (let* ((proof (library-library-proof lib))
         (x *library-x*)
         (y *library-y*)
         (call (list *t3-quotient-niq* x y))
         (formula (t3-quotient-quotient-claim x y call interval))
         (template (t3-quotient-quotient-claim x y *proof-result* interval))
         (measure (list *library-nfix* x))
         (ifix (proof-sym "IFIX" "ACL2")))
    (proof-with-checked-results
        ((source (proof-proof-unfold proof call))
         (conditions (proof-proof-assume proof (cadr template) t))
         (parts (proof-proof-conjunct proof conditions))
         (nx (car parts))
         (typed (cadr parts))
         (types (proof-proof-conjunct proof typed))
         (ix (library-library-cite lib "NATURAL-INTEGER" (list x) (list nx)))
         (x-nonnegative (library-library-cite lib "NATURAL-NONNEGATIVE" (list x) (list nx)))
         (known (list ix (car types) (cadr types) nx x-nonnegative))
         (value (t3-quotient-right-side source))
         (requests (t3-logic-libraryproofs-by-value-leaves lib value nil))
         (leaves (t3-quotient-quotient-induction-leaves requests lib formula interval typed known ifix))
         (step (t3-logic-libraryproofs-by-value lib value template (car leaves) nil))
         (reversed (proof-proof-symmetric proof source))
         (step (proof-proof-rewrite-result proof step reversed template *proof-result*))
         (ordinal (library-library-cite lib "NFIX-ORDINAL" (list x) nil))
         (result (proof-proof-induct proof ordinal step formula measure (cdr leaves))))
      (library-library-lemma lib (if interval
                                     "T3-NONNEGATIVE-QUOTIENT-INTERVAL"
                                   "T3-NONNEGATIVE-QUOTIENT")
                             formula result nil))))

(defun t3-quotient-base-claim (term)
  (let ((inverse (list *t3-logic-reciprocal* term)))
    (proof-ite (library-integer term)
               (proof-ite (library-positive term)
                          (proof-ite (library-positive inverse)
                                     (library-lt inverse *proof-one*) *proof-false*)
                          *proof-false*)
               *proof-false*)))

(defun t3-quotient-base-absences (proof options)
  (if (endp options)
      nil
    (proof-with-checked-results
        ((absent (proof-proof-assume proof (car options) nil))
         (rest (t3-quotient-base-absences proof (cdr options))))
      (cons absent rest))))

(defun t3-quotient-print-base-cases (lib options step)
  (if (endp options)
      step
    (let* ((proof (library-library-proof lib))
           (test (car options)))
      (proof-with-checked-results
          ((particular (t3-logic-libraryproofs-prove-formula lib
                                                           (t3-quotient-base-claim (caddr test))
                                                           nil nil))
           (assumed (proof-proof-assume proof test t))
           (reversed (proof-proof-symmetric proof assumed))
           (yes (proof-proof-rewrite-first proof particular reversed))
           (step (proof-proof-cases proof test yes step)))
        (t3-quotient-print-base-cases lib (cdr options) step)))))

(defun t3-quotient-print-base-range (lib)
  (let* ((proof (library-library-proof lib))
         (base (list *t3-quotient-print-base* *library-x*))
         (claim (t3-quotient-base-claim *library-x*))
         (options (list (proof-eq *library-x* (proof-quote 2))
                        (proof-eq *library-x* (proof-quote 8))
                        (proof-eq *library-x* (proof-quote 10))
                        (proof-eq *library-x* (proof-quote 16)))))
    (proof-with-checked-results
        ((base-success (proof-proof-assume proof base t))
         (absent (t3-quotient-base-absences proof options))
         (literal (proof-step-first base-success))
         (no-base (t3-logic-libraryproofs-normalize
                   lib literal absent (list *t3-quotient-print-base* (proof-sym "MEMBER-EQUAL" "ACL2")
                                            *t3-logic-endp* *t3-logic-atom* *proof-not*)))
         (value (t3-quotient-right-side no-base)))
      (if (not (equal value *proof-false*))
          '(:failure "ProofMismatch" "")
        (proof-with-checked-results
            ((reduced (proof-proof-rewrite proof base-success no-base '(1)))
             (no-base (proof-proof-tidy proof reduced))
             (step (proof-proof-subsume proof no-base (cons claim (proof-step-clause no-base))))
             (step (t3-quotient-print-base-cases lib (reverse options) step)))
          (library-library-lemma lib "T3-PRINT-BASE-RANGE" claim step (list (proof-neg literal))))))))

(defun t3-quotient-evidence-after-library (evidence before after)
  (if (equal (t3-logic-evidence-lib evidence) before)
      (t3-logic-evidence-with-lib evidence after)
    evidence))

(defun t3-quotient-infer-positive-value (lib value base ib pb evidence positive-value)
  (if positive-value
      (cons positive-value evidence)
    (proof-with-checked-results
        ((iz (t3-logic-libraryproofs-type-of lib *proof-zero* nil))
         (iv (t3-logic-evidence-integer evidence value))
         (within (t3-logic-evidence-require (cdr iv) (library-le base value)))
         (positive (library-library-cite lib "LESS-THEN-WEAK" (list *proof-zero* base value)
                                         (list iz ib (car iv) pb (car within)))))
      (cons positive (cdr within)))))

(defun t3-quotient-print-ratio (lib value base evidence positive-value)
  (proof-with-checked-results
      ((before lib)
       (lib (if (assoc-equal *t3-quotient-print-base-lemma*
                             (proof-proof-facts (library-library-proof lib)))
                lib
              (t3-quotient-print-base-range lib)))
       (evidence (t3-quotient-evidence-after-library evidence before lib))
       (proof (library-library-proof lib))
       (base-ok (t3-logic-evidence-require evidence (list *t3-quotient-print-base* base)))
       (range (library-library-cite lib "T3-PRINT-BASE-RANGE" (list base) (list (car base-ok))))
       (parts (proof-proof-conjunct proof range))
       (ib (car parts))
       (parts (proof-proof-conjunct proof (cadr parts)))
       (pb (car parts))
       (bounds (proof-proof-conjunct proof (cadr parts)))
       (inferred (t3-quotient-infer-positive-value lib value base ib pb (cdr base-ok) positive-value))
       (positive-value (car inferred))
       (inverse (list *t3-logic-reciprocal* base))
       (sums (t3-rational-order-rational-sums-init lib))
       (inverse-type (t3-rational-order-rational-sums-type-of sums inverse (list ib)))
       (iv (t3-logic-evidence-integer (cdr inferred) value))
       (value-type (t3-logic-libraryproofs-rational lib value (list (car iv))))
       (zero (t3-logic-libraryproofs-prove lib (list *library-rationalp* *proof-zero*) nil nil))
       (one (t3-logic-libraryproofs-prove lib (list *library-rationalp* *proof-one*) nil nil))
       (above (library-library-cite lib "T3-RAT-SCALE" (list *proof-zero* inverse value)
                                    (list zero inverse-type value-type positive-value (car bounds))))
       (zero-product (library-library-cite lib "T3-PRODUCT-ZERO" (list value) nil))
       (above (proof-proof-rewrite proof above zero-product '(1 1)))
       (below (library-library-cite lib "T3-RAT-SCALE" (list inverse *proof-one* value)
                                    (list inverse-type one value-type positive-value (cadr bounds))))
       (unit (t3-quotient-mul-one lib value value-type))
       (below (proof-proof-rewrite proof below unit '(1 2)))
       (ratio (list *proof-times* value inverse))
       (ratio-type (t3-rational-order-rational-sums-type-of sums ratio (list value-type inverse-type))))
    (cons (list (list ratio ratio-type above below ib pb) (cdr iv)) lib)))

(defun t3-quotient-multiply-ratio (lib ratio base base-type base-positive types)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((parts (proof-list-of-length ratio 3))
         (value (cadr parts))
         (inverse (caddr parts))
         (sums (t3-rational-order-rational-sums-init lib))
         (nonzero (t3-rational-order-nonzero-from-positive lib base-positive))
         (inverse-axiom (library-library-axiom lib "INVERSE-OF-*" (list base)))
         (number (t3-logic-libraryproofs-number lib base (list base-type)))
         (premise (t3-scan-typed-pair lib number nonzero))
         (cancel (proof-proof-modus-ponens proof inverse-axiom premise))
         (associates (library-library-axiom lib "ASSOCIATIVITY-OF-*" (list base value inverse)))
         (left (proof-proof-symmetric proof associates))
         (commutes (library-library-axiom lib "COMMUTATIVITY-OF-*" (list base value)))
         (left (proof-proof-rewrite proof left commutes '(1 2 1)))
         (associates (library-library-axiom lib "ASSOCIATIVITY-OF-*" (list value base inverse)))
         (left (proof-proof-chain proof left (list associates)))
         (left (proof-proof-rewrite proof left cancel '(1 2 2)))
         (typed (t3-rational-order-rational-sums-type-of sums value types))
         (unit (t3-quotient-mul-one lib value typed)))
      (proof-proof-chain proof left (list unit)))))

(defun t3-quotient-rounded-numerator-upper (lib numerator denominator inn rn is-one)
  (let* ((proof (library-library-proof lib))
         (sums (t3-rational-order-rational-sums-init lib))
         (next-num (library-plus *proof-one* numerator)))
    (proof-with-checked-results
        ((unit (proof-proof-reflexive proof (t3-quotient-product next-num denominator)))
         (unit (proof-proof-rewrite proof unit is-one '(1 2 1)))
         (rt (t3-rational-order-rational-sums-type-of sums next-num (list rn)))
         (identity (library-library-cite lib "T3-RAT-MUL-UNIT" (list next-num) (list rt)))
         (unit (proof-proof-chain proof unit (list identity)))
         (successor (library-library-cite lib "SUCCESSOR-LARGER" (list numerator) (list inn))))
      (library-library-transport-argument lib successor unit 2))))

(defun t3-quotient-rounded-numerator (tests lib numerator denominator inn rn nat-n upper)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((test (proof-term-at (last tests) 0))
         (guard (proof-term-at test 0))
         (is-one (proof-proof-assume proof guard t))
         (scale (proof-proof-reflexive proof (t3-quotient-product numerator denominator)))
         (scale (proof-proof-rewrite proof scale is-one '(1 2 1)))
         (identity (library-library-cite lib "T3-RAT-MUL-UNIT" (list numerator) (list rn)))
         (scale (proof-proof-chain proof scale (list identity)))
         (weak (library-library-cite lib "WEAK-REFLEXIVE" (list numerator) (list inn)))
         (reversed (proof-proof-symmetric proof scale))
         (weak (proof-proof-rewrite proof weak reversed '(1 1 2)))
         (above (and upper (t3-quotient-rounded-numerator-upper lib numerator denominator inn rn is-one))))
      (list nat-n rn weak above))))

(defun t3-quotient-rounded-niq (rounded lib numerator denominator ind pos-d nat-n lemma upper)
  (if (not (equal rounded (list *t3-quotient-niq* numerator denominator)))
      '(:failure "ProofMismatch" "")
    (let ((proof (library-library-proof lib))
          (sums (t3-rational-order-rational-sums-init lib)))
      (proof-with-checked-results
          ((divisor (t3-scan-typed-pair lib ind pos-d))
           (types (t3-scan-typed-pair lib nat-n divisor))
           (claim (proof-proof-fact proof lemma (list (list *library-x* numerator)
                                                     (list *library-y* denominator))))
           (applied (proof-proof-prove-if proof claim types))
           (parts (proof-proof-conjunct proof applied))
           (nat-q (car parts))
           (typed (library-library-cite lib "NATURAL-INTEGER" (list rounded) (list nat-q)))
           (rat-q (t3-rational-order-rational-sums-type-of sums rounded (list typed)))
           (bounds (if upper
                       (proof-proof-conjunct proof (cadr parts))
                     (list (cadr parts) nil))))
        (list nat-q rat-q (car bounds) (cadr bounds))))))

(defun t3-quotient-rounded-leaf-upper
    (lib rounded value base evidence ratio rr rat-q denominator rd ib pb pos-d product-r above strict)
  (let ((proof (library-library-proof lib))
        (successor (library-plus *proof-one* rounded)))
    (proof-with-checked-results
        ((reversed (proof-proof-symmetric proof product-r))
         (scaled (proof-proof-rewrite proof above reversed '(1 1)))
         (iv (t3-logic-evidence-integer evidence value))
         (rationals (list rr rat-q rd ib (car iv)))
         (order (t3-rational-order-reflect-scale lib scaled ratio successor denominator rationals pos-d))
         (before lib)
         (lib (cdr order))
         (evidence (t3-quotient-evidence-after-library (cdr iv) before lib))
         (proof (library-library-proof lib))
         (sums (t3-rational-order-rational-sums-init lib))
         (succ-type (t3-rational-order-rational-sums-type-of sums successor (list rat-q)))
         (base-type (t3-rational-order-rational-sums-type-of sums base (list ib)))
         (above-input (library-library-cite lib "T3-RAT-SCALE" (list ratio successor base)
                                            (list rr succ-type base-type pb (car order))))
         (cancel (t3-quotient-multiply-ratio lib ratio base ib pb rationals))
         (above-input (proof-proof-rewrite proof above-input cancel '(1 1)))
         (strict (t3-scan-typed-pair lib strict above-input)))
      (cons (list strict evidence) lib))))

(defun t3-quotient-rounded-bounds-leaf
    (rounded tests lib value base evidence ratio rr limit ib pb numerator denominator inn ind
             pos-d rn rd product-r nat-n lemma upper)
  (let ((proof (library-library-proof lib))
        (sums (t3-rational-order-rational-sums-init lib)))
    (proof-with-checked-results
        ((bounds (if (equal rounded numerator)
                     (t3-quotient-rounded-numerator tests lib numerator denominator inn rn nat-n upper)
                   (t3-quotient-rounded-niq rounded lib numerator denominator ind pos-d nat-n lemma upper)))
         (nat-q (car bounds))
         (rat-q (cadr bounds))
         (over (proof-proof-assume proof (library-lt ratio rounded) t))
         (scaled (library-library-cite lib "T3-RAT-SCALE" (list ratio rounded denominator)
                                        (list rr rat-q rd pos-d over)))
         (scaled (proof-proof-rewrite proof scaled product-r '(1 1)))
         (cut (proof-proof-cut proof scaled (caddr bounds)))
         (over-claim (proof-step-first over))
         (under (proof-proof-front proof cut (proof-neg over-claim)))
         (iv (t3-logic-evidence-integer evidence value))
         (rv (t3-rational-order-rational-sums-type-of sums value (list (car iv))))
         (strict (library-library-cite lib "T3-RAT-WEAK-THEN-LESS" (list rounded ratio value)
                                        (list rat-q rr rv under limit)))
         (result (if upper
                     (t3-quotient-rounded-leaf-upper
                      lib rounded value base (cdr iv) ratio rr rat-q denominator rd ib pb pos-d
                      product-r (cadddr bounds) strict)
                   (cons (list strict (cdr iv)) lib)))
         (lib (cdr result))
         (step (t3-scan-typed-pair lib nat-q (caar result))))
      (cons (list step (cadar result)) lib))))

(defun t3-quotient-rounded-leaves
    (requests lib value base evidence ratio rr limit ib pb numerator denominator inn ind
              pos-d rn rd product-r nat-n lemma upper)
  (if (endp requests)
      (cons (list nil evidence) lib)
    (proof-with-checked-results
        ((leaf (t3-quotient-rounded-bounds-leaf
                (caar requests) (cadar requests) lib value base evidence ratio rr limit ib pb
                numerator denominator inn ind pos-d rn rd product-r nat-n lemma upper))
         (rest (t3-quotient-rounded-leaves
                (cdr requests) (cdr leaf) value base (cadar leaf) ratio rr limit ib pb
                numerator denominator inn ind pos-d rn rd product-r nat-n lemma upper)))
      (cons (list (cons (cons (car requests) (caar leaf)) (caar rest)) (cadar rest)) (cdr rest)))))

(defun t3-quotient-rounded-template (value base upper)
  (let ((strict (library-lt *proof-result* value)))
    (proof-ite (list *library-natp* *proof-result*)
               (if upper
                   (proof-ite strict
                              (library-lt value (t3-quotient-product
                                                 (library-plus *proof-one* *proof-result*) base))
                              *proof-false*)
                 strict)
               *proof-false*)))

(defun t3-quotient-rounded-bounds (lib call evidence positive-value upper)
  (let ((lemma (if upper *t3-quotient-quotient-interval* *t3-quotient-quotient-lemma*)))
    (proof-with-checked-results
        ((before lib)
         (lib (if (assoc-equal (proof-sym "SELF-T3-RAT-SCALE" "ACL2")
                               (proof-proof-facts (library-library-proof lib)))
                  lib
                (t3-rational-order-build lib)))
         (lib (if (assoc-equal lemma (proof-proof-facts (library-library-proof lib)))
                  lib
                (t3-quotient-quotient-induction lib upper)))
         (parts (proof-list-of-length call 3))
         (function (car parts))
         (value (cadr parts))
         (base (caddr parts))
         (ratio-info (t3-quotient-print-ratio
                      lib value base (t3-quotient-evidence-after-library evidence before lib) positive-value))
         (lib (cdr ratio-info))
         (evidence (cadar ratio-info))
         (ratio-parts (caar ratio-info))
         (ratio (car ratio-parts))
         (rr (cadr ratio-parts))
         (positive-r (caddr ratio-parts))
         (limit (cadddr ratio-parts))
         (ib (fifth ratio-parts))
         (pb (sixth ratio-parts))
         (proof (library-library-proof lib))
         (numerator (list *t3-rational-numerator* ratio))
         (denominator (list *t3-rational-denominator* ratio))
         (parts (t3-rational-order-ratio-parts lib ratio rr))
         (inn (car parts))
         (ind (cadr parts))
         (pos-d (caddr parts))
         (sums (t3-rational-order-rational-sums-init lib))
         (rn (t3-rational-order-rational-sums-type-of sums numerator (list inn)))
         (rd (t3-rational-order-rational-sums-type-of sums denominator (list ind)))
         (product-r (library-library-cite lib "T3-RATIO-NUMERATOR" (list ratio) (list rr)))
         (zero (t3-logic-libraryproofs-prove lib (list *library-rationalp* *proof-zero*) nil nil))
         (mul-nm (library-library-cite lib "T3-RAT-SCALE" (list *proof-zero* ratio denominator)
                                      (list zero rr rd pos-d positive-r)))
         (zero-product (library-library-cite lib "T3-PRODUCT-ZERO" (list denominator) nil))
         (mul-nm (proof-proof-rewrite proof mul-nm zero-product '(1 1)))
         (positive-n (proof-proof-rewrite proof mul-nm product-r '(1 2)))
         (nonnegative-n (library-library-cite lib "POSITIVE-NONNEGATIVE" (list numerator)
                                              (list inn positive-n)))
         (nat-n (library-library-cite lib "NATURAL-FROM-BOUNDS" (list numerator)
                                      (list inn nonnegative-n)))
         (opened (t3-logic-libraryproofs-normalize lib call nil (list function (proof-cl "="))))
         (nonnegative-n (library-library-cite lib "NATURAL-NONNEGATIVE" (list numerator) (list nat-n)))
         (opened-value (t3-quotient-right-side opened))
         (other-branch (proof-term-at opened-value 3))
         (other (t3-logic-libraryproofs-normalize lib other-branch (list nonnegative-n) (list *proof-not*)))
         (opened (if other
                     (proof-proof-rewrite proof opened other '(1 2 3))
                   (t3-quotient-step-first other)))
         (template (t3-quotient-rounded-template value base upper))
         (opened-value (t3-quotient-right-side opened))
         (requests (t3-logic-libraryproofs-by-value-leaves lib opened-value nil))
         (leaves (t3-quotient-rounded-leaves requests lib value base evidence ratio rr limit ib pb
                                             numerator denominator inn ind pos-d rn rd product-r nat-n lemma upper))
         (lib (cdr leaves))
         (proof (library-library-proof lib))
         (step (t3-logic-libraryproofs-by-value lib opened-value template (caar leaves) nil))
         (reversed (proof-proof-symmetric proof opened))
         (step (proof-proof-rewrite-result proof step reversed template *proof-result*))
         (parts (proof-proof-conjunct proof step))
         (steps (if upper
                    (proof-with-checked-results ((bounds (proof-proof-conjunct proof (cadr parts))))
                      (cons (car parts) bounds))
                  parts)))
      (cons (list steps (cadar leaves)) lib))))

(defun t3-quotient-digit-measure (value)
  (library-plus (list *library-count* value)
                (proof-ite (library-lt value *proof-zero*) *proof-one* *proof-zero*)))

(defun t3-quotient-is-digit-measure (term)
  (if (not (proof-is-call term *proof-plus*))
      nil
    (proof-with-checked-results ((count (proof-term-at term 1)))
      (if (not (proof-is-call count *library-count*))
          nil
        (proof-with-checked-results ((value (proof-term-at count 1)))
          (equal term (t3-quotient-digit-measure value)))))))

(defun t3-quotient-digit-rank-value (lib rank typed sign)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((count-term (proof-term-at rank 1))
         (term (proof-term-at count-term 1))
         (rational (t3-logic-libraryproofs-rational lib term (list typed)))
         (count (t3-rational-count-branch lib term rational typed))
         (magnitude (t3-logic-libraryproofs-simplify lib (list *t3-rational-abs* term)
                                                     (list typed sign) (list *t3-rational-abs*)))
         (count (proof-proof-chain proof count (list magnitude)))
         (result (proof-proof-reflexive proof rank))
         (result (proof-proof-rewrite proof result count '(1 2 1)))
         (phase-term (proof-term-at rank 2))
         (phase (proof-proof-select proof phase-term sign))
         (result (proof-proof-rewrite proof result phase '(1 2 2)))
         (phase-value (t3-quotient-right-side phase)))
      (if (not (equal phase-value *proof-zero*))
          result
        (proof-with-checked-results
            ((add-zero (library-library-cite lib "ADD-ZERO-RIGHT" (list term) (list typed))))
          (proof-proof-chain proof result (list add-zero)))))))

(defun t3-quotient-digit-negative-lift (proof smaller normalized left)
  (if (not normalized)
      left
    (proof-with-checked-results
        ((lift (proof-proof-reflexive proof smaller))
         (lift (proof-proof-rewrite proof lift normalized '(1 2 1 1)))
         (lift (proof-proof-rewrite proof lift normalized '(1 2 2 1 1))))
      (proof-proof-chain proof lift (list left)))))

(defun t3-quotient-digit-descent-negative (lib smaller larger new old old-type sign evidence)
  (proof-with-checked-results
      ((normalized (t3-logic-libraryproofs-normalize
                    lib new (list sign) (list (proof-cl "ABS") (proof-cl "MINUSP"))))
       (actual (if normalized (t3-quotient-right-side normalized) new)))
    (if (not (equal actual (library-minus old)))
        '(:failure "Unsupported" "")
      (proof-with-checked-results
          ((proof (library-library-proof lib))
           (new-type (t3-logic-evidence-integer evidence actual))
           (positive (t3-arithmetic-integer-comparison lib *proof-zero* actual (cdr new-type)))
           (good (library-library-cite lib "POSITIVE-NONNEGATIVE" (list actual)
                                       (list (car new-type) (car positive))))
           (left (t3-quotient-digit-rank-value lib (t3-quotient-digit-measure actual)
                                               (car new-type) good))
           (left (t3-quotient-digit-negative-lift proof smaller normalized left))
           (right (t3-quotient-digit-rank-value lib larger old-type sign))
           (left-value (t3-quotient-right-side left))
           (right-value (t3-quotient-right-side right))
           (strict (t3-arithmetic-integer-comparison lib left-value right-value (cdr positive))))
        (cons (list (car strict) left right (cdr strict)) lib)))))

(defun t3-quotient-digit-descent-nonnegative (lib smaller larger new old old-type evidence)
  (proof-with-checked-results
      ((sign (t3-logic-evidence-require evidence (proof-neg (library-lt old *proof-zero*)))))
    (if (not (or (proof-is-call new (proof-cl "FLOOR"))
                 (proof-is-call new (proof-cl "TRUNCATE"))))
        '(:failure "Unsupported" "")
      (proof-with-checked-results
          ((rounded (t3-quotient-rounded-bounds lib new (cdr sign) nil nil))
           (lib (cdr rounded))
           (steps (caar rounded))
           (natural (car steps))
           (typed (library-library-cite lib "NATURAL-INTEGER" (list new) (list natural)))
           (good (library-library-cite lib "NATURAL-NONNEGATIVE" (list new) (list natural)))
           (left (t3-quotient-digit-rank-value lib smaller typed good))
           (right (t3-quotient-digit-rank-value lib larger old-type (car sign))))
        (cons (list (cadr steps) left right (cadar rounded)) lib)))))

(defun t3-quotient-digit-descent (lib smaller larger evidence)
  (proof-with-checked-results
      ((old-count (proof-term-at larger 1))
       (old (proof-term-at old-count 1))
       (new-count (proof-term-at smaller 1))
       (new (proof-term-at new-count 1))
       (old-type (t3-logic-evidence-integer evidence old))
       (sign (t3-logic-evidence-find (cdr old-type) (library-lt old *proof-zero*)))
       (result (if (car sign)
                   (t3-quotient-digit-descent-negative
                    lib smaller larger new old (car old-type) (car sign) (cdr sign))
                 (t3-quotient-digit-descent-nonnegative
                  lib smaller larger new old (car old-type) (cdr sign))))
       (lib (cdr result))
       (parts (car result))
       (strict (library-library-transport-argument lib (car parts) (cadr parts) 1))
       (strict (library-library-transport-argument lib strict (caddr parts) 2))
       (smaller-type (t3-logic-libraryproofs-type-of lib smaller nil))
       (larger-type (t3-logic-libraryproofs-type-of lib larger nil))
       (order (library-library-cite lib "FINITE-ORDER" (list smaller larger)
                                    (list smaller-type larger-type)))
       (step (proof-proof-transport (library-library-proof lib) strict order)))
    (cons (list step (cadddr parts)) lib)))
