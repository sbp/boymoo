(in-package "BOYMOO-PROVER")
(set-verify-guards-eagerness 0)

(defconst *t3-book-symbol-tables-member* (proof-sym "MEMBER-EQUAL" "ACL2"))
(defconst *t3-book-symbol-tables-strip* (proof-sym "STRIP-CARS" "ACL2"))
(defconst *t3-book-symbol-tables-symbol-table* (proof-sym "SYMBOL-ALISTP" "ACL2"))
(defconst *t3-book-symbol-tables-symbolp* (proof-cl "SYMBOLP"))
(defconst *t3-book-symbol-tables-key-symbol* "T3-KEY-OF-SYMBOL-TABLE")

(defun t3-book-symbol-tables-literal-symbol (lib entry)
  (let* ((proof (library-library-proof lib))
         (book (t3-book-values-make-book-proofs lib nil nil))
         (term (list *t3-book-symbol-tables-symbolp* (list *library-car* entry))))
    (proof-with-checked-results
     ((opened (t3-book-values-book-proofs-normalize book term nil nil))
      (value (and opened (proof-rewritten-term opened))))
     (if (and opened (not (equal value term)))
         (proof-with-checked-results
          ((step (t3-logic-libraryproofs-prove-formula lib value nil nil)))
          (proof-proof-transport proof step opened))
       (t3-logic-libraryproofs-prove-formula lib term nil nil)))))

(defund t3-book-symbol-tables-literal-table-entry (datum recognized lib name)
  (let ((proof (library-library-proof lib))
        (entry (proof-quote datum)))
    (proof-with-checked-results
     ((cell (t3-logic-libraryproofs-prove-formula
             lib (list *proof-consp* entry) nil nil))
      (key (t3-book-symbol-tables-literal-symbol lib entry))
      (recognizer (proof-step-first recognized))
      (tail (proof-term-at recognizer 1))
      (cells (library-library-cite lib name (list entry tail)
                                   (list cell key recognized)))
      (literal-term (proof-step-first cells))
      (cons-term (proof-term-at literal-term 1))
      (literal (or (t3-logic-libraryproofs-constant lib cons-term)
                   '(:failure "failure" "")))
      (rewritten (proof-proof-rewrite proof cells literal '(1 1))))
     (proof-proof-tidy proof rewritten))))

(defun t3-book-symbol-tables-literal-table-entries (entries recognized lib name)
  (declare (xargs :measure (acl2-count entries)))
  (if (endp entries)
      recognized
    (proof-with-checked-results
     ((recognized (t3-book-symbol-tables-literal-table-entry (car entries) recognized lib name)))
     (t3-book-symbol-tables-literal-table-entries (cdr entries) recognized lib name))))

(defun t3-book-symbol-tables-literal-table (lib value)
  (proof-with-checked-results
   ((data (if (proof-is-call value *proof-quote*)
              (proof-term-at value 1)
            '(:failure "Unsupported" ""))))
   (if (not (proof-compound data))
       '(:failure "Unsupported" "")
     (let* ((proof (library-library-proof lib))
            (cell (list *proof-consp* *library-x*))
            (typed (list *t3-book-symbol-tables-symbolp* (list *library-car* *library-x*)))
            (tail (list *t3-book-symbol-tables-symbol-table* *library-y*))
            (target (list *t3-book-symbol-tables-symbol-table*
                          (list *proof-cons* *library-x* *library-y*)))
            (name "T3-SYMBOL-TABLE-CONS"))
       (proof-with-checked-results
        ((cell-proof (proof-proof-assume proof cell t))
         (typed-proof (proof-proof-assume proof typed t))
         (equation (t3-book-spines-shallow lib target (list cell-proof typed-proof)))
         (tail-proof (proof-proof-assume proof tail t))
         (constructed (proof-proof-transport proof tail-proof equation))
         (lib (library-library-lemma lib name target constructed
                                     (list (proof-neg cell) (proof-neg typed) (proof-neg tail))))
         (recognized (t3-logic-libraryproofs-prove-formula
                      lib (list *t3-book-symbol-tables-symbol-table* *proof-false*)
                      (list *t3-book-symbol-tables-symbol-table* *t3-logic-atom*
                            *proof-not* (proof-cl "EQ"))
                      nil))
         (recognized (t3-book-symbol-tables-literal-table-entries
                      (reverse data) recognized lib name)))
        (cons recognized lib))))))

(defun t3-book-symbol-tables-symbol-keys-inspect (guard lib member)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
     ((key-term (proof-term-at member 2))
      (keys (t3-book-spines-shallow lib key-term (list guard)))
      (reflexive (proof-proof-reflexive proof member))
      (visible (t3-book-spines-replace-value lib reflexive (list keys)))
      (value (proof-rewritten-term visible))
      (expanded (t3-book-spines-shallow lib value nil)))
     (proof-proof-chain proof visible (list expanded)))))

(defun t3-book-symbol-tables-symbol-keys (lib)
  (let* ((proof (library-library-proof lib))
         (table (list *t3-book-symbol-tables-symbol-table* *library-x*))
         (member (list *t3-book-symbol-tables-member* *library-y*
                       (list *t3-book-symbol-tables-strip* *library-x*)))
         (goal (list *t3-book-symbol-tables-symbolp* *library-y*))
         (inner (proof-ite member goal *proof-true*))
         (formula (proof-ite table inner *proof-true*))
         (test (list *proof-consp* *library-x*)))
    (proof-with-checked-results
     ((typed (proof-proof-assume proof table t))
      (contained (proof-proof-assume proof member t))
      (cons-case (proof-proof-assume proof test t))
      (atom-case (proof-proof-assume proof test nil))
      (shape (t3-book-spines-shallow lib table (list cons-case)))
      (rewritten (proof-proof-rewrite proof typed shape '(1)))
      (rewritten (proof-proof-tidy proof rewritten))
      (parts (t3-book-associations-components lib rewritten))
      (parts (proof-list-of-length parts 3))
      (hypothesis (t3-list-bounds-tail-hypothesis lib formula cons-case))
      (tail-rule (proof-proof-prove-if proof hypothesis (caddr parts)))
      (search (t3-book-symbol-tables-symbol-keys-inspect cons-case lib member))
      (search-term (proof-rewritten-term search))
      (comparison (proof-term-at search-term 1))
      (found (proof-proof-assume proof comparison t))
      (yes (library-library-transport-argument lib (cadr parts) found 1))
      (denied (proof-proof-if-false proof search-term))
      (advance (proof-proof-chain proof search (list denied)))
      (remaining (proof-proof-rewrite proof contained advance '(1)))
      (remaining (proof-proof-tidy proof remaining))
      (no (proof-proof-prove-if proof tail-rule remaining))
      (step (proof-proof-cases proof comparison yes no))
      (inspection (t3-book-symbol-tables-symbol-keys-inspect atom-case lib member))
      (empty (proof-proof-rewrite proof contained inspection '(1)))
      (empty (proof-proof-tidy proof empty))
      (base (proof-proof-subsume proof empty
                                 (proof-unique (cons goal (proof-step-clause empty)))))
      (step (t3-scan-conclusion lib inner step))
      (step (t3-scan-conclusion lib formula step))
      (base (t3-scan-conclusion lib inner base))
      (base (t3-scan-conclusion lib formula base))
      (induction (t3-list-bounds-tail-induction lib formula step base)))
     (library-library-lemma lib *t3-book-symbol-tables-key-symbol* formula induction nil))))

(defun t3-book-symbol-tables-primitive-symbol (lib name formula)
  (proof-with-checked-results
   ((lib (t3-book-symbol-tables-symbol-keys lib))
    (hypothesis (proof-term-at formula 1))
    (assumed (proof-proof-assume (library-library-proof lib) hypothesis t))
    (expanded (t3-book-spines-shallow lib hypothesis nil))
    (expansion (proof-rewritten-term expanded))
    (membership (proof-term-at expansion 1))
    (membership (proof-list-of-length membership 3)))
   (let ((table-form (caddr membership)))
     (if (not (proof-is-call table-form *t3-book-symbol-tables-strip*))
         '(:failure "Unsupported" "")
       (proof-with-checked-results
        ((table (proof-term-at table-form 1))
         (literal-table (t3-book-symbol-tables-literal-table lib table)))
        (let ((lib (cdr literal-table))
              (proof (library-library-proof (cdr literal-table)))
              (typed (car literal-table)))
          (proof-with-checked-results
           ((rewritten (proof-proof-rewrite proof assumed expanded '(1)))
            (rewritten (proof-proof-tidy proof rewritten))
            (conjuncts (proof-proof-conjunct proof rewritten))
            (goal (proof-term-at formula 2))
            (value (proof-term-at goal 1))
            (key (library-library-cite lib *t3-book-symbol-tables-key-symbol*
                                       (list table value) nil))
            (key (proof-proof-prove-if proof key typed))
            (key (proof-proof-prove-if proof key (car conjuncts)))
            (implication (t3-book-lemmas-implication lib formula key))
            (entry (proof-proof-entry "theorem" name (list name) (list implication))))
           (cons entry lib))))))))
