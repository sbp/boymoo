(in-package "BOYMOO-PROVER")
(set-verify-guards-eagerness 0)

(defconst *t3-genvar-genvar* (proof-sym "GENVAR1" "ACL2"))
(defconst *t3-genvar-guard* (proof-sym "GENVAR1-GUARDP" "ACL2"))
(defconst *t3-genvar-gsym* (proof-sym "GSYM" "ACL2"))
(defconst *t3-genvar-legal* (proof-sym "LEGAL-VARIABLEP" "ACL2"))
(defconst *t3-genvar-legal-name* (proof-sym "LEGAL-VARIABLE-OR-CONSTANT-NAMEP" "ACL2"))
(defconst *t3-genvar-package* (proof-sym "SYMBOL-PACKAGE-NAME" "ACL2"))
(defconst *t3-genvar-imports* (proof-sym "PKG-IMPORTS" "ACL2"))
(defconst *t3-genvar-intern* (proof-sym "INTERN-IN-PACKAGE-OF-SYMBOL" "ACL2"))
(defconst *t3-genvar-symbolp* (proof-cl "SYMBOLP"))
(defconst *t3-genvar-char* (proof-cl "CHAR"))
(defconst *t3-genvar-nth* (proof-cl "NTH"))
(defconst *t3-genvar-eql* (proof-cl "EQL"))
(defconst *t3-genvar-common-lisp* (proof-quote '("str" "COMMON-LISP")))
(defconst *t3-genvar-keyword* (proof-quote '("str" "KEYWORD")))
(defconst *t3-genvar-star* (proof-quote '("char" 42)))
(defconst *t3-genvar-ampersand* (proof-quote '("char" 38)))

(defun t3-genvar-package-name (symbol)
  (list *t3-genvar-package* symbol))

(defun t3-genvar-package-imports (witness)
  (list *t3-genvar-imports* (t3-genvar-package-name witness)))

(defun t3-genvar-genvar-measure (formals)
  (proof-with-checked-results ((parts (proof-list-of-length formals 4)))
    (let ((witness (car parts))
          (avoid (caddr parts))
          (counter (cadddr parts)))
      (list *library-gap*
            (library-plus (t3-name-bounds-name-total avoid)
                          (t3-name-bounds-name-total (t3-genvar-package-imports witness)))
            counter))))

(defun t3-genvar-name-conditions (symbol)
  (let* ((name (list *t3-name-bounds-symbol-name* symbol))
         (first (list *t3-genvar-char* name *proof-zero*)))
    (list (list *t3-genvar-symbolp* symbol)
          (proof-neg (proof-eq (t3-genvar-package-name symbol) *t3-genvar-common-lisp*))
          (proof-neg (proof-eq (t3-genvar-package-name symbol) *t3-genvar-keyword*))
          (proof-neg (proof-eq (list *t3-logic-length* name) *proof-zero*))
          (proof-neg (proof-eq first *t3-genvar-star*))
          (proof-neg (proof-eq first *t3-genvar-ampersand*)))))

(defun t3-genvar-common-lisp-arm-p (term)
  (if (not (proof-is-call term *proof-if*))
      nil
    (proof-with-checked-results ((test (proof-term-at term 1)))
      (if (not (equal test (proof-eq (t3-genvar-package-name *library-x*)
                                   *t3-genvar-common-lisp*)))
          nil
        (proof-with-checked-results ((otherwise (proof-term-at term 3)))
          (equal otherwise (proof-quote (proof-cl "VARIABLE"))))))))

(mutual-recursion
 (defun t3-genvar-common-lisp-name-arm-visit (n lib term path)
   (declare (xargs :measure (nfix n)))
   (cond
    ((zp n) '(:failure "Fuel" "t3-genvar-common-lisp-name-arm-visit"))
    ((or (not (proof-compound term)) (proof-is-call term *proof-quote*)) nil)
    ((endp term) '(:failure "failure" ""))
    ((or (proof-compound (car term)) (member-equal (car term) *t3-logic-wrappers*))
     (let ((proof (library-library-proof lib)))
       (proof-with-checked-results
           ((opened (if (proof-compound (car term))
                        (proof-proof-beta proof term)
                      (proof-proof-unfold proof term)))
            (body (proof-rewritten-term opened))
            (found (t3-genvar-common-lisp-name-arm-visit (1- n) lib body path)))
         (and found (cons (cons (list opened path) (car found)) (cdr found))))))
    (t (proof-with-checked-results ((matches (t3-genvar-common-lisp-arm-p term)))
         (if matches
             (list nil (caddr term) (append path '(2)))
           (t3-genvar-common-lisp-name-arm-parts (1- n) lib (cdr term) path 1))))))
 (defun t3-genvar-common-lisp-name-arm-parts (n lib parts path index)
   (declare (xargs :measure (nfix n)))
   (cond ((zp n) '(:failure "Fuel" "t3-genvar-common-lisp-name-arm-parts"))
         ((endp parts) nil)
         (t (proof-with-checked-results
                ((found (t3-genvar-common-lisp-name-arm-visit
                         (1- n) lib (car parts) (append path (list index)))))
              (or found (t3-genvar-common-lisp-name-arm-parts
                         (1- n) lib (cdr parts) path (1+ index))))))))

(defun t3-genvar-common-lisp-name-arm (lib term path)
  (t3-genvar-common-lisp-name-arm-visit 1000000 lib term path))

(defun t3-genvar-rewrite-openings (proof equation openings)
  (declare (xargs :measure (acl2-count openings)))
  (if (endp openings)
      equation
    (proof-with-checked-results
        ((next (proof-proof-rewrite proof equation (caar openings)
                                    (append '(1 2) (cadar openings)))))
      (t3-genvar-rewrite-openings proof next (cdr openings)))))

(defun t3-genvar-legal-name-equation (lib)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((equation (proof-proof-unfold proof (list *t3-genvar-legal-name* *library-x*)))
         (value (proof-rewritten-term equation))
         (arm (t3-genvar-common-lisp-name-arm lib value nil)))
      (if (not arm)
          '(:failure "Unsupported" "")
        (proof-with-checked-results
            ((equation (t3-genvar-rewrite-openings proof equation (car arm)))
             (name (proof-sym "T3-COMMON-LISP-NAME-TESTS" "ACL2"))
             (lib (library-library-definition lib name (list *library-x*) (cadr arm)))
             (proof (library-library-proof lib))
             (unfolded (proof-proof-unfold proof (list name *library-x*)))
             (folded (proof-proof-symmetric proof unfolded))
             (result (proof-proof-rewrite proof equation folded (append '(1 2) (caddr arm)))))
          (cons result lib))))))

(defun t3-genvar-assumptions (proof conditions)
  (if (endp conditions)
      nil
    (proof-with-checked-results
        ((premise (proof-proof-assume proof (car conditions) t))
         (rest (t3-genvar-assumptions proof (cdr conditions))))
      (cons premise rest))))

(defun t3-genvar-different-value (lib ordinary-package value)
  (let ((test (proof-eq *library-x* value))
        (proof (library-library-proof lib)))
    (proof-with-checked-results
        ((equal-test (proof-proof-assume proof test t))
         (conflict (proof-proof-rewrite proof ordinary-package equal-test '(1 1 1 1)))
         (package (proof-proof-compute proof (t3-genvar-package-name value)
                                       (cadr *t3-genvar-common-lisp*)))
         (conflict (proof-proof-rewrite proof conflict package '(1 1 1)))
         (conflict (t3-logic-libraryproofs-simplify-first lib conflict nil (list *proof-not*))))
      (proof-proof-front proof conflict (proof-neg test)))))

(defun t3-genvar-ordinary-variable-name (lib)
  (let ((proof (library-library-proof lib))
        (conditions (t3-genvar-name-conditions *library-x*))
        (goal (list *t3-genvar-legal* *library-x*)))
    (proof-with-checked-results
        ((premises (t3-genvar-assumptions proof conditions))
         (different-true (t3-genvar-different-value lib (cadr premises) *proof-true*))
         (different-false (t3-genvar-different-value lib (cadr premises) *proof-false*))
         (opened (proof-proof-unfold proof goal))
         (legal-name (t3-genvar-legal-name-equation lib))
         (lib (cdr legal-name))
         (proof (library-library-proof lib))
         (equation (proof-proof-rewrite proof opened (car legal-name) '(1 2 1)))
         (body (proof-rewritten-term equation))
         (result (t3-logic-libraryproofs-prove-formula
                  lib body (list *t3-genvar-eql* (proof-cl "EQ") (proof-cl "=") *proof-not*)
                  (append premises (list different-true different-false))))
         (transported (proof-proof-transport proof result equation)))
      (library-library-lemma lib "T3-LEGAL-ORDINARY-NAME" goal transported
                             (library-guards conditions)))))

(defun t3-genvar-capacity-of-generated-name (lib characters lower counter nat-counter)
  (proof-with-checked-results
      ((n-type (library-library-cite lib "NATURAL-INTEGER" (list counter) (list nat-counter)))
       (parts (proof-list-of-length characters 3))
       (span-types (t3-digit-capacity-capacity-type lib (caddr parts)))
       (appended (t3-digit-capacity-append-capacity lib (cadr parts) (caddr parts) span-types))
       (lib (cdr appended))
       (joint-types (t3-digit-capacity-capacity-type lib characters))
       (advance (library-library-cite lib "SUCCESSOR-LARGER" (list counter) (list n-type)))
       (types (list n-type (car span-types) (car joint-types)))
       (partial (t3-size-chain lib advance lower types))
       (result (t3-size-chain lib partial (car appended) types)))
    (cons result lib)))

(defun t3-genvar-symbol-name-equality (lib candidate string witness stringp symbolp)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((law (proof-proof-fact proof (proof-sym "SYMBOL-NAME-INTERN-IN-PACKAGE-OF-SYMBOL" "ACL2")
                                (list (list (proof-sym "S" "ACL2") string)
                                      (list (proof-sym "ANY-SYMBOL" "ACL2") witness))))
         (paired (t3-scan-typed-pair lib stringp symbolp))
         (result (proof-proof-modus-ponens proof law paired))
         (reverse-candidate (proof-proof-symmetric proof candidate)))
      (proof-proof-rewrite proof result reverse-candidate '(1 1 1)))))

(defun t3-genvar-prefix-observations (lib chars string joined-cons coercion join)
  (let* ((proof (library-library-proof lib))
         (first-character (list *t3-genvar-char* string *proof-zero*))
         (tail (list *library-len* (list *library-cdr* chars))))
    (proof-with-checked-results
        ((open-char (proof-proof-unfold proof first-character))
         (open-char (proof-proof-rewrite proof open-char coercion '(1 2 2)))
         (opened (proof-rewritten-term open-char))
         (head (t3-list-bounds-endp-branch lib opened joined-cons))
         (head-value (proof-rewritten-term head))
         (normal-head (t3-logic-libraryproofs-normalize
                       lib head-value nil (list *t3-logic-zp* *proof-not*)))
         (head (proof-proof-chain proof head (list normal-head)))
         (first (proof-proof-chain proof open-char (list head)))
         (first (proof-proof-rewrite proof first join '(1 2 1)))
         (first-value (proof-rewritten-term first))
         (normalized (t3-logic-libraryproofs-normalize lib first-value nil nil))
         (first (proof-proof-chain proof first (list normalized)))
         (string-type (t3-list-bounds-string-assertion lib chars))
         (length-step (t3-logic-libraryproofs-simplify
                       lib (list *t3-logic-length* string)
                       (list string-type) (list *t3-logic-length*)))
         (length-step (proof-proof-rewrite proof length-step coercion '(1 2 1)))
         (expanded (proof-proof-unfold proof (list *library-len* chars)))
         (length-body (proof-rewritten-term expanded))
         (selected (proof-proof-select proof length-body joined-cons))
         (expanded (proof-proof-chain proof expanded (list selected)))
         (length-step (proof-proof-chain proof length-step (list expanded)))
         (tail-natural (t3-logic-libraryproofs-natural lib tail))
         (nonnegative (library-library-cite lib "NATURAL-NONNEGATIVE"
                                             (list tail) (list tail-natural)))
         (tail-type (t3-logic-libraryproofs-type-of lib tail nil))
         (size (library-library-cite lib "POSITIVE-ONE-PLUS"
                                      (list tail) (list tail-type nonnegative)))
         (positive (library-library-transport-argument lib size length-step 2))
         (nonzero (t3-rational-order-nonzero-from-positive lib positive)))
      (list first nonzero))))

(defun t3-genvar-package-facts (proof witness source-package evidence packages)
  (declare (xargs :measure (acl2-count packages)))
  (if (endp packages)
      (cons nil evidence)
    (proof-with-checked-results
        ((target (proof-neg (proof-eq (t3-genvar-package-name witness) (car packages))))
         (found (t3-logic-evidence-require evidence target))
         (reversed (proof-proof-symmetric proof source-package))
         (step (proof-proof-rewrite-first proof (car found) reversed))
         (rest (t3-genvar-package-facts proof witness source-package (cdr found) (cdr packages))))
      (cons (cons step (car rest)) (cdr rest)))))

(defun t3-genvar-prefix-facts (proof prefix char-equation name-eq evidence marks)
  (declare (xargs :measure (acl2-count marks)))
  (if (endp marks)
      (cons nil evidence)
    (proof-with-checked-results
        ((target (proof-neg (proof-eq (list *library-car* prefix) (car marks))))
         (found (t3-logic-evidence-require evidence target))
         (reversed-char (proof-proof-symmetric proof char-equation))
         (step (proof-proof-rewrite-first proof (car found) reversed-char))
         (reversed-name (proof-proof-symmetric proof name-eq))
         (step (proof-proof-rewrite-first proof step reversed-name))
         (rest (t3-genvar-prefix-facts proof prefix char-equation name-eq (cdr found) (cdr marks))))
      (cons (cons step (car rest)) (cdr rest)))))

(defun t3-genvar-legal-candidate
    (lib witness prefix candidate-eq evidence joined string coercion name-eq no-import)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((equation (proof-step-first candidate-eq))
         (candidate (proof-term-at equation 1))
         (symbol (library-library-axiom lib "SYMBOLP-INTERN-IN-PACKAGE-OF-SYMBOL"
                                        (list string witness)))
         (reverse-candidate (proof-proof-symmetric proof candidate-eq))
         (symbol (proof-proof-rewrite proof symbol reverse-candidate '(1 1)))
         (symbol-wit (t3-logic-evidence-require evidence (list *t3-genvar-symbolp* witness)))
         (source-package (library-library-axiom
                          lib "SYMBOL-PACKAGE-NAME-INTERN-IN-PACKAGE-OF-SYMBOL"
                          (list string witness)))
         (type-string (t3-list-bounds-string-assertion lib joined))
         (typed-witness (t3-scan-typed-pair lib (car symbol-wit) no-import))
         (known (t3-scan-typed-pair lib type-string typed-witness))
         (source-package (proof-proof-modus-ponens proof source-package known))
         (reverse-candidate (proof-proof-symmetric proof candidate-eq))
         (source-package (proof-proof-rewrite proof source-package reverse-candidate '(1 1 1)))
         (package-facts (t3-genvar-package-facts
                         proof witness source-package (cdr symbol-wit)
                         (list *t3-genvar-common-lisp* *t3-genvar-keyword*)))
         (right (proof-term-at joined 2))
         (prefix-cons (t3-logic-evidence-require (cdr package-facts) (list *proof-consp* prefix)))
         (join-eq (t3-list-bounds-append-branch lib prefix right (car prefix-cons)))
         (joined-value (proof-rewritten-term join-eq))
         (is-cons (proof-proof-fact proof "consp-cons"
                                    (seq-zip (list *library-x* *library-y*) (cdr joined-value))))
         (joined-cons (library-library-transport-argument lib is-cons join-eq 1))
         (observations (t3-genvar-prefix-observations lib joined string joined-cons coercion join-eq))
         (reverse-name (proof-proof-symmetric proof name-eq))
         (length-step (proof-proof-rewrite-first proof (cadr observations) reverse-name))
         (ordinary (t3-genvar-prefix-facts proof prefix (car observations) name-eq (cdr prefix-cons)
                                           (list *t3-genvar-star* *t3-genvar-ampersand*)))
         (result (library-library-cite lib "T3-LEGAL-ORDINARY-NAME" (list candidate)
                                       (cons symbol (append (car package-facts)
                                                            (cons length-step (car ordinary)))))))
      (cons result (cdr ordinary)))))

(defun t3-genvar-matching-gap-p (base next-counter larger counter)
  (proof-with-checked-results ((larger-base (proof-term-at larger 1)))
    (and (equal base larger-base)
         (proof-with-checked-results ((larger-counter (proof-term-at larger 2)))
           (and (equal counter larger-counter)
                (equal next-counter (library-plus *proof-one* counter)))))))

(defun t3-genvar-gap-from-list
    (lib smaller larger counter nat-counter named below member chosen other first)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((parts (proof-list-of-length (cdr smaller) 2))
         (base (car parts))
         (next-counter (cadr parts))
         (matches (t3-genvar-matching-gap-p base next-counter larger counter)))
      (if (not matches)
          '(:failure "failure" "")
        (proof-with-checked-results
            ((measured (t3-name-bounds-available-member-bound lib member))
             (measured (if first
                           (proof-proof-rewrite proof measured named '(1 1 2 1 1))
                         measured))
             (name-string (proof-rewritten-term named))
             (capacity-types (t3-digit-capacity-capacity-type
                              lib (t3-list-bounds-string-to-chars name-string)))
             (chosen-type (t3-name-bounds-total-integer lib chosen))
             (other-type (t3-name-bounds-total-integer lib other))
             (integers (list chosen-type other-type))
             (other-natural (t3-name-bounds-total-natural lib other))
             (other-bound (library-library-cite lib "NATURAL-NONNEGATIVE"
                                                (list (t3-name-bounds-name-total other))
                                                (list other-natural)))
             (total (t3-size-sum-at-least lib (t3-name-bounds-name-total chosen)
                                         other-bound integers first))
             (n-type (library-library-cite lib "NATURAL-INTEGER"
                                           (list counter) (list nat-counter)))
             (first-bound (t3-size-chain lib below measured
                                         (cons n-type (cons (car capacity-types) integers))))
             (inside (t3-size-chain lib first-bound total (cons n-type integers)))
             (advances (library-library-cite lib "SUCCESSOR-LARGER"
                                             (list counter) (list n-type)))
             (base-type (t3-logic-libraryproofs-type-of lib base integers))
             (next-type (t3-logic-libraryproofs-type-of lib next-counter (list n-type))))
          (library-library-cite lib "GAP-DECREASE" (list base counter next-counter)
                                (list base-type n-type next-type inside advances)))))))

(defun t3-genvar-positive-tests (tests found)
  (if (endp tests)
      (proof-list-of-length (reverse found) 2)
    (proof-with-checked-results ((parts (proof-list-of-length (car tests) 2)))
      (if (cadr parts)
          (if (consp (cdr found))
              '(:failure "Unproved" "")
            (t3-genvar-positive-tests (cdr tests) (cons (car parts) found)))
        (t3-genvar-positive-tests (cdr tests) found)))))

(defun t3-genvar-descend-rejection
    (lib goal smaller larger raw-reject witness prefix avoid counter guard natural
     joined string inverse candidate candidate-eq named below)
  (let ((proof (library-library-proof lib))
        (table (t3-genvar-package-imports witness)))
    (proof-with-checked-results
        ((reject (proof-proof-assume proof raw-reject t))
         (equality (t3-logic-libraryproofs-normalize lib raw-reject nil nil))
         (reject (if equality
                     (proof-with-checked-results ((rewritten (proof-proof-rewrite proof reject equality '(1))))
                       (proof-proof-tidy proof rewritten))
                   reject))
         (test (proof-step-first reject)))
      (if (not (proof-is-call test *proof-if*))
          '(:failure "failure" "")
        (let ((in-avoid (list *t3-name-bounds-member-equal* candidate avoid))
              (in-imports (list *t3-name-bounds-member-name* string table)))
          (proof-with-checked-results ((first-test (proof-term-at test 1)))
            (if (not (equal first-test in-avoid))
                '(:failure "failure" "")
              (proof-with-checked-results
                  ((avoid-test (proof-proof-assume proof in-avoid t))
                   (from-avoid (t3-genvar-gap-from-list lib smaller larger counter natural named
                                                       below avoid-test avoid table t))
                   (imports-test (proof-proof-assume proof in-imports t))
                   (from-imports (t3-genvar-gap-from-list lib smaller larger counter natural named
                                                         below imports-test table avoid nil))
                   (not-avoided (proof-proof-assume proof in-avoid nil))
                   (else-branch (proof-proof-select proof test not-avoided))
                   (no-legal (proof-proof-rewrite proof reject else-branch '(1)))
                   (no-legal (proof-proof-tidy proof no-legal))
                   (no-legal-term (proof-step-first no-legal))
                   (normalized (t3-logic-libraryproofs-normalize lib no-legal-term nil nil))
                   (no-legal (if normalized
                                 (proof-with-checked-results
                                     ((rewritten (proof-proof-rewrite proof no-legal normalized '(1))))
                                   (proof-proof-tidy proof rewritten))
                               no-legal))
                   (no-import (proof-proof-assume proof in-imports nil))
                   (permitted (t3-genvar-legal-candidate lib witness prefix candidate-eq guard joined
                                                         string inverse named no-import))
                   (conflict (proof-proof-cut proof (car permitted) no-legal))
                   (impossible (proof-proof-subsume proof conflict
                                                     (cons goal (proof-step-clause conflict))))
                   (inner (proof-proof-cases proof in-imports from-imports impossible)))
                (proof-proof-cases proof in-avoid from-avoid inner)))))))))

(defun t3-genvar-descent (lib goal call)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((parts (proof-list-of-length goal 3))
         (tests (t3-genvar-positive-tests (termination-call-tests call) nil))
         (raw-guard (car tests))
         (equation (t3-logic-libraryproofs-normalize lib raw-guard nil nil))
         (guard-term (if equation (proof-rewritten-term equation) raw-guard))
         (guard-parts (proof-list-of-length guard-term 5))
         (witness (cadr guard-parts))
         (prefix (caddr guard-parts))
         (avoid (cadddr guard-parts))
         (counter (car (cddddr guard-parts)))
         (guard (t3-logic-evidence-init lib (list (list raw-guard t)) nil
                                        (list *t3-genvar-guard* *t3-genvar-eql*)))
         (natural (t3-logic-evidence-require guard (list *library-natp* counter)))
         (prefix-type (t3-logic-evidence-require (cdr natural) (list *t3-list-bounds-char-list* prefix)))
         (expansion (t3-digit-capacity-decimal-expansion lib counter (car natural)))
         (digit-list (proof-step-first (car expansion)))
         (digits (proof-term-at digit-list 1))
         (joined (list *t3-list-bounds-append* prefix digits))
         (append-theorem (library-library-cite lib "T3-CHARACTER-LIST-APPEND" (cdr joined) nil))
         (typed (t3-scan-typed-pair lib (car prefix-type) (car expansion)))
         (all-chars (proof-proof-prove-if proof append-theorem typed))
         (coerce-inverse (t3-list-bounds-string-list-inverse lib all-chars))
         (string (t3-list-bounds-chars-to-string joined))
         (candidate-eq (proof-proof-unfold proof (list *t3-genvar-gsym* witness prefix counter)))
         (candidate-value (proof-rewritten-term candidate-eq))
         (normalized (t3-logic-libraryproofs-normalize lib candidate-value nil nil))
         (candidate-eq (proof-proof-chain proof candidate-eq (list normalized)))
         (candidate-literal (proof-step-first candidate-eq))
         (candidate (proof-term-at candidate-literal 1))
         (stringp (t3-list-bounds-string-assertion lib joined))
         (symbolp (t3-logic-evidence-require (cdr prefix-type) (list *t3-genvar-symbolp* witness)))
         (named (t3-genvar-symbol-name-equality lib candidate-eq string witness stringp (car symbolp)))
         (capacity (t3-genvar-capacity-of-generated-name lib joined (cadr expansion) counter (car natural)))
         (lib (cdr capacity))
         (proof (library-library-proof lib))
         (reverse-coercion (proof-proof-symmetric proof coerce-inverse))
         (below (proof-proof-rewrite proof (car capacity) reverse-coercion '(1 2 1)))
         (guard (t3-logic-evidence-with-lib (cdr symbolp) lib))
         (decrease (t3-genvar-descend-rejection lib goal (cadr parts) (caddr parts) (cadr tests)
                                              witness prefix avoid counter guard (car natural)
                                              joined string coerce-inverse candidate candidate-eq named below)))
      (cons decrease lib))))

(defun t3-genvar-build (lib)
  (proof-with-checked-results
      ((lib (t3-digit-capacity-build lib))
       (lib (t3-name-bounds-build lib))
       (lib (t3-list-bounds-append-character-lists lib)))
    (t3-genvar-ordinary-variable-name lib)))
