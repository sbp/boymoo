(in-package "BOYMOO-PROVER")
(set-verify-guards-eagerness 0)

(defconst *t3-rational-order-rational-sums-additive-lemmas*
  '("ADD-ZERO-LEFT" "ADD-ZERO-RIGHT" "DOUBLE-NEGATION"
    "LESS-DIFFERENCE" "NEGATE-SUM"))

(defconst *t3-rational-order-rational-sums-prefix* "T3-RAT-")

(defconst *t3-rational-order-closure-axioms*
  (list (cons *proof-plus* "rationalp-binary-+")
        (cons *proof-times* "rationalp-binary-*")
        (cons *proof-minus* "rationalp-unary--")
        (cons *t3-logic-reciprocal* "rationalp-unary-/")))

(defun t3-rational-order-rational (term)
  (list *library-rationalp* term))

(defun t3-rational-order-make-rational-sums (lib prefix)
  (list :t3-rational-sums lib prefix))

(defun t3-rational-order-rational-sums-init (lib)
  (t3-rational-order-make-rational-sums lib *t3-rational-order-rational-sums-prefix*))

(defun t3-rational-order-rational-sums-lib (sums)
  (cadr sums))

(defun t3-rational-order-rational-sums-prefix (sums)
  (if (eq (car sums) :number-sums) "T3-NUMBER-" (caddr sums)))

(defun t3-rational-order-rational-sums-with-lib (sums lib)
  (if (eq (car sums) :number-sums)
      (list :number-sums lib)
    (t3-rational-order-make-rational-sums lib (t3-rational-order-rational-sums-prefix sums))))

(defun t3-rational-order-rational-sums-cite (sums name arguments evidence)
  (library-library-cite
   (t3-rational-order-rational-sums-lib sums)
   (if (member-equal name *t3-rational-order-rational-sums-additive-lemmas*)
       (concatenate 'string (t3-rational-order-rational-sums-prefix sums) name)
     name)
   arguments evidence))

(defun t3-rational-order-find-type (evidence literal integer-literal)
  (if (endp evidence)
      nil
    (proof-with-checked-results ((first (proof-step-first (car evidence))))
      (if (or (equal first literal) (equal first integer-literal))
          (car evidence)
        (t3-rational-order-find-type (cdr evidence) literal integer-literal)))))

(defun t3-rational-order-number-type-of (lib term)
  (let ((proof (library-library-proof lib)))
    (cond ((proof-is-call term *proof-plus*)
           (library-library-cite lib "SUM-NUMBER" (cdr term) nil))
          ((proof-is-call term *proof-minus*)
           (library-library-cite lib "NEGATION-NUMBER" (cdr term) nil))
          ((proof-is-call term *proof-quote*)
           (proof-with-checked-results
            ((fact (proof-proof-fact proof "rationalp-acl2-numberp" (list (list *library-x* term))))
            (rational (t3-logic-libraryproofs-prove lib (t3-rational-order-rational term) nil nil)))
            (proof-proof-modus-ponens proof fact rational)))
          ((proof-is-call term (proof-sym "FIX" "ACL2"))
           (library-library-cite lib "T3-FIX-NUMBER" (cdr term) nil))
          (t '(:failure "unsupported" "")))))

(mutual-recursion
 (defun t3-rational-order-rational-sums-type-of (sums term evidence)
   (declare (xargs :measure (1+ (* 2 (acl2-count term)))))
   (let* ((lib (t3-rational-order-rational-sums-lib sums))
          (proof (library-library-proof lib))
          (numeric (equal (t3-rational-order-rational-sums-prefix sums) "T3-NUMBER-"))
          (literal (list (if numeric *library-numberp* *library-rationalp*) term)))
     (proof-with-checked-results
      ((known (t3-rational-order-find-type evidence literal
                                         (if numeric literal (library-integer term)))))
      (cond
       (known
        (if (equal (proof-step-first known) literal)
            known
          (t3-logic-libraryproofs-rational lib term (list known))))
       (numeric (t3-rational-order-number-type-of lib term))
       ((proof-is-call term *proof-quote*) (t3-logic-libraryproofs-prove lib literal nil nil))
       (t
        (proof-with-checked-results ((head (proof-term-at term 0)))
          (let ((axiom (cdr (assoc-equal head *t3-rational-order-closure-axioms*))))
            (if (not axiom)
                '(:failure "unsupported" "")
              (proof-with-checked-results
               ((premise (proof-proof-fact proof axiom (seq-zip (list *library-x* *library-y*) (cdr term))))
                (types (t3-rational-order-type-arguments sums (cdr term) evidence))
                (given (if (consp (cdr types))
                           (proof-with-checked-results
                            ((first (proof-step-first premise))
                             (hypothesis (proof-term-at first 1)))
                            (t3-logic-libraryproofs-prove lib hypothesis types nil))
                         (proof-term-at types 0))))
               (proof-proof-modus-ponens proof premise given))))))))))

 (defun t3-rational-order-type-arguments (sums arguments evidence)
   (declare (xargs :measure (* 2 (acl2-count arguments))))
   (if (endp arguments)
       nil
     (proof-with-checked-results
      ((first (t3-rational-order-rational-sums-type-of sums (car arguments) evidence))
       (rest (t3-rational-order-type-arguments sums (cdr arguments) evidence)))
      (cons first rest)))))

(defun t3-rational-order-rational-sums-number-type (sums term types)
  (if (equal (t3-rational-order-rational-sums-prefix sums) "T3-NUMBER-")
      (t3-rational-order-rational-sums-type-of sums term types)
    (let* ((lib (t3-rational-order-rational-sums-lib sums))
           (proof (library-library-proof lib)))
      (proof-with-checked-results
       ((fact (proof-proof-fact proof "rationalp-acl2-numberp" (list (list *library-x* term))))
        (type-step (t3-rational-order-rational-sums-type-of sums term types)))
       (proof-proof-modus-ponens proof fact type-step)))))

(defun t3-rational-order-rational-sums-inverse-unique (sums term inverse cancel types)
  (let* ((lib (t3-rational-order-rational-sums-lib sums))
         (proof (library-library-proof lib))
         (minus-term (library-minus term)))
    (proof-with-checked-results
     ((swap (library-library-axiom lib "COMMUTATIVITY-OF-+" (list minus-term term)))
      (opp (library-library-axiom lib "INVERSE-OF-+" (list term)))
      (opposites (proof-proof-chain proof swap (list opp)))
      (inverse-type (t3-rational-order-rational-sums-type-of sums inverse types))
      (result (t3-rational-order-rational-sums-cite sums "ADD-ZERO-LEFT" (list inverse) (list inverse-type)))
      (reversed (proof-proof-symmetric proof opposites))
      (result (proof-proof-rewrite proof result reversed '(1 1 1)))
      (result (proof-proof-symmetric proof result))
      (associate (library-library-axiom lib "ASSOCIATIVITY-OF-+" (list minus-term term inverse)))
      (result (proof-proof-chain proof result (list associate)))
      (result (proof-proof-rewrite proof result cancel '(1 2 2)))
      (minus-type (t3-rational-order-rational-sums-type-of sums minus-term types))
      (identity (t3-rational-order-rational-sums-cite sums "ADD-ZERO-RIGHT" (list minus-term) (list minus-type))))
     (proof-proof-chain proof result (list identity)))))

(defun t3-rational-order-rational-sums-push-minus (n sums term evidence)
  (declare (xargs :measure (nfix n)))
  (if (not (o< (nfix (1- n)) (nfix n)))
      '(:failure "fuel" "t3-rational-order-rational-sums-push-minus")
    (let* ((lib (t3-rational-order-rational-sums-lib sums))
           (proof (library-library-proof lib)))
      (cond
       ((proof-is-call term *proof-plus*)
        (proof-with-checked-results
         ((result (proof-proof-reflexive proof term))
          (left (proof-term-at term 1))
          (left-step (t3-rational-order-rational-sums-push-minus (1- n) sums left evidence))
          (result (if left-step (proof-proof-rewrite proof result left-step '(1 2 1)) result))
          (right (proof-term-at term 2))
          (right-step (t3-rational-order-rational-sums-push-minus (1- n) sums right evidence))
          (result (if right-step (proof-proof-rewrite proof result right-step '(1 2 2)) result))
          (first (proof-step-first result))
          (right (proof-term-at first 2)))
         (if (equal right term) nil result)))
       ((proof-is-call term *proof-minus*)
        (proof-with-checked-results ((argument (proof-term-at term 1)))
          (if (proof-is-call argument *proof-quote*)
              (t3-logic-libraryproofs-constant lib term)
            ; The unprefixed facts gate the rules. The citation chooses the typed lemma.
            (let ((facts (proof-proof-facts proof)))
              (proof-with-checked-results
               ((result
                 (cond
                  ((and (proof-is-call argument *proof-minus*)
                        (assoc-equal (proof-sym "SELF-DOUBLE-NEGATION" "ACL2") facts))
                   (proof-with-checked-results
                    ((item (proof-term-at argument 1))
                     (type-step (t3-rational-order-rational-sums-type-of sums item evidence)))
                    (t3-rational-order-rational-sums-cite sums "DOUBLE-NEGATION" (list item) (list type-step))))
                  ((and (proof-is-call argument *proof-plus*)
                        (assoc-equal (proof-sym "SELF-NEGATE-SUM" "ACL2") facts))
                   (proof-with-checked-results
                    ((steps (t3-rational-order-type-arguments sums (cdr argument) evidence)))
                    (t3-rational-order-rational-sums-cite sums "NEGATE-SUM" (cdr argument) steps)))
                  (t nil))))
               (if (not result)
                   nil
                 (proof-with-checked-results
                  ((first (proof-step-first result))
                   (right (proof-term-at first 2))
                   (rest (t3-rational-order-rational-sums-push-minus (1- n) sums right evidence)))
                  (proof-proof-chain proof result (list rest)))))))))
       (t nil)))))

(defun t3-rational-order-linear-remove-zero (sums step name term place evidence)
  (proof-with-checked-results
   ((type-step (t3-rational-order-rational-sums-type-of sums term evidence))
    (zero-step (t3-rational-order-rational-sums-cite sums name (list term) (list type-step))))
   (proof-proof-rewrite (library-library-proof (t3-rational-order-rational-sums-lib sums))
                        step zero-step place)))

(defun t3-rational-order-linear-combine-pair (lib a b)
  (if (and (proof-is-call a *proof-quote*) (proof-is-call b *proof-quote*))
      (t3-logic-libraryproofs-constant lib (library-plus a b))
    (library-linear-combine-pair lib a b)))

(defun t3-rational-order-linear-combine (n sums step place evidence)
  (declare (xargs :measure (nfix n)))
  (if (not (o< (nfix (1- n)) (nfix n)))
      '(:failure "fuel" "t3-rational-order-linear-combine")
    (let* ((lib (t3-rational-order-rational-sums-lib sums))
           (proof (library-library-proof lib)))
      (proof-with-checked-results
       ((first (proof-step-first step))
        (node (library-linear-form-get first (cdr place))))
       (if (not (proof-is-call node *proof-plus*))
           (proof-proof-tidy proof step)
         (proof-with-checked-results ((pair (proof-list-of-length (cdr node) 2)))
           (let* ((a (car pair))
                  (rest (cadr pair))
                  (suffix (proof-is-call rest *proof-plus*)))
             (proof-with-checked-results ((b (if suffix (proof-term-at rest 1) rest)))
               (cond
                ((equal a *proof-zero*)
                 (proof-with-checked-results
                  ((step (t3-rational-order-linear-remove-zero sums step "ADD-ZERO-LEFT" rest place evidence)))
                  (t3-rational-order-linear-combine (1- n) sums step place evidence)))
                ((and (equal b *proof-zero*) (not suffix))
                 (proof-with-checked-results
                  ((step (t3-rational-order-linear-remove-zero sums step "ADD-ZERO-RIGHT" a place evidence)))
                  (t3-rational-order-linear-combine (1- n) sums step place evidence)))
                (t
                 (proof-with-checked-results ((combine (t3-rational-order-linear-combine-pair lib a b)))
                   (if (not combine)
                       (t3-rational-order-linear-combine (1- n) sums step (append place '(2)) evidence)
                     (proof-with-checked-results
                      ((step (if suffix
                                 (proof-with-checked-results
                                  ((tail (proof-term-at rest 2))
                                   (assoc-step (library-library-axiom lib "ASSOCIATIVITY-OF-+" (list a b tail)))
                                   (symmetric (proof-proof-symmetric proof assoc-step)))
                                  (proof-proof-rewrite proof step symmetric place))
                               step))
                       (step (proof-proof-rewrite proof step combine (if suffix (append place '(1)) place))))
                      (t3-rational-order-linear-combine (1- n) sums step '(1 2) evidence))))))))))))))

(defun t3-rational-order-rational-sums-linear-form (sums term evidence)
  (let* ((lib (t3-rational-order-rational-sums-lib sums))
         (proof (library-library-proof lib)))
    (proof-with-checked-results
     ((step (t3-rational-order-rational-sums-push-minus 1000000 sums term evidence))
      (step (if step step (proof-proof-reflexive proof term)))
      (step (library-linear-reassociate 1000000 lib step '(1 2)))
      (step (library-linear-sort 1000000 lib step '(1 2) nil)))
     (t3-rational-order-linear-combine 1000000 sums step '(1 2) evidence))))

(defun t3-rational-order-rational-sums-linear-equal (sums left right types)
  (let ((proof (library-library-proof (t3-rational-order-rational-sums-lib sums))))
    (proof-with-checked-results
     ((a (t3-rational-order-rational-sums-linear-form sums left types))
      (b (t3-rational-order-rational-sums-linear-form sums right types))
      (a-first (proof-step-first a))
      (a-normal (proof-term-at a-first 2))
      (b-first (proof-step-first b))
      (b-normal (proof-term-at b-first 2)))
     (if (equal a-normal b-normal)
         (proof-with-checked-results ((symmetric (proof-proof-symmetric proof b)))
           (proof-proof-chain proof a (list symmetric)))
       (proof-with-checked-results
        ((a-text (proof-write a-normal))
         (b-text (proof-write b-normal)))
        '(:failure "unproved" ""))))))

(defun t3-rational-order-rational-sums-comparison (sums a b types)
  (proof-with-checked-results
   ((a-type (t3-rational-order-rational-sums-type-of sums a types))
    (b-type (t3-rational-order-rational-sums-type-of sums b types)))
   (t3-rational-order-rational-sums-cite sums "LESS-DIFFERENCE" (list a b) (list a-type b-type))))

(defun t3-rational-order-step-guards (steps)
  (if (endp steps)
      nil
    (proof-with-checked-results
     ((first (proof-step-first (car steps)))
      (rest (t3-rational-order-step-guards (cdr steps))))
     (cons (proof-neg first) rest))))

(defun t3-rational-order-add-identity-lemma (lib prefix name step rx)
  (proof-with-checked-results
   ((first (proof-step-first step))
    (guard (proof-step-first rx)))
   (library-library-lemma lib (concatenate 'string prefix name)
                          first step (list (proof-neg guard)))))

(defun t3-rational-order-additive-identities (lib sums types)
  (let* ((proof (library-library-proof lib))
         (shared (equal lib (t3-rational-order-rational-sums-lib sums)))
         (prefix (t3-rational-order-rational-sums-prefix sums))
         (x *library-x*)
         (y *library-y*)
         (zero *proof-zero*)
         (minus-x (library-minus x))
         (fix (proof-sym "FIX" "ACL2")))
    (proof-with-checked-results
     ((types (proof-list-of-length types 3))
      (numeric (t3-rational-order-rational-sums-number-type sums x types))
      (fixed (t3-logic-libraryproofs-simplify lib (list fix x) (list numeric) (list fix)))
      (left (library-library-axiom lib "UNICITY-OF-0" (list x)))
      (left (proof-proof-chain proof left (list fixed)))
      (right (library-library-axiom lib "COMMUTATIVITY-OF-+" (list x zero)))
      (right (proof-proof-chain proof right (list left)))
      (unit (library-library-axiom lib "UNICITY-OF-1" (list x)))
      (unit (proof-proof-chain proof unit (list fixed)))
      (lib (t3-rational-order-add-identity-lemma lib prefix "ADD-ZERO-LEFT" left (car types)))
      (lib (t3-rational-order-add-identity-lemma lib prefix "ADD-ZERO-RIGHT" right (car types)))
      (lib (t3-rational-order-add-identity-lemma lib prefix "MUL-UNIT" unit (car types)))
      (sums (if shared (t3-rational-order-rational-sums-with-lib sums lib) sums))
      (proof (library-library-proof lib))
      (swapped (library-library-axiom lib "COMMUTATIVITY-OF-+" (list minus-x x)))
      (inverse-axiom (library-library-axiom lib "INVERSE-OF-+" (list x)))
      (cancel (proof-proof-chain proof swapped (list inverse-axiom)))
      (inverse (t3-rational-order-rational-sums-inverse-unique sums minus-x x cancel types))
      (double (proof-proof-symmetric proof inverse))
      (lib (t3-rational-order-add-identity-lemma lib prefix "DOUBLE-NEGATION" double (car types)))
      (sums (if shared (t3-rational-order-rational-sums-with-lib sums lib) sums)))
     (let* ((proof (library-library-proof lib))
            (term (library-plus x y))
            (inverse (library-plus minus-x (library-minus y))))
       (proof-with-checked-results
        ((cancel (t3-rational-order-rational-sums-linear-equal sums (library-plus term inverse) zero types))
         (unique (t3-rational-order-rational-sums-inverse-unique sums term inverse cancel types))
         (push (proof-proof-symmetric proof unique))
         (first (proof-step-first push))
         (guards (t3-rational-order-step-guards (list (car types) (cadr types))))
         (lib (library-library-lemma lib (concatenate 'string prefix "NEGATE-SUM") first push guards))
         (sums (if shared (t3-rational-order-rational-sums-with-lib sums lib) sums))
         (proof (library-library-proof lib))
         (a (library-library-axiom lib "<-ON-OTHERS" (list x y)))
         (b (library-library-axiom lib "<-ON-OTHERS" (list zero (library-diff y x))))
         (identity (t3-rational-order-rational-sums-linear-equal
                    sums (library-diff zero (library-diff y x)) (library-diff x y) types))
         (b (proof-proof-rewrite proof b identity '(1 2 1)))
         (b (proof-proof-symmetric proof b))
         (less-difference (proof-proof-chain proof a (list b)))
         (first (proof-step-first less-difference)))
        (library-library-lemma lib (concatenate 'string prefix "LESS-DIFFERENCE")
                               first less-difference guards))))))

(defun t3-rational-order-positive-sum (lib sums types)
  (let* ((proof (library-library-proof lib))
         (x *library-x*)
         (y *library-y*)
         (zero *proof-zero*)
         (positive-x-term (library-positive x))
         (positive-y-term (library-positive y))
         (lower-term (library-lt x zero))
         (goal (library-positive (library-plus y x)))
         (x-zero (proof-eq x zero)))
    (proof-with-checked-results
     ((types (proof-list-of-length types 3))
      (positive-x (proof-proof-assume proof positive-x-term t))
      (positive-y (proof-proof-assume proof positive-y-term t))
      (lower (proof-proof-assume proof lower-term nil))
      (positive-case (library-library-cite lib "POSITIVE-SUM" (list y x) (list positive-y positive-x)))
      (zero-right (t3-rational-order-rational-sums-cite sums "ADD-ZERO-RIGHT" (list y) (list (cadr types))))
      (zero-case (library-library-transport-argument lib positive-y zero-right 2))
      (assumed-zero (proof-proof-assume proof x-zero t))
      (same-zero (proof-proof-symmetric proof assumed-zero))
      (zero-case (proof-proof-rewrite proof zero-case same-zero '(1 2 2)))
      (tri (library-library-axiom lib "TRICHOTOMY" (list x)))
      (tri (proof-proof-conjunct proof tri))
      (numeric (t3-rational-order-rational-sums-number-type sums x types))
      (tri (proof-proof-modus-ponens proof (car tri) numeric))
      (not-positive (proof-proof-assume proof positive-x-term nil))
      (not-zero (proof-proof-assume proof x-zero nil))
      (negative (t3-logic-libraryproofs-simplify-first lib tri (list not-positive not-zero) nil))
      (equivalent (t3-rational-order-rational-sums-comparison sums x zero types))
      (identity (t3-rational-order-rational-sums-linear-equal sums (library-diff zero x)
                                                             (library-minus x) types))
      (equivalent (proof-proof-rewrite proof equivalent identity '(1 2 2)))
      (negative (proof-proof-transport proof negative equivalent))
      (contradicted (proof-proof-cut proof negative lower))
      (impossible (proof-proof-subsume proof contradicted (cons goal (proof-step-clause contradicted))))
      (zero-or-negative (proof-proof-cases proof x-zero zero-case impossible))
      (result (proof-proof-cases proof positive-x-term positive-case zero-or-negative))
      (guards (t3-rational-order-step-guards (list (car types) (cadr types) positive-y))))
     (library-library-lemma lib (concatenate 'string (t3-rational-order-rational-sums-prefix sums) "POSITIVE-SUM")
                            goal result (append guards (list lower-term))))))

(defun t3-rational-order-weak-then-strict (lib sums types)
  (let* ((proof (library-library-proof lib))
         (x *library-x*)
         (y *library-y*)
         (z *library-z*)
         (left (library-diff y x))
         (right (library-diff z y))
         (prefix (t3-rational-order-rational-sums-prefix sums)))
    (proof-with-checked-results
     ((weak (proof-proof-assume proof (library-lt y x) nil))
      (strict (proof-proof-assume proof (library-lt y z) t))
      (weak-compare (library-library-axiom lib "<-ON-OTHERS" (list y x)))
      (nonnegative (proof-proof-rewrite proof weak weak-compare '(1 1)))
      (strict-compare (t3-rational-order-rational-sums-comparison sums y z types))
      (pos (proof-proof-rewrite proof strict strict-compare '(1)))
      (left-type (t3-rational-order-rational-sums-type-of sums left types))
      (right-type (t3-rational-order-rational-sums-type-of sums right types))
      (bound (library-library-cite lib (concatenate 'string prefix "POSITIVE-SUM")
                                   (list left right) (list left-type right-type pos nonnegative)))
      (target (t3-rational-order-rational-sums-comparison sums x z types))
      (identity (t3-rational-order-rational-sums-linear-equal sums (library-diff z x)
                                                             (library-plus right left) types))
      (target (proof-proof-rewrite proof target identity '(1 2 2)))
      (result (proof-proof-transport proof bound target))
      (guards (t3-rational-order-step-guards types))
      (strict-first (proof-step-first strict)))
     (library-library-lemma lib (concatenate 'string prefix "WEAK-THEN-LESS") (library-lt x z) result
                            (append guards (list (library-lt y x) (proof-neg strict-first)))))))

(defun t3-rational-order-scaled-difference (lib sums types)
  (let* ((proof (library-library-proof lib))
         (x *library-x*)
         (y *library-y*)
         (z *library-z*)
         (negative (library-minus x))
         (zx (list *proof-times* z x))
         (zn (list *proof-times* z negative)))
    (proof-with-checked-results
     ((cancel (library-library-axiom lib "DISTRIBUTIVITY" (list z x negative)))
      (inverse (library-library-axiom lib "INVERSE-OF-+" (list x)))
      (cancel (proof-proof-rewrite proof cancel inverse '(1 1 2)))
      (product-zero (library-library-cite lib "T3-PRODUCT-ZERO" (list z) nil))
      (cancel (proof-proof-rewrite proof cancel product-zero '(1 1)))
      (cancel (proof-proof-symmetric proof cancel))
      (inverse (t3-rational-order-rational-sums-inverse-unique sums zx zn cancel types))
      (distributes (library-library-axiom lib "DISTRIBUTIVITY" (list z y negative))))
     (proof-proof-rewrite proof distributes inverse '(1 2 2)))))

(defun t3-rational-order-strict-scale (lib sums types)
  (let* ((proof (library-library-proof lib))
         (x *library-x*)
         (y *library-y*)
         (z *library-z*)
         (zx (list *proof-times* z x))
         (zy (list *proof-times* z y))
         (difference (library-diff y x)))
    (proof-with-checked-results
     ((types (proof-list-of-length types 3))
      (distributes (t3-rational-order-scaled-difference lib sums types))
      (less (proof-proof-assume proof (library-lt x y) t))
      (comparison (t3-rational-order-rational-sums-comparison sums x y types))
      (positive-difference (proof-proof-rewrite proof less comparison '(1)))
      (scale (proof-proof-assume proof (library-positive z) t))
      (difference-type (t3-rational-order-rational-sums-type-of sums difference types))
      (multiplied (library-library-cite lib "POSITIVE-PRODUCT" (list z difference)
                                        (list (caddr types) difference-type scale positive-difference)))
      (comparison (t3-rational-order-rational-sums-comparison sums zx zy types))
      (distributes (proof-proof-symmetric proof distributes))
