(in-package "BOYMOO-PROVER")
(set-verify-guards-eagerness 0)

(defconst *t3-book-numeric-order-fix* (proof-sym "FIX" "ACL2"))

(defun t3-book-numeric-order-number-sums-type-of (sums term evidence)
  (t3-rational-order-rational-sums-type-of sums term evidence))

(defun t3-book-numeric-order-select (lib equation evidence)
  (proof-with-checked-results
   ((first (proof-step-first equation))
    (right (proof-term-at first 2))
    (branch (t3-logic-libraryproofs-normalize lib right evidence nil)))
   (proof-proof-chain (library-library-proof lib) equation (list branch))))

(defun t3-book-numeric-order-fixed-comparison-added (has-a has-b lib sums a b fx fy)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
     ((left (proof-proof-assume proof a has-a))
      (right (proof-proof-assume proof b has-b))
      (completed (library-library-axiom lib "COMPLETION-OF-+" (list *library-x* *library-y*)))
      (raw (t3-book-numeric-order-select lib completed (list left right)))
      (fixed (proof-proof-reflexive proof (library-plus fx fy)))
      (opened (proof-proof-unfold proof fx))
      (left-fixed (t3-book-numeric-order-select lib opened (list left)))
      (opened (proof-proof-unfold proof fy))
      (right-fixed (t3-book-numeric-order-select lib opened (list right)))
      (fixed (t3-book-spines-replace-value lib fixed (list left-fixed right-fixed)))
      (fixed
       (cond ((and has-a (not has-b))
              (proof-with-checked-results
               ((same (t3-rational-order-rational-sums-cite sums "ADD-ZERO-RIGHT"
                                                            (list *library-x*) (list left))))
               (proof-proof-chain proof fixed (list same))))
             ((and has-b (not has-a))
              (proof-with-checked-results
               ((same (t3-rational-order-rational-sums-cite sums "ADD-ZERO-LEFT"
                                                            (list *library-y*) (list right))))
               (proof-proof-chain proof fixed (list same))))
             ((and (not has-a) (not has-b))
              (proof-with-checked-results
               ((first (proof-step-first fixed))
                (value (proof-term-at first 2))
                (constant (t3-logic-libraryproofs-constant lib value)))
               (proof-proof-chain proof fixed (list constant))))
             (t fixed)))
      (reversed (proof-proof-symmetric proof fixed)))
     (proof-proof-chain proof raw (list reversed)))))

(defun t3-book-numeric-order-fixed-addition (lib sums a b fx fy)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
     ((both (t3-book-numeric-order-fixed-comparison-added t t lib sums a b fx fy))
      (left-only (t3-book-numeric-order-fixed-comparison-added t nil lib sums a b fx fy))
      (yes (proof-proof-cases proof b both left-only))
      (right-only (t3-book-numeric-order-fixed-comparison-added nil t lib sums a b fx fy))
      (neither (t3-book-numeric-order-fixed-comparison-added nil nil lib sums a b fx fy))
      (no (proof-proof-cases proof b right-only neither))
      (addition (proof-proof-cases proof a yes no))
      (first (proof-step-first addition)))
     (library-library-lemma lib "T3-ADD-FIXED" first addition nil))))

(defun t3-book-numeric-order-fixed-negation (lib a fx opened present absent)
  (let ((proof (library-library-proof lib))
        (negative (library-minus *library-x*))
        (fixed (library-minus fx)))
    (proof-with-checked-results
     ((yes (proof-proof-reflexive proof fixed))
      (present-fixed (t3-book-numeric-order-select lib opened (list present)))
      (yes (t3-book-spines-replace-value lib yes (list present-fixed)))
      (no (proof-proof-reflexive proof fixed))
      (absent-fixed (t3-book-numeric-order-select lib opened (list absent)))
      (no (t3-book-spines-replace-value lib no (list absent-fixed)))
      (first (proof-step-first no))
      (right (proof-term-at first 2))
      (constant (t3-logic-libraryproofs-constant lib right))
      (no (proof-proof-chain proof no (list constant)))
      (complete (library-library-axiom lib "COMPLETION-OF-UNARY-MINUS" (list *library-x*)))
      (absent-negative (t3-book-numeric-order-select lib complete (list absent)))
      (yes (proof-proof-symmetric proof yes))
      (no (proof-proof-symmetric proof no))
      (no (proof-proof-chain proof absent-negative (list no)))
      (same-minus (proof-proof-cases proof a yes no)))
     (library-library-lemma lib "T3-NEGATE-FIXED" (proof-eq negative fixed) same-minus nil))))

(defun t3-book-numeric-order-fixed-less (lib sums fx fy)
  (let ((proof (library-library-proof lib))
        (negative (library-minus *library-y*)))
    (proof-with-checked-results
     ((difference (library-library-cite lib "T3-ADD-FIXED" (list *library-x* negative) nil))
      (negate-number (t3-rational-order-rational-sums-type-of sums negative nil))
      (opened (proof-proof-unfold proof (list *t3-book-numeric-order-fix* negative)))
      (remove-fix (t3-book-numeric-order-select lib opened (list negate-number)))
      (negate-fixed (library-library-cite lib "T3-NEGATE-FIXED" (list *library-y*) nil))
      (difference (t3-book-spines-replace-value lib difference (list remove-fix negate-fixed)))
      (original (library-library-axiom lib "<-ON-OTHERS" (list *library-x* *library-y*)))
      (original (t3-book-spines-replace-value lib original (list difference)))
      (fixed (library-library-axiom lib "<-ON-OTHERS" (list fx fy)))
      (fixed (proof-proof-symmetric proof fixed))
      (done (proof-proof-chain proof original (list fixed)))
      (first (proof-step-first done)))
     (library-library-lemma lib "T3-LESS-FIXED" first done nil))))

(defun t3-book-numeric-order-fixed-comparison (lib sums)
  (let* ((proof (library-library-proof lib))
         (shared (equal lib (t3-rational-order-rational-sums-lib sums)))
         (a (list *library-numberp* *library-x*))
         (b (list *library-numberp* *library-y*))
         (fx (list *t3-book-numeric-order-fix* *library-x*))
         (fy (list *t3-book-numeric-order-fix* *library-y*)))
    (proof-with-checked-results
     ((zero-type (t3-rational-order-rational-sums-type-of sums *proof-zero* nil))
      (present (proof-proof-assume proof a t))
      (absent (proof-proof-assume proof a nil))
      (opened (proof-proof-unfold proof fx))
      (selected (t3-book-numeric-order-select lib opened (list present)))
      (yes (library-library-transport-argument lib present selected 1))
      (selected (t3-book-numeric-order-select lib opened (list absent)))
      (no (library-library-transport-argument lib zero-type selected 1))
      (numeric (proof-proof-cases proof a yes no))
      (lib (library-library-lemma lib "T3-FIX-NUMBER" (list *library-numberp* fx) numeric nil))
      (sums (if shared (t3-rational-order-rational-sums-with-lib sums lib) sums))
      (lib (t3-book-numeric-order-fixed-addition lib sums a b fx fy))
      (lib (t3-book-numeric-order-fixed-negation lib a fx opened present absent))
      (sums (if shared (t3-rational-order-rational-sums-with-lib sums lib) sums)))
     (t3-book-numeric-order-fixed-less lib sums fx fy))))

(defun t3-book-numeric-order-negative-premises (steps)
  (if (endp steps)
      nil
    (proof-with-checked-results
     ((first (proof-step-first (car steps)))
      (rest (t3-book-numeric-order-negative-premises (cdr steps))))
     (cons (proof-neg first) rest))))

(defun t3-book-numeric-order-typed-order (lib sums types)
  (let* ((shared (equal lib (t3-rational-order-rational-sums-lib sums)))
         (proof (library-library-proof lib))
         (prefix (t3-rational-order-rational-sums-prefix sums))
         (x *library-x*)
         (y *library-y*)
         (z *library-z*))
    (proof-with-checked-results
     ((p (proof-proof-assume proof (library-lt x y) t))
      (comparison (t3-rational-order-rational-sums-comparison sums x y types))
      (d (proof-proof-rewrite proof p comparison '(1)))
      (d (proof-proof-tidy proof d))
      (weak-delta (t3-rational-order-nonnegative-from-positive lib sums d types))
      (reverse-order (library-library-axiom lib "<-ON-OTHERS" (list y x)))
      (reversed (proof-proof-symmetric proof reverse-order))
      (weak (proof-proof-rewrite proof weak-delta reversed '(1 1)))
      (weak (proof-proof-tidy proof weak))
      (first-type (proof-term-at types 0))
      (first-type (proof-step-first first-type))
      (second-type (proof-term-at types 1))
      (second-type (proof-step-first second-type))
      (p-first (proof-step-first p))
      (lib (library-library-lemma lib (concatenate 'string prefix "LESS-TO-WEAK")
                                  (library-le x y) weak
                                  (list (proof-neg first-type) (proof-neg second-type)
                                        (proof-neg p-first))))
      (sums (if shared (t3-rational-order-rational-sums-with-lib sums lib) sums))
      (proof (library-library-proof lib))
      (right (proof-proof-assume proof (library-lt z y) nil))
      (other-order (library-library-axiom lib "<-ON-OTHERS" (list z y)))
      (other-delta (proof-proof-rewrite proof right other-order '(1 1)))
      (other-delta (proof-proof-tidy proof other-delta)))
     (let ((a (library-diff y x))
           (b (library-diff z y)))
       (proof-with-checked-results
        ((b-type (t3-rational-order-rational-sums-type-of sums b types))
         (a-type (t3-rational-order-rational-sums-type-of sums a types))
         (positive (library-library-cite lib (concatenate 'string prefix "POSITIVE-SUM")
                                         (list b a) (list b-type a-type d other-delta)))
         (order (t3-rational-order-rational-sums-comparison sums x z types))
         (identity (t3-rational-order-rational-sums-linear-equal sums (library-diff z x)
                                                                (library-plus a b) types))
         (order (t3-book-spines-replace-value lib order (list identity)))
         (result (proof-proof-transport proof positive order))
         (guards (t3-book-numeric-order-negative-premises types))
         (right-first (proof-step-first right))
         (reverse-strict (proof-term-at right-first 1)))
        (library-library-lemma lib (concatenate 'string prefix "LESS-THEN-WEAK")
                               (library-lt x z) result
                               (append guards (list (proof-neg p-first) reverse-strict))))))))

(defun t3-book-numeric-order-fixed-arguments (arguments)
  (if (endp arguments)
      nil
    (proof-with-checked-results
     ((value (proof-term-at (car arguments) 1))
      (rest (t3-book-numeric-order-fixed-arguments (cdr arguments))))
     (cons value rest))))

(defun t3-book-numeric-order-with-fixed (lib step reverse)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
     ((first (proof-step-first step))
      (strict (proof-is-call first *proof-less*))
      (term (if strict first (proof-term-at first 1)))
      (args (if (integerp term)
                '(:failure "failure" "")
              (if reverse (t3-book-numeric-order-fixed-arguments (cdr term)) (cdr term))))
      (equation (library-library-cite lib "T3-LESS-FIXED" args nil))
      (equation (if reverse (proof-proof-symmetric proof equation) equation))
      (changed (proof-proof-rewrite proof step equation (if strict '(1) '(1 1)))))
     (proof-proof-tidy proof changed))))

(defun t3-book-numeric-order-types (proof variables)
  (if (endp variables)
      nil
    (proof-with-checked-results
     ((step (proof-proof-assume proof (list *library-numberp* (car variables)) t))
      (rest (t3-book-numeric-order-types proof (cdr variables))))
     (cons step rest))))

(defun t3-book-numeric-order-fixed-values (variables)
  (if (endp variables)
      nil
    (cons (list *t3-book-numeric-order-fix* (car variables))
          (t3-book-numeric-order-fixed-values (cdr variables)))))

(defun t3-book-numeric-order-value-types (sums values)
  (if (endp values)
      nil
    (proof-with-checked-results
     ((step (t3-book-numeric-order-number-sums-type-of sums (car values) nil))
      (rest (t3-book-numeric-order-value-types sums (cdr values))))
     (cons step rest))))

(defun t3-book-numeric-order-fixed-premises (lib premises)
  (if (endp premises)
      nil
    (proof-with-checked-results
     ((step (t3-book-numeric-order-with-fixed lib (car premises) nil))
      (rest (t3-book-numeric-order-fixed-premises lib (cdr premises))))
     (cons step rest))))

(defun t3-book-numeric-order-comparison-guards (premises)
  (if (endp premises)
      nil
    (proof-with-checked-results
     ((first (proof-step-first (car premises)))
      (side (if (proof-is-call first *proof-less*) (proof-neg first) (proof-term-at first 1)))
      (rest (t3-book-numeric-order-comparison-guards (cdr premises))))
     (cons side rest))))

(defun t3-book-numeric-order-object-comparison (lib sums name variables premises)
  (let ((values (t3-book-numeric-order-fixed-values variables))
        (prefix (t3-rational-order-rational-sums-prefix sums)))
    (proof-with-checked-results
     ((evidence (t3-book-numeric-order-value-types sums values))
      (numeric (t3-book-numeric-order-fixed-premises lib premises))
      (result (library-library-cite lib (concatenate 'string prefix name) values
                                     (append evidence numeric)))
      (result (t3-book-numeric-order-with-fixed lib result t))
      (sides (t3-book-numeric-order-comparison-guards premises))
      (first (proof-step-first result)))
     (library-library-lemma lib (concatenate 'string "T3-OBJECT-" name) first result sides))))

(defun t3-book-numeric-order-build (lib)
  (let ((sums (list :number-sums lib))
        (x *library-x*)
        (y *library-y*)
        (z *library-z*)
        (fx (list *t3-book-numeric-order-fix* *library-x*)))
    (proof-with-checked-results
     ((types (t3-book-numeric-order-types (library-library-proof lib) (list x y z)))
      (lib (t3-rational-order-additive-identities lib sums types))
      (sums (t3-rational-order-rational-sums-with-lib sums lib))
      (lib (t3-rational-order-positive-sum lib sums types))
      (sums (t3-rational-order-rational-sums-with-lib sums lib))
      (lib (t3-rational-order-weak-then-strict lib sums types))
      (sums (t3-rational-order-rational-sums-with-lib sums lib))
      (lib (t3-book-numeric-order-typed-order lib sums types))
      (sums (t3-rational-order-rational-sums-with-lib sums lib))
      (lib (t3-book-numeric-order-fixed-comparison lib sums))
      (sums (t3-rational-order-rational-sums-with-lib sums lib))
      (proof (library-library-proof lib))
      (smaller (t3-rational-order-rational-sums-linear-equal sums (library-diff fx fx)
                                                           *proof-zero* nil))
      (irreflexive (library-library-axiom lib "<-ON-OTHERS" (list fx fx)))
      (irreflexive (t3-book-spines-replace-value lib irreflexive (list smaller)))
      (fixed (library-library-cite lib "T3-LESS-FIXED" (list x x) nil))
      (irreflexive (proof-proof-chain proof fixed (list irreflexive)))
      (zero (library-library-axiom lib "ZERO" nil))
      (reversed (proof-proof-symmetric proof irreflexive))
      (result (proof-proof-rewrite proof zero reversed '(1 1)))
      (result (proof-proof-tidy proof result))
      (lib (library-library-lemma lib "T3-OBJECT-WEAK-REFLEXIVE" (library-le x x) result nil))
      (sums (t3-rational-order-rational-sums-with-lib sums lib))
      (proof (library-library-proof lib))
      (p (proof-proof-assume proof (library-lt x y) t))
      (p-weak (proof-proof-assume proof (library-lt y x) nil))
      (q (proof-proof-assume proof (library-lt y z) t))
      (q-weak (proof-proof-assume proof (library-lt z y) nil))
      (lib (t3-book-numeric-order-object-comparison lib sums "LESS-TO-WEAK" (list x y) (list p)))
      (sums (t3-rational-order-rational-sums-with-lib sums lib))
      (lib (t3-book-numeric-order-object-comparison
            lib sums "LESS-THEN-WEAK" (list x y z) (list p q-weak)))
      (sums (t3-rational-order-rational-sums-with-lib sums lib))
      (lib (t3-book-numeric-order-object-comparison
            lib sums "WEAK-THEN-LESS" (list x y z) (list p-weak q)))
      (proof (library-library-proof lib))
      (reverse (proof-proof-assume proof (library-lt z x) t))
      (before (library-library-cite lib "T3-OBJECT-LESS-THEN-WEAK" (list z x y)
                                     (list reverse p-weak)))
      (contradicted (proof-proof-cut proof before q-weak))
      (first (proof-step-first reverse))
      (forward (proof-proof-front proof contradicted (proof-neg first))))
     (library-library-lemma lib "T3-OBJECT-WEAK-TRANSITIVE" (library-le x z) forward
                            (list (library-lt y x) (library-lt z y))))))
