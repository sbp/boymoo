(in-package "BOYMOO-PROVER")
(set-verify-guards-eagerness 0)

(defconst *t3-api-prefix* "T3")
(defconst *t3-api-line-feed* (coerce (list #\Newline) 'string))

(defun t3-api-trim-line-feeds (raw end)
  (declare (xargs :measure (nfix end)))
  (if (and (not (zp end)) (eql (char raw (1- end)) #\Newline))
      (t3-api-trim-line-feeds raw (1- end))
    (if (equal end (length raw)) raw (subseq raw 0 end))))

(defun t3-api-parse (raw)
  (if (not (stringp raw))
      '(:failure "failure" "")
    (let ((parsed (reader-reader-line
                   (reader-reader (t3-api-trim-line-feeds raw (length raw))))))
      (if (failure-p parsed)
          parsed
        (list (caar parsed) (proof-freeze (cadar parsed)))))))

(defun t3-api-text-lines-scan (source start index reversed)
  (declare (xargs :measure (nfix (- (length source) (nfix index)))))
  (let ((index (nfix index))
        (size (length source)))
    (if (<= size index)
        (reverse (if (< start size)
                     (cons (subseq source start size) reversed)
                   reversed))
      (let* ((code (char-code (char source index)))
             (next (1+ index)))
        (cond ((and (= code 13) (< next size) (eql (char source next) #\Newline))
               (let ((end (1+ next)))
                 (t3-api-text-lines-scan source end end
                                         (cons (subseq source start end) reversed))))
              ((or (and (<= 10 code) (<= code 13))
                   (and (<= 28 code) (<= code 30)))
               (t3-api-text-lines-scan source next next
                                       (cons (subseq source start next) reversed)))
              (t (t3-api-text-lines-scan source start next reversed)))))))

(defun t3-api-text-lines (lines)
  (cond ((stringp lines) (t3-api-text-lines-scan lines 0 0 nil))
        ((true-listp lines) lines)
        (t '(:failure "failure" ""))))

(defun t3-api-normalize-line (line)
  (cond ((not (stringp line))
         '(:failure "failure" ""))
        ((text-ends-with line *t3-api-line-feed*) line)
        (t (concatenate 'string line *t3-api-line-feed*))))

(defun t3-api-measures-lines (aids measures)
  (if (endp aids)
      measures
    (proof-with-checked-results ((raw (t3-api-normalize-line (car aids))))
      (if (text-starts-with raw "(measure ")
          (proof-with-checked-results
              ((parsed (t3-api-parse raw))
               (relation (proof-term-at (cadr parsed) 2)))
            (let* ((data (cadr parsed))
                   (measures (if (equal relation *proof-ordinal-less*)
                                 (table-put measures (car data) (cadr data))
                               measures)))
              (t3-api-measures-lines (cdr aids) measures)))
        (t3-api-measures-lines (cdr aids) measures)))))

(defun t3-api-measures (aids)
  (t3-api-measures-lines aids nil))

(defun t3-api-own-names-replace (token names)
  (table-get names token token))

(defun t3-api-own-names-substitute (remaining chars names reversed)
  (declare (xargs :measure (nfix remaining)))
  (if (or (zp remaining) (endp chars))
      (coerce (reverse reversed) 'string)
    (let* ((chunk (t3-logic-token-chunk chars))
           (raw (cadr chunk))
           (width (max 1 (len raw)))
           (token (and (car chunk) (coerce (reverse raw) 'string)))
           (replacement (and token (t3-api-own-names-replace token names)))
           (next (if (equal token replacement)
                     (append raw reversed)
                   (revappend (coerce replacement 'list) reversed))))
      (t3-api-own-names-substitute (- remaining width) (caddr chunk) names next))))

(defun t3-api-own-names-rewrite (source names)
  (cond ((not (stringp source))
         '(:failure "failure" ""))
        ((endp names) source)
        (t (t3-api-own-names-substitute (length source) (coerce source 'list) names nil))))

(defun t3-api-own-names-entries (entries names reversed)
  (cond ((endp entries) '(:failure "failure" ""))
        ((endp (cdr entries))
         (proof-with-checked-results
             ((source (proof-term-at (car entries) 3))
              (source (t3-api-own-names-rewrite source names)))
           (list (reverse reversed) source)))
        (t
         (proof-with-checked-results ((entry (proof-list-of-length (car entries) 4)))
           (let ((name (cadr entry)))
             (proof-with-checked-results
                 ((source (t3-api-own-names-rewrite (cadddr entry) names))
                  (original (proof-write name)))
               (let ((digest (text-upper (siphash-hexdigest source))))
                 (proof-with-checked-results
                     ((package (proof-term-at name 1))
                      (renamed (proof-write
                                (proof-sym (concatenate 'string "PROVER-" *t3-api-prefix*
                                                        "-" digest)
                                           package))))
                   (let ((names (table-put names original renamed)))
                     (t3-api-own-names-entries
                      (cdr entries) names
                      (cons (t3-api-own-names-rewrite source names) reversed)))))))))))

(defun t3-api-own-names (entries)
  (t3-api-own-names-entries entries nil nil))

