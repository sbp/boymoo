(defun t3-api-book-proof (book)
  (library-library-proof (t3-book-values-book-proofs-library book)))

(defun t3-api-ground ()
  (proof-with-checked-results
      ((book (t3-book-values-book-proofs-init *t3-api-ground-declarations*))
       (library (library-library-build (t3-book-values-book-proofs-library book)))
       (library (t3-logic-libraryproofs-for-book library))
       (library (t3-arithmetic-build library))
       (library (t3-size-build library)))
    (t3-book-values-book-proofs-with-library book library)))

(defconst *t3-api-helper-recipes*
  (list (list *t3-book-lemmas-booleanp* :boolean-value "T3-BOOLEAN-TRUE")
        (list *t3-book-lemmas-iff* :iff-elimination "T3-IFF-LEFT" "T3-IFF-RIGHT")
        (list :none :cons-equality "T3-EQUAL-CONS")
        (list *t3-book-lemmas-exported-nfix* :natural-fix "T3-EXPORTED-NFIX")
        (list *t3-book-lemmas-set-tail* :set-tail "T3-SET-TAIL-COUNT")
        (list *t3-book-halves-halve* :halves "T3-LEN-CDR-WEAK" "T3-HALVE-BOUND-0"
              "T3-HALVE-BOUND-1" "T3-HALVE-LESS-0" "T3-HALVE-LESS-1")))

(defun t3-api-helper-run (recipe library)
  (case recipe
    (:boolean-value (t3-book-lemmas-boolean-value library))
    (:iff-elimination (t3-book-lemmas-iff-elimination library))
    (:cons-equality (t3-book-lemmas-cons-equality library))
    (:natural-fix (t3-book-lemmas-natural-fix library))
    (:set-tail (t3-book-lemmas-set-tail library))
    (otherwise (t3-book-halves-halves library))))

(defun t3-api-helper-first-collision (labels facts index)
  (if (endp labels)
      nil
    (let ((name (proof-sym (concatenate 'string "SELF-" (car labels)) "ACL2")))
      (if (assoc-equal name facts)
          (list index name)
        (t3-api-helper-first-collision (cdr labels) facts (1+ index))))))

(defun t3-api-halves-first-public (lib)
  (let* ((proof (library-library-proof lib))
         (cons-test (list *proof-consp* *library-x*))
         (tail-test (list *proof-consp* (list *library-cdr* *library-x*))))
    (proof-with-checked-results
        ((opened (proof-proof-unfold proof (list *t3-book-halves-halve* *library-x*)))
         (cons-step (proof-proof-assume proof cons-test t))
         (tail-cons (proof-proof-assume proof tail-test t))
         (evidence (t3-logic-evidence-init lib nil (list cons-step) nil))
         (decrease (t3-size-length-tail lib *library-x* evidence)))
      (t3-book-halves-public-lemma lib 0 opened cons-step tail-cons (car decrease)
                                  cons-test tail-test))))

(defun t3-api-halves-prefix (lib index)
  (proof-with-checked-results ((lib (t3-book-halves-length-weak lib)))
    (if (= index 0)
        lib
      (proof-with-checked-results ((lib (t3-book-halves-split-bound lib 0)))
        (if (= index 1)
            lib
          (proof-with-checked-results ((lib (t3-book-halves-split-bound lib 1)))
            (if (= index 2) lib (t3-api-halves-first-public lib))))))))

(defun t3-api-helper-run-prefix (recipe lib index)
  (cond ((and (eq recipe :iff-elimination) (= index 0))
         (let ((equivalent (list *t3-book-lemmas-iff* *library-x* *library-y*)))
           (proof-with-checked-results
               ((opened (proof-proof-unfold (library-library-proof lib) equivalent)))
             (t3-book-lemmas-iff-direction lib equivalent opened
                                          *library-x* *library-y* "T3-IFF-LEFT"))))
        ((and (eq recipe :halves) (< index 4)) (t3-api-halves-prefix lib index))
        (t (t3-api-helper-run recipe lib))))

; A helper can append a duplicate lemma before detecting the collision.
; Reaching that entry without the old fact identifies the collision.
(defun t3-api-helper-discard-collision (recipe labels book)
  (let* ((lib (t3-book-values-book-proofs-library book))
         (proof (library-library-proof lib))
         (facts (proof-proof-facts proof))
         (collision (t3-api-helper-first-collision labels facts 0)))
    (if (not collision)
        book
      (let* ((facts (table-delete facts (cadr collision)))
             (without-fact (library-library-with-proof lib (proof-proof-with-facts proof facts)))
             (attempt (t3-api-helper-run-prefix recipe without-fact (car collision))))
        (if (failure-p attempt)
            book
          (t3-book-values-book-proofs-with-library book without-fact))))))

(defun t3-api-helper-attempt (recipe labels book)
  (let ((result (t3-api-helper-run recipe (t3-book-values-book-proofs-library book))))
    (cond ((not (failure-p result))
           (t3-book-values-book-proofs-with-library book result))
          ((member-equal (cadr result) '("ProofMismatch" "assertion"))
           (t3-api-helper-discard-collision recipe labels book))
          ((member-equal (cadr result) '("Unproved" "Unsupported" "value" "key" "coding"
                                       "encoding" "decoding" "translating"))
           book)
          (t result))))

(defun t3-api-helpers-recipes (recipes book names base)
  (if (endp recipes)
      book
    (let* ((trigger (caar recipes))
           (recipe (cadar recipes))
           (labels (cddar recipes)))
      (proof-with-checked-results
          ((book (if (or (member-equal trigger names) (and (eq trigger :none) base))
                     (t3-api-helper-attempt recipe labels book)
                   book)))
        (t3-api-helpers-recipes (cdr recipes) book names base)))))

(defun t3-api-helpers (lib names base)
  (t3-api-helpers-recipes *t3-api-helper-recipes* lib names base))

(defun t3-api-library-helpers (lib)
  (t3-api-helpers lib (table-keys (proof-proof-definitions (t3-api-book-proof lib))) t))

(defun t3-api-library-admit (lines lib seen)
  (if (endp lines)
      (proof-with-checked-results ((lib (t3-api-library-helpers lib)))
        (list lib (reverse seen)))
    (proof-with-checked-results ((raw (t3-api-normalize-line (car lines))))
      (if (member-equal raw seen)
          (t3-api-library-admit (cdr lines) lib seen)
        (proof-with-checked-results
            ((parsed (t3-api-parse raw))
             (lib (t3-books-admit lib (car parsed) (cadr parsed))))
          (t3-api-library-admit (cdr lines) lib (cons raw seen)))))))

(defun t3-api-library (lines)
  (proof-with-checked-results ((ground (t3-api-ground)))
    (t3-api-library-admit lines ground nil)))

(defun t3-api-make-scope (lib seen search earlier)
  (list :t3-api-scope lib seen search earlier))

(defun t3-api-scope-lib (scope)
  (cadr scope))

(defun t3-api-scope-seen (scope)
  (caddr scope))

(defun t3-api-scope-search (scope)
  (cadddr scope))

(defun t3-api-scope-earlier (scope)
  (car (cddddr scope)))

(defun t3-api-scope-init (library)
  (proof-with-checked-results ((base (t3-api-library library)))
    (let ((lib (car base)))
      (proof-with-checked-results ((search (t3-book-theorems-theorems-init lib)))
        (t3-api-make-scope lib (cadr base) search nil)))))

(defun t3-api-definition-names (definitions)
  (if (endp definitions)
      nil
    (proof-with-checked-results
        ((name (proof-term-at (car definitions) 0))
         (rest (t3-api-definition-names (cdr definitions))))
      (cons name rest))))

(defun t3-api-scope-index (search lib kind fields)
  (let ((search (t3-book-theorems-theorems-with-lib search lib)))
    (if (equal kind "choose")
        (proof-with-checked-results ((name (proof-term-at fields 0)))
          (let ((fact (assoc-equal name (proof-proof-facts (t3-api-book-proof lib)))))
            (if (not fact)
                '(:failure "failure" "")
              (proof-with-checked-results ((formula (proof-term-at (cdr fact) 0)))
                (t3-book-theorems-theorems-index-fact search name formula)))))
      (t3-book-theorems-theorems-add search kind fields))))

(defun t3-api-admit-prefix-line (lib search kind fields)
  (proof-with-checked-results ((lib (t3-books-admit lib kind fields)))
    (if (equal kind "define")
        (proof-with-checked-results
            ((names (t3-api-definition-names (cdr fields)))
             (lib (t3-api-helpers lib names nil))
             (search (t3-api-scope-index search lib kind fields)))
          (t3-book-theorems-prepare-prefix-definitions search names))
      (t3-api-scope-index search lib kind fields))))

(defun t3-api-scope-extend-lines (lines lib seen search earlier)
  (if (endp lines)
      (t3-api-make-scope lib (reverse seen) search earlier)
    (proof-with-checked-results ((raw (t3-api-normalize-line (car lines))))
      (if (member-equal raw seen)
          (t3-api-scope-extend-lines (cdr lines) lib seen search earlier)
        (proof-with-checked-results
            ((parsed (t3-api-parse raw))
             (search (t3-api-admit-prefix-line lib search (car parsed) (cadr parsed))))
          (t3-api-scope-extend-lines (cdr lines) (t3-book-theorems-theorems-lib search)
                                     (cons raw seen) search earlier))))))

(defun t3-api-scope-extend (scope earlier)
  (t3-api-scope-extend-lines (nthcdr (len (t3-api-scope-earlier scope)) earlier)
                             (t3-api-scope-lib scope)
                             (reverse (t3-api-scope-seen scope))
                             (t3-api-scope-search scope)
                             earlier))

(defun t3-api-context (library earlier)
  (proof-with-checked-results ((scope (t3-api-scope-init library)))
    (t3-api-scope-extend scope earlier)))

(defun t3-api-forbidden-definitions (definitions)
  (if (endp definitions)
      nil
    (proof-with-checked-results
        ((name (proof-term-at (car definitions) 0))
         (package (proof-term-at name 1)))
      (if (equal package "COMMON-LISP")
          t
        (t3-api-forbidden-definitions (cdr definitions))))))

(defun t3-api-prove-prepared (lib search kind name data measures)
  (let ((search (t3-book-theorems-theorems-with-lib search lib)))
    (proof-with-checked-results ((fragment (t3-books-generate lib search kind name data measures)))
      (let ((entries (t3-books-fragment-entries fragment)))
        (if (endp entries)
            '(:failure "failure" "")
          (proof-with-checked-results ((word (proof-term-at (car (last entries)) 0)))
            (if (equal word "skip") nil (t3-api-own-names entries))))))))

(defun t3-api-prove-from-scope (scope raw kind name data aids)
  (if (member-equal raw (t3-api-scope-seen scope))
      nil
    (proof-with-checked-results ((measures (and (equal kind "define") (t3-api-measures aids))))
      (t3-api-prove-prepared (t3-api-scope-lib scope) (t3-api-scope-search scope)
                             kind name data measures))))

(defun t3-api-proof-request-from-parsed (raw parsed)
  (let ((kind (car parsed))
        (data (cadr parsed)))
    (if (not (member-equal kind '("define" "constrain" "theorem")))
        nil
      (proof-with-checked-results ((name (t3-books-obligation kind data)))
        (if (not name)
            nil
          (let ((definitions (cond ((equal kind "define") (cdr data))
                                   ((equal kind "constrain") (car data))
                                   (t nil))))
            (proof-with-checked-results ((forbidden (t3-api-forbidden-definitions definitions)))
              (and (not forbidden) (list raw kind name data)))))))))

(defun t3-api-proof-request (statement)
  (proof-with-checked-results
      ((raw (t3-api-normalize-line statement))
       (parsed (t3-api-parse raw)))
    (t3-api-proof-request-from-parsed raw parsed)))

(defun t3-api-prove-core (statement earlier library aids)
  (proof-with-checked-results ((request (t3-api-proof-request statement)))
    (and request
         (proof-with-checked-results ((scope (t3-api-context library earlier)))
           (t3-api-prove-from-scope scope (car request) (cadr request)
                                    (caddr request) (cadddr request) aids)))))

(defun t3-api-prove-input (statement earlier library aids)
  (proof-with-checked-results
      ((earlier (t3-api-text-lines earlier))
       (library (t3-api-text-lines library))
       (aids (t3-api-text-lines aids)))
    (t3-api-prove-core statement earlier library aids)))

(defun t3-api-prove (statement earlier library aids)
  (let ((result (t3-api-prove-input statement earlier library aids)))
    (if (failure-p result) nil result)))
