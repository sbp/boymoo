(defun t3-digit-capacity-expansion-comparison (n ans value)
  (library-le (t3-quotient-product (library-plus *proof-one* n)
                                  (t3-digit-capacity-capacity ans))
              (t3-digit-capacity-capacity value)))

(defun t3-digit-capacity-expansion-claim (n ans value)
  (let ((precondition (proof-ite (list *library-natp* n)
                                 (list *t3-list-bounds-char-list* ans) *proof-false*))
        (result (proof-ite (list *t3-list-bounds-char-list* value)
                           (t3-digit-capacity-expansion-comparison n ans value) *proof-false*)))
    (proof-ite precondition result *proof-true*)))

(defun t3-digit-capacity-base-capacity (lib value tests ten ix nonnegative char-ans)
  (let* ((proof (library-library-proof lib))
         (y *library-y*)
         (capacity-y (t3-digit-capacity-capacity y))
         (left (t3-quotient-product (library-plus *proof-one* *library-x*) capacity-y))
         (definitions (list *t3-digit-capacity-capacity*)))
    (proof-with-checked-results
     ((test-pair (proof-term-at tests 0))
      (test (proof-term-at test-pair 0))
      (false-branch (proof-term-at test 3))
      (disabled (t3-logic-libraryproofs-normalize lib false-branch (list ten) (list *proof-not*)))
      (premise (proof-proof-assume proof test t))
      (premise (proof-proof-rewrite proof premise disabled '(1 3)))
      (premise (proof-proof-tidy proof premise))
      (parts (proof-proof-conjunct proof premise))
      (expansion (t3-logic-libraryproofs-simplify lib (list *t3-logic-zp* *library-x*)
                                               (list ix) (list *t3-logic-zp*)))
      (upper (proof-proof-rewrite proof (car parts) expansion '(1)))
      (zero (t3-rational-order-zero-from-bounds lib (t3-rational-order-rational-sums-init lib)
                                               *library-x* nonnegative upper (list ix)))
      (ans-type (t3-digit-capacity-capacity-type lib y))
      (reduced (proof-proof-reflexive proof left))
      (reduced (proof-proof-rewrite proof reduced zero '(1 2 2 2)))
      (computed (proof-proof-compute proof (library-plus *proof-one* *proof-zero*) 1))
      (reduced (proof-proof-rewrite proof reduced computed '(1 2 2)))
      (rational (t3-logic-libraryproofs-rational lib capacity-y (list (car ans-type))))
      (unit (t3-quotient-mul-one lib capacity-y rational))
      (reduced (proof-proof-chain proof reduced (list unit)))
      (result
       (if (equal value y)
           (proof-with-checked-results
            ((bound (library-library-cite lib "WEAK-REFLEXIVE" (list capacity-y) (list (car ans-type)))))
            (list char-ans bound))
         (proof-with-checked-results
          ((pair (proof-term-at (last tests) 0))
           (last-test (proof-term-at pair 0))
           (raw-nil (proof-proof-assume proof last-test t))
           (nil-eq (t3-logic-libraryproofs-simplify-first lib raw-nil nil
                                                        (list (proof-cl "NULL") (proof-cl "EQ"))))
           (base-left (proof-proof-reflexive proof capacity-y))
           (base-left (proof-proof-rewrite proof base-left nil-eq '(1 2 1)))
           (cap-nil (t3-logic-libraryproofs-normalize lib
                                                     (t3-digit-capacity-capacity *proof-false*) nil definitions))
           (base-left (proof-proof-chain proof base-left (list cap-nil)))
           (base-right (t3-logic-libraryproofs-normalize lib (t3-digit-capacity-capacity value)
                                                        nil definitions))
           (bound (t3-logic-libraryproofs-prove lib (library-lt *proof-one* *t3-digit-capacity-ten*) nil nil))
           (bound (library-library-as-weak lib bound))
           (base-left (proof-proof-symmetric proof base-left))
           (bound (proof-proof-rewrite proof bound base-left '(1 1 2)))
           (base-right (proof-proof-symmetric proof base-right))
           (bound (proof-proof-rewrite proof bound base-right '(1 1 1)))
           (chars (t3-logic-libraryproofs-prove-formula
                   lib (list *t3-list-bounds-char-list* value)
                   (list *t3-list-bounds-char-list* *t3-logic-atom* *proof-not*) nil)))
          (list chars bound))))
      (reduced (proof-proof-symmetric proof reduced))
      (bound (proof-proof-rewrite proof (cadr result) reduced '(1 1 2)))
      (bound (proof-proof-tidy proof bound)))
     (list (car result) bound))))

(defun t3-digit-capacity-grown-capacity (lib part suffix next-ans next-value n-type q-type upper ih-bound)
  (let* ((successor (library-plus *proof-one* part))
         (next-counter (library-plus *proof-one* *library-x*))
         (limit (t3-quotient-product successor *t3-digit-capacity-ten*))
         (cap-suffix (t3-digit-capacity-capacity suffix)))
    (proof-with-checked-results
     ((evidence (t3-logic-evidence-init lib nil (list n-type q-type upper) nil))
      (numeric (t3-arithmetic-successor-bound lib *library-x* next-counter limit evidence))
      (type-ans (t3-digit-capacity-capacity-type lib suffix))
      (scaled (t3-digit-capacity-multiply-weak
               lib (car numeric) cap-suffix (list n-type q-type (car type-ans)) (cadr type-ans)))
      (lib (cdr scaled))
      (proof (library-library-proof lib))
      (defined (t3-quotient-product successor (t3-digit-capacity-capacity next-ans)))
      (construction (proof-proof-fact proof "consp-cons"
                                     (seq-zip (list *library-x* *library-y*) (cdr next-ans))))
      (equation (proof-proof-reflexive proof defined))
      (expansion (t3-digit-capacity-capacity-branch lib next-ans construction))
      (equation (proof-proof-rewrite proof equation expansion '(1 2 1)))
      (flipped (library-library-axiom lib "COMMUTATIVITY-OF-*" (list *t3-digit-capacity-ten* cap-suffix)))
      (equation (proof-proof-rewrite proof equation flipped '(1 2 1)))
      (associate (library-library-axiom lib "ASSOCIATIVITY-OF-*"
                                       (list cap-suffix *t3-digit-capacity-ten* successor)))
      (equation (proof-proof-chain proof equation (list associate)))
      (equation (proof-proof-symmetric proof equation))
      (scaled (proof-proof-rewrite proof (car scaled) equation '(1 1 1)))
      (next-ans-type (t3-digit-capacity-capacity-type lib next-ans))
      (next-value-type (t3-digit-capacity-capacity-type lib next-value))
      (bound (t3-size-chain lib scaled ih-bound
                            (list n-type q-type (car type-ans) (car next-ans-type) (car next-value-type)))))
     (cons bound lib))))

(defun t3-digit-capacity-explode-bound-recursive-leaf (lib simplified tests formula ix ten char-ans)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results ((args (proof-list-of-length (cdr simplified) 3)))
      (let ((part (car args))
            (next-ans (caddr args)))
        (if (not (and (equal part (list *t3-digit-capacity-floor* *library-x* *t3-digit-capacity-ten*))
                      (proof-is-call next-ans *proof-cons*)))
            '(:failure "failure" "")
          (proof-with-checked-results
           ((signed (t3-logic-evidence-init lib tests nil (list *t3-logic-zp*)))
            (entering (t3-logic-evidence-require signed (library-positive *library-x*)))
            (entering (car entering))
            (interval (library-library-cite lib "T3-FLOOR-INTERVAL"
                                            (list *library-x* *t3-digit-capacity-ten*)
                                            (list ix entering ten)))
            (interval (proof-proof-conjunct proof interval))
            (next-natural (car interval))
            (comparisons (proof-proof-conjunct proof (cadr interval)))
            (descent (car comparisons))
            (upper (cadr comparisons))
            (q-type (library-library-cite lib "NATURAL-INTEGER" (list part) (list next-natural)))
            (smaller (library-library-cite lib "NFIX-DECREASE" (list part *library-x*)
                                           (list q-type ix entering descent)))
            (pairs (list (list *library-x* part) (list *library-y* next-ans)))
            (decrease (proof-step-first smaller))
            (child (proof-subst formula (list (cons *library-x* part) (cons *library-y* next-ans))))
            (ih (proof-proof-assume proof (proof-ite decrease child *proof-true*) t))
            (claim (proof-proof-prove-if proof ih smaller))
            (digit-term (proof-term-at next-ans 1))
            (digit (library-library-cite lib "T3-DIGIT-CHARACTER" (cdr digit-term) nil))
            (child-chars (t3-list-bounds-char-cons lib digit char-ans))
            (typed (t3-scan-typed-pair lib next-natural child-chars))
            (hypothesis (proof-proof-prove-if proof claim typed))
            (parts (proof-proof-conjunct proof hypothesis))
            (bound (t3-digit-capacity-grown-capacity
                    lib part *library-y* next-ans simplified ix q-type upper (cadr parts))))
           (cons (list (car parts) (car bound) pairs) (cdr bound))))))))

(defund t3-digit-capacity-explode-bound-leaf
    (value tests lib formula template ix nonnegative ten char-ans substitutions)
  (proof-with-checked-results
   ((equation (t3-logic-libraryproofs-normalize lib value nil nil))
    (simplified (if equation (proof-rewritten-term equation) value))
    (case-formula (t3-digit-capacity-expansion-claim *library-x* *library-y* simplified))
    (result
     (if (proof-is-call simplified *t3-digit-capacity-explode*)
         (proof-with-checked-results
          ((result (t3-digit-capacity-explode-bound-recursive-leaf lib simplified tests
                                                                  formula ix ten char-ans)))
          (cons (list (caar result) (cadar result) (append substitutions (list (caddar result))))
                (cdr result)))
       (proof-with-checked-results
        ((result (t3-digit-capacity-base-capacity lib simplified tests ten ix nonnegative char-ans)))
        (cons (list (car result) (cadr result) substitutions) lib))))
    (lib (cdr result))
    (parts (car result))
    (pair (t3-scan-typed-pair lib (car parts) (cadr parts)))
    (step (t3-scan-conclusion lib case-formula pair))
    (step (if equation
              (let ((proof (library-library-proof lib)))
                (proof-with-checked-results ((reversed (proof-proof-symmetric proof equation)))
                  (proof-proof-rewrite-result proof step reversed template *proof-result*)))
            step)))
   (cons (list step (caddr parts)) lib)))

(defun t3-digit-capacity-explode-bound-leaves
    (requests lib formula template ix nonnegative ten char-ans substitutions)
  (declare (xargs :measure (acl2-count requests)))
  (if (endp requests)
      (list nil lib substitutions)
    (proof-with-checked-results
     ((leaf (t3-digit-capacity-explode-bound-leaf
             (caar requests) (cadar requests) lib formula template ix nonnegative ten
             char-ans substitutions))
      (rest (t3-digit-capacity-explode-bound-leaves (cdr requests) (cdr leaf) formula template
                                                   ix nonnegative ten char-ans (cadar leaf))))
     (list (cons (cons (car requests) (caar leaf)) (car rest)) (cadr rest) (caddr rest)))))

(defun t3-digit-capacity-explode-bound (lib)
  (let* ((proof (library-library-proof lib))
         (index (list *library-nfix* *library-x*))
         (call (list *t3-digit-capacity-explode* *library-x* *t3-digit-capacity-ten* *library-y*))
         (formula (t3-digit-capacity-expansion-claim *library-x* *library-y* call))
         (template (t3-digit-capacity-expansion-claim *library-x* *library-y* *proof-result*)))
    (proof-with-checked-results
     ((source (proof-proof-unfold proof call))
      (body (proof-rewritten-term source))
      (equation (t3-logic-libraryproofs-normalize lib body nil nil))
      (source (proof-proof-chain proof source (list equation)))
      (assumed (proof-proof-assume proof (cadr template) t))
      (parts (proof-proof-conjunct proof assumed))
      (natural (car parts))
      (char-ans (cadr parts))
      (ix (library-library-cite lib "NATURAL-INTEGER" (list *library-x*) (list natural)))
      (nonnegative (library-library-cite lib "NATURAL-NONNEGATIVE" (list *library-x*) (list natural)))
      (ten (t3-digit-capacity-known-print-base lib *t3-digit-capacity-ten*))
      (value (proof-rewritten-term source))
      (requests (t3-logic-libraryproofs-by-value-leaves lib value nil))
      (leaves (t3-digit-capacity-explode-bound-leaves requests lib formula template ix nonnegative
                                                     ten char-ans nil))
      (lib (cadr leaves))
      (proof (library-library-proof lib))
      (step (t3-logic-libraryproofs-by-value lib value template (car leaves) nil))
      (reversed (proof-proof-symmetric proof source))
      (step (proof-proof-rewrite-result proof step reversed template *proof-result*))
