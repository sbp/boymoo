(in-package "BOYMOO-PROVER")
(set-verify-guards-eagerness 0)

(defconst *t3-digit-capacity-ten* (proof-quote 10))
(defconst *t3-digit-capacity-capacity* (proof-sym "T3-DECIMAL-CAPACITY" "ACL2"))
(defconst *t3-digit-capacity-explode* (proof-sym "EXPLODE-NONNEGATIVE-INTEGER" "ACL2"))
(defconst *t3-digit-capacity-digit* (proof-sym "DIGIT-TO-CHAR" "ACL2"))
(defconst *t3-digit-capacity-floor* (proof-cl "FLOOR"))

(defun t3-digit-capacity-capacity (argument)
  (list *t3-digit-capacity-capacity* argument))

(defun t3-digit-capacity-capacity-branch (lib argument test)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
     ((equation (proof-proof-unfold proof (t3-digit-capacity-capacity argument)))
      (body (proof-rewritten-term equation))
      (branch (proof-proof-select proof body test))
      (selected (proof-proof-chain proof equation (list branch)))
      (value (proof-rewritten-term selected))
      (normalized (t3-logic-libraryproofs-normalize lib value nil nil)))
     (proof-proof-chain proof selected (list normalized)))))

(defun t3-digit-capacity-capacity-type (lib term)
  (proof-with-checked-results
   ((typed (library-library-cite lib "T3-DECIMAL-CAPACITY-TYPE" (list term) nil)))
   (proof-proof-conjunct (library-library-proof lib) typed)))

(defun t3-digit-capacity-capacity-one (lib term typed)
  (let ((proof (library-library-proof lib))
        (value (t3-digit-capacity-capacity term)))
    (proof-with-checked-results
     ((law (proof-proof-fact proof "integer-discrete" (list (list *library-x* value))))
      (typed (proof-list-of-length typed 2))
      (types (t3-scan-typed-pair lib (car typed) (cadr typed))))
     (proof-proof-modus-ponens proof law types))))

(defun t3-digit-capacity-capacity-fold (lib)
  (let* ((tail-capacity (t3-digit-capacity-capacity *t3-list-bounds-tail*))
         (times-ten (t3-quotient-product tail-capacity *t3-digit-capacity-ten*))
         (template (proof-ite (library-integer *proof-result*)
                              (library-positive *proof-result*) *proof-false*)))
    (proof-with-checked-results
     ((lib (t3-list-bounds-define-fold lib *t3-digit-capacity-capacity* times-ten *proof-one*))
      (proof (library-library-proof lib))
      (cons-case (proof-proof-assume proof *t3-list-bounds-cons-x* t))
      (formula (proof-subst template (list (cons *proof-result*
                                                (t3-digit-capacity-capacity *library-x*)))))
      (hypothesis (t3-list-bounds-tail-hypothesis lib formula cons-case))
      (types (proof-proof-conjunct proof hypothesis))
      (int-tail (car types))
      (pos-tail (cadr types))
      (product-type (t3-logic-libraryproofs-type-of lib times-ten (list int-tail)))
      (ten-rational (t3-logic-libraryproofs-rational lib *t3-digit-capacity-ten* nil))
      (tail-rational (t3-logic-libraryproofs-rational lib tail-capacity (list int-tail)))
      (ten-positive (t3-logic-libraryproofs-prove lib (library-positive *t3-digit-capacity-ten*) nil nil))
      (product-pos (library-library-cite lib "POSITIVE-PRODUCT"
                                         (list *t3-digit-capacity-ten* tail-capacity)
                                         (list ten-rational tail-rational ten-positive pos-tail)))
      (expansion (t3-digit-capacity-capacity-branch lib *library-x* cons-case))
      (typed-product (t3-scan-typed-pair lib product-type product-pos))
      (reversed (proof-proof-symmetric proof expansion))
      (step (proof-proof-rewrite-result proof typed-product reversed template *proof-result*))
      (atom-case (proof-proof-assume proof *t3-list-bounds-cons-x* nil))
      (expansion (t3-digit-capacity-capacity-branch lib *library-x* atom-case))
      (one-integer (t3-logic-libraryproofs-type-of lib *proof-one* nil))
      (one-positive (t3-logic-libraryproofs-prove lib (library-positive *proof-one*) nil nil))
      (typed-one (t3-scan-typed-pair lib one-integer one-positive))
      (reversed (proof-proof-symmetric proof expansion))
      (base (proof-proof-rewrite-result proof typed-one reversed template *proof-result*))
      (induction (t3-list-bounds-tail-induction lib formula step base)))
     (library-library-lemma lib "T3-DECIMAL-CAPACITY-TYPE" formula induction nil))))

(defun t3-digit-capacity-capacity-append-lemma (lib)
  (let* ((proof (library-library-proof lib))
         (x *library-x*)
         (y *library-y*)
         (combined (list *t3-list-bounds-append* x y))
         (target (t3-digit-capacity-capacity combined))
         (capacity-y (t3-digit-capacity-capacity y))
         (factor (t3-quotient-product capacity-y (t3-digit-capacity-capacity x)))
         (formula (proof-eq target factor)))
    (proof-with-checked-results
     ((cons-case (proof-proof-assume proof *t3-list-bounds-cons-x* t))
      (expanded (t3-list-bounds-append-branch lib x y cons-case))
      (first (proof-proof-reflexive proof target))
      (first (proof-proof-rewrite proof first expanded '(1 2 1)))
      (value (proof-rewritten-term expanded))
      (construction (proof-proof-fact proof "consp-cons" (seq-zip (list x y) (cdr value))))
      (branch (t3-digit-capacity-capacity-branch lib value construction))
      (first (proof-proof-chain proof first (list branch)))
      (ih (t3-list-bounds-tail-hypothesis lib formula cons-case))
      (first (proof-proof-rewrite proof first ih '(1 2 2)))
      (associate (library-library-axiom lib "ASSOCIATIVITY-OF-*"
                                       (list *t3-digit-capacity-ten*
                                             (t3-digit-capacity-capacity *t3-list-bounds-tail*) capacity-y)))
      (associate (proof-proof-symmetric proof associate))
      (first (proof-proof-chain proof first (list associate)))
      (branch (t3-digit-capacity-capacity-branch lib x cons-case))
      (branch (proof-proof-symmetric proof branch))
      (first (proof-proof-rewrite proof first branch '(1 2 1)))
      (atom-case (proof-proof-assume proof *t3-list-bounds-cons-x* nil))
      (single (t3-list-bounds-append-branch lib x y atom-case))
      (base (proof-proof-reflexive proof target))
      (base (proof-proof-rewrite proof base single '(1 2 1)))
      (types (t3-digit-capacity-capacity-type lib y))
      (rational (t3-logic-libraryproofs-rational lib capacity-y (list (car types))))
      (unit (library-library-cite lib "T3-RAT-MUL-UNIT" (list capacity-y) (list rational)))
      (unit (proof-proof-symmetric proof unit))
      (base (proof-proof-chain proof base (list unit)))
      (branch (t3-digit-capacity-capacity-branch lib x atom-case))
      (branch (proof-proof-symmetric proof branch))
      (base (proof-proof-rewrite proof base branch '(1 2 1)))
      (induction (t3-list-bounds-tail-induction lib formula first base)))
     (library-library-lemma lib "T3-APPEND-CAPACITY" formula induction nil))))

(defun t3-digit-capacity-multiply-weak (lib order factor types factor-positive)
  (proof-with-checked-results
   ((lib (t3-rational-order-weak-scale lib))
    (ends (t3-size-endpoints order))
    (ends (proof-list-of-length ends 2))
    (sums (t3-rational-order-rational-sums-init lib))
    (lower (t3-rational-order-rational-sums-type-of sums (car ends) types))
    (upper (t3-rational-order-rational-sums-type-of sums (cadr ends) types))
    (factor-type (t3-rational-order-rational-sums-type-of sums factor types))
    (scaled (library-library-cite lib "T3-RAT-WEAK-SCALE" (append ends (list factor))
                                  (list lower upper factor-type order factor-positive))))
   (cons scaled lib)))

(defun t3-digit-capacity-append-capacity (lib left right right-type)
  (let ((right-capacity (t3-digit-capacity-capacity right)))
    (proof-with-checked-results
     ((left-type (t3-digit-capacity-capacity-type lib left))
      (above-one (t3-digit-capacity-capacity-one lib left left-type))
      (right-integer (proof-term-at right-type 0))
      (right-positive (proof-term-at right-type 1))
      (scaled (t3-digit-capacity-multiply-weak lib above-one right-capacity
                                                (list (car left-type) right-integer) right-positive))
      (lib (cdr scaled))
      (proof (library-library-proof lib))
      (rational (t3-logic-libraryproofs-rational lib right-capacity (list right-integer)))
      (unit (t3-quotient-mul-one lib right-capacity rational))
      (scaled (proof-proof-rewrite proof (car scaled) unit '(1 1 2)))
      (switched (library-library-axiom lib "COMMUTATIVITY-OF-*"
                                       (list right-capacity (t3-digit-capacity-capacity left))))
      (scaled (proof-proof-rewrite proof scaled switched '(1 1 1)))
      (append-product (library-library-cite lib "T3-APPEND-CAPACITY" (list left right) nil))
      (append-product (proof-proof-symmetric proof append-product))
      (rewritten (proof-proof-rewrite proof scaled append-product '(1 1 1)))
      (rewritten (proof-proof-tidy proof rewritten)))
     (cons rewritten lib))))

(defun t3-digit-capacity-known-print-base (lib radix)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
     ((evaluated (t3-logic-libraryproofs-normalize
                  lib (list *t3-quotient-print-base* radix) nil
                  (list *t3-quotient-print-base* (proof-sym "MEMBER-EQUAL" "ACL2")
                        *t3-logic-endp* *t3-logic-atom* *proof-not*)))
      (value (if evaluated
                 (proof-rewritten-term evaluated)
               '(:failure "failure" "")))
      (computed (proof-proof-compute proof value *proof-t*))
      (result (proof-proof-chain proof evaluated (list computed))))
     (proof-proof-true-from-eq proof result))))

(defun t3-digit-capacity-floor-interval (lib upper)
  (let* ((proof (library-library-proof lib))
         (ix-term (library-integer *library-x*))
         (px-term (library-positive *library-x*))
         (radix-term (list *t3-quotient-print-base* *library-y*)))
    (proof-with-checked-results
     ((ix (proof-proof-assume proof ix-term t))
      (px (proof-proof-assume proof px-term t))
      (radix (proof-proof-assume proof radix-term t))
      (evidence (t3-logic-evidence-init lib nil (list ix px radix) nil))
      (bounds (t3-quotient-rounded-bounds lib (list *t3-digit-capacity-floor* *library-x* *library-y*)
                                         evidence px upper))
      (lib (cdr bounds))
      (steps (caar bounds))
      (comparisons (if upper
                       (t3-scan-typed-pair lib (cadr steps) (caddr steps))
                     (cadr steps)))
      (result (t3-scan-typed-pair lib (car steps) comparisons))
      (claim (proof-step-first result))
      (ix-term (proof-step-first ix))
      (px-term (proof-step-first px))
      (radix-term (proof-step-first radix)))
     (library-library-lemma lib (if upper "T3-FLOOR-INTERVAL" "T3-FLOOR-DECREASE")
                            claim result
                            (list (proof-neg ix-term) (proof-neg px-term) (proof-neg radix-term))))))

(defund t3-digit-capacity-digit-character-leaf (char tests lib)
  (declare (ignore tests))
  (t3-logic-libraryproofs-prove lib (list *t3-list-bounds-character* char) nil nil))

(defun t3-digit-capacity-digit-character-leaves (requests lib)
  (declare (xargs :measure (acl2-count requests)))
  (if (endp requests)
      nil
    (proof-with-checked-results
     ((leaf (t3-digit-capacity-digit-character-leaf (caar requests) (cadar requests) lib))
      (rest (t3-digit-capacity-digit-character-leaves (cdr requests) lib)))
     (cons (cons (car requests) leaf) rest))))

(defun t3-digit-capacity-digit-character (lib)
  (let ((proof (library-library-proof lib))
        (term (list *t3-digit-capacity-digit* *library-x*))
        (template (list *t3-list-bounds-character* *proof-result*)))
    (proof-with-checked-results
     ((expansion (proof-proof-unfold proof term))
      (value (proof-rewritten-term expansion))
      (requests (t3-logic-libraryproofs-by-value-leaves lib value nil))
      (leaves (t3-digit-capacity-digit-character-leaves requests lib))
      (result (t3-logic-libraryproofs-by-value lib value template leaves nil))
      (reversed (proof-proof-symmetric proof expansion))
