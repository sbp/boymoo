(in-package "BOYMOO-PROVER")
(set-verify-guards-eagerness 0)

(defconst *t3-book-indexed-calls-aux* (proof-sym "MAKE-MV-NTH-CALLS-AUX" "ACL2"))
(defconst *t3-book-indexed-calls-i* (proof-sym "I" "ACL2"))
(defconst *t3-book-indexed-calls-n* (proof-sym "N" "ACL2"))
(defconst *t3-book-indexed-calls-length-aux* (proof-sym "LEN-OF-MAKE-MV-NTH-CALLS-AUX" "ACL2"))

(defun t3-book-indexed-calls-fix-value (lib value type-proof)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((exported (library-library-cite lib "T3-EXPORTED-NFIX" (list value) nil))
         (call (t3-book-term-collections-step-term-at exported 2))
         (logical (proof-proof-unfold proof call))
         (body (t3-book-term-collections-step-term-at logical 2))
         (selected (proof-proof-select proof body type-proof)))
      (proof-proof-chain proof exported (list logical selected)))))

(defun t3-book-indexed-calls-clip-nonpositive (lib value nonpositive)
  (let* ((proof (library-library-proof lib))
         (test (list *library-natp* value))
         (zero (proof-eq value *proof-zero*)))
    (proof-with-checked-results
        ((natural (proof-proof-assume proof test t))
         (integer-step (library-library-cite lib "NATURAL-INTEGER" (list value) (list natural)))
         (lower (library-library-cite lib "NATURAL-NONNEGATIVE" (list value) (list natural)))
         (nonzero (proof-proof-assume proof zero nil))
         (contradiction (library-library-cite lib "T3-POSITIVE-FROM-NONZERO" (list value)
                                              (list integer-step lower nonzero)))
         (cut (proof-proof-cut proof contradiction nonpositive))
         (equality (proof-proof-front proof cut zero))
         (selected (t3-book-indexed-calls-fix-value lib value natural))
         (yes (proof-proof-chain proof selected (list equality)))
         (not-natural (proof-proof-assume proof test nil))
         (no (t3-book-indexed-calls-fix-value lib value not-natural)))
      (proof-proof-cases proof test yes no))))

(defun t3-book-indexed-calls-interval-init (lib call)
  (if (integerp call)
      '(:failure "failure" "")
    (proof-with-checked-results ((endpoints (proof-list-of-length (seq-slice call -2 :none) 2)))
      (let* ((index (car endpoints))
             (end (cadr endpoints))
             (tests (list (list *library-natp* index) (list *library-natp* end)
                          (library-lt index end)))
             (before (library-diff end index))
             (next-index (library-plus *proof-one* index))
             (remaining (library-diff end next-index))
             (measure (list *library-nfix* before))
             (pairs (list (list index next-index))))
        (list :t3-book-indexed-calls-interval lib call index end tests before next-index
              remaining measure pairs)))))

(defun t3-book-indexed-calls-interval-lib (interval) (nth 1 interval))
(defun t3-book-indexed-calls-interval-call (interval) (nth 2 interval))
(defun t3-book-indexed-calls-interval-index (interval) (nth 3 interval))
(defun t3-book-indexed-calls-interval-end (interval) (nth 4 interval))
(defun t3-book-indexed-calls-interval-tests (interval) (nth 5 interval))
(defun t3-book-indexed-calls-interval-before (interval) (nth 6 interval))
(defun t3-book-indexed-calls-interval-next-index (interval) (nth 7 interval))
(defun t3-book-indexed-calls-interval-remaining (interval) (nth 8 interval))
(defun t3-book-indexed-calls-interval-measure (interval) (nth 9 interval))
(defun t3-book-indexed-calls-interval-pairs (interval) (nth 10 interval))

(defun t3-book-indexed-calls-comparison (lib a b integers)
  (proof-with-checked-results
      ((a-type (t3-logic-libraryproofs-type-of lib a integers))
       (b-type (t3-logic-libraryproofs-type-of lib b integers)))
    (library-library-cite lib "LESS-DIFFERENCE" (list a b) (list a-type b-type))))

(defun t3-book-indexed-calls-less-from-difference (lib a b positive-difference integers)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((comparison (t3-book-indexed-calls-comparison lib a b integers))
         (positive-value (t3-book-term-collections-step-term-at positive-difference 2))
         (delta (library-library-linear-equal lib (library-diff b a) positive-value integers))
         (comparison (proof-proof-rewrite proof comparison delta '(1 2 2))))
      (proof-proof-transport proof positive-difference comparison))))

(defun t3-book-indexed-calls-nat-integer (lib step)
  (proof-with-checked-results ((value (t3-book-term-collections-step-term-at step 1)))
    (library-library-cite lib "NATURAL-INTEGER" (list value) (list step))))

(defun t3-book-indexed-calls-interval-induction-case (interval formula evidence)
  (let* ((lib (t3-book-indexed-calls-interval-lib interval))
         (proof (library-library-proof lib))
         (index (t3-book-indexed-calls-interval-index interval))
         (end (t3-book-indexed-calls-interval-end interval))
         (remaining (t3-book-indexed-calls-interval-remaining interval))
         (before (t3-book-indexed-calls-interval-before interval)))
    (proof-with-checked-results
        ((parts (proof-list-of-length evidence 3))
         (indexed (t3-book-indexed-calls-nat-integer lib (car parts)))
         (cap (t3-book-indexed-calls-nat-integer lib (cadr parts)))
         (numbers (list indexed cap))
         (comparison (t3-book-indexed-calls-comparison lib index end numbers))
         (span-positive (proof-proof-rewrite proof (caddr parts) comparison '(1)))
         (lost (t3-logic-libraryproofs-prove lib (library-positive *proof-one*) nil nil))
         (reduced (t3-book-indexed-calls-less-from-difference lib remaining before lost numbers))
         (remaining-type (t3-logic-libraryproofs-type-of lib remaining numbers))
         (before-type (t3-logic-libraryproofs-type-of lib before numbers))
         (smaller (library-library-cite lib "NFIX-DECREASE" (list remaining before)
                                        (list remaining-type before-type span-positive reduced)))
         (decrease (proof-step-first smaller))
         (child (proof-subst formula
                             (proof-bindings-table (t3-book-indexed-calls-interval-pairs interval) nil)))
         (hypothesis (proof-proof-assume proof (proof-ite decrease child *proof-true*) t))
         (induction (proof-proof-prove-if proof hypothesis smaller)))
      (list induction numbers span-positive))))

(defun t3-book-indexed-calls-interval-induct (interval result formula)
  (let ((lib (t3-book-indexed-calls-interval-lib interval)))
    (proof-with-checked-results
        ((rank (library-library-cite lib "NFIX-ORDINAL"
                                    (list (t3-book-indexed-calls-interval-before interval)) nil)))
      (proof-proof-induct (library-library-proof lib) rank result formula
                          (t3-book-indexed-calls-interval-measure interval)
                          (list (t3-book-indexed-calls-interval-pairs interval))))))

(defun t3-book-indexed-calls-indexed-type-prove-branch (opened evidence lib interval normalized accepted)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((value (t3-book-term-collections-step-term-at opened 2))
         (result
          (if (equal value *proof-false*)
              (t3-book-substitution-quoted-base lib (list *t3-book-substitution-list* *proof-false*))
            (proof-with-checked-results
                ((induction (t3-book-indexed-calls-interval-induction-case interval normalized evidence))
                 (tail (proof-proof-modus-ponens proof (car induction) accepted)))
              (t3-book-term-collections-constructed-type
               1000000 lib *t3-book-substitution-list* value (list accepted tail))))))
      (library-library-transport-argument lib result opened 1))))

(defun t3-book-indexed-calls-indexed-length-natural (typed lower lib)
  (proof-with-checked-results ((value (t3-book-term-collections-step-term-at typed 1)))
    (library-library-cite lib "NATURAL-FROM-BOUNDS" (list value) (list typed lower))))

(defun t3-book-indexed-calls-indexed-length-join (proof left right)
  (proof-with-checked-results ((symmetric (proof-proof-symmetric proof right)))
    (proof-proof-chain proof left (list symmetric))))

(defun t3-book-indexed-calls-indexed-length-absent-end (lib i indexed left right)
  (let* ((proof (library-library-proof lib))
         (value (library-diff *proof-zero* i)))
    (proof-with-checked-results
        ((lower (library-library-cite lib "NATURAL-NONNEGATIVE" (list i) (list indexed)))
         (typed (library-library-cite lib "NATURAL-INTEGER" (list i) (list indexed)))
         (comparison (t3-book-indexed-calls-comparison lib i *proof-zero* (list typed)))
         (nonpositive (proof-proof-rewrite proof lower comparison '(1 1)))
         (fixed (t3-book-indexed-calls-clip-nonpositive lib value nonpositive))
         (right (proof-proof-chain proof right (list fixed))))
      (t3-book-indexed-calls-indexed-length-join proof left right))))

(defun t3-book-indexed-calls-indexed-length-empty (lib interval evidence left right)
  (let ((proof (library-library-proof lib))
        (i (t3-book-indexed-calls-interval-index interval))
        (n (t3-book-indexed-calls-interval-end interval)))
    (proof-with-checked-results
        ((int-index (library-library-cite lib "NATURAL-INTEGER" (list i) (list (car evidence))))
         (int-bound (library-library-cite lib "NATURAL-INTEGER" (list n) (list (cadr evidence))))
         (comparison (t3-book-indexed-calls-comparison lib i n (list int-index int-bound)))
         (negative (proof-term-at evidence 2))
         (nonpositive (proof-proof-rewrite proof negative comparison '(1 1)))
         (fixed (t3-book-indexed-calls-clip-nonpositive
                 lib (t3-book-indexed-calls-interval-before interval) nonpositive))
         (right (proof-proof-chain proof right (list fixed))))
      (t3-book-indexed-calls-indexed-length-join proof left right))))

(defun t3-book-indexed-calls-indexed-length-grow (lib interval goal evidence left right)
  (let ((proof (library-library-proof lib))
        (index (t3-book-indexed-calls-interval-index interval))
        (end (t3-book-indexed-calls-interval-end interval))
        (before (t3-book-indexed-calls-interval-before interval))
        (remaining (t3-book-indexed-calls-interval-remaining interval)))
    (proof-with-checked-results
        ((induction (t3-book-indexed-calls-interval-induction-case interval goal evidence))
         (ih (car induction))
         (numbers (cadr induction))
         (span-positive (caddr induction))
         (span-type (t3-logic-libraryproofs-type-of lib before numbers))
         (lower (library-library-cite lib "POSITIVE-NONNEGATIVE"
                                      (list before) (list span-type span-positive)))
         (span-natural (t3-book-indexed-calls-indexed-length-natural span-type lower lib))
         (span-fixed (t3-book-indexed-calls-fix-value lib before span-natural))
         (right (proof-proof-chain proof right (list span-fixed)))
         (one-below (library-library-cite lib "T3-ONE-BELOW"
                                         (list before) (list span-type span-positive)))
         (identity (library-library-linear-equal lib (library-diff before *proof-one*) remaining numbers))
         (next-lower (proof-proof-rewrite proof one-below identity '(1 1 1)))
         (next-type (t3-logic-libraryproofs-type-of lib remaining numbers))
         (next-natural (t3-book-indexed-calls-indexed-length-natural next-type next-lower lib))
         (one-natural (t3-logic-libraryproofs-natural lib *proof-one*))
         (next-index (library-library-cite lib "NATURAL-SUM" (list *proof-one* index)
                                           (list one-natural (car evidence))))
         (child-value (t3-book-term-collections-step-term-at ih 2))
         (child (proof-proof-select proof child-value next-index))
         (end-fixed (t3-book-indexed-calls-fix-value lib end (cadr evidence)))
         (child (t3-book-spines-replace-value lib child (list end-fixed)))
         (remaining-fixed (t3-book-indexed-calls-fix-value lib remaining next-natural))
         (child (proof-proof-chain proof child (list remaining-fixed)))
         (replacement (proof-proof-chain proof ih (list child)))
         (left (t3-book-spines-replace-value lib left (list replacement)))
         (left-value (t3-book-term-collections-step-term-at left 2))
         (identity (library-library-linear-equal lib left-value before numbers))
         (left (proof-proof-chain proof left (list identity))))
      (t3-book-indexed-calls-indexed-length-join proof left right))))

(defun t3-book-indexed-calls-indexed-length-prove-branch (opened evidence lib interval width span goal)
  (let ((proof (library-library-proof lib))
        (i (t3-book-indexed-calls-interval-index interval))
        (n (t3-book-indexed-calls-interval-end interval)))
    (proof-with-checked-results
        ((identity (proof-proof-reflexive proof width))
         (left (proof-proof-rewrite proof identity opened '(1 2 1)))
         (value (t3-book-term-collections-step-term-at opened 2))
         (length-step (t3-book-halves-length-cons lib value nil))
         (left (proof-proof-chain proof left (list length-step)))
         (indexed (proof-term-at evidence 0))
         (right (proof-proof-select proof span indexed)))
      (if (endp (cdr evidence))
          (t3-book-indexed-calls-indexed-length-join proof left right)
        (proof-with-checked-results
            ((fixed (t3-book-indexed-calls-fix-value lib n (cadr evidence)))
             (right (t3-book-spines-replace-value lib right (list fixed))))
          (cond ((endp (cddr evidence))
                 (t3-book-indexed-calls-indexed-length-absent-end lib i indexed left right))
                ((equal value *proof-false*)
                 (t3-book-indexed-calls-indexed-length-empty lib interval evidence left right))
                (t (t3-book-indexed-calls-indexed-length-grow
                    lib interval goal evidence left right))))))))

(defun t3-book-indexed-calls-interval-cases-branch (signed interval source prove)
  (let* ((lib (t3-book-indexed-calls-interval-lib interval))
         (proof (library-library-proof lib)))
    (proof-with-checked-results
        ((body (t3-book-term-collections-step-term-at source 2))
         (normalized (t3-logic-libraryproofs-normalize lib body signed (list *proof-not*)))
         (bounds (proof-proof-chain proof source (list normalized))))
      (case (car prove)
        (:type
         (t3-book-indexed-calls-indexed-type-prove-branch
          bounds signed lib interval (cadr prove) (caddr prove)))
        (:length
         (t3-book-indexed-calls-indexed-length-prove-branch
          bounds signed lib interval (cadr prove) (caddr prove) (cadddr prove)))
        (otherwise
         (let ((reply (assoc-equal (list bounds signed) (cdr prove))))
           (if reply (cdr reply) '(:failure "Unproved" ""))))))))

(defun t3-book-indexed-calls-interval-cases (interval prove)
  (let* ((lib (t3-book-indexed-calls-interval-lib interval))
         (proof (library-library-proof lib))
         (tests (t3-book-indexed-calls-interval-tests interval)))
    (proof-with-checked-results
        ((source (proof-proof-unfold proof (t3-book-indexed-calls-interval-call interval)))
         (index-test (car tests))
         (cap-test (cadr tests))
         (span-test (caddr tests))
         (indexed (proof-proof-assume proof index-test t))
         (cap (proof-proof-assume proof cap-test t))
         (growing (proof-proof-assume proof span-test t))
         (not-growing (proof-proof-assume proof span-test nil))
         (shorter (t3-book-indexed-calls-interval-cases-branch
                   (list indexed cap not-growing) interval source prove))
         (longer (t3-book-indexed-calls-interval-cases-branch
                  (list indexed cap growing) interval source prove))
         (current (proof-proof-cases proof span-test longer shorter))
         (not-cap (proof-proof-assume proof cap-test nil))
         (stopped (t3-book-indexed-calls-interval-cases-branch
                   (list indexed not-cap) interval source prove))
         (current (proof-proof-cases proof cap-test current stopped))
         (not-indexed (proof-proof-assume proof index-test nil))
         (unindexed (t3-book-indexed-calls-interval-cases-branch
                     (list not-indexed) interval source prove)))
      (proof-proof-cases proof index-test current unindexed))))

(defun t3-book-indexed-calls-indexed-type (lib name formula)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((actual (proof-term-at formula 2))
         (beta (proof-proof-beta proof actual))
         (goal (t3-book-term-collections-step-term-at beta 2))
         (call (proof-term-at goal 1))
         (interval (t3-book-indexed-calls-interval-init lib call))
         (kind (proof-term-at formula 0))
         (premise (proof-term-at formula 1))
         (normalized (list kind premise goal))
         (accepted (proof-proof-assume proof premise t))
         (branches (t3-book-indexed-calls-interval-cases interval (list :type normalized accepted)))
         (case-step (t3-book-lemmas-implication lib normalized branches))
         (inducted (t3-book-indexed-calls-interval-induct interval case-step normalized))
         (consequent (proof-proof-modus-ponens proof inducted accepted))
         (actual (proof-proof-transport proof consequent beta))
         (proved (t3-book-lemmas-implication lib formula actual)))
      (proof-proof-entry "theorem" name (list name) (list proved)))))

(defun t3-book-indexed-calls-indexed-length (lib name formula)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((beta (proof-proof-beta proof formula))
         (goal (t3-book-term-collections-step-term-at beta 2))
         (parts (proof-list-of-length (cdr goal) 2))
         (width (car parts))
         (span (cadr parts))
         (call (proof-term-at width 1))
         (interval (t3-book-indexed-calls-interval-init lib call))
         (case-step (t3-book-indexed-calls-interval-cases interval (list :length width span goal)))
         (inducted (t3-book-indexed-calls-interval-induct interval case-step goal))
         (proved (proof-proof-transport proof inducted beta)))
      (proof-proof-entry "theorem" name (list name) (list proved)))))

(defun t3-book-indexed-calls-full-length (lib name formula)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((beta (proof-proof-beta proof formula))
         (goal (t3-book-term-collections-step-term-at beta 2))
         (parts (proof-list-of-length (cdr goal) 2))
         (width (car parts))
         (expected (cadr parts))
         (call (proof-term-at width 1))
         (call (t3-book-spines-shallow lib call nil))
         (result (proof-proof-fact proof *t3-book-indexed-calls-length-aux*
                                   (list (list *t3-book-indexed-calls-i* *proof-zero*))))
         (literal (proof-step-first result))
         (opened (proof-proof-beta proof literal))
         (result (proof-proof-rewrite proof result opened '(1)))
         (body (t3-book-term-collections-step-term-at result 2))
         (normalized (t3-logic-libraryproofs-normalize lib body nil (list *library-natp* *proof-not*)))
         (result (proof-proof-chain proof result (list normalized)))
         (typed (t3-logic-libraryproofs-type-of lib expected nil))
         (identity (library-library-cite lib "ADD-ZERO-RIGHT" (list expected) (list typed)))
         (result (t3-book-spines-replace-value lib result (list identity)))
         (natural (t3-logic-libraryproofs-natural lib expected))
         (fixed (t3-book-indexed-calls-fix-value lib expected natural))
         (result (proof-proof-chain proof result (list fixed)))
         (call-back (proof-proof-symmetric proof call))
         (result (proof-proof-rewrite proof result call-back '(1 1 1)))
         (proved (proof-proof-transport proof result beta)))
      (proof-proof-entry "theorem" name (list name) (list proved)))))
