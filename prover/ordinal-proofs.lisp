(in-package "BOYMOO-PROVER")
(set-verify-guards-eagerness 0)

(defun ordinal-proofs-ordinal-zero-lemmas (lib)
  (let* ((proof (library-library-proof lib))
         (finite (list *library-o-finp* *library-x*))
         (ordered (list *proof-ordinal-less* *proof-not*))
         (lower (list *proof-ordinal-less* *library-x* *proof-zero*)))
    (if (assoc-equal (proof-sym "SELF-NONZERO-ORDINAL-POSITIVE" "ACL2")
                     (proof-proof-facts proof))
        lib
      (proof-with-checked-results
       ((fin (proof-proof-assume proof finite t))
        (nonfinite (proof-proof-assume proof finite nil))
        (zero-fin (proof-proof-prove proof (list *library-o-finp* *proof-zero*) nil
                                     (list *library-o-finp* (proof-cl "ATOM") *proof-not*)))
        (ordinal (proof-proof-assume proof (list *proof-ordinalp* *library-x*) t))
        (opened (proof-proof-unfold proof (proof-step-first ordinal)))
        (ordinal-body (proof-proof-rewrite proof ordinal opened '(1)))
        (natural (proof-proof-prove-if proof ordinal-body fin))
        (bound (library-library-cite lib "NATURAL-NONNEGATIVE" (list *library-x*)
                                     (list natural)))
        (numeric (proof-proof-simplify proof lower (list fin zero-fin) ordered))
        (infinite-order (proof-proof-simplify proof lower (list nonfinite zero-fin) ordered))
        (yes (library-library-transport-argument lib bound numeric 1))
        (not-nil (proof-proof-not-nil proof))
        (no (library-library-transport-argument lib not-nil infinite-order 1))
        (joined (proof-proof-cases proof finite yes no))
        (lib (library-library-lemma lib "ORDINAL-AT-LEAST-ZERO" (proof-neg lower) joined
                                    (list (proof-neg (proof-step-first ordinal)))))
        (integrality (library-library-cite lib "NATURAL-INTEGER" (list *library-x*)
                                           (list natural))))
       (let* ((proof (library-library-proof lib))
              (zero (proof-eq *library-x* *proof-zero*))
              (greater (list *proof-ordinal-less* *proof-zero* *library-x*)))
         (proof-with-checked-results
          ((nonzero (proof-proof-assume proof zero nil))
           (positive (lemmas-positive-nonzero-integer lib *library-x* integrality nonzero bound)))
          (let* ((lib (cdr positive))
                 (proof (library-library-proof lib)))
            (proof-with-checked-results
             ((numeric (proof-proof-simplify proof greater (list zero-fin fin) ordered))
              (yes (proof-proof-transport proof (car positive) numeric))
              (no (proof-proof-prove proof greater (list zero-fin nonfinite) ordered))
              (joined (proof-proof-cases proof finite yes no)))
             (library-library-lemma lib "NONZERO-ORDINAL-POSITIVE" greater joined
                                    (list (proof-neg (proof-step-first ordinal)) zero))))))))))

(defun ordinal-proofs-positive-ordinal (lib comparison left-ord right-ord)
  (proof-with-checked-results
   ((lib (ordinal-proofs-ordinal-zero-lemmas lib))
    (literal (proof-step-first comparison))
    (literal (proof-list-of-length literal 3)))
   (let* ((proof (library-library-proof lib))
          (left (cadr literal))
          (right (caddr literal))
          (zero (proof-eq right *proof-zero*)))
     (proof-with-checked-results
      ((zero-assumption (proof-proof-assume proof zero t))
       (below-zero (proof-proof-rewrite proof comparison zero-assumption '(1 2)))
       (contradiction (library-library-cite lib "ORDINAL-AT-LEAST-ZERO" (list left)
                                            (list left-ord)))
       (cut (proof-proof-cut proof below-zero contradiction))
       (nonzero (proof-proof-front proof cut (proof-neg zero)))
       (step (library-library-cite lib "NONZERO-ORDINAL-POSITIVE" (list right)
                                  (list right-ord nonzero))))
      (cons step lib)))))
