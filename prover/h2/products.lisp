(in-package "BOYMOO-PROVER")
(set-verify-guards-eagerness 0)

(defmacro h2-products-with-results (bindings result)
  (if (endp bindings)
      result
    (let ((binding (car bindings))
          (name (caar bindings)))
      `(let (,binding)
         (if (h2-search-stopped-p ,name)
             ,name
           (h2-products-with-results ,(cdr bindings) ,result))))))

(defun h2-products-first-at (step index)
  (proof-with-checked-results ((literal (proof-step-first step)))
    (proof-term-at literal index)))

(defun h2-products-numerical-zero-product (proof)
  (let* ((library (h2-search-search-library proof))
         (core (library-library-proof library))
         (name "SELF-H2-ZERO-PRODUCT"))
    (if (assoc-equal (proof-sym name "ACL2") (proof-proof-facts core))
        (cons name proof)
      (let* ((value (h2-division-product *library-x* *proof-zero*))
             (negative (library-minus value))
             (expression (library-plus negative value))
             (sums (h2-calculation-number-sums-init library)))
        (proof-with-checked-results
            ((distributed (library-library-axiom
                           library "DISTRIBUTIVITY"
                           (list *library-x* *proof-zero* *proof-zero*)))
             (sum-zero (proof-proof-compute
                        core (library-plus *proof-zero* *proof-zero*) 0))
             (distributed (proof-proof-rewrite core distributed sum-zero '(1 1 2)))
             (reflexive (proof-proof-reflexive core expression))
             (expanded (proof-proof-rewrite core reflexive distributed '(1 2 2)))
             (commute (library-library-axiom
                       library "COMMUTATIVITY-OF-+" (list negative value)))
             (inverse (library-library-axiom library "INVERSE-OF-+" (list value)))
             (zero (proof-proof-chain core commute (list inverse)))
             (expanded-value (h2-products-first-at expanded 2))
             (contracted (h2-calculation-number-sums-linear-equal
                          sums expanded-value value nil))
             (from-zero (proof-proof-symmetric core zero))
             (equation (proof-proof-chain core from-zero (list expanded contracted)))
             (result (proof-proof-symmetric core equation))
             (claim (proof-step-first result))
             (library (library-library-lemma library "H2-ZERO-PRODUCT" claim result nil)))
          (cons name (h2-search-search-with-library proof library)))))))

(defun h2-products-product-of-negative (proof factor value)
  (let* ((library (h2-search-search-library proof))
         (core (library-library-proof library))
         (name "SELF-H2-PRODUCT-OF-NEGATIVE"))
    (proof-with-checked-results
        ((proof
          (if (assoc-equal (proof-sym name "ACL2") (proof-proof-facts core))
              proof
            (let* ((minus-y (library-minus *library-y*))
                   (positive (h2-division-product *library-x* *library-y*))
                   (negative (h2-division-product *library-x* minus-y)))
              (proof-with-checked-results
                  ((distributed (library-library-axiom
                                 library "DISTRIBUTIVITY" (list *library-x* *library-y* minus-y)))
                   (inverse (library-library-axiom library "INVERSE-OF-+" (list *library-y*)))
                   (distributed (proof-proof-rewrite core distributed inverse '(1 1 2)))
                   (undistributed (proof-proof-symmetric core distributed))
                   (zero-law (h2-products-numerical-zero-product proof))
                   (zero-name (car zero-law))
                   (proof (cdr zero-law))
                   (library (h2-search-search-library proof))
                   (core (library-library-proof library))
                   (zero-axiom (library-library-axiom library zero-name (list *library-x*)))
                   (equal-zero (proof-proof-chain core undistributed (list zero-axiom)))
                   (opposite (library-minus positive))
                   (added (library-plus opposite (library-plus positive negative)))
                   (sums (h2-calculation-number-sums-init library))
                   (identity (h2-calculation-number-sums-linear-equal sums added negative nil))
                   (identity (proof-proof-symmetric core identity))
                   (identity (proof-proof-rewrite core identity equal-zero '(1 2 2)))
                   (typed (h2-calculation-number-sums-type-of sums opposite nil))
                   (zero (h2-calculation-number-sums-cite
                          sums "ADD-ZERO-RIGHT" (list opposite) (list typed)))
                   (result (proof-proof-chain core identity (list zero)))
                   (claim (proof-step-first result))
                   (library (library-library-lemma
                             library "H2-PRODUCT-OF-NEGATIVE" claim result nil)))
                (h2-search-search-with-library proof library)))))
         (step (library-library-axiom (h2-search-search-library proof) name (list factor value))))
      (cons step proof))))

(defun h2-products-inverse-product (proof value typed nonzero)
  (let* ((library (h2-search-search-library proof))
         (core (library-library-proof library))
         (positive (proof-eq value *proof-zero*))
         (negative (proof-neg positive)))
    (proof-with-checked-results
        ((literal (proof-step-first nonzero))
         (nonzero
          (if (equal literal negative)
              nonzero
            (proof-with-checked-results
                ((assumed (proof-proof-assume core positive t))
                 (reversed (proof-proof-symmetric core assumed))
                 (cut (proof-proof-cut core reversed nonzero)))
              (proof-proof-front core cut negative))))
         (inverse (library-library-axiom library "INVERSE-OF-*" (list value)))
         (condition (h2-products-first-at inverse 1))
         (evidence (proof-proof-prove core condition (list typed nonzero) nil)))
      (proof-proof-modus-ponens core inverse evidence))))

(defun h2-products-collapse-unit (proof unit remaining)
  (let* ((library (h2-search-search-library proof))
         (core (library-library-proof library)))
    (proof-with-checked-results
        ((product-term (h2-products-first-at unit 1))
         (factors (proof-list-of-length (cdr product-term) 2))
         (association (library-library-axiom
                       library "ASSOCIATIVITY-OF-*" (append factors (list remaining))))
         (equation (proof-proof-symmetric core association))
         (equation (proof-proof-rewrite core equation unit '(1 2 1)))
         (identity (library-library-axiom library "UNICITY-OF-1" (list remaining))))
      (proof-proof-chain core equation (list identity)))))

(defun h2-products-recover-factor (proof factor remaining typed nonzero)
  (let* ((library (h2-search-search-library proof))
         (core (library-library-proof library))
         (reciprocal (list *h2-calculation-reciprocal* factor)))
    (proof-with-checked-results
        ((equation (library-library-axiom
                    library "ASSOCIATIVITY-OF-*" (list factor remaining reciprocal)))
         (swapped (library-library-axiom library "COMMUTATIVITY-OF-*" (list remaining reciprocal)))
         (equation (proof-proof-rewrite core equation swapped '(1 2 2)))
         (unit (h2-products-inverse-product proof factor typed nonzero))
         (collapse (h2-products-collapse-unit proof unit remaining)))
      (proof-proof-chain core equation (list collapse)))))

(defun h2-products-cancel-left-factor (proof same-product typed nonzero)
  (let* ((library (h2-search-search-library proof))
         (core (library-library-proof library)))
    (proof-with-checked-results
        ((literal (proof-step-first same-product))
         (products (proof-list-of-length (cdr literal) 2))
         (first (car products))
         (second (cadr products))
         (factor (proof-term-at first 1))
         (inverted (list *h2-calculation-reciprocal* factor))
         (commute (library-library-axiom library "COMMUTATIVITY-OF-*" (list inverted factor)))
         (inverse (h2-products-inverse-product proof factor typed nonzero))
         (unit (proof-proof-chain core commute (list inverse)))
         (multiplied (h2-division-product inverted first))
         (reflexive (proof-proof-reflexive core multiplied))
         (aligned (proof-proof-rewrite core reflexive same-product '(1 2 2)))
         (first-remaining (proof-term-at first 2))
         (left (h2-products-collapse-unit proof unit first-remaining))
         (left (proof-proof-symmetric core left))
         (second-remaining (proof-term-at second 2))
         (right (h2-products-collapse-unit proof unit second-remaining)))
      (proof-proof-chain core left (list aligned right)))))

(defun h2-products-zero-factor-visit (n proof value position evidence)
  (declare (xargs :measure (nfix n)))
  (if (not (o< (nfix (1- n)) (nfix n)))
      '(:failure "Fuel" "h2-products-zero-factor-visit")
    (let* ((library (h2-search-search-library proof))
           (core (library-library-proof library)))
      (proof-with-checked-results
          ((factor (proof-term-at value position))
           (known (proof-step-first evidence)))
        (if (equal known (proof-eq factor *proof-zero*))
            (proof-with-checked-results
                ((reflexive (proof-proof-reflexive core value))
                 (replaced (proof-proof-rewrite core reflexive evidence (list 1 2 position)))
                 (replaced
                  (if (equal position 1)
                      (proof-with-checked-results
                          ((rewritten (h2-products-first-at replaced 2))
                           (commute (library-library-axiom library "COMMUTATIVITY-OF-*" (cdr rewritten))))
                        (proof-proof-chain core replaced (list commute)))
                    replaced))
                 (zero-law (h2-products-numerical-zero-product proof))
                 (zero-name (car zero-law))
                 (proof (cdr zero-law))
                 (other (proof-term-at value (- 3 position)))
                 (library (h2-search-search-library proof))
                 (zero (library-library-axiom library zero-name (list other)))
                 (step (proof-proof-chain (library-library-proof library) replaced (list zero))))
              (cons step proof))
          (proof-with-checked-results
              ((completion (library-library-axiom library "COMPLETION-OF-*" (cdr value))))
            (if (equal position 1)
                (proof-with-checked-results
                    ((step (h2-book-logic-select-body proof completion evidence)))
                  (cons step proof))
              (proof-with-checked-results
                  ((swapped (library-library-axiom library "COMMUTATIVITY-OF-*" (cdr value)))
                   (swapped-value (h2-products-first-at swapped 2))
                   (result (h2-products-zero-factor-visit (1- n) proof swapped-value 1 evidence))
                   (zero (car result))
                   (proof (cdr result))
                   (core (library-library-proof (h2-search-search-library proof)))
                   (step (proof-proof-chain core swapped (list zero))))
                (cons step proof)))))))))

(defun h2-products-zero-factor (proof value position evidence)
  (h2-products-zero-factor-visit 1000000 proof value position evidence))

(defun h2-products-zero-factors-excluded (proof unit position)
  (let ((core (library-library-proof (h2-search-search-library proof))))
    (proof-with-checked-results
        ((product-term (h2-products-first-at unit 1))
         (factor (proof-term-at product-term position))
         (equality (proof-eq factor *proof-zero*))
         (assumed (proof-proof-assume core equality t))
         (result (h2-products-zero-factor proof product-term position assumed))
         (collapse (car result))
         (proof (cdr result))
         (core (library-library-proof (h2-search-search-library proof)))
         (conflict (proof-proof-rewrite core unit collapse '(1 1)))
         (false (proof-proof-compute core (proof-eq *proof-zero* *proof-one*) *proof-nil*))
         (conflict (proof-proof-rewrite core conflict false '(1)))
         (conflict (proof-proof-tidy core conflict))
         (step (proof-proof-front core conflict (proof-neg equality))))
      (cons step proof))))

(defun h2-products-inverse-unique (proof unit factor-type proposed-type)
  (proof-with-checked-results
      ((product-term (h2-products-first-at unit 1))
       (factors (proof-list-of-length (cdr product-term) 2))
       (factor (car factors))
       (proposed (cadr factors))
       (result (h2-products-zero-factors-excluded proof unit 1))
       (nonzero (car result))
       (proof (cdr result))
       (library (h2-search-search-library proof))
       (core (library-library-proof library))
       (inverse (h2-products-inverse-product proof factor factor-type nonzero))
       (reverse-unit (proof-proof-symmetric core unit))
       (same (proof-proof-chain core inverse (list reverse-unit)))
       (equality (h2-products-cancel-left-factor proof same factor-type nonzero))
       (reciprocal (list *h2-calculation-reciprocal* factor))
       (sums (h2-calculation-number-sums-init library))
       (typed (h2-calculation-number-sums-type-of sums reciprocal nil))
       (left (library-library-cite library "H2-NUMBER-FIX" (list reciprocal) (list typed)))
       (right (library-library-cite library "H2-NUMBER-FIX" (list proposed) (list proposed-type)))
       (left (proof-proof-symmetric core left))
       (step (proof-proof-chain core left (list equality right))))
    (cons step proof)))

(defun h2-products-divide-product (proof formula)
  (let* ((library (h2-search-search-library proof))
         (core (library-library-proof library)))
    (proof-with-checked-results
        ((parts (proof-list-of-length (cdr formula) 2))
         (premise (car parts))
         (goal (cadr parts))
         (assumed (proof-proof-assume core premise t))
         (conditions (proof-proof-conjunct core assumed))
         (value (proof-term-at goal 1))
         (factor (proof-term-at value 1))
         (fixed (proof-term-at goal 2))
         (remaining (proof-term-at fixed 1))
         (unit (h2-products-inverse-product proof factor (car conditions) (cadr conditions)))
         (reduced (h2-products-collapse-unit proof unit remaining))
         (left (h2-products-first-at reduced 1))
         (reduced
          (if (equal left value)
              reduced
            (proof-with-checked-results
                ((inner (proof-term-at value 2))
                 (commute (library-library-axiom library "COMMUTATIVITY-OF-*" (cdr inner)))
                 (reflexive (proof-proof-reflexive core value))
                 (converted (proof-proof-rewrite core reflexive commute '(1 2 2))))
              (proof-proof-chain core converted (list reduced))))))
      (h2-search-search-introduce proof formula reduced))))

(defun h2-products-fix-second-factor (proof factor value)
  (let* ((library (h2-search-search-library proof))
         (core (library-library-proof library))
         (product-term (h2-division-product factor value))
         (fixed (list *h2-calculation-fix* value))
         (test (list *h2-calculation-numberp* value)))
    (proof-with-checked-results
        ((typed (proof-proof-assume core test t))
         (untyped (proof-proof-assume core test nil))
         (same (library-library-cite library "H2-NUMBER-FIX" (list value) (list typed)))
         (identity (proof-proof-reflexive core product-term))
         (swapped (proof-proof-symmetric core same))
         (yes (proof-proof-rewrite core identity swapped '(1 2 2)))
         (result (h2-products-zero-factor proof product-term 2 untyped))
         (zero (car result))
         (proof (cdr result))
         (core (library-library-proof (h2-search-search-library proof)))
         (opening (proof-proof-unfold core fixed))
         (empty (h2-book-logic-select-body proof opening untyped))
         (result (h2-products-zero-factor proof (h2-division-product factor fixed) 2 empty))
         (clipped (car result))
         (proof (cdr result))
         (core (library-library-proof (h2-search-search-library proof)))
         (clipped (proof-proof-symmetric core clipped))
         (no (proof-proof-chain core zero (list clipped)))
         (step (proof-proof-cases core test yes no)))
      (cons step proof))))

(defun h2-products-set-rules (proof)
  (h2-book-logic-set-rules proof "" nil "" 80))

(defun h2-products-reciprocal-zero (proof term known)
  (let ((library (h2-search-search-library proof)))
    (h2-products-with-results
        ((completion (library-library-axiom library "COMPLETION-OF-UNARY-/" (list term)))
         (body (h2-products-first-at completion 2))
         (condition (proof-term-at body 1))
         (proof (h2-products-set-rules proof))
         (result (h2-search-search-call-with-remainder proof :solve (list (proof-neg condition) known nil)))
         (absent (car result))
         (proof (cdr result))
         (step (h2-book-logic-select-body proof completion absent)))
      (cons step proof))))

(defun h2-products-inverse-involution-zero-case (known target proof value formula)
  (h2-products-with-results
      ((result (h2-products-reciprocal-zero proof value known))
       (absent (car result))
       (proof (cdr result))
       (core (library-library-proof (h2-search-search-library proof)))
       (left (proof-term-at formula 1))
       (reflexive (proof-proof-reflexive core left))
       (reduced (proof-proof-rewrite core reflexive absent '(1 2 1)))
       (zero (proof-proof-compute core (list *h2-calculation-reciprocal* *proof-zero*) 0))
       (reduced (proof-proof-chain core reduced (list zero)))
       (reversed (proof-proof-symmetric core target))
       (step (proof-proof-chain core reduced (list reversed))))
    (cons step proof)))

(defun h2-products-inverse-involution (proof formula)
  (let* ((library (h2-search-search-library proof))
         (core (library-library-proof library)))
    (h2-products-with-results
        ((right (proof-term-at formula 2))
         (value (proof-term-at right 1))
         (number (list *h2-calculation-numberp* value))
         (zero (proof-eq value *proof-zero*))
         (typed (proof-proof-assume core number t))
         (nonnumber (proof-proof-assume core number nil))
         (is-zero (proof-proof-assume core zero t))
         (not-zero (proof-proof-assume core zero nil))
         (reciprocal (list *h2-calculation-reciprocal* value))
         (fix (proof-proof-unfold core (list *h2-calculation-fix* value)))
         (numeric-fix (library-library-cite library "H2-NUMBER-FIX" (list value) (list typed)))
         (target (proof-proof-chain core numeric-fix (list is-zero)))
         (result (h2-products-inverse-involution-zero-case (list typed is-zero) target proof value formula))
         (zero-value (car result))
         (proof (cdr result))
         (target (h2-book-logic-select-body proof fix nonnumber))
         (result (h2-products-inverse-involution-zero-case (list nonnumber) target proof value formula))
         (nonnumeric (car result))
         (proof (cdr result))
         (library (h2-search-search-library proof))
         (core (library-library-proof library))
         (original (h2-products-inverse-product proof value typed not-zero))
         (commute (library-library-axiom library "COMMUTATIVITY-OF-*" (list reciprocal value)))
         (swapped (proof-proof-chain core commute (list original)))
         (sums (h2-calculation-number-sums-init library))
         (reciprocal-type (h2-calculation-number-sums-type-of sums reciprocal nil))
         (result (h2-products-inverse-unique proof swapped reciprocal-type typed))
         (twice (car result))
         (proof (cdr result))
         (core (library-library-proof (h2-search-search-library proof)))
         (reverse-fix (proof-proof-symmetric core numeric-fix))
         (nonzero-value (proof-proof-chain core twice (list reverse-fix)))
         (numeric (proof-proof-cases core zero zero-value nonzero-value))
         (step (proof-proof-cases core number numeric nonnumeric)))
      (cons step proof))))

(defun h2-products-inverse-distributed-missing (position sign evidence proof combined left right)
  (h2-products-with-results
      ((arg (proof-term-at combined position))
       (result (h2-products-zero-factor proof combined position sign))
       (product-zero (car result))
       (proof (cdr result))
       (core (library-library-proof (h2-search-search-library proof)))
       (identity (proof-proof-reflexive core left))
       (reduced (proof-proof-rewrite core identity product-zero '(1 2 1)))
       (computed (proof-proof-compute core (list *h2-calculation-reciprocal* *proof-zero*) 0))
       (reduced (proof-proof-chain core reduced (list computed)))
       (result (h2-products-reciprocal-zero proof arg evidence))
       (empty (car result))
       (proof (cdr result))
       (result (h2-products-zero-factor proof right position empty))
       (other-zero (car result))
       (proof (cdr result))
       (core (library-library-proof (h2-search-search-library proof)))
       (other-zero (proof-proof-symmetric core other-zero))
       (step (proof-proof-chain core reduced (list other-zero))))
    (cons step proof)))

(defun h2-products-context-add-steps (context proof steps)
  (declare (xargs :measure (acl2-count steps)))
  (if (endp steps)
      context
    (h2-products-with-results
        ((result (h2-search-context-add context proof (car steps))))
      (h2-products-context-add-steps (cdr result) proof (cdr steps)))))

(defun h2-products-product-form (n proof term context replies)
  (declare (xargs :measure (nfix n)))
  (if (not (o< (nfix (1- n)) (nfix n)))
      '(:failure "Fuel" "h2-products-product-form")
    (h2-products-with-results
        ((result (h2-calculation-product-form-with-replies proof term context replies)))
      (if (not (h2-calculation-request-p result))
          result
        (let ((proof-at-call (h2-calculation-request-proof result))
              (context-at-call (h2-calculation-request-context result))
              (args (h2-calculation-request-arguments result))
              (operation (h2-calculation-request-operation result)))
          (h2-products-with-results
              ((answer (h2-search-search-call-with-remainder
                        proof-at-call operation
                        (if (eq operation :deduce)
                            (list (car args) context-at-call (cadr args))
                          (list (car args) context-at-call))))
               (search (cdr answer))
               (step (if (eq operation :deduce) (caar answer) (car answer)))
               (context-at-call (if (eq operation :deduce) (cdar answer) context-at-call))
               (reply (cons step (cons search context-at-call))))
            (h2-products-product-form (1- n) proof term context (append replies (list reply)))))))))

(defun h2-products-inverse-distributed (proof formula)
  (let* ((library (h2-search-search-library proof))
         (core (library-library-proof library)))
    (h2-products-with-results
        ((left (proof-term-at formula 1))
         (combined (proof-term-at left 1))
         (factors (proof-list-of-length (cdr combined) 2))
         (parts (proof-list-of-length (cdr formula) 2))
         (right (cadr parts))
         (number1 (list *h2-calculation-numberp* (car factors)))
         (number2 (list *h2-calculation-numberp* (cadr factors)))
         (zero1 (proof-eq (car factors) *proof-zero*))
         (zero2 (proof-eq (cadr factors) *proof-zero*))
         (typed1 (proof-proof-assume core number1 t))
         (typed2 (proof-proof-assume core number2 t))
         (not-zero1 (proof-proof-assume core zero1 nil))
         (not-zero2 (proof-proof-assume core zero2 nil))
         (proof (h2-products-set-rules proof))
         (context (h2-products-context-add-steps
                   (h2-search-context-init) proof (list typed1 typed2 not-zero1 not-zero2)))
         (result (h2-products-product-form 1000000 proof (h2-division-product combined right) context nil))
         (unit (car result))
         (proof (cadr result))
         (right-side (h2-products-first-at unit 2)))
      (if (not (equal right-side *proof-one*))
          '(:failure "Unproved" "")
        (h2-products-with-results
            ((library (h2-search-search-library proof))
             (core (library-library-proof library))
             (sums (h2-calculation-number-sums-init library))
             (combined-type (h2-calculation-number-sums-type-of sums combined nil))
             (right-type (h2-calculation-number-sums-type-of sums right nil))
             (result (h2-products-inverse-unique proof unit combined-type right-type))
             (nonzero (car result))
             (proof (cdr result))
             (core (library-library-proof (h2-search-search-library proof)))
             (sign (proof-proof-assume core zero2 t))
             (zero2-assumption (proof-proof-assume core zero2 t))
             (result (h2-products-inverse-distributed-missing
                      2 sign (list typed2 zero2-assumption) proof combined left right))
             (right-zero (car result))
             (proof (cdr result))
             (core (library-library-proof (h2-search-search-library proof)))
             (right-nonnumeric (proof-proof-assume core number2 nil))
             (result (h2-products-inverse-distributed-missing
                      2 right-nonnumeric (list right-nonnumeric) proof combined left right))
             (right-no (car result))
             (proof (cdr result))
             (core (library-library-proof (h2-search-search-library proof)))
             (right-number (proof-proof-cases core zero2 right-zero nonzero))
             (right-cases (proof-proof-cases core number2 right-number right-no))
             (sign (proof-proof-assume core zero1 t))
             (zero1-assumption (proof-proof-assume core zero1 t))
             (result (h2-products-inverse-distributed-missing
                      1 sign (list typed1 zero1-assumption) proof combined left right))
             (left-zero (car result))
             (proof (cdr result))
             (core (library-library-proof (h2-search-search-library proof)))
             (left-nonnumeric (proof-proof-assume core number1 nil))
             (result (h2-products-inverse-distributed-missing
                      1 left-nonnumeric (list left-nonnumeric) proof combined left right))
             (left-no (car result))
             (proof (cdr result))
             (core (library-library-proof (h2-search-search-library proof)))
             (left-number (proof-proof-cases core zero1 left-zero right-cases))
             (step (proof-proof-cases core number1 left-number left-no)))
          (cons step proof))))))

(defun h2-products-cancel-comparison-vanished
    (sign fixed-zero proof first position against-zero second comparison fixed-position cases zero-test)
  (h2-products-with-results
      ((result (h2-products-zero-factor proof first position sign))
       (raw (car result))
       (proof (cdr result))
       (core (library-library-proof (h2-search-search-library proof)))
       (result (if against-zero
                   (h2-products-with-results ((other (proof-proof-reflexive core *proof-zero*)))
                     (cons other proof))
                 (h2-products-zero-factor proof second position sign)))
       (other (car result))
       (proof (cdr result))
       (core (library-library-proof (h2-search-search-library proof)))
       (other (proof-proof-symmetric core other))
       (equality (proof-proof-chain core raw (list other)))
       (left (h2-ordering-equality-value proof comparison equality))
       (test (if (equal fixed-position 2) (proof-proof-symmetric core fixed-zero) fixed-zero))
       (selection (proof-proof-select core cases test))
       (test-value (h2-ordering-equality-value proof zero-test test))
       (right (proof-proof-chain core selection (list test-value)))
       (right (proof-proof-symmetric core right))
       (step (proof-proof-chain core left (list right))))
    (cons step proof)))

(defun h2-products-cancel-comparison-zero-view (proof factor)
  (h2-products-with-results
      ((law (h2-products-numerical-zero-product proof))
       (name (car law))
       (proof (cdr law))
       (library (h2-search-search-library proof))
       (equation (library-library-axiom library name (list factor)))
       (step (proof-proof-symmetric (library-library-proof library) equation)))
    (cons step proof)))

(defun h2-products-cancel-comparison-zero-test (library forward backward)
  (let* ((core (library-library-proof library))
         (sums (h2-calculation-number-sums-init library)))
    (h2-products-with-results
        ((typed (h2-calculation-number-sums-type-of sums *proof-zero* nil))
         (zero-fixed (library-library-cite library "H2-NUMBER-FIX" (list *proof-zero*) (list typed)))
         (forward (proof-proof-rewrite core forward zero-fixed '(1 2)))
         (reversed (proof-proof-symmetric core zero-fixed))
         (backward (proof-proof-rewrite core backward reversed '(1 2))))
      (list forward backward))))

(defun h2-products-cancel-comparison (proof formula position against-zero)
  (let* ((library (h2-search-search-library proof))
         (core (library-library-proof library)))
    (h2-products-with-results
        ((parts (proof-list-of-length (cdr formula) 2))
         (comparison (car parts))
         (cases (cadr parts))
         (compared (proof-list-of-length (cdr comparison) 2))
         (first (car compared))
         (second (cadr compared))
         (factor (proof-term-at first position))
         (branches (proof-list-of-length (cdr cases) 3))
         (zero-test (car branches))
         (remaining (caddr branches))
         (number (list *h2-calculation-numberp* factor))
         (zero (proof-eq factor *proof-zero*))
         (typed (proof-proof-assume core number t))
         (nonnumeric (proof-proof-assume core number nil))
         (is-zero (proof-proof-assume core zero t))
         (nonzero (proof-proof-assume core zero nil))
         (fixed-value (library-library-cite library "H2-NUMBER-FIX" (list factor) (list typed)))
         (zero-test-left (proof-term-at zero-test 1))
         (fixed-position (if (equal zero-test-left *proof-zero*) 2 1))
         (target (proof-proof-chain core fixed-value (list is-zero)))
         (result (h2-products-cancel-comparison-vanished
                  is-zero target proof first position against-zero second comparison fixed-position cases zero-test))
         (yes (car result))
         (proof (cdr result))
         (core (library-library-proof (h2-search-search-library proof)))
         (opening (proof-proof-unfold core (list *h2-calculation-fix* factor)))
         (target (h2-book-logic-select-body proof opening nonnumeric))
         (result (h2-products-cancel-comparison-vanished
                  nonnumeric target proof first position against-zero second comparison fixed-position cases zero-test))
         (no-number (car result))
         (proof (cdr result))
         (library (h2-search-search-library proof))
         (core (library-library-proof library))
         (left-view (if (equal position 1)
                        (proof-proof-reflexive core first)
                      (library-library-axiom library "COMMUTATIVITY-OF-*" (cdr first))))
         (result
          (if against-zero
              (h2-products-cancel-comparison-zero-view proof factor)
            (h2-products-with-results
                ((right-view (if (equal position 1)
                                 (proof-proof-reflexive core second)
                               (library-library-axiom library "COMMUTATIVITY-OF-*" (cdr second)))))
              (cons right-view proof))))
         (right-view (car result))
         (proof (cdr result))
         (library (h2-search-search-library proof))
         (core (library-library-proof library))
         (left-reversed (proof-proof-symmetric core left-view))
         (compared (proof-proof-assume core comparison t))
         (same (proof-proof-chain core left-reversed (list compared right-view)))
         (forward (h2-products-cancel-left-factor proof same typed nonzero))
         (backward-test (proof-proof-assume core remaining t))
         (tests (if against-zero
                    (h2-products-cancel-comparison-zero-test library forward backward-test)
                  (list forward backward-test)))
         (left-product (h2-products-first-at left-view 2))
         (left-value (proof-term-at left-product 2))
         (result (h2-products-fix-second-factor proof factor left-value))
         (fixed-left (car result))
         (proof (cdr result))
         (right-product (h2-products-first-at right-view 2))
         (right-value (proof-term-at right-product 2))
         (result (h2-products-fix-second-factor proof factor right-value))
         (fixed-right (car result))
         (proof (cdr result))
         (core (library-library-proof (h2-search-search-library proof)))
         (fixed-left (proof-proof-rewrite core fixed-left (cadr tests) '(1 2 2)))
         (fixed-right (proof-proof-symmetric core fixed-right))
         (right-reversed (proof-proof-symmetric core right-view))
         (backward (proof-proof-chain core left-view (list fixed-left fixed-right right-reversed)))
         (equal-step (h2-ordering-equal-tests proof comparison remaining (car tests) backward))
         (test (proof-proof-assume core zero-test t))
         (test (proof-proof-rewrite core test fixed-value (list 1 fixed-position)))
         (test (if (equal fixed-position 2) (proof-proof-symmetric core test) test))
         (denied (proof-proof-cut core test nonzero))
         (denied (proof-proof-front core denied (proof-neg zero-test)))
         (selected (proof-proof-select core cases denied))
         (selected (proof-proof-symmetric core selected))
         (active (proof-proof-chain core equal-step (list selected)))
         (number-cases (proof-proof-cases core zero yes active))
         (step (proof-proof-cases core number number-cases no-number)))
      (cons step proof))))

(defun h2-products-product-theorem (proof label formula)
  (cond ((equal label "FUNCTIONAL-SELF-INVERSION-OF-/")
         (h2-products-inverse-involution proof formula))
        ((equal label "DISTRIBUTIVITY-OF-/-OVER-*")
         (h2-products-inverse-distributed proof formula))
        ((member-equal label '("/-CANCELLATION-ON-LEFT" "/-CANCELLATION-ON-RIGHT"))
         (h2-products-with-results ((step (h2-products-divide-product proof formula)))
           (cons step proof)))
        ((equal label "LEFT-CANCELLATION-FOR-*")
         (h2-products-cancel-comparison proof formula 1 nil))
        ((equal label "RIGHT-CANCELLATION-FOR-*")
         (h2-products-cancel-comparison proof formula 2 nil))
        ((equal label "ZERO-IS-ONLY-ZERO-DIVISOR")
         (h2-products-cancel-comparison proof formula 1 t))
        (t (cons nil proof))))
