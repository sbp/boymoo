(in-package "BOYMOO-PROVER")

(set-verify-guards-eagerness 0)

(defconst *h2-binomial-choose* (proof-sym "CHOOSE" "ACL2"))
(defconst *h2-binomial-choose-mk* (proof-sym "CHOOSE-MK" "ACL2"))
(defconst *h2-binomial-factorial* (proof-sym "FACTORIAL" "ACL2"))
(defconst *h2-binomial-sum* (proof-sym "SUMLIST" "ACL2"))
(defconst *h2-binomial-n-expt* (proof-sym "N-EXPT" "ACL2"))
(defconst *h2-binomial-zip* (proof-sym "ZIP" "ACL2"))
(defconst *h2-binomial-zp* (proof-sym "ZP" "ACL2"))
(defconst *h2-binomial-k* (proof-sym "K" "ACL2"))
(defconst *h2-binomial-n* (proof-sym "N" "ACL2"))
(defconst *h2-binomial-expt* (proof-cl "EXPT"))
(defconst *h2-binomial-r* (proof-sym "R" "ACL2"))

(defmacro h2-binomial-with-results (bindings result)
  (if (endp bindings)
      result
    (let ((binding (car bindings))
          (name (caar bindings)))
      `(let (,binding)
         (if (h2-search-stopped-p ,name)
             ,name
           (h2-binomial-with-results ,(cdr bindings) ,result))))))

(defun h2-binomial-term-at (term path)
  (declare (xargs :measure (acl2-count path)))
  (if (endp path)
      term
    (proof-with-checked-results ((argument (proof-term-at term (car path))))
      (h2-binomial-term-at argument (cdr path)))))

(defun h2-binomial-step-at (step path)
  (proof-with-checked-results ((literal (proof-step-first step)))
    (h2-binomial-term-at literal path)))

(defun h2-binomial-tail (term)
  (if (integerp term)
      '(:failure "failure" "")
    (cdr term)))

(defun h2-binomial-pair-arguments (term)
  (proof-with-checked-results ((arguments (h2-binomial-tail term)))
    (proof-list-of-length arguments 2)))

(defun h2-binomial-derive (proof formula definitions facts seeds repeat)
  (h2-binomial-with-results
      ((result (h2-book-logic-derive proof formula definitions facts nil 1 repeat seeds nil 80))
       (step (car result)))
    (cons step (cdr result))))

(defun h2-binomial-factorial-evidence (proof term)
  (let ((base (library-library-proof (h2-search-search-library proof))))
    (proof-with-checked-results
        ((index (proof-term-at term 1))
         (fact (proof-proof-fact base (proof-sym "FACTORIAL-POSITIVE-INTEGER" "ACL2")
                                (list (list *h2-binomial-n* index)))))
      (proof-proof-conjunct base fact))))

(defun h2-binomial-factorial-step (proof term typed strict)
  (h2-binomial-with-results
      ((index (proof-term-at term 1))
       (running (h2-binomial-derive proof (proof-neg (list *h2-binomial-zp* index))
                                    "ZP" nil (list typed strict) ""))
       (proof (cdr running))
       (base (library-library-proof (h2-search-search-library proof)))
       (opening (proof-proof-unfold base term))
       (step (h2-book-logic-select-body proof opening (car running))))
    (cons step proof)))

(defun h2-binomial-natural-predecessor (proof position typed strict)
  (h2-binomial-with-results
      ((running (h2-binomial-derive proof (proof-neg (list *h2-binomial-zp* position))
                                    "ZP" nil (list typed strict) ""))
       (proof (cdr running))
       (library (h2-search-search-library proof))
       (step (library-plus *proof-neg-one* position))
       (integer-step (library-library-type-of library step (list typed)))
       (bound (library-library-cite library "H2-PREDECESSOR-NONNEGATIVE" (list position)
                                     (list (car running)))))
    (cons (list integer-step bound) proof)))

(defun h2-binomial-choose-view (proof call fields)
  (let ((base (library-library-proof (h2-search-search-library proof))))
    (proof-with-checked-results
        ((opening (proof-proof-unfold base call))
         (test (h2-binomial-step-at opening '(2 1)))
         (evidence (proof-proof-prove base test fields nil)))
      (h2-book-logic-select-body proof opening evidence))))

(defun h2-binomial-indexed-difference (proof strict facts)
  (let* ((library (h2-search-search-library proof))
         (base (library-library-proof library)))
    (proof-with-checked-results
        ((literal (proof-step-first strict))
         (terms (h2-binomial-pair-arguments literal))
         (comparison (library-library-comparison library (car terms) (cadr terms) facts)))
      (proof-proof-rewrite base strict comparison '(1)))))

(defun h2-binomial-factor-width (factors width)
  (if (endp factors)
      width
    (if (integerp (car factors))
        '(:failure "failure" "")
      (let ((length (len (car factors))))
        (h2-binomial-factor-width (cdr factors) (if width (min width length) length))))))

(defun h2-binomial-factor-column (factors index)
  (if (endp factors)
      nil
    (cons (nth index (car factors))
          (h2-binomial-factor-column (cdr factors) index))))

(defun h2-binomial-positive-product (proof value factors)
  (let ((library (h2-search-search-library proof)))
    (proof-with-checked-results
        ((terms (h2-binomial-pair-arguments value))
         (width (if (integerp factors)
                    '(:failure "failure" "")
                  (h2-binomial-factor-width factors nil))))
      (if (equal width 2)
          (let ((typed (h2-binomial-factor-column factors 0))
                (positions (h2-binomial-factor-column factors 1)))
            (proof-with-checked-results
                ((left (library-library-rational library (car terms) typed))
                 (right (library-library-rational library (cadr terms) typed)))
              (library-library-cite library "POSITIVE-PRODUCT" terms
                                    (list* left right positions))))
        (proof-length-failure 2 (nfix width))))))

(defun h2-binomial-scale-ratio-factor (library equation factorization divisor ratio)
  (let ((base (library-library-proof library)))
    (proof-with-checked-results
        ((equation (proof-proof-rewrite base equation factorization '(1 2 1)))
         (factor (h2-binomial-step-at factorization '(2 1)))
         (value (h2-binomial-step-at ratio '(2)))
         (associate (library-library-axiom library "ASSOCIATIVITY-OF-*" (list factor divisor value))))
      (proof-proof-chain base equation (list associate)))))

(defun h2-binomial-scale-ratio
    (proof denominator ratio rest-type divisor-type positive-divisor factorization)
  (let* ((library (h2-search-search-library proof))
         (base (library-library-proof library)))
    (proof-with-checked-results
        ((value (h2-binomial-step-at ratio '(2)))
         (terms (h2-binomial-pair-arguments value))
         (numerator (car terms))
         (inverse (cadr terms))
         (divisor (proof-term-at inverse 1))
         (left (h2-binomial-step-at ratio '(1)))
         (scaled (h2-division-product denominator left))
         (reflexive (proof-proof-reflexive base scaled))
         (equation (proof-proof-rewrite base reflexive ratio '(1 2 2)))
         (equation (if factorization
                       (h2-binomial-scale-ratio-factor library equation factorization divisor ratio)
                     equation))
         (place (if factorization '(1 2 2) '(1 2)))
         (grouping (library-library-axiom library "ASSOCIATIVITY-OF-*" (list divisor numerator inverse)))
         (grouping (proof-proof-symmetric base grouping))
         (equation (proof-proof-rewrite base equation grouping place))
         (zero-type (library-library-type-of library *proof-zero* nil))
         (nonzero (library-library-cite library "H2-LESS-IMPLIES-UNEQUAL" (list *proof-zero* divisor)
                                        (list zero-type positive-divisor)))
         (divisor-number (library-library-number library divisor (list divisor-type)))
         (cancellation (h2-products-recover-factor proof divisor numerator divisor-number nonzero))
         (numerator-number (library-library-number library numerator (list rest-type)))
         (fixed (library-library-cite library "H2-NUMBER-FIX" (list numerator) (list numerator-number)))
         (equality (proof-proof-chain base cancellation (list fixed)))
         (step (proof-proof-rewrite base equation equality place)))
      (proof-proof-tidy base step))))

(defun h2-binomial-factorial-pairs (proof terms)
  (if (endp terms)
      nil
    (proof-with-checked-results
        ((first (h2-binomial-factorial-evidence proof (car terms)))
         (rest (h2-binomial-factorial-pairs proof (cdr terms))))
      (cons first rest))))

(defun h2-binomial-choose-reduction-scaled (ratio numerator-type factorization proof denominator)
  (let ((library (h2-search-search-library proof)))
    (proof-with-checked-results
        ((divisor (h2-binomial-step-at ratio '(2 2 1)))
         (terms (h2-binomial-tail divisor))
         (facts (h2-binomial-factorial-pairs proof terms))
         (divisor-type (library-library-type-of library divisor (strip-cars facts)))
         (strict (h2-binomial-positive-product proof divisor facts)))
      (h2-binomial-scale-ratio proof denominator ratio numerator-type divisor-type
                              strict factorization))))

(defun h2-binomial-choose-reduction-source-types (library sums views)
  (if (endp views)
      nil
    (proof-with-checked-results
        ((right (h2-binomial-step-at (car views) '(2)))
         (typed (h2-calculation-number-sums-type-of sums right nil))
         (first (library-library-transport-argument library typed (car views) 1))
         (rest (h2-binomial-choose-reduction-source-types library sums (cdr views))))
      (cons first rest))))

(defun h2-binomial-choose-reduction-finish
    (proof formula goal left first second first-factorization second-factorization
     k n delta types f-prev fk fdelta denominator n-type pos-n)
  (h2-binomial-with-results
      ((numerator-type (h2-binomial-factorial-evidence proof f-prev))
       (numerator (h2-binomial-step-at left '(2 1)))
       (left-type (h2-binomial-factorial-evidence proof numerator))
       (scaled-left (h2-binomial-choose-reduction-scaled left (car left-type) nil proof denominator))
       (step (h2-binomial-factorial-step proof numerator n-type pos-n))
       (proof (cdr step))
       (library (h2-search-search-library proof))
       (base (library-library-proof library))
       (scaled-left (proof-proof-chain base scaled-left (list (car step))))
       (goal-right (proof-term-at goal 2))
       (terms (h2-binomial-tail goal-right))
       (distributed (library-library-axiom library "DISTRIBUTIVITY" (cons denominator terms)))
       (scaled-first (h2-binomial-choose-reduction-scaled first (car numerator-type)
                                                         first-factorization proof denominator))
       (distributed (proof-proof-rewrite base distributed scaled-first '(1 2 1)))
       (scaled-second (h2-binomial-choose-reduction-scaled second (car numerator-type)
                                                          second-factorization proof denominator))
       (distributed (proof-proof-rewrite base distributed scaled-second '(1 2 2)))
       (commute (library-library-axiom library "COMMUTATIVITY-OF-*" (list k f-prev)))
       (distributed (proof-proof-rewrite base distributed commute '(1 2 1)))
       (commute (library-library-axiom library "COMMUTATIVITY-OF-*" (list delta f-prev)))
       (distributed (proof-proof-rewrite base distributed commute '(1 2 2)))
       (distributivity (library-library-axiom library "DISTRIBUTIVITY" (list f-prev k delta)))
       (distributivity (proof-proof-symmetric base distributivity))
       (factored (proof-proof-chain base distributed (list distributivity)))
       (linear (library-library-linear-equal library (library-plus k delta) n types))
       (factored (proof-proof-rewrite base factored linear '(1 2 2)))
       (commute (library-library-axiom library "COMMUTATIVITY-OF-*" (list f-prev n)))
       (factored (proof-proof-chain base factored (list commute)))
       (reversed (proof-proof-symmetric base factored))
       (equality (proof-proof-chain base scaled-left (list reversed)))
       (f-types (h2-binomial-factorial-pairs proof (list fk fdelta)))
       (d-type (library-library-number library denominator (strip-cars f-types)))
       (positive-d (h2-binomial-positive-product proof denominator f-types))
       (zero-type (library-library-type-of library *proof-zero* nil))
       (nonzero (library-library-cite library "H2-LESS-IMPLIES-UNEQUAL" (list *proof-zero* denominator)
                                      (list zero-type positive-d)))
       (recovered (h2-products-cancel-left-factor proof equality d-type nonzero))
       (sums (h2-calculation-number-sums-init library))
       (left-term (h2-binomial-step-at left '(1)))
       (left-value (h2-binomial-step-at left '(2)))
       (left-type (h2-calculation-number-sums-type-of sums left-value nil))
       (left-type (library-library-transport-argument library left-type left 1))
       (left-fix (library-library-cite library "H2-NUMBER-FIX" (list left-term) (list left-type)))
       (source-types (h2-binomial-choose-reduction-source-types library sums (list first second)))
       (right-type (h2-calculation-number-sums-type-of sums goal-right source-types))
       (right-fix (library-library-cite library "H2-NUMBER-FIX" (list goal-right) (list right-type)))
       (left-fix (proof-proof-symmetric base left-fix))
       (step (proof-proof-chain base left-fix (list recovered right-fix)))
       (step (h2-search-search-introduce proof formula step)))
    (cons step proof)))

(defun h2-binomial-choose-reduction-denominators
    (proof formula goal left first second k n delta types k-type n-type delta-type positive-k pos-delta pos-n)
  (h2-binomial-with-results
      ((product (h2-binomial-step-at left '(2 2 1)))
       (factors (h2-binomial-pair-arguments product))
       (fk (car factors))
       (fdelta (cadr factors))
       (denominator (h2-division-product fk fdelta))
       (f-prev (h2-binomial-step-at first '(2 1)))
       (first-den (h2-binomial-step-at first '(2 2 1)))
       (base (library-library-proof (h2-search-search-library proof)))
       (reflexive (proof-proof-reflexive base denominator))
       (opened (h2-binomial-factorial-step proof fk k-type positive-k))
       (proof (cdr opened))
       (library (h2-search-search-library proof))
       (base (library-library-proof library))
       (first-factorization (proof-proof-rewrite base reflexive (car opened) '(1 2 1)))
       (first-factor (proof-term-at first-den 1))
       (associate (library-library-axiom library "ASSOCIATIVITY-OF-*" (list k first-factor fdelta)))
       (first-factorization (proof-proof-chain base first-factorization (list associate)))
       (second-den (h2-binomial-step-at second '(2 2 1)))
       (reflexive (proof-proof-reflexive base denominator))
       (opened (h2-binomial-factorial-step proof fdelta delta-type pos-delta))
       (proof (cdr opened))
       (library (h2-search-search-library proof))
       (base (library-library-proof library))
       (second-factorization (proof-proof-rewrite base reflexive (car opened) '(1 2 2)))
       (second-factor (proof-term-at second-den 2))
       (middle (library-library-axiom library "ASSOCIATIVITY-OF-*" (list fk delta second-factor)))
       (middle (proof-proof-symmetric base middle))
       (commute (library-library-axiom library "COMMUTATIVITY-OF-*" (list fk delta)))
       (middle (proof-proof-rewrite base middle commute '(1 2 1)))
       (args (h2-binomial-tail second-den))
       (associate (library-library-axiom library "ASSOCIATIVITY-OF-*" (cons delta args)))
       (second-factorization (proof-proof-chain base second-factorization (list middle associate))))
    (h2-binomial-choose-reduction-finish proof formula goal left first second first-factorization second-factorization
                                        k n delta types f-prev fk fdelta denominator n-type pos-n)))

(defun h2-binomial-choose-reduction (proof formula)
  (let* ((library (h2-search-search-library proof))
         (base (library-library-proof library)))
    (h2-binomial-with-results
        ((parts (h2-binomial-pair-arguments formula))
         (premise (car parts))
         (goal (cadr parts))
         (assumed (proof-proof-assume base premise t))
         (fields (h2-ranges-conjuncts proof assumed))
         (fields (proof-list-of-length fields 4))
         (k-type (car fields))
         (n-type (cadr fields))
         (positive-k (caddr fields))
         (inside (cadddr fields))
         (k (h2-binomial-step-at k-type '(1)))
         (n (h2-binomial-step-at n-type '(1)))
         (delta (library-diff n k))
         (types (list k-type n-type))
         (delta-type (library-library-type-of library delta types))
         (pos-delta (h2-binomial-indexed-difference proof inside types))
         (zero-type (library-library-type-of library *proof-zero* nil))
         (pos-n (library-library-cite library "LESS-TRANSITIVE" (list *proof-zero* k n)
                                      (list zero-type k-type n-type positive-k inside)))
         (k-bound (library-library-cite library "POSITIVE-NONNEGATIVE" (list k) (list k-type positive-k)))
         (upper (library-library-cite library "H2-INTEGER-ASYMMETRY" (list k n) (list k-type n-type inside)))
         (left-call (proof-term-at goal 1))
         (left (h2-binomial-choose-view proof left-call (list k-type n-type k-bound upper)))
         (predecessor (h2-binomial-natural-predecessor proof k k-type positive-k))
         (low (caar predecessor))
         (low-bound (cadar predecessor))
         (proof (cdr predecessor))
         (library (h2-search-search-library proof))
         (base (library-library-proof library))
         (high (library-library-type-of library (library-plus *proof-neg-one* n) types))
         (k-prev (h2-binomial-step-at low '(1)))
         (n-prev (h2-binomial-step-at high '(1)))
         (order (library-library-axiom library "<-ON-OTHERS" (list n k)))
         (gap (proof-proof-rewrite base upper order '(1 1)))
         (lowers (library-library-weak-from-difference library k-prev n-prev gap types))
         (recover-n (library-library-linear-equal library (library-plus *proof-one* n-prev) n types))
         (recover-n (proof-proof-symmetric base recover-n))
         (near (proof-proof-rewrite base inside recover-n '(1 2)))
         (unchanged-low (library-library-cite library "H2-INTEGER-SUCCESSOR-BOUND" (list k n-prev)
                                               (list k-type high near)))
         (first-call (h2-binomial-term-at goal '(2 1)))
         (first (h2-binomial-choose-view proof first-call (list low high low-bound lowers)))
         (second-call (h2-binomial-term-at goal '(2 2)))
         (second (h2-binomial-choose-view proof second-call (list k-type high k-bound unchanged-low)))
         (shift (library-library-linear-equal library (library-diff n-prev k-prev) delta types))
         (first (proof-proof-rewrite base first shift '(1 2 2 1 2 1)))
         (shift (library-library-linear-equal library (library-diff n-prev k)
                                             (library-plus *proof-neg-one* delta) types))
         (second (proof-proof-rewrite base second shift '(1 2 2 1 2 1))))
      (h2-binomial-choose-reduction-denominators
       proof formula goal left first second k n delta types k-type n-type delta-type positive-k pos-delta pos-n))))

(defun h2-binomial-choose-edge-build (proof at-zero name label)
  (let* ((library (h2-search-search-library proof))
         (base (library-library-proof library))
         (n *h2-binomial-n*)
         (value (list *h2-binomial-choose* (if at-zero *proof-zero* n) n))
         (valid (proof-ite (library-integer n) (library-nonnegative n) *proof-false*))
         (target (proof-ite valid *proof-one* *proof-zero*))
         (formula (proof-eq value target)))
    (h2-binomial-with-results
        ((opening (proof-proof-unfold base value))
         (guard (h2-binomial-step-at opening '(2 1)))
         (yes (proof-proof-assume base valid t))
         (no (proof-proof-assume base valid nil))
         (pair (proof-proof-conjunct base yes))
         (typed-n (car pair))
         (bounds (cadr pair))
         (reflexive-type (if at-zero (library-library-type-of library *proof-zero* nil) typed-n))
         (reflexive (library-library-cite library "WEAK-REFLEXIVE" (list (if at-zero *proof-zero* n))
                                          (list reflexive-type)))
         (zero-type (library-library-type-of library *proof-zero* nil))
         (good-guard (h2-binomial-derive proof guard "" nil (list typed-n bounds reflexive zero-type) ""))
         (proof (cdr good-guard))
         (base (library-library-proof (h2-search-search-library proof)))
         (ratio (h2-book-logic-select-body proof opening (car good-guard)))
         (assumed (proof-proof-assume base guard t))
         (fields (h2-ranges-conjuncts proof assumed))
         (contradicts-invalid (proof-proof-prove base valid fields nil))
         (conflict (proof-proof-cut base contradicts-invalid no))
         (bad-guard (proof-proof-front base conflict (proof-neg guard)))
         (term (list *h2-binomial-factorial* n))
         (zero-factorial (h2-binomial-derive proof (proof-eq (list *h2-binomial-factorial* *proof-zero*) *proof-one*)
                                             "FACTORIAL ZP" nil nil ""))
         (proof (cdr zero-factorial))
         (library (h2-search-search-library proof))
         (base (library-library-proof library))
         (index (h2-binomial-step-at ratio '(2 2 1 2 1)))
         (identity (library-library-linear-equal library index (if at-zero n *proof-zero*) (list typed-n)))
         (ratio (proof-proof-rewrite base ratio identity '(1 2 2 1 2 1)))
         (position (if at-zero 1 2))
         (ratio (proof-proof-rewrite base ratio (car zero-factorial) (list 1 2 2 1 position)))
         (denominator (h2-binomial-step-at ratio '(2 2 1)))
         (unit (library-library-axiom library "UNICITY-OF-1" (list term)))
         (unit (if at-zero
                   unit
                 (proof-with-checked-results
                     ((terms (h2-binomial-tail denominator))
                      (commute (library-library-axiom library "COMMUTATIVITY-OF-*" terms)))
                   (proof-proof-chain base commute (list unit)))))
         (evidence (h2-binomial-factorial-evidence proof term))
         (typed (car evidence))
         (strict (cadr evidence))
         (number (library-library-number library term (list typed)))
         (fixed (library-library-cite library "H2-NUMBER-FIX" (list term) (list number)))
         (unit (proof-proof-chain base unit (list fixed)))
         (ratio (proof-proof-rewrite base ratio unit '(1 2 2 1)))
         (zero-type (library-library-type-of library *proof-zero* nil))
         (nonzero (library-library-cite library "H2-LESS-IMPLIES-UNEQUAL" (list *proof-zero* term)
                                        (list zero-type strict)))
         (number (library-library-number library term (list typed)))
         (inverse (h2-products-inverse-product proof term number nonzero))
         (one (proof-proof-chain base ratio (list inverse)))
         (yes-target (proof-proof-select base target yes))
         (yes-target (proof-proof-symmetric base yes-target))
         (good (proof-proof-chain base one (list yes-target)))
         (bad (h2-book-logic-select-body proof opening bad-guard))
         (no-target (proof-proof-select base target no))
         (no-target (proof-proof-symmetric base no-target))
         (bad (proof-proof-chain base bad (list no-target)))
         (step (proof-proof-cases base valid good bad))
         (library (library-library-lemma library (concatenate 'string "H2-" name) formula step nil)))
      (cons label (h2-search-search-with-library proof library)))))

(defun h2-binomial-choose-edge (proof at-zero)
  (let* ((name (if at-zero "CHOOSE-AT-ZERO" "CHOOSE-AT-DIAGONAL"))
         (label (proof-sym (concatenate 'string "SELF-H2-" name) "ACL2"))
         (base (library-library-proof (h2-search-search-library proof))))
    (if (assoc-equal label (proof-proof-facts base))
        (cons label proof)
      (h2-binomial-choose-edge-build proof at-zero name label))))

(defun h2-binomial-choose-from-boundary (proof k n fields not-interior legal)
  (let* ((library (h2-search-search-library proof))
         (base (library-library-proof library)))
    (h2-binomial-with-results
        ((fields (proof-list-of-length fields 2))
         (k-type (car fields))
         (n-type (cadr fields))
         (bounds (proof-proof-conjunct base legal))
         (lower (car bounds))
         (upper (cadr bounds))
         (want (list *h2-binomial-choose* k n))
         (less (library-positive k))
         (strictly-positive (proof-proof-assume base less t))
         (weak (proof-proof-assume base less nil))
         (int-zero (library-library-type-of library *proof-zero* nil))
         (zero (library-library-cite library "H2-INTEGER-EQUAL-WHEN-NEITHER-LESS" (list k *proof-zero*)
                                     (list k-type int-zero lower weak)))
         (edge (h2-binomial-choose-edge proof t))
         (proof (cdr edge))
         (base (library-library-proof (h2-search-search-library proof)))
         (row (proof-proof-fact base (car edge) (list (list *h2-binomial-n* n))))
         (n-lower (proof-proof-rewrite base upper zero '(1 1 2)))
         (guard (h2-binomial-step-at row '(2 1)))
         (domain (proof-proof-prove base guard (list n-type n-lower) nil))
         (row (h2-book-logic-select-body proof row domain))
         (reflexive (proof-proof-reflexive base want))
         (zero-view (proof-proof-rewrite base reflexive zero '(1 2 1)))
         (zero-answer (proof-proof-chain base zero-view (list row)))
         (allowed (h2-binomial-derive proof (proof-neg (library-lt k n)) "" nil
                                      (list not-interior strictly-positive) ""))
         (proof (cdr allowed))
         (library (h2-search-search-library proof))
         (match (library-library-cite library "H2-INTEGER-EQUAL-WHEN-NEITHER-LESS" (list n k)
                                      (list n-type k-type upper (car allowed))))
         (edge (h2-binomial-choose-edge proof nil))
         (proof (cdr edge))
         (base (library-library-proof (h2-search-search-library proof)))
         (diagonal (proof-proof-fact base (car edge) (list (list *h2-binomial-n* k))))
         (guard (h2-binomial-step-at diagonal '(2 1)))
         (domain (proof-proof-prove base guard (list k-type lower) nil))
         (diagonal (h2-book-logic-select-body proof diagonal domain))
         (reflexive (proof-proof-reflexive base want))
         (diagonal-view (proof-proof-rewrite base reflexive match '(1 2 2)))
         (end-answer (proof-proof-chain base diagonal-view (list diagonal)))
         (step (proof-proof-cases base less end-answer zero-answer)))
      (cons step proof))))

(defun h2-binomial-assume-tests (base conditions)
  (if (endp conditions)
      nil
    (proof-with-checked-results
        ((condition (proof-list-of-length (car conditions) 2))
         (step (proof-proof-assume base (car condition) (cadr condition)))
         (rest (h2-binomial-assume-tests base (cdr conditions))))
      (cons step rest))))

(defun h2-binomial-changed-bindings (old new)
  (if (or (endp old) (endp new))
      nil
    (if (equal (car old) (car new))
        (h2-binomial-changed-bindings (cdr old) (cdr new))
      (cons (list (car old) (car new))
            (h2-binomial-changed-bindings (cdr old) (cdr new))))))

(defun h2-binomial-choose-iteration-cases (base children old formula descent updates)
  (declare (xargs :measure (acl2-count children)))
  (if (endp children)
      (list nil updates)
    (proof-with-checked-results
        ((actuals (h2-binomial-tail (car children)))
         (bindings (h2-binomial-changed-bindings old actuals))
         (updates (append updates (list bindings)))
         (descent-test (proof-step-first descent))
         (smaller (proof-subst formula (proof-bindings-table bindings nil)))
         (hypothesis (proof-proof-assume base (proof-ite descent-test smaller *proof-true*) t))
         (step (proof-proof-prove-if base hypothesis descent))
         (rest (h2-binomial-choose-iteration-cases base (cdr children) old formula descent updates)))
      (list (cons step (car rest)) (cadr rest)))))

(defun h2-binomial-choose-iteration-expand (base expanded cases index)
  (declare (xargs :measure (acl2-count cases)))
  (if (endp cases)
      expanded
    (proof-with-checked-results
        ((expanded (proof-proof-rewrite base expanded (car cases) (list 1 2 index))))
      (h2-binomial-choose-iteration-expand base expanded (cdr cases) (1+ index)))))

(defun h2-binomial-choose-iteration-base (value evidence proof classify formula k n)
  (let* ((library (h2-search-search-library proof))
         (base (library-library-proof library)))
    (if classify
        (proof-with-checked-results ((step (library-library-natural library value)))
          (cons step proof))
      (h2-binomial-with-results
          ((want (proof-term-at formula 2))
           (candidate (proof-proof-unfold base want))
           (result
            (if (equal value *proof-zero*)
                (h2-binomial-with-results
                    ((guard (h2-binomial-step-at candidate '(2 1)))
                     (invalid (h2-binomial-derive proof (proof-neg guard) "" nil evidence ""))
                     (proof (cdr invalid))
                     (step (h2-book-logic-select-body proof candidate (car invalid))))
                  (cons step proof))
              (h2-binomial-with-results
                  ((first (proof-term-at evidence 0))
                   (fields (proof-proof-conjunct base first))
                   (not-interior (proof-term-at evidence 1))
                   (legal (proof-term-at evidence 2)))
                (h2-binomial-choose-from-boundary proof k n fields not-interior legal))))
           (proof (cdr result))
           (base (library-library-proof (h2-search-search-library proof)))
           (step (proof-proof-symmetric base (car result))))
        (cons step proof)))))

(defun h2-binomial-choose-iteration-inductive (value evidence proof classify formula k n updates)
  (let* ((library (h2-search-search-library proof))
         (base (library-library-proof library)))
    (h2-binomial-with-results
        ((first (proof-term-at evidence 0))
         (types (proof-proof-conjunct base first))
         (k-type (car types))
         (n-type (cadr types))
         (second (proof-term-at evidence 1))
         (strict (proof-proof-conjunct base second))
         (positive-k (car strict))
         (within (cadr strict))
         (zero-type (library-library-type-of library *proof-zero* nil))
         (positive-n (library-library-cite library "LESS-TRANSITIVE" (list *proof-zero* k n)
                                           (list zero-type k-type n-type positive-k within)))
         (running (h2-binomial-derive proof (proof-neg (list *h2-binomial-zp* n)) "ZP" nil
                                      (list n-type positive-n) ""))
         (proof (cdr running))
         (library (h2-search-search-library proof))
         (base (library-library-proof library))
         (builtin (library-library-builtin library 9 n))
         (descent (proof-proof-discharge base builtin (car running)))
         (children (h2-binomial-tail value))
         (cases (h2-binomial-choose-iteration-cases base children (list k n) formula descent updates))
         (updates (cadr cases))
         (cases (car cases))
         (step
          (if classify
              (library-library-cite library "NATURAL-SUM" children cases)
            (proof-with-checked-results
                ((expanded (proof-proof-reflexive base value))
                 (expanded (h2-binomial-choose-iteration-expand base expanded cases 1))
                 (reduction (proof-proof-fact base (proof-sym "CHOOSE-REDUCTION" "ACL2")
                                              (list (list *h2-binomial-k* k) (list *h2-binomial-n* n))))
                 (guard (h2-binomial-step-at reduction '(1)))
                 (guard (proof-proof-prove base guard (list k-type n-type positive-k within) nil))
                 (equation (proof-proof-modus-ponens base reduction guard))
                 (reversed (proof-proof-symmetric base equation)))
              (proof-proof-chain base expanded (list reversed))))))
      (cons (list step updates) proof))))

(defun h2-binomial-choose-iteration-leaf (value conditions proof classify formula k n updates)
  (let ((base (library-library-proof (h2-search-search-library proof))))
    (h2-binomial-with-results ((evidence (h2-binomial-assume-tests base conditions)))
      (if (or (equal value *proof-zero*) (equal value *proof-one*))
          (h2-binomial-with-results
              ((result (h2-binomial-choose-iteration-base value evidence proof classify formula k n)))
            (cons (list (car result) updates) (cdr result)))
        (h2-binomial-choose-iteration-inductive value evidence proof classify formula k n updates)))))

(defun h2-binomial-choose-iteration-by-value
    (fuel value conditions proof classify formula k n updates template)
  (declare (xargs :measure (nfix fuel)))
  (cond
   ((zp fuel) '(:failure "Fuel" "h2-binomial-choose-iteration-by-value"))
   ((proof-is-call value *proof-if*)
    (h2-binomial-with-results
        ((branches (proof-list-of-length (cdr value) 3))
         (test (car branches))
         (yes (h2-binomial-choose-iteration-by-value
               (1- fuel) (cadr branches) (append conditions (list (list test t)))
               proof classify formula k n updates template))
         (no (h2-binomial-choose-iteration-by-value
              (1- fuel) (caddr branches) (append conditions (list (list test nil)))
              (cdr yes) classify formula k n (cadar yes) template))
         (proof (cdr no))
         (base (library-library-proof (h2-search-search-library proof)))
         (step (proof-by-value-join base value template (caar yes) (caar no))))
      (cons (list step (cadar no)) proof)))
   ((and (proof-compound value) (endp value))
    '(:failure "failure" ""))
   ((and (proof-compound value) (proof-compound (car value)))
    (h2-binomial-with-results
        ((base (library-library-proof (h2-search-search-library proof)))
         (equality (proof-proof-beta base value))
         (opened (h2-binomial-step-at equality '(2)))
         (result (h2-binomial-choose-iteration-by-value
                  (1- fuel) opened conditions proof classify formula k n updates template))
         (proof (cdr result))
         (base (library-library-proof (h2-search-search-library proof)))
         (reversed (proof-proof-symmetric base equality))
         (step (proof-proof-rewrite-result base (caar result) reversed template *proof-result*)))
      (cons (list step (cadar result)) proof)))
   (t
    (h2-binomial-with-results
        ((result (h2-binomial-choose-iteration-leaf value conditions proof classify formula k n updates))
         (literal (proof-step-first (caar result)))
         (target (proof-subst template (list (cons *proof-result* value)))))
      (if (equal literal target)
          result
        '(:failure "failure" ""))))))

(defun h2-binomial-choose-iteration (proof formula classify)
  (let ((base (library-library-proof (h2-search-search-library proof))))
    (h2-binomial-with-results
        ((call (proof-term-at formula 1))
         (indices (h2-binomial-pair-arguments call))
         (k (car indices))
         (n (cadr indices))
         (template (if classify
                       (list *library-natp* *proof-result*)
                     (proof-with-checked-results ((right (proof-term-at formula 2)))
                       (proof-eq *proof-result* right))))
         (opening (proof-proof-unfold base call))
         (value (h2-binomial-step-at opening '(2)))
         (body (h2-binomial-choose-iteration-by-value 1000000 value nil proof classify formula k n nil template))
         (proof (cdr body))
         (library (h2-search-search-library proof))
         (base (library-library-proof library))
         (reversed (proof-proof-symmetric base opening))
         (case-step (proof-proof-rewrite-result base (caar body) reversed template *proof-result*))
         (ordinal (library-library-builtin library 1 n))
         (step (proof-proof-induct base ordinal case-step formula (list *library-count* n) (cadar body))))
      (cons step proof))))

(defun h2-binomial-choose-natural (proof formula)
  (h2-binomial-with-results
      ((term (h2-binomial-term-at formula '(1 1)))
       (indices (h2-binomial-pair-arguments term))
       (k (car indices))
       (n (cadr indices))
       (call (list *h2-binomial-choose-mk* k n))
       (natural (h2-binomial-choose-iteration proof (list *library-natp* call) t))
       (proof (cdr natural))
       (base (library-library-proof (h2-search-search-library proof)))
       (equality (proof-proof-fact base (proof-sym "CHOOSE-MK-CHOOSE" "ACL2")
                                  (list (list *h2-binomial-k* k) (list *h2-binomial-n* n))))
       (typed (proof-proof-rewrite base (car natural) equality '(1 1)))
       (literal (proof-step-first typed))
       (opening (proof-proof-unfold base literal))
       (step (proof-proof-rewrite base typed opening '(1)))
       (step (proof-proof-tidy base step)))
    (cons step proof)))

(defun h2-binomial-positive-expt-build (proof name)
  (let* ((library (h2-search-search-library proof))
         (base (library-library-proof library))
         (n *h2-binomial-n*)
         (r *h2-binomial-r*)
         (guard (proof-ite (library-integer n) (library-positive n) *proof-false*)))
    (h2-binomial-with-results
        ((assumed (proof-proof-assume base guard t))
         (evidence (proof-proof-conjunct base assumed))
         (n-type (car evidence))
         (strict (cadr evidence))
         (zero-type (library-library-type-of library *proof-zero* nil))
         (nonzero (library-library-cite library "H2-LESS-IMPLIES-UNEQUAL" (list *proof-zero* n)
                                        (list zero-type strict)))
         (test (list *h2-binomial-zip* n))
         (active (h2-binomial-derive proof (proof-neg test) "ZIP =" nil (list n-type nonzero) ""))
         (proof (cdr active))
         (library (h2-search-search-library proof))
         (base (library-library-proof library))
         (call (list *h2-binomial-expt* r n))
         (opening (proof-proof-unfold base call))
         (opened (h2-book-logic-select-body proof opening (car active)))
         (zero-test (h2-binomial-step-at opened '(2 1)))
         (zero-base (proof-proof-assume base zero-test t))
         (zero (h2-book-logic-select-body proof opened zero-base))
         (remains (proof-proof-assume base zero-test nil))
         (normal (h2-book-logic-select-body proof opened remains))
         (normal (h2-book-logic-select-body proof normal strict))
         (unroll (h2-division-product r (list *h2-binomial-expt* r (library-plus *proof-neg-one* n))))
         (shift (library-library-axiom library "COMMUTATIVITY-OF-+" (list n *proof-neg-one*)))
         (normal (proof-proof-rewrite base normal shift '(1 2 2 2)))
         (typed (list *h2-calculation-numberp* r))
         (numeric (proof-proof-assume base typed t))
         (nonnumeric (proof-proof-assume base typed nil))
         (equation (h2-book-logic-logical-equation proof zero-test))
         (fixed-zero (proof-proof-rewrite base zero-base equation '(1)))
         (fixed (library-library-cite library "H2-NUMBER-FIX" (list r) (list numeric)))
         (base-is-zero (proof-proof-rewrite base fixed-zero fixed '(1 1)))
         (zero-factor (h2-products-zero-factor proof unroll 1 base-is-zero))
         (nonnumeric-factor (h2-products-zero-factor (cdr zero-factor) unroll 1 nonnumeric))
         (proof (cdr nonnumeric-factor))
         (library (h2-search-search-library proof))
         (base (library-library-proof library))
         (vanish (proof-proof-cases base typed (car zero-factor) (car nonnumeric-factor)))
         (vanish (proof-proof-symmetric base vanish))
         (special (proof-proof-chain base zero (list vanish)))
         (formula (list *library-implies* guard (proof-eq call unroll)))
         (case-step (proof-proof-cases base zero-test special normal))
         (step (h2-search-search-introduce proof formula case-step))
         (library (library-library-lemma library "H2-EXPT-POSITIVE-STEP" formula step nil)))
      (cons name (h2-search-search-with-library proof library)))))

(defun h2-binomial-positive-expt (proof)
  (let ((name (proof-sym "SELF-H2-EXPT-POSITIVE-STEP" "ACL2"))
        (base (library-library-proof (h2-search-search-library proof))))
    (if (assoc-equal name (proof-proof-facts base))
        (cons name proof)
      (h2-binomial-positive-expt-build proof name))))

(defun h2-binomial-unfold-positive-expt (proof base power natural-type strict)
  (h2-binomial-with-results
      ((result (h2-binomial-positive-expt proof))
       (proof (cdr result))
       (core (library-library-proof (h2-search-search-library proof)))
       (rule (proof-proof-fact core (car result)
                              (list (list *h2-binomial-r* base) (list *h2-binomial-n* power))))
       (guard (h2-binomial-step-at rule '(1)))
       (evidence (proof-proof-prove core guard (list natural-type strict) nil))
       (step (proof-proof-modus-ponens core rule evidence)))
    (cons step proof)))

(defun h2-binomial-natural-countdown (proof formula n natural-type strict)
  (h2-binomial-with-results
      ((running (h2-binomial-derive proof (proof-neg (list *h2-binomial-zp* n))
                                    "ZP" nil (list natural-type strict) ""))
       (proof (cdr running))
       (library (h2-search-search-library proof))
       (base (library-library-proof library))
       (builtin (library-library-builtin library 9 n))
       (descent (proof-proof-discharge base builtin (car running)))
       (predecessor (library-plus *proof-neg-one* n))
       (update (list (list n predecessor)))
       (test (proof-step-first descent))
       (smaller (proof-subst formula (list (cons n predecessor))))
       (hypothesis (proof-proof-assume base (proof-ite test smaller *proof-true*) t))
       (smaller (proof-proof-prove-if base hypothesis descent))
       (typed (library-library-type-of library predecessor (list natural-type)))
       (bound (library-library-cite library "H2-PREDECESSOR-NONNEGATIVE" (list n) (list (car running))))
       (guard (h2-binomial-step-at smaller '(1)))
       (evidence (proof-proof-prove base guard (list typed bound) nil))
       (step (proof-proof-modus-ponens base smaller evidence)))
    (cons (list update step) proof)))

(defun h2-binomial-expt-matches-natural-more (goal typed strict smaller proof)
  (h2-binomial-with-results
      ((left (proof-term-at goal 1))
       (args (h2-binomial-pair-arguments left))
       (opening (h2-binomial-unfold-positive-expt proof (car args) (cadr args) typed strict))
       (proof (cdr opening))
       (base (library-library-proof (h2-search-search-library proof)))
       (step (proof-proof-rewrite base (car opening) smaller '(1 2 2)))
       (right (proof-term-at goal 2))
       (rule (proof-proof-unfold base right))
       (guard (h2-binomial-step-at rule '(2 1)))
       (evidence (proof-proof-prove base guard (list typed strict) nil))
       (natural-open (h2-book-logic-select-body proof rule evidence))
       (natural-open (proof-proof-symmetric base natural-open))
       (step (proof-proof-chain base step (list natural-open))))
    (cons step proof)))

(defun h2-binomial-induction-branch (branch goal typed strict smaller proof)
  (if (eq branch :expt-matches-natural)
      (h2-binomial-expt-matches-natural-more goal typed strict smaller proof)
    (let ((reply (assoc-equal (list goal typed strict smaller) branch)))
      (cond ((not reply) '(:failure "failure" ""))
            ((failure-p (cdr reply)) (cdr reply))
            (t (cons (cdr reply) proof))))))

(defun h2-binomial-nonnegative-induction (proof formula branch base-definitions facts)
  (let* ((library (h2-search-search-library proof))
         (core (library-library-proof library)))
    (h2-binomial-with-results
        ((parts (h2-binomial-pair-arguments formula))
         (guard (car parts))
         (goal (cadr parts))
         (assumed (proof-proof-assume core guard t))
         (evidence (proof-proof-conjunct core assumed))
         (typed (car evidence))
         (bound (cadr evidence))
         (n (h2-binomial-step-at typed '(1)))
         (test (library-positive n))
         (strict (proof-proof-assume core test t))
         (weak (proof-proof-assume core test nil))
         (zero-type (library-library-type-of library *proof-zero* nil))
         (zero (library-library-cite library "H2-INTEGER-EQUAL-WHEN-NEITHER-LESS" (list n *proof-zero*)
                                     (list typed zero-type bound weak)))
         (base (h2-binomial-derive proof goal base-definitions facts (list zero) "BINOMIAL-EXPANSION SUMLIST"))
         (proof (cdr base))
         (countdown (h2-binomial-natural-countdown proof formula n typed strict))
         (proof (cdr countdown))
         (update (caar countdown))
         (child (cadar countdown))
         (result (h2-binomial-induction-branch branch goal typed strict child proof))
         (proof (cdr result))
         (library (h2-search-search-library proof))
         (core (library-library-proof library))
         (cases (proof-proof-cases core test (car result) (car base)))
         (cases (h2-search-search-introduce proof formula cases))
         (ordinal (library-library-builtin library 1 n))
         (step (proof-proof-induct core ordinal cases formula (list *library-count* n) (list update))))
      (cons step proof))))

(defun h2-binomial-expt-matches-natural (proof formula)
  (h2-binomial-nonnegative-induction proof formula :expt-matches-natural "EXPT N-EXPT ZIP =" nil))

(defun h2-binomial-expansion-commute (library evidence x y)
  (let ((base (library-library-proof library))
        (name (proof-sym "BINOMIAL-THEOREM" "ACL2")))
    (proof-with-checked-results
        ((expansion (proof-proof-fact base name nil))
         (opposite (proof-proof-fact base name (list (list x y) (list y x))))
         (first (proof-proof-modus-ponens base expansion evidence))
         (second (proof-proof-modus-ponens base opposite evidence))
         (first (proof-proof-symmetric base first))
         (commute (library-library-axiom library "COMMUTATIVITY-OF-+" (list x y)))
         (commute (proof-proof-rewrite base first commute '(1 2 1))))
      (proof-proof-chain base commute (list second)))))

(defun h2-binomial-expansion-exponents (base evidence goal n)
  (proof-with-checked-results
      ((term (h2-binomial-term-at goal '(1 1)))
       (power (proof-proof-fact base (proof-sym "N-EXPT-EXPT" "ACL2")
                                (list (list *library-x* term) (list *h2-binomial-n* n))))
       (expansion (proof-proof-fact base (proof-sym "BINOMIAL-THEOREM-FAKE" "ACL2") nil))
       (first (proof-proof-modus-ponens base power evidence))
       (second (proof-proof-modus-ponens base expansion evidence)))
    (proof-proof-chain base first (list second))))

(defun h2-binomial-binomial-expansion (proof label formula)
  (let* ((library (h2-search-search-library proof))
         (base (library-library-proof library)))
    (proof-with-checked-results
        ((parts (h2-binomial-pair-arguments formula))
         (guard (car parts))
         (goal (cadr parts))
         (evidence (proof-proof-assume base guard t))
         (n (h2-binomial-term-at guard '(1 1)))
         (result (if (equal label "BINOMIAL-THEOREM")
                     (h2-binomial-expansion-exponents base evidence goal n)
                   (h2-binomial-expansion-commute library evidence *library-x* *library-y*))))
      (h2-search-search-introduce proof formula result))))

(defun h2-binomial-fixed-expansion-call (formula)
  (proof-with-checked-results
      ((value (h2-binomial-term-at formula '(2 1)))
       (head (proof-term-at value 0))
       (arguments (seq-slice value 1 3))
       (index (proof-term-at value 3))
       (successor (library-plus *proof-one* index))
       (bound (proof-term-at value 4)))
    (append (cons head arguments) (list successor bound))))

(defun h2-binomial-folded-attempt (proof formula fixed inherited-hooks used replies)
  (let ((result (h2-binomial-derive
                 (h2-search-search-with-replies proof (reverse used))
                 formula "BINOMIAL-EXPANSION" nil nil "")))
    (cond
     ((failure-p result) (cons :done result))
     ((not (h2-search-request-p result))
      (list* :done (car result) (h2-search-search-with-replies (cdr result) replies)))
     (t
      (let* ((method (h2-search-request-method result))
             (phase (h2-search-request-phase result))
             (term (car (h2-search-request-args result))))
        (cond
         ((and (eq phase :before) (eq method :can-open) (equal term fixed))
          (list :retry (cons '(:return nil) used) replies))
         ((not (member-eq method inherited-hooks))
          (list :retry (cons :base used) replies))
         ((endp replies) (cons :done result))
         (t (list :retry (cons (car replies) used) (cdr replies)))))))))

(defun h2-binomial-derive-folded (n proof formula fixed hooks attempt)
  (declare (xargs :measure (nfix n)))
  (cond ((zp n) '(:failure "Fuel" "h2-binomial-derive-folded"))
        ((eq (car attempt) :done) (cdr attempt))
        (t (h2-binomial-derive-folded
            (1- n) proof formula fixed hooks
            (h2-binomial-folded-attempt proof formula fixed hooks (cadr attempt) (caddr attempt))))))

; A failed search returns just the failure.
; The shortest reply prefix that reaches it determines the unused suffix.
(defun h2-binomial-unused-expansion-replies (n search formula replies low high)
  (declare (xargs :measure (nfix n)))
  (cond
   ((zp n) '(:failure "Fuel" "h2-binomial-unused-expansion-replies"))
   ((<= high low) (nthcdr low replies))
   (t
    (let* ((middle (floor (+ low high) 2))
           (trial (h2-binomial-derive
                   (h2-search-search-with-replies search (take middle replies))
                   formula "BINOMIAL-EXPANSION" nil nil ""))
           (needs-reply (h2-search-request-p trial)))
      (h2-binomial-unused-expansion-replies
       (1- n) search formula replies
       (if needs-reply (1+ middle) low)
       (if needs-reply high middle))))))

(defun h2-binomial-restore-fixed-calls (search formula derived saved)
  (let ((answer (car derived))
        (configured (cdr derived)))
    (h2-binomial-with-results
        ((replies
          (if (failure-p answer)
              (let ((replies (h2-search-search-replies search)))
                (h2-binomial-unused-expansion-replies
                 1000000 search formula replies 0 (len replies)))
            (h2-search-search-replies configured)))
         (configured (h2-search-search-with-replies configured replies))
         (restored (h2-search-search-call-with-remainder
                    configured :restore-fixed-calls (list saved))))
      (if (failure-p answer)
          answer
        (cons answer (cdr restored))))))

(defun h2-binomial-expansion-zero-with-folds (proof formula fixed)
  (h2-binomial-with-results
      ((saved (h2-search-search-call-with-remainder proof :keep-folded (list (list fixed))))
       (search (cdr saved))
       (derived (h2-book-logic-derive search formula "BINOMIAL-EXPANSION" nil nil 1 "" nil nil 80)))
    (if (h2-search-request-p (car derived))
        (car derived)
      (h2-binomial-restore-fixed-calls search formula derived (car saved)))))

(defun h2-binomial-expansion-zero (proof formula)
  (proof-with-checked-results ((fixed (h2-binomial-fixed-expansion-call formula)))
    (let ((hooks (h2-search-search-hooks proof)))
      (if (and (member-eq :keep-folded hooks) (member-eq :restore-fixed-calls hooks))
          (h2-binomial-expansion-zero-with-folds proof formula fixed)
        (let ((replies (h2-search-search-replies proof))
              (scoped (h2-search-search-with-hooks proof (add-to-set-eq :can-open hooks))))
          (h2-binomial-with-results
              ((result (h2-binomial-derive-folded 1000000 scoped formula fixed hooks (list :retry nil replies)))
               (search (h2-search-search-with-hooks (cdr result) hooks)))
            (cons (car result) search)))))))

(defun h2-binomial-binomial-theorem (proof label formula)
  (cond
   ((equal label "CHOOSE-REDUCTION")
    (h2-binomial-choose-reduction proof formula))
   ((equal label "CHOOSE-MK-CHOOSE")
    (h2-binomial-choose-iteration proof formula nil))
   ((equal label "CHOOSE-IS-NON-NEGATIVE-INTEGER")
    (h2-binomial-choose-natural proof formula))
   ((equal label "CHOOSE-0-N")
    (h2-binomial-with-results
        ((edge (h2-binomial-choose-edge proof t))
         (proof (cdr edge))
         (base (library-library-proof (h2-search-search-library proof)))
         (step (proof-proof-fact base (car edge) nil)))
      (cons step proof)))
   ((equal label "N-EXPT-EXPT")
    (h2-binomial-expt-matches-natural proof formula))
   ((member-equal label '("BINOMIAL-THEOREM" "BINOMIAL-SUM-COMMUTES"))
    (proof-with-checked-results ((step (h2-binomial-binomial-expansion proof label formula)))
      (cons step proof)))
   ((equal label "BINOMIAL-EXPANSION-ZERO")
    (h2-binomial-expansion-zero proof formula))
   (t (cons nil proof))))
