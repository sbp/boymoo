(in-package "BOYMOO-PROVER")
(set-verify-guards-eagerness 0)

(defconst *h2-compression-compress-loop* (proof-sym "COMPRESS11" "ACL2"))
(defconst *h2-compression-zp* (proof-sym "ZP" "ACL2"))
(defconst *h2-compression-name* (proof-sym "NAME" "ACL2"))
(defconst *h2-compression-data* (proof-sym "L" "ACL2"))
(defconst *h2-compression-index* (proof-sym "I" "ACL2"))
(defconst *h2-compression-limit* (proof-sym "N" "ACL2"))
(defconst *h2-compression-default* (proof-sym "DEFAULT" "ACL2"))
(defconst *h2-compression-canonical-name* (proof-quote (proof-sym "FAKE-NAME" "KEYWORD")))
(defconst *h2-compression-header* (proof-sym "HEADER" "ACL2"))

(defmacro h2-compression-with-results (bindings result)
  (if (endp bindings)
      result
    (let ((binding (car bindings))
          (name (caar bindings)))
      `(let (,binding)
         (if (h2-search-stopped-p ,name)
             ,name
           (h2-compression-with-results ,(cdr bindings) ,result))))))

(defun h2-compression-first-at (step index)
  (proof-with-checked-results ((literal (proof-step-first step)))
    (proof-term-at literal index)))

(defun h2-compression-folded-call
    (n proof operation args folded use-caller-hook replies supplied)
  (declare (xargs :measure (nfix n)))
  (if (not (o< (nfix (1- n)) (nfix n)))
      '(:failure "fuel" "h2-compression-folded-call")
    (let* ((search (h2-search-search-with-replies proof supplied))
           (result (h2-search-search-call-with-remainder search operation args)))
      (cond
       ((failure-p result) result)
       ((not (h2-search-request-p result))
        (cons (car result) (h2-search-search-with-replies proof replies)))
       (t
        (let* ((can-open (and (eq (h2-search-request-method result) :can-open)
                              (eq (h2-search-request-phase result) :before)))
               (reply (cond ((and can-open (member-equal (car (h2-search-request-args result)) folded))
                             '(:return nil))
                            ((and can-open (not use-caller-hook)) :base)
                            (t nil))))
          (if (or reply (consp replies))
              (h2-compression-folded-call
               (1- n) proof operation args folded use-caller-hook
               (if reply replies (cdr replies)) (append supplied (list (or reply (car replies)))))
            result)))))))

(defun h2-compression-derive-with-folded (proof options folded)
  (h2-compression-with-results
      ((configured (h2-book-logic-set-rules proof (nth 1 options) (nth 2 options)
                                           (nth 5 options) (nth 8 options))))
    (let* ((formula (car options))
           (variable (nth 3 options))
           (operation (if variable :list-induction :solve))
           (args (if variable
                     (list formula (proof-sym variable "ACL2") nil (nth 4 options))
                   (list formula (nth 6 options) (nth 7 options)))))
      (if (endp folded)
          (h2-search-search-call-with-remainder configured operation args)
        (let* ((hooks (h2-search-search-hooks configured))
               (scoped (h2-search-search-with-hooks configured (add-to-set-eq :can-open hooks))))
          (h2-compression-with-results
              ((result (h2-compression-folded-call
                        1000000 scoped operation args folded (member-eq :can-open hooks)
                        (h2-search-search-replies configured) nil)))
            (cons (car result) (h2-search-search-with-hooks (cdr result) hooks))))))))

(defun h2-compression-derive (proof formula definitions facts seeds cases)
  (h2-compression-derive-with-folded proof (list formula definitions facts nil 1 "" seeds cases 80) nil))

(defun h2-compression-set-fuel (proof)
  (if (member-eq :set-fuel (h2-search-search-hooks proof))
      (h2-compression-with-results
          ((result (h2-search-search-call-with-remainder proof :set-fuel '(42000))))
        (cdr result))
    proof))

(defun h2-compression-answer-derive (proof request)
  (h2-compression-derive-with-folded proof (h2-alist-recognizers-request-arguments request)
                                     (h2-alist-recognizers-request-folded request)))

(defun h2-compression-equal-total-sums (n proof left right replies)
  (declare (xargs :measure (nfix n)))
  (if (not (o< (nfix (1- n)) (nfix n)))
      '(:failure "fuel" "h2-compression-equal-total-sums")
    (h2-compression-with-results
        ((result (h2-calculation-equal-total-sums-with-replies proof left right replies)))
      (let ((value (car result)))
        (if (not (h2-alist-recognizers-request-p value))
            result
          (let ((reply (h2-compression-answer-derive (cdr result) value)))
            (if (h2-search-request-p reply)
                reply
              (h2-compression-equal-total-sums
               (1- n) proof left right (append replies (list reply))))))))))

(defun h2-compression-range-decrease (proof index limit active)
  (let ((span (library-diff limit index))
        (remaining (library-diff limit (library-plus index *proof-one*))))
    (h2-compression-with-results
        ((result (h2-compression-equal-total-sums
                  1000000 proof (library-plus *proof-neg-one* span) remaining nil))
         (equation (car result))
         (proof (cdr result))
         (library (h2-search-search-library proof))
         (core (library-library-proof library))
         (descent (library-library-builtin library 9 span))
         (smaller (proof-proof-discharge core descent active)))
      (if (not equation)
          '(:failure "failure" "")
        (h2-compression-with-results ((step (proof-proof-rewrite core smaller equation '(1 1 1))))
          (cons step proof))))))

(defun h2-compression-logical-branch (proof term evidence)
  (let ((core (library-library-proof (h2-search-search-library proof))))
    (h2-compression-with-results
        ((opening (proof-proof-unfold core term))
         (opening (h2-book-logic-select-body proof opening evidence))
         (body (h2-compression-first-at opening 2))
         (direct (h2-search-search-remove-wrappers proof body)))
      (proof-proof-chain core opening (list direct)))))

(defun h2-compression-loop-name (proof)
  (let* ((library (h2-search-search-library proof))
         (core (library-library-proof library))
         (name "SELF-H2-COMPRESS-LOOP-NAME"))
    (if (assoc-equal (proof-sym name "ACL2") (proof-proof-facts core))
        (cons name proof)
      (let* ((arguments (list *h2-compression-data* *h2-compression-index*
                              *h2-compression-limit* *h2-compression-default*))
             (left (list* *h2-compression-compress-loop* *h2-compression-name* arguments))
             (right (list* *h2-compression-compress-loop* *h2-compression-canonical-name* arguments))
             (formula (proof-eq left right))
             (span (library-diff *h2-compression-limit* *h2-compression-index*))
             (test (list *h2-compression-zp* span))
             (new-index (library-plus *h2-compression-index* *proof-one*))
             (updates (list (list *h2-compression-index* new-index))))
        (h2-compression-with-results
            ((stopped (proof-proof-assume core test t))
             (running (proof-proof-assume core test nil))
             (left-stopped (h2-compression-logical-branch proof left stopped))
             (right-stopped (h2-compression-logical-branch proof right stopped))
             (reversed (proof-proof-symmetric core right-stopped))
             (yes (proof-proof-chain core left-stopped (list reversed)))
             (result (h2-compression-range-decrease
                      proof *h2-compression-index* *h2-compression-limit* running))
             (decrease (car result))
             (proof (cdr result))
             (library (h2-search-search-library proof))
             (core (library-library-proof library))
             (smaller (proof-subst formula (list (cons *h2-compression-index* new-index))))
             (decrease-term (proof-step-first decrease))
             (hypothesis (proof-proof-assume core (proof-ite decrease-term smaller *proof-true*) t))
             (induction (proof-proof-prove-if core hypothesis decrease))
             (equation (h2-compression-logical-branch proof left running))
             (literal (proof-step-first equation))
             (equation (proof-proof-rewrite-result core equation induction literal (cadr smaller)))
             (right-running (h2-compression-logical-branch proof right running))
             (reversed (proof-proof-symmetric core right-running))
             (no (proof-proof-chain core equation (list reversed)))
             (ordinal (library-library-builtin library 1 span))
             (cases (proof-proof-cases core test yes no))
             (result (proof-proof-induct core ordinal cases formula (list *library-count* span) (list updates)))
             (library (library-library-lemma library "H2-COMPRESS-LOOP-NAME" formula result nil)))
          (cons name (h2-search-search-with-library proof library)))))))

(defun h2-compression-normalize-compression (proof formula)
  (h2-compression-with-results
      ((result (h2-compression-loop-name proof))
       (name (car result))
       (proof (cdr result)))
    (h2-compression-derive proof formula "COMPRESS1 HEADER DIMENSIONS DEFAULT SYNP" (list name) nil nil)))

(defun h2-compression-loop-preserved (proof recognizer constructor lookup)
  (h2-compression-with-results
      ((definition (h2-alist-recognizers-label recognizer)))
    (let* ((stem (concatenate 'string "COMPRESS-LOOP-" definition))
           (name (concatenate 'string "SELF-H2-" stem))
           (library (h2-search-search-library proof))
           (core (library-library-proof library)))
      (if (assoc-equal (proof-sym name "ACL2") (proof-proof-facts core))
          (cons name proof)
        (let* ((loop-call (list *h2-compression-compress-loop* *h2-compression-name*
                                *h2-compression-data* *h2-compression-index*
                                *h2-compression-limit* *h2-compression-default*))
               (span (library-diff *h2-compression-limit* *h2-compression-index*))
               (test (list *h2-compression-zp* span))
               (new-index (library-plus *h2-compression-index* *proof-one*))
               (updates (list (list *h2-compression-index* new-index))))
          (h2-compression-with-results
              ((premise (h2-alist-recognizers-accepted recognizer *h2-compression-data*))
               (conclusion (h2-alist-recognizers-accepted recognizer loop-call))
               (formula (list *library-implies* premise conclusion))
               (source (proof-proof-assume core premise t))
               (yes (proof-proof-assume core test t))
               (no (proof-proof-assume core test nil))
               (ends (h2-compression-logical-branch proof loop-call yes))
               (begins (h2-compression-logical-branch proof loop-call no))
               (accepted-nil (h2-alist-recognizers-accepted recognizer *proof-false*))
               (result (h2-compression-derive proof accepted-nil definition nil nil nil))
               (base (car result))
               (proof (cdr result))
               (library (h2-search-search-library proof))
               (base (library-library-transport-argument library base ends 1))
               (result (h2-compression-range-decrease
                        proof *h2-compression-index* *h2-compression-limit* no))
               (decrease (car result))
               (proof (cdr result))
               (library (h2-search-search-library proof))
               (core (library-library-proof library))
               (decrease-term (proof-step-first decrease))
               (updated (proof-subst formula (list (cons *h2-compression-index* new-index))))
               (smaller (proof-proof-assume core (proof-ite decrease-term updated *proof-true*) t))
               (hypothesis (proof-proof-prove-if core smaller decrease))
               (induction (proof-proof-modus-ponens core hypothesis source))
               (body (h2-compression-first-at begins 2))
               (parts (proof-list-of-length (cdr body) 3))
               (drop (car parts))
               (entry (proof-term-at (caddr parts) 1))
               (drop-step (proof-proof-assume core drop t))
               (dropped (h2-book-logic-select-body proof begins drop-step))
               (omitted (library-library-transport-argument library induction dropped 1))
               (keep (proof-proof-assume core drop nil))
               (result (h2-compression-derive proof entry "" nil (list keep) (list entry)))
               (present (car result))
               (proof (cdr result))
               (library (h2-search-search-library proof))
               (core (library-library-proof library))
               (signature (h2-alist-recognizers-alist-fact
                           library lookup recognizer
                           (list (list *library-x* *h2-compression-data*)
                                 (list *h2-alist-recognizers-key* *h2-compression-index*))))
               (condition (h2-compression-first-at signature 1))
               (proved (proof-proof-prove core condition (list source present) nil))
               (singleton (proof-proof-modus-ponens core signature proved))
               (kept (h2-alist-recognizers-cons-closed library constructor singleton induction recognizer))
               (selected (h2-book-logic-select-body proof begins keep))
               (kept (library-library-transport-argument library kept selected 1))
               (drop-cases (proof-proof-cases core drop omitted kept))
               (case-step (proof-proof-cases core test base drop-cases))
               (statement (h2-search-search-introduce proof formula case-step))
               (ordinal (library-library-builtin library 1 span))
               (result (proof-proof-induct core ordinal statement formula (list *library-count* span) (list updates)))
               (library (library-library-lemma library (concatenate 'string "H2-" stem) formula result nil)))
            (cons name (h2-search-search-with-library proof library))))))))

(defun h2-compression-recognizer-call (n proof operation recognizer parts replies)
  (declare (xargs :measure (nfix n)))
  (if (not (o< (nfix (1- n)) (nfix n)))
      '(:failure "fuel" "h2-compression-recognizer-call")
    (h2-compression-with-results
        ((result (case operation
                   (:list-parts (h2-alist-recognizers-list-parts-with-replies proof recognizer replies))
                   (:lookup-singleton (h2-alist-recognizers-lookup-singleton-with-replies
                                       proof recognizer parts replies))
                   (:reverse-preserved (h2-alist-recognizers-reverse-preserved-with-replies
                                        proof recognizer parts replies)))))
      (let ((value (car result)))
        (if (not (h2-alist-recognizers-request-p value))
            result
          (h2-compression-with-results
              ((derived (h2-compression-answer-derive (cdr result) value)))
            (h2-compression-recognizer-call (1- n) proof operation recognizer parts
                                            (append replies (list derived)))))))))

(defun h2-compression-compression-laws (proof recognizer)
  (h2-compression-with-results
      ((result (h2-compression-recognizer-call 1000000 proof :list-parts recognizer nil nil))
       (parts (car result))
       (proof (cdr result))
       (result (h2-compression-recognizer-call 1000000 proof :lookup-singleton recognizer parts nil))
       (lookup (car result))
       (proof (cdr result))
       (result (h2-compression-recognizer-call 1000000 proof :reverse-preserved recognizer parts nil))
       (reverse-name (car result))
       (proof (cdr result))
       (constructor (proof-term-at parts 0))
       (result (h2-compression-loop-preserved proof recognizer constructor lookup))
       (loop-name (car result))
       (proof (cdr result)))
    (cons (list constructor lookup reverse-name loop-name) proof)))

(defun h2-compression-compressed-conforms-checked
    (value tests proof data source recognizer constructor reverse-name loop-name head)
  (declare (ignore tests))
  (if (equal value data)
      source
    (let* ((library (h2-search-search-library proof))
           (core (library-library-proof library)))
      (h2-compression-with-results
          ((tail (proof-term-at value 2))
           (reversed (proof-is-call tail *h2-alist-recognizers-reverse*))
           (iteration (if reversed (proof-term-at tail 1) tail))
           (bindings (seq-zip (list *h2-compression-name* *h2-compression-data*
                                   *h2-compression-index* *h2-compression-limit*
                                   *h2-compression-default*)
                             (cdr iteration)))
           (law (h2-alist-recognizers-alist-fact library loop-name recognizer bindings))
           (predicate (proof-proof-modus-ponens core law source))
           (predicate
            (if reversed
                (h2-compression-with-results
                    ((back (h2-alist-recognizers-alist-fact
                            library reverse-name recognizer (list (list *library-x* iteration)))))
                  (proof-proof-modus-ponens core back predicate))
              predicate)))
        (h2-alist-recognizers-cons-closed library constructor head predicate recognizer)))))

(defun h2-compression-conforms-by-value (n value template tests proof data source recognizer laws head)
  (declare (xargs :measure (nfix n)))
  (if (not (o< (nfix (1- n)) (nfix n)))
      '(:failure "fuel" "h2-compression-conforms-by-value")
    (let ((core (library-library-proof (h2-search-search-library proof))))
      (cond
       ((proof-is-call value *proof-if*)
        (h2-compression-with-results
            ((branches (proof-list-of-length (cdr value) 3))
             (test (car branches))
             (yes (h2-compression-conforms-by-value
                   (1- n) (cadr branches) template (append tests (list (list test t)))
                   proof data source recognizer laws head))
             (no (h2-compression-conforms-by-value
                  (1- n) (caddr branches) template (append tests (list (list test nil)))
                  proof data source recognizer laws head))
             (if-true (proof-proof-if-true core value))
             (if-true (proof-proof-symmetric core if-true))
             (yes (proof-proof-rewrite-result core yes if-true template *proof-result*))
             (if-false (proof-proof-if-false core value))
             (if-false (proof-proof-symmetric core if-false))
             (no (proof-proof-rewrite-result core no if-false template *proof-result*)))
          (proof-proof-cases core test yes no)))
       ((and (proof-compound value) (not (consp value)))
        '(:failure "failure" ""))
       ((and (proof-compound value) (proof-compound (car value)))
        (h2-compression-with-results
            ((equality (proof-proof-beta core value))
             (body (h2-compression-first-at equality 2))
             (opened (h2-compression-conforms-by-value
                      (1- n) body template tests proof data source recognizer laws head))
             (reversed (proof-proof-symmetric core equality)))
          (proof-proof-rewrite-result core opened reversed template *proof-result*)))
       (t (h2-compression-with-results
              ((step (h2-compression-compressed-conforms-checked
                      value tests proof data source recognizer (car laws) (caddr laws) (cadddr laws) head))
               (literal (proof-step-first step))
               (target (proof-subst template (list (cons *proof-result* value)))))
            (if (equal literal target)
                step
              '(:failure "failure" ""))))))))

(defun h2-compression-compressed-conforms (proof recognizer compression source header laws)
  (let* ((library (h2-search-search-library proof))
         (core (library-library-proof library)))
    (h2-compression-with-results
        ((laws (proof-list-of-length laws 4))
         (literal (proof-step-first header))
         (header-eq (h2-book-logic-logical-equation proof literal))
         (assoc-step (proof-proof-rewrite core header header-eq '(1)))
         (lookup-term (proof-step-first assoc-step))
         (args (proof-list-of-length (cdr lookup-term) 2))
         (key (car args))
         (data (cadr args))
         (head (h2-alist-recognizers-alist-fact
                library (cadr laws) recognizer
                (list (list *h2-alist-recognizers-key* key) (list *library-x* data))))
         (condition (h2-compression-first-at head 1))
         (evidence (proof-proof-prove core condition (list source assoc-step) nil))
         (head (proof-proof-modus-ponens core head evidence))
         (reversed (proof-proof-symmetric core header-eq))
         (head (proof-proof-rewrite core head reversed '(1 1 1)))
         (opening (h2-book-logic-logical-equation proof compression))
         (body (h2-compression-first-at opening 2))
         (template (h2-alist-recognizers-accepted recognizer *proof-result*))
         (result (h2-compression-conforms-by-value
                  1000000 body template nil proof data source recognizer laws head)))
      (library-library-transport-argument library result opening 1))))

(defun h2-compression-absent-compression (proof compression header)
  (let ((core (library-library-proof (h2-search-search-library proof))))
    (h2-compression-with-results
        ((header-term (h2-compression-first-at header 1))
         (header-eq (h2-book-logic-logical-equation proof header-term))
         (absent (proof-proof-rewrite core header header-eq '(1 1)))
         (formula (proof-eq compression (list *proof-cons* *proof-false* *proof-false*)))
         (fixed (h2-compression-first-at header-eq 2)))
      (h2-compression-derive-with-folded
       proof (list formula "COMPRESS1 HEADER ARRAY-ORDER ASSOC-KEYWORD DIMENSIONS DEFAULT COMPRESS11 ZP"
                   nil nil 1 "" (list absent) nil 80) (list fixed)))))

(defun h2-compression-compression-list-theorem (proof theorem formula)
  (let* ((alist (equal theorem "ALISTP-OF-COMPRESS1"))
         (predicate (if alist (list *h2-alist-recognizers-alist*)
                      (list *h2-alist-recognizers-bounded* *h2-alist-recognizers-bound*))))
    (h2-compression-with-results
        ((proof (h2-compression-set-fuel proof))
         (result (h2-compression-compression-laws proof predicate))
         (laws (car result))
         (proof (cdr result))
         (library (h2-search-search-library proof))
         (core (library-library-proof library))
         (parts (proof-list-of-length (cdr formula) 2))
         (assumed (proof-proof-assume core (car parts) t))
         (conditions (proof-proof-conjunct core assumed))
         (source (car conditions))
         (extra (cadr conditions))
         (goal (cadr parts)))
      (if alist
          (h2-compression-with-results
              ((term (h2-compression-first-at extra 1))
               (header (library-library-cite library "H2-CONSP-NONNIL" (list term) (list extra)))
               (compression (proof-term-at goal 1))
               (result (h2-compression-compressed-conforms proof predicate compression source header laws))
               (step (h2-search-search-introduce proof formula result)))
            (cons step proof))
        (h2-compression-with-results
            ((parts (proof-list-of-length (cdr goal) 2))
             (conformity (car parts))
             (header-term (cadr parts))
             (bound (proof-term-at conformity 2))
             (predicate (list *h2-alist-recognizers-bounded* bound))
             (found (proof-proof-assume core header-term t))
             (missing (proof-proof-assume core header-term nil))
             (compression (proof-term-at conformity 1))
             (preserved (h2-compression-compressed-conforms proof predicate compression source found laws))
             (result (h2-compression-derive proof goal "" nil (list preserved found) nil))
             (yes (car result))
             (proof (cdr result))
             (result (h2-compression-absent-compression proof compression missing))
             (empty (car result))
             (proof (cdr result))
             (empty-value (h2-compression-first-at empty 2))
             (accepted (h2-alist-recognizers-accepted predicate empty-value))
             (label (h2-alist-recognizers-label predicate))
             (result (h2-compression-derive proof (proof-neg accepted) label nil nil nil))
             (has-nil-entry (car result))
             (proof (cdr result))
             (core (library-library-proof (h2-search-search-library proof)))
             (reversed (proof-proof-symmetric core empty))
             (invalid (proof-proof-rewrite core has-nil-entry reversed '(1 1 1)))
             (result (h2-compression-derive proof goal "" nil (list invalid missing) nil))
             (no (car result))
             (proof (cdr result))
             (core (library-library-proof (h2-search-search-library proof)))
             (cases (proof-proof-cases core header-term yes no))
             (step (h2-search-search-introduce proof formula cases)))
          (cons step proof))))))

(defun h2-compression-array-conditions (n core tail)
  (declare (xargs :measure (nfix n)))
  (if (not (o< (nfix (1- n)) (nfix n)))
      '(:failure "fuel" "h2-compression-array-conditions")
    (h2-compression-with-results ((literal (proof-step-first tail)))
      (if (not (proof-is-call literal *proof-if*))
          (list tail)
        (h2-compression-with-results ((no (proof-term-at literal 3)))
          (if (not (equal no *proof-false*))
              (list tail)
            (h2-compression-with-results
                ((parts (proof-proof-conjunct core tail))
                 (rest (h2-compression-array-conditions (1- n) core (cadr parts))))
              (cons (car parts) rest))))))))

(defun h2-compression-array-fields (proof compression exists conditions)
  (declare (xargs :measure (acl2-count conditions)))
  (if (endp conditions)
      (cons nil proof)
    (let ((condition (car conditions)))
      (h2-compression-with-results
          ((literal (proof-step-first condition))
           (kind (proof-term-at literal 0))
           (result
            (if (or (equal kind *h2-alist-recognizers-alist*)
                    (equal kind *h2-alist-recognizers-bounded*))
                (let ((generic (if (equal kind *h2-alist-recognizers-alist*)
                                   (list *h2-alist-recognizers-alist*)
                                 (list *h2-alist-recognizers-bounded* *h2-alist-recognizers-bound*))))
                  (h2-compression-with-results
                      ((result (h2-compression-compression-laws proof generic))
                       (laws (car result))
                       (proof (cdr result))
                       (predicate (cons kind (cddr literal)))
                       (condition (h2-compression-compressed-conforms
                                   proof predicate compression condition exists laws)))
                    (cons condition proof)))
              (cons condition proof)))
           (condition (car result))
           (proof (cdr result))
           (rest (h2-compression-array-fields proof compression exists (cdr conditions)))
           (fields (car rest))
           (proof (cdr rest)))
        (cons (cons condition fields) proof)))))

(defun h2-compression-compressed-array (proof formula header-preservation)
  (let* ((library (h2-search-search-library proof))
         (core (library-library-proof library)))
    (h2-compression-with-results
        ((parts (proof-list-of-length (cdr formula) 2))
         (before (car parts))
         (after (cadr parts))
         (args (proof-list-of-length (cdr before) 2))
         (name (car args))
         (data (cadr args))
         (compressed (proof-term-at after 2))
         (source (proof-proof-assume core before t))
         (before-eq (h2-book-logic-logical-equation proof before))
         (tail (proof-proof-rewrite core source before-eq '(1)))
         (conditions (h2-compression-array-conditions 1000000 core tail))
         (proof (h2-compression-set-fuel proof))
         (array-name (proof-term-at compressed 1))
         (header (list *h2-compression-header* array-name data))
         (result (h2-compression-derive proof header "HEADER ASSOC-KEYWORD" nil
                                        (cons source conditions) (list header)))
         (exists (car result))
         (proof (cdr result))
         (library (h2-search-search-library proof))
         (core (library-library-proof library))
         (preserve (library-library-axiom library header-preservation (list name array-name data)))
         (preserve-left (h2-compression-first-at preserve 1))
         (left-eq (h2-book-logic-logical-equation proof preserve-left))
         (left-eq (proof-proof-symmetric core left-eq))
         (preserve-right (h2-compression-first-at preserve 2))
         (right-eq (h2-book-logic-logical-equation proof preserve-right))
         (preserve (proof-proof-chain core left-eq (list preserve right-eq)))
         (normalized (h2-book-logic-logical-equation proof after))
         (literal (proof-step-first normalized))
         (slot (h2-compression-first-at preserve 1))
         (normalized (proof-proof-rewrite-result core normalized preserve literal slot))
         (result (h2-compression-array-fields proof compressed exists conditions))
         (fields (car result))
         (proof (cdr result))
         (core (library-library-proof (h2-search-search-library proof)))
         (target (h2-compression-first-at normalized 2))
         (proved (proof-proof-prove core target fields nil))
         (answer (proof-proof-transport core proved normalized))
         (step (h2-search-search-introduce proof formula answer)))
      (cons step proof))))
