(in-package "BOYMOO-PROVER")
(set-verify-guards-eagerness 0)

(defconst *h2-tail-recursion-test* (proof-sym "DEFPUN-TEST" "ACL2"))
(defconst *h2-tail-recursion-next* (proof-sym "DEFPUN-ST" "ACL2"))
(defconst *h2-tail-recursion-iterate* (proof-sym "DEFPUN-STN" "ACL2"))
(defconst *h2-tail-recursion-evaluate* (proof-sym "DEFPUN-FN" "ACL2"))
(defconst *h2-tail-recursion-choose* (proof-sym "FCH" "ACL2"))
(defconst *h2-tail-recursion-run* (proof-sym "DEFPUN-F" "ACL2"))
(defconst *h2-tail-recursion-zp* (proof-sym "ZP" "ACL2"))
(defconst *h2-tail-recursion-n* (proof-sym "N" "ACL2"))
(defconst *h2-tail-recursion-m* (proof-sym "M" "ACL2"))

(defun h2-tail-recursion-reached (initial bound)
  (list *h2-tail-recursion-test* (list *h2-tail-recursion-iterate* initial bound)))

(defun h2-tail-recursion-positive-bound (proof reach testing)
  (let ((logic (h2-modular-proof proof)))
    (h2-recipes-with-results
     ((iterate (h2-modular-first-at reach '(1)))
      (bound (proof-term-at iterate 2))
      (zero (list *h2-tail-recursion-zp* bound))
      (opening (proof-proof-unfold logic iterate))
      (zero-step (proof-proof-assume logic zero t))
      (empty (h2-ordinals-select-body proof opening zero-step))
      (rewritten (proof-proof-rewrite logic reach empty '(1 1)))
      (conflict (proof-proof-cut logic rewritten testing)))
     (proof-proof-front logic conflict (proof-neg zero)))))

(defun h2-tail-recursion-evaluation-branch (proof initial bound index testing)
  (let ((logic (h2-modular-proof proof)))
    (h2-recipes-with-results
     ((equation (proof-proof-unfold logic (list *h2-tail-recursion-evaluate* initial bound)))
      (test (h2-modular-first-at equation '(2 1)))
      (test-eq (proof-proof-select logic test index))
      (equation (proof-proof-rewrite logic equation test-eq '(1 2 1)))
      (literal (proof-step-first index)))
     (h2-ordinals-select-body proof equation
                              (if (equal literal (list *h2-tail-recursion-zp* bound)) index testing)))))

(defun h2-tail-recursion-stops-early (proof initial bound testing)
  (let ((logic (h2-modular-proof proof))
        (test (list *h2-tail-recursion-zp* bound)))
    (h2-recipes-with-results
     ((positive (proof-proof-assume logic test t))
      (yes (h2-tail-recursion-evaluation-branch proof initial bound positive testing))
      (negative (proof-proof-assume logic test nil))
      (no (h2-tail-recursion-evaluation-branch proof initial bound negative testing)))
     (proof-proof-cases logic test yes no))))

(defun h2-tail-recursion-step-end (proof reach positive)
  (let ((logic (h2-modular-proof proof)))
    (h2-recipes-with-results
     ((iterate (h2-modular-first-at reach '(1)))
      (opening (proof-proof-unfold logic iterate))
      (stepped (h2-ordinals-select-body proof opening positive)))
     (proof-proof-rewrite logic reach stepped '(1 1)))))

(defun h2-tail-recursion-synchronized-evaluation (proof)
  (let ((name (proof-sym "SELF-H2-DEFPUN-SAME-STOP" "ACL2")))
    (if (h2-ordinals-has-fact proof name)
        (cons name proof)
      (let* ((library (h2-modular-library proof))
             (logic (library-library-proof library))
             (x *library-x*)
             (n *h2-tail-recursion-n*)
             (m *h2-tail-recursion-m*)
             (premise (proof-ite (h2-tail-recursion-reached x n)
                                 (h2-tail-recursion-reached x m) *proof-false*))
             (formula (list *library-implies* premise
                            (proof-eq (list *h2-tail-recursion-evaluate* x n)
                                      (list *h2-tail-recursion-evaluate* x m))))
             (test (list *h2-tail-recursion-test* x)))
        (h2-recipes-with-results
         ((assumed (proof-proof-assume logic premise t))
          (conjuncts (proof-proof-conjunct logic assumed))
          (left (car conjuncts))
          (right (cadr conjuncts))
          (stopped (proof-proof-assume logic test t))
          (active (proof-proof-assume logic test nil))
          (stops-n (h2-tail-recursion-stops-early proof x n stopped))
          (stops-m (h2-tail-recursion-stops-early proof x m stopped))
          (stops-m (proof-proof-symmetric logic stops-m))
          (yes (proof-proof-chain logic stops-n (list stops-m)))
          (n-positive (h2-tail-recursion-positive-bound proof left active))
          (m-positive (h2-tail-recursion-positive-bound proof right active))
          (first (h2-tail-recursion-evaluation-branch proof x n n-positive active))
          (second (h2-tail-recursion-evaluation-branch proof x m m-positive active))
          (next-call (h2-modular-first-at first '(2)))
          (next-arguments (h2-modular-tail-of-size next-call 2))
          (next-state (car next-arguments))
          (n-next (cadr next-arguments))
          (m-next (h2-modular-first-at second '(2 2)))
          (substitutions (list (list x next-state) (list n n-next) (list m m-next)))
          (builtin (library-library-builtin library 9 n))
          (decrease (proof-proof-discharge logic builtin n-positive))
          (less (proof-step-first decrease))
          (smaller (proof-subst formula (list (cons x next-state) (cons n n-next) (cons m m-next))))
          (assumption (proof-proof-assume logic (proof-ite less smaller *proof-true*) t))
          (induction (proof-proof-prove-if logic assumption decrease))
          (left-end (h2-tail-recursion-step-end proof left n-positive))
          (right-end (h2-tail-recursion-step-end proof right m-positive))
          (hypothesis (h2-modular-first-at induction '(1)))
          (reached (proof-proof-prove logic hypothesis (list left-end right-end) nil))
          (equal (proof-proof-modus-ponens logic induction reached))
          (reverse-second (proof-proof-symmetric logic second))
          (no (proof-proof-chain logic first (list equal reverse-second)))
          (cases (proof-proof-cases logic test yes no))
          (step (h2-modular-introduce proof formula cases))
          (ordinal (library-library-builtin library 1 n))
          (step (proof-proof-induct logic ordinal step formula (list *library-count* n)
                                    (list substitutions)))
          (proof (h2-recipes-lemma proof "H2-DEFPUN-SAME-STOP" formula step nil)))
         (cons name proof))))))

(defun h2-tail-recursion-choose-bound (proof reached-end)
  (let ((logic (h2-modular-proof proof)))
    (h2-recipes-with-results
     ((iterate (h2-modular-first-at reached-end '(1)))
      (args (h2-modular-tail-of-size iterate 2))
      (choice (proof-proof-fact logic *h2-tail-recursion-choose*
                                (list (list *library-x* (car args))
                                      (list *h2-tail-recursion-n* (cadr args))))))
     (proof-proof-modus-ponens logic choice reached-end))))

(defun h2-tail-recursion-prepend-transition (proof initial reached-end)
  (h2-recipes-with-results
   ((iterate (h2-modular-first-at reached-end '(1)))
    (args (h2-modular-tail-of-size iterate 2))
    (child (car args))
    (bound (cadr args))
    (fixed (list *h2-modular-natural-fix* bound))
    (zero (list *h2-tail-recursion-zp* bound))
    (fix-name (h2-modular-fixed-natural proof))
    (name (car fix-name))
    (proof (cdr fix-name))
    (library (h2-modular-library proof))
    (fixed-natural (library-library-axiom library name (list bound)))
    (typed (library-library-cite library "NATURAL-INTEGER" (list fixed) (list fixed-natural)))
    (lower (library-library-cite library "NATURAL-NONNEGATIVE" (list fixed) (list fixed-natural)))
    (bound-next (library-plus *proof-one* fixed))
    (positive (library-library-cite library "POSITIVE-ONE-PLUS" (list fixed) (list typed lower)))
    (next-typed (library-library-type-of library bound-next (list typed)))
    (index (h2-ordinals-derive proof (proof-neg (list *h2-tail-recursion-zp* bound-next))
                              "ZP" nil (list positive next-typed) 80))
    (proof (cdr index))
    (library (h2-modular-library proof))
    (logic (library-library-proof library))
    (opening (proof-proof-unfold logic (list *h2-tail-recursion-iterate* initial bound-next)))
    (next-eq (h2-ordinals-select-body proof opening (car index)))
    (decrement (library-library-cite library "H2-ADD1-SUB1" (list fixed) (list typed)))
    (next-eq (proof-proof-rewrite logic next-eq decrement '(1 2 2)))
    (origin (list *h2-tail-recursion-iterate* child bound))
    (naturalized (list *h2-tail-recursion-iterate* child fixed))
    (stop (proof-proof-assume logic zero t))
    (active (proof-proof-assume logic zero nil))
    (fix-when-zp (library-library-axiom library "SELF-H2-NFIX-WHEN-ZP" (list bound)))
    (fixed-zero (proof-proof-modus-ponens logic fix-when-zp stop))
    (reflexive (proof-proof-reflexive logic naturalized))
    (first (proof-proof-rewrite logic reflexive fixed-zero '(1 2 2)))
    (at-zero (h2-ordinals-derive proof
                                (proof-eq (list *h2-tail-recursion-iterate* child *proof-zero*) child)
                                "DEFPUN-STN ZP" nil nil 80))
    (proof (cdr at-zero))
    (library (h2-modular-library proof))
    (logic (library-library-proof library))
    (first (proof-proof-chain logic first (list (car at-zero))))
    (origin-open (proof-proof-unfold logic origin))
    (origin-zero (h2-ordinals-select-body proof origin-open stop))
    (origin-zero (proof-proof-symmetric logic origin-zero))
    (yes (proof-proof-chain logic first (list origin-zero)))
    (fix-when-not-zp (library-library-axiom library "SELF-H2-NFIX-WHEN-NOT-ZP" (list bound)))
    (fixed-original (proof-proof-modus-ponens logic fix-when-not-zp active))
    (reflexive (proof-proof-reflexive logic naturalized))
    (no (proof-proof-rewrite logic reflexive fixed-original '(1 2 2)))
    (cases (proof-proof-cases logic zero yes no))
    (next-eq (proof-proof-chain logic next-eq (list cases)))
    (step (library-library-transport-argument library reached-end next-eq 1)))
   (cons step proof)))

(defun h2-tail-recursion-tail-recursive-equation (proof formula)
  (let ((logic (h2-modular-proof proof)))
    (h2-recipes-with-results
     ((initial (h2-modular-term-at formula '(1 1)))
      (result (proof-term-at formula 2))
      (child (list *h2-tail-recursion-next* initial))
      (n (list *h2-tail-recursion-choose* initial))
      (m (list *h2-tail-recursion-choose* child))
      (test (list *h2-tail-recursion-test* initial))
      (start (proof-proof-unfold logic (list *h2-tail-recursion-run* initial)))
      (next-run (proof-proof-unfold logic (list *h2-tail-recursion-run* child)))
      (here (h2-tail-recursion-reached initial n))
      (there (h2-tail-recursion-reached child m))
      (stopped (proof-proof-assume logic test t))
      (continuing (proof-proof-assume logic test nil))
      (at-zero (h2-ordinals-derive proof
                                  (proof-eq (list *h2-tail-recursion-iterate* initial *proof-zero*) initial)
                                  "DEFPUN-STN ZP" nil nil 80))
      (proof (cdr at-zero))
      (library (h2-modular-library proof))
      (logic (library-library-proof library))
      (reach-at-zero (library-library-transport-argument library stopped (car at-zero) 1))
      (chosen (h2-tail-recursion-choose-bound proof reach-at-zero))
      (start-chosen (h2-ordinals-select-body proof start chosen))
      (stops (h2-tail-recursion-stops-early proof initial n stopped))
      (stopped-result (proof-proof-select logic result stopped))
      (stopped-result (proof-proof-symmetric logic stopped-result))
      (yes (proof-proof-chain logic start-chosen (list stops stopped-result)))
      (found (proof-proof-assume logic here t))
      (index (h2-tail-recursion-positive-bound proof found continuing))
      (first-end (h2-tail-recursion-step-end proof found index))
      (second-end (h2-tail-recursion-choose-bound proof first-end))
      (first-bound (h2-modular-first-at first-end '(1 2)))
      (synchronized (h2-tail-recursion-synchronized-evaluation proof))
      (name (car synchronized))
      (proof (cdr synchronized))
      (logic (h2-modular-proof proof))
      (same (proof-proof-fact logic name
                               (list (list *library-x* child)
                                     (list *h2-tail-recursion-n* first-bound)
                                     (list *h2-tail-recursion-m* m))))
      (premise (h2-modular-first-at same '(1)))
      (both (proof-proof-prove logic premise (list first-end second-end) nil))
      (agreement (proof-proof-modus-ponens logic same both))
      (next-value (h2-ordinals-select-body proof next-run second-end))
      (found-start (h2-ordinals-select-body proof start found))
      (continuing-value (h2-tail-recursion-evaluation-branch proof initial n index continuing))
      (reverse-next (proof-proof-symmetric logic next-value))
      (on-hit (proof-proof-chain logic found-start (list continuing-value agreement reverse-next)))
      (missing (proof-proof-assume logic here nil))
      (other (proof-proof-assume logic there t))
      (prepended (h2-tail-recursion-prepend-transition proof initial other))
      (proof (cdr prepended))
      (logic (h2-modular-proof proof))
      (from-child (h2-tail-recursion-choose-bound proof (car prepended)))
      (conflict (proof-proof-cut logic from-child missing))
      (neither (proof-proof-front logic conflict (proof-neg there)))
      (missing-start (h2-ordinals-select-body proof start missing))
      (missing-next (h2-ordinals-select-body proof next-run neither))
      (missing-next (proof-proof-symmetric logic missing-next))
      (on-miss (proof-proof-chain logic missing-start (list missing-next)))
      (child-cases (proof-proof-cases logic here on-hit on-miss))
      (continuing-result (proof-proof-select logic result continuing))
      (continuing-result (proof-proof-symmetric logic continuing-result))
      (no (proof-proof-chain logic child-cases (list continuing-result)))
      (step (proof-proof-cases logic test yes no)))
     (cons step proof))))
