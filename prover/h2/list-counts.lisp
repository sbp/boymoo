      (h2-list-counts-sum-counts proof formula operation)))
   ((equal label "DUPLICITY-OF-REV") (h2-list-counts-rev-count proof formula))
   ((equal label "DUPLICITY-OF-REVERSE") (h2-list-counts-reverse-count proof formula))
   ((equal label "DUPLICITY-WHEN-NON-MEMBER-EQUAL") (h2-list-counts-member-count proof formula nil))
   ((equal label "DUPLICITY-WHEN-MEMBER-EQUAL") (h2-list-counts-member-count proof formula t))
   ((equal label "DUPLICITY-ZERO-TO-MEMBER-EQUAL") (h2-list-counts-count-zero-iff proof formula))
   ((equal label "NO-DUPLICATESP-EQUAL-WHEN-HIGH-DUPLICITY") (h2-list-counts-high-count proof formula))
   ((equal label "DUPLICITY-OF-FLATTEN-OF-REV") (h2-list-counts-flatten-count proof formula))
   (t (cons nil proof))))
