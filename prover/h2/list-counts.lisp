(in-package "BOYMOO-PROVER")

(set-verify-guards-eagerness 0)

(defconst *h2-list-counts-duplicity* (proof-sym "DUPLICITY" "ACL2"))
(defconst *h2-list-counts-append* (proof-sym "BINARY-APPEND" "ACL2"))
(defconst *h2-list-counts-fix* (proof-sym "TRUE-LIST-FIX" "ACL2"))
(defconst *h2-list-counts-flatten* (proof-sym "FLATTEN" "ACL2"))
(defconst *h2-list-counts-a* (proof-sym "A" "ACL2"))
(defconst *h2-list-counts-b* (proof-sym "B" "ACL2"))
(defconst *h2-list-counts-revappend* (proof-cl "REVAPPEND"))
(defconst *h2-list-counts-stringp* (proof-cl "STRINGP"))

(defmacro h2-list-counts-inherited (method proof &rest args)
  `(,method (h2-book-logic-proof ,proof) ,@args))

(defmacro h2-list-counts-library-call (method proof &rest args)
  `(,method (h2-search-search-library ,proof) ,@args))

(defmacro h2-list-counts-after-update (proof update body)
  `(let ((h2-list-counts-update ,update))
     (cond ((h2-book-logic-stop-p h2-list-counts-update)
            (cons h2-list-counts-update ,proof))
           ((h2-book-logic-stop-p (car h2-list-counts-update)) h2-list-counts-update)
           (t (let ((,proof (cdr h2-list-counts-update))) ,body)))))

(defun h2-list-counts-first-at (step index)
  (proof-with-checked-results ((literal (proof-step-first step)))
    (proof-term-at literal index)))

(defun h2-list-counts-arguments (term size)
  (if (integerp term)
      '(:failure "failure" "")
    (proof-list-of-length (cdr term) size)))

(defun h2-list-counts-has-fact (proof name)
  (if (assoc-equal name (h2-list-counts-inherited proof-proof-facts proof)) t nil))

(defun h2-list-counts-add-lemma (proof name formula step)
  (h2-book-logic-add-lemma proof name formula step nil))

(defun h2-list-counts-derive (proof formula definitions facts variable repeat seeds)
  (h2-book-logic-derive proof formula definitions facts variable 1 repeat seeds nil 80))

(defun h2-list-counts-hypothesis (proof decrease formula bindings)
  (proof-with-checked-results
      ((literal (proof-step-first decrease))
       (instance (proof-subst formula (proof-bindings-table bindings nil))))
    (h2-list-counts-inherited proof-proof-assume proof
                              (proof-ite literal instance *proof-true*) t)))

(defun h2-list-counts-list-branch (proof call shape cons-p)
  (h2-book-logic-with-results proof
      ((opening (h2-book-logic-logical-equation proof call))
       (body (h2-list-counts-first-at opening 2))
       (test (proof-term-at body 1))
       (head (proof-term-at test 0))
       ((evidence proof)
        (if (equal head *proof-consp*)
            (cons shape proof)
          (h2-list-counts-derive proof (if cons-p (proof-neg test) test)
                                  "" nil nil "" (list shape)))))
    (cons (h2-book-logic-select-body proof opening evidence) proof)))

(defun h2-list-counts-count-call (key data)
  (list *h2-list-counts-duplicity* key data))

(defun h2-list-counts-count-case (proof opening evidence)
  (h2-book-logic-with-results proof
      ((body (h2-list-counts-first-at opening 2))
       (required (proof-term-at body 1))
       (head (h2-list-counts-first-at evidence 0))
       ((fact proof)
        (h2-list-counts-derive proof (if (equal head *proof-not*) (proof-neg required) required)
                                "" nil nil "" (list evidence))))
    (cons (h2-book-logic-select-body proof opening fact) proof)))

(defun h2-list-counts-cons-count (proof key head tail)
  (h2-list-counts-inherited proof-proof-fact proof (proof-sym "DUPLICITY-OF-CONS" "ACL2")
                            (list (list *h2-list-counts-a* key) (list *h2-list-counts-b* head)
                                  (list *library-x* tail))))

(defun h2-list-counts-append-count (proof key first second)
  (h2-list-counts-inherited proof-proof-fact proof (proof-sym "DUPLICITY-OF-APPEND" "ACL2")
                            (list (list *h2-list-counts-a* key) (list *library-x* first)
                                  (list *library-y* second))))

(defun h2-list-counts-natural-lemma (proof)
  (let* ((x *library-x*)
         (count (h2-list-counts-count-call *h2-list-counts-a* x))
         (formula (list *library-natp* count))
         (test (list *proof-consp* x))
         (updates (list (list x (list *library-cdr* x)))))
    (h2-book-logic-with-results proof
        ((cons-step (h2-list-counts-inherited proof-proof-assume proof test t))
         (noncons (h2-list-counts-inherited proof-proof-assume proof test nil))
         (zero-type (h2-list-counts-library-call library-library-natural proof *proof-zero*))
         ((empty proof) (h2-list-counts-list-branch proof count noncons nil))
         (zero (h2-list-counts-library-call library-library-transport-argument proof zero-type empty 1))
         ((opened proof) (h2-list-counts-list-branch proof count cons-step t))
         (body (h2-list-counts-first-at opened 2))
         (same (proof-term-at body 1))
         (builtin (h2-list-counts-library-call library-library-builtin proof 3 x))
         (decrease (h2-list-counts-inherited proof-proof-discharge proof builtin cons-step))
         (hypothesis (h2-list-counts-hypothesis proof decrease formula updates))
         (inner (h2-list-counts-inherited proof-proof-prove-if proof hypothesis decrease))
         (inner-count (h2-list-counts-first-at inner 1))
         (one-type (h2-list-counts-library-call library-library-natural proof *proof-one*))
         (plus-one (h2-list-counts-library-call library-library-cite proof "NATURAL-SUM"
                                               (list *proof-one* inner-count) (list one-type inner)))
         (matching (h2-list-counts-inherited proof-proof-assume proof same t))
         (selected (h2-book-logic-select-body proof opened matching))
         (yes (h2-list-counts-library-call library-library-transport-argument proof plus-one selected 1))
         (different (h2-list-counts-inherited proof-proof-assume proof same nil))
         (selected (h2-book-logic-select-body proof opened different))
         (no (h2-list-counts-library-call library-library-transport-argument proof inner selected 1))
         (branches (h2-list-counts-inherited proof-proof-cases proof same yes no))
         (branches (h2-list-counts-inherited proof-proof-cases proof test branches zero))
         (ordinal (h2-list-counts-library-call library-library-builtin proof 1 x))
         (result (h2-list-counts-inherited proof-proof-induct proof ordinal branches formula
                                           (list *library-count* x) (list updates)))
         (proof (h2-list-counts-add-lemma proof "H2-DUPLICITY-NATURAL" formula result)))
      (cons nil proof))))

(defun h2-list-counts-natural-count (proof key data)
  (let ((name (proof-sym "SELF-H2-DUPLICITY-NATURAL" "ACL2")))
    (h2-list-counts-after-update proof
        (if (h2-list-counts-has-fact proof name)
            (cons nil proof)
          (h2-list-counts-natural-lemma proof))
      (cons (h2-list-counts-inherited proof-proof-fact proof name
                                     (list (list *h2-list-counts-a* key) (list *library-x* data)))
            proof))))

(defun h2-list-counts-count-integer (proof key data)
  (let ((call (h2-list-counts-count-call key data)))
    (h2-book-logic-with-results proof
        (((natural proof) (h2-list-counts-natural-count proof key data)))
      (cons (h2-list-counts-library-call library-library-cite proof "NATURAL-INTEGER"
                                        (list call) (list natural))
            proof))))

(defun h2-list-counts-accumulator-branch
    (proof holds cmp output active counted data tail initial natural decrease formula term types)
  (h2-book-logic-with-results proof
      ((comparison (h2-list-counts-inherited proof-proof-assume proof cmp holds))
       (output-branch (proof-term-at output 3))
       (value (h2-list-counts-inherited proof-proof-select proof output-branch comparison))
       (selected-run (h2-list-counts-inherited proof-proof-rewrite proof active value '(1 2 3)))
       (next-initial (h2-list-counts-first-at value 2))
       (bindings (if holds (list (list data tail) (list initial next-initial))
                   (list (list data tail))))
       (hypothesis (h2-list-counts-hypothesis proof decrease formula bindings))
       (child (h2-list-counts-inherited proof-proof-prove-if proof hypothesis decrease))
       (next-natural
        (if holds
            (proof-with-checked-results
                ((one-type (h2-list-counts-library-call library-library-natural proof *proof-one*)))
              (h2-list-counts-library-call library-library-cite proof "NATURAL-SUM"
                                           (list *proof-one* initial) (list one-type natural)))
          natural))
       (smaller (h2-list-counts-inherited proof-proof-modus-ponens proof child next-natural))
       (evaluated (h2-list-counts-inherited proof-proof-chain proof selected-run (list smaller)))
       ((logical proof) (h2-list-counts-count-case proof counted comparison))
       (target (h2-list-counts-inherited proof-proof-reflexive proof term))
       (target (h2-list-counts-inherited proof-proof-rewrite proof target logical '(1 2 1)))
       (left (h2-list-counts-first-at evaluated 2))
       (right (h2-list-counts-first-at target 2))
       (aligned (h2-list-counts-library-call library-library-linear-equal proof left right types))
       (inverse (h2-list-counts-inherited proof-proof-symmetric proof target))
       (branch (h2-list-counts-inherited proof-proof-chain proof evaluated (list aligned inverse))))
    (cons (list branch bindings) proof)))

(defun h2-list-counts-accumulator-count (proof formula)
  (h2-book-logic-with-results proof
      ((parts (h2-list-counts-arguments formula 2))
       (guard (car parts))
       (goal (cadr parts))
       (run (proof-term-at goal 1))
       (arguments (h2-list-counts-arguments run 3))
       (key (car arguments))
       (data (cadr arguments))
       (initial (caddr arguments))
       (term (proof-term-at goal 2))
       (count (proof-term-at term 1))
       (natural (h2-list-counts-inherited proof-proof-assume proof guard t))
       (typed (h2-list-counts-library-call library-library-cite proof "NATURAL-INTEGER"
                                          (list initial) (list natural)))
       (test (list *proof-consp* data))
       (cons-step (h2-list-counts-inherited proof-proof-assume proof test t))
       (noncons (h2-list-counts-inherited proof-proof-assume proof test nil))
       ((stop proof) (h2-list-counts-list-branch proof run noncons nil))
       ((zero proof) (h2-list-counts-list-branch proof count noncons nil))
       (view (h2-list-counts-inherited proof-proof-reflexive proof term))
       (view (h2-list-counts-inherited proof-proof-rewrite proof view zero '(1 2 1)))
       (zero-add (h2-list-counts-library-call library-library-cite proof "ADD-ZERO-LEFT"
                                             (list initial) (list typed)))
       (empty (h2-list-counts-inherited proof-proof-chain proof view (list zero-add)))
       (inverse (h2-list-counts-inherited proof-proof-symmetric proof empty))
       (no (h2-list-counts-inherited proof-proof-chain proof stop (list inverse)))
       ((active proof) (h2-list-counts-list-branch proof run cons-step t))
       ((counted proof) (h2-list-counts-list-branch proof count cons-step t))
       (output (h2-list-counts-first-at active 2))
       (output-branch (proof-term-at output 3))
       (cmp (proof-term-at output-branch 1))
       (tail (proof-term-at output 2))
       (builtin (h2-list-counts-library-call library-library-builtin proof 3 data))
       (decrease (h2-list-counts-inherited proof-proof-discharge proof builtin cons-step))
       ((tail-type proof) (h2-list-counts-count-integer proof key tail))
       (types (list tail-type typed))
       ((match proof) (h2-list-counts-accumulator-branch proof t cmp output active counted
                                                        data tail initial natural decrease formula term types))
       ((miss proof) (h2-list-counts-accumulator-branch proof nil cmp output active counted
                                                       data tail initial natural decrease formula term types))
       (yes (h2-list-counts-inherited proof-proof-cases proof cmp (car match) (car miss)))
       (branches (h2-list-counts-inherited proof-proof-cases proof test yes no))
       (case-step (h2-search-search-introduce proof formula branches))
       (ordinal (h2-list-counts-library-call library-library-builtin proof 1 data)))
    (cons (h2-list-counts-inherited proof-proof-induct proof ordinal case-step formula
                                   (list *library-count* data) (list (cadr match) (cadr miss)))
          proof)))

(defun h2-list-counts-sum-counts-left (proof operation left comparison induction key head second)
  (if (equal operation *h2-list-counts-append*)
      (h2-book-logic-with-results proof
          (((selected proof) (h2-list-counts-count-case proof left comparison))
           (template (proof-step-first selected))
           (slot (h2-list-counts-first-at induction 1)))
        (cons (h2-list-counts-inherited proof-proof-rewrite-result proof selected induction template slot)
              proof))
    (h2-book-logic-with-results proof
        ((extra (h2-list-counts-cons-count proof key head second))
         ((equation proof) (h2-list-counts-count-case proof extra comparison)))
      (cons (h2-list-counts-inherited proof-proof-rewrite proof left equation '(1 2 2)) proof))))

(defun h2-list-counts-sum-counts-branch
    (proof holds cmp operation left induction key head second right-count total types)
  (h2-book-logic-with-results proof
      ((comparison (h2-list-counts-inherited proof-proof-assume proof cmp holds))
       ((selected proof)
        (h2-list-counts-sum-counts-left proof operation left comparison induction key head second))
       (target-count (h2-book-logic-select-body proof right-count comparison))
       (right (h2-list-counts-inherited proof-proof-reflexive proof total))
       (right (h2-list-counts-inherited proof-proof-rewrite proof right target-count '(1 2 1)))
       (left-value (h2-list-counts-first-at selected 2))
       (right-value (h2-list-counts-first-at right 2))
       (aligned (h2-list-counts-library-call library-library-linear-equal proof
                                             left-value right-value types))
       (inverse (h2-list-counts-inherited proof-proof-symmetric proof right)))
    (cons (h2-list-counts-inherited proof-proof-chain proof selected (list aligned inverse)) proof)))

(defun h2-list-counts-sum-counts (proof formula operation)
  (h2-book-logic-with-results proof
      ((parts (h2-list-counts-arguments formula 2))
       (counted (car parts))
       (total (cadr parts))
       (arguments (h2-list-counts-arguments counted 2))
       (key (car arguments))
       (combined (cadr arguments))
       (lists (h2-list-counts-arguments combined 2))
       (first (car lists))
       (second (cadr lists))
       (left-count (h2-list-counts-count-call key first))
       (test (list *proof-consp* first))
       (cons-step (h2-list-counts-inherited proof-proof-assume proof test t))
       (noncons (h2-list-counts-inherited proof-proof-assume proof test nil))
       (opened (h2-list-counts-inherited proof-proof-reflexive proof counted))
       ((base proof) (h2-list-counts-list-branch proof combined noncons nil))
       (opened (h2-list-counts-inherited proof-proof-rewrite proof opened base '(1 2 2)))
       (empty (h2-list-counts-inherited proof-proof-reflexive proof total))
       ((base proof) (h2-list-counts-list-branch proof left-count noncons nil))
       (empty (h2-list-counts-inherited proof-proof-rewrite proof empty base '(1 2 1)))
       ((typed proof) (h2-list-counts-count-integer proof key second))
       (add-zero (h2-list-counts-library-call library-library-cite proof "ADD-ZERO-LEFT"
                                             (list (h2-list-counts-count-call key second)) (list typed)))
       (empty (h2-list-counts-inherited proof-proof-chain proof empty (list add-zero)))
       (inverse (h2-list-counts-inherited proof-proof-symmetric proof empty))
       (no (h2-list-counts-inherited proof-proof-chain proof opened (list inverse)))
       ((active proof) (h2-list-counts-list-branch proof combined cons-step t))
       (head (list *library-car* first))
       (tail (list *library-cdr* first))
       (recursive (if (equal operation *h2-list-counts-revappend*)
                      (list (list first tail) (list second (list *proof-cons* head second)))
                    (list (list first tail))))
       (builtin (h2-list-counts-library-call library-library-builtin proof 3 first))
       (decrease (h2-list-counts-inherited proof-proof-discharge proof builtin cons-step))
       (smaller (h2-list-counts-hypothesis proof decrease formula recursive))
       (induction (h2-list-counts-inherited proof-proof-prove-if proof smaller decrease))
       (left (h2-list-counts-inherited proof-proof-reflexive proof counted))
       (left (h2-list-counts-inherited proof-proof-rewrite proof left active '(1 2 2)))
       (left
        (if (equal operation *h2-list-counts-append*)
            (proof-with-checked-results
                ((body (h2-list-counts-first-at active 2))
                 (rest (proof-term-at body 2))
                 (equation (h2-list-counts-cons-count proof key head rest)))
              (h2-list-counts-inherited proof-proof-chain proof left (list equation)))
          (h2-list-counts-inherited proof-proof-chain proof left (list induction))))
       ((right-count proof) (h2-list-counts-list-branch proof left-count cons-step t))
       (body (h2-list-counts-first-at right-count 2))
       (cmp (proof-term-at body 1))
       ((tail-type proof) (h2-list-counts-count-integer proof key tail))
       ((second-type proof) (h2-list-counts-count-integer proof key second))
       (types (list tail-type second-type))
       ((match proof) (h2-list-counts-sum-counts-branch proof t cmp operation left induction
                                                       key head second right-count total types))
       ((miss proof) (h2-list-counts-sum-counts-branch proof nil cmp operation left induction
                                                      key head second right-count total types))
       (yes (h2-list-counts-inherited proof-proof-cases proof cmp match miss))
       (ordinal (h2-list-counts-library-call library-library-builtin proof 1 first))
       (branches (h2-list-counts-inherited proof-proof-cases proof test yes no)))
    (cons (h2-list-counts-inherited proof-proof-induct proof ordinal branches formula
                                   (list *library-count* first) (list recursive)) proof)))

(defun h2-list-counts-count-fixed-list-branch (proof holds cmp opened child active)
  (h2-book-logic-with-results proof
      ((comparison (h2-list-counts-inherited proof-proof-assume proof cmp holds))
       ((branch proof) (h2-list-counts-count-case proof opened comparison))
       (template (proof-step-first branch))
       (slot (h2-list-counts-first-at child 1))
       (branch (h2-list-counts-inherited proof-proof-rewrite-result proof branch child template slot))
       (target (h2-book-logic-select-body proof active comparison))
       (inverse (h2-list-counts-inherited proof-proof-symmetric proof target)))
    (cons (h2-list-counts-inherited proof-proof-chain proof branch (list inverse)) proof)))

(defun h2-list-counts-count-fixed-list (proof formula)
  (h2-book-logic-with-results proof
      ((parts (h2-list-counts-arguments formula 2))
       (left (car parts))
       (right (cadr parts))
       (args (h2-list-counts-arguments left 2))
       (key (car args))
       (fixed (cadr args))
       (data (proof-term-at fixed 1))
       (test (list *proof-consp* data))
       (cons-step (h2-list-counts-inherited proof-proof-assume proof test t))
       (noncons (h2-list-counts-inherited proof-proof-assume proof test nil))
       (opening (h2-book-logic-logical-equation proof fixed))
       (base (h2-list-counts-inherited proof-proof-reflexive proof left))
       (empty-fixed (h2-book-logic-select-body proof opening noncons))
       (base (h2-list-counts-inherited proof-proof-rewrite proof base empty-fixed '(1 2 2)))
       (value (h2-list-counts-first-at base 2))
       ((zero proof) (h2-list-counts-derive proof (proof-eq value *proof-zero*) "DUPLICITY" nil nil "" nil))
       ((empty proof) (h2-list-counts-list-branch proof right noncons nil))
       (inverse (h2-list-counts-inherited proof-proof-symmetric proof empty))
       (no (h2-list-counts-inherited proof-proof-chain proof base (list zero inverse)))
       (head (list *library-car* data))
       (tail (list *library-cdr* data))
       (rest (list *h2-list-counts-fix* tail))
       (opened (h2-list-counts-inherited proof-proof-reflexive proof left))
       (selected (h2-book-logic-select-body proof opening cons-step))
       (opened (h2-list-counts-inherited proof-proof-rewrite proof opened selected '(1 2 2)))
       (count-cons (h2-list-counts-cons-count proof key head rest))
       (opened (h2-list-counts-inherited proof-proof-chain proof opened (list count-cons)))
       ((active proof) (h2-list-counts-list-branch proof right cons-step t))
       (body (h2-list-counts-first-at active 2))
       (cmp (proof-term-at body 1))
       (updates (list (list data tail)))
       (builtin (h2-list-counts-library-call library-library-builtin proof 3 data))
       (decrease (h2-list-counts-inherited proof-proof-discharge proof builtin cons-step))
       (hypothesis (h2-list-counts-hypothesis proof decrease formula updates))
       (child (h2-list-counts-inherited proof-proof-prove-if proof hypothesis decrease))
       ((match proof) (h2-list-counts-count-fixed-list-branch proof t cmp opened child active))
       ((miss proof) (h2-list-counts-count-fixed-list-branch proof nil cmp opened child active))
       (yes (h2-list-counts-inherited proof-proof-cases proof cmp match miss))
       (ordinal (h2-list-counts-library-call library-library-builtin proof 1 data))
       (branches (h2-list-counts-inherited proof-proof-cases proof test yes no)))
    (cons (h2-list-counts-inherited proof-proof-induct proof ordinal branches formula
                                   (list *library-count* data) (list updates)) proof)))

(defun h2-list-counts-member-count-empty (proof present member count noncons premise goal)
  (if present
      (h2-book-logic-with-results proof
          (((missing proof) (h2-list-counts-list-branch proof member noncons nil))
           (conflict (h2-list-counts-inherited proof-proof-rewrite proof premise missing '(1)))
           (conflict (h2-list-counts-inherited proof-proof-tidy proof conflict)))
        (cons (h2-list-counts-inherited proof-proof-subsume proof conflict
                                       (cons goal (proof-step-clause conflict))) proof))
    (h2-list-counts-list-branch proof count noncons nil)))

(defun h2-list-counts-member-count-hit
    (proof present key data member-branch count-branch match-head guard cons-step goal)
  (if present
      (let* ((tail (list *library-cdr* data))
             (tail-count (h2-list-counts-count-call key tail)))
        (h2-book-logic-with-results proof
            (((natural proof) (h2-list-counts-natural-count proof key tail))
             (bounds (h2-list-counts-library-call library-library-cite proof "NATURAL-NONNEGATIVE"
                                                 (list tail-count) (list natural)))
             (typed (h2-list-counts-library-call library-library-cite proof "NATURAL-INTEGER"
                                                (list tail-count) (list natural)))
             (nonzero (h2-list-counts-library-call library-library-cite proof "POSITIVE-ONE-PLUS"
                                                  (list tail-count) (list typed bounds)))
             ((equation proof) (h2-list-counts-count-case proof count-branch match-head)))
          (cons (h2-list-counts-library-call library-library-transport-argument proof nonzero equation 2)
                proof)))
    (h2-book-logic-with-results proof
        ((selected (h2-book-logic-select-body proof member-branch match-head))
         (nonnil (h2-list-counts-library-call library-library-cite proof "H2-CONSP-NONNIL"
                                             (list data) (list cons-step)))
         (found (h2-list-counts-inherited proof-proof-transport proof nonnil selected))
         (opening (h2-list-counts-inherited proof-proof-unfold proof guard))
         (denied (h2-book-logic-select-body proof opening found))
         (not-nil (h2-list-counts-inherited proof-proof-not-nil proof))
         (conflict (h2-list-counts-library-call library-library-transport-argument proof not-nil denied 1)))
