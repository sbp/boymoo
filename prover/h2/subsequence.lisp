(in-package "BOYMOO-PROVER")
(set-verify-guards-eagerness 0)

(defconst *h2-subsequence-take* (proof-sym "TAKE" "ACL2"))
(defconst *h2-subsequence-zp* (proof-sym "ZP" "ACL2"))
(defconst *h2-subsequence-posp* (proof-sym "POSP" "ACL2"))
(defconst *h2-subsequence-fix* (proof-sym "TRUE-LIST-FIX" "ACL2"))
(defconst *h2-subsequence-nfix* (proof-sym "NFIX" "ACL2"))
(defconst *h2-subsequence-iff* (proof-sym "IFF" "ACL2"))
(defconst *h2-subsequence-nthcdr* (proof-cl "NTHCDR"))

(defun h2-subsequence-open-body (proof opening)
  (h2-recipes-with-results
   ((term (h2-modular-first-at opening '(2)))
    (unwrapped (h2-search-search-remove-wrappers (h2-recipes-recipes-search proof) term)))
   (proof-proof-chain (h2-modular-proof proof) opening (list unwrapped))))

(defun h2-subsequence-auxiliary (proof name formula definitions facts)
  (h2-recipes-recipes-auxiliary proof name formula definitions facts nil 1 "" nil nil 80))

(defun h2-subsequence-take-length (proof)
  (let ((name "SELF-H2-LEN-OF-TAKE"))
    (if (h2-ordinals-has-fact proof (proof-sym name "ACL2"))
        (cons name proof)
      (let* ((x *library-x*)
             (y *library-y*)
             (take-term (list *h2-subsequence-take* x y))
             (fixed (list *h2-subsequence-nfix* x))
             (length (list *library-len* take-term))
             (formula (proof-eq length fixed))
             (logic (h2-modular-proof proof)))
        (h2-recipes-with-results
         ((opening (proof-proof-unfold logic take-term))
          (opening (h2-subsequence-open-body proof opening))
          (test (h2-modular-first-at opening '(2 1)))
          (zero (proof-proof-assume logic test t))
          (nonzero (proof-proof-assume logic test nil))
          (base (h2-ordinals-select-body proof opening zero))
          (nil-length (h2-ordinals-derive proof (proof-eq (list *library-len* *proof-false*) *proof-zero*)
                                          "LEN" nil nil 80))
          (proof (cdr nil-length))
          (library (h2-modular-library proof))
          (logic (library-library-proof library))
          (reverse-base (proof-proof-symmetric logic base))
          (length-zero (proof-proof-rewrite logic (car nil-length) reverse-base '(1 1 1)))
          (fix-when-zp (library-library-axiom library "SELF-H2-NFIX-WHEN-ZP" (list x)))
          (fix-zero (proof-proof-modus-ponens logic fix-when-zp zero))
          (fix-zero (proof-proof-symmetric logic fix-zero))
          (yes (proof-proof-chain logic length-zero (list fix-zero)))
          (step (h2-ordinals-select-body proof opening nonzero))
          (body (h2-modular-first-at step '(2)))
          (body-parts (proof-list-of-length body 3))
          (head (cadr body-parts))
          (child (caddr body-parts))
          (args (h2-modular-tail-of-size child 2))
          (predecessor (car args))
          (tail (cadr args))
          (substitution (list (list x predecessor) (list y tail)))
          (builtin (library-library-builtin library 9 x))
          (descent (proof-proof-discharge logic builtin nonzero))
          (less (proof-step-first descent))
          (smaller (proof-subst formula (list (cons x predecessor) (cons y tail))))
          (hypothesis (proof-proof-assume logic (proof-ite less smaller *proof-true*) t))
          (smaller (proof-proof-prove-if logic hypothesis descent))
          (length-cons
           (h2-subsequence-auxiliary
            proof "LEN-OF-CONS"
            (proof-eq (list *library-len* (list *proof-cons* x y))
                      (library-plus *proof-one* (list *library-len* y)))
            "LEN" nil))
          (length-cons-name (car length-cons))
          (proof (cdr length-cons))
          (library (h2-modular-library proof))
          (logic (library-library-proof library))
          (length-add (library-library-axiom library length-cons-name (list head child)))
          (lifted (proof-proof-rewrite logic length-add smaller '(1 2 2)))
          (fix-child (library-library-axiom library "SELF-H2-NFIX-PREDECESSOR" (list x)))
          (fixed-child (proof-proof-modus-ponens logic fix-child nonzero))
          (lifted (proof-proof-rewrite logic lifted fixed-child '(1 2 2)))
          (typed (library-library-cite library "H2-POSITIVE-INDEX-INTEGER" (list x) (list nonzero)))
          (fix-parent (library-library-axiom library "SELF-H2-NFIX-WHEN-NOT-ZP" (list x)))
          (fixed-parent (proof-proof-modus-ponens logic fix-parent nonzero))
          (cancel (library-library-cite library "H2-SUB1-ADD1" (list x) (list typed)))
          (fixed-parent (proof-proof-symmetric logic fixed-parent))
          (no (proof-proof-chain logic lifted (list cancel fixed-parent)))
          (reverse-step (proof-proof-symmetric logic step))
          (no (proof-proof-rewrite logic no reverse-step '(1 1 1)))
          (ordinal (library-library-builtin library 1 x))
          (cases (proof-proof-cases logic test yes no))
          (induction (proof-proof-induct logic ordinal cases formula (list *library-count* x)
                                         (list substitution)))
          (proof (h2-recipes-lemma proof "H2-LEN-OF-TAKE" formula induction nil)))
         (cons name proof))))))

(defun h2-subsequence-list-fix-selectors (proof)
  (let* ((y *library-y*)
         (fixed (list *h2-subsequence-fix* y))
         (tail (list *h2-subsequence-fix* (list *library-cdr* y))))
    (h2-recipes-with-results
     ((head (h2-subsequence-auxiliary proof "CAR-OF-LIST-FIX"
                                      (proof-eq (list *library-car* fixed) (list *library-car* y))
                                      "TRUE-LIST-FIX" nil))
      (head-name (car head))
      (rest (h2-ordinals-folded-recipe (cdr head) (list tail) "CDR-OF-LIST-FIX"
                                       (proof-eq (list *library-cdr* fixed) tail)
                                       "TRUE-LIST-FIX" nil nil 80))
      (rest-name (car rest)))
     (cons (list head-name rest-name) (cdr rest)))))

(defun h2-subsequence-add-take-of-list-fix (proof name take-term tail facts)
  (if (h2-ordinals-has-fact proof (proof-sym name "ACL2"))
      proof
    (h2-recipes-with-results
     ((induction (h2-recipes-recipes-index-induction
                  proof take-term "X" "TAKE" facts (list (list *library-y* tail))
                  (list (list *h2-subsequence-zp* *library-x*))))
      (step (car induction)))
     (h2-recipes-lemma (cdr induction) "H2-TAKE-OF-LIST-FIX" take-term step nil))))

(defun h2-subsequence-add-nthcdr-of-list-fix (proof name nthcdr tail rest)
  (if (h2-ordinals-has-fact proof (proof-sym name "ACL2"))
      proof
    (h2-recipes-with-results
     ((proof (h2-recipes-recipes-set-rules proof "NTHCDR" (list rest "built-in-clause-8") "" 80))
      (x *library-x*)
      (updates (list (list x (library-plus x *proof-neg-one*)) (list *library-y* tail)))
      (ordinal (library-library-builtin (h2-modular-library proof) 1 x))
      (induction (h2-ordinals-search proof :induction
                                    (list nthcdr (list *library-count* x) (list updates)
                                          ordinal (list (list *h2-subsequence-zp* x))))))
     (h2-recipes-lemma (cdr induction) "H2-NTHCDR-OF-LIST-FIX" nthcdr (car induction) nil))))

(defun h2-subsequence-list-fix-operations (proof)
  (let ((names '("SELF-H2-TAKE-OF-LIST-FIX" "SELF-H2-NTHCDR-OF-LIST-FIX")))
    (if (and (h2-ordinals-has-fact proof (proof-sym (car names) "ACL2"))
             (h2-ordinals-has-fact proof (proof-sym (cadr names) "ACL2")))
        (cons names proof)
      (let* ((x *library-x*)
             (y *library-y*)
             (fixed (list *h2-subsequence-fix* y))
             (tail (list *library-cdr* y)))
        (h2-recipes-with-results
         ((selectors (h2-subsequence-list-fix-selectors proof))
          (facts (car selectors))
          (take-term (proof-eq (list *h2-subsequence-take* x fixed) (list *h2-subsequence-take* x y)))
          (proof (h2-subsequence-add-take-of-list-fix (cdr selectors) (car names) take-term tail facts))
          (nthcdr (proof-eq (list *h2-subsequence-nthcdr* x fixed)
                            (list *h2-subsequence-fix* (list *h2-subsequence-nthcdr* x y))))
          (proof (h2-subsequence-add-nthcdr-of-list-fix proof (cadr names) nthcdr tail (cadr facts))))
         (cons names proof))))))

(defun h2-subsequence-take-whole (proof)
  (let ((name "SELF-H2-TAKE-WHOLE-LIST"))
    (if (h2-ordinals-has-fact proof (proof-sym name "ACL2"))
        (cons name proof)
      (let* ((x *library-x*)
             (length (list *library-len* x))
             (tail (list *library-cdr* x))
             (take-term (list *h2-subsequence-take* length x))
             (fixed (list *h2-subsequence-fix* x))
             (formula (proof-eq take-term fixed))
             (test (list *proof-consp* x))
             (logic (h2-modular-proof proof)))
        (h2-recipes-with-results
         ((cons-step (proof-proof-assume logic test t))
          (noncons (proof-proof-assume logic test nil))
          (facts (h2-ordinals-positive-length proof cons-step))
          (active (h2-ordinals-derive proof (proof-neg (list *h2-subsequence-zp* length))
                                       "ZP" nil facts 80))
          (proof (cdr active))
          (library (h2-modular-library proof))
          (logic (library-library-proof library))
          (take-open (proof-proof-unfold logic take-term))
          (fix-open (proof-proof-unfold logic fixed))
          (take-open (h2-subsequence-open-body proof take-open))
          (fix-open (h2-subsequence-open-body proof fix-open))
          (selected (h2-ordinals-select-body proof take-open (car active)))
          (length-open (proof-proof-unfold logic length))
          (len-cons (h2-ordinals-select-body proof length-open cons-step))
          (selected (proof-proof-rewrite logic selected len-cons '(1 2 2 1 2)))
          (child-length (list *library-len* tail))
          (typed (library-library-type-of library child-length nil))
          (cancel (library-library-cite library "H2-ADD1-SUB1" (list child-length) (list typed)))
          (selected (proof-proof-rewrite logic selected cancel '(1 2 2 1)))
          (updates (list (list x tail)))
          (builtin (library-library-builtin library 3 x))
          (descent (proof-proof-discharge logic builtin cons-step))
          (less (proof-step-first descent))
          (child-formula (proof-subst formula (list (cons x tail))))
          (smaller (proof-proof-assume logic (proof-ite less child-formula *proof-true*) t))
          (smaller (proof-proof-prove-if logic smaller descent))
          (selected (proof-proof-rewrite logic selected smaller '(1 2 2)))
          (fix-cons (h2-ordinals-select-body proof fix-open cons-step))
          (fix-cons (proof-proof-symmetric logic fix-cons))
          (yes (proof-proof-chain logic selected (list fix-cons)))
          (empty (h2-ordinals-derive proof (proof-eq take-term *proof-false*) "LEN TAKE ZP"
                                      nil (list noncons) 80))
          (proof (cdr empty))
          (library (h2-modular-library proof))
          (logic (library-library-proof library))
          (fix-atom (h2-ordinals-select-body proof fix-open noncons))
          (fix-atom (proof-proof-symmetric logic fix-atom))
          (no (proof-proof-chain logic (car empty) (list fix-atom)))
          (ordinal (library-library-builtin library 1 x))
          (cases (proof-proof-cases logic test yes no))
          (result (proof-proof-induct logic ordinal cases formula (list *library-count* x) (list updates)))
          (proof (h2-recipes-lemma proof "H2-TAKE-WHOLE-LIST" formula result nil)))
         (cons name proof))))))

(defun h2-subsequence-nthcdr-nil (proof)
  (let* ((name "SELF-H2-NTHCDR-NIL")
         (x *library-x*)
         (formula (proof-eq (list *h2-subsequence-nthcdr* x *proof-false*) *proof-false*)))
    (if (h2-ordinals-has-fact proof (proof-sym name "ACL2"))
        (cons name proof)
      (h2-recipes-with-results
       ((proof (h2-recipes-recipes-set-rules proof "NTHCDR" '("built-in-clause-8") "" 80))
        (updates (list (list (list x (library-plus x *proof-neg-one*)))))
        (ordinal (library-library-builtin (h2-modular-library proof) 1 x))
        (result (h2-ordinals-search proof :induction
                                    (list formula (list *library-count* x) updates
                                          ordinal (list (list *h2-subsequence-zp* x)))))
        (proof (h2-recipes-lemma (cdr result) "H2-NTHCDR-NIL" formula (car result) nil)))
       (cons name proof)))))

(defun h2-subsequence-nthcdr-length (proof)
  (let ((name "SELF-H2-LEN-OF-NTHCDR"))
    (if (h2-ordinals-has-fact proof (proof-sym name "ACL2"))
        (cons name proof)
      (let* ((x *library-x*)
             (y *library-y*)
             (call (list *h2-subsequence-nthcdr* x y))
             (length (list *library-len* y))
             (lhs (list *library-len* call))
             (rhs (list *h2-subsequence-nfix* (library-diff length (list *h2-subsequence-nfix* x))))
             (formula (proof-eq lhs rhs))
             (test (list *h2-subsequence-zp* x))
             (library (h2-modular-library proof))
             (logic (library-library-proof library)))
        (h2-recipes-with-results
         ((zero (proof-proof-assume logic test t))
          (active (proof-proof-assume logic test nil))
          (opening (proof-proof-unfold logic call))
          (left (proof-proof-reflexive logic lhs))
          (selected (h2-ordinals-select-body proof opening zero))
          (base (proof-proof-rewrite logic left selected '(1 2 1)))
          (fix-when-zp (library-library-axiom library "SELF-H2-NFIX-WHEN-ZP" (list x)))
          (zero-fix (proof-proof-modus-ponens logic fix-when-zp zero))
          (right (proof-proof-reflexive logic rhs))
          (right-zero (proof-proof-rewrite logic right zero-fix '(1 2 1 2 1)))
          (drop-zero (library-library-linear-equal library (library-diff length *proof-zero*) length nil))
          (right-zero (proof-proof-rewrite logic right-zero drop-zero '(1 2 1)))
          (natural (library-library-natural library length))
          (fixed-value (h2-modular-natural-value proof natural))
          (right-zero (proof-proof-chain logic right-zero (list fixed-value)))
          (right-zero (proof-proof-symmetric logic right-zero))
          (yes (proof-proof-chain logic base (list right-zero)))
          (next-call (h2-ordinals-select-body proof opening active))
          (body (h2-modular-first-at next-call '(2)))
          (arguments (h2-modular-tail-of-size body 2))
          (predecessor (car arguments))
          (tail (cadr arguments))
          (typed (library-library-cite library "H2-POSITIVE-INDEX-INTEGER" (list x) (list active)))
          (positive (library-library-cite library "H2-POSITIVE-INDEX-POSITIVE" (list x) (list active)))
          (lower (library-library-cite library "H2-PREDECESSOR-NONNEGATIVE" (list x) (list active)))
          (commuted (library-library-axiom library "COMMUTATIVITY-OF-+" (list *proof-neg-one* x)))
          (lower (proof-proof-rewrite logic lower commuted '(1 1 1)))
          (pre-int (library-library-type-of library predecessor (list typed)))
          (pre-nat (library-library-cite library "NATURAL-FROM-BOUNDS" (list predecessor) (list pre-int lower)))
          (fixed-pred (h2-modular-natural-value proof pre-nat))
          (fix-when-active (library-library-axiom library "SELF-H2-NFIX-WHEN-NOT-ZP" (list x)))
          (parent-fix (proof-proof-modus-ponens logic fix-when-active active))
          (right (proof-proof-reflexive logic rhs))
          (aligned (proof-proof-rewrite logic right parent-fix '(1 2 1 2 1)))
          (left (proof-proof-reflexive logic lhs))
          (shifted (proof-proof-rewrite logic left next-call '(1 2 1)))
          (updates (list (list x predecessor) (list y tail)))
          (builtin (library-library-builtin library 8 x))
          (decrease (proof-proof-discharge logic builtin active))
          (less (proof-step-first decrease))
          (child-formula (proof-subst formula (list (cons x predecessor) (cons y tail))))
          (hypothesis (proof-proof-assume logic (proof-ite less child-formula *proof-true*) t))
          (smaller (proof-proof-prove-if logic hypothesis decrease))
          (cons-test (list *proof-consp* y))
          (cons-step (proof-proof-assume logic cons-test t))
          (noncons (proof-proof-assume logic cons-test nil))
          (on-cons (proof-proof-chain logic shifted (list smaller)))
          (on-cons (proof-proof-rewrite logic on-cons fixed-pred '(1 2 1 2 1)))
          (open-length (proof-proof-unfold logic length))
          (len-cons (h2-ordinals-select-body proof open-length cons-step))
          (raw-span (proof-proof-reflexive logic (library-diff length x)))
          (expanded (proof-proof-rewrite logic raw-span len-cons '(1 2 1)))
          (span (h2-modular-first-at expanded '(2)))
          (rearranged (library-library-linear-equal
                       library (library-diff (list *library-len* tail) predecessor) span (list typed)))
          (back-expanded (proof-proof-symmetric logic expanded))
          (rearranged (proof-proof-chain logic rearranged (list back-expanded)))
          (on-cons (proof-proof-rewrite logic on-cons rearranged '(1 2 1)))
          (back-aligned (proof-proof-symmetric logic aligned))
          (on-cons (proof-proof-chain logic on-cons (list back-aligned)))
          (compound-cdr (library-library-axiom library "COMPLETION-OF-CDR" (list y)))
          (nil-tail (h2-ordinals-select-body proof compound-cdr noncons))
          (on-atom (proof-proof-rewrite logic shifted nil-tail '(1 2 1 2)))
          (nthcdr-nil (h2-subsequence-nthcdr-nil proof))
          (nthcdr-nil-name (car nthcdr-nil))
          (proof (cdr nthcdr-nil))
          (library (h2-modular-library proof))
          (logic (library-library-proof library))
          (drop-nil (library-library-axiom library nthcdr-nil-name (list predecessor)))
          (on-atom (proof-proof-rewrite logic on-atom drop-nil '(1 2 1)))
          (nil-length (h2-ordinals-derive proof (proof-eq (list *library-len* *proof-false*) *proof-zero*)
                                          "LEN" nil nil 80))
          (proof (cdr nil-length))
          (library (h2-modular-library proof))
          (logic (library-library-proof library))
          (on-atom (proof-proof-chain logic on-atom (list (car nil-length))))
          (length-open (proof-proof-unfold logic length))
          (len-atom (h2-ordinals-select-body proof length-open noncons))
          (empty-span (proof-proof-rewrite logic aligned len-atom '(1 2 1 1)))
          (negative (library-library-less-from-difference
                     library (library-diff *proof-zero* x) *proof-zero* positive (list typed)))
          (empty-span-term (h2-modular-first-at empty-span '(2)))
          (span-int (library-library-type-of library (library-diff *proof-zero* x) (list typed)))
          (clipped (h2-ordinals-derive proof (proof-eq empty-span-term *proof-zero*) "NFIX"
                                       nil (list negative span-int) 80))
          (proof (cdr clipped))
          (library (h2-modular-library proof))
          (logic (library-library-proof library))
          (empty-zero (proof-proof-chain logic empty-span (list (car clipped))))
          (empty-zero (proof-proof-symmetric logic empty-zero))
          (on-atom (proof-proof-chain logic on-atom (list empty-zero)))
          (no (proof-proof-cases logic cons-test on-cons on-atom))
          (ordinal (library-library-builtin library 1 x))
          (cases (proof-proof-cases logic test yes no))
          (result (proof-proof-induct logic ordinal cases formula (list *library-count* x) (list updates)))
          (proof (h2-recipes-lemma proof "H2-LEN-OF-NTHCDR" formula result nil)))
         (cons name proof))))))

(defun h2-subsequence-take-with-fixed-count (proof)
  (let ((name "SELF-H2-TAKE-NFIX-COUNT"))
    (if (h2-ordinals-has-fact proof (proof-sym name "ACL2"))
        (cons name proof)
      (let* ((x *library-x*)
             (y *library-y*)
             (take-term (list *h2-subsequence-take* x y))
             (fixed (list *h2-subsequence-take* (list *h2-subsequence-nfix* x) y))
             (formula (proof-eq take-term fixed))
             (test (list *h2-subsequence-zp* x))
             (library (h2-modular-library proof))
             (logic (library-library-proof library)))
        (h2-recipes-with-results
         ((zero (proof-proof-assume logic test t))
          (active (proof-proof-assume logic test nil))
          (fix-when-zp (library-library-axiom library "SELF-H2-NFIX-WHEN-ZP" (list x)))
          (zero-fix (proof-proof-modus-ponens logic fix-when-zp zero))
          (fixed-eq (proof-proof-reflexive logic fixed))
          (counted (proof-proof-rewrite logic fixed-eq zero-fix '(1 2 1)))
          (zero-take (h2-modular-first-at counted '(2)))
          (base (h2-ordinals-derive proof (proof-eq take-term zero-take) "TAKE ZP" nil (list zero) 80))
          (proof (cdr base))
          (library (h2-modular-library proof))
          (logic (library-library-proof library))
          (reverse-counted (proof-proof-symmetric logic counted))
          (yes (proof-proof-chain logic (car base) (list reverse-counted)))
          (fix-when-active (library-library-axiom library "SELF-H2-NFIX-WHEN-NOT-ZP" (list x)))
          (unchanged (proof-proof-modus-ponens logic fix-when-active active))
          (take-eq (proof-proof-reflexive logic take-term))
          (reverse-unchanged (proof-proof-symmetric logic unchanged))
          (no (proof-proof-rewrite logic take-eq reverse-unchanged '(1 2 1)))
          (cases (proof-proof-cases logic test yes no))
          (proof (h2-recipes-lemma proof "H2-TAKE-NFIX-COUNT" formula cases nil)))
         (cons name proof))))))

(defun h2-subsequence-subsequence-of-length (proof formula)
  (let ((logic (h2-modular-proof proof)))
    (h2-recipes-with-results
     ((parts (h2-modular-tail-of-size formula 2))
      (guard-term (car parts))
      (goal (cadr parts))
      (call (proof-term-at goal 1))
      (opening (proof-proof-unfold logic call))
      (body (h2-modular-first-at opening '(2)))
      (arguments (h2-modular-tail-of-size body 2))
      (length (car arguments))
      (tail (cadr arguments))
      (tail-arguments (h2-modular-tail-of-size tail 2))
      (n (car tail-arguments))
      (data (cadr tail-arguments))
      (naturalized (h2-subsequence-take-with-fixed-count proof))
      (fixed-name (car naturalized))
      (proof (cdr naturalized))
      (library (h2-modular-library proof))
      (logic (library-library-proof library))
      (fixed (library-library-axiom library fixed-name (list length tail)))
      (fixed (proof-proof-chain logic opening (list fixed)))
      (nthcdr-length (h2-subsequence-nthcdr-length proof))
      (nthcdr-length-name (car nthcdr-length))
      (proof (cdr nthcdr-length))
      (library (h2-modular-library proof))
      (logic (library-library-proof library))
      (residual (library-library-axiom library nthcdr-length-name (list n data)))
      (natural (proof-proof-assume logic guard-term t))
      (natural-value (h2-modular-natural-value proof natural))
      (residual (proof-proof-rewrite logic residual natural-value '(1 2 1 2 1)))
      (reverse-residual (proof-proof-symmetric logic residual))
      (fixed (proof-proof-rewrite logic fixed reverse-residual '(1 2 1)))
      (take-whole (h2-subsequence-take-whole proof))
      (take-whole-name (car take-whole))
      (proof (cdr take-whole))
      (library (h2-modular-library proof))
      (logic (library-library-proof library))
      (whole (library-library-axiom library take-whole-name (list tail)))
      (fixed (proof-proof-chain logic fixed (list whole)))
      (fix-operations (h2-subsequence-list-fix-operations proof))
      (names (car fix-operations))
      (proof (cdr fix-operations))
      (library (h2-modular-library proof))
      (logic (library-library-proof library))
      (fixed-drop (library-library-axiom library (cadr names) (list n data)))
      (fixed-drop (proof-proof-symmetric logic fixed-drop))
      (step (proof-proof-chain logic fixed (list fixed-drop)))
      (step (h2-modular-introduce proof formula step)))
     (cons step proof))))

(defun h2-subsequence-nonnil-cons (proof)
  (h2-recipes-with-results
   ((named (h2-book-logic-nonnil-cons (h2-recipes-recipes-search proof)))
    (name (car named)))
   (cons name (h2-recipes-recipes-with-search proof (cdr named)))))

(defun h2-subsequence-positive-take (proof label formula)
  (let ((take-term (list *h2-subsequence-take* *library-x* *library-y*))
        (positive (list *h2-subsequence-posp* *library-x*)))
    (if (equal label "CONSP-OF-SUBSEQ-LIST")
        (h2-recipes-with-results
         ((law (h2-subsequence-auxiliary proof "CONSP-OF-POSITIVE-TAKE"
                                         (proof-eq (list *proof-consp* take-term) positive)
                                         "TAKE POSP ZP" nil))
          (name (car law)))
         (h2-ordinals-derive (cdr law) formula "SUBSEQ-LIST" (list name) nil 80))
      (h2-recipes-with-results
       ((cons-name (h2-subsequence-nonnil-cons proof))
        (name (car cons-name))
        (law (h2-subsequence-auxiliary (cdr cons-name) "POSITIVE-TAKE-UNDER-IFF"
                                       (list *h2-subsequence-iff* take-term positive)
                                       "TAKE POSP ZP" (list name)))
        (law-name (car law))
        (proof (cdr law))
        (library (h2-modular-library proof))
        (logic (library-library-proof library))
        (claim (proof-term-at formula 1))
        (opening (proof-proof-unfold logic claim))
        (term (h2-modular-first-at opening '(2)))
        (arguments (if (integerp term) (proof-term-at term 1) (seq-slice term 1 :none)))
        (instantiated (library-library-axiom library law-name arguments))
        (step (library-library-transport-argument library instantiated opening 1)))
       (cons step proof)))))

(defun h2-subsequence-starting-from-zero (proof formula)
  (let* ((library (h2-modular-library proof))
         (logic (library-library-proof library)))
    (h2-recipes-with-results
     ((result (proof-term-at formula 2))
      (arguments (h2-modular-tail-of-size result 2))
      (n (car arguments))
      (data (cadr arguments))
      (call (proof-term-at formula 1))
      (opening (proof-proof-unfold logic call))
      (minus (proof-proof-compute logic (list *proof-minus* *proof-zero*) 0))
      (opening (proof-proof-rewrite logic opening minus '(1 2 1 2)))
      (commuted (library-library-axiom library "COMMUTATIVITY-OF-+" (list n *proof-zero*)))
      (identity (library-library-axiom library "UNICITY-OF-0" (list n)))
      (add-zero (proof-proof-chain logic commuted (list identity)))
      (opening (proof-proof-rewrite logic opening add-zero '(1 2 1)))
      (drop-zero (h2-ordinals-derive proof
                                     (proof-eq (list *h2-subsequence-nthcdr* *proof-zero* data) data)
                                     "NTHCDR ZP" nil nil 80))
      (proof (cdr drop-zero))
      (logic (h2-modular-proof proof))
      (opening (proof-proof-rewrite logic opening (car drop-zero) '(1 2 2)))
      (fixed (h2-ordinals-derive proof
                                 (proof-eq (list *h2-subsequence-take* (list (proof-sym "FIX" "ACL2") n) data)
                                           result)
                                 "FIX TAKE ZP" nil nil 80))
      (proof (cdr fixed))
      (step (proof-proof-chain (h2-modular-proof proof) opening (list (car fixed)))))
     (cons step proof))))

(defun h2-subsequence-subsequence-theorem (proof label formula)
  (cond
   ((equal label "SUBSEQ-LIST-OF-LEN") (h2-subsequence-subsequence-of-length proof formula))
   ((equal label "LEN-OF-NTHCDR")
    (h2-recipes-with-results
     ((named (h2-subsequence-nthcdr-length proof))
      (name (car named))
      (proof (cdr named))
      (call (h2-modular-term-at formula '(1 1)))
      (arguments (if (integerp call) (proof-term-at call 1) (seq-slice call 1 :none)))
      (step (library-library-axiom (h2-modular-library proof) name arguments)))
     (cons step proof)))
   ((equal label "TAKE-OF-LEN")
    (h2-recipes-with-results
     ((named (h2-subsequence-take-whole proof))
      (name (car named))
      (proof (cdr named))
      (value (h2-modular-term-at formula '(1 2)))
      (step (library-library-axiom (h2-modular-library proof) name (list value))))
     (cons step proof)))
   ((member-equal label '("LEN-OF-SUBSEQ-LIST" "LEN-OF-TAKE"))
    (h2-recipes-with-results ((named (h2-subsequence-take-length proof)) (name (car named)))
      (h2-ordinals-derive (cdr named) formula "SUBSEQ-LIST" (list name) nil 80)))
   ((equal label "CONSP-OF-TAKE")
    (h2-recipes-with-results ((named (h2-subsequence-nonnil-cons proof)) (name (car named)))
      (h2-ordinals-derive (cdr named) formula "TAKE ZP" (list name) nil 80)))
   ((member-equal label '("CONSP-OF-SUBSEQ-LIST" "SUBSEQ-LIST-UNDER-IFF"))
    (h2-subsequence-positive-take proof label formula))
   ((member-equal label '("SUBSEQ-LIST-OF-LIST-FIX" "NTHCDR-OF-LIST-FIX" "TAKE-OF-LIST-FIX"))
    (h2-recipes-with-results ((named (h2-subsequence-list-fix-operations proof)) (names (car named)))
      (h2-ordinals-derive (cdr named) formula "SUBSEQ-LIST" names nil 80)))
   ((equal label "SUBSEQ-LIST-STARTING-FROM-ZERO")
    (h2-subsequence-starting-from-zero proof formula))
   (t (cons nil proof))))
