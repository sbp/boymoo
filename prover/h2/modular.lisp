(in-package "BOYMOO-PROVER")
(set-verify-guards-eagerness 0)

(defconst *h2-modular-mod* (proof-sym "NONNEG-INT-MOD" "ACL2"))
(defconst *h2-modular-natural-fix* (proof-sym "NFIX" "ACL2"))
(defconst *h2-modular-zp* (proof-sym "ZP" "ACL2"))

(defun h2-modular-search (proof)
  (if (h2-search-object-p proof)
      proof
    (h2-recipes-recipes-search proof)))

(defun h2-modular-library (proof)
  (h2-search-search-library (h2-modular-search proof)))

(defun h2-modular-proof (proof)
  (library-library-proof (h2-modular-library proof)))

(defun h2-modular-with-library (proof library)
  (let ((search (h2-search-search-with-library (h2-modular-search proof) library)))
    (if (h2-search-object-p proof)
        search
      (h2-recipes-recipes-with-search proof search))))

(defun h2-modular-term-at (term indices)
  (declare (xargs :measure (acl2-count indices)))
  (if (endp indices)
      term
    (proof-with-checked-results ((part (proof-term-at term (car indices))))
      (h2-modular-term-at part (cdr indices)))))

(defun h2-modular-first-at (step indices)
  (proof-with-checked-results ((literal (proof-step-first step)))
    (h2-modular-term-at literal indices)))

(defun h2-modular-slice-from-one (term)
  (if (integerp term)
      (proof-term-at term 1)
    (seq-slice term 1 :none)))

(defun h2-modular-tail-of-size (term size)
  (proof-with-checked-results ((tail (h2-modular-slice-from-one term)))
    (proof-list-of-length tail size)))

(defun h2-modular-bindings (pairs bindings)
  (declare (xargs :measure (acl2-count pairs)))
  (if (endp pairs)
      bindings
    (h2-modular-bindings (cdr pairs) (table-put bindings (caar pairs) (cadar pairs)))))

(defun h2-modular-derive (proof formula definitions facts seeds cases)
  (h2-recipes-recipes-derive proof formula definitions facts nil 1 "" seeds cases 80))

(defun h2-modular-introduce (proof formula conclusion)
  (h2-search-search-introduce (h2-modular-search proof) formula conclusion))

(defmacro h2-modular-with-search-results (bindings result)
  (if (endp bindings)
      result
    (let ((binding (car bindings))
          (name (caar bindings)))
      `(let (,binding)
         (if (h2-search-stopped-p ,name)
             ,name
           (h2-modular-with-search-results ,(cdr bindings) ,result))))))

(defun h2-modular-fixed-natural (proof)
  (let* ((name "SELF-H2-NATURALP-OF-NFIX")
         (library (h2-modular-library proof))
         (rules (library-library-proof library)))
    (if (assoc-equal (proof-sym name "ACL2") (proof-proof-facts rules))
        (cons name proof)
      (proof-with-checked-results
          ((actual (proof-proof-unfold rules (list *h2-modular-natural-fix* *library-x*)))
           (auxiliary (proof-proof-unfold rules (list *library-nfix* *library-x*)))
           (opened (proof-proof-unfold rules (list *library-natp* *library-x*)))
           (expanded (proof-proof-rewrite rules auxiliary opened '(1 2 1)))
           (reversed (proof-proof-symmetric rules expanded))
           (aligned (proof-proof-chain rules actual (list reversed)))
           (nat (proof-proof-fact rules (proof-sym "SELF-NFIX-NATURAL" "ACL2") nil))
           (nat (library-library-transport-argument library nat aligned 1))
           (claim (proof-step-first nat))
           (library (library-library-lemma library "H2-NATURALP-OF-NFIX" claim nat nil)))
        (cons name (h2-modular-with-library proof library))))))

(defun h2-modular-natural-value (proof natural)
  (let* ((library (h2-modular-library proof))
         (rules (library-library-proof library)))
    (proof-with-checked-results
        ((literal (proof-step-first natural))
         (opening (proof-proof-unfold rules literal))
         (condition (proof-proof-rewrite rules natural opening '(1)))
         (value (proof-term-at literal 1))
         (lemma (library-library-axiom library "SELF-H2-NFIX-WHEN-NATURAL" (list value))))
      (proof-proof-modus-ponens rules lemma condition))))

(defun h2-modular-remainder-step (proof)
  (let* ((name "SELF-H2-REMAINDER-SUBTRACTION")
         (library (h2-modular-library proof))
         (rules (library-library-proof library))
         (x *library-x*)
         (y *library-y*))
    (if (assoc-equal (proof-sym name "ACL2") (proof-proof-facts rules))
        (cons name proof)
      (proof-with-checked-results
          ((actual (list *h2-modular-natural-fix* x))
           (nonzero (proof-proof-assume rules (list *h2-modular-zp* y) nil))
           (less (library-lt actual y))
           (large (proof-proof-assume rules less nil))
           (iy (library-library-cite library "H2-POSITIVE-INDEX-INTEGER" (list y) (list nonzero)))
           (py (library-library-cite library "H2-POSITIVE-INDEX-POSITIVE" (list y) (list nonzero)))
           (fixed (h2-modular-fixed-natural proof))
           (proof (cdr fixed))
           (library (h2-modular-library proof))
           (rules (library-library-proof library))
           (nat-actual (library-library-axiom library (car fixed) (list x)))
           (raw-integer (library-library-cite library "NATURAL-INTEGER" (list actual) (list nat-actual)))
           (izero (library-library-type-of library *proof-zero* nil))
           (clip-positive (library-library-cite library "LESS-THEN-WEAK" (list *proof-zero* y actual)
                                                (list izero iy raw-integer py large)))
           (opened (proof-proof-unfold rules actual))
           (body (h2-modular-first-at opened '(2)))
           (test (proof-term-at body 1))
           (nat (list *library-natp* x))
           (holds (proof-proof-assume rules test t))
           (nat-opened (proof-proof-unfold rules nat))
           (valid (proof-proof-transport rules holds nat-opened))
           (clipped (proof-proof-if-false rules body))
           (clipped (proof-proof-chain rules opened (list clipped)))
           (zero-bound (proof-proof-rewrite rules clip-positive clipped '(1 2)))
           (zero-fact (library-library-axiom library "ZERO" nil))
           (contradiction (proof-proof-cut rules zero-bound zero-fact))
           (clipped-case (proof-proof-subsume rules contradiction (cons nat (proof-step-clause contradiction))))
           (nx (proof-proof-cases rules test valid clipped-case))
           (nat-opened (proof-proof-unfold rules nat))
           (evidence (proof-proof-rewrite rules nx nat-opened '(1)))
           (selected (proof-proof-select rules body evidence))
           (align (proof-proof-chain rules opened (list selected)))
           (no-less (proof-proof-rewrite rules large align '(1 1 1)))
           (ix (library-library-cite library "NATURAL-INTEGER" (list x) (list nx)))
           (next-value (library-diff x y))
           (comparison (library-library-axiom library "<-ON-OTHERS" (list x y)))
           (delta-bound (proof-proof-rewrite rules no-less comparison '(1 1)))
           (delta-int (library-library-type-of library next-value (list ix iy)))
           (delta-nat (library-library-cite library "NATURAL-FROM-BOUNDS" (list next-value)
                                             (list delta-int delta-bound)))
           (strict (library-library-less-from-difference library next-value x py (list ix iy)))
           (before (list *library-count* x))
           (after (list *library-count* next-value))
           (count-result (h2-division-count-of-natural library))
           (count-name (car count-result))
           (library (cdr count-result))
           (rules (library-library-proof library))
           (count-fact (proof-sym count-name "ACL2"))
           (before-eq (proof-proof-use rules count-fact (list (list x x)) (list nx)))
           (after-eq (proof-proof-use rules count-fact (list (list x next-value)) (list delta-nat)))
           (scaled (library-library-transport-argument library strict after-eq 1))
           (scaled (library-library-transport-argument library scaled before-eq 2))
           (ordinal (library-library-ordinal-comparison library after before))
           (descent (proof-proof-transport rules scaled ordinal))
           (claim (proof-step-first descent))
           (library (library-library-lemma library "H2-REMAINDER-SUBTRACTION" claim descent
                                           (list (list *h2-modular-zp* y) less))))
        (cons name (h2-modular-with-library proof library))))))

(defun h2-modular-remainder-bounds (proof)
  (let* ((name "SELF-H2-REMAINDER-BOUNDS")
         (x *library-x*)
         (y *library-y*))
    (if (assoc-equal (proof-sym name "ACL2") (proof-proof-facts (h2-modular-proof proof)))
        (cons name proof)
      (proof-with-checked-results
          ((step-result (h2-modular-remainder-step proof))
           (proof (cdr step-result))
           (library (h2-modular-library proof))
           (rules (library-library-proof library))
           (step-name (proof-sym (car step-result) "ACL2"))
           (value (list *h2-modular-mod* x y))
           (nonzero (proof-neg (list *h2-modular-zp* y)))
           (template (proof-ite (list *library-natp* *proof-result*)
                                (library-lt *proof-result* y) *proof-false*))
           (claim (proof-subst template (list (cons *proof-result* value))))
           (formula (list *library-implies* nonzero claim))
           (divisor (proof-proof-assume rules nonzero t))
           (opening (proof-proof-unfold rules value))
           (right (h2-modular-first-at opening '(2)))
           (selected (proof-proof-select rules right divisor))
           (opened (proof-proof-chain rules opening (list selected)))
           (body (h2-modular-first-at opened '(2)))
           (test (proof-term-at body 1))
           (clip (list *h2-modular-natural-fix* x))
           (fixed (h2-modular-fixed-natural proof))
           (proof (cdr fixed))
           (library (h2-modular-library proof))
           (rules (library-library-proof library))
           (nat (library-library-axiom library (car fixed) (list x)))
           (at-clip (proof-subst template (list (cons *proof-result* clip))))
           (less (proof-proof-assume rules test t))
           (base-case (proof-proof-prove rules at-clip (list nat less) nil))
           (selected (proof-proof-if-true rules body))
           (base (proof-proof-chain rules opened (list selected)))
           (base-reversed (proof-proof-symmetric rules base))
           (yes (proof-proof-rewrite-result rules base-case base-reversed template *proof-result*))
           (selected (proof-proof-if-false rules body))
           (child (proof-proof-chain rules opened (list selected)))
           (next-value (h2-modular-first-at child '(2 1)))
           (updates (list (list x next-value)))
           (large (proof-proof-assume rules test nil))
           (descent (proof-proof-use rules step-name nil (list divisor large)))
           (smaller (proof-step-first descent))
           (instance (proof-subst formula (h2-modular-bindings updates nil)))
           (hypothesis (proof-ite smaller instance *proof-true*))
           (assumed (proof-proof-assume rules hypothesis t))
           (small (proof-proof-prove-if rules assumed descent))
           (small (proof-proof-modus-ponens rules small divisor))
           (child-reversed (proof-proof-symmetric rules child))
           (no (proof-proof-rewrite-result rules small child-reversed template *proof-result*))
           (joined (proof-proof-cases rules test yes no))
           (cases (h2-modular-introduce proof formula joined))
           (ordinal (library-library-builtin library 1 x))
           (result (proof-proof-induct rules ordinal cases formula (list *library-count* x) (list updates)))
           (library (library-library-lemma library "H2-REMAINDER-BOUNDS" formula result nil)))
        (cons name (h2-modular-with-library proof library))))))

(defun h2-modular-remainder-count-bound (proof)
  (let* ((name "SELF-H2-REMAINDER-COUNT-LESS")
         (rules (h2-modular-proof proof))
         (x *library-x*)
         (y *library-y*))
    (if (assoc-equal (proof-sym name "ACL2") (proof-proof-facts rules))
        (cons name proof)
      (proof-with-checked-results
          ((divisor (proof-proof-assume rules (list *h2-modular-zp* y) nil))
           (bounds (h2-modular-remainder-bounds proof))
           (proof (cdr bounds))
           (library (h2-modular-library proof))
           (rules (library-library-proof library))
           (lemma (library-library-axiom library (car bounds) (list x y)))
           (bounded (proof-proof-modus-ponens rules lemma divisor))
           (conjuncts (proof-proof-conjunct rules bounded))
           (natural (car conjuncts))
           (strict (cadr conjuncts))
           (iy (library-library-cite library "H2-POSITIVE-INDEX-INTEGER" (list y) (list divisor)))
           (py (library-library-cite library "H2-POSITIVE-INDEX-POSITIVE" (list y) (list divisor)))
           (y-lower (library-library-cite library "POSITIVE-NONNEGATIVE" (list y) (list iy py)))
           (ny (library-library-cite library "NATURAL-FROM-BOUNDS" (list y) (list iy y-lower)))
           (count-result (h2-division-count-of-natural library))
           (count-name (car count-result))
           (library (cdr count-result))
           (rules (library-library-proof library))
           (count-id (proof-sym count-name "ACL2"))
           (value (list *h2-modular-mod* x y))
           (child (proof-proof-use rules count-id (list (list x value)) (list natural)))
           (parent (proof-proof-use rules count-id (list (list x y)) (list ny)))
           (comparison (library-library-transport-argument library strict child 1))
           (comparison (library-library-transport-argument library comparison parent 2))
           (ordinal (library-library-ordinal-comparison library (list *library-count* value)
                                                        (list *library-count* y)))
           (descend (proof-proof-transport rules comparison ordinal))
           (claim (proof-step-first descend))
           (library (library-library-lemma library "H2-REMAINDER-COUNT-LESS" claim descend
                                           (list (list *h2-modular-zp* y)))))
        (cons name (h2-modular-with-library proof library))))))

(defun h2-modular-remainder-theorem (proof formula)
  (let ((rules (h2-modular-proof proof)))
    (h2-modular-with-search-results
        ((parts (h2-modular-tail-of-size formula 2))
         (guard (car parts))
         (comparison (proof-list-of-length (cadr parts) 3))
         (value (cadr comparison))
         (divisor (caddr comparison))
         (dividend (proof-term-at value 1))
         (assumed (proof-proof-assume rules guard t))
         (normal-guard (proof-proof-conjunct rules assumed))
         (derived (h2-modular-derive proof (proof-neg (list *h2-modular-zp* divisor))
                                     "ZP" nil normal-guard nil))
         (not-zero (car derived))
         (bounds (h2-modular-remainder-bounds (cdr derived)))
         (proof (cdr bounds))
         (library (h2-modular-library proof))
         (rules (library-library-proof library))
         (lemma (library-library-axiom library (car bounds) (list dividend divisor)))
         (bounded (proof-proof-modus-ponens rules lemma not-zero))
         (conjuncts (proof-proof-conjunct rules bounded))
         (result (h2-modular-introduce proof formula (cadr conjuncts))))
      (cons result proof))))

(defconst *h2-modular-boolean-facts*
  (list (cons *proof-consp* "booleanp-consp")
        (cons *proof-integerp* "booleanp-integerp")
        (cons *library-rationalp* "booleanp-rationalp")
        (cons (proof-sym "COMPLEX-RATIONALP" "ACL2") "booleanp-complex-rationalp")
        (cons *library-numberp* "booleanp-acl2-numberp")
        (cons (proof-cl "STRINGP") "booleanp-stringp")
        (cons (proof-cl "SYMBOLP") "booleanp-symbolp")
        (cons *proof-less* "booleanp-<")))

(defun h2-modular-boolean-value (library term evidence)
  (proof-with-checked-results ((head (proof-term-at term 0)))
    (let ((name (assoc-equal head *h2-modular-boolean-facts*)))
      (if (not name)
          '(:failure "failure" "")
        (proof-with-checked-results
            ((typed (proof-proof-fact (library-library-proof library) (cdr name)
                                     (seq-zip (list *library-x* *library-y*) (cdr term)))))
          (library-library-cite library "H2-TRUE-BOOLEAN" (list term) (list evidence typed)))))))

(defun h2-modular-quotient-guard (proof test dividend divisor typed positive)
  (let* ((library (h2-modular-library proof))
         (rules (library-library-proof library)))
    (h2-modular-with-search-results
        ((nonnegative (library-library-cite library "POSITIVE-NONNEGATIVE" (list divisor)
                                           (list typed positive)))
         (izero (library-library-type-of library *proof-zero* nil))
         (unequal-zero (library-library-cite library "H2-LESS-IMPLIES-UNEQUAL" (list *proof-zero* divisor)
                                            (list izero positive)))
         (below-zero (library-lt dividend *proof-zero*))
         (numeric (proof-proof-assume rules (library-integer dividend) t))
         (negative (proof-proof-assume rules below-zero t))
         (izero (library-library-type-of library *proof-zero* nil))
         (below-divisor (library-library-cite library "LESS-TRANSITIVE" (list dividend *proof-zero* divisor)
                                             (list numeric izero typed negative positive)))
         (goal (proof-eq test (library-lt (list *h2-modular-natural-fix* dividend) divisor)))
         (known (list typed positive nonnegative unequal-zero))
         (below-literal (proof-step-first below-divisor))
         (below-value (h2-modular-boolean-value library below-literal below-divisor))
         (positive-literal (proof-step-first positive))
         (positive-value (h2-modular-boolean-value library positive-literal positive))
         (yes-result (h2-modular-derive proof goal "NFIX IFIX" nil
                                         (append known (list numeric negative below-value positive-value)) nil))
         (yes (car yes-result))
         (proof (cdr yes-result))
         (rules (h2-modular-proof proof))
         (nonnegative-input (proof-proof-assume rules below-zero nil))
         (no-result (h2-modular-derive proof goal "NFIX IFIX" nil
                                        (append known (list numeric nonnegative-input)) nil))
         (no (car no-result))
         (proof (cdr no-result))
         (rules (h2-modular-proof proof))
         (numeric-literal (proof-step-first numeric))
         (noninteger-input (proof-proof-assume rules numeric-literal nil))
         (other-result (h2-modular-derive proof goal "NFIX IFIX" nil
                                           (append known (list noninteger-input)) nil))
         (other (car other-result))
         (proof (cdr other-result))
         (rules (h2-modular-proof proof))
         (numeric-case (proof-proof-cases rules below-zero yes no))
         (result (proof-proof-cases rules numeric-literal numeric-case other)))
      (cons result proof))))

(defun h2-modular-quotient-remainder-base (remainder-eq quotient-eq proof total zero-product drop-zero)
  (let ((rules (h2-modular-proof proof)))
    (proof-with-checked-results
        ((reflexive (proof-proof-reflexive rules total))
         (normalized (proof-proof-rewrite rules reflexive remainder-eq '(1 2 1)))
         (normalized (proof-proof-rewrite rules normalized quotient-eq '(1 2 2 2)))
         (removed (proof-proof-rewrite rules normalized zero-product '(1 2 2))))
      (proof-proof-chain rules removed (list drop-zero)))))

(defun h2-modular-quotient-remainder-fixed-value (value fact evidence proof)
  (let ((library (h2-modular-library proof)))
    (proof-with-checked-results ((lemma (library-library-axiom library fact (list value))))
      (proof-proof-modus-ponens (library-library-proof library) lemma evidence))))

(defun h2-modular-quotient-remainder (proof formula)
  (let* ((rules (h2-modular-proof proof))
         (zero *proof-zero*)
         (one *proof-one*))
    (h2-modular-with-search-results
        ((total (proof-term-at formula 1))
         (modulus (proof-term-at total 1))
         (quotient (h2-modular-term-at total '(2 2)))
         (operands (h2-modular-tail-of-size modulus 2))
         (n (car operands))
         (d (cadr operands))
         (fixed-n (proof-term-at formula 2))
         (fixed-d (h2-modular-term-at total '(2 1)))
         (mod-eq (proof-proof-unfold rules modulus))
         (quot-eq (proof-proof-unfold rules quotient))
         (test (list *h2-modular-zp* d))
         (zero-divisor (proof-proof-assume rules test t))
         (positive-divisor (proof-proof-assume rules test nil))
         (fixed (h2-modular-fixed-natural proof))
         (proof (cdr fixed))
         (library (h2-modular-library proof))
         (input-natural (library-library-axiom library (car fixed) (list n)))
         (fixed (h2-modular-fixed-natural proof))
         (proof (cdr fixed))
         (library (h2-modular-library proof))
         (rules (library-library-proof library))
         (divisor-natural (library-library-axiom library (car fixed) (list d)))
         (fixed-n-integer (library-library-cite library "NATURAL-INTEGER" (list fixed-n)
                                                (list input-natural)))
         (fixed-d-integer (library-library-cite library "NATURAL-INTEGER" (list fixed-d)
                                                (list divisor-natural)))
         (zero-product (library-library-cite library "H2-INTEGER-ZERO-PRODUCT" (list fixed-d)
                                             (list fixed-d-integer)))
         (drop-zero (library-library-cite library "ADD-ZERO-RIGHT" (list fixed-n)
                                           (list fixed-n-integer)))
         (mod-body (h2-modular-first-at mod-eq '(2)))
         (selected (proof-proof-select rules mod-body zero-divisor))
         (zero-mod (proof-proof-chain rules mod-eq (list selected)))
         (zero-result (h2-modular-derive proof (proof-eq quotient zero) "NONNEGATIVE-INTEGER-QUOTIENT"
                                          '("SELF-H2-NFIX-WHEN-ZP") (list zero-divisor) nil))
         (zero-quot (car zero-result))
         (proof (cdr zero-result))
         (library (h2-modular-library proof))
         (rules (library-library-proof library))
         (zero-case (h2-modular-quotient-remainder-base zero-mod zero-quot proof total zero-product drop-zero))
         (id (library-library-cite library "H2-POSITIVE-INDEX-INTEGER" (list d) (list positive-divisor)))
         (pd (library-library-cite library "H2-POSITIVE-INDEX-POSITIVE" (list d) (list positive-divisor)))
         (selected (proof-proof-select rules mod-body positive-divisor))
         (open-mod (proof-proof-chain rules mod-eq (list selected)))
         (quot-test (h2-modular-first-at quot-eq '(2 1)))
         (guard-result (h2-modular-quotient-guard proof quot-test n d id pd))
         (guard (car guard-result))
         (proof (cdr guard-result))
         (rules (h2-modular-proof proof))
         (open-quot (proof-proof-rewrite rules quot-eq guard '(1 2 1)))
         (less (h2-modular-first-at guard '(2)))
         (small (proof-proof-assume rules less t))
         (large (proof-proof-assume rules less nil))
         (open-mod-body (h2-modular-first-at open-mod '(2)))
         (selected (proof-proof-select rules open-mod-body small))
         (small-mod (proof-proof-chain rules open-mod (list selected)))
         (open-quot-body (h2-modular-first-at open-quot '(2)))
         (selected (proof-proof-select rules open-quot-body small))
         (small-quot (proof-proof-chain rules open-quot (list selected)))
         (small-case (h2-modular-quotient-remainder-base small-mod small-quot proof total zero-product drop-zero))
         (selected (proof-proof-select rules open-mod-body large))
         (next-mod (proof-proof-chain rules open-mod (list selected)))
         (selected (proof-proof-select rules open-quot-body large))
         (next-quot (proof-proof-chain rules open-quot (list selected)))
         (remainder (h2-modular-first-at next-mod '(2)))
         (next-n (proof-term-at remainder 1))
         (next-count (h2-modular-first-at next-quot '(2 2)))
         (updates (list (list n next-n)))
         (descent-result (h2-modular-remainder-step proof))
         (proof (cdr descent-result))
         (library (h2-modular-library proof))
         (rules (library-library-proof library))
         (descent (proof-proof-use rules (proof-sym (car descent-result) "ACL2")
                                   (list (list *library-x* n) (list *library-y* d))
                                   (list positive-divisor large)))
         (smaller-literal (proof-step-first descent))
         (instance (proof-subst formula (h2-modular-bindings updates nil)))
         (case-hypothesis (proof-proof-assume rules (proof-ite smaller-literal instance *proof-true*) t))
         (smaller (proof-proof-prove-if rules case-hypothesis descent))
         (fixed-d-eq (h2-modular-quotient-remainder-fixed-value d "SELF-H2-NFIX-WHEN-NOT-ZP"
                                                              positive-divisor proof))
