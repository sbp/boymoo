                                                (list iquot ix iden pden bound)))
           (floor-call (list *h2-division-floor* x y))
           (opening (h2-book-logic-logical-equation search floor-call))
           (body (h2-division-step-at opening 2))
           (test (proof-term-at body 1))
           (test-open (proof-proof-unfold proof test))
           (opening (proof-proof-rewrite proof opening test-open '(1 2 1)))
           (body (h2-division-step-at opening 2))
           (den-one (proof-term-at body 1))
           (yes (proof-proof-if-true proof body))
           (one-value (proof-proof-chain proof opening (list yes)))
           (no (proof-proof-if-false proof body))
           (other-value (proof-proof-chain proof opening (list no)))
           (other-value (h2-division-chain-selections proof other-value (list nonnegative-num)))
           (rhs-same (proof-proof-reflexive proof rhs))
           (one-test (proof-proof-assume proof den-one t))
           (scaled-by-one (proof-proof-rewrite proof rhs-same one-test '(1 2 1)))
           (identity (h2-division-identity-factor lib x integers))
