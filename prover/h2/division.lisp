(defun h2-division-product (left right)
  (list *proof-times* left right))

(defun h2-division-step-at (step index)
  (proof-with-checked-results ((first (proof-step-first step)))
    (proof-term-at first index)))

(defun h2-division-identity-factor (lib term evidence)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((unary (library-library-axiom lib "UNICITY-OF-1" (list term)))
         (value (h2-division-step-at unary 2))
         (number (library-library-number lib term evidence))
         (fixed (proof-proof-simplify proof value (list number)
                                      (list (proof-sym "FIX" "ACL2")))))
      (proof-proof-chain proof unary (list fixed)))))

(defun h2-division-positive-product (lib left right positive-left positive-right integers)
  (proof-with-checked-results
      ((rational-left (library-library-rational lib left integers))
       (rational-right (library-library-rational lib right integers)))
    (library-library-cite lib "POSITIVE-PRODUCT" (list left right)
                          (list rational-left rational-right positive-left positive-right))))

(defun h2-division-order-zero (lib integers)
  (let* ((proof (library-library-proof lib))
         (x *library-x*)
         (zero *proof-zero*)
         (times-zero (h2-division-product x zero))
         (difference (library-diff times-zero times-zero)))
    (proof-with-checked-results
        ((zero-sum (proof-proof-compute proof (library-plus zero zero) 0))
         (distributivity (library-library-axiom lib "DISTRIBUTIVITY" (list x zero zero)))
         (double (proof-proof-rewrite proof distributivity zero-sum '(1 1 2)))
         (reflexive (proof-proof-reflexive proof difference))
         (subtract (proof-proof-rewrite proof reflexive double '(1 2 1)))
         (zero-step (library-library-linear-equal lib difference zero integers))
         (product-zero
          (library-library-linear-equal
           lib (library-diff (library-plus times-zero times-zero) times-zero) times-zero integers))
         (zero-back (proof-proof-symmetric proof zero-step))
         (result (proof-proof-chain proof zero-back (list subtract product-zero)))
         (back (proof-proof-symmetric proof result))
         (ix (proof-step-first (car integers))))
      (library-library-lemma lib "H2-INTEGER-ZERO-PRODUCT" (proof-eq times-zero zero)
                             back (list (proof-neg ix))))))

(defun h2-division-order-lift (lib integers a b strict less factor-positive)
  (let* ((proof (library-library-proof lib))
         (x *library-x*)
         (y *library-y*)
         (z *library-z*)
         (delta (library-diff y x)))
    (proof-with-checked-results
        ((comparison (library-library-comparison lib x y integers))
         (delta-positive (proof-proof-rewrite proof less comparison '(1)))
         (gap (h2-division-positive-product lib z delta factor-positive delta-positive integers))
         (align (library-library-linear-equal lib (library-plus x delta) y integers))
         (distribution (library-library-axiom lib "DISTRIBUTIVITY" (list z x delta)))
         (distribute (proof-proof-rewrite proof distribution align '(1 1 2)))
         (lifted (library-library-less-from-difference
                  lib a (library-plus a (h2-division-product z delta)) gap integers))
         (lifted (library-library-transport-argument lib lifted distribute 2))
         (ix (proof-step-first (car integers)))
         (iy (proof-step-first (cadr integers)))
         (iz (proof-step-first (caddr integers)))
         (positive-factor (proof-step-first factor-positive)))
      (library-library-lemma lib "H2-LESS-POSITIVE-PRODUCT" (library-lt a b) lifted
                             (library-guards (list ix iy iz positive-factor strict))))))

(defun h2-division-order-cancel (lib integers a b strict factor-positive)
  (let* ((proof (library-library-proof lib))
         (x *library-x*)
         (y *library-y*)
         (z *library-z*)
         (ix (car integers))
         (iy (cadr integers))
         (iz (caddr integers))
         (same (proof-eq x y)))
    (proof-with-checked-results
        ((scaled-less (proof-proof-assume proof (library-lt a b) t))
         (same-step (proof-proof-assume proof same t))
         (reverse (proof-proof-symmetric proof same-step))
         (equal-step (proof-proof-rewrite proof scaled-less reverse '(1 2 2)))
         (int-a (library-library-type-of lib a integers))
         (weak (library-library-cite lib "WEAK-REFLEXIVE" (list a) (list int-a)))
         (impossible (proof-proof-cut proof equal-step weak))
         (equal-case (proof-proof-subsume proof impossible
                                          (cons strict (proof-step-clause impossible))))
         (not-strict (proof-proof-assume proof strict nil))
         (not-same (proof-proof-assume proof same nil))
         (opposite (library-library-cite lib "H2-INTEGER-TRICHOTOMY" (list x y)
                                         (list ix iy not-strict not-same)))
         (scaled-opposite (library-library-cite lib "H2-LESS-POSITIVE-PRODUCT" (list y x z)
                                                (list iy ix iz factor-positive opposite)))
         (int-b (library-library-type-of lib b integers))
         (int-a (library-library-type-of lib a integers))
         (asymmetry (library-library-cite lib "H2-INTEGER-ASYMMETRY" (list b a)
                                          (list int-b int-a scaled-opposite)))
         (descending (proof-proof-cut proof scaled-less asymmetry))
         (descending-case (proof-proof-front proof descending strict))
         (result (proof-proof-cases proof same equal-case descending-case))
         (int-x (proof-step-first ix))
         (int-y (proof-step-first iy))
         (int-z (proof-step-first iz))
         (positive-factor (proof-step-first factor-positive))
         (scaled (proof-step-first scaled-less)))
      (library-library-lemma lib "H2-LESS-CANCEL-PRODUCT" strict result
                             (library-guards (list int-x int-y int-z positive-factor scaled))))))

(defun h2-division-product-order (lib)
  (proof-with-checked-results ((lib (h2-arithmetic-integer-order lib)))
    (if (assoc-equal (proof-sym "SELF-H2-LESS-CANCEL-PRODUCT" "ACL2")
                     (proof-proof-facts (library-library-proof lib)))
        lib
      (let ((x *library-x*) (y *library-y*) (z *library-z*))
        (proof-with-checked-results
            ((integers (library-library-ints lib (list x y z)))
             (lib (h2-division-order-zero lib integers)))
          (let* ((proof (library-library-proof lib))
                 (a (h2-division-product z x))
                 (b (h2-division-product z y))
                 (strict (library-lt x y)))
            (proof-with-checked-results
                ((less (proof-proof-assume proof strict t))
                 (factor-positive (proof-proof-assume proof (library-positive z) t))
                 (lib (h2-division-order-lift lib integers a b strict less factor-positive)))
              (h2-division-order-cancel lib integers a b strict factor-positive))))))))

(defun h2-division-add-subtraction-descent (lib)
  (let* ((proof (library-library-proof lib))
         (x *library-x*)
         (y *library-y*)
         (xy (library-lt x y)))
    (proof-with-checked-results ((integers (library-library-ints lib (list x y))))
      (let ((ix (car integers)) (iy (cadr integers)))
        (proof-with-checked-results
            ((pos (proof-proof-assume proof (library-positive y) t))
             (bound (proof-proof-assume proof xy nil))
             (int-zero (library-library-type-of lib *proof-zero* nil))
             (pos-x (library-library-cite lib "LESS-THEN-WEAK" (list *proof-zero* y x)
                                          (list int-zero iy ix pos bound)))
             (next-value (library-diff x y))
             (strict (library-library-less-from-difference lib next-value x pos integers))
             (int-next (library-library-type-of lib next-value integers))
             (smaller (library-library-cite lib "NFIX-DECREASE" (list next-value x)
                                            (list int-next ix pos-x strict)))
             (claim (proof-step-first smaller))
             (int-x (proof-step-first ix))
             (int-y (proof-step-first iy))
             (positive-y (proof-step-first pos)))
          (library-library-lemma lib "H2-SUBTRACTION-DESCENT" claim smaller
                                 (append (library-guards (list int-x int-y positive-y))
                                         (list xy))))))))

(defun h2-division-subtraction-descent (lib)
  (let ((name "SELF-H2-SUBTRACTION-DESCENT"))
    (if (assoc-equal (proof-sym name "ACL2") (proof-proof-facts (library-library-proof lib)))
        (cons name lib)
      (let ((result (h2-division-add-subtraction-descent lib)))
        (if (failure-p result) (cons result lib) (cons name result))))))

(defun h2-division-chain-selections (proof opening evidence)
  (declare (xargs :measure (acl2-count evidence)))
  (if (endp evidence)
      opening
    (proof-with-checked-results
        ((right (h2-division-step-at opening 2))
         (selected (proof-proof-select proof right (car evidence)))
         (chained (proof-proof-chain proof opening (list selected))))
      (h2-division-chain-selections proof chained (cdr evidence)))))

(defun h2-division-add-count-of-natural (lib)
  (let ((proof (library-library-proof lib)) (x *library-x*))
    (proof-with-checked-results
        ((nat (proof-proof-assume proof (list *library-natp* x) t))
         (ix (library-library-cite lib "NATURAL-INTEGER" (list x) (list nat)))
         (lower (library-library-cite lib "NATURAL-NONNEGATIVE" (list x) (list nat)))
         (finite (library-library-cite lib "INTEGER-FINITE" (list x) (list ix)))
         (finite-first (proof-step-first finite))
         (finite-open (proof-proof-unfold proof finite-first))
         (atom-step (proof-proof-rewrite proof finite finite-open '(1)))
         (atom-first (proof-step-first atom-step))
         (atom-open (proof-proof-unfold proof atom-first))
         (not-cons (proof-proof-rewrite proof atom-step atom-open '(1)))
         (count-step (proof-proof-unfold proof (list *library-count* x)))
         (rational (library-library-rational lib x (list ix)))
         (count-step (h2-division-chain-selections proof count-step (list not-cons rational ix)))
         (absolute-term (h2-division-step-at count-step 2))
         (absolute (proof-proof-unfold proof absolute-term))
         (absolute (h2-division-chain-selections proof absolute (list ix lower)))
         (step (proof-proof-chain proof count-step (list absolute)))
         (claim (proof-step-first step))
         (nat-first (proof-step-first nat)))
      (library-library-lemma lib "H2-COUNT-OF-NATURAL" claim step (list (proof-neg nat-first))))))

(defun h2-division-count-of-natural (lib)
  (let ((name "SELF-H2-COUNT-OF-NATURAL"))
