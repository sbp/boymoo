  (h2-book-logic-with-saved-result search
    (h2-division-with-search search
        ((case-step (h2-division-derive search test "" nil nil 1 "" evidence nil 80) :search)
         (lib (h2-search-search-library search))
         (proof (library-library-proof lib))
         (opened (h2-division-chain-selections proof expansion (list case-step)))
         (predicate (proof-term-at goal 0))
         (value (h2-division-step-at opened 2))
         (result (h2-division-recognize recognize search (list predicate value) accumulator-invariant)
                 :search)
         (lib (h2-search-search-library search))
         (step (library-library-transport-argument lib result opened 1)))
      (cons step search))))

(defun h2-division-explode-accumulator (search formula recognize)
  (h2-division-with-search search
      ((indexed (h2-division-index-lemmas search) :search)
       (floor (h2-division-floor-bounds search) :search)
       (base-bounds (h2-division-print-base-bounds search) :search)
       (lib (h2-search-search-library search))
       (proof (library-library-proof lib))
       (goal (proof-term-at formula 2))
       (value (proof-term-at goal 1))
       (arguments (if (integerp value)
                      (proof-term-at value 1)
                    (proof-list-of-length (cdr value) 3)))
       (n (car arguments))
       (base (cadr arguments))
       (accumulator (caddr arguments))
       (invariant (proof-term-at formula 1))
       (accumulator-invariant (proof-proof-assume proof invariant t))
       (zero (list *h2-division-zp* n))
       (is-base (list *h2-division-print-base* base))
       (expansion (proof-proof-unfold proof value))
       (body (h2-division-step-at expansion 2))
       (test (proof-term-at body 1))
       (zero-step (proof-proof-assume proof zero t))
       (stopped (h2-division-explode-accumulator-base-case
                 (list zero-step) search test expansion recognize goal accumulator-invariant)
                :search)
       (recognize (h2-division-next-recognizer recognize))
       (lib (h2-search-search-library search))
       (proof (library-library-proof lib))
       (not-zero (proof-proof-assume proof zero nil))
       (not-base (proof-proof-assume proof is-base nil))
       (invalid (h2-division-explode-accumulator-base-case
                 (list not-zero not-base) search test expansion recognize goal accumulator-invariant)
                :search)
       (recognize (h2-division-next-recognizer recognize))
       (lib (h2-search-search-library search))
       (proof (library-library-proof lib))
       (nonzero (proof-proof-assume proof zero nil))
       (valid (proof-proof-assume proof is-base t))
       (continue-test (h2-division-derive search (proof-neg test) "" nil nil 1 ""
                                          (list nonzero valid) nil 80)
                      :search)
       (lib (h2-search-search-library search))
       (proof (library-library-proof lib))
       (equality (h2-division-chain-selections proof expansion (list continue-test)))
       (child (h2-division-step-at equality 2))
       (in (library-library-cite lib "H2-POSITIVE-INDEX-INTEGER" (list n) (list nonzero)))
       (pn (library-library-cite lib "H2-POSITIVE-INDEX-POSITIVE" (list n) (list nonzero)))
       (base-theorem (library-library-axiom lib base-bounds (list base)))
       (base-property (proof-proof-modus-ponens proof base-theorem valid))
       (base-parts (proof-proof-conjunct proof base-property))
       (ib (car base-parts))
       (lb (cadr base-parts))
       (bindings (list (list *library-x* n) (list *library-y* base)))
       (bounds (proof-proof-use proof (proof-sym floor "ACL2") bindings (list in ib pn lb)))
       (floor-parts (proof-proof-conjunct proof bounds))
       (nat (car floor-parts))
       (less (cadr floor-parts))
       (measure (list *library-nfix* n))
       (child-n (proof-term-at child 1))
       (child-int (library-library-cite lib "NATURAL-INTEGER" (list child-n) (list nat)))
       (small (library-library-cite lib "NFIX-DECREASE" (list child-n n)
                                    (list child-int in pn less)))
       (child-accumulator (proof-term-at child 3))
       (updated (list (list n child-n) (list accumulator child-accumulator)))
       (substitution (table-put (list (cons n child-n)) accumulator child-accumulator))
       (descent (proof-step-first small))
       (child-formula (proof-subst formula substitution))
       (hypothesis (proof-ite descent child-formula *proof-true*))
       (assumed (proof-proof-assume proof hypothesis t))
       (recursive (proof-proof-prove-if proof assumed small))
       (claim (h2-division-step-at recursive 1))
       (cons-step (h2-division-recognize recognize search claim accumulator-invariant) :search)
       (lib (h2-search-search-library search))
       (proof (library-library-proof lib))
       (recursive-step (proof-proof-modus-ponens proof recursive cons-step))
       (success (library-library-transport-argument lib recursive-step equality 1))
       (base-case (proof-proof-cases proof is-base success invalid))
       (result (proof-proof-cases proof zero stopped base-case))
       (result (h2-search-search-introduce search formula result))
       (ordinal (library-library-cite lib "NFIX-ORDINAL" (list n) nil))
       (step (proof-proof-induct proof ordinal result formula measure (list updated))))
    (cons step search)))

(defun h2-division-explode-true-list (search formula)
  (h2-division-explode-accumulator search formula :true-list))
