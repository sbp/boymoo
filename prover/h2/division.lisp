(defun h2-division-index-lemmas-request (search replies)
  (h2-book-logic-with-saved-result search
    (let ((result (h2-arithmetic-index-lemmas (h2-search-search-library search) replies)))
      (cond ((failure-p result) (cons result search))
            ((h2-alists-request-p (car result))
             (cons (car result) (h2-search-search-with-library search (cdr result))))
            (t (cons nil (h2-search-search-with-library search result)))))))

(defun h2-division-index-lemmas-next (n search replies)
  (declare (xargs :measure (nfix n)))
  (if (not (o< (nfix (1- n)) (nfix n)))
      (cons '(:failure "Fuel" "h2-division-index-lemmas-next") search)
    (let* ((result (h2-division-index-lemmas-request search replies))
           (search (cdr result)))
      (if (not (h2-alists-request-p (car result)))
          result
        (let ((args (h2-alists-request-arguments (car result))))
          (h2-division-with-search search
              ((step (h2-division-derive search
                                         (nth 0 args) (nth 1 args) (nth 2 args)
                                         (nth 3 args) (nth 4 args) (nth 5 args)
                                         (nth 6 args) (nth 7 args) (nth 8 args))
                     :search))
            (h2-division-index-lemmas-next
             (1- n) search (list (cons step (h2-search-search-library search))))))))))

(defun h2-division-index-lemmas (search)
  (h2-book-logic-with-saved-result search
    (h2-division-index-lemmas-next 1000000 search nil)))

(defun h2-division-explode-true-list-recognize (claim evidence search)
  (h2-division-derive search claim "TRUE-LISTP" nil nil 1 "TRUE-LISTP" (list evidence) nil 80))

(defun h2-division-make-recognizer (definitions facts repeat)
  (list :h2-division-recognizer definitions facts repeat))

(defun h2-division-recognizer-p (recognizer)
  (eq (car recognizer) :h2-division-recognizer))

(defun h2-division-recognizer-definitions (recognizer) (cadr recognizer))
(defun h2-division-recognizer-facts (recognizer) (caddr recognizer))
(defun h2-division-recognizer-repeat (recognizer) (cadddr recognizer))

(defun h2-division-recognize (recognize search claim evidence)
  (cond ((eq recognize :true-list) (h2-division-explode-true-list-recognize claim evidence search))
        ((h2-division-recognizer-p recognize)
         (h2-division-derive search claim (h2-division-recognizer-definitions recognize)
                             (h2-division-recognizer-facts recognize) nil 1
                             (h2-division-recognizer-repeat recognize) (list evidence) nil 80))
        ((consp recognize) (car recognize))
        (t (cons (list :call :recognize search claim evidence) search))))

(defun h2-division-next-recognizer (recognize)
  (if (or (eq recognize :true-list) (h2-division-recognizer-p recognize))
      recognize
    (cdr recognize)))

(defun h2-division-explode-accumulator-base-case
