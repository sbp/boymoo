           (less (proof-proof-rewrite proof less scaled '(1 2)))
           (positive-den (proof-proof-prove proof (list *h2-division-posp* den)
                                            (list iden pden) (list *h2-division-posp*)))
           (theorem (library-library-axiom lib quotient (list num den)))
           (test (h2-division-step-at theorem 1))
           (premises (proof-proof-prove proof test (list nat-num positive-den) nil))
           (niq (proof-proof-modus-ponens proof theorem premises))
           (properties (proof-proof-conjunct proof niq))
           (nat-quotient (car properties))
