(defun h2-division-floor-bounds-from-quotient (search quotient)
  (let* ((lib (h2-search-search-library search))
         (proof (library-library-proof lib))
         (x *library-x*)
         (y *library-y*)
         (zero *proof-zero*)
         (one *proof-one*)
         (name "SELF-H2-FLOOR-POSITIVE-INTEGER-BOUNDS"))
    (if (assoc-equal (proof-sym name "ACL2") (proof-proof-facts proof))
        (cons name search)
      (h2-division-with-search search
          ((types (library-library-ints lib (list x y)))
           (ix (car types))
           (iy (cadr types))
           (px (proof-proof-assume proof (library-positive x) t))
           (larger-base (proof-proof-assume proof (library-lt one y) t))
           (int-zero (library-library-type-of lib zero nil))
           (int-one (library-library-type-of lib one nil))
           (pos-one (proof-proof-prove proof (library-positive one) nil nil))
           (py (library-library-cite lib "LESS-TRANSITIVE" (list zero one y)
                                     (list int-zero int-one iy pos-one larger-base)))
           (reciprocal (list *h2-division-reciprocal* y))
           (ratio (h2-division-product x reciprocal))
           (rational-x (library-library-rational lib x (list ix)))
           (rational-y (library-library-rational lib y (list iy)))
           (rational-reciprocal
            (h2-division-floor-bounds-fraction-rule "rationalp-unary-/" (list y)
                                                   (list rational-y) lib))
           (rational-ratio
            (h2-division-floor-bounds-fraction-rule "rationalp-binary-*" (list x reciprocal)
                                                   (list rational-x rational-reciprocal) lib))
           (num (list *h2-division-numerator* ratio))
           (den (list *h2-division-denominator* ratio))
           (parts-fact (library-library-axiom lib "RATIONAL-IMPLIES1" (list ratio)))
