(defun h2-division-interrupted-p (value)
  (or (failure-p value)
      (h2-search-request-p value)
      (and (consp value) (eq (car value) :call))))

(defmacro h2-division-with-search (search bindings body)
  (if (endp bindings)
      body
    (let* ((binding (car bindings))
           (name (car binding))
           (form (cadr binding))
           (next `(h2-division-with-search ,search ,(cdr bindings) ,body)))
      (case (caddr binding)
        (:search
         `(let ((h2-division-result ,form))
            (if (h2-division-interrupted-p h2-division-result)
                (cons h2-division-result ,search)
              (let ((,name (car h2-division-result))
                    (,search (cdr h2-division-result)))
                (if (h2-division-interrupted-p ,name)
                    (cons ,name ,search)
                  ,next)))))
        (:library
         `(let ((,name ,form))
            (if (h2-division-interrupted-p ,name)
                (cons ,name ,search)
              (let ((,search (h2-search-search-with-library ,search ,name)))
                ,next))))
        (otherwise
         `(let ((,name ,form))
            (if (h2-division-interrupted-p ,name)
                (cons ,name ,search)
              ,next)))))))

(defun h2-division-derive
    (search formula definitions facts variable depth repeat seeds cases split-limit)
  (h2-book-logic-derive search formula definitions facts variable depth repeat seeds cases split-limit))

(defun h2-division-quotient-bounds-lift (nat bound opening lib template)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((term (h2-division-step-at nat 1))
         (goal (proof-subst template (list (cons *proof-result* term))))
         (pair (proof-proof-prove proof goal (list nat bound) nil))
         (reverse (proof-proof-symmetric proof opening)))
      (proof-proof-rewrite-result proof pair reverse template *proof-result*))))

(defun h2-division-quotient-bounds (search)
  (h2-division-with-search search
      ((lib (h2-division-product-order (h2-search-search-library search)) :library))
    (let* ((proof (library-library-proof lib))
           (name "SELF-H2-NONNEGATIVE-QUOTIENT-BOUNDS")
           (x *library-x*)
           (y *library-y*)
           (zero *proof-zero*)
           (one *proof-one*)
           (value (list *h2-division-quotient* x y))
           (natural (list *library-natp* x))
           (divisor (list *h2-division-posp* y))
           (precondition (proof-ite natural divisor *proof-false*))
           (template (proof-ite (list *library-natp* *proof-result*)
                                (library-le (h2-division-product y *proof-result*) x)
                                *proof-false*)))
      (if (assoc-equal (proof-sym name "ACL2") (proof-proof-facts proof))
          (cons name search)
        (h2-division-with-search search
            ((properties (proof-subst template (list (cons *proof-result* value))))
             (formula (list *library-implies* precondition properties))
             (assumed (proof-proof-assume proof precondition t))
             (premises (proof-proof-conjunct proof assumed))
             (nx (car premises))
             (py (cadr premises))
             (ix (library-library-cite lib "NATURAL-INTEGER" (list x) (list nx)))
             (bx (library-library-cite lib "NATURAL-NONNEGATIVE" (list x) (list nx)))
             (divisor-open (proof-proof-unfold proof divisor))
             (typed-positive (proof-proof-rewrite proof py divisor-open '(1)))
             (types (proof-proof-conjunct proof typed-positive))
             (iy (car types))
             (pos-y (cadr types))
             (iy-bound (library-library-cite lib "POSITIVE-NONNEGATIVE" (list y) (list iy pos-y)))
             (integers (list ix iy))
             (int-zero (library-library-type-of lib zero nil))
             (unequal (library-library-cite lib "H2-LESS-IMPLIES-UNEQUAL" (list zero y)
                                            (list int-zero pos-y)))
             (comparison (library-lt x y))
             (opening (proof-proof-unfold proof value))
             (body (h2-division-step-at opening 2))
             (test (proof-term-at body 1))
             (equality (h2-division-derive search (proof-eq test comparison) "NFIX IFIX"
                                           nil nil 1 "" (list ix iy iy-bound unequal) nil 80)
                       :search)
             (lib (h2-search-search-library search))
             (proof (library-library-proof lib))
             (opened (proof-proof-rewrite proof opening equality '(1 2 1)))
             (body (h2-division-step-at opened 2))
             (yes (proof-proof-if-true proof body))
             (base-value (proof-proof-chain proof opened (list yes)))
             (product-zero (library-library-cite lib "H2-INTEGER-ZERO-PRODUCT" (list y) (list iy)))
             (base-less (proof-proof-reflexive proof (library-lt x (h2-division-product y zero))))
             (base-less (proof-proof-rewrite proof base-less product-zero '(1 2 2)))
             (base-bound (library-library-transport-argument lib bx base-less 1))
             (nat-zero (library-library-natural lib zero))
             (base-case (h2-division-quotient-bounds-lift nat-zero base-bound base-value lib template))
             (delta (library-diff x y))
             (not-comparison (proof-proof-assume proof comparison nil))
             (comparison-form (library-library-axiom lib "<-ON-OTHERS" (list x y)))
             (nonnegative-delta (proof-proof-rewrite proof not-comparison comparison-form '(1 1)))
             (int-delta (library-library-type-of lib delta integers))
             (nat-delta (library-library-cite lib "NATURAL-FROM-BOUNDS" (list delta)
                                             (list int-delta nonnegative-delta)))
             (smaller (library-library-less-from-difference lib delta x pos-y integers))
             (int-zero (library-library-type-of lib zero nil))
             (pos-x (library-library-cite lib "WEAK-THEN-LESS" (list zero delta x)
                                          (list int-zero int-delta ix nonnegative-delta smaller)))
             (measure (list *library-nfix* x))
             (substitution (list (list x delta)))
             (descent (library-library-cite lib "NFIX-DECREASE" (list delta x)
                                           (list int-delta ix pos-x smaller)))
             (descent-test (proof-step-first descent))
             (child-formula (proof-subst formula (list (cons x delta))))
             (hypothesis (proof-ite descent-test child-formula *proof-true*))
             (assumed (proof-proof-assume proof hypothesis t))
             (recursive (proof-proof-prove-if proof assumed descent))
             (recursive-test (h2-division-step-at recursive 1))
             (recursive-premises (proof-proof-prove proof recursive-test (list nat-delta py) nil))
             (bound (proof-proof-modus-ponens proof recursive recursive-premises))
             (parts (proof-proof-conjunct proof bound))
             (nat-child (car parts))
             (child-bound (cadr parts))
             (child (h2-division-step-at nat-child 1))
             (child-int (library-library-cite lib "NATURAL-INTEGER" (list child) (list nat-child)))
             (integers (append integers (list child-int)))
             (successor (library-plus one child))
             (nat-one (library-library-natural lib one))
             (successor-nat (library-library-cite lib "NATURAL-SUM" (list one child)
                                                 (list nat-one nat-child)))
             (first-product (h2-division-product y child))
             (second-product (h2-division-product y successor))
             (distribute (library-library-axiom lib "DISTRIBUTIVITY" (list y one child)))
             (commute (library-library-axiom lib "COMMUTATIVITY-OF-*" (list y one)))
             (identity (h2-division-identity-factor lib y integers))
             (unit (proof-proof-chain proof commute (list identity)))
             (distribute (proof-proof-rewrite proof distribute unit '(1 2 1)))
             (delta-less (library-library-axiom lib "<-ON-OTHERS" (list delta first-product)))
             (root-less (library-library-axiom lib "<-ON-OTHERS" (list x second-product)))
             (root-less (proof-proof-rewrite proof root-less distribute '(1 2 1 2 1)))
             (delta-less-body (h2-division-step-at delta-less 2))
             (delta-left (proof-term-at delta-less-body 1))
             (root-less-body (h2-division-step-at root-less 2))
             (root-left (proof-term-at root-less-body 1))
             (difference (library-library-linear-equal lib delta-left root-left integers))
             (changed-delta (proof-proof-rewrite proof delta-less difference '(1 2 1)))
             (back-root (proof-proof-symmetric proof root-less))
             (compare (proof-proof-chain proof changed-delta (list back-root)))
             (successor-bound (proof-proof-rewrite proof child-bound compare '(1 1)))
             (no (proof-proof-if-false proof body))
             (recursive-value (proof-proof-chain proof opened (list no)))
             (recursive-case (h2-division-quotient-bounds-lift
                              successor-nat successor-bound recursive-value lib template))
             (branches (proof-proof-cases proof comparison base-case recursive-case))
             (case-step (h2-search-search-introduce search formula branches))
             (ordinal (library-library-cite lib "NFIX-ORDINAL" (list x) nil))
             (step (proof-proof-induct proof ordinal case-step formula measure (list substitution)))
             (lib (library-library-lemma lib "H2-NONNEGATIVE-QUOTIENT-BOUNDS" formula step nil)
                  :library))
          (cons name search))))))

(defun h2-division-multiply-ratio (search ratio divisor numerator integers pos-divisor)
  (let* ((lib (h2-search-search-library search))
         (zero *proof-zero*))
    (h2-division-with-search search
        ((type-zero (library-library-type-of lib zero nil))
         (nonzero (library-library-cite lib "H2-LESS-IMPLIES-UNEQUAL" (list zero divisor)
                                        (list type-zero pos-divisor)))
         (reverse (h2-division-derive search (proof-neg (proof-eq divisor zero)) "" nil nil 1
                                      "" (list nonzero) nil 80)
                  :search)
         (lib (h2-search-search-library search))
         (proof (library-library-proof lib))
         (inverse (library-library-axiom lib "INVERSE-OF-*" (list divisor)))
         (guard (h2-division-step-at inverse 1))
         (number (library-library-number lib divisor integers))
         (guards (proof-proof-prove proof guard (list number reverse) nil))
         (cancel (proof-proof-modus-ponens proof inverse guards))
         (value (h2-division-step-at ratio 2))
         (right (h2-division-product divisor value))
         (expanded (proof-proof-reflexive proof right))
         (ratio-back (proof-proof-symmetric proof ratio))
         (expanded (proof-proof-rewrite proof expanded ratio-back '(1 2 2)))
         (reciprocal (list *h2-division-reciprocal* divisor))
         (associate (library-library-axiom lib "ASSOCIATIVITY-OF-*"
                                           (list divisor reciprocal numerator)))
         (reassociate (proof-proof-symmetric proof associate))
         (expanded (proof-proof-chain proof expanded (list reassociate)))
         (expanded (proof-proof-rewrite proof expanded cancel '(1 2 1)))
         (unit (h2-division-identity-factor lib numerator integers))
         (step (proof-proof-chain proof expanded (list unit))))
      (cons step search))))

(defun h2-division-floor-bounds-fraction-rule (name args evidence lib)
