(in-package "BOYMOO-PROVER")
(set-verify-guards-eagerness 0)

(defconst *h2-numeric-recipes-sum* (proof-sym "SUMLIST" "ACL2"))
(defconst *h2-numeric-recipes-append* (proof-sym "BINARY-APPEND" "ACL2"))

(defun h2-numeric-recipes-positive-factorial (proof formula)
  (let* ((library (h2-modular-library proof))
         (rules (library-library-proof library)))
    (proof-with-checked-results
        ((value (h2-modular-term-at formula '(1 1)))
         (n (proof-term-at value 1))
         (opening (proof-proof-unfold rules value))
         (body (h2-modular-first-at opening '(2)))
         (test (proof-term-at body 1))
         (stopped (proof-proof-assume rules test t))
         (active (proof-proof-assume rules test nil))
         (selected (proof-proof-select rules body stopped))
         (base (proof-proof-chain rules opening (list selected)))
         (template (proof-ite (library-integer *proof-result*)
                              (library-lt *proof-zero* *proof-result*) *proof-false*))
         (at-one (proof-subst template (list (cons *proof-result* *proof-one*))))
         (unit (proof-proof-prove rules at-one nil nil))
         (reversed (proof-proof-symmetric rules base))
         (yes (proof-proof-rewrite-result rules unit reversed template *proof-result*))
         (selected (proof-proof-select rules body active))
         (step (proof-proof-chain rules opening (list selected)))
         (product (h2-modular-first-at step '(2)))
         (factors (proof-list-of-length product 3))
         (child (caddr factors))
         (predecessor (proof-term-at child 1))
         (update (list (list n predecessor)))
         (decrease (library-library-builtin library 9 n))
         (descent (proof-proof-discharge rules decrease active))
         (descent-literal (proof-step-first descent))
         (instance (proof-subst formula (h2-modular-bindings update nil)))
         (smaller (proof-ite descent-literal instance *proof-true*))
         (hypothesis (proof-proof-assume rules smaller t))
         (child-bounds (proof-proof-prove-if rules hypothesis descent))
         (parts (proof-proof-conjunct rules child-bounds))
         (child-integer (car parts))
         (child-positive (cadr parts))
         (n-integer (library-library-cite library "H2-POSITIVE-INDEX-INTEGER" (list n) (list active)))
         (n-positive (library-library-cite library "H2-POSITIVE-INDEX-POSITIVE" (list n) (list active)))
         (inputs (list n-integer child-integer))
         (n-rational (library-library-rational library n inputs))
         (child-rational (library-library-rational library child inputs))
         (positive (library-library-cite library "POSITIVE-PRODUCT" (list n child)
                                         (list n-rational child-rational n-positive child-positive)))
         (at-product (proof-subst template (list (cons *proof-result* product))))
         (integer (library-library-type-of library product inputs))
         (claim (proof-proof-prove rules at-product (list integer positive) nil))
         (reversed (proof-proof-symmetric rules step))
         (no (proof-proof-rewrite-result rules claim reversed template *proof-result*))
         (ordinal (library-library-builtin library 1 n))
         (cases (proof-proof-cases rules test yes no)))
      (proof-proof-induct rules ordinal cases formula (list *library-count* n) (list update)))))

(defun h2-numeric-recipes-factorial-theorem (proof label formula)
  (if (equal label "FACTORIAL-POSITIVE-INTEGER")
      (proof-with-checked-results ((step (h2-numeric-recipes-positive-factorial proof formula)))
        (cons step proof))
    (let* ((library (h2-modular-library proof))
           (rules (library-library-proof library)))
      (proof-with-checked-results
          ((value (h2-modular-term-at formula '(1 1)))
           (n (proof-term-at value 1))
           (positive (proof-proof-fact rules (proof-sym "FACTORIAL-POSITIVE-INTEGER" "ACL2")
                                       (list (list (proof-sym "N" "ACL2") n)))))
        (if (equal label "FACTORIAL-NON-NEGATIVE")
            (proof-with-checked-results
                ((discrete (proof-proof-fact rules "integer-discrete" (list (list *library-x* value))))
                 (step (proof-proof-modus-ponens rules discrete positive)))
              (cons step proof))
          (proof-with-checked-results
              ((parts (proof-proof-conjunct rules positive))
               (typed (car parts))
               (strict (cadr parts))
               (bound (library-library-cite library "POSITIVE-NONNEGATIVE" (list value)
                                            (list typed strict))))
            (h2-modular-derive proof formula "ABS MINUSP" nil (list typed bound) nil)))))))

(defun h2-numeric-recipes-factorial-quotient (proof formula)
  (let* ((library (h2-modular-library proof))
         (rules (library-library-proof library))
         (zero *proof-zero*)
         (one *proof-one*))
    (h2-modular-with-search-results
        ((parts (h2-modular-tail-of-size formula 2))
         (premise (car parts))
         (equation (cadr parts))
         (assumed (proof-proof-assume rules premise t))
         (types (proof-proof-conjunct rules assumed))
         (typed (car types))
         (lower (cadr types))
         (n (h2-modular-first-at typed '(1)))
         (izero (library-library-type-of library zero nil))
         (ione (library-library-type-of library one nil))
         (zero-one (proof-proof-prove rules (library-lt zero one) nil nil))
         (positive (library-library-cite library "LESS-THEN-WEAK" (list zero one n)
                                         (list izero ione typed zero-one lower)))
         (factorial (h2-modular-term-at equation '(1 1)))
         (opening (proof-proof-unfold rules factorial))
         (stopping (h2-modular-first-at opening '(2 1)))
         (running-result (h2-modular-derive proof (proof-neg stopping) "ZP" nil (list typed positive) nil))
         (running (car running-result))
         (proof (cdr running-result))
         (search (h2-recipes-recipes-search proof))
         (library (h2-modular-library proof))
         (rules (library-library-proof library))
         (opened (h2-book-logic-select-body search opening running))
         (earlier (h2-modular-first-at opened '(2 2)))
         (argument (proof-term-at earlier 1))
         (verified (proof-proof-fact rules (proof-sym "FACTORIAL-POSITIVE-INTEGER" "ACL2")
                                     (list (list (proof-sym "N" "ACL2") argument))))
         (parts (proof-proof-conjunct rules verified))
         (prior-type (car parts))
         (prior-positive (cadr parts))
         (izero (library-library-type-of library zero nil))
         (nonzero (library-library-cite library "H2-LESS-IMPLIES-UNEQUAL" (list zero earlier)
                                        (list izero prior-positive)))
         (lhs (proof-term-at equation 1))
         (reflexive (proof-proof-reflexive rules lhs))
         (quotient (proof-proof-rewrite rules reflexive opened '(1 2 1)))
         (commute (library-library-axiom library "COMMUTATIVITY-OF-*" (list n earlier)))
         (quotient (proof-proof-rewrite rules quotient commute '(1 2 1)))
         (earlier-number (library-library-number library earlier (list prior-type)))
         (recovered (h2-products-recover-factor search earlier n earlier-number nonzero))
         (quotient (proof-proof-chain rules quotient (list recovered)))
         (n-number (library-library-number library n (list typed)))
         (finalize (library-library-cite library "H2-NUMBER-FIX" (list n) (list n-number)))
         (result (proof-proof-chain rules quotient (list finalize)))
         (step (h2-modular-introduce proof formula result)))
      (cons step proof))))

(defun h2-numeric-recipes-folded-request-p (value)
  (and (consp value) (eq (car value) :h2-numeric-recipes-folded-induction)))

(defun h2-numeric-recipes-folded-request-args (request)
  (cdr request))

(defun h2-numeric-recipes-numeric-theorem (proof label formula)
  (cond
    ((member-equal label '("FACTORIAL-POSITIVE-INTEGER" "FACTORIAL-NON-NEGATIVE" "ABS-FACTORIAL"))
     (h2-numeric-recipes-factorial-theorem proof label formula))
    ((equal label "FACTORIAL-N/N-1")
     (h2-numeric-recipes-factorial-quotient proof formula))
    ((equal label "RATIONALP-SUMLIST")
     (h2-recipes-recipes-derive proof formula "SUMLIST RATIONAL-LISTP"
                                '("rationalp-binary-+") "X" 1 "" nil nil 80))
    ((equal label "SUMLIST-APPEND")
     (h2-modular-with-search-results
         ((claim (list *library-numberp* (list *h2-numeric-recipes-sum* *library-y*)))
          (auxiliary (h2-recipes-recipes-auxiliary proof "SUMLIST-NUMBER" claim
                                                    "SUMLIST" '("SELF-SUM-NUMBER") nil 1 "" nil nil 80))
          (typed (car auxiliary))
          (proof (cdr auxiliary))
          (definitions (list *h2-numeric-recipes-append* *h2-numeric-recipes-sum*))
          (search (h2-search-search-configure
                   (h2-recipes-recipes-search proof) definitions
                   (list "built-in-clause-3" typed "SELF-H2-NUMBER-ADD-ZERO-LEFT" "ASSOCIATIVITY-OF-+")
                   nil 80)))
       (cons (list :h2-numeric-recipes-folded-induction formula *library-x* definitions)
             (h2-recipes-recipes-with-search proof search))))
    (t (cons nil proof))))
