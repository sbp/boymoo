(in-package "BOYMOO-PROVER")

(set-verify-guards-eagerness 0)

(defun product-arithmetic-product (a b)
  (list *proof-times* a b))

(defun product-arithmetic-conjunction (terms)
  (cond ((endp terms) '(:failure "failure" ""))
        ((endp (cdr terms)) (car terms))
        (t (proof-ite (car terms) (product-arithmetic-conjunction (cdr terms)) *proof-false*))))

(defun product-arithmetic-conjoin (lib proofs)
  (cond
   ((endp proofs) '(:failure "failure" ""))
   ((endp (cdr proofs)) (car proofs))
   (t
    (let ((proof (library-library-proof lib))
          (left (car proofs)))
      (proof-with-checked-results
       ((right (product-arithmetic-conjoin lib (cdr proofs)))
        (left-first (proof-step-first left))
        (right-first (proof-step-first right))
        (formula (proof-ite left-first right-first *proof-false*))
        (selected (proof-proof-select proof formula left)))
       (proof-proof-transport proof right selected))))))

(defun product-arithmetic-at-path (path node)
  (declare (xargs :measure (acl2-count path)))
  (if (endp path)
      node
    (proof-with-checked-results ((child (proof-term-at node (car path))))
     (product-arithmetic-at-path (cdr path) child))))

(defun product-arithmetic-product-form-at (place proof)
  (proof-with-checked-results ((first (proof-step-first proof)))
   (product-arithmetic-at-path (cdr place) first)))

(defun product-arithmetic-associate-next (lib step place)
  (proof-with-checked-results ((node (product-arithmetic-product-form-at place step)))
   (if (not (proof-is-call node *proof-times*))
       (list :done step)
     (proof-with-checked-results ((arguments (proof-list-of-length (cdr node) 2)))
      (let ((left (car arguments))
            (right (cadr arguments)))
        (if (proof-is-call left *proof-times*)
            (proof-with-checked-results
             ((associate (library-library-axiom lib "ASSOCIATIVITY-OF-*" (append (cdr left) (list right))))
              (step (proof-proof-rewrite (library-library-proof lib) step associate place)))
             (list :next step place))
          (list :next step (append place '(2)))))))))

(defun product-arithmetic-swap-factors (lib left right rest)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results ((swap (library-library-axiom lib "COMMUTATIVITY-OF-*" (list left right))))
     (if (equal right rest)
         swap
       (proof-with-checked-results
        ((tail (proof-term-at rest 2))
         (grouped (library-library-axiom lib "ASSOCIATIVITY-OF-*" (list left right tail)))
         (grouped (proof-proof-symmetric proof grouped))
         (grouped (proof-proof-rewrite proof grouped swap '(1 2 1)))
         (associate (library-library-axiom lib "ASSOCIATIVITY-OF-*" (list right left tail))))
        (proof-proof-chain proof grouped (list associate)))))))

(defun product-arithmetic-sort-next (lib step place changed)
  (proof-with-checked-results ((node (product-arithmetic-product-form-at place step)))
   (if (not (proof-is-call node *proof-times*))
       (if changed
           (list :next step '(1 2) nil)
         (list :done step))
     (proof-with-checked-results
      ((arguments (proof-list-of-length (cdr node) 2))
       (left (car arguments))
       (rest (cadr arguments))
       (right (if (proof-is-call rest *proof-times*) (proof-term-at rest 1) rest))
       (left-text (proof-write left))
       (right-text (proof-write right)))
      (let ((next (append place '(2))))
        (if (string< right-text left-text)
            (proof-with-checked-results
             ((swap (product-arithmetic-swap-factors lib left right rest))
              (step (proof-proof-rewrite (library-library-proof lib) step swap place)))
             (list :next step next t))
          (list :next step next changed)))))))

(defun product-arithmetic-normalize (n lib phase task)
  (declare (xargs :measure (nfix n)))
  (cond
   ((zp n) '(:failure "Fuel" "product-arithmetic-normalize"))
   ((failure-p task) task)
   ((eq (car task) :done) (cadr task))
   (t
    (product-arithmetic-normalize
     (1- n) lib phase
     (if (eq phase :associate)
         (product-arithmetic-associate-next lib (cadr task) (caddr task))
       (product-arithmetic-sort-next lib (cadr task) (caddr task) (cadddr task)))))))

(defun product-arithmetic-product-form (lib term)
  (proof-with-checked-results
   ((step (lemmas-slice-library-reflexive lib term))
    (step (product-arithmetic-normalize 1000000 lib :associate (list :next step '(1 2))))
    (step (product-arithmetic-normalize 1000000 lib :sort (list :next step '(1 2) nil))))
   (proof-proof-tidy (library-library-proof lib) step)))

(defun product-arithmetic-product-equal (lib left right)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
     ((a (product-arithmetic-product-form lib left))
      (b (product-arithmetic-product-form lib right))
      (first-a (proof-step-first a))
      (normal-a (proof-term-at first-a 2))
      (first-b (proof-step-first b))
      (normal-b (proof-term-at first-b 2)))
     (if (not (equal normal-a normal-b))
         *terms-different-normal-forms*
       (proof-with-checked-results ((symmetric (proof-proof-symmetric proof b)))
        (proof-proof-chain proof a (list symmetric)))))))

(defun product-arithmetic-one-product (lib value types)
  (let* ((fix (proof-sym "FIX" "ACL2"))
         (fixed (list fix value)))
    (proof-with-checked-results
     ((numeric (lemmas-slice-library-number lib value types))
      (lib (cdr numeric))
      (proof (library-library-proof lib))
      (identity (proof-proof-simplify proof fixed (list (car numeric)) (list fix)))
      (one (library-library-axiom lib "UNICITY-OF-1" (list value)))
      (step (proof-proof-chain proof one (list identity))))
     (cons step lib))))

(defun product-arithmetic-positive-nonzero (lib value step)
  (let ((test (proof-eq value *proof-zero*))
        (proof (library-library-proof lib)))
    (proof-with-checked-results
     ((assumed (proof-proof-assume proof test t))
      (impossible (proof-proof-rewrite proof step assumed '(1 2)))
      (false (proof-proof-compute proof (library-lt *proof-zero* *proof-zero*) *proof-nil*))
      (impossible (proof-proof-rewrite proof impossible false '(1)))
      (impossible (proof-proof-tidy proof impossible)))
     (proof-proof-front proof impossible (proof-neg test)))))

(defun product-arithmetic-zero-product-lemma (lib)
  (let ((name "PRODUCT-ZERO"))
    (if (lemmas-has-fact lib (lemmas-self-name name))
        lib
      (let* ((proof (library-library-proof lib))
             (leaf (product-arithmetic-product *library-x* *proof-zero*)))
        (proof-with-checked-results
         ((integers (library-library-ints lib (list *library-x*)))
          (split (library-library-axiom lib "DISTRIBUTIVITY" (list *library-x* *proof-zero* *proof-zero*)))
          (zero (proof-proof-compute proof (library-plus *proof-zero* *proof-zero*) 0))
          (split (proof-proof-rewrite proof split zero '(1 1 2)))
          (lifted (lemmas-slice-library-reflexive lib (library-plus leaf (library-minus leaf))))
          (lifted (proof-proof-rewrite proof lifted split '(1 2 1)))
          (inverse (library-library-axiom lib "INVERSE-OF-+" (list leaf)))
          (lifted (proof-proof-rewrite proof lifted inverse '(1 1)))
          (linear (library-library-linear-equal lib (library-plus (library-plus leaf leaf) (library-minus leaf))
                                               leaf integers))
          (step (proof-proof-chain proof lifted (list linear)))
          (step (proof-proof-symmetric proof step)))
         (library-library-lemma lib name (proof-eq leaf *proof-zero*) step
                                (list (proof-neg (library-integer *library-x*)))))))))

(defun product-arithmetic-product-zero (lib value integral)
  (proof-with-checked-results
   ((lib (product-arithmetic-zero-product-lemma lib))
    (step (library-library-cite lib "PRODUCT-ZERO" (list value) (list integral))))
   (cons step lib)))

(defun product-arithmetic-minus-product-lemma (lib)
  (let ((name "PRODUCT-NEGATION"))
    (if (lemmas-has-fact lib (lemmas-self-name name))
        lib
      (let* ((proof (library-library-proof lib))
             (left (product-arithmetic-product *library-x* *library-y*))
             (right (product-arithmetic-product *library-x* (library-minus *library-y*)))
             (minus-left (library-minus left)))
        (proof-with-checked-results
         ((types (library-library-ints lib (list *library-x* *library-y*)))
          (inverse (library-library-axiom lib "DISTRIBUTIVITY" (list *library-x* *library-y* (library-minus *library-y*))))
          (sum (library-library-axiom lib "INVERSE-OF-+" (list *library-y*)))
          (inverse (proof-proof-rewrite proof inverse sum '(1 1 2)))
          (zero (product-arithmetic-product-zero lib *library-x* (car types)))
          (lib (cdr zero))
          (proof (library-library-proof lib))
          (inverse (proof-proof-rewrite proof inverse (car zero) '(1 1)))
          (equation (lemmas-slice-library-reflexive lib (library-plus *proof-zero* minus-left)))
          (equation (proof-proof-rewrite proof equation inverse '(1 2 1)))
          (integer (lemmas-slice-library-type-of lib minus-left types))
          (lib (cdr integer))
          (proof (library-library-proof lib))
          (left-zero (library-library-cite lib "ADD-ZERO-LEFT" (list minus-left) (list (car integer))))
          (equation (proof-proof-rewrite proof equation left-zero '(1 1)))
          (linear (library-library-linear-equal lib (library-plus (library-plus left right) minus-left) right types))
          (equation (proof-proof-chain proof equation (list linear)))
          (step (proof-proof-symmetric proof equation)))
         (library-library-lemma lib name (proof-eq right minus-left) step
                                (library-guards (list (library-integer *library-x*) (library-integer *library-y*)))))))))

(defun product-arithmetic-product-difference (lib a b factor types)
  (proof-with-checked-results
   ((lib (product-arithmetic-minus-product-lemma lib))
    (expansion (library-library-axiom lib "DISTRIBUTIVITY" (list factor b (library-minus a))))
    (factor-type (lemmas-slice-library-type-of lib factor types))
    (a-type (lemmas-slice-library-type-of (cdr factor-type) a types))
    (lib (cdr a-type))
    (signs (library-library-cite lib "PRODUCT-NEGATION" (list factor a) (list (car factor-type) (car a-type))))
    (proof (library-library-proof lib))
    (rewritten (proof-proof-rewrite proof expansion signs '(1 2 2)))
    (step (proof-proof-tidy proof rewritten)))
   (cons step lib)))

(defun product-arithmetic-positive-product (lib a b types pa pb)
  (proof-with-checked-results
   ((axiom (library-library-axiom lib "POSITIVE" (list a b)))
    (parts (proof-proof-conjunct (library-library-proof lib) axiom))
    (law (cadr parts))
    (first (proof-step-first law))
    (condition (proof-term-at first 1))
    (a-rational (lemmas-slice-library-rational lib a types))
    (b-rational (lemmas-slice-library-rational (cdr a-rational) b types))
    (lib (cdr b-rational))
    (proof (library-library-proof lib))
    (premise (proof-proof-prove proof condition (list (car a-rational) (car b-rational) pa pb) nil))
    (step (proof-proof-modus-ponens proof law premise)))
   (cons step lib)))

(defun product-arithmetic-comparison (lib a b types)
  (proof-with-checked-results
   ((a-type (lemmas-slice-library-type-of lib a types))
    (b-type (lemmas-slice-library-type-of (cdr a-type) b types))
    (lib (cdr b-type))
    (step (library-library-cite lib "LESS-DIFFERENCE" (list a b) (list (car a-type) (car b-type)))))
   (cons step lib)))

(defun product-arithmetic-step-guards (proofs)
  (if (endp proofs)
      nil
    (proof-with-checked-results ((first (proof-step-first (car proofs)))
                  (rest (product-arithmetic-step-guards (cdr proofs))))
     (cons (proof-neg first) rest))))

(defun product-arithmetic-product-order-lemma (lib)
  (let ((name "PRODUCT-STRICT-ORDER"))
    (if (lemmas-has-fact lib (lemmas-self-name name))
        lib
      (let* ((proof (library-library-proof lib))
             (x *library-x*)
             (y *library-y*)
             (z *library-z*))
        (proof-with-checked-results
         ((types (library-library-ints lib (list x y z)))
          (greater (proof-proof-assume proof (library-lt x y) t))
          (factor (proof-proof-assume proof (library-positive z) t))
          (comparison (library-library-comparison lib x y types))
          (delta (proof-proof-rewrite proof greater comparison '(1)))
          (delta (proof-proof-tidy proof delta))
          (positive-delta (product-arithmetic-positive-product lib z (library-diff y x) types factor delta))
          (difference (product-arithmetic-product-difference (cdr positive-delta) x y z types))
          (lib (cdr difference))
          (proof (library-library-proof lib))
          (result (proof-proof-rewrite proof (car positive-delta) (car difference) '(1 2)))
          (result (proof-proof-tidy proof result))
          (comparison (library-library-comparison lib (product-arithmetic-product z x)
                                                  (product-arithmetic-product z y) types))
          (strict (proof-proof-transport proof result comparison))
          (first (proof-step-first strict))
          (guards (product-arithmetic-step-guards (append types (list factor greater)))))
         (library-library-lemma lib name first strict guards))))))

(defun product-arithmetic-product-order (lib a b factor types strict positive-factor)
  (let ((values (list a b factor)))
    (proof-with-checked-results
     ((lib (product-arithmetic-product-order-lemma lib))
      (integers (lemmas-slice-library-types lib values types))
      (lib (cdr integers))
      (step (library-library-cite lib "PRODUCT-STRICT-ORDER" values
                                  (append (car integers) (list positive-factor strict)))))
     (cons step lib))))

(defun product-arithmetic-reflect-sign-lemma (lib name)
  (let* ((proof (library-library-proof lib))
         (x *library-x*)
         (y *library-y*)
         (xy (product-arithmetic-product x y))
         (same (proof-eq y *proof-zero*)))
    (proof-with-checked-results
     ((ints (library-library-ints lib (list x y)))
      (px (proof-proof-assume proof (library-positive x) t))
      (pxy (proof-proof-assume proof (library-positive xy) t))
      (zero (product-arithmetic-product-zero lib x (car ints)))
      (lib (cdr zero))
      (proof (library-library-proof lib))
      (small (proof-proof-assume proof (library-lt y *proof-zero*) t))
      (bad (product-arithmetic-product-order lib y *proof-zero* x ints small px))
      (lib (cdr bad))
      (proof (library-library-proof lib))
      (bad (proof-proof-rewrite proof (car bad) (car zero) '(1 2)))
      (bad (proof-proof-tidy proof bad))
      (int-zero (lemmas-slice-library-type-of lib *proof-zero* nil))
      (int-xy (lemmas-slice-library-type-of (cdr int-zero) xy ints))
      (lib (cdr int-xy))
      (proof (library-library-proof lib))
      (opposite (library-library-cite lib "LESS-TO-WEAK" (list *proof-zero* xy)
                                      (list (car int-zero) (car int-xy) pxy)))
      (cut (proof-proof-cut proof bad opposite))
      (small-first (proof-step-first small))
      (bound (proof-proof-front proof cut (proof-neg small-first)))
      (same-assumed (proof-proof-assume proof same t))
      (impossible (proof-proof-rewrite proof pxy same-assumed '(1 2 2)))
      (impossible (proof-proof-rewrite proof impossible (car zero) '(1 2)))
      (false (proof-proof-compute proof (library-lt *proof-zero* *proof-zero*) *proof-nil*))
      (impossible (proof-proof-rewrite proof impossible false '(1)))
      (impossible (proof-proof-tidy proof impossible))
      (nonzero (proof-proof-front proof impossible (proof-neg same)))
      (positive (lemmas-positive-nonzero-integer lib y (cadr ints) nonzero bound))
      (first (proof-step-first (car positive)))
      (guards (product-arithmetic-step-guards (append ints (list px pxy)))))
     (library-library-lemma (cdr positive) name first (car positive) guards))))

(defun product-arithmetic-reflect-positive-product (lib value factor types positive-term positive-factor)
  (let ((name "PRODUCT-REFLECTS-SIGN")
        (values (list factor value)))
    (proof-with-checked-results
     ((lib (if (lemmas-has-fact lib (lemmas-self-name name))
               lib
             (product-arithmetic-reflect-sign-lemma lib name)))
      (integers (lemmas-slice-library-types lib values types))
      (lib (cdr integers))
      (step (library-library-cite lib name values (append (car integers) (list positive-factor positive-term)))))
     (cons step lib))))

(defun product-arithmetic-reflect-product-order (lib a b factor types strict positive-factor)
  (proof-with-checked-results
   ((comparison (product-arithmetic-comparison lib (product-arithmetic-product factor a)
                                               (product-arithmetic-product factor b) types))
    (lib (cdr comparison))
    (proof (library-library-proof lib))
    (delta (proof-proof-rewrite proof strict (car comparison) '(1)))
    (delta (proof-proof-tidy proof delta))
    (difference (product-arithmetic-product-difference lib a b factor types))
    (expanded (library-library-transport-argument (cdr difference) delta (car difference) 2))
    (signed (product-arithmetic-reflect-positive-product (cdr difference) (library-diff b a) factor
                                                         types expanded positive-factor))
    (comparison (product-arithmetic-comparison (cdr signed) a b types))
    (lib (cdr comparison))
    (step (proof-proof-transport (library-library-proof lib) (car signed) (car comparison))))
   (cons step lib)))
