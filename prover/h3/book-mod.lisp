(defun h3-book-mod-evidence-step (evidence term)
  (let ((entry (assoc-equal term evidence)))
    (if entry
        (cdr entry)
      '(:failure "failure" ""))))

(defun h3-book-mod-mod-floor-zero (lib call product-zero x-numeric)
  (proof-with-checked-results
      ((dividend (proof-term-at call 1))
       (proof (library-library-proof lib))
       (step (proof-proof-unfold proof call))
       (step (proof-proof-rewrite proof step product-zero '(1 2 2 1)))
       (minus-zero (proof-proof-compute proof (library-minus *proof-zero*) 0))
       (step (proof-proof-rewrite proof step minus-zero '(1 2 2)))
       (swap (library-library-axiom lib "COMMUTATIVITY-OF-+" (list dividend *proof-zero*)))
       (unit (library-library-axiom lib "UNICITY-OF-0" (list dividend)))
       (step (proof-proof-chain proof step (list swap unit))))
    (if (h3-book-rounding-argument-present-p x-numeric)
        (proof-with-checked-results
            ((fixed (h3-book-arithmetic-fix-value lib dividend x-numeric)))
          (proof-proof-chain proof step (list fixed)))
      step)))

