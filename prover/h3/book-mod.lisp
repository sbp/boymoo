(defun h3-book-mod-mod-rational-goal (lib goal given)
  (h3-book-rounding-with-library lib
      ((call (proof-term-at goal 1))
       (context (h3-book-order-bounds-init lib (list given)))
       (i (proof-term-at call 1))
       (test (list *library-rationalp* i))
       (rational (proof-proof-assume (library-library-proof lib) test t))
       ((yes lib) (h3-book-mod-remainder-rational-with-library lib call rational nil))
       (excluded (h3-book-mod-evidence-step (h3-book-order-bounds-evidence context)
                                             (proof-neg (list *h3-book-signs-complexp* i))))
       (proof (library-library-proof lib))
       (not-rational (proof-proof-assume proof test nil))
       (missing (h3-book-floor-nonnumeric-given-noncomplex lib excluded not-rational))
       (zero (h3-book-mod-mod-zero-dividend lib call missing))
       (integer-zero (library-library-axiom lib "INTEGER-0" nil))
       (rational-zero (h3-book-numerator-as-rational lib integer-zero))
       (no (library-library-transport-argument lib rational-zero zero 1))
       (step (proof-proof-cases proof test yes no)))
    (cons step lib)))

(defun h3-book-mod-first-equation-with-call (evidence head)
  (cond
   ((endp evidence) '(:failure "failure" ""))
   ((not (proof-is-call (caar evidence) *proof-equal*))
    (h3-book-mod-first-equation-with-call (cdr evidence) head))
   (t (proof-with-checked-results ((left (h3-book-rounding-step-at (cdar evidence) 1)))
        (if (proof-is-call left head)
            (cdar evidence)
          (h3-book-mod-first-equation-with-call (cdr evidence) head))))))

(defun h3-book-mod-reconstruct-with-context (lib call context)
  (proof-with-checked-results
      ((dividend (proof-term-at call 1))
