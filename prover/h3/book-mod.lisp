  (proof-with-checked-results
      ((parts (proof-list-of-length call 3))
       (j (caddr parts))
       (floor (list *h3-book-floor-floor* (cadr parts) j))
       (product-zero
        (if (h3-book-rounding-argument-present-p zero)
            (proof-with-checked-results
                ((proof (library-library-proof lib))
                 (identity (proof-proof-reflexive proof (list *proof-times* floor j)))
                 (expanded (proof-proof-rewrite proof identity zero '(1 2 2)))
                 (vanished (h3-event-counts-multiply-zero lib floor)))
              (proof-proof-chain proof expanded (list vanished)))
          (h3-event-counts-multiply-zero lib floor))))
    (h3-book-mod-mod-floor-zero lib call product-zero x-numeric)))

