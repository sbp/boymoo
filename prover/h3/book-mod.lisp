                 (h3-book-order-bounds-with-library context lib) dividend)))
    (h3-book-mod-remainder-reconstruction-with-library lib call numeric)))

(defun h3-book-mod-operand-proof (lib term context operation)
  (if (eq operation :reconstruct)
      (h3-book-mod-reconstruct-with-context lib term context)
    (cons (h3-book-order-bounds-rational context term) lib)))

; Try the proof for a third operand before rejecting an oversized operand list.
(defun h3-book-mod-prove-two-operands (lib terms context operation)
  (if (endp terms)
      (cons '(:failure "failure" "") lib)
    (h3-book-rounding-with-library lib
        (((first lib) (h3-book-mod-operand-proof lib (car terms) context operation)))
      (if (endp (cdr terms))
          (cons '(:failure "failure" "") lib)
        (h3-book-rounding-with-library lib
            (((second lib) (h3-book-mod-operand-proof lib (cadr terms) context operation)))
          (if (endp (cddr terms))
              (cons (list first second) lib)
            (h3-book-rounding-with-library lib
                (((extra lib) (h3-book-mod-operand-proof lib (caddr terms) context operation)))
              (cons '(:failure "failure" "") lib))))))))

(defun h3-book-mod-floor-and-remainder-equality (lib given)
  (h3-book-rounding-with-library lib
      ((context (h3-book-order-bounds-init lib (list given)))
       (evidence (h3-book-order-bounds-evidence context))
       (same-floor (h3-book-mod-first-equation-with-call evidence *h3-book-rounding-fl*))
       (same-mod (h3-book-mod-first-equation-with-call evidence *h3-book-mod-mod*))
       (formula (proof-step-first same-mod))
       ((steps lib) (h3-book-mod-prove-two-operands lib (cdr formula) context :reconstruct))
       (left (car steps))
       (right (cadr steps))
       (proof (library-library-proof lib))
       (term (h3-book-rounding-step-at left 1))
       (aligned (proof-proof-reflexive proof term))
       (aligned (proof-proof-rewrite proof aligned same-floor '(1 2 1 2)))
       (aligned (proof-proof-rewrite proof aligned same-mod '(1 2 2)))
       (reversed (proof-proof-symmetric proof left))
       (step (proof-proof-chain proof reversed (list aligned right))))
    (cons step lib)))

(defun h3-book-mod-by-one (lib goal given)
  (proof-with-checked-results
      ((call (proof-term-at goal 1))
       (x (proof-term-at call 1))
       (rational (h3-book-numerator-as-rational lib given))
       (typed (h3-book-signs-number lib rational))
       (ratio (h3-book-floor-ratio-by-one lib x typed))
       (ratio-int (library-library-transport-argument lib given ratio 1))
       (one-numeric (h3-book-arithmetic-typed-number lib *proof-one*))
       (search (h3-rewrite-search-init lib nil nil nil 150 nil))
       (nonzero (car (h3-rewrite-search-prove search (proof-neg (proof-eq *proof-one* *proof-zero*)) nil)))
       (step (h3-book-mod-mod-exact-if-integer-ratio lib call typed one-numeric nonzero ratio-int)))
    (cons step lib)))

(defun h3-book-mod-multiple (lib goal given)
  (proof-with-checked-results
      ((call (proof-term-at goal 1))
       (parts (h3-book-rounding-tail-of-size call 2))
       (i (car parts))
       (j (cadr parts))
       (context (h3-book-order-bounds-init lib (list given)))
       (evidence (h3-book-order-bounds-evidence context))
       (nonzero (h3-rewrite-search-known (h3-book-order-bounds-search context)
                                         (proof-neg (proof-eq j *proof-zero*)) evidence))
       (whole (h3-book-mod-evidence-step evidence
                                         (list *proof-integerp* (h3-book-floor-floor-ratio i j))))
       (i-numeric (h3-book-order-bounds-numeric context i))
       (j-numeric (h3-book-order-bounds-numeric context j))
       (step (h3-book-mod-mod-exact-if-integer-ratio lib call i-numeric j-numeric nonzero whole)))
    (cons step lib)))

(defun h3-book-mod-first-remainder-call (terms)
  (cond ((endp terms) '(:failure "failure" ""))
        ((proof-is-call (car terms) *h3-book-mod-mod*) (car terms))
        (t (h3-book-mod-first-remainder-call (cdr terms)))))

(defun h3-book-mod-positive-bounds-goal (lib goal given)
  (proof-with-checked-results
      ((relation (if (proof-is-call goal *proof-if*) (proof-term-at goal 1) goal))
       (relation (if (proof-is-call relation *proof-not*) (proof-term-at relation 1) relation))
       (call (if (integerp relation)
                 '(:failure "failure" "")
               (h3-book-mod-first-remainder-call (cdr relation))))
       (context (h3-book-order-bounds-init lib (list given))))
    (h3-book-mod-mod-bound-goal-with-library lib goal context call)))

(defun h3-book-mod-nonpositive-goal (lib goal given)
  (h3-book-rounding-with-library lib
      ((conditional (proof-is-call goal *proof-if*))
       (bound (if conditional (proof-term-at goal 2) goal))
       (comparison (proof-term-at bound 1))
       (call (proof-term-at comparison 2))
       (context (h3-book-order-bounds-init lib (list given)))
       ((types lib) (if (integerp call)
                        '(:failure "failure" "")
                      (h3-book-mod-prove-two-operands lib (cdr call) context :rational)))
       (i-type (car types))
       (j-type (cadr types))
       (j (proof-term-at call 2))
       ((negative context)
        (h3-book-order-bounds-bound-with-bounds context (library-lt j *proof-zero*)))
       ((bounds lib) (h3-book-mod-remainder-bounds-with-library lib call i-type j-type negative -1))
       (nonpositive (car bounds)))
    (if conditional
        (h3-book-rounding-with-library lib
            (((rational lib) (h3-book-mod-remainder-rational-with-library lib call i-type j-type))
             (step (h3-book-floor-conjunct-proof lib (list rational nonpositive))))
          (cons step lib))
      (cons nonpositive lib))))

(defun h3-book-mod-prove-guarded (lib name goal given)
  (cond
   ((equal name "MOD-WITH-X-A-NON-ACL2-NUMBER-IS-ZERO")
    (proof-with-checked-results
        ((call (proof-term-at goal 1))
         (step (h3-book-mod-mod-zero-dividend lib call given)))
      (cons step lib)))
   ((equal name "MOD-WHEN-Y-IS-NOT-AN-ACL2-NUMBERP")
    (proof-with-checked-results
        ((call (proof-term-at goal 1))
         (floor (cons *h3-book-floor-floor* (cdr call)))
         (j (proof-term-at call 2))
         (rule (library-library-axiom lib "DEFAULT-*-2" (list floor j)))
         (zero (proof-proof-modus-ponens (library-library-proof lib) rule given))
         (step (h3-book-mod-mod-floor-zero lib call zero nil)))
      (cons step lib)))
   ((member-equal name '("MOD-INTEGERP" "INTEGERP-MOD"))
    (h3-book-mod-mod-integer-goal lib goal given))
   ((member-equal name '("RATIONALP-MOD" "RATIONALP-MOD-CASE-SPLIT"))
    (proof-with-checked-results
        ((call (proof-term-at goal 1))
         (context (h3-book-order-bounds-init lib (list given)))
         (i (proof-term-at call 1))
         (rational (h3-book-order-bounds-rational context i)))
      (h3-book-mod-remainder-rational-with-library lib call rational nil)))
   ((member-equal name '("MOD-RATIONAL-WHEN-Y-IS-RATIONAL-REWRITE" "MOD-INTEGERP-2"))
    (proof-with-checked-results ((context (h3-book-order-bounds-init lib (list given))))
      (h3-book-mod-mod-type-equivalence-with-library lib goal context)))
   ((equal name "MOD-RATIONALP")
    (h3-book-mod-mod-rational-goal lib goal given))
   ((member-equal name '("NATP-MOD" "NATP-MOD-REWRITE"))
    (proof-with-checked-results
        ((call (proof-term-at goal 1))
         (context (h3-book-order-bounds-init lib (list given))))
      (h3-book-mod-mod-natural-with-library lib call context)))
   ((equal name "MOD-DEF")
    (proof-with-checked-results
        ((call (proof-term-at goal 1))
         (equality (h3-book-mod-mod-using-fl lib call))
         (body (h3-book-rounding-step-at equality 2))
         (target (proof-term-at goal 2))
         (ordered (h3-book-arithmetic-associative-equal lib body target))
         (step (proof-proof-chain (library-library-proof lib) equality (list ordered))))
      (cons step lib)))
   ((member-equal name '("MOD-FL-2" "QUOT-MOD"))
    (if (not (assoc-equal *h3-book-rounding-fl*
                          (proof-proof-definitions (library-library-proof lib))))
        *h3-rewrite-unproved*
      (proof-with-checked-results
          ((left (proof-term-at goal 1))
           (call (proof-term-at left 2))
           (context (h3-book-order-bounds-init lib (list given))))
        (h3-book-mod-reconstruct-with-context lib call context))))
   ((equal name "FL-MOD-EQUAL")
    (h3-book-mod-floor-and-remainder-equality lib given))
   ((equal name "MOD-BY-1")
    (h3-book-mod-by-one lib goal given))
   ((equal name "MOD-MULT-OF-N")
    (h3-book-mod-multiple lib goal given))
   ((member-equal name *h3-book-mod-mod-positive-bounds*)
    (h3-book-mod-positive-bounds-goal lib goal given))
   ((member-equal name '("MOD-NON-POSITIVE" "MOD-NON-POSITIVE-TYPE-PRESCRIPTION"))
    (h3-book-mod-nonpositive-goal lib goal given))
   (t (cons nil lib))))

(defun h3-book-mod-mod-theorem-with-library (lib name formula)
  (h3-book-rounding-with-library lib
      ((implies (proof-is-call formula *library-implies*))
       (parts (and implies (proof-list-of-length (cdr formula) 2)))
       (guard (car parts))
       (goal (if implies (cadr parts) formula)))
    (cond
     ((member-equal name '("MOD-ACL2-NUMBERP" "MOD-ACL2-NUMBERP-TYPE-PRESCRIPTION"))
      (proof-with-checked-results
          ((call (proof-term-at goal 1))
           (opened (proof-proof-unfold (library-library-proof lib) call))
           (body (h3-book-rounding-step-at opened 2))
           (typed (h3-book-arithmetic-typed-number lib body))
           (step (library-library-transport-argument lib typed opened 1)))
        (cons step lib)))
     ((equal name "MOD-0")
      (proof-with-checked-results
          ((left (proof-term-at goal 1))
           (call (proof-term-at left 1))
           (first (h3-book-mod-mod-zero-dividend lib call nil))
           (right (proof-term-at goal 2))
           (call (proof-term-at right 1))
           (second (h3-book-mod-mod-zero-divisor lib call nil nil))
           (step (h3-book-floor-conjunct-proof lib (list first second))))
        (cons step lib)))
     ((h3-book-rounding-argument-present-p guard)
      (h3-book-rounding-with-library lib
          ((given (proof-proof-assume (library-library-proof lib) guard t))
           ((step lib) (h3-book-mod-prove-guarded lib name goal given)))
        (h3-book-rounding-guarded-step-with-library lib guard step)))
     (t (cons nil lib)))))

