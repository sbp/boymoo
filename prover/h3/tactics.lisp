(in-package "BOYMOO-PROVER")
(set-verify-guards-eagerness 0)

(defconst *h3-tactics-atom* (proof-cl "ATOM"))
(defconst *h3-tactics-endp* (proof-cl "ENDP"))
(defconst *h3-tactics-numeric-equal* (proof-cl "="))
(defconst *h3-tactics-fix* (proof-sym "FIX" "ACL2"))
(defconst *h3-tactics-realfix* (proof-sym "REALFIX" "ACL2"))
(defconst *h3-tactics-dfp* (proof-sym "DFP" "ACL2"))
(defconst *h3-tactics-to-df* (proof-sym "TO-DF" "ACL2"))
(defconst *h3-tactics-make-chars* (proof-sym "MAKE-CHARACTER-LIST" "ACL2"))
(defconst *h3-tactics-common-rules*
  (list (proof-sym "CAR-CONS" "ACL2") (proof-sym "CDR-CONS" "ACL2") "consp-cons"))
(defconst *h3-tactics-logical*
  (list *h3-tactics-atom* *h3-tactics-endp* *proof-not* (proof-cl "EQ")
        (proof-cl "EQL") *h3-tactics-numeric-equal*))
(defconst *h3-tactics-intersections*
  (list (proof-sym "INTERSECTION-EQ-EXEC" "ACL2")
        (proof-sym "INTERSECTION-EQL-EXEC" "ACL2")))
(defconst *h3-tactics-context-types*
  (list (cons (proof-sym "MFC-CLAUSE" "ACL2") (proof-sym "PSEUDO-TERM-LISTP" "ACL2"))
        (cons (proof-sym "MFC-TYPE-ALIST" "ACL2") (proof-sym "TYPE-ALISTP" "ACL2"))))

(defun h3-tactics-step-argument (step index)
  (proof-with-checked-results ((literal (proof-step-first step)))
    (proof-term-at literal index)))

(defun h3-tactics-acl2-symbols (names)
  (if (endp names)
      nil
    (cons (proof-sym (car names) "ACL2")
          (h3-tactics-acl2-symbols (cdr names)))))

(defun h3-tactics-with-library (step library)
  (if (failure-p step) step (cons step library)))

(defun h3-tactics-using (library formula names definitions calls hypotheses budget)
  (proof-with-checked-results
   ((rules (h3-rewrite-rules-init library names nil))
    (search (h3-rewrite-search-init library definitions calls rules budget nil)))
   (car (h3-rewrite-search-prove search formula hypotheses))))

(defun h3-tactics-convert-fact (library formula name definitions)
  (let* ((proof (library-library-proof library))
         (search (h3-rewrite-search-init library definitions nil nil 150 t))
         (target-result (h3-rewrite-search-reduce search formula nil nil nil)))
    (proof-with-checked-results
     ((target-eq (car target-result))
      (fact (proof-proof-fact proof name nil))
      (literal (proof-step-first fact))
      (source-eq (car (h3-rewrite-search-reduce (cadr target-result) literal nil nil nil)))
      (fact (if source-eq
                (proof-with-checked-results ((rewritten (proof-proof-rewrite proof fact source-eq '(1))))
                  (proof-proof-tidy proof rewritten))
              fact))
      (target (if target-eq (h3-tactics-step-argument target-eq 2) formula))
      (literal (proof-step-first fact))
      (matched (h3-rewrite-match literal target nil)))
     (if (not (car matched))
         *h3-rewrite-unproved*
       (proof-with-checked-results ((instance (proof-proof-instantiate proof fact
                                                                       (table-items (cdr matched)))))
         (if target-eq (proof-proof-transport proof instance target-eq) instance))))))

(defun h3-tactics-parallel-recursions-prove-case (hypotheses library formula left right)
  (h3-tactics-using library formula nil (list *h3-tactics-endp* *h3-tactics-atom*)
                   (list left right) hypotheses 150))

(defun h3-tactics-character-list-idempotent-prove-case (hypotheses library formula calls)
  (h3-tactics-using library formula *h3-tactics-common-rules* (list *h3-tactics-atom*)
                   calls hypotheses 150))

(defun h3-tactics-structural-induction (n library formula variable replacements replies kind calls)
  (declare (xargs :measure (nfix n)))
  (if (not (o< (nfix (1- n)) (nfix n)))
      '(:failure "Fuel" "h3-tactics-structural-induction")
    (let ((result (h3-induction-structural-induction library formula variable replacements replies)))
      (if (not (h3-induction-request-p result))
          result
        (let ((hypotheses (h3-induction-request-evidence result)))
          (proof-with-checked-results
           ((reply (if (eq kind :parallel)
                       (h3-tactics-parallel-recursions-prove-case hypotheses library formula
                                                                (car calls) (cadr calls))
                     (h3-tactics-character-list-idempotent-prove-case hypotheses library formula calls))))
           (h3-tactics-structural-induction (1- n) library formula variable replacements
                                           (append replies (list reply)) kind calls)))))))

(defun h3-tactics-parallel-recursions (library formula)
  (proof-with-checked-results
   ((pair (proof-list-of-length (cdr formula) 2))
    (variable (proof-term-at (car pair) 1)))
   (let* ((child (list *library-cdr* variable))
          (replacements (list (list (list (cons variable child)) 3))))
     (h3-tactics-structural-induction 1000000 library formula variable replacements
                                     nil :parallel pair))))

(defun h3-tactics-character-list-idempotent (library formula)
  (let* ((child (list *library-cdr* *library-x*))
         (inner (list *h3-tactics-make-chars* *library-x*))
         (tail (list *h3-tactics-make-chars* child))
         (calls (list inner
                      (list *h3-tactics-make-chars* *proof-false*)
                      (list *h3-tactics-make-chars*
                            (list *proof-cons* (list *library-car* *library-x*) tail))
                      (list *h3-tactics-make-chars*
                            (list *proof-cons* (proof-quote '("char" 0)) tail))))
         (replacements (list (list (list (cons *library-x* child)) 3))))
    (h3-tactics-structural-induction 1000000 library formula *library-x* replacements
                                    nil :character calls)))

(defconst *h3-tactics-direct*
  (list
   (cons "RATIONALP-UNARY--" "rationalp-unary--")
   (cons "RATIONALP-UNARY-/" "rationalp-unary-/")
   (cons "RATIONALP-IMPLIES-ACL2-NUMBERP" "rationalp-acl2-numberp")
   (cons "RATIONALP-TO-DF" (proof-sym "RATIONALP-CONSTRAINED-TO-DF" "ACL2"))
   (cons "TO-DF-IDEMPOTENT" (proof-sym "CONSTRAINED-TO-DF-IDEMPOTENT" "ACL2"))
   (cons "TO-DF-DEFAULT" (proof-sym "CONSTRAINED-TO-DF-DEFAULT" "ACL2"))
   (cons "TO-DF-MONOTONICITY" (proof-sym "CONSTRAINED-TO-DF-MONOTONICITY" "ACL2"))))

(defconst *h3-tactics-completions*
  (list
   (list "DEFAULT-+-1" "+" *h3-tactics-fix*)
   (list "DEFAULT-+-2" "+" *h3-tactics-fix*)
   (list "DEFAULT-*-1" "*")
   (list "DEFAULT-*-2" "*")
   (list "DEFAULT-UNARY-MINUS" "UNARY-MINUS")
   (list "DEFAULT-UNARY-/" "UNARY-/")
   (list "DEFAULT-CAR" "CAR")
   (list "DEFAULT-CDR" "CDR")
   (list "DEFAULT-CHAR-CODE" "CHAR-CODE")
   (list "DEFAULT-CODE-CHAR" "CODE-CHAR" (proof-sym "SYNP" "ACL2"))
   (list "DEFAULT-COMPLEX-1" "COMPLEX")
   (list "DEFAULT-COMPLEX-2" "COMPLEX")
   (list "DEFAULT-COERCE-1" "COERCE")
   (list "DEFAULT-COERCE-2" "COERCE" (proof-sym "SYNP" "ACL2"))
   (list "DEFAULT-COERCE-3" "COERCE" *h3-tactics-atom*)
   (list "DEFAULT-DENOMINATOR" "DENOMINATOR")
   (list "DEFAULT-IMAGPART" "IMAGPART")
   (list "DEFAULT-INTERN-IN-PACKAGE-OF-SYMBOL" "INTERN-IN-PACKAGE-OF-SYMBOL")
   (list "DEFAULT-NUMERATOR" "NUMERATOR")
   (list "DEFAULT-REALPART" "REALPART")))

(defun h3-tactics-complex-default-second (library formula completed search context)
  (let ((proof (library-library-proof library)))
    (proof-with-checked-results
     ((completed-zero (library-library-axiom library "COMPLETION-OF-COMPLEX"
                                             (list *library-x* *proof-zero*)))
      (right (h3-tactics-step-argument completed-zero 2))
      (reduction (h3-rewrite-search-reduce search right context nil nil))
      (reduced (car reduction))
      (completed-zero (proof-proof-chain proof completed-zero (list reduced)))
      (back (proof-proof-symmetric proof completed-zero))
      (left (h3-tactics-step-argument completed-zero 1))
      (complex-zero (h3-numeric-complex-zero library left))
      (result (proof-proof-chain proof completed (list back complex-zero)))
      (right (h3-tactics-step-argument result 2))
      (reduced (car (h3-rewrite-search-reduce (cadr reduction) right context nil nil)))
      (antecedent (proof-term-at formula 1))
      (result (proof-proof-chain proof result (list reduced))))
     (h3-rewrite-implication library antecedent result))))

(defun h3-tactics-complete-complex (library name formula rule definitions)
  (let ((proof (library-library-proof library)))
    (proof-with-checked-results
     ((antecedent (proof-term-at formula 1))
      (start (library-library-axiom library rule (list *library-x* *library-y*)))
      (search (h3-rewrite-search-init library (append definitions (list *h3-tactics-realfix*))
                                      nil nil 150 nil))
      (assumption (proof-proof-assume proof antecedent t))
      (context (h3-rewrite-search-context search (list assumption)))
      (right (h3-tactics-step-argument start 2))
      (reduction (h3-rewrite-search-reduce search right context nil nil))
      (reduced (car reduction))
      (result (proof-proof-chain proof start (list reduced)))
      (value (h3-tactics-step-argument result 2))
      (conclusion (proof-term-at formula 2))
      (target (proof-term-at conclusion 2))
      (search (cadr reduction)))
     (if (equal value target)
         (h3-rewrite-implication library antecedent result)
       (proof-with-checked-results ((right (library-library-axiom library rule (cdr target))))
         (if (text-ends-with name "-2")
             (h3-tactics-complex-default-second library formula result search context)
           (proof-with-checked-results
            ((term (h3-tactics-step-argument right 2))
             (reduced (car (h3-rewrite-search-reduce search term context nil nil)))
             (right (proof-proof-chain proof right (list reduced)))
             (right-back (proof-proof-symmetric proof right))
             (result (proof-proof-chain proof result (list right-back))))
            (h3-rewrite-implication library antecedent result))))))))

(defun h3-tactics-complete-coerce-second (library formula)
  (let ((proof (library-library-proof library)))
    (proof-with-checked-results
     ((parts (proof-list-of-length (cdr formula) 2))
      (antecedent (car parts))
      (conclusion (cadr parts))
      (assumption (proof-proof-assume proof antecedent t))
      (conjuncts (proof-proof-conjunct proof assumption))
      (non-list (cadr conjuncts))
      (pair (proof-list-of-length (cdr conclusion) 2))
      (left-eq (library-library-axiom library "COMPLETION-OF-COERCE" (cdr (car pair))))
      (right-eq (library-library-axiom library "COMPLETION-OF-COERCE" (cdr (cadr pair))))
      (right (h3-tactics-step-argument left-eq 2))
      (selected (proof-proof-select proof right non-list))
      (left-eq (proof-proof-chain proof left-eq (list selected)))
      (search (h3-rewrite-search-init library nil nil nil 150 nil))
      (right (h3-tactics-step-argument right-eq 2))
      (reduced (car (h3-rewrite-search-reduce search right nil nil nil)))
      (right-eq (proof-proof-chain proof right-eq (list reduced)))
      (right-back (proof-proof-symmetric proof right-eq))
      (result (proof-proof-chain proof left-eq (list right-back))))
     (h3-rewrite-implication library antecedent result))))

(defun h3-tactics-completion (library name formula)
  (let ((entry (assoc-equal name *h3-tactics-completions*)))
    (if (not entry)
        '(:failure "MissingProofData" "")
      (proof-with-checked-results
       ((conclusion (proof-term-at formula 2))
        (left (proof-term-at conclusion 1))
        (function-symbol (proof-term-at left 0)))
       (let ((definitions (cddr entry))
             (rule (concatenate 'string "COMPLETION-OF-" (cadr entry)))
             (calls (and (equal name "DEFAULT-COERCE-3")
                         (list (list *h3-tactics-make-chars* *library-x*)))))
         (cond
          ((equal function-symbol (proof-cl "COMPLEX"))
           (h3-tactics-complete-complex library name formula rule definitions))
          ((equal name "DEFAULT-COERCE-2")
           (h3-tactics-complete-coerce-second library formula))
          (t (h3-tactics-using library formula (list (proof-sym rule "ACL2"))
                               definitions calls nil 150))))))))

(defun h3-tactics-intersection-shape (library formula left right)
  (and (and (proof-compound left)
             (member-equal (car left) *h3-tactics-intersections*)
             (equal right (cons (proof-sym "INTERSECTION-EQUAL" "ACL2") (cdr left))))
    (proof-with-checked-results ((argument (proof-term-at left 1)))
      (and (not (proof-compound argument))
           (h3-tactics-parallel-recursions library formula)))))

(defun h3-tactics-character-shape (library left right)
  (and (and (proof-is-call right *h3-tactics-make-chars*)
             (equal left (list *h3-tactics-make-chars* right)))
    (proof-with-checked-results ((argument (proof-term-at right 1)))
      (and (not (proof-compound argument))
        (let* ((inner (list *h3-tactics-make-chars* *library-x*))
               (canonical (proof-eq (list *h3-tactics-make-chars* inner) inner)))
          (proof-with-checked-results ((step (h3-tactics-character-list-idempotent library canonical)))
            (proof-proof-instantiate (library-library-proof library) step
                                     (list (list *library-x* argument)))))))))

(defun h3-tactics-structural-equality (library formula)
  (and (proof-is-call formula *proof-equal*)
    (proof-with-checked-results
     ((pair (proof-list-of-length (cdr formula) 2))
      (left (car pair))
      (right (cadr pair))
      (intersection (h3-tactics-intersection-shape library formula left right)))
     (or intersection (h3-tactics-character-shape library left right)))))

(defun h3-tactics-indexed-shape (library formula guard result)
  (proof-with-checked-results ((nth-call (proof-term-at result 1)))
    (and (proof-is-call nth-call *h3-lists-nth*)
      (proof-with-checked-results
       ((parts (proof-list-of-length (cdr nth-call) 2))
        (index (car parts))
        (call (cadr parts)))
       (and (proof-is-call index *proof-quote*)
         (proof-with-checked-results ((value (proof-term-at index 1)))
           (let ((value (if (eq value t) 1 value)))
             (and (and (natp value) (<= value 2) (proof-compound call))
               (proof-with-checked-results ((head (proof-term-at call 0)))
                 (and (and (assoc-equal head (proof-proof-definitions (library-library-proof library)))
                            (> (len call) (+ 3 value))
                            (not (proof-compound (nth 2 call)))
                            (equal guard (list *proof-integerp* (nth (+ 3 value) call))))
                   (h3-counts-indexed-count library formula)))))))))))

(defun h3-tactics-merge-shape (library formula guard result)
  (proof-with-checked-results ((call (proof-term-at result 1)))
    (and (proof-is-call call (proof-sym "MERGE-LEXORDER" "ACL2"))
      (proof-with-checked-results ((args (proof-list-of-length (cdr call) 3)))
        (let ((a (car args))
              (b (cadr args)))
          (and (equal guard (proof-ite (list *h3-lists-true-listp* a)
                                        (list *h3-lists-true-listp* b) *proof-false*))
            (h3-merges-merge-lexorder library formula)))))))

(defun h3-tactics-symbol-sort-shape (library formula guard result)
  (proof-with-checked-results ((call (proof-term-at result 1)))
    (and (proof-is-call call (proof-sym "STRICT-MERGE-SORT-SYMBOL<" "ACL2"))
      (proof-with-checked-results ((argument (proof-term-at call 1)))
        (and (equal guard (list (proof-sym "SYMBOL-LISTP" "ACL2") argument))
          (h3-sorting-symbol-sort library formula))))))

(defun h3-tactics-structural-implication (library formula)
  (and (proof-is-call formula *library-implies*)
    (proof-with-checked-results ((parts (proof-list-of-length (cdr formula) 2)))
      (let ((guard (car parts))
            (result (cadr parts)))
        (cond
         ((proof-is-call result *proof-integerp*)
          (h3-tactics-indexed-shape library formula guard result))
         ((proof-is-call result *h3-lists-true-listp*)
          (h3-tactics-merge-shape library formula guard result))
         ((proof-is-call result (proof-sym "SYMBOL-LISTP" "ACL2"))
          (h3-tactics-symbol-sort-shape library formula guard result))
         (t nil))))))

(defun h3-tactics-structural-context (library formula)
  (and (and (proof-compound formula) (equal (len formula) 2)
             (proof-compound (cadr formula)))
    (let ((predicate (car formula))
          (call (cadr formula)))
      (and call
           (equal (table-get *h3-tactics-context-types* (car call) :none) predicate)
        (h3-tactics-using library formula *h3-tactics-common-rules* *h3-tactics-logical*
                         (list call (list predicate *proof-false*)) nil 150)))))

(defun h3-tactics-structural-shape (library formula)
  (proof-with-checked-results ((equation (h3-tactics-structural-equality library formula)))
    (if equation
        (cons equation library)
      (proof-with-checked-results ((implication (h3-tactics-structural-implication library formula)))
        (or implication
            (h3-tactics-with-library (h3-tactics-structural-context library formula) library))))))

(defun h3-tactics-df-result (library formula)
  (proof-with-checked-results ((predicate (proof-term-at formula 0)))
    (and (member-equal predicate (list *h3-tactics-dfp* *library-rationalp*))
      (proof-with-checked-results
       ((call (proof-term-at formula 1))
        (head (proof-term-at call 0))
        (label (proof-term-at head 2)))
       (if (stringp label)
           (and (text-starts-with label '("DF-" "BINARY-DF-" "UNARY-DF-"))
             (h3-tactics-using library formula
                              (h3-tactics-acl2-symbols '("DFP-TO-DF" "RATIONALP-TO-DF"))
                              nil (list call) nil 150))
         '(:failure "MalformedTacticInput" ""))))))

(defun h3-tactics-solve-by-name (library name formula)
  (let ((direct (assoc-equal name *h3-tactics-direct*)))
    (cond
     (direct
      (h3-tactics-with-library
       (h3-tactics-convert-fact library formula (cdr direct) (list *h3-tactics-to-df*)) library))
     ((assoc-equal name *h3-tactics-completions*)
      (h3-tactics-with-library (h3-tactics-completion library name formula) library))
     ((member-equal name '("DEFAULT-<-1" "DEFAULT-<-2"))
      (h3-tactics-with-library (h3-numeric-comparison-default library formula) library))
     ((equal name "ORDERED-SYMBOL-ALISTP-ADD-PAIR-FORWARD")
      (h3-tactics-with-library
       (h3-tactics-using library formula (list (proof-sym "ORDERED-SYMBOL-ALISTP-ADD-PAIR" "ACL2"))
                         nil nil nil 150)
       library))
     ((text-starts-with name "STATE-P1-UPDATE-")
      (h3-state-state-update library formula))
     ((equal name "CONS-CAR-CDR")
      (h3-tactics-with-library
       (h3-tactics-using library formula (h3-tactics-acl2-symbols '("CAR-CDR-ELIM" "DEFAULT-CAR" "DEFAULT-CDR"))
                         nil nil nil 150)
       library))
     ((equal name "COMPLEX-0")
      (proof-with-checked-results ((term (proof-term-at formula 1)))
        (h3-tactics-with-library (h3-numeric-complex-zero library term) library)))
     ((equal name "ADD-DEF-COMPLEX")
      (h3-numeric-addition-of-complex-parts library formula))
     ((member-equal name '("REALPART-+" "IMAGPART-+"))
      (h3-tactics-with-library (h3-numeric-part-of-sum library formula) library))
     ((equal name "BAD-ATOM-COMPOUND-RECOGNIZER")
      (h3-tactics-with-library
       (h3-tactics-using library formula nil (h3-tactics-acl2-symbols '("IFF" "BAD-ATOM"))
                         nil nil 250)
       library))
     ((equal name "ALPHORDER-REFLEXIVE")
      (h3-atom-order-alphorder-reflexive library formula))
     ((text-starts-with name "ALPHORDER-")
      (h3-atom-order-alphorder-law library name formula))
     ((text-starts-with name "LEXORDER-")
      (h3-lexicographic-lexorder library name formula))
     ((equal name "RESIZE-LIST-EXEC-IS-RESIZE-LIST")
      (h3-lists-resize-list library formula))
     ((equal name "ACL2-COUNT-CAR-CDR-LINEAR")
      (h3-tactics-with-library
       (h3-tactics-using library formula nil nil (list (list *library-count* *library-x*)) nil 150)
       library))
     ((member-equal name '("FN-COUNT-EVG-REC-TYPE-PRESCRIPTION" "FN-COUNT-EVG-REC-BOUND"))
      (h3-event-counts-event-count library formula))
     ((equal name "FN-COUNT-1-TYPE")
      (h3-counts-count-tuple library formula))
     ((equal name "ANCESTORS-CHECK-BUILTIN-PROPERTY")
      (h3-ancestors-ancestors-check library formula))
     ((equal name "EQLABLEP-NTH")
      (h3-tactics-with-library (h3-lists-eqlable-nth library formula) library))
     ((equal name "SYMBOL-LISTP-CDR-ASSOC-EQUAL")
      (h3-tactics-with-library (h3-lists-association-cdr library formula) library))
     ((member-equal name '("D-POS-LISTP-FORWARD-TO-TRUE-LISTP" "POS-LISTP-FORWARD-TO-INTEGER-LISTP"))
      (h3-tactics-with-library (h3-lists-recognizer-implication library formula) library))
     ((equal name "TRUE-LISTP-CHARS-FOR-TILDE-@-CLAUSE-ID-PHRASE/PERIODS")
      (h3-lists-printed-phrase library formula))
     ((equal name "TRUE-LISTP-EXPLODE-ATOM")
      (h3-lists-explode-atom library formula))
     ((equal name "DF-ROUND-IDEMPOTENT")
      (h3-tactics-with-library
       (h3-tactics-using library formula
                         (h3-tactics-acl2-symbols '("DF-ROUND-IS-IDENTITY-FOR-DFP" "DFP-DF-ROUND"))
                         nil nil nil 150)
       library))
     ((equal name "DFP-MINUS")
      (h3-tactics-with-library
       (h3-tactics-using library formula (list "rationalp-unary--" (proof-sym "TO-DF-MINUS" "ACL2"))
                         (list *h3-tactics-dfp* *h3-tactics-numeric-equal* *h3-tactics-to-df*)
                         nil nil 150)
       library))
     ((member-equal name '("DFP-TO-DF" "DFP-IMPLIES-RATIONALP" "DFP-IMPLIES-TO-DF-IS-IDENTITY"))
      (let ((names (and (equal name "DFP-TO-DF")
                     (h3-tactics-acl2-symbols '("RATIONALP-TO-DF" "TO-DF-IDEMPOTENT")))))
        (h3-tactics-with-library
         (h3-tactics-using library formula names (list *h3-tactics-dfp* *h3-tactics-numeric-equal*)
                           nil nil 150)
         library)))
     (t
      (proof-with-checked-results ((step (h3-tactics-df-result library formula)))
        (if step (cons step library) *h3-rewrite-unproved*))))))

(defun h3-tactics-solve (library name formula)
  (proof-with-checked-results ((structural (h3-tactics-structural-shape library formula)))
    (if (car structural) structural (h3-tactics-solve-by-name library name formula))))
