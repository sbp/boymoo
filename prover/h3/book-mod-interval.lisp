(in-package "BOYMOO-PROVER")
(set-verify-guards-eagerness 0)

; Bindings have the form (value expression) or (value object expression).
; In the second form, the expression returns a pair with a Library or Bounds.
(defmacro h3-book-mod-interval-with (bindings result)
  (if (endp bindings)
      result
    (let* ((binding (car bindings))
           (name (car binding))
           (remaining `(h3-book-mod-interval-with ,(cdr bindings) ,result)))
      (if (endp (cddr binding))
          (let ((value (or name 'interval-ignored)))
            `(let ((,value ,(cadr binding)))
               (if (failure-p ,value)
                   (cons ,value lib)
                 ,remaining)))
        (let ((object (cadr binding))
              (form (caddr binding)))
          `(let ((interval-result-pair ,form))
             (cond
              ((failure-p interval-result-pair) (cons interval-result-pair lib))
              ((failure-p (car interval-result-pair))
               ,(if (eq object 'lib)
                    'interval-result-pair
                  '(cons (car interval-result-pair)
                         (h3-book-order-bounds-lib (cdr interval-result-pair)))))
              (t
               (let (,@(and name `((,name (car interval-result-pair))))
                     (,object (cdr interval-result-pair)))
                 ,remaining)))))))))

(defun h3-book-mod-interval-term-at (term path)
  (declare (xargs :measure (acl2-count path)))
  (if (endp path)
      term
    (proof-with-checked-results ((child (proof-term-at term (car path))))
      (h3-book-mod-interval-term-at child (cdr path)))))

(defun h3-book-mod-interval-step-at (step path)
  (proof-with-checked-results ((literal (proof-step-first step)))
    (h3-book-mod-interval-term-at literal path)))

(defun h3-book-mod-interval-tail (term)
  (if (integerp term)
      '(:failure "failure" "")
    (cdr term)))

(defun h3-book-mod-interval-arguments (term count)
  (proof-with-checked-results ((arguments (h3-book-mod-interval-tail term)))
    (proof-list-of-length arguments count)))

(defun h3-book-mod-interval-finite-product (lib amount rational-divisor)
  (proof-with-checked-results
    ((divisor (h3-book-mod-interval-step-at rational-divisor '(1))))
    (if (equal amount *proof-zero*)
        (h3-book-arithmetic-zero-left lib divisor)
      (let ((proof (library-library-proof lib)))
        (proof-with-checked-results
          ((identity (library-library-axiom lib "UNICITY-OF-1" (list divisor)))
           (numeric (h3-book-signs-number lib rational-divisor))
           (fixed (h3-book-arithmetic-fix-value lib divisor numeric))
           (unit (proof-proof-chain proof identity (list fixed))))
          (cond
           ((equal amount *proof-one*) unit)
           ((equal amount (library-plus *proof-one* *proof-zero*))
            (proof-with-checked-results
              ((product (proof-proof-reflexive proof (list *proof-times* amount divisor)))
               (one (proof-proof-compute proof amount 1))
               (simplified (proof-proof-rewrite proof product one '(1 2 1))))
              (proof-proof-chain proof simplified (list unit))))
           ((equal amount (library-plus *proof-one* *proof-one*))
            (proof-with-checked-results
              ((commute (library-library-axiom lib "COMMUTATIVITY-OF-*" (list amount divisor)))
               (distribute (library-library-axiom lib "DISTRIBUTIVITY"
                                                  (list divisor *proof-one* *proof-one*)))
               (terms (proof-proof-chain proof commute (list distribute)))
               (swap-unit (library-library-axiom lib "COMMUTATIVITY-OF-*" (list divisor *proof-one*)))
               (right-unit (proof-proof-chain proof swap-unit (list unit)))
               (terms (proof-proof-rewrite proof terms right-unit '(1 2 1))))
              (proof-proof-rewrite proof terms right-unit '(1 2 2))))
           (t '(:failure "unproved" ""))))))))

(defun h3-book-mod-interval-ratio-endpoint-types (lib terms ratio ratio-type)
  (declare (xargs :measure (acl2-count terms)))
  (if (endp terms)
      nil
    (proof-with-checked-results
      ((typed (if (equal (car terms) ratio)
                  ratio-type
                (h3-book-quotient-rational-type lib (car terms) nil)))
       (remaining (h3-book-mod-interval-ratio-endpoint-types lib (cdr terms) ratio ratio-type)))
      (cons typed remaining))))

(defun h3-book-mod-interval-ratio-from-scaled-rewrite
    (lib terms index ratio dividend divisor divisor-term law signs transformed)
  (declare (xargs :measure (acl2-count terms)))
  (if (endp terms)
      transformed
    (proof-with-checked-results
      ((value (if (equal (car terms) ratio)
                  (proof-with-checked-results ((numeric (h3-book-signs-number lib dividend)))
                    (h3-book-quotient-clear-reciprocal lib ratio divisor-term law numeric))
                (h3-book-mod-interval-finite-product lib (car terms) divisor)))
       (position (if (< 0 (h3-book-signs-signs-sign signs)) index (- 3 index)))
       (transformed (proof-proof-rewrite (library-library-proof lib) transformed value
                                        (list 1 2 position))))
      (h3-book-mod-interval-ratio-from-scaled-rewrite
       lib (cdr terms) (+ 1 index) ratio dividend divisor divisor-term law signs transformed))))

(defun h3-book-mod-interval-scale-endpoints (operands)
  (case (len operands)
    (0 '(:failure "failure" ""))
    (1 '(:failure "failure" ""))
    (2 operands)
    (otherwise '(:failure "failure" ""))))

(defun h3-book-mod-interval-ratio-from-scaled-with-library (lib ratio-type dividend divisor signs relation given)
  (let ((negated (proof-is-call relation *proof-not*)))
    (h3-book-mod-interval-with
      ((comparison (if negated (proof-term-at relation 1) relation))
       (nil (h3-book-mod-interval-step-at dividend '(1)))
       (divisor-term (h3-book-mod-interval-step-at divisor '(1)))
       (ratio (h3-book-mod-interval-step-at ratio-type '(1)))
       (numeric (h3-book-signs-number lib divisor))
       (law (h3-book-arithmetic-inverse lib divisor-term numeric (h3-book-signs-signs-zero signs)))
       (operands (h3-book-mod-interval-tail comparison))
       (endpoints (h3-book-mod-interval-ratio-endpoint-types lib operands ratio ratio-type))
       (pair (h3-book-mod-interval-scale-endpoints operands))
       (transformed lib (h3-book-quotient-scale-order-with-library lib (car pair) (cadr pair) divisor signs endpoints))
       (transformed (h3-book-mod-interval-ratio-from-scaled-rewrite
                     lib operands 1 ratio dividend divisor divisor-term law signs transformed))
       (proof (library-library-proof lib))
       (answer (if negated
                   (library-library-transport-argument lib given transformed 1)
                 (proof-proof-transport proof given transformed))))
      (cons answer lib))))

(defun h3-book-mod-interval-remainder-in-interval-with-library (lib dividend divisor signs integer lower upper)
  (h3-book-mod-interval-with
    ((dividend-literal (proof-step-first dividend))
     (n (proof-term-at dividend-literal 1))
     (divisor-literal (proof-step-first divisor))
     (d (proof-term-at divisor-literal 1))
     (q (h3-book-mod-interval-step-at integer '(1)))
     (ratio (h3-book-floor-floor-ratio n d))
     (evidence (table-put (list (cons dividend-literal dividend)) divisor-literal divisor))
     (kind (h3-book-quotient-rational-type lib ratio evidence))
     (below lib (h3-book-mod-interval-ratio-from-scaled-with-library lib kind dividend divisor signs
                                                      (library-le q ratio) lower))
     (above lib (h3-book-mod-interval-ratio-from-scaled-with-library lib kind dividend divisor signs
                                                      (library-lt ratio (library-plus *proof-one* q)) upper))
     (floor-call (list *h3-book-floor-floor* n d))
     (actual lib (h3-book-floor-floor-bounds-with-library lib floor-call kind))
     (exact lib (h3-book-floor-same-floor-interval-with-library lib kind actual (list integer below above)))
     (proof (library-library-proof lib))
     (unfolded (proof-proof-unfold proof (list *h3-book-mod-mod* n d)))
     (opened (proof-proof-rewrite proof unfolded exact '(1 2 2 1 1)))
     (endpoint (h3-book-mod-interval-step-at opened '(2 2 1 1)))
     (factor (h3-book-mod-interval-finite-product lib endpoint divisor))
     (answer (proof-proof-rewrite proof opened factor '(1 2 2 1))))
    (cons answer lib)))

(defun h3-book-mod-interval-inside-remainder-with-library (lib dividend divisor signs lower upper)
  (h3-book-mod-interval-with
    ((integer (library-library-axiom lib "INTEGER-0" nil))
     (step lib (h3-book-mod-interval-remainder-in-interval-with-library lib dividend divisor signs integer lower upper))
     (proof (library-library-proof lib))
     (zero (proof-proof-compute proof (library-minus *proof-zero*) 0))
     (step (proof-proof-rewrite proof step zero '(1 2 2)))
     (n (h3-book-mod-interval-step-at dividend '(1)))
     (commute (library-library-axiom lib "COMMUTATIVITY-OF-+" (list n *proof-zero*)))
     (identity (library-library-axiom lib "UNICITY-OF-0" (list n)))
     (numeric (h3-book-signs-number lib dividend))
     (fixed (h3-book-arithmetic-fix-value lib n numeric))
     (answer (proof-proof-chain proof step (list commute identity fixed))))
    (cons answer lib)))

(defun h3-book-mod-interval-mixed-remainder (lib call rational nonrational numeric-dividend)
  (proof-with-checked-results ((operands (h3-book-mod-interval-arguments call 2)))
    (let* ((dividend (car operands))
           (divisor (cadr operands))
           (floor-call (list *h3-book-floor-floor* dividend divisor))
           (proof (library-library-proof lib)))
      (proof-with-checked-results
        ((empty (h3-book-mod-floor-zero-with-mixed-types lib floor-call rational nonrational))
         (product (proof-proof-reflexive proof (list *proof-times* floor-call divisor)))
         (product (proof-proof-rewrite proof product empty '(1 2 1)))
         (zero (h3-book-arithmetic-zero-left lib divisor))
         (product (proof-proof-chain proof product (list zero))))
        (h3-book-mod-mod-floor-zero lib call product numeric-dividend)))))

; Return the first failed bound with the Bounds reached on the preceding calls.
(defun h3-book-mod-interval-orientation-bounds (context goals)
  (declare (xargs :measure (acl2-count goals)))
  (if (endp goals)
      (cons nil context)
    (let ((bound (h3-book-order-bounds-bound-with-bounds context (car goals))))
      (if (failure-p (car bound))
          bound
        (let ((later (h3-book-mod-interval-orientation-bounds (cdr bound) (cdr goals))))
          (if (failure-p (car later))
              later
            (cons (cons (car bound) (car later)) (cdr later))))))))

(defun h3-book-mod-interval-unchanged-orientations (orientations n d dividend divisor context)
  (declare (xargs :measure (acl2-count orientations)))
  (if (endp orientations)
      (cons '(:failure "unproved" "") (h3-book-order-bounds-lib context))
    (let* ((orientation (car orientations))
           (goals (if (< 0 orientation)
                      (list (library-le *proof-zero* n) (library-lt n d) (library-lt *proof-zero* d))
                    (list (library-le n *proof-zero*) (library-lt d n) (library-lt d *proof-zero*))))
           (result (h3-book-mod-interval-orientation-bounds context goals))
           (bounds (car result))
           (context (cdr result))
           (lib (h3-book-order-bounds-lib context)))
      (cond ((h3-rewrite-unproved-p bounds)
             (h3-book-mod-interval-unchanged-orientations (cdr orientations) n d dividend divisor context))
            ((failure-p bounds) (cons bounds lib))
            (t (h3-book-mod-interval-with
                 ((numeric (h3-book-signs-number lib divisor))
                  (signs lib (h3-book-signs-sign-evidence-with-library lib numeric orientation (caddr bounds))))
                 (h3-book-mod-interval-inside-remainder-with-library lib dividend divisor signs
                                                        (car bounds) (cadr bounds))))))))

(defun h3-book-mod-interval-unchanged-mod-request (n lib call context)
  (if (zp n)
      (cons '(:failure "fuel" "h3-book-mod-interval-unchanged-mod-request") lib)
    (h3-book-mod-interval-with
      ((operands (h3-book-mod-interval-arguments call 2))
       (dividend-term (car operands))
       (divisor-term (cadr operands))
       (dividend (h3-book-order-bounds-rational context dividend-term)))
      (let* ((divisor (h3-book-order-bounds-rational context divisor-term))
             (evidence (h3-book-order-bounds-evidence context)))
        (cond
         ((h3-rewrite-unproved-p divisor)
          (let ((test (list *library-rationalp* divisor-term)))
            (h3-book-mod-interval-with
              ((assumed (proof-proof-assume (library-library-proof lib) test t))
               (more (h3-book-order-bounds-init lib (append (table-values evidence) (list assumed)))))
              (list :rational-divisor dividend test more))))
         ((failure-p divisor) (cons divisor lib))
         (t
          (h3-book-mod-interval-with
            ((known (h3-rewrite-search-known (h3-book-order-bounds-search context)
                                             (proof-eq divisor-term *proof-zero*) evidence)))
            (if known
                (h3-book-mod-interval-with
                  ((numeric (h3-book-signs-number lib dividend))
                   (answer (h3-book-mod-mod-zero-divisor lib call known numeric)))
                  (cons answer lib))
              (h3-book-mod-interval-unchanged-orientations '(1 -1) dividend-term divisor-term
                                                          dividend divisor context)))))))))

(defun h3-book-mod-interval-unchanged-mod-cases (lib call dividend test rational-case)
  (h3-book-mod-interval-with
    ((yes lib rational-case)
     (proof (library-library-proof lib))
     (missing (proof-proof-assume proof test nil))
     (numeric (h3-book-signs-number lib dividend))
     (no (h3-book-mod-interval-mixed-remainder lib call dividend missing numeric))
     (answer (proof-proof-cases proof test yes no)))
    (cons answer lib)))

; A request holds the evidence needed to prove the rational-divisor case first.
(defun h3-book-mod-interval-unchanged-mod-run (n lib call request)
  (declare (xargs :measure (nfix n)))
  (if (or (zp n) (not (eq (car request) :rational-divisor)))
      request
    (let* ((next (- n 1))
           (subrequest (h3-book-mod-interval-unchanged-mod-request next lib call (cadddr request)))
           (yes (h3-book-mod-interval-unchanged-mod-run next lib call subrequest)))
      (h3-book-mod-interval-unchanged-mod-cases lib call (cadr request) (caddr request) yes))))

(defun h3-book-mod-interval-unchanged-mod-with-library (n lib call context)
  (h3-book-mod-interval-unchanged-mod-run
   n lib call (h3-book-mod-interval-unchanged-mod-request n lib call context)))

(defun h3-book-mod-interval-nested-remainder-rational-case
    (typed lib inner first positive ordered second signs)
  (h3-book-mod-interval-with
    ((rational lib (h3-book-mod-remainder-rational-with-library lib inner typed first))
     (bounds lib (h3-book-mod-remainder-bounds-with-library lib inner typed first positive 1))
     (context (h3-book-order-bounds-init lib (list rational first second)))
     (upper context (h3-book-order-bounds-compose-with-bounds context (cadr bounds) ordered)))
    (h3-book-mod-interval-inside-remainder-with-library (h3-book-order-bounds-lib context) rational second signs
                                           (car bounds) upper)))

(defun h3-book-mod-interval-nested-remainder-with-library (lib call context)
  (h3-book-mod-interval-with
    ((operands (h3-book-mod-interval-arguments call 2))
     (inner (car operands))
     (d2 (cadr operands))
     (operands (h3-book-mod-interval-arguments inner 2))
     (x (car operands))
     (d1 (cadr operands))
     (context (h3-book-order-bounds-with-library context lib))
     (first (h3-book-order-bounds-rational context d1))
     (second (h3-book-order-bounds-rational context d2))
     (positive context (h3-book-order-bounds-bound-with-bounds context (library-lt *proof-zero* d1)))
     (outer-positive context (h3-book-order-bounds-bound-with-bounds context (library-lt *proof-zero* d2)))
     (lib (h3-book-order-bounds-lib context))
     (numeric (h3-book-signs-number lib second))
     (signs lib (h3-book-signs-sign-evidence-with-library lib numeric 1 outer-positive))
     (context (h3-book-order-bounds-with-library context lib))
     (ordered context (h3-book-order-bounds-bound-with-bounds context (library-le d1 d2)))
     (lib (h3-book-order-bounds-lib context))
     (test (list *library-rationalp* x)))
    (let ((typed (h3-book-order-bounds-rational context x)))
      (cond
       ((h3-rewrite-unproved-p typed)
        (h3-book-mod-interval-with
          ((numeric (h3-book-order-bounds-numeric context x))
           (proof (library-library-proof lib))
           (absent (proof-proof-assume proof test nil))
           (left (h3-book-mod-interval-mixed-remainder lib inner first absent numeric))
           (right (h3-book-mod-interval-mixed-remainder lib (list *h3-book-mod-mod* x d2) second absent numeric))
           (reflexive (proof-proof-reflexive proof call))
           (replaced (proof-proof-rewrite proof reflexive left '(1 2 1)))
           (back (proof-proof-symmetric proof left))
           (no (proof-proof-chain proof replaced (list right back)))
           (assumed (proof-proof-assume proof test t))
           (yes lib (h3-book-mod-interval-nested-remainder-rational-case
                     assumed lib inner first positive ordered second signs))
           (result (proof-proof-cases (library-library-proof lib) test yes no)))
          (cons result lib)))
       ((failure-p typed) (cons typed lib))
       (t (h3-book-mod-interval-nested-remainder-rational-case
           typed lib inner first positive ordered second signs))))))

(defun h3-book-mod-interval-move-sum-bound-with-library (lib bound target typed)
  (h3-book-mod-interval-with
    ((nil lib (h3-book-sums-lemmas-with-library lib))
     (negated (proof-is-call target *proof-not*))
     (sums (h3-book-sums-book-sums-init lib))
     (target-comparison (if negated (proof-term-at target 1) target))
     (source-comparison (h3-book-mod-interval-step-at bound (if negated '(1) nil)))
     (equality (h3-book-sums-cancel-comparison lib sums target-comparison source-comparison typed))
     (answer (if negated
                 (library-library-transport-argument lib bound equality 1)
               (proof-proof-transport (library-library-proof lib) bound equality))))
    (cons answer lib)))

(defun h3-book-mod-interval-summed-remainder-bounds-with-library
    (lib first second divisor positive first-bounds second-bounds)
  (h3-book-mod-interval-with
    ((a (h3-book-mod-interval-step-at first '(1)))
     (b (h3-book-mod-interval-step-at second '(1)))
     (d (h3-book-mod-interval-step-at divisor '(1)))
     (total (library-plus a b))
     (types (list first second divisor))
     (total-type (h3-numeric-rational-sum lib first second))
     (limits (h3-book-order-bounds-init lib (append types (list total-type positive))))
     (first-pair (proof-list-of-length first-bounds 2))
     (second-pair (proof-list-of-length second-bounds 2))
     (from-a lib (h3-book-mod-interval-move-sum-bound-with-library lib (car second-pair) (library-le a total) types))
     (limits (h3-book-order-bounds-with-library limits lib))
     (lower limits (h3-book-order-bounds-compose-with-bounds limits (car first-pair) from-a))
     (lib (h3-book-order-bounds-lib limits))
     (middle (library-plus d b))
     (first-step lib (h3-book-mod-interval-move-sum-bound-with-library lib (cadr first-pair) (library-lt total middle) types))
     (second-step lib (h3-book-mod-interval-move-sum-bound-with-library lib (cadr second-pair)
                                                         (library-lt middle (library-plus d d)) types))
     (limits (h3-book-order-bounds-with-library limits lib))
     (upper limits (h3-book-order-bounds-compose-with-bounds limits first-step second-step)))
    (cons (list lower upper) (h3-book-order-bounds-lib limits))))

(defun h3-book-mod-interval-sum-of-remainders (lib left right divisor)
  (proof-with-checked-results
    ((a (h3-book-mod-interval-step-at left '(1)))
     (b (h3-book-mod-interval-step-at right '(1)))
     (d (h3-book-mod-interval-step-at divisor '(1)))
     (name (proof-sym "MOD-SUM-ELIM-BOTH" "ACL2"))
     (proof (library-library-proof lib)))
    (if (not (assoc-equal name (proof-proof-facts proof)))
        '(:failure "unproved" "")
      (proof-with-checked-results
        ((bindings (list (list (proof-sym "A" "ACL2") a)
                         (list (proof-sym "B" "ACL2") b)
                         (list *library-y* d)))
         (fact (proof-proof-fact proof name bindings))
         (formula (h3-book-mod-interval-step-at fact '(1)))
         (left-type (h3-book-floor-noncomplex-type lib left))
         (right-type (h3-book-floor-noncomplex-type lib right))
         (search (h3-rewrite-search-init lib *h3-book-descent-transparent* nil nil 150 nil))
         (guard (car (h3-rewrite-search-prove search formula (list left-type right-type)))))
        (proof-proof-modus-ponens proof fact guard)))))

(mutual-recursion
 (defun h3-book-mod-interval-replace-remainder-visit (term path equality)
   (declare (xargs :measure (acl2-count term)))
   (proof-with-checked-results ((left (h3-book-mod-interval-step-at equality '(1))))
     (cond ((equal term left) (list path))
           ((and (consp term) (h3-rewrite-arguments term))
            (h3-book-mod-interval-replace-remainder-visit-arguments (cdr term) 1 path equality))
           (t nil))))
 (defun h3-book-mod-interval-replace-remainder-visit-arguments (arguments index path equality)
   (declare (xargs :measure (acl2-count arguments)))
   (if (endp arguments)
       nil
     (proof-with-checked-results
       ((first (h3-book-mod-interval-replace-remainder-visit (car arguments) (append path (list index)) equality))
        (rest (h3-book-mod-interval-replace-remainder-visit-arguments (cdr arguments) (+ 1 index) path equality)))
       (append first rest)))))

(defun h3-book-mod-interval-rewrite-places (proof step equality paths)
  (declare (xargs :measure (acl2-count paths)))
  (if (endp paths)
      step
    (proof-with-checked-results ((step (proof-proof-rewrite proof step equality (car paths))))
      (h3-book-mod-interval-rewrite-places proof step equality (cdr paths)))))

(defun h3-book-mod-interval-replace-remainder (lib step equality)
  (proof-with-checked-results
    ((term (h3-book-mod-interval-step-at step '(2)))
     (paths (h3-book-mod-interval-replace-remainder-visit term '(1 2) equality)))
    (h3-book-mod-interval-rewrite-places (library-library-proof lib) step equality paths)))

(defun h3-book-mod-interval-mod-sum-cases-empty
    (lib source choice a b d rat-a rat-b numeric-a numeric-b total total-rat zero)
  (h3-book-mod-interval-with
    ((proof (library-library-proof lib))
     (total-number (h3-book-signs-number lib total-rat))
     (default (h3-book-mod-mod-zero-divisor lib source zero total-number))
     (empty-choice (proof-proof-reflexive proof choice))
     (reduction (h3-book-mod-mod-zero-divisor lib (list *h3-book-mod-mod* a d) zero numeric-a))
     (empty-choice (h3-book-mod-interval-replace-remainder lib empty-choice reduction))
     (reduction (h3-book-mod-mod-zero-divisor lib (list *h3-book-mod-mod* b d) zero numeric-b))
     (empty-choice (h3-book-mod-interval-replace-remainder lib empty-choice reduction))
     (empty-choice (h3-book-mod-interval-replace-remainder lib empty-choice zero))
     (zero-times (proof-proof-compute proof (list *proof-times* *proof-neg-one* *proof-zero*) 0))
     (empty-choice (h3-book-mod-interval-replace-remainder lib empty-choice zero-times))
     (otherwise (h3-book-mod-interval-step-at empty-choice '(2 3)))
     (normalized lib (h3-book-translation-sum-equality-with-library lib otherwise total (list rat-a rat-b)))
     (proof (library-library-proof lib))
     (empty-choice (proof-proof-rewrite proof empty-choice normalized '(1 2 3)))
     (then (h3-book-mod-interval-step-at empty-choice '(2 2)))
     (then (h3-book-arithmetic-associative-equal lib then total))
     (empty-choice (proof-proof-rewrite proof empty-choice then '(1 2 2)))
     (conditional (h3-book-mod-interval-step-at empty-choice '(2)))
     (test (proof-term-at conditional 1))
     (yes (proof-proof-if-true proof conditional))
     (no (proof-proof-if-false proof conditional))
     (selected (proof-proof-cases proof test yes no))
     (empty-choice (proof-proof-chain proof empty-choice (list selected)))
