        ((applicable (or mod-equality (h3-book-mod-interval-negative-mod-equality-p goal))))
        (if applicable
            (h3-book-mod-interval-with ((context (h3-book-mod-interval-assumed-bounds lib guard)))
              (h3-book-mod-interval-affine-literal-remainder-with-library lib goal context))
          (cons nil lib)))))))

(defun h3-book-mod-interval-remainder-interval-theorem-with-library (lib name formula)
  (if (not (proof-is-call formula *library-implies*))
      (cons nil lib)
    (h3-book-mod-interval-with
      ((operands (h3-book-mod-interval-arguments formula 2))
       (guard (car operands))
       (goal (cadr operands))
       (step lib (h3-book-mod-interval-theorem-proof lib name guard goal))
       (answer (and step (h3-rewrite-implication lib guard step))))
      (cons answer lib))))

