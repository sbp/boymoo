(in-package "BOYMOO-PROVER")
(set-verify-guards-eagerness 0)

(defconst *h3-state-true-listp* (proof-sym "TRUE-LISTP" "ACL2"))
(defconst *h3-state-state-p1* (proof-sym "STATE-P1" "ACL2"))
(defconst *h3-state-stringp* (proof-cl "STRINGP"))
(defconst *h3-state-length* (proof-cl "LENGTH"))
(defconst *h3-state-max* (proof-cl "MAX"))

(defconst *h3-state-state-fields*
  '(("sym" "ACL2" "OPEN-INPUT-CHANNELS")
    ("sym" "ACL2" "OPEN-OUTPUT-CHANNELS")
    ("sym" "ACL2" "GLOBAL-TABLE")
    ("sym" "ACL2" "IDATES")
    ("sym" "ACL2" "ACL2-ORACLE")
    ("sym" "ACL2" "FILE-CLOCK")
    ("sym" "ACL2" "READABLE-FILES")
    ("sym" "ACL2" "WRITTEN-FILES")
    ("sym" "ACL2" "READ-FILES")
    ("sym" "ACL2" "WRITEABLE-FILES")
    ("sym" "ACL2" "USER-STOBJ-ALIST1")))

(defun h3-state-open-nil-test (proof as-nil search)
  (proof-with-checked-results
      ((literal (proof-step-first as-nil))
       (head (proof-term-at literal 0)))
    (if (equal head *proof-equal*)
        as-nil
      (proof-with-checked-results
          ((equality (car (h3-rewrite-search-reduce search literal nil nil nil)))
           (opened (if equality
                       (proof-proof-rewrite proof as-nil equality '(1))
                     '(:failure "MalformedTacticInput" ""))))
        (proof-proof-tidy proof opened)))))

(defun h3-state-true-list-not-string (lib)
  (let* ((name (proof-sym "SELF-H3-TRUE-LIST-NOT-STRING" "ACL2"))
         (proof (library-library-proof lib)))
    (if (assoc-equal name (proof-proof-facts proof))
        (cons name lib)
      (let* ((listp (list *h3-state-true-listp* *library-x*))
             (cons (list *proof-consp* *library-x*))
             (pred (list *h3-state-stringp* *library-x*)))
        (proof-with-checked-results
            ((rule (proof-proof-fact proof "consp-not-stringp" nil))
             (yes (proof-proof-assume proof cons t))
             (positive (proof-proof-modus-ponens proof rule yes))
             (list-hyp (proof-proof-assume proof listp t))
             (opened (proof-proof-unfold proof listp))
             (opened (proof-proof-rewrite proof list-hyp opened '(1)))
             (no (proof-proof-assume proof cons nil))
             (as-nil (proof-proof-prove-if proof opened no))
             (search (h3-rewrite-search-init lib (list (proof-cl "EQ")
                                                       (proof-cl "NULL")
                                                       (proof-cl "ATOM"))
                                             nil nil 150 nil))
             (as-nil (h3-state-open-nil-test proof as-nil search))
             (empty (proof-proof-compute proof (list *h3-state-stringp* *proof-false*)
                                         (cadr *proof-false*)))
             (identity (proof-proof-reflexive proof pred))
             (rewritten (proof-proof-rewrite proof identity as-nil '(1 2 1)))
             (equality (proof-proof-chain proof rewritten (list empty)))
             (negative (h3-rewrite-negation lib equality))
             (cases (proof-proof-cases proof cons positive negative))
             (lib (library-library-lemma lib "H3-TRUE-LIST-NOT-STRING"
                                         (proof-neg pred) cases (list (proof-neg listp)))))
          (cons name lib))))))

(defun h3-state-true-list-length (lib)
  (let* ((name (proof-sym "SELF-H3-TRUE-LIST-LENGTH" "ACL2"))
         (proof (library-library-proof lib)))
    (if (assoc-equal name (proof-proof-facts proof))
        (cons name lib)
      (let ((listp (list *h3-state-true-listp* *library-x*))
            (length (list *h3-state-length* *library-x*)))
        (proof-with-checked-results
            ((opened (proof-proof-unfold proof length))
             (addition (h3-state-true-list-not-string lib))
             (lib (cdr addition))
             (proof (library-library-proof lib))
             (nonstring (proof-proof-fact proof (car addition) nil))
             (literal (proof-step-first opened))
             (right (proof-term-at literal 2))
             (branch (proof-proof-select proof right nonstring))
             (length-eq (proof-proof-chain proof opened (list branch)))
             (lib (library-library-lemma lib "H3-TRUE-LIST-LENGTH"
                                         (proof-eq length (list *library-len* *library-x*))
                                         length-eq (list (proof-neg listp)))))
          (cons name lib))))))

(defun h3-state-state-update (lib formula)
  (let ((names '(("sym" "ACL2" "LEN-UPDATE-NTH")
                 ("sym" "ACL2" "NTH-UPDATE-NTH")
                 ("sym" "ACL2" "TRUE-LISTP-UPDATE-NTH")
                 ("sym" "ACL2" "ASSOC-ADD-PAIR")
                 ("sym" "ACL2" "ORDERED-SYMBOL-ALISTP-ADD-PAIR-FORWARD")
                 ("sym" "ACL2" "ADD-PAIR-PRESERVES-ALL-BOUNDP")
                 ("sym" "ACL2" "CDR-CONS"))))
    (proof-with-checked-results
        ((addition (h3-state-true-list-length lib))
         (lib (cdr addition))
         (rules (h3-rewrite-rules-init lib (append names (list (car addition)))
                                       (list (proof-cl "EQL"))))
         (definitions (append *h3-state-state-fields*
                              (list *h3-state-state-p1* *h3-state-max*
                                    (proof-sym "FORCE" "ACL2")
                                    (proof-sym "NFIX" "ACL2")
                                    (proof-sym "NATP" "ACL2")
                                    *proof-not*)))
         (search (h3-rewrite-search-init lib definitions nil rules 350 nil))
         (step (car (h3-rewrite-search-prove search formula nil))))
      (cons step lib))))
