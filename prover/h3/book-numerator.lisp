  (h3-book-quotient-with-library lib
      ((given (proof-proof-assume (library-library-proof lib) (list *library-rationalp* *library-x*) t))
       (parts (h3-book-numerator-denominator-data lib given))
       (denominator (car parts))
       (numerator (cadr parts))
       (positive (caddr parts))
       (decomposition (cadddr parts))
       (d (h3-book-quotient-step-at denominator 1))
       (n (h3-book-quotient-step-at numerator 1))
       (reciprocal (list *h3-book-arithmetic-divide* d))
       (dr (h3-book-numerator-as-rational lib denominator))
       (dr-first (proof-step-first dr))
       (rr (h3-book-quotient-rational-type lib reciprocal (list (cons dr-first dr))))
       (numeric (h3-book-signs-number lib rr))
       (positive (h3-book-numerator-positive-reciprocal-with-library lib dr positive) :paired)
       (signs (h3-book-signs-sign-evidence-with-library lib numeric 1 positive) :paired)
       (numerator-rational (h3-book-numerator-as-rational lib numerator))
       (relation (h3-book-signs-rational-scaling-with-library lib numerator-rational rr signs orientation) :paired)
       (proof (library-library-proof lib))
