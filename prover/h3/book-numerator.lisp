       (r (car branch))
       (rational (cadr branch))
       (no (caddr branch))
       (search (cadddr branch))
       (sign (h3-book-numerator-numerator-sign-with-library lib rational orientation) :paired)
       (data (h3-book-numerator-denominator-data lib rational))
       (numerator (cadr data))
       (search (h3-rewrite-search-with-lib search lib))
       (yes (car (h3-rewrite-search-prove search target (list given numerator sign))))
       (result (if no (proof-proof-cases (library-library-proof lib) r yes no) yes)))
    (h3-rewrite-implication lib guard result)))

(defun h3-book-numerator-numerator-theorem-integer (lib name formula)
  (let ((proof (library-library-proof lib)))
    (h3-book-quotient-with-library lib
        ((guard (proof-term-at formula 1))
         (integer (proof-proof-assume proof guard t))
         (components (h3-book-numerator-integer-components lib integer))
         (result (if (equal name "INTEGERP==>DENOMINATOR=1") (cadr components) (car components))))
      (h3-rewrite-implication lib guard result))))

(defun h3-book-numerator-numerator-theorem-with-library (lib name formula)
  (cond
   ((member-equal name '("/-PRESERVES-POSITIVE" "/-PRESERVES-NEGATIVE"))
    (h3-book-numerator-reciprocal-sign-with-library lib formula (if (text-ends-with name "POSITIVE") 1 -1)))
   ((equal name "NUMERATOR-NONZERO-FORWARD")
    (h3-book-numerator-num-nonzero-forward-with-library lib formula))
   ((member-equal name '("NUMERATOR-OF-INTEGER-IS-THE-INTEGER-ITSELF" "NUMERATOR-WHEN-INTEGERP"
                         "INTEGERP==>DENOMINATOR=1"))
    (h3-book-numerator-numerator-theorem-integer lib name formula))
   ((equal name "EQUAL-DENOMINATOR-1")
    (h3-book-numerator-denominator-one-with-library lib formula))
   ((equal name "*-R-DENOMINATOR-R")
    (h3-book-numerator-reconstruct-numerator-with-library lib formula))
   (t
    (let ((sign (assoc-equal name *h3-book-numerator-numerator-signs*)))
      (if sign
          (h3-book-numerator-numerator-theorem-sign lib name formula (cdr sign))
        (cons nil lib))))))

(defun h3-book-numerator-numerator-theorem (lib name formula)
  (h3-book-quotient-checked-pair
   (h3-book-numerator-numerator-theorem-with-library lib name formula)))
