(in-package "BOYMOO-PROVER")
(set-verify-guards-eagerness 0)

(defconst *h3-book-numerator-prefix* "H3-BOOK-RATIONAL-")

(defconst *h3-book-numerator-numerator-signs*
  '(("NUMERATOR-LESS-THAN-ZERO" . -1)
    ("NUMERATOR-GREATER-THAN-ZERO" . 1)
    ("NUMERATOR-EQUAL-ZERO" . 0)
    ("NUMERATOR-NEGATIVE-INTEGER-TYPE-PRESCRIPTION" . -1)
    ("NUMERATOR-POSITIVE-INTEGER-TYPE-PRESCRIPTION" . 1)
    ("NUMERATOR-NON-NEGATIVE-INTEGER-TYPE-PRESCRIPTION" . -1)
    ("NUMERATOR-NON-POSITIVE-INTEGER-TYPE-PRESCRIPTION" . 1)))

(defun h3-book-numerator-as-rational (lib integer)
  (proof-with-checked-results
      ((value (h3-book-quotient-step-at integer 1))
       (rule (library-library-axiom lib "INTEGER-IMPLIES-RATIONAL" (list value))))
    (proof-proof-modus-ponens (library-library-proof lib) rule integer)))

(defun h3-book-numerator-denominator-data (lib rational)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((value (h3-book-quotient-step-at rational 1))
         (rule (library-library-axiom lib "RATIONAL-IMPLIES1" (list value)))
         (types (proof-proof-modus-ponens proof rule rational))
         (parts (proof-proof-conjunct proof types))
         (denominator (car parts))
         (rest (cadr parts))
         (parts (proof-proof-conjunct proof rest))
         (numerator (car parts))
         (positive (cadr parts))
         (rule (library-library-axiom lib "RATIONAL-IMPLIES2" (list value)))
         (decomposition (proof-proof-modus-ponens proof rule rational)))
      (list denominator numerator positive decomposition))))

(defun h3-book-numerator-integer-components (lib integer)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((value (h3-book-quotient-step-at integer 1))
         (rational (h3-book-numerator-as-rational lib integer))
         (parts (h3-book-numerator-denominator-data lib rational))
         (denominator (car parts))
         (numerator (cadr parts))
         (positive (caddr parts))
         (reconstruction (cadddr parts))
         (d (h3-book-quotient-step-at denominator 1))
         (nonzero (h3-book-signs-zero-contradiction lib d 2 positive))
         (rational-d (h3-book-numerator-as-rational lib denominator))
         (numeric (h3-book-signs-number lib rational-d))
         (law (h3-book-arithmetic-inverse lib d numeric nonzero))
         (reconstructed (h3-book-quotient-step-at reconstruction 1))
         (rational-n (h3-book-numerator-as-rational lib numerator))
         (numeric-n (h3-book-signs-number lib rational-n))
         (clear (h3-book-quotient-clear-reciprocal lib reconstructed d law numeric-n))
         (scaled (proof-proof-reflexive proof (list *proof-times* reconstructed d)))
         (scaled (proof-proof-rewrite proof scaled reconstruction '(1 2 1)))
         (scaled (proof-proof-rewrite proof scaled clear '(1 1)))
         (product (h3-book-quotient-step-at scaled 2))
         (arranged (h3-book-arithmetic-associative-equal lib product (list *proof-times* d value)))
         (equal-numerator (proof-proof-chain proof scaled (list arranged)))
         (one (h3-book-arithmetic-one-right lib d))
         (fixed (h3-book-arithmetic-fix-value lib d numeric))
         (equal-denominator (proof-proof-chain proof one (list fixed)))
         (equal-denominator (proof-proof-symmetric proof equal-denominator))
         (q-one (library-library-axiom lib "INTEGER-1" nil))
         (lowest (proof-proof-fact proof (proof-sym "LOWEST-TERMS" "ACL2")
                                   (list (list (proof-sym "N" "ACL2") d)
                                         (list *library-x* value)
                                         (list (proof-sym "R" "ACL2") value)
                                         (list (proof-sym "Q" "ACL2") *proof-one*))))
         (search (h3-rewrite-search-init lib nil nil nil 150 nil))
         (facts (h3-rewrite-search-context search (list denominator rational integer q-one positive
                                                        equal-numerator equal-denominator)))
         (test (h3-book-quotient-step-at lowest 1))
         (given (car (h3-rewrite-search-derive search test facts nil nil)))
         (reduced-denominator (proof-proof-modus-ponens proof lowest given))
         (result (proof-proof-rewrite proof equal-numerator reduced-denominator '(1 2 1)))
         (unit (library-library-axiom lib "UNICITY-OF-1" (list value)))
         (numeric-value (h3-book-signs-number lib rational))
         (fixed (h3-book-arithmetic-fix-value lib value numeric-value))
         (times-one (proof-proof-chain proof unit (list fixed)))
         (result (proof-proof-chain proof result (list times-one))))
      (list result reduced-denominator))))

(defun h3-book-numerator-lemma-present-p (lib label)
  (let ((name (proof-sym (concatenate 'string "SELF-" label) "ACL2")))
    (if (assoc-equal name (proof-proof-facts (library-library-proof lib))) t nil)))

(defun h3-book-numerator-positive-reciprocal-case
    (signs lib r r-reciprocal sign-x law positive-one target)
  (if (< 0 (h3-book-signs-signs-sign signs))
      (cons (h3-book-signs-signs-positive signs) lib)
    (h3-book-quotient-with-library lib
        ((result (h3-book-signs-rational-sign-with-library lib r r-reciprocal sign-x signs) :paired)
         (proof (library-library-proof lib))
         (impossible (proof-proof-rewrite proof (h3-book-signs-signs-positive result) law '(1 1 2)))
         (contradiction (proof-proof-cut proof positive-one impossible)))
      (proof-proof-subsume proof contradiction (cons target (proof-step-clause contradiction))))))

(defun h3-book-numerator-positive-reciprocal-lemma (lib label)
  (h3-book-quotient-with-library lib
      ((proof (library-library-proof lib))
       (bound (h3-book-signs-sign-test *library-x* 1))
       (given (proof-proof-assume proof bound t))
       (r (proof-proof-assume proof (list *library-rationalp* *library-x*) t))
       (numeric (h3-book-signs-number lib r))
       (reciprocal (list *h3-book-arithmetic-divide* *library-x*))
       (r-first (proof-step-first r))
       (r-reciprocal (h3-book-quotient-rational-type lib reciprocal (list (cons r-first r))))
       (sign-x (h3-book-signs-sign-evidence-with-library lib numeric 1 given) :paired)
       (law (h3-book-arithmetic-inverse lib *library-x* numeric (h3-book-signs-signs-zero sign-x)))
       (target (h3-book-signs-sign-test reciprocal 1))
       (search (h3-rewrite-search-init lib nil nil nil 150 nil))
       (positive-one (car (h3-rewrite-search-prove search (h3-book-signs-sign-test *proof-one* 1) nil)))
       (numeric-reciprocal (h3-book-signs-number lib r-reciprocal))
       (result (h3-book-quotient-each-sign-with-library
                lib numeric-reciprocal h3-book-quotient-sign-callback h3-book-numerator-positive-reciprocal-case
                r r-reciprocal sign-x law positive-one target) :paired)
       (lib (library-library-lemma lib label target result (list (proof-neg r-first) (proof-neg bound)))))
    nil))

(defun h3-book-numerator-positive-reciprocal-with-library (lib rational positive)
  (let ((label (concatenate 'string *h3-book-numerator-prefix* "POSITIVE-RECIPROCAL")))
    (h3-book-quotient-with-library lib
        ((added (if (h3-book-numerator-lemma-present-p lib label)
                    (cons nil lib)
                  (h3-book-numerator-positive-reciprocal-lemma lib label)) :paired)
         (value (h3-book-quotient-step-at rational 1)))
      (library-library-cite lib label (list value) (list rational positive)))))

