       (aligned (proof-proof-chain proof commuted (list decomposition)))
       (position (if (< 0 orientation) 2 1))
       (relation (proof-proof-rewrite proof relation aligned (list 1 1 position)))
       (relation (proof-proof-symmetric proof relation))
       (claim (proof-step-first relation))
       (premise (proof-step-first given))
       (lib (library-library-lemma lib label claim relation (list (proof-neg premise)))))
    nil))

