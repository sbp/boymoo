(defun h3-book-numerator-theorem-signed-value (guard)
  (proof-with-checked-results ((head (proof-term-at guard 0)))
    (if (equal head *h3-book-signs-case-split*)
        (proof-with-checked-results ((left (proof-term-at guard 1)))
          (proof-term-at left 1))
      (proof-with-checked-results ((right (proof-term-at guard 2))
                                   (test (proof-term-at right 1)))
        (proof-term-at test 1)))))

(defun h3-book-numerator-numerator-theorem-nonstrict (lib search guard target given orientation)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((bound (proof-term-at guard 1))
         (value (proof-term-at bound (if (< 0 orientation) 2 1)))
         (test (list *library-rationalp* value))
         (rational (proof-proof-assume proof test t))
         (other (proof-proof-assume proof test nil))
         (rule (library-library-axiom lib "DEFAULT-NUMERATOR" (list value)))
         (default (proof-proof-modus-ponens proof rule other))
         (result (h3-rewrite-search-prove search target (list given default)))
         (no (car result)))
      (list test rational no (cdr result)))))

