(in-package "BOYMOO-PROVER")
(set-verify-guards-eagerness 0)

(defconst *h3-numeric-complex* (proof-cl "COMPLEX"))
(defconst *h3-numeric-real* (proof-cl "REALPART"))
(defconst *h3-numeric-imaginary* (proof-cl "IMAGPART"))
(defconst *h3-numeric-fix* (proof-sym "FIX" "ACL2"))
(defconst *h3-numeric-realfix* (proof-sym "REALFIX" "ACL2"))

(defun h3-numeric-reduce-with-proofs (search term evidence)
  (proof-with-checked-results ((context (h3-rewrite-search-context search evidence)))
    (h3-rewrite-search-reduce search term context nil nil)))

(defun h3-numeric-reverse-reduction (proof reduced)
  (if reduced
      (proof-proof-symmetric proof reduced)
    '(:failure "MalformedTacticInput" "")))

(defun h3-numeric-complex-zero (lib term)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((real (proof-term-at term 1))
         (search (h3-rewrite-search-init
                  lib (list *h3-numeric-realfix* *h3-numeric-fix*) nil nil 150 nil))
         (rational (list *library-rationalp* real))
         (yes (proof-proof-assume proof rational t))
         (no (proof-proof-assume proof rational nil))
         (result (h3-rewrite-search-prove
                  search (list *library-rationalp* *proof-zero*) nil))
         (imaginary-zero (car result))
         (search (cdr result))
         (imaginary (proof-step-first imaginary-zero))
         (result (h3-rewrite-search-prove
                  search (proof-ite rational imaginary *proof-false*)
                  (list yes imaginary-zero)))
         (both (car result))
         (search (cdr result))
         (definition (library-library-axiom lib "COMPLEX-DEFINITION"
                                            (list real *proof-zero*)))
         (definition (proof-proof-modus-ponens proof definition both))
         (literal (proof-step-first definition))
         (right (proof-term-at literal 2))
         (times (proof-term-at right 2))
         (zero-times (proof-proof-compute proof times 0))
         (definition (proof-proof-rewrite proof definition zero-times '(1 2 2)))
         (commute (library-library-axiom lib "COMMUTATIVITY-OF-+"
                                         (list real *proof-zero*)))
         (zero-left (library-library-axiom lib "UNICITY-OF-0" (list real)))
         (add-zero (proof-proof-chain proof commute (list zero-left)))
         (number (proof-proof-fact proof "rationalp-acl2-numberp"
                                   (list (list *library-x* real))))
         (number (proof-proof-modus-ponens proof number yes))
         (sum (proof-step-first add-zero))
         (right (proof-term-at sum 2))
         (result (h3-numeric-reduce-with-proofs search right (list number)))
         (reduced (car result))
         (search (cadr result))
         (add-zero (proof-proof-chain proof add-zero (list reduced)))
         (rhs (list *h3-numeric-realfix* real))
         (result (h3-numeric-reduce-with-proofs search rhs (list yes)))
         (reduced (car result))
         (search (cadr result))
         (reverse-fix (h3-numeric-reverse-reduction proof reduced))
         (good (proof-proof-chain proof definition (list add-zero reverse-fix)))
         (bad (library-library-axiom lib "COMPLETION-OF-COMPLEX"
                                     (list real *proof-zero*)))
         (bad-literal (proof-step-first bad))
         (bad-right (proof-term-at bad-literal 2))
         (result (h3-numeric-reduce-with-proofs search bad-right (list no)))
         (reduced (car result))
         (search (cadr result))
         (complex-zero (proof-proof-compute
                        proof (list *h3-numeric-complex* *proof-zero* *proof-zero*) 0))
         (result (h3-numeric-reduce-with-proofs search rhs (list no)))
         (reduced-fix (car result))
         (reverse-fix (h3-numeric-reverse-reduction proof reduced-fix))
         (bad (proof-proof-chain proof bad (list reduced complex-zero reverse-fix))))
      (proof-proof-cases proof rational good bad))))

(defun h3-numeric-real-and-imaginary (lib value)
  (proof-with-checked-results
      ((axiom (library-library-axiom lib "COMPLEX-IMPLIES1" (list value))))
    (proof-proof-conjunct (library-library-proof lib) axiom)))

(defun h3-numeric-rational-components (lib rational)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((rational-literal (proof-step-first rational))
         (value (proof-term-at rational-literal 1))
         (bindings (list (list *library-x* value)))
         (imaginary (proof-proof-fact proof "imagpart-rationalp" bindings))
         (imaginary (proof-proof-modus-ponens proof imaginary rational))
         (number (proof-proof-fact proof "rationalp-acl2-numberp" bindings))
         (number (proof-proof-modus-ponens proof number rational))
         (decomposed (library-library-axiom lib "REALPART-IMAGPART-ELIM" (list value)))
         (decomposed (proof-proof-modus-ponens proof decomposed number))
         (decomposed (proof-proof-rewrite proof decomposed imaginary '(1 1 2)))
         (literal (proof-step-first decomposed))
         (complex-value (proof-term-at literal 1))
         (zero (h3-numeric-complex-zero lib complex-value))
         (parts (h3-numeric-real-and-imaginary lib value))
         (search (h3-rewrite-search-init lib (list *h3-numeric-realfix*) nil nil 150 nil))
         (literal (proof-step-first zero))
         (right (proof-term-at literal 2))
         (result (h3-numeric-reduce-with-proofs search right (list (car parts))))
         (reduced (car result))
         (zero (proof-proof-chain proof zero (list reduced)))
         (reversed (proof-proof-symmetric proof zero))
         (real (proof-proof-chain proof reversed (list decomposed))))
      (list real imaginary number))))

(defun h3-numeric-tail (term)
  (if (integerp term)
      '(:failure "MalformedTacticInput" "")
    (cdr term)))

(defun h3-numeric-operands (term count)
  (proof-with-checked-results ((tail (h3-numeric-tail term)))
    (proof-list-of-length tail count)))

(defun h3-numeric-comparison-default (lib formula)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((formula-parts (h3-numeric-operands formula 2))
         (antecedent (car formula-parts))
         (conclusion (cadr formula-parts))
         (conclusion-parts (h3-numeric-operands conclusion 2))
         (left (car conclusion-parts))
         (right (cadr conclusion-parts))
         (antecedent-argument (proof-term-at antecedent 1))
         (absent (proof-term-at antecedent-argument 1))
         (left-first (proof-term-at left 1))
         (remaining (if (equal left-first absent) (proof-term-at left 2) left-first))
         (rational (list *library-rationalp* remaining))
         (not-number (proof-proof-assume proof antecedent t))
         (number-if-rational
          (proof-proof-fact proof "rationalp-acl2-numberp" (list (list *library-x* absent))))
         (absent-rational (list *library-rationalp* absent))
         (absent-as-rational (proof-proof-assume proof absent-rational t))
         (number-if-rational (proof-proof-modus-ponens
                              proof number-if-rational absent-as-rational))
         (not-rational (proof-proof-cut proof number-if-rational not-number))
         (not-rational (proof-proof-front proof not-rational (proof-neg absent-rational)))
         (common (list not-number not-rational))
         (left-args (h3-numeric-tail left))
         (left-completion (library-library-axiom lib "COMPLETION-OF-<" left-args))
         (rational-proof (proof-proof-assume proof rational t))
         (components (h3-numeric-rational-components lib rational-proof))
         (good (car (h3-rewrite-search-prove
                     (h3-rewrite-search-init lib nil nil nil 150 nil)
                     conclusion (append (list left-completion rational-proof)
                                        common components))))
         (not-rational-proof (proof-proof-assume proof rational nil))
         (right-args (h3-numeric-tail right))
         (right-completion (library-library-axiom lib "COMPLETION-OF-<" right-args))
         (bad (car (h3-rewrite-search-prove
                    (h3-rewrite-search-init lib nil nil nil 150 nil)
                    conclusion (append common (list not-rational-proof left-completion
                                                    right-completion)))))
         (cases (proof-proof-cases proof rational good bad)))
      (h3-rewrite-implication lib antecedent cases))))

(defun h3-numeric-rational-sum (lib a b)
  (let ((proof (library-library-proof lib))
        (search (h3-rewrite-search-init lib nil nil nil 150 nil)))
    (proof-with-checked-results
        ((first-a (proof-step-first a))
         (first-b (proof-step-first b))
         (conjunction (car (h3-rewrite-search-prove
                            search (proof-ite first-a first-b *proof-false*) (list a b))))
         (left (proof-term-at first-a 1))
         (right (proof-term-at first-b 1))
         (rule (proof-proof-fact proof "rationalp-binary-+"
                                 (list (list *library-x* left)
                                       (list *library-y* right)))))
      (proof-proof-modus-ponens proof rule conjunction))))

(defun h3-numeric-complete-part (lib start value head index)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((completion (library-library-axiom
                      lib (concatenate 'string "COMPLETION-OF-" (caddr head)) (list value)))
         (literal (proof-step-first completion))
         (if-term (proof-term-at literal 2))
         (branch (proof-proof-if-false proof if-term))
         (completion (proof-proof-chain proof completion (list branch))))
      (proof-proof-rewrite proof start completion (list 1 2 index)))))

(defun h3-numeric-decompose (lib value)
  (let* ((proof (library-library-proof lib))
         (test (list *library-numberp* value))
         (real (list *h3-numeric-real* value))
         (imaginary (list *h3-numeric-imaginary* value)))
    (proof-with-checked-results
        ((elimination (library-library-axiom lib "REALPART-IMAGPART-ELIM" (list value)))
         (number (proof-proof-assume proof test t))
         (good (proof-proof-modus-ponens proof elimination number))
         (bad (proof-proof-reflexive proof (list *h3-numeric-complex* real imaginary)))
         (bad (h3-numeric-complete-part lib bad value *h3-numeric-real* 1))
         (bad (h3-numeric-complete-part lib bad value *h3-numeric-imaginary* 2))
         (zero (proof-proof-compute
                proof (list *h3-numeric-complex* *proof-zero* *proof-zero*) 0))
         (bad (proof-proof-chain proof bad (list zero)))
         (target (list *h3-numeric-fix* value))
         (opened (proof-proof-unfold proof target))
         (second-open (proof-proof-unfold proof target))
         (literal (proof-step-first second-open))
         (if-term (proof-term-at literal 2))
         (branch (proof-proof-if-true proof if-term))
         (closed (proof-proof-chain proof opened (list branch)))
         (reverse (proof-proof-symmetric proof closed))
         (good (proof-proof-chain proof good (list reverse)))
         (opened (proof-proof-unfold proof target))
         (second-open (proof-proof-unfold proof target))
         (literal (proof-step-first second-open))
         (if-term (proof-term-at literal 2))
         (branch (proof-proof-if-false proof if-term))
         (closed (proof-proof-chain proof opened (list branch)))
         (reverse (proof-proof-symmetric proof closed))
         (bad (proof-proof-chain proof bad (list reverse))))
      (proof-proof-cases proof test good bad))))

(defun h3-numeric-expand-complex (lib a b)
  (let ((proof (library-library-proof lib))
        (search (h3-rewrite-search-init lib nil nil nil 150 nil)))
    (proof-with-checked-results
        ((first-a (proof-step-first a))
         (first-b (proof-step-first b))
         (both (car (h3-rewrite-search-prove
                     search (proof-ite first-a first-b *proof-false*) (list a b))))
         (real (proof-term-at first-a 1))
         (imaginary (proof-term-at first-b 1))
         (rule (library-library-axiom lib "COMPLEX-DEFINITION" (list real imaginary))))
      (proof-proof-modus-ponens proof rule both))))

(defun h3-numeric-rewrite-decomposed (lib start value index)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((decomposition (h3-numeric-decompose lib value))
         (reverse (proof-proof-symmetric proof decomposition)))
      (proof-proof-rewrite proof start reverse (list 1 2 index)))))

(defun h3-numeric-rewrite-expanded (lib start parts index)
  (proof-with-checked-results ((expansion (h3-numeric-expand-complex
                                           lib (car parts) (cadr parts))))
    (proof-proof-rewrite (library-library-proof lib) start expansion (list 1 2 index))))

(defun h3-numeric-reassociate-parts (lib start a p c q)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((associate (library-library-axiom lib "ASSOCIATIVITY-OF-+"
                                           (list a p (list *proof-plus* c q))))
         (start (proof-proof-chain proof start (list associate)))
         (associate (library-library-axiom lib "ASSOCIATIVITY-OF-+" (list p c q)))
         (associate (proof-proof-symmetric proof associate))
         (start (proof-proof-rewrite proof start associate '(1 2 2)))
         (commute (library-library-axiom lib "COMMUTATIVITY-OF-+" (list p c)))
         (start (proof-proof-rewrite proof start commute '(1 2 2 1)))
         (associate (library-library-axiom lib "ASSOCIATIVITY-OF-+" (list c p q)))
         (start (proof-proof-rewrite proof start associate '(1 2 2)))
         (associate (library-library-axiom lib "ASSOCIATIVITY-OF-+"
                                           (list a c (list *proof-plus* p q))))
         (associate (proof-proof-symmetric proof associate)))
      (proof-proof-chain proof start (list associate)))))

(defun h3-numeric-addition-of-complex-parts (lib formula)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((operands (h3-numeric-operands formula 2))
         (left (car operands))
         (right (cadr operands))
         (addends (h3-numeric-operands left 2))
         (x (car addends))
         (y (cadr addends))
         (commute (library-library-axiom lib "COMMUTATIVITY-OF-+"
                                         (list *library-x* *proof-zero*)))
         (zero-left (library-library-axiom lib "UNICITY-OF-0" (list *library-x*)))
         (zero-right (proof-proof-chain proof commute (list zero-left)))
         (zero-right-literal (proof-step-first zero-right))
         (lib (library-library-lemma lib "H3-ADD-ZERO-RIGHT" zero-right-literal zero-right nil))
         (proof (library-library-proof lib))
         (rules (h3-rewrite-rules-init
                 lib '(("sym" "ACL2" "SELF-H3-ADD-ZERO-RIGHT")
                       ("sym" "ACL2" "UNICITY-OF-0")
                       ("sym" "ACL2" "COMPLETION-OF-+")) nil))
         (search (h3-rewrite-search-init lib (list *h3-numeric-fix*) nil rules 150 nil))
         (target (proof-eq left (list *proof-plus* (list *h3-numeric-fix* x)
                                      (list *h3-numeric-fix* y))))
         (start (car (h3-rewrite-search-prove search target nil)))
         (start (h3-numeric-rewrite-decomposed lib start x 1))
         (start (h3-numeric-rewrite-decomposed lib start y 2))
         (parts-x (h3-numeric-real-and-imaginary lib x))
         (parts-y (h3-numeric-real-and-imaginary lib y))
         (start (h3-numeric-rewrite-expanded lib start parts-x 1))
         (start (h3-numeric-rewrite-expanded lib start parts-y 2))
         (literal (proof-step-first start))
         (sum (proof-term-at literal 2))
         (summands (h3-numeric-operands sum 2))
         (first-parts (proof-list-of-length (car summands) 3))
         (second-parts (proof-list-of-length (cadr summands) 3))
         (p (caddr first-parts))
         (q (caddr second-parts))
         (start (h3-numeric-reassociate-parts lib start (cadr first-parts) p
                                             (cadr second-parts) q))
         (real-sum (h3-numeric-rational-sum lib (car parts-x) (car parts-y)))
         (imag-sum (h3-numeric-rational-sum lib (cadr parts-x) (cadr parts-y)))
         (other (h3-numeric-expand-complex lib real-sum imag-sum))
         (literal (proof-step-first other))
         (other-left (proof-term-at literal 1)))
      (if (not (equal other-left right))
          '(:failure "ProofMismatch" "")
        (proof-with-checked-results
            ((multiplier (proof-term-at p 1))
             (factor-p (proof-term-at p 2))
             (factor-q (proof-term-at q 2))
             (distributivity (library-library-axiom lib "DISTRIBUTIVITY"
                                                    (list multiplier factor-p factor-q)))
             (other (proof-proof-rewrite proof other distributivity '(1 2 2)))
             (other (proof-proof-symmetric proof other))
             (step (proof-proof-chain proof start (list other))))
          (cons step lib))))))

(defun h3-numeric-part-of-sum (lib formula)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((operands (h3-numeric-operands formula 2))
         (left (proof-list-of-length (car operands) 2))
         (head (car left))
         (args (cadr left))
         (addends (h3-numeric-tail args))
         (add (library-library-axiom lib "ADD-DEF-COMPLEX" addends))
         (x (proof-term-at args 1))
         (parts-x (h3-numeric-real-and-imaginary lib x))
         (y (proof-term-at args 2))
         (parts-y (h3-numeric-real-and-imaginary lib y))
         (real-sum (h3-numeric-rational-sum lib (car parts-x) (car parts-y)))
         (imag-sum (h3-numeric-rational-sum lib (cadr parts-x) (cadr parts-y)))
         (real (proof-step-first real-sum))
         (imaginary (proof-step-first imag-sum))
         (search (h3-rewrite-search-init lib nil nil nil 150 nil))
         (both (car (h3-rewrite-search-prove search (proof-ite real imaginary *proof-false*)
                                            (list real-sum imag-sum))))
         (head-name (proof-term-at head 2))
         (add-literal (proof-step-first add))
         (add-right (proof-term-at add-literal 2))
         (rule-args (h3-numeric-tail add-right))
         (rule (library-library-axiom
                lib (concatenate 'string head-name "-COMPLEX") rule-args))
         (start (proof-proof-reflexive proof left))
         (start (proof-proof-rewrite proof start add '(1 2 1)))
         (end (proof-proof-modus-ponens proof rule both)))
      (proof-proof-chain proof start (list end)))))
