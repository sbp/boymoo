                     library (library-plus *proof-zero* inverse) inverse (list integer)))
         (difference (proof-proof-rewrite proof difference reduction '(1 2 2)))
         (result (proof-proof-rewrite proof negative difference '(1))))
      (proof-proof-tidy proof result))))

