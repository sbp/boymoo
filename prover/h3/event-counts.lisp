(defun h3-event-counts-natural-helpers (library)
  (let ((proof (library-library-proof library)))
    (proof-with-checked-results
        ((neg-int (proof-proof-assume proof (library-lt *library-x* *proof-zero*) t))
         (integer (proof-proof-assume proof (list *proof-integerp* *library-x*) t))
         (positive (h3-event-counts-positive-inverse library integer neg-int))
         (inv (library-minus *library-x*))
         (inv-int (library-library-type-of library inv (list integer)))
         (nonnegative (library-library-cite library "POSITIVE-NONNEGATIVE" (list inv)
                                            (list inv-int positive)))
         (nat (library-library-cite library "NATURAL-FROM-BOUNDS" (list inv)
                                    (list inv-int nonnegative)))
         (claim (proof-step-first nat))
         (integer-test (proof-step-first integer))
         (negative-test (proof-step-first neg-int))
         (library (library-library-lemma library "H3-NATURAL-NEGATIVE-INVERSE" claim nat
                                         (list (proof-neg integer-test) (proof-neg negative-test))))
         (proof (library-library-proof library))
         (length-step (proof-proof-unfold proof (list *h3-event-counts-length* *library-x*)))
         (template (list *library-natp* *proof-result*))
         (right (h3-event-counts-step-term length-step 2))
         (requests (proof-proof-by-value-leaves proof right nil))
         (replies (h3-event-counts-natural-helpers-length-leaves requests library))
         (natural-length (proof-proof-by-value proof right template replies nil))
         (reversed (proof-proof-symmetric proof length-step))
         (natural-length (proof-proof-rewrite-result proof natural-length reversed template *proof-result*))
         (claim (proof-step-first natural-length))
         (library (library-library-lemma library "H3-NATURAL-LENGTH" claim natural-length nil))
         (proof (library-library-proof library))
         (nat-x (proof-proof-assume proof (list *library-natp* *library-x*) t))
         (two (proof-quote 2))
         (word (list *proof-times* two *library-x*))
         (doubled (library-library-axiom library "COMMUTATIVITY-OF-*" (list two *library-x*)))
         (computation (proof-proof-compute proof (library-plus *proof-one* *proof-one*) 2))
         (reversed (proof-proof-symmetric proof computation))
         (doubled (proof-proof-rewrite proof doubled reversed '(1 2 2)))
         (distribution (library-library-axiom library "DISTRIBUTIVITY"
                                               (list *library-x* *proof-one* *proof-one*)))
         (doubled (proof-proof-chain proof doubled (list distribution)))
         (commuted (library-library-axiom library "COMMUTATIVITY-OF-*" (list *library-x* *proof-one*)))
         (unit (library-library-axiom library "UNICITY-OF-1" (list *library-x*)))
         (identity (proof-proof-chain proof commuted (list unit)))
         (nx-int (library-library-cite library "NATURAL-INTEGER" (list *library-x*) (list nat-x)))
         (search (h3-rewrite-search-init library (list (proof-sym "FIX" "ACL2")) nil nil 150 nil))
         (right (h3-event-counts-step-term identity 2))
         (number (library-library-number library *library-x* (list nx-int)))
         (context (h3-rewrite-search-context search (list number)))
         (reduced (car (h3-rewrite-search-reduce search right context nil nil)))
         (identity (proof-proof-chain proof identity (list reduced)))
         (doubled (proof-proof-rewrite proof doubled identity '(1 2 1)))
         (doubled (proof-proof-rewrite proof doubled identity '(1 2 2)))
         (add (library-library-cite library "NATURAL-SUM" (list *library-x* *library-x*) (list nat-x)))
         (doubled-nat (library-library-transport-argument library add doubled 1))
         (claim (proof-step-first doubled-nat)))
      (if (equal claim (list *library-natp* word))
          (proof-with-checked-results
              ((nat-x-test (proof-step-first nat-x))
               (library (library-library-lemma library "H3-NATURAL-DOUBLE" claim doubled-nat
                                               (list (proof-neg nat-x-test)))))
            (cons (list (proof-sym "SELF-H3-NATURAL-NEGATIVE-INVERSE" "ACL2")
                        (proof-sym "SELF-H3-NATURAL-LENGTH" "ACL2")
                        (proof-sym "SELF-H3-NATURAL-DOUBLE" "ACL2")
                        (proof-sym "SELF-NATURAL-SUM" "ACL2")
                        (proof-sym "SELF-NATURAL-FROM-BOUNDS" "ACL2"))
                  library))
        '(:failure "ProofMismatch" "")))))

(defun h3-event-counts-cutoff-rule (library low high)
  (let ((proof (library-library-proof library)))
    (proof-with-checked-results
        ((limit (library-lt low *library-x*))
         (cap-evidence (proof-proof-assume proof limit nil))
         (claim (library-lt *library-x* high))
         (search (h3-rewrite-search-init library nil nil nil 150 nil))
         (result (h3-rewrite-search-prove search (list *library-numberp* low) nil))
         (low-type (car result))
         (search (cdr result))
         (result (h3-rewrite-search-prove search (list *library-numberp* high) nil))
         (high-type (car result))
         (search (cdr result))
         (result (h3-rewrite-search-prove search (library-lt low high) nil))
         (gap (car result))
         (search (cdr result))
         (test (list *library-numberp* *library-x*))
         (numeric (proof-proof-assume proof test t))
         (nonnumeric (proof-proof-assume proof test nil))
         (yes (h3-numeric-order-cite library "WEAK-THEN-LESS" (list *library-x* low high)
                                    (list numeric low-type high-type cap-evidence gap)))
         (axiom (library-library-axiom library "DEFAULT-<-1" (list *library-x* high)))
         (default (proof-proof-modus-ponens proof axiom nonnumeric))
         (result (h3-rewrite-search-prove search (library-lt *proof-zero* high) nil))
         (zero-bound (car result))
         (search (cdr result))
         (other (proof-proof-transport proof zero-bound default))
         (bound (proof-proof-cases proof test yes other))
         (library (library-library-lemma library "H3-CUTOFF-STRICT-BOUND" claim bound (list limit)))
         (proof (library-library-proof library))
         (search (h3-rewrite-search-with-lib search library))
         (increment (library-plus *proof-one* *library-x*))
         (edge (proof-proof-assume proof (library-lt *library-x* low) t))
         (result (h3-rewrite-search-prove search (list *library-numberp* *proof-one*) nil))
         (one (car result))
         (search (cdr result))
         (advanced (h3-numeric-order-cite library "LESS-SHIFT-LEFT"
                                         (list *library-x* low *proof-one*)
                                         (list numeric low-type one edge)))
         (low-value (proof-term-at low 1)))
      (if (not (acl2-numberp low-value))
          '(:failure "MalformedTacticInput" "")
        (proof-with-checked-results
            ((fixed (proof-quote (1+ low-value)))
             (computation (proof-proof-compute proof (library-plus *proof-one* low) (cadr fixed)))
             (advanced (proof-proof-rewrite proof advanced computation '(1 2)))
             (a-type (library-library-cite library "SUM-NUMBER" (list *proof-one* *library-x*) nil))
             (result (h3-rewrite-search-prove search (list *library-numberp* fixed) nil))
             (fixed-type (car result))
             (search (cdr result))
             (result (h3-rewrite-search-prove search (library-lt fixed high) nil))
             (upper-edge (car result))
             (search (cdr result))
             (positive (h3-numeric-order-cite library "LESS-TRANSITIVE" (list increment fixed high)
                                             (list a-type fixed-type high-type advanced upper-edge)))
             (axiom (library-library-axiom library "DEFAULT-+-2" (list *proof-one* *library-x*)))
             (default (proof-proof-modus-ponens proof axiom nonnumeric))
             (fix-search (h3-rewrite-search-init library (list (proof-sym "FIX" "ACL2")) nil nil 150 nil))
             (right (h3-event-counts-step-term default 2))
             (reduced (car (h3-rewrite-search-reduce fix-search right nil nil nil)))
             (default (proof-proof-chain proof default (list reduced)))
             (one-bound (car (h3-rewrite-search-prove search (library-lt *proof-one* high) nil)))
             (negative (library-library-transport-argument library one-bound default 1))
             (bound (proof-proof-cases proof test positive negative))
             (claim (proof-step-first bound))
             (edge-test (proof-step-first edge))
             (library (library-library-lemma library "H3-CUTOFF-INCREMENT-BOUND" claim bound
                                             (list (proof-neg edge-test)))))
          (cons (list (proof-sym "SELF-H3-CUTOFF-INCREMENT-BOUND" "ACL2")
                      (proof-sym "SELF-H3-CUTOFF-STRICT-BOUND" "ACL2"))
                library))))))

