(defun h3-event-counts-event-count-recursive-context
    (recursive-calls formula measure call edges proof context used-substitutions)
  (if (endp recursive-calls)
      (cons context used-substitutions)
    (let* ((recursive (car recursive-calls))
           (bindings (h3-event-counts-event-count-bindings (cdr call) (cdr recursive)))
           (used-substitutions (if (member-equal bindings used-substitutions)
                                   used-substitutions
                                 (append used-substitutions (list bindings)))))
      (proof-with-checked-results
          ((child (proof-term-at recursive 1))
           (head (proof-term-at child 0))
           (smaller (if (assoc-equal head edges)
                        (cdr (assoc-equal head edges))
                      '(:failure "MissingProofData" "")))
           (smaller-claim (proof-step-first smaller))
           (map (h3-event-counts-event-count-binding-map bindings nil))
           (new-measure (proof-subst measure map)))
        (if (equal smaller-claim (list *proof-ordinal-less* new-measure measure))
            (proof-with-checked-results
                ((statement (proof-subst formula map))
                 (hypothesis (proof-proof-assume proof
                                                (proof-ite smaller-claim statement *proof-true*) t))
                 (step (proof-proof-prove-if proof hypothesis smaller)))
              (h3-event-counts-event-count-recursive-context
               (cdr recursive-calls) formula measure call edges proof
               (append context (list step)) used-substitutions))
          '(:failure "ProofMismatch" ""))))))

(defun h3-event-counts-event-count-leaf
    (value tests library call edges formula measure template rules used-substitutions)
  (let ((proof (library-library-proof library)))
    (proof-with-checked-results
        ((context (h3-event-counts-event-count-assumptions tests proof))
         (calls (h3-counts-nested-calls value *h3-event-counts-event-count*))
         (result (h3-event-counts-event-count-recursive-context
                  (proof-unique calls) formula measure call edges proof context used-substitutions))
         (target (proof-subst template (list (cons *proof-result* value))))
         (search (h3-rewrite-search-init library (list (proof-cl "NOT"))
                                        (list (list *library-natp* *proof-zero*)) rules 55 nil))
         (step (car (h3-rewrite-search-prove search target (car result)))))
      (cons step (cdr result)))))

(defun h3-event-counts-event-count-leaves
    (requests library call edges formula measure template rules used-substitutions)
  (if (endp requests)
      (cons nil used-substitutions)
    (proof-with-checked-results
        ((request (car requests))
         (result (h3-event-counts-event-count-leaf
                  (car request) (cadr request) library call edges formula measure
                  template rules used-substitutions))
         (rest (h3-event-counts-event-count-leaves
                (cdr requests) library call edges formula measure template rules (cdr result))))
      (cons (cons (cons request (car result)) (car rest)) (cdr rest)))))

(defun h3-event-counts-event-count (library formula)
  (proof-with-checked-results
      ((library (h3-numeric-order-numeric-order library))
       (proof (library-library-proof library))
       (head (proof-term-at formula 0))
       (typed (equal head *library-implies*))
       (call (if typed
                 (proof-with-checked-results ((consequent (proof-term-at formula 2)))
                   (proof-term-at consequent 1))
               (proof-term-at formula 1)))
       (parts (proof-list-of-length call 4))
       (evg (cadr parts))
       (acc (caddr parts))
       (template (if typed
                     (list *library-implies* (list *library-natp* acc) (list *library-natp* *proof-result*))
                   (proof-with-checked-results ((bound (proof-term-at formula 2)))
                     (library-lt *proof-result* bound))))
       (definitions (list *h3-event-counts-the-check* *h3-event-counts-min-fixnat*
                          (proof-cl "ATOM") (proof-cl "NULL") (proof-cl "EQ")))
       (body (proof-proof-unfold proof call))
       (search (h3-rewrite-search-init library definitions nil nil 150 t))
       (right (h3-event-counts-step-term body 2))
       (normal (car (h3-rewrite-search-reduce search right nil nil nil)))
       (body (proof-proof-chain proof body (list normal)))
       (measure (list *library-count* evg))
       (edges (h3-event-counts-fraction-decreases library evg))
       (entries (list (list *library-car* 2) (list *library-cdr* 3)
                      (list *h3-numeric-real* 18) (list *h3-numeric-imaginary* 19)))
       (edges (h3-event-counts-event-count-edges entries evg library edges))
       (helpers (if typed
                    (h3-event-counts-natural-helpers library)
                  (h3-event-counts-cutoff-rule library (proof-quote 200000) (caddr formula))))
       (library (cdr helpers))
       (proof (library-library-proof library))
       (rules (h3-rewrite-rules-init library (car helpers) nil))
       (right (h3-event-counts-step-term body 2))
       (requests (proof-proof-by-value-leaves proof right nil))
       (leaves (h3-event-counts-event-count-leaves
                requests library call edges formula measure template rules nil))
       (result (proof-proof-by-value proof right template (car leaves) nil))
       (reversed (proof-proof-symmetric proof body))
       (result (proof-proof-rewrite-result proof result reversed template *proof-result*))
       (ordinal (library-library-builtin library 1 evg))
       (result (proof-proof-induct proof ordinal result formula measure (cdr leaves))))
    (cons result library)))
