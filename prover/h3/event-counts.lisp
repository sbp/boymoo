        ((term (h3-event-counts-step-term integer 1))
         (less (library-lt term *proof-zero*))
         (abs-value (list *h3-event-counts-abs* term))
         (search (h3-rewrite-search-init library (list *h3-event-counts-abs*) nil nil 150 nil))
