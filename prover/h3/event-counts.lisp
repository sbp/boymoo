         (context (h3-rewrite-search-context search (list integer negative)))
         (reduction (h3-rewrite-search-reduce search abs-value context nil nil))
         (equation (car reduction))
         (yes (library-library-transport-argument library inverse equation 2))
         (rational (h3-event-counts-rational-integer library integer))
