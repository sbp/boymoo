(defun h3-event-counts-multiply-zero (library factor)
  (let* ((proof (library-library-proof library))
         (value (list *proof-times* factor *proof-zero*)))
    (if (proof-is-call factor *proof-quote*)
        (proof-proof-compute proof value 0)
      (proof-with-checked-results
          ((twice (library-library-axiom library "DISTRIBUTIVITY"
                                          (list factor *proof-zero* *proof-zero*)))
           (zero-sum (proof-proof-compute proof (library-plus *proof-zero* *proof-zero*) 0))
           (twice (proof-proof-rewrite proof twice zero-sum '(1 1 2)))
           (inverse (library-library-axiom library "INVERSE-OF-+" (list value)))
           (after (proof-proof-rewrite proof inverse twice '(1 1 1)))
           (cancel (library-library-axiom library "ASSOCIATIVITY-OF-+"
                                           (list value value (library-minus value))))
           (after (proof-proof-rewrite proof after cancel '(1 1)))
           (after (proof-proof-rewrite proof after inverse '(1 1 2)))
           (closure (library-library-axiom library "CLOSURE" (list factor *proof-zero*)))
           (parts (proof-proof-conjunct proof closure))
           (parts (proof-proof-conjunct proof (cadr parts)))
           (commuted (library-library-axiom library "COMMUTATIVITY-OF-+"
                                             (list value *proof-zero*)))
           (identity (library-library-axiom library "UNICITY-OF-0" (list value)))
           (neutral (proof-proof-chain proof commuted (list identity)))
           (right (h3-event-counts-step-term neutral 2))
           (opened (proof-proof-unfold proof right))
           (right (h3-event-counts-step-term opened 2))
           (selected (proof-proof-select proof right (car parts)))
           (neutral (proof-proof-chain proof neutral (list opened selected)))
           (result (proof-proof-rewrite proof after neutral '(1 1))))
        (proof-proof-tidy proof result)))))

