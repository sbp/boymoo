(defun h3-event-counts-fraction-decreases-edges (edges parent integers library results)
  (if (endp edges)
      results
    (let* ((proof (library-library-proof library))
           (edge (car edges))
           (child (car edge))
           (value (cadr edge))
           (equation (caddr edge))
           (gap (cadddr edge)))
      (proof-with-checked-results
          ((right (h3-event-counts-step-term parent 2))
           (bound (library-library-less-from-difference library value right gap integers))
           (bound (library-library-transport-argument library bound equation 1))
           (bound (library-library-transport-argument library bound parent 2))
           (left (h3-event-counts-step-term equation 1))
           (whole (h3-event-counts-step-term parent 1))
           (ordinal (library-library-ordinal-comparison library left whole))
           (result (proof-proof-transport proof bound ordinal))
           (key (proof-term-at child 0)))
        (h3-event-counts-fraction-decreases-edges
         (cdr edges) parent integers library (table-put results key result))))))

(defun h3-event-counts-fraction-decreases (library value)
  (let ((proof (library-library-proof library)))
    (proof-with-checked-results
        ((rational (proof-proof-assume proof (list *library-rationalp* value) t))
         (noninteger (proof-proof-assume proof (list *proof-integerp* value) nil))
         (axiom (library-library-axiom library "RATIONAL-IMPLIES1" (list value)))
         (fractional (proof-proof-modus-ponens proof axiom rational))
         (parts (proof-proof-conjunct proof fractional))
         (di (car parts))
         (rest (proof-proof-conjunct proof (cadr parts)))
         (ni (car rest))
         (dp (cadr rest))
         (num (h3-event-counts-step-term ni 1))
         (den (h3-event-counts-step-term di 1))
         (abs-num (list *h3-event-counts-abs* num))
         (integers (h3-rewrite-rules-init library '("integerp-unary--") nil))
         (search (h3-rewrite-search-init library (list *h3-event-counts-abs*) nil integers 150 nil))
         (abs-int (car (h3-rewrite-search-prove search (list *proof-integerp* abs-num) (list ni))))
         (nonzero (h3-event-counts-nonzero-numerator library rational noninteger))
         (abs-pos (h3-event-counts-positive-absolute library ni nonzero))
         (num-rational (h3-event-counts-rational-integer library ni))
         (count-num (h3-event-counts-count-number library num-rational ni))
         (den-rational (h3-event-counts-rational-integer library di))
         (count-den (h3-event-counts-count-number library den-rational di))
         (not-negative (library-library-cite library "POSITIVE-NONNEGATIVE" (list den) (list di dp)))
         (search (h3-rewrite-search-init library (list *h3-event-counts-abs*) nil nil 150 nil))
         (right (h3-event-counts-step-term count-den 2))
         (context (h3-rewrite-search-context search (list di not-negative)))
         (reduction (car (h3-rewrite-search-reduce search right context nil nil)))
         (count-den (proof-proof-chain proof count-den (list reduction)))
         (parent (h3-event-counts-count-number library rational noninteger))
         (parent-value (h3-event-counts-step-term parent 2)))
      (if (equal parent-value (library-plus abs-num den))
          (h3-event-counts-fraction-decreases-edges
           (list (list num abs-num count-num dp) (list den den count-den abs-pos))
           parent (list di abs-int) library nil)
        '(:failure "ProofMismatch" "")))))

