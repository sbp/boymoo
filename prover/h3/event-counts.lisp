(defun h3-event-counts-event-count-bindings (variables actuals)
  (cond ((or (endp variables) (endp actuals)) nil)
        ((equal (car variables) (car actuals))
         (h3-event-counts-event-count-bindings (cdr variables) (cdr actuals)))
        (t (cons (list (car variables) (car actuals))
                 (h3-event-counts-event-count-bindings (cdr variables) (cdr actuals))))))

