              library p q positive no backward)))
    (cons step library)))

(defun h3-book-parity-negative-half-successor (library goal integer)
  (h3-book-parity-with-library library
      ((right (proof-term-at goal 2))
       (before (proof-term-at right 1))
       (half (proof-term-at before 1))
       (value (h3-book-parity-step-term integer 1))
       (halved (h3-book-parity-halved-integer library half integer) :library)
       (rational (car halved))
       (doubled (cadr halved))
       (phase (h3-book-parity-half-shift library rational) :library)
       (proof (library-library-proof library))
       (phase-rhs (h3-book-parity-step-term phase 2))
       (selected (proof-proof-select proof phase-rhs doubled))
       (phase (proof-proof-chain proof phase (list selected)))
       (integral (h3-book-parity-step-term phase 1))
       (shifted (proof-term-at integral 1))
       (bounds (h3-book-order-bounds-init library (list rational)))
       (shifted-type (h3-book-order-bounds-rational bounds shifted))
       (opposite (h3-book-parity-integer-negation library shifted-type) :library)
       (coefficient *h3-book-rounding-half*)
       (cancelled (library-library-cite library *h3-book-sums-negate*
                                       (list coefficient half) nil))
       (proof (library-library-proof library))
       (literal (proof-proof-compute proof (library-minus coefficient)
                                     (cadr *h3-book-parity-neg-half*)))
       (cancelled (proof-proof-rewrite proof cancelled literal '(1 2 1)))
       (negative (h3-book-signs-minus-product-with-library
                  library coefficient value t) :library)
       (proof (library-library-proof library))
       (negative (proof-proof-symmetric proof negative))
       (negative (proof-proof-rewrite proof negative literal '(1 2 1)))
       (cancelled (proof-proof-rewrite proof cancelled negative '(1 2 2)))
       (result (proof-proof-chain proof opposite (list phase)))
       (step (proof-proof-rewrite proof result cancelled '(1 1 1))))
    (cons step library)))

(defun h3-book-parity-before-even-integer (library goal context)
  (h3-book-parity-with-library library
      ((predecessor (proof-term-at goal 1))
       (consequent (proof-term-at goal 2))
       (half-predecessor (proof-term-at consequent 1))
       (predecessor-term (proof-term-at predecessor 1))
       (term (proof-term-at predecessor-term 2))
       (integer (h3-book-rounding-clear-integer-divisor library term context)))
    (if (not integer)
        *h3-rewrite-unproved*
      (h3-book-parity-with-library library
          ((half (list *proof-times* *h3-book-rounding-half* term))
           (halved (h3-book-parity-halved-integer library half integer) :library)
           (rational (car halved))
           (doubled (cadr halved))
           (phase (h3-book-parity-half-shift library rational) :library)
           (proof (library-library-proof library))
           (phase-rhs (h3-book-parity-step-term phase 2))
           (selected (proof-proof-select proof phase-rhs doubled))
           (known (h3-book-parity-evidence context (library-integer half)))
           (selected-rhs (h3-book-parity-step-term selected 2))
           (opened (proof-proof-unfold proof selected-rhs))
           (opened-rhs (h3-book-parity-step-term opened 2))
           (known-case (proof-proof-select proof opened-rhs known))
           (phase (proof-proof-chain proof phase (list selected opened known-case)))
           (integral (h3-book-parity-step-term phase 1))
           (shifted (proof-term-at integral 1))
           (offset-type (h3-book-parity-search-prove library (library-integer *proof-neg-one*)))
           (bounds (h3-book-order-bounds-init library (list rational)))
           (shifted-type (h3-book-order-bounds-rational bounds shifted))
           (offset (h3-book-parity-integer-offset library offset-type shifted-type) :library)
           (half *h3-book-rounding-half*)
           (alignment (library-library-axiom
                       library "DISTRIBUTIVITY" (list half *proof-neg-one* term)))
           (proof (library-library-proof library))
           (literal (proof-proof-compute
                     proof (list *proof-times* half *proof-neg-one*)
                     (cadr *h3-book-parity-neg-half*)))
           (alignment (proof-proof-rewrite proof alignment literal '(1 2 1)))
           (alignment-rhs (h3-book-parity-step-term alignment 2))
           (offset-integral (h3-book-parity-step-term offset 1))
           (offset-term (proof-term-at offset-integral 1))
           (normalized (h3-book-translation-sum-equality-with-library
                        library alignment-rhs offset-term (list rational integer)) :library)
           (proof (library-library-proof library))
           (alignment (proof-proof-chain proof alignment (list normalized)))
           (reverse-alignment (proof-proof-symmetric proof alignment))
           (offset (proof-proof-rewrite proof offset reverse-alignment '(1 1 1)))
           (after (proof-proof-chain proof offset (list phase)))
           (after-test (h3-book-parity-step-term after 1)))
        (if (equal after-test half-predecessor)
            (proof-with-checked-results
                ((predecessor-int (library-library-type-of library predecessor-term (list integer)))
                 (nonintegral (h3-rewrite-negation library after))
                 (step (h3-book-floor-conjunct-proof library (list predecessor-int nonintegral))))
              (cons step library))
          '(:failure "failure" ""))))))

(defun h3-book-parity-phase-target (goal)
  (proof-with-checked-results
      ((shifted
        (cond ((proof-is-call goal *proof-equal*)
               (proof-term-at goal 1))
              ((proof-is-call goal *library-implies*)
               (proof-with-checked-results ((left (proof-term-at goal 1)))
                 (if (proof-is-call left *proof-integerp*)
                     left
                   (proof-term-at goal 2))))
              (t nil))))
    (if (proof-is-call shifted *proof-integerp*)
        (proof-with-checked-results ((sum (proof-term-at shifted 1)))
          (if (proof-is-call sum *proof-plus*)
              (proof-with-checked-results ((offset (proof-term-at sum 1)))
                (if (equal offset *h3-book-rounding-half*)
                    (proof-term-at sum 2)
                  :none))
            :none))
      :none)))

(defun h3-book-parity-phase-theorem (library goal value context)
  (h3-book-parity-with-library library
      ((rational (h3-book-order-bounds-rational context value))
       (result (h3-book-parity-half-shift library rational) :library)
       (literal (proof-step-first result)))
    (if (equal literal goal)
        (cons result library)
      (proof-with-checked-results
          ((parts (proof-list-of-length (cdr literal) 2))
           (left (car parts))
           (right (cadr parts))
           (proof (library-library-proof library)))
        (cond
         ((proof-is-call goal *library-implies*)
          (proof-with-checked-results
              ((step
                (cond
                 ((equal (cdr goal) (list left right))
                  (proof-with-checked-results ((given (proof-proof-assume proof left t)))
                    (proof-proof-rewrite proof given result '(1))))
                 ((equal (cdr goal) (list right left))
                  (proof-with-checked-results ((given (proof-proof-assume proof right t)))
                    (proof-proof-transport proof given result)))
                 (t nil))))
            (if step
                (proof-with-checked-results
                    ((antecedent (proof-term-at goal 1))
                     (implication (h3-rewrite-implication library antecedent step)))
                  (cons implication library))
              (cons nil library))))
         (t
          (proof-with-checked-results ((goal-left (proof-term-at goal 1)))
            (if (equal goal-left left)
                (proof-with-checked-results
                    ((goal-right (proof-term-at goal 2))
                     (right-branch (proof-term-at right 2)))
                  (if (equal goal-right right-branch)
                      (proof-with-checked-results
                          ((test (proof-term-at right 1))
                           (given (table-get (h3-book-order-bounds-evidence context)
                                               test nil)))
                        (if given
                            (proof-with-checked-results
                                ((selected (proof-proof-select proof right given))
                                 (step (proof-proof-chain proof result (list selected))))
                              (cons step library))
                          (cons nil library)))
                    (cons nil library)))
              (cons nil library)))))))))

(defconst *h3-book-parity-odd-sums*
  '("INTEGERP-SUM-OF-ODDS-OVER-2" "INTEGERP-SUM-OF-ODDS-OVER-2-LEADING-CONSTANT"))

(defun h3-book-parity-parity-theorem-with-library (library name formula)
  (if (not (proof-is-call formula *library-implies*))
      (cons nil library)
    (h3-book-parity-with-library library
        ((parts (proof-list-of-length (cdr formula) 2))
         (guard (car parts))
         (goal (cadr parts))
         (value (h3-book-parity-phase-target goal)))
      (if (and (equal value :none)
               (not (member-equal name
                                  (append *h3-book-parity-odd-sums*
                                          '("X-OR-X/2" "EVEN-AND-ODD-ALTERNATE-3"
                                            "EVEN-ODD-5")))))
          (cons nil library)
        (h3-book-parity-with-library library
            ((proof (library-library-proof library))
             (given (proof-proof-assume proof guard t))
             (context (h3-book-order-bounds-init library (list given)))
             (step
              (cond
               ((not (equal value :none))
                (h3-book-parity-phase-theorem library goal value context))
               ((member-equal name *h3-book-parity-odd-sums*)
                (h3-book-parity-with-library library
                    ((left (proof-term-at goal 1))
                     (term (if (proof-is-call goal *proof-equal*)
                               (proof-term-at left 1)
                             left))
                     (terms (if (integerp term)
                                (proof-term-at term 1)
                              (proof-list-of-length (cdr term) 2)))
                     (x (car terms))
                     (y (cadr terms))
                     (first (h3-book-order-bounds-rational context x))
                     (second (h3-book-order-bounds-rational context y))
                     (double (h3-book-parity-evidence context
                                                     (library-integer (h3-book-parity-twice x))))
                     (fractional (h3-book-parity-evidence context
                                                         (proof-neg (library-integer x))))
                     (sum (h3-book-parity-odd-half-sum
                           library first second double fractional) :library))
                  (if (proof-is-call goal *proof-integerp*)
                      (proof-with-checked-results
                          ((right (h3-book-parity-step-term sum 2))
                           (test (proof-term-at right 1))
                           (test-step (h3-book-parity-evidence context test))
                           (branch (proof-term-at right 2))
                           (branch-step (h3-book-parity-evidence context branch))
                           (conclusion (h3-book-floor-conjunct-proof library
                                                                    (list test-step branch-step)))
                           (step (proof-proof-transport (library-library-proof library)
                                                        conclusion sum)))
                        (cons step library))
                    (cons sum library))))
               ((equal name "EVEN-ODD-5")
                (h3-book-parity-before-even-integer library goal context))
               (t
                (proof-with-checked-results ((integer (proof-proof-assume proof guard t)))
                  (if (equal name "X-OR-X/2")
                      (h3-book-parity-halve-successor library goal integer)
                    (h3-book-parity-negative-half-successor library goal integer)))))
              :library))
          (if step
              (proof-with-checked-results ((implication (h3-rewrite-implication library guard step)))
                (cons implication library))
            (cons nil library)))))))

