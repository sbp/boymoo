         (equality (h3-book-translation-sum-equality-with-library
                    library term total (list integer rational)) :library)
         (step (library-library-transport-argument library whole equality 1)))
      (cons step library))))

(defun h3-book-parity-integer-offset-backward (typed library shifted integer)
