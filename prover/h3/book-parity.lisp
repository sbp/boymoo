(in-package "BOYMOO-PROVER")
(set-verify-guards-eagerness 0)

(defconst *h3-book-parity-half-offset* "H3-BOOK-HALF-INTEGER-OFFSET")
(defconst *h3-book-parity-half-shift* "H3-BOOK-HALF-INTEGER-SHIFT")
(defconst *h3-book-parity-neg-half* (proof-quote '("ratio" -1 2)))

(defun h3-book-parity-remember-library (result library)
  (if (failure-p result) (cons result library) result))

; Retain the Library when a later proof operation fails.
(defmacro h3-book-parity-with-library (library bindings result)
  (if (endp bindings)
      `(h3-book-parity-remember-library ,result ,library)
    (let* ((binding (car bindings))
           (name (car binding))
           (form (cadr binding))
           (next `(h3-book-parity-with-library ,library ,(cdr bindings) ,result)))
      (cond
       ((eq (caddr binding) :library)
        `(let ((parity-reply (h3-book-parity-remember-library ,form ,library)))
           (let ((,name (car parity-reply))
                 (,library (cdr parity-reply)))
             (if (failure-p ,name) parity-reply ,next))))
       ((eq name library)
        `(let ((parity-library ,form))
           (if (failure-p parity-library)
               (cons parity-library ,library)
             (let ((,library parity-library))
               ,next))))
       (t
        `(let ((,name ,form))
           (if (failure-p ,name) (cons ,name ,library) ,next)))))))

(defun h3-book-parity-step-term (step index)
  (proof-with-checked-results ((literal (proof-step-first step)))
    (proof-term-at literal index)))

(defun h3-book-parity-search-prove (library goal)
  (proof-with-checked-results
      ((search (h3-rewrite-search-init library nil nil nil 150 nil))
       (result (h3-rewrite-search-prove search goal nil)))
    (car result)))

(defun h3-book-parity-evidence (context term)
  (let ((entry (assoc-equal term (h3-book-order-bounds-evidence context))))
    (if entry
        (cdr entry)
      '(:failure "failure" ""))))

(defun h3-book-parity-twice (term)
  (list *proof-times* *h3-book-rounding-two* term))

(defun h3-book-parity-two-sign-with-library (library)
  (let ((two *h3-book-rounding-two*))
    (h3-book-parity-with-library library
        ((search (h3-rewrite-search-init library nil nil nil 150 nil))
         (whole-result (h3-rewrite-search-prove search (library-integer two) nil))
         (whole (car whole-result))
         (rational (h3-book-numerator-as-rational library whole))
         (numeric (h3-book-signs-number library rational))
         (positive-result
          (h3-rewrite-search-prove (cdr whole-result)
                                   (library-lt *proof-zero* two) nil))
         (positive (car positive-result))
         (signs (h3-book-signs-sign-evidence-with-library library numeric 1 positive) :library)
         (law (h3-book-arithmetic-inverse library two numeric
                                          (h3-book-signs-signs-zero signs))))
      (cons (list whole rational signs law) library))))

(defun h3-book-parity-half-offset-proof (library rational double fractional)
  (let ((two *h3-book-rounding-two*))
    (h3-book-parity-with-library library
        ((term (h3-book-parity-step-term rational 1))
         (doubled (h3-book-parity-step-term double 1))
         (q (list *h3-book-floor-floor* doubled two))
         (two-result (h3-book-parity-two-sign-with-library library) :library)
         (two-int (car two-result))
         (two-rat (cadr two-result))
         (signs (caddr two-result))
         (law (cadddr two-result))
         (ratio (h3-book-floor-floor-ratio doubled two))
         (recover (h3-book-quotient-cancel-inverse-pair library ratio two term law))
         (term-number (h3-book-signs-number library rational))
         (term-fixed (h3-book-arithmetic-fix-value library term term-number))
         (proof (library-library-proof library))
         (recover (proof-proof-chain proof recover (list term-fixed)))
         (ratio-rat (library-library-transport-argument library rational recover 1))
         (bounds (h3-book-floor-floor-bounds-with-library library q ratio-rat) :library)
         (q-int (car bounds))
         (lower (cadr bounds))
         (upper (caddr bounds))
         (d-rat (h3-book-numerator-as-rational library double))
         (lower (h3-book-rounding-multiply-ratio-bound-with-library
                 library lower d-rat two-rat signs) :library)
         (upper (h3-book-rounding-multiply-ratio-bound-with-library
                 library upper d-rat two-rat signs) :library)
         (lower-comparison (h3-book-parity-step-term lower 1))
         (bottom (proof-term-at lower-comparison 2))
         (bottom-int (library-library-type-of library bottom (list q-int two-int)))

         (test (proof-eq bottom doubled))
         (proof (library-library-proof library))
         (ratio-reflexive (proof-proof-reflexive proof ratio))
         (assumed (proof-proof-assume proof test t))
         (reverse-test (proof-proof-symmetric proof assumed))
         (integral (proof-proof-rewrite proof ratio-reflexive reverse-test '(1 2 1)))
         (integral-ratio (h3-book-parity-step-term integral 2))
         (cancelled (h3-book-quotient-cancel-inverse-pair library integral-ratio two q law))
         (q-rat (h3-book-numerator-as-rational library q-int))
         (q-number (h3-book-signs-number library q-rat))
         (q-fixed (h3-book-arithmetic-fix-value library q q-number))
         (cancelled (proof-proof-chain proof cancelled (list q-fixed)))
         (reverse-recover (proof-proof-symmetric proof recover))
         (integral (proof-proof-chain proof reverse-recover (list integral cancelled)))
         (term-integral (library-library-transport-argument library q-int integral 1))
         (collision (proof-proof-cut proof term-integral fractional))
         (different (proof-proof-front proof collision (proof-neg test)))
         (bottom-rat (h3-book-numerator-as-rational library bottom-int))
         (bottom-number (h3-book-signs-number library bottom-rat))
         (d-number (h3-book-signs-number library d-rat))
         (strict (h3-book-floor-strict-from-weak-with-library
                  library bottom-number d-number lower different) :library)
         (lo (h3-book-floor-integer-gap-with-library library bottom-int double strict) :library)

         (high (h3-book-parity-step-term upper 2))
         (high-int (library-library-type-of library high (list q-int two-int)))
         (hi (h3-book-floor-integer-gap-with-library library double high-int upper) :library)
         (two-number (h3-book-signs-number library two-rat))
         (expand (h3-book-floor-times-successor library two q two-number))
         (proof (library-library-proof library))
         (hi (proof-proof-rewrite proof hi expand '(1 1 1)))
         (next-integer (library-plus *proof-one* bottom))
         (sums (h3-book-sums-book-sums-init library))
         (hi-comparison (h3-book-parity-step-term hi 1))
         (comparison (h3-book-sums-cancel-comparison
                      library sums hi-comparison (library-lt next-integer doubled)
                      (list q-int double bottom-int)))
         (hi (proof-proof-rewrite proof hi comparison '(1 1)))
         (library (h3-numeric-order-numeric-order library))
         (neighbor (library-library-type-of library next-integer (list bottom-int)))
         (d-number (h3-book-signs-number library d-rat))
         (neighbor-rat (h3-book-numerator-as-rational library neighbor))
         (neighbor-number (h3-book-signs-number library neighbor-rat))
         (equal-step
          (h3-numeric-order-cite library "WEAK-ANTISYMMETRIC" (list doubled next-integer)
                                (list d-number neighbor-number hi lo)))
         (proof (library-library-proof library))
         (reverse-recover (proof-proof-symmetric proof recover))
         (shifted (proof-proof-rewrite proof reverse-recover equal-step '(1 2 1)))
         (sum (h3-book-translation-sum-ratio library *proof-one* bottom two))
         (shifted (proof-proof-chain proof shifted (list sum)))
         (literal (h3-book-parity-search-prove
                   library (proof-eq (h3-book-floor-floor-ratio *proof-one* two)
                                     *h3-book-rounding-half*)))
         (shifted (proof-proof-rewrite proof shifted literal '(1 2 1)))
         (step (proof-proof-rewrite proof shifted cancelled '(1 2 2))))
      (cons step library))))

(defun h3-book-parity-half-offset-with-library (library rational double fractional)
  (let* ((lemma *h3-book-parity-half-offset*)
         (name (proof-sym (concatenate 'string "SELF-" lemma) "ACL2"))
         (proof (library-library-proof library)))
    (h3-book-parity-with-library library
        ((registered
          (if (assoc-equal name (proof-proof-facts proof))
              (cons nil library)
            (h3-book-parity-with-library library
                ((r (proof-proof-assume proof (list *library-rationalp* *library-x*) t))
                 (d (proof-proof-assume
                     proof (library-integer (h3-book-parity-twice *library-x*)) t))
                 (f (proof-proof-assume proof (library-integer *library-x*) nil))
                 (result (h3-book-parity-half-offset-proof library r d f) :library)
                 (claim (proof-step-first result))
                 (r-literal (proof-step-first r))
                 (d-literal (proof-step-first d))
                 (f-condition (h3-book-parity-step-term f 1))
                 (library (library-library-lemma
                           library lemma claim result
                           (list (proof-neg r-literal) (proof-neg d-literal) f-condition))))
              (cons nil library)))
          :library)
         (term (h3-book-parity-step-term rational 1))
         (step (library-library-cite library lemma (list term)
                                     (list rational double fractional))))
      (cons step library))))

(defun h3-book-parity-half-reconstruction-with-library (library term integer)
  (let* ((two *h3-book-rounding-two*)
         (half *h3-book-rounding-half*)
         (reciprocal (list *h3-book-arithmetic-divide* two))
         (proof (library-library-proof library)))
    (h3-book-parity-with-library library
        ((value (h3-book-parity-step-term integer 1))
         (step (proof-proof-reflexive proof (h3-book-parity-twice term)))
         (step
          (cond ((integerp term) (proof-term-at term 1))
                ((member-equal half (cdr term))
                 (proof-with-checked-results
                     ((second (proof-term-at term 2))
                      (computed (proof-proof-compute proof reciprocal (cadr half)))
                      (coefficient (proof-proof-symmetric proof computed)))
                   (proof-proof-rewrite proof step coefficient
                                        (list 1 2 2 (if (equal second half) 2 1)))))
                (t step)))
         (two-result (h3-book-parity-two-sign-with-library library) :library)
         (law (cadddr two-result))
         (rational (h3-book-numerator-as-rational library integer))
         (product (h3-book-parity-step-term step 2))
         (cancelled (h3-book-quotient-cancel-inverse-pair library product two value law))
         (numeric (h3-book-signs-number library rational))
         (fixed (h3-book-arithmetic-fix-value library value numeric))
         (identity (proof-proof-chain (library-library-proof library) step
                                      (list cancelled fixed))))
      (cons identity library))))

(defun h3-book-parity-type-after-sum (library first second target)
  (h3-book-parity-with-library library
      ((left (h3-book-parity-step-term first 1))
       (right (h3-book-parity-step-term second 1))
