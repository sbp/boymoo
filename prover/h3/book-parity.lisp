(defun h3-book-parity-halve-successor (library goal integer)
  (h3-book-parity-with-library library
      ((parts (if (integerp goal)
                  (proof-term-at goal 1)
                (proof-list-of-length (cdr goal) 3)))
       (before (car parts))
       (after (caddr parts))
       (half (proof-term-at before 1))
       (value (h3-book-parity-step-term integer 1))
       (halved (h3-book-parity-halved-integer library half integer) :library)
       (rational (car halved))
       (doubled (cadr halved))
       (equivalence (h3-book-parity-half-shift library rational) :library)
       (proof (library-library-proof library))
       (odd (proof-proof-assume proof before nil))
       (phase (h3-book-floor-conjunct-proof library (list doubled odd)))
       (shifted (proof-proof-transport proof phase equivalence))
       (two *h3-book-rounding-two*)
       (aligned (h3-book-translation-sum-ratio library *proof-one* value two))
       (one-half (h3-book-parity-search-prove
                  library (proof-eq (h3-book-floor-floor-ratio *proof-one* two)
                                    *h3-book-rounding-half*)))
       (aligned (proof-proof-rewrite proof aligned one-half '(1 2 1)))
       (shifted (library-library-transport-argument library shifted aligned 1))
       (shifted-literal (proof-step-first shifted)))
    (if (equal shifted-literal after)
        (proof-with-checked-results
            ((even (proof-proof-assume proof before t))
             (odd (proof-proof-assume proof before nil))
             (even-case (proof-proof-select proof goal even))
             (yes (proof-proof-transport proof even even-case))
             (odd-case (proof-proof-select proof goal odd))
             (no (proof-proof-transport proof shifted odd-case))
             (step (proof-proof-cases proof before yes no)))
          (cons step library))
      '(:failure "failure" ""))))

