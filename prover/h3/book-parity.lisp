(defun h3-book-parity-integer-offset (library integer rational)
  (h3-book-parity-with-library library
      ((offset (h3-book-parity-step-term integer 1))
       (term (h3-book-parity-step-term rational 1))
       (shifted (library-plus offset term))
       (p (library-integer shifted))
       (q (library-integer term))
       (opposite (library-library-type-of library (library-minus offset) (list integer)))
       (start (h3-book-floor-equivalent-booleans-start-with-library library p) :library)
       (forward (h3-book-parity-integer-offset-forward
                 (car start) library shifted offset opposite term integer rational) :library)
       (positive (h3-book-floor-equivalent-booleans-positive-with-library
                  library (cadr start) forward) :library)
       (proof (library-library-proof library))
       (no (proof-proof-assume proof p nil))
       (assumed (proof-proof-assume proof q t))
       (backward (h3-book-parity-integer-offset-backward assumed library shifted integer))
       (step (h3-book-floor-equivalent-booleans-finish
              library p q positive no backward)))
    (cons step library)))

(defun h3-book-parity-doubled-after-shift (library rational shifted)
  (let* ((two *h3-book-rounding-two*)
         (half *h3-book-rounding-half*)
         (proof (library-library-proof library)))
    (h3-book-parity-with-library library
        ((term (h3-book-parity-step-term rational 1))
         (shifted-term (h3-book-parity-step-term shifted 1))
         (twice-shifted (library-library-type-of
                         library (h3-book-parity-twice shifted-term) (list shifted)))
         (distribute (library-library-axiom library "DISTRIBUTIVITY" (list two half term)))
         (times-half (proof-proof-compute proof (list *proof-times* two half) 1))
         (distribute (proof-proof-rewrite proof distribute times-half '(1 2 1)))
         (typed-sum (proof-proof-rewrite proof twice-shifted distribute '(1 1)))
         (sum (h3-book-parity-step-term typed-sum 1))
         (total (library-plus *proof-neg-one* sum))
         (integer (library-library-type-of library total (list typed-sum)))
         (align (h3-book-translation-sum-equality-with-library
                 library (h3-book-parity-twice term) total (list rational)) :library)
         (step (library-library-transport-argument library integer align 1)))
      (cons step library))))

(defun h3-book-parity-half-shift-proof (library rational)
  (let ((half *h3-book-rounding-half*))
    (h3-book-parity-with-library library
        ((x (h3-book-parity-step-term rational 1))
         (shifted (library-plus half x))
         (left (library-integer shifted))
         (before (library-integer x))
         (double (library-integer (h3-book-parity-twice x)))
         (right (proof-ite double (proof-neg before) *proof-false*))
         (registered (h3-book-sums-lemmas-with-library library) :library)
         (proof (library-library-proof library))

         (before-int (proof-proof-assume proof before t))
         (opposite (library-library-type-of library (library-minus x) (list before-int)))
         (left-assumption (proof-proof-assume proof left t))
         (bad (h3-book-parity-type-after-sum library left-assumption opposite half) :library)
         (half-noninteger (h3-book-parity-search-prove
                           library (proof-neg (library-integer half))))
         (proof (library-library-proof library))
         (impossible (proof-proof-cut proof bad half-noninteger))
         (absent (proof-proof-front proof impossible (proof-neg left)))
         (absent (h3-rewrite-nil-value library absent))
         (deduction (proof-proof-unfold proof (proof-neg before)))
         (deduction-rhs (h3-book-parity-step-term deduction 2))
         (fails (proof-proof-select proof deduction-rhs before-int))
         (fails (proof-proof-chain proof deduction (list fails)))
         (reverse-fails (proof-proof-symmetric proof fails))
         (absent (proof-proof-chain proof absent (list reverse-fails)))

         (fractional (proof-proof-assume proof before nil))
         (double-int (proof-proof-assume proof double t))
         (offset (h3-book-parity-half-offset-with-library
                  library rational double-int fractional) :library)
         (offset-sum (h3-book-parity-step-term offset 2))
         (q (proof-term-at offset-sum 2))
         (q-int (h3-book-floor-floor-is-integer-with-library library q) :library)
         (proof (library-library-proof library))
         (changed (proof-proof-reflexive proof shifted))
         (changed (proof-proof-rewrite proof changed offset '(1 2 2)))
         (changed-rhs (h3-book-parity-step-term changed 2))
         (normalized (h3-book-translation-sum-equality-with-library
                      library changed-rhs (library-plus *proof-one* q) (list q-int)) :library)
         (whole (library-library-type-of library (library-plus *proof-one* q) (list q-int)))
         (proof (library-library-proof library))
         (identity (proof-proof-chain proof changed (list normalized)))
         (shifted-int (library-library-transport-argument library whole identity 1))
         (succeeds (proof-proof-select proof deduction-rhs fractional))
         (succeeds (proof-proof-chain proof deduction (list succeeds)))
         (present (h3-book-signs-predicate-value-with-library library shifted-int) :library)
         (proof (library-library-proof library))
         (reverse-succeeds (proof-proof-symmetric proof succeeds))
         (present (proof-proof-chain proof present (list reverse-succeeds)))

         (yes (proof-proof-cases proof before absent present))
         (double-int (proof-proof-assume proof double t))
         (selected (proof-proof-select proof right double-int))
         (reverse-selected (proof-proof-symmetric proof selected))
         (yes (proof-proof-chain proof yes (list reverse-selected)))
         (left-assumption (proof-proof-assume proof left t))
         (doubled (h3-book-parity-doubled-after-shift library rational left-assumption) :library)
         (proof (library-library-proof library))
         (double-not-int (proof-proof-assume proof double nil))
         (contrary (proof-proof-cut proof doubled double-not-int))
         (no (proof-proof-front proof contrary (proof-neg left)))
         (no (h3-rewrite-nil-value library no))
         (double-not-int (proof-proof-assume proof double nil))
         (selected (proof-proof-select proof right double-not-int))
         (reverse-selected (proof-proof-symmetric proof selected))
         (no (proof-proof-chain proof no (list reverse-selected)))
         (step (proof-proof-cases proof double yes no)))
      (cons step library))))

(defun h3-book-parity-half-shift (library rational)
  (let* ((lemma *h3-book-parity-half-shift*)
         (name (proof-sym (concatenate 'string "SELF-" lemma) "ACL2"))
         (proof (library-library-proof library)))
    (h3-book-parity-with-library library
        ((registered
          (if (assoc-equal name (proof-proof-facts proof))
              (cons nil library)
            (h3-book-parity-with-library library
                ((given (proof-proof-assume proof (list *library-rationalp* *library-x*) t))
                 (result (h3-book-parity-half-shift-proof library given) :library)
                 (claim (proof-step-first result))
                 (given-literal (proof-step-first given))
                 (library (library-library-lemma
                           library lemma claim result (list (proof-neg given-literal)))))
              (cons nil library)))
          :library)
         (value (h3-book-parity-step-term rational 1))
         (step (library-library-cite library lemma (list value) (list rational))))
      (cons step library))))

(defun h3-book-parity-odd-half-sum (library first second double fractional)
  (h3-book-parity-with-library library
      ((offset (h3-book-parity-half-offset-with-library
                library first double fractional) :library)
       (x (h3-book-parity-step-term first 1))
       (y (h3-book-parity-step-term second 1))
       (offset-sum (h3-book-parity-step-term offset 2))
       (q (proof-term-at offset-sum 2))
       (new-value (library-plus *h3-book-rounding-half* y))
       (q-int (h3-book-floor-floor-is-integer-with-library library q) :library)
       (proof (library-library-proof library))
       (changed (proof-proof-reflexive proof (library-plus x y)))
       (changed (proof-proof-rewrite proof changed offset '(1 2 1)))
       (changed-rhs (h3-book-parity-step-term changed 2))
       (arranged (h3-book-arithmetic-associative-equal library changed-rhs
                                                      (library-plus q new-value)))
       (identity (proof-proof-chain proof changed (list arranged)))
       (bounds (h3-book-order-bounds-init library (list second)))
       (shifted-rational (h3-book-order-bounds-rational bounds new-value))
       (result (h3-book-parity-integer-offset library q-int shifted-rational) :library)
       (proof (library-library-proof library))
       (reverse-identity (proof-proof-symmetric proof identity))
       (result (proof-proof-rewrite proof result reverse-identity '(1 1 1)))
       (phase (h3-book-parity-half-shift library second) :library)
       (step (proof-proof-chain (library-library-proof library) result (list phase))))
