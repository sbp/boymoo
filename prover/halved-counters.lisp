(in-package "BOYMOO-PROVER")
(set-verify-guards-eagerness 0)

(defun halved-counters-counter-definitions (names definitions)
  (cond ((endp names) nil)
        ((assoc-equal (car names) definitions)
         (cons (car names)
               (halved-counters-counter-definitions (cdr names) definitions)))
        (t (halved-counters-counter-definitions (cdr names) definitions))))

(defun halved-counters-rulers-for-library (rulers lib updated)
  (if (equal (rulers-rulers-proof rulers) lib)
      (rulers-rulers-with-proof rulers updated)
    rulers))

(defun halved-counters-library-ordinal-comparison (lib a b)
  (if (eq (proof-proof-kind (library-library-proof lib)) :base)
      (proof-with-checked-results
       ((comparison (library-library-ordinal-comparison lib a b)))
       (cons comparison lib))
    (proof-with-checked-results
     ((a-type (lemmas-slice-library-type-of lib a nil))
      (b-type (lemmas-slice-library-type-of (cdr a-type) b nil))
      (lib (cdr b-type))
      (comparison (library-library-cite lib "FINITE-ORDER" (list a b)
                                        (list (car a-type) (car b-type)))))
     (cons comparison lib))))

(defun halved-counters-shifted-base (lib value integral positive-value nonunit)
  (let* ((proof (library-library-proof lib))
         (delta (library-diff value *proof-one*)))
    (proof-with-checked-results
     ((first (proof-proof-fact proof "integer-discrete"
                               (list (list *library-x* value))))
      (premise (product-arithmetic-conjoin lib (list integral positive-value)))
      (first (proof-proof-modus-ponens proof first premise))
      (delta-int (library-library-type-of lib delta (list integral)))
      (axiom (library-library-axiom lib "<-ON-OTHERS" (list value *proof-one*)))
      (lower (proof-proof-rewrite proof first axiom '(1 1)))
      (lower (proof-proof-tidy proof lower))
      (identity (library-library-linear-equal lib value (library-plus delta *proof-one*)
                                              (list integral)))
      (same (proof-proof-assume proof (proof-eq delta *proof-zero*) t))
      (equals-one (proof-proof-rewrite proof identity same '(1 2 1)))
      (constant (proof-proof-compute proof (library-plus *proof-zero* *proof-one*) 1))
      (equals-one (proof-proof-chain proof equals-one (list constant)))
      (cut (proof-proof-cut proof equals-one nonunit))
      (same-first (proof-step-first same))
      (nonzero (proof-proof-front proof cut (proof-neg same-first)))
      (positive-result (lemmas-positive-nonzero-integer lib delta delta-int nonzero lower))
      (lib (cdr positive-result))
      (proof (library-library-proof lib))
      (discrete (proof-proof-fact proof "integer-discrete" (list (list *library-x* delta))))
      (premise (product-arithmetic-conjoin lib (list delta-int (car positive-result))))
      (bound (proof-proof-modus-ponens proof discrete premise))
      (axiom (library-library-axiom lib "<-ON-OTHERS" (list delta *proof-one*)))
      (bound (proof-proof-rewrite proof bound axiom '(1 1)))
      (bound (proof-proof-tidy proof bound))
      (weak (library-library-weak-from-difference lib *shift-arithmetic-two* value bound
                                                  (list integral))))
     (cons weak lib))))

(defun halved-counters-natural-clip (lib value natural)
  (proof-with-checked-results
   ((helper (proof-proof-simplify (library-library-proof lib)
                                 (list *library-nfix* value)
                                 (list natural) (list *library-nfix*)))
    (equation (lemmas-nfix-equation lib value))
    (lib (cdr equation))
    (step (proof-proof-chain (library-library-proof lib) (car equation) (list helper))))
   (cons step lib)))

(defun halved-counters-half-positive (lib q natural-q as-integer upper at-least-two)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
     ((zero (proof-proof-assume proof (proof-eq q *proof-zero*) t))
      (contradiction (proof-proof-rewrite proof upper zero '(1 2 2 2)))
      (constant (proof-proof-compute proof (library-plus *proof-one* *proof-zero*) 1))
      (contradiction (proof-proof-rewrite proof contradiction constant '(1 2 2)))
      (twice-one (proof-proof-compute proof
                                      (product-arithmetic-product *shift-arithmetic-two* *proof-one*)
                                      2))
      (contradiction (proof-proof-rewrite proof contradiction twice-one '(1 2)))
      (contradiction (proof-proof-tidy proof contradiction))
      (cut (proof-proof-cut proof contradiction at-least-two))
      (zero-first (proof-step-first zero))
      (nonzero (proof-proof-front proof cut (proof-neg zero-first)))
      (lower (library-library-cite lib "NATURAL-NONNEGATIVE" (list q) (list natural-q))))
     (lemmas-positive-nonzero-integer lib q as-integer nonzero lower))))

(defun halved-counters-half-measure-remainder (lib q natural-q int-q upper short
                                                   integral pos converted identity)
  (let ((value *library-x*)
        (proof (library-library-proof lib))
        (types (list int-q integral)))
    (proof-with-checked-results
     ((nonunit (proof-proof-assume proof (proof-eq value *proof-one*) nil))
      (two-bound (halved-counters-shifted-base lib value integral pos nonunit))
      (lib (cdr two-bound))
      (after (library-diff value q))
      (pq (halved-counters-half-positive lib q natural-q int-q upper (car two-bound)))
      (lib (cdr pq))
      (proof (library-library-proof lib))
      (comparison (library-library-comparison lib q value types))
      (ps (proof-proof-rewrite proof short comparison '(1)))
      (ps (proof-proof-tidy proof ps))
      (type-after (library-library-type-of lib after types))
      (nonnegative (library-library-cite lib "POSITIVE-NONNEGATIVE" (list after)
                                         (list type-after ps)))
      (type-after (library-library-type-of lib after types))
      (natural (library-library-cite lib "NATURAL-FROM-BOUNDS" (list after)
                                     (list type-after nonnegative)))
      (less (library-library-less-from-difference lib after value (car pq) types))
      (identity (proof-proof-rewrite proof identity converted '(1 2 1 2 1))))
     (cons (list after less natural identity) lib))))

(defun halved-counters-half-measure-lemma (lib remainder)
  (let* ((label (if remainder "HALF-COUNTER-REMAINDER" "HALF-COUNTER-FIRST"))
         (proof (library-library-proof lib))
         (value *library-x*)
         (two *shift-arithmetic-two*))
    (if (assoc-equal (proof-sym (string-append "SELF-" label) "ACL2")
                     (proof-proof-facts proof))
        (cons label lib)
      (proof-with-checked-results
       ((half (list *shift-arithmetic-ash* value *proof-neg-one*))
        (actual (if remainder (library-diff value half) half))
        (child (list *lemmas-nfix* actual))
        (integral (proof-proof-assume proof (library-integer value) t))
        (pos (proof-proof-assume proof (library-positive value) t))
        (int-two (library-library-type-of lib two nil))
        (one-less (proof-proof-prove proof (library-lt *proof-one* two) nil nil))
        (assumptions (list integral int-two pos one-less))
        (integral-first (proof-step-first integral))
        (pos-first (proof-step-first pos))
        (conditions (list (proof-neg integral-first) (proof-neg pos-first)))
        (product-lemma (quotient-proofs-radix-product-lemma lib *quotient-proofs-floor*))
        (lib (cdr product-lemma))
        (bounds (library-library-cite lib (car product-lemma) (list value two) assumptions))
        (parts (quotient-proofs-bound-parts lib bounds))
        (natural-q (car parts))
        (upper (caddr parts))
        (q (list *quotient-proofs-floor* value two))
        (int-q (library-library-cite lib "NATURAL-INTEGER" (list q) (list natural-q)))
        (less-lemma (quotient-proofs-radix-less-lemma lib *quotient-proofs-floor*))
        (lib (cdr less-lemma))
        (short (library-library-cite lib (car less-lemma) (list value two) assumptions))
        (converted (shift-arithmetic-unscaled-floor lib half integral 1 two))
        (identity (proof-proof-reflexive (library-library-proof lib) child))
        (types (list int-q integral))
        (conditions (if remainder
                        (append conditions (list (proof-eq value *proof-one*)))
                      conditions))
        (branch (if remainder
                    (halved-counters-half-measure-remainder
                     lib q natural-q int-q upper short integral pos converted identity)
                  (proof-with-checked-results
                   ((identity (proof-proof-rewrite (library-library-proof lib)
                                                   identity converted '(1 2 1))))
                   (cons (list q short natural-q identity) lib))))
        (lib (cdr branch))
        (after (caar branch))
        (less (cadar branch))
        (natural (caddar branch))
        (identity (cadddr (car branch)))
        (left (halved-counters-natural-clip lib after natural))
        (lib (cdr left))
        (proof (library-library-proof lib))
        (left (proof-proof-chain proof identity (list (car left))))
        (nonnegative (library-library-cite lib "POSITIVE-NONNEGATIVE" (list value)
                                           (list integral pos)))
        (natural-value (library-library-cite lib "NATURAL-FROM-BOUNDS" (list value)
                                             (list integral nonnegative)))
        (right (halved-counters-natural-clip lib value natural-value))
        (lib (cdr right))
        (proof (library-library-proof lib))
        (type-after (library-library-type-of lib after types))
        (finite (library-library-cite lib "FINITE-ORDER" (list after value)
                                      (list type-after integral)))
        (ordinal (proof-proof-transport proof less finite))
        (ordinal (library-library-transport-argument lib ordinal left 1))
        (ordinal (library-library-transport-argument lib ordinal (car right) 2))
        (claim (proof-step-first ordinal))
        (lib (library-library-lemma lib label claim ordinal conditions)))
       (cons label lib)))))

(defun halved-counters-reduced-nonunit (proof steps definitions value)
  (if (endp steps)
      nil
    (proof-with-checked-results
     ((step (cdar steps))
      (formula (proof-step-first step))
      (test (and (proof-is-call formula *proof-not*) (proof-term-at formula 1))))
     (if (proof-is-call test *proof-equal*)
         (proof-with-checked-results
          ((reduced (proof-proof-simplify-first proof step nil definitions))
           (literal (proof-step-first reduced)))
          (if (equal literal (proof-neg (proof-eq value *proof-one*)))
              reduced
            (halved-counters-reduced-nonunit proof (cdr steps) definitions value)))
       (halved-counters-reduced-nonunit proof (cdr steps) definitions value)))))

(defun halved-counters-descent-evidence (proof rulers definitions value integral pos remainder)
  (if (not remainder)
      (cons (list integral pos) rulers)
    (proof-with-checked-results
     ((found (rulers-rulers-find rulers (proof-neg (proof-eq value *proof-one*))))
      (nonunit (if (car found)
                   (car found)
                 (proof-with-checked-results
                  ((derived (rulers-rulers-derived (cdr found))))
                  (halved-counters-reduced-nonunit proof derived definitions value)))))
     (cons (and nonunit (list integral pos nonunit)) (cdr found)))))

(defun halved-counters-halved-counter-descent-with-rulers (lib goal rulers)
  (proof-with-checked-results
   ((goal (proof-list-of-length goal 3)))
   (let ((child (cadr goal))
         (parent (caddr goal))
         (proof (library-library-proof lib)))
     (if (not (and (proof-is-call child *lemmas-nfix*)
                   (proof-is-call parent *lemmas-nfix*)))
         (cons (list nil rulers) lib)
       (proof-with-checked-results
        ((value (proof-term-at parent 1))
         (definitions (halved-counters-counter-definitions
                       *countdowns-counter-wrappers* (proof-proof-definitions proof)))
         (unclipped (proof-term-at child 1))
         (opened (proof-proof-simplify proof unclipped nil definitions))
         (opening (and opened (proof-step-first opened)))
         (actual (if opened (proof-term-at opening 2) unclipped))
         (half (list *shift-arithmetic-ash* value *proof-neg-one*)))
        (if (not (or (equal actual half) (equal actual (library-diff value half))))
            (cons (list nil rulers) lib)
          (proof-with-checked-results
           ((found (rulers-rulers-find rulers (library-integer value)))
            (integral (car found))
            (found (rulers-rulers-find (cdr found) (library-positive value)))
            (pos (car found))
            (rulers (cdr found)))
           (if (not (and integral pos))
               (cons (list nil rulers) lib)
             (proof-with-checked-results
              ((remainder (not (equal actual half)))
               (evidence (halved-counters-descent-evidence proof rulers definitions value integral pos
                                                          remainder))
               (rulers (cdr evidence)))
              (if (not (car evidence))
                  (cons (list nil rulers) lib)
                (proof-with-checked-results
                 ((lemma (halved-counters-half-measure-lemma lib remainder))
                  (rulers (halved-counters-rulers-for-library rulers lib (cdr lemma)))
                  (lib (cdr lemma))
                  (proof (library-library-proof lib))
                  (ordinal (library-library-cite lib (car lemma) (list value) (car evidence)))
                  (ordinal (if opened
                               (proof-with-checked-results
                                ((reverse-opening (proof-proof-symmetric proof opened))
                                 (rewritten (proof-proof-rewrite proof ordinal reverse-opening '(1 1 1))))
                                (proof-proof-tidy proof rewritten))
                             ordinal)))
                 (cons (list ordinal rulers) lib))))))))))))

(defun halved-counters-halved-counter-descent (lib goal rulers)
  (proof-with-checked-results
   ((result (halved-counters-halved-counter-descent-with-rulers lib goal rulers)))
   (cons (caar result) (cdr result))))

(defun halved-counters-compare-implication (lib formula condition child parent)
  (if (not (and (proof-is-call child *lemmas-nfix*)
                (proof-is-call parent *lemmas-nfix*)))
      (cons nil lib)
    (proof-with-checked-results
     ((premise (proof-proof-assume (library-library-proof lib) condition t))
      (rulers (rulers-rulers-init lib (list (list condition t)) nil))
      (descent (halved-counters-halved-counter-descent
                lib (list *proof-ordinal-less* child parent) rulers))
      (lib (cdr descent)))
     (if (not (car descent))
         (cons nil lib)
       (proof-with-checked-results
        ((comparison (halved-counters-library-ordinal-comparison lib child parent))
         (lib (cdr comparison))
         (proof (library-library-proof lib))
         (less (proof-proof-rewrite proof (car descent) (car comparison) '(1)))
         (less (proof-proof-tidy proof less))
         (step (witnesses-prove-implication lib formula premise less)))
        (cons step lib))))))

(defun halved-counters-halved-counter-comparison (lib formula)
  (if (not (proof-is-call formula *library-implies*))
      (cons nil lib)
    (proof-with-checked-results
     ((conclusion (proof-term-at formula 2)))
     (if (not (proof-is-call conclusion *proof-less*))
          (cons nil lib)
        (proof-with-checked-results
         ((arguments (proof-list-of-length (cdr formula) 2))
          (order (proof-list-of-length (cdr conclusion) 2)))
         (halved-counters-compare-implication lib formula (car arguments)
                                             (car order) (cadr order)))))))
