(in-package "BOYMOO-PROVER")
(set-verify-guards-eagerness 0)

(defconst *l1-lexicographic-numeric-equal* (proof-cl "="))
(defconst *l1-lexicographic-fix* (proof-sym "FIX" "ACL2"))
(defconst *l1-lexicographic-control* (list (proof-cl "ATOM") *proof-not*))

(defun l1-lexicographic-number-length (proof argument)
  (proof-with-checked-results
      ((length-term (list *library-len* argument))
       (opened (proof-proof-unfold proof length-term))
       (value (proof-rewritten-term opened))
       (true-branch (proof-proof-if-true proof value))
       (yes (proof-proof-chain proof opened (list true-branch)))
       (false-branch (proof-proof-if-false proof value))
       (no (proof-proof-chain proof opened (list false-branch)))
       (sum (proof-rewritten-term yes))
       (closure (proof-proof-fact proof (proof-sym "CLOSURE" "ACL2")
                                  (seq-zip (list *library-x* *library-y*) (cdr sum))))
       (numbers (proof-proof-conjunct proof closure))
       (computed (proof-proof-compute proof (list *library-numberp* *proof-zero*) *proof-t*))
       (zero (proof-proof-true-from-eq proof computed))
       (yes (proof-proof-symmetric proof yes))
       (yes (proof-proof-rewrite proof (car numbers) yes '(1 1)))
       (no (proof-proof-symmetric proof no))
       (no (proof-proof-rewrite proof zero no '(1 1))))
    (proof-proof-cases proof (list *proof-consp* argument) yes no)))

(defun l1-lexicographic-cancel-successor (proof argument)
  (let ((length-term (list *library-len* argument)))
    (proof-with-checked-results
        ((associativity (proof-proof-fact
                         proof (proof-sym "ASSOCIATIVITY-OF-+" "ACL2")
                         (list (list *library-x* *proof-neg-one*)
                               (list *library-y* *proof-one*)
                               (list *library-z* length-term))))
         (reversed (proof-proof-symmetric proof associativity))
         (zero (proof-proof-compute proof (library-plus *proof-neg-one* *proof-one*) 0))
         (result (proof-proof-rewrite proof reversed zero '(1 2 1)))
         (neutral (proof-proof-fact proof (proof-sym "UNICITY-OF-0" "ACL2")
                                    (list (list *library-x* length-term))))
         (number (l1-lexicographic-number-length proof argument))
         (fixed (l1-application-proof-simplify proof (list *l1-lexicographic-fix* length-term)
                                              (list number) (list *l1-lexicographic-fix*))))
      (proof-proof-chain proof result (list neutral fixed)))))

(defun l1-lexicographic-open-length (proof step argument index)
  (proof-with-checked-results
      ((opened (proof-proof-unfold proof (list *library-len* argument)))
       (body (proof-rewritten-term opened))
       (true-branch (proof-proof-if-true proof body))
       (cons-step (proof-proof-chain proof opened (list true-branch))))
    (proof-proof-rewrite proof step cons-step (list 1 index))))

(defun l1-lexicographic-cancel-length (proof step argument index)
  (proof-with-checked-results
      ((cancelled (l1-lexicographic-cancel-successor proof (list *library-cdr* argument))))
    (proof-proof-rewrite proof step cancelled (list 1 index))))

(defun l1-lexicographic-equal-tail-lengths (proof x y same-length)
  (proof-with-checked-results
      ((assumed (proof-proof-assume proof same-length t))
       (unfolded (proof-proof-unfold proof same-length))
       (length-step (proof-proof-rewrite proof assumed unfolded '(1)))
       (length-step (l1-lexicographic-open-length proof length-step x 1))
       (length-step (l1-lexicographic-open-length proof length-step y 2))
       (literal (proof-step-first length-step))
       (left (proof-term-at literal 1))
       (reflexive (proof-proof-reflexive proof (library-plus *proof-neg-one* left)))
       (cancelled (proof-proof-rewrite proof reflexive length-step '(1 2 2)))
       (cancelled (l1-lexicographic-cancel-length proof cancelled x 1))
       (cancelled (l1-lexicographic-cancel-length proof cancelled y 2)))
    (proof-proof-tidy proof cancelled)))

(defun l1-lexicographic-not-less-when-equal (proof equality)
  (proof-with-checked-results
      ((literal (proof-step-first equality))
       (parts (proof-list-of-length literal 3))
       (x (cadr parts))
       (y (caddr parts))
       (reflexive (proof-proof-reflexive proof (library-lt x y)))
       (reversed (proof-proof-symmetric proof equality))
       (same (proof-proof-rewrite proof reflexive reversed '(1 2 2)))
       (reflexive (proof-proof-fact proof (proof-sym "<-ON-OTHERS" "ACL2")
                                    (list (list *library-x* x) (list *library-y* x))))
       (inverse (proof-proof-fact proof (proof-sym "INVERSE-OF-+" "ACL2")
                                  (list (list *library-x* x))))
       (reflexive (proof-proof-rewrite proof reflexive inverse '(1 2 1)))
       (zero (proof-proof-compute proof (library-lt *proof-zero* *proof-zero*) *proof-nil*))
       (false (proof-proof-chain proof same (list reflexive zero)))
       (not-nil (proof-proof-not-nil proof))
       (reversed (proof-proof-symmetric proof false))
       (result (proof-proof-rewrite proof not-nil reversed '(1 1))))
    (proof-proof-tidy proof result)))

(mutual-recursion
 (defun l1-lexicographic-replace-value (term original replacement)
   (declare (xargs :measure (acl2-count term)))
   (cond ((equal term original) replacement)
         ((or (not (proof-compound term)) (proof-is-call term *proof-quote*)) term)
         ((endp term) '(:failure "failure" ""))
         (t (proof-with-checked-results
                ((args (l1-lexicographic-replace-arguments (cdr term) original replacement)))
              (cons (car term) args)))))
 (defun l1-lexicographic-replace-arguments (args original replacement)
   (declare (xargs :measure (acl2-count args)))
   (if (endp args)
       nil
     (proof-with-checked-results
         ((first (l1-lexicographic-replace-value (car args) original replacement))
          (rest (l1-lexicographic-replace-arguments (cdr args) original replacement)))
       (cons first rest)))))

(defund l1-lexicographic-compared-test (left right changed)
  (proof-with-checked-results
      ((literal (if changed (proof-step-first changed)
                  '(:failure "failure" "")))
       (changed-left (proof-term-at literal 1))
       (matches (and (equal left changed-left)
                     (proof-with-checked-results ((changed-right (proof-term-at literal 2)))
                       (equal right changed-right)))))
    (if matches
        :changed
      (proof-with-checked-results
          ((left-head (proof-term-at left 0))
           (right-head (proof-term-at right 0)))
        (if (not (and (equal left-head right-head) (equal right-head *proof-if*)))
            '(:failure "failure" "")
          (proof-with-checked-results
              ((left-test (proof-term-at left 1))
               (right-test (proof-term-at right 1)))
            (if (equal left-test right-test)
                (list left-test)
              '(:failure "failure" ""))))))))

(defun l1-lexicographic-branch-equality (proof left right test yes no)
  (proof-with-checked-results
      ((top-left (proof-proof-if-true proof left))
       (top-right (proof-proof-if-true proof right))
       (top-right (proof-proof-symmetric proof top-right))
       (top (proof-proof-chain proof top-left (list yes top-right)))
       (bottom-left (proof-proof-if-false proof left))
       (bottom-right (proof-proof-if-false proof right))
       (bottom-right (proof-proof-symmetric proof bottom-right))
       (bottom (proof-proof-chain proof bottom-left (list no bottom-right))))
    (proof-proof-cases proof test top bottom)))

(defund l1-lexicographic-branch-at (term position)
  (proof-term-at term position))

(defun l1-lexicographic-compare-branches (proof left right changed)
  (declare (xargs :measure (acl2-count left)))
  (if (equal left right)
      (proof-proof-reflexive proof left)
    (proof-with-checked-results
        ((test (l1-lexicographic-compared-test left right changed)))
      (cond ((eq test :changed) changed)
            ((not (consp (cddr left))) '(:failure "failure" ""))
            (t (proof-with-checked-results
                   ((right-yes (l1-lexicographic-branch-at right 2))
                    (yes (l1-lexicographic-compare-branches proof (caddr left) right-yes changed)))
                 (if (not (consp (cdddr left)))
                     '(:failure "failure" "")
                   (proof-with-checked-results
                       ((right-no (l1-lexicographic-branch-at right 3))
                        (no (l1-lexicographic-compare-branches proof (cadddr left) right-no changed)))
                     (l1-lexicographic-branch-equality proof left right (car test) yes no)))))))))

(defun l1-lexicographic-length-wrapper-tail (proof function digits x y same-length)
  (let ((child-x (list *library-cdr* x))
        (child-y (list *library-cdr* y)))
    (proof-with-checked-results
        ((digit-function (proof-term-at digits 0))
         (child-digits (list digit-function child-x child-y))
         (child-wrapper (list function child-x child-y))
         (cons-x (list *proof-consp* child-x))
         (cons-y (list *proof-consp* child-y))
         (yes-x (proof-ite cons-y child-wrapper *proof-false*))
         (wrapped (proof-ite cons-x yes-x *proof-false*))
         (equal-lengths (l1-lexicographic-equal-tail-lengths proof x y same-length))
         (literal (proof-step-first equal-lengths))
         (equal-test (cons *l1-lexicographic-numeric-equal* (cdr literal)))
         (equal-unfolded (proof-proof-unfold proof equal-test))
         (equal-step (proof-proof-transport proof equal-lengths equal-unfolded))
         (no-less (l1-lexicographic-not-less-when-equal proof equal-lengths))
         (opened (proof-proof-unfold proof child-wrapper))
         (body (proof-rewritten-term opened))
         (assume-x (proof-proof-assume proof cons-x t))
         (remains (l1-application-proof-simplify proof body (list equal-step no-less assume-x)
                                                *l1-lexicographic-control*))
         (agreement (proof-proof-chain proof opened (list remains)))
         (agree-value (proof-rewritten-term agreement)))
      (if (not (equal agree-value child-digits))
          '(:failure "failure" "")
        (proof-with-checked-results
            ((opened-digits (proof-proof-unfold proof child-digits))
             (digit-body (proof-rewritten-term opened-digits))
             (assume-x (proof-proof-assume proof cons-x t))
             (assume-not-y (proof-proof-assume proof cons-y nil))
             (none-y (l1-application-proof-simplify proof digit-body
                                                    (list assume-x assume-not-y) nil))
             (none-x (proof-proof-if-false proof digit-body))
             (agreement (proof-proof-symmetric proof agreement))
             (yes-branch (proof-proof-if-true proof yes-x))
             (yes-branch (proof-proof-symmetric proof yes-branch))
             (both (proof-proof-chain proof agreement (list yes-branch)))
             (no-branch (proof-proof-if-false proof yes-x))
             (no-branch (proof-proof-symmetric proof no-branch))
             (only-x (proof-proof-chain proof opened-digits (list none-y no-branch)))
             (right (proof-proof-cases proof cons-y both only-x))
             (wrapped-yes (proof-proof-if-true proof wrapped))
             (wrapped-yes (proof-proof-symmetric proof wrapped-yes))
             (yes-tail (proof-proof-chain proof right (list wrapped-yes)))
             (wrapped-no (proof-proof-if-false proof wrapped))
             (wrapped-no (proof-proof-symmetric proof wrapped-no))
             (no-tail (proof-proof-chain proof opened-digits (list none-x wrapped-no)))
             (tail (proof-proof-cases proof cons-x yes-tail no-tail)))
          (list tail wrapped child-digits))))))

(defun l1-lexicographic-length-wrapper-finish (proof function x y body digits same-length)
  (proof-with-checked-results
      ((branches (l1-lexicographic-length-wrapper-tail proof function digits x y same-length))
       (expanded (proof-proof-unfold proof digits))
       (value (proof-rewritten-term expanded))
       (converted (l1-lexicographic-replace-value value (caddr branches) (cadr branches)))
       (comparison (l1-lexicographic-compare-branches proof value converted (car branches)))
       (step (proof-proof-chain proof expanded (list comparison)))
       (amended (l1-lexicographic-replace-value body digits converted))
       (opened (proof-proof-unfold proof (list function x y)))
       (comparison (l1-lexicographic-compare-branches proof body amended step)))
    (proof-proof-chain proof opened (list comparison))))

(defun l1-lexicographic-length-wrapper (proof function formals body)
  (if (not (and (equal (len formals) 2) (proof-is-call body *proof-if*)))
      '(:failure "UnsupportedApplication" "")
    (let* ((x (car formals))
           (y (cadr formals))
           (x-length (list *library-len* x))
           (y-length (list *library-len* y))
           (same-length (list *l1-lexicographic-numeric-equal* x-length y-length)))
      (proof-with-checked-results
          ((test (proof-term-at body 1))
           (digit-case (and (equal test (library-lt x-length y-length))
                            (proof-term-at body 3)))
           (same-test (and (proof-is-call digit-case *proof-if*) (proof-term-at digit-case 1))))
        (if (not (equal same-test same-length))
            '(:failure "UnsupportedApplication" "")
          (proof-with-checked-results
              ((equal-branch (proof-term-at digit-case 2))
               (digits (proof-term-at equal-branch 3)))
            (l1-lexicographic-length-wrapper-finish proof function x y body digits same-length)))))))
