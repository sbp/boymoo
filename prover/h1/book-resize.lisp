(in-package "BOYMOO-PROVER")
(set-verify-guards-eagerness 0)

(defconst *h1-book-resize-nth* (proof-cl "NTH"))
(defconst *h1-book-resize-length-limit* (proof-sym "LIMIT" "ACL2"))
(defconst *h1-book-resize-resize* (proof-sym "RESIZE-LIST" "ACL2"))
(defconst *h1-book-resize-make-list* (proof-sym "MAKE-LIST-AC" "ACL2"))
(defconst *h1-book-resize-tail* (proof-sym "TAIL" "ACL2"))

(defun h1-book-resize-step-at (step place)
  (if (not step)
      '(:failure "failure" "")
    (proof-with-checked-results ((literal (proof-step-first step)))
      (h1-book-arithmetic-at literal place))))

(defun h1-book-resize-show-spine (proof test cons-step)
  (let ((core (h1-tactics-prover-proof proof)))
    (proof-with-checked-results
        ((definition (proof-proof-unfold core test))
         (definition
          (if (proof-is-call test (proof-cl "ENDP"))
              (proof-with-checked-results
                  ((value (h1-book-resize-step-at definition '(2)))
                   (opened (proof-proof-unfold core value)))
                (proof-proof-chain core definition (list opened)))
            definition))
         (literal (h1-book-resize-step-at cons-step nil))
         (value (h1-book-resize-step-at definition '(2))))
      (if (equal literal value)
          (h1-propositions-proof-transport core cons-step definition)
        (proof-with-checked-results
            ((assumed (h1-arithmetic-proof-assume core test t))
             (rewritten (proof-proof-rewrite core assumed definition '(1)))
             (contradiction (proof-proof-cut core cons-step rewritten)))
          (proof-proof-front core contradiction (proof-neg test)))))))

(defun h1-book-resize-nth-branch (proof index items cons-step zero-index)
  (let ((core (h1-tactics-prover-proof proof))
        (lib (h1-tactics-prover-library proof)))
    (proof-with-checked-results
        ((opened (proof-proof-unfold core (list *h1-book-resize-nth* index items)))
         (test (h1-book-resize-step-at opened '(2 1)))
         (endp-step (h1-book-resize-show-spine proof test cons-step))
         (selected (h1-propositions-select-value lib opened endp-step))
         (value (h1-book-resize-step-at selected '(2))))
      (if (equal value *proof-false*)
          selected
        (proof-with-checked-results ((selected (h1-propositions-select-value lib selected zero-index)))
          (if (proof-is-call items *proof-cons*)
              (proof-with-checked-results
                  ((head (library-library-axiom lib "CAR-CONS" (cdr items)))
                   (selected (h1-propositions-rewrite-value lib selected head))
                   (tail (library-library-axiom lib "CDR-CONS" (cdr items))))
                (h1-propositions-rewrite-value lib selected tail))
            selected))))))

(defun h1-book-resize-nth-on-cons (proof index value test earlier-equation)
  (let ((core (h1-tactics-prover-proof proof)))
    (proof-with-checked-results
        ((args (h1-arithmetic-term-tail value))
         (known-cons (proof-proof-fact core "consp-cons"
                                      (seq-zip (list *library-x* *library-y*) args)))
         (step (h1-book-resize-nth-branch proof index value known-cons test))
         (reversed (h1-propositions-proof-symmetric core earlier-equation)))
      (proof-proof-rewrite core step reversed '(1 1 2)))))

(defun h1-book-resize-nf-nonnegative (proof term)
  (let ((lib (h1-tactics-prover-library proof)))
    (proof-with-checked-results
        ((natural (library-library-cite lib "ACL2-NFIX-NATURAL" (list term) nil)))
      (library-library-cite lib "NATURAL-NONNEGATIVE"
                            (list (list *h1-book-modulo-fix* term)) (list natural)))))

(defun h1-book-resize-make-decrement (previous integral positive fixed previous-fixed)
  (list :h1-decrement previous integral positive fixed previous-fixed))

(defun h1-book-resize-decrement-previous (decrement)
  (nth 1 decrement))

(defun h1-book-resize-decrement-integral (decrement)
  (nth 2 decrement))

(defun h1-book-resize-decrement-positive (decrement)
  (nth 3 decrement))

(defun h1-book-resize-decrement-fixed (decrement)
  (nth 4 decrement))

(defun h1-book-resize-decrement-previous-fixed (decrement)
  (nth 5 decrement))

(defun h1-book-resize-zero-is-inside (proof index stop limit)
  (let ((core (h1-tactics-prover-proof proof))
        (lib (h1-tactics-prover-library proof)))
    (proof-with-checked-results
        ((zero (library-library-cite lib "ACL2-NFIX-WHEN-ZP" (list index) (list stop)))
         (reversed (h1-propositions-proof-symmetric core zero))
         (inside (proof-proof-rewrite core (h1-book-resize-decrement-positive limit)
                                      reversed '(1 1)))
         (fixed (h1-propositions-proof-symmetric core (h1-book-resize-decrement-fixed limit))))
      (proof-proof-rewrite core inside fixed '(1 2)))))

(defun h1-book-resize-decrement (proof term active)
  (proof-with-checked-results
      ((divisor (h1-book-modulo-positive-divisor proof term active))
       (parts (h1-book-cofactors-positive-parts proof divisor))
       (integral (car parts))
       (positive (cadr parts))
       (previous (library-plus *proof-neg-one* term))
       (smaller (h1-book-scan-previous-natural proof term previous integral positive))
       (natural (h1-book-modulo-natural-from-positive proof integral positive))
       (fixed (h1-book-modulo-fix-value proof term natural))
       (previous-fixed (h1-book-modulo-fix-value proof previous smaller)))
    (h1-book-resize-make-decrement previous integral positive fixed previous-fixed)))

(defun h1-book-resize-rewrite-bound-pair (lib sides equality)
  (proof-with-checked-results
      ((before (h1-propositions-rewrite-value lib (car sides) equality))
       (after (h1-propositions-rewrite-value lib (cadr sides) equality)))
    (list before after)))

(defun h1-book-resize-align-index-bounds-rewrite (lib sides fixes)
  (declare (xargs :measure (len fixes)))
  (if (or (failure-p sides) (endp fixes))
      sides
    (h1-book-resize-align-index-bounds-rewrite
     lib (h1-book-resize-rewrite-bound-pair lib sides (car fixes)) (cdr fixes))))

(defun h1-book-resize-align-index-bounds (proof parent child numbers fixes)
  (let ((core (h1-tactics-prover-proof proof))
        (lib (h1-tactics-prover-library proof)))
    (proof-with-checked-results
        ((before (h1-propositions-propositional-proof-reflexive lib parent))
         (after (h1-propositions-propositional-proof-reflexive lib child))
         (sides (h1-book-resize-align-index-bounds-rewrite lib (list before after) fixes))
         (norm (h1-book-field-field-normalizer proof nil))
         (norm (h1-book-field-remember norm numbers))
         (left (h1-book-resize-step-at (car sides) '(2)))
         (right (h1-book-resize-step-at (cadr sides) '(2)))
         (shift (h1-book-order-by-difference proof left right norm))
         (shifted (car shift))
         (reversed (h1-propositions-proof-symmetric core (cadr sides))))
      (proof-proof-chain core (car sides) (list shifted reversed)))))

(defun h1-book-resize-out-of-range (proof)
  (let* ((core (h1-tactics-prover-proof proof))
         (lib (h1-tactics-prover-library proof))
         (nth-term (list *h1-book-resize-nth* *library-y* *library-x*))
         (inside (library-lt (list *h1-book-modulo-fix* *library-y*)
                             (h1-book-list-size-length *library-x*)))
         (required (proof-neg inside))
         (goal (proof-eq nth-term *proof-false*))
         (formula (list *library-implies* required goal)))
    (proof-with-checked-results
        ((expansion (proof-proof-unfold core nth-term))
         (endp-test (h1-book-resize-step-at expansion '(2 1)))
         (stop (h1-arithmetic-proof-assume core endp-test t))
         (empty-branch (h1-propositions-select-value lib expansion stop))
         (empty (h1-propositions-propositional-proof-implies-from lib formula empty-branch))
         (more (h1-arithmetic-proof-assume core endp-test nil))
         (cons-step (h1-book-termination-cons-from-nonatom proof more))
         (more (h1-arithmetic-proof-assume core endp-test nil))
         (body (h1-propositions-select-value lib expansion more))
         (zp-test (list *h1-arithmetic-zp* *library-y*))
         (stop-index (h1-arithmetic-proof-assume core zp-test t))
         (fixed-zero (library-library-cite lib "ACL2-NFIX-WHEN-ZP"
                                           (list *library-y*) (list stop-index)))
         (assumed (h1-arithmetic-proof-assume core required t))
         (zero-bound (proof-proof-rewrite core assumed fixed-zero '(1 1 1)))
         (positive-length (h1-book-list-size-length-positive proof cons-step))
         (impossible (proof-proof-cut core positive-length zero-bound))
         (head-case (proof-proof-subsume core impossible
                                         (cons goal (proof-step-clause impossible))))
         (no-head (h1-propositions-propositional-proof-implies-from lib formula head-case))
         (active (h1-arithmetic-proof-assume core zp-test nil))
         (smaller (h1-book-resize-decrement proof *library-y* active))
         (nth-next (h1-propositions-select-value lib body active))
         (call (h1-book-resize-step-at nth-next '(2)))
         (parts (proof-list-of-length call 3))
         (index (cadr parts))
         (tail (caddr parts))
         (changes (list (list *library-x* tail) (list *library-y* index)))
         (child (proof-subst formula (list (cons *library-x* tail) (cons *library-y* index))))
         (length-open (proof-proof-unfold core (h1-book-list-size-length *library-x*)))
         (length-step (h1-propositions-select-value lib length-open cons-step))
         (child-bound (h1-book-arithmetic-at child '(1 1)))
         (tail-integer (library-library-type-of lib (h1-book-list-size-length tail) nil))
         (alignment
          (h1-book-resize-align-index-bounds
           proof inside child-bound
           (list (h1-book-resize-decrement-integral smaller) tail-integer)
           (list (h1-book-resize-decrement-fixed smaller)
                 (h1-book-resize-decrement-previous-fixed smaller) length-step)))
         (assumed (h1-arithmetic-proof-assume core required t))
         (right (proof-proof-rewrite core assumed alignment '(1 1)))
         (builtin (library-library-builtin lib 3 *library-x*))
         (decrease (proof-proof-discharge core builtin cons-step))
         (decrease-claim (proof-step-first decrease))
         (assumed (h1-arithmetic-proof-assume core (proof-ite decrease-claim child *proof-true*) t))
         (induction (h1-propositions-proof-prove-if core assumed decrease))
         (result (h1-propositions-propositional-proof-modus-ponens lib induction right))
         (next (proof-proof-chain core nth-next (list result)))
         (recursive (h1-propositions-propositional-proof-implies-from lib formula next))
         (nonempty (proof-proof-cases core zp-test no-head recursive))
         (step (proof-proof-cases core endp-test empty nonempty))
         (measure (list *library-count* *library-x*))
         (ordinal (descent-measure-ordinal lib measure)))
      (proof-proof-induct core ordinal step formula measure (list changes)))))

(defun h1-book-resize-resize-branch (proof equation evidence)
  (let ((core (h1-tactics-prover-proof proof))
        (lib (h1-tactics-prover-library proof)))
    (proof-with-checked-results
        ((term (h1-book-resize-step-at equation '(1 2)))
         (posp-term (list *h1-book-cofactors-posp* term))
         (literal (h1-book-resize-step-at evidence nil))
         (guard
          (if (equal literal (list *h1-arithmetic-zp* term))
              (proof-with-checked-results
                  ((relation (library-library-cite lib "ZP-IS-NOT-POSP" (list term) nil))
                   (sign (proof-proof-rewrite core evidence relation '(1)))
                   (opened (proof-proof-unfold core posp-term)))
                (proof-proof-rewrite core sign opened '(1 1)))
            (proof-with-checked-results
                ((divisor (h1-book-modulo-positive-divisor proof term evidence))
                 (opened (proof-proof-unfold core posp-term)))
              (proof-proof-rewrite core divisor opened '(1))))))
      (h1-propositions-select-value lib equation guard))))

(defun h1-book-resize-resize-equation (proof term)
  (let ((core (h1-tactics-prover-proof proof)))
    (proof-with-checked-results
        ((equation (proof-proof-unfold core term))
         (value (h1-book-resize-step-at equation '(2)))
         (opened (proof-proof-unfold core value)))
      (proof-proof-chain core equation (list opened)))))

(defun h1-book-resize-resize-length (proof)
  (let* ((core (h1-tactics-prover-proof proof))
         (lib (h1-tactics-prover-library proof))
         (resize (list *h1-book-resize-resize* *library-x* *library-y* *library-z*))
         (length-term (h1-book-list-size-length resize))
         (fixed (list *h1-book-modulo-fix* *library-y*))
         (goal (proof-eq length-term fixed))
         (stop (list *h1-arithmetic-zp* *library-y*)))
    (proof-with-checked-results
        ((equation (h1-book-resize-resize-equation proof resize))
         (assumed (h1-arithmetic-proof-assume core stop t))
         (at-stop (h1-book-resize-resize-branch proof equation assumed))
         (identity (h1-propositions-propositional-proof-reflexive lib length-term))
         (left (h1-propositions-rewrite-value lib identity at-stop))
         (length-false (h1-book-list-size-length *proof-false*))
         (empty (h1-tactics-prover-solve proof (proof-eq length-false *proof-zero*)
                                        (list (car length-false)) 160))
         (assumed (h1-arithmetic-proof-assume core stop t))
         (fixed-zero (library-library-cite lib "ACL2-NFIX-WHEN-ZP" (list *library-y*)
                                           (list assumed)))
         (reversed (h1-propositions-proof-symmetric core fixed-zero))
         (base (proof-proof-chain core left (list empty reversed)))
         (active (h1-arithmetic-proof-assume core stop nil))
         (advance (h1-book-resize-resize-branch proof equation active))
         (cons-term (h1-book-resize-step-at advance '(2)))
         (body (proof-proof-unfold core (h1-book-list-size-length cons-term)))
         (args (h1-arithmetic-term-tail cons-term))
         (is-cons (proof-proof-fact core "consp-cons"
                                    (seq-zip (list *library-x* *library-y*) args)))
         (body (h1-propositions-select-value lib body is-cons))
         (projection (library-library-axiom lib "CDR-CONS" args))
         (body (h1-propositions-rewrite-value lib body projection))
         (recursive (proof-term-at cons-term 2))
         (args (if (integerp recursive)
                   '(:failure "failure" "")
                 (seq-slice recursive 1 3)))
         (args (proof-list-of-length args 2))
         (next-list (car args))
         (next-length (cadr args))
         (bindings (list (list *library-x* next-list) (list *library-y* next-length)))
         (builtin (library-library-builtin lib 9 *library-y*))
         (smaller (proof-proof-discharge core builtin active))
         (child (proof-subst goal (list (cons *library-x* next-list)
                                       (cons *library-y* next-length))))
         (decrease (proof-step-first smaller))
         (assumed (h1-arithmetic-proof-assume core (proof-ite decrease child *proof-true*) t))
         (result (h1-propositions-proof-prove-if core assumed smaller))
         (current (h1-book-resize-decrement proof *library-y* active))
         (identity (h1-propositions-propositional-proof-reflexive lib length-term))
         (left (h1-propositions-rewrite-value lib identity advance))
         (left (proof-proof-chain core left (list body)))
         (left (h1-propositions-rewrite-value lib left result))
         (left (h1-propositions-rewrite-value lib left
                                             (h1-book-resize-decrement-previous-fixed current)))
         (norm (h1-book-field-field-normalizer proof nil))
         (norm (h1-book-field-remember norm (list (h1-book-resize-decrement-integral current))))
         (value (h1-book-resize-step-at left '(2)))
         (normalized (h1-book-arithmetic-algebra-equality norm value *library-y*))
         (equality (car normalized))
         (reversed (h1-propositions-proof-symmetric core (h1-book-resize-decrement-fixed current)))
         (recursive (proof-proof-chain core left (list equality reversed)))
         (measure (list *library-count* *library-y*))
         (ordinal (descent-measure-ordinal lib measure))
         (cases (proof-proof-cases core stop base recursive)))
      (proof-proof-induct core ordinal cases goal measure (list bindings)))))

(defun h1-book-resize-resize-nil (proof)
  (let* ((core (h1-tactics-prover-proof proof))
         (lib (h1-tactics-prover-library proof))
         (resized (list *h1-book-resize-resize* *library-x* *h1-book-resize-length-limit* *library-z*))
         (fixed (list *h1-book-modulo-fix* *h1-book-resize-length-limit*))
         (required (proof-neg (library-lt (list *h1-book-modulo-fix* *library-y*) fixed))))
    (proof-with-checked-results
        ((length-eq (library-library-cite lib "RESIZE-LENGTH"
                                          (list *library-x* *h1-book-resize-length-limit* *library-z*)
                                          nil))
         (assumed (h1-arithmetic-proof-assume core required t))
         (reversed (h1-propositions-proof-symmetric core length-eq))
         (before (proof-proof-rewrite core assumed reversed '(1 1 2)))
         (range-eq (library-library-cite lib "NTH-RANGE-EQUATION" (list resized *library-y*) nil))
         (result (h1-propositions-propositional-proof-modus-ponens lib range-eq before))
         (claim (proof-step-first result)))
      (h1-propositions-propositional-proof-implies-from
       lib (list *library-implies* required claim) result))))

(defun h1-book-resize-nth-resize-nonempty
    (holds proof cons-test before stop-index logical limit-bounds index-bounds
           limit active-index formula condition within-list successor-goals)
  (let ((core (h1-tactics-prover-proof proof))
        (lib (h1-tactics-prover-library proof)))
    (proof-with-checked-results
        ((cons-step (h1-arithmetic-proof-assume core cons-test holds))
         (shape (proof-proof-unfold core (h1-book-list-size-length *library-x*)))
         (size (h1-propositions-select-value lib shape cons-step))
         (body (h1-book-resize-step-at before '(2)))
         (test (h1-book-arithmetic-at body '(1 1)))
         (atom-step (h1-book-resize-show-spine proof test cons-step))
         (term (proof-term-at body 1))
         (selected (h1-propositions-propositional-proof-select lib term atom-step))
         (prepared (h1-propositions-rewrite-value lib before selected))
         (term (h1-book-arithmetic-at body '(2 1)))
         (selected (h1-propositions-propositional-proof-select lib term atom-step))
         (prepared (h1-propositions-rewrite-value lib prepared selected))
         (result (h1-book-resize-step-at prepared '(2)))
         (tail (h1-book-arithmetic-at result '(2 1)))
         (initial (h1-arithmetic-proof-assume core stop-index t))
         (left (h1-book-resize-nth-on-cons proof *library-y* result initial prepared))
         (inside (h1-book-resize-zero-is-inside proof *library-y* initial limit-bounds))
         (ready (h1-propositions-propositional-proof-select lib logical inside))
         (right
          (if holds
              (proof-with-checked-results
                  ((fixed-zero (library-library-cite lib "ACL2-NFIX-WHEN-ZP"
                                                     (list *library-y*) (list initial)))
                   (retained (h1-book-list-size-length-positive proof cons-step))
                   (reversed (h1-propositions-proof-symmetric core fixed-zero))
                   (retained (proof-proof-rewrite core retained reversed '(1 1)))
                   (selected (h1-propositions-select-value lib ready retained))
                   (branch (h1-book-resize-nth-branch proof *library-y* *library-x*
                                                       cons-step initial)))
                (proof-proof-chain core selected (list branch)))
            (proof-with-checked-results
                ((bound (h1-book-resize-nf-nonnegative proof *library-y*))
                 (reversed (h1-propositions-proof-symmetric core size))
                 (retained (proof-proof-rewrite core bound reversed '(1 1 2))))
              (h1-propositions-select-value lib ready retained))))
         (reversed (h1-propositions-proof-symmetric core right))
         (first (proof-proof-chain core left (list reversed)))
         (previous-index (h1-book-resize-decrement-previous index-bounds))
         (previous-limit (h1-book-resize-decrement-previous limit-bounds))
         (changes (list (list *library-y* previous-index) (list limit previous-limit)))
         (changes (if (equal tail *library-x*) changes
                    (append changes (list (list *library-x* tail)))))
         (successor-goals (append successor-goals (list changes)))
         (builtin (library-library-builtin lib 9 *library-y*))
         (decrease (proof-proof-discharge core builtin active-index))
         (child (proof-subst formula (proof-bindings-table changes nil)))
         (descent (proof-step-first decrease))
         (assumed (h1-arithmetic-proof-assume core (proof-ite descent child *proof-true*) t))
         (recursion (h1-propositions-proof-prove-if core assumed decrease))
         (left (h1-book-resize-nth-on-cons proof *library-y* result active-index prepared))
         (step (proof-proof-chain core left (list recursion)))
         (child-bound (h1-book-arithmetic-at child '(2 1)))
         (unchanged
          (h1-book-resize-align-index-bounds
           proof condition child-bound
           (list (h1-book-resize-decrement-integral index-bounds)
                 (h1-book-resize-decrement-integral limit-bounds))
           (list (h1-book-resize-decrement-fixed index-bounds)
                 (h1-book-resize-decrement-previous-fixed index-bounds)
                 (h1-book-resize-decrement-fixed limit-bounds)
                 (h1-book-resize-decrement-previous-fixed limit-bounds))))
         (reversed (h1-propositions-proof-symmetric core unchanged))
         (step (proof-proof-rewrite core step reversed '(1 2 1)))
         (equalities
          (if holds
              (proof-with-checked-results
                  ((child-bound (h1-book-arithmetic-at child '(2 2 1)))
                   (tail-integral (library-library-type-of lib (h1-book-list-size-length tail) nil))
                   (same-test
                    (h1-book-resize-align-index-bounds
                     proof within-list child-bound
                     (list (h1-book-resize-decrement-integral index-bounds) tail-integral)
                     (list (h1-book-resize-decrement-fixed index-bounds)
                           (h1-book-resize-decrement-previous-fixed index-bounds)
                           size)))
                   (aligned (h1-book-resize-nth-branch proof *library-y* *library-x*
                                                       cons-step active-index)))
                (list same-test aligned))
            (proof-with-checked-results
                ((bound (h1-book-resize-nf-nonnegative proof *library-y*))
                 (reversed (h1-propositions-proof-symmetric core size))
                 (parent-empty (proof-proof-rewrite core bound reversed '(1 1 2)))
                 (bound (h1-book-resize-nf-nonnegative proof previous-index))
                 (reversed (h1-propositions-proof-symmetric core size))
                 (child-empty (proof-proof-rewrite core bound reversed '(1 1 2)))
                 (parent-false (h1-tactics-prover-false-equation proof parent-empty))
                 (child-false (h1-tactics-prover-false-equation proof child-empty))
                 (reversed (h1-propositions-proof-symmetric core child-false))
                 (same-test (proof-proof-chain core parent-false (list reversed)))
                 (old (h1-book-resize-nth-branch proof *library-y* *library-x*
                                                 cons-step active-index))
                 (new (h1-book-resize-nth-branch proof previous-index *library-x*
                                                 cons-step active-index))
                 (reversed (h1-propositions-proof-symmetric core new))
                 (aligned (proof-proof-chain core old (list reversed))))
              (list same-test aligned))))
         (reversed (h1-propositions-proof-symmetric core (car equalities)))
         (step (proof-proof-rewrite core step reversed '(1 2 2 1)))
         (reversed (h1-propositions-proof-symmetric core (cadr equalities)))
         (step (proof-proof-rewrite core step reversed '(1 2 2 2)))
         (cases (proof-proof-cases core stop-index first step)))
      (cons cases successor-goals))))

(defun h1-book-resize-nth-resize (proof)
  (let* ((core (h1-tactics-prover-proof proof))
         (lib (h1-tactics-prover-library proof))
         (limit *h1-book-resize-length-limit*)
         (resized (list *h1-book-resize-resize* *library-x* limit *library-z*))
         (fixed-index (list *h1-book-modulo-fix* *library-y*))
         (condition (library-lt fixed-index (list *h1-book-modulo-fix* limit)))
