(in-package "BOYMOO-PROVER")
(set-verify-guards-eagerness 0)

(defun h1-book-expt-sum-power (base exponent)
  (list *h1-arithmetic-expt* base exponent))

(defun h1-book-expt-sum-number (term)
  (list *library-numberp* term))

(defun h1-book-expt-sum-fixed-zero (term)
  (proof-eq (list *h1-book-arithmetic-fix* term) *proof-zero*))

(defun h1-book-expt-sum-step-at (step indices)
  (proof-with-checked-results ((literal (proof-step-first step)))
    (h1-book-arithmetic-at literal indices)))

(defun h1-book-expt-sum-zip-lemma (proof name item result typed)
  (let ((lib (h1-tactics-prover-library proof))
        (premise (proof-ite typed item *proof-false*)))
    (proof-with-checked-results
        ((implication (h1-tactics-prover-solve
                       proof (list *library-implies* premise result) (list *h1-arithmetic-zip*) 160))
         (assumed (h1-tactics-prover-conjunction-assumption proof premise))
         (step (h1-propositions-propositional-proof-modus-ponens lib implication assumed))
         (lib (library-library-lemma lib name result step (list (proof-neg typed) (proof-neg item)))))
      (h1-tactics-prover-with-library proof lib))))

(defun h1-book-expt-sum-zip-when-integer (proof)
  (let ((term (list *h1-arithmetic-zip* *library-x*))
        (zero (proof-eq *library-x* *proof-zero*))
        (typed (library-integer *library-x*)))
    (proof-with-checked-results ((proof (h1-book-expt-sum-zip-lemma proof "ZERO-FROM-ZIP" term zero typed)))
      (h1-book-expt-sum-zip-lemma proof "NO-ZIP-FROM-NONZERO" (proof-neg zero) (proof-neg term) typed))))

(defun h1-book-expt-sum-power-at-zero (proof base equality)
  (let ((lib (h1-tactics-prover-library proof))
        (core (h1-tactics-prover-proof proof)))
    (proof-with-checked-results
        ((at-zero (library-library-axiom lib "H1-EXPT-AT-ZERO" (list base)))
         (reversed (h1-propositions-proof-symmetric core equality))
         (rewritten (proof-proof-rewrite core at-zero reversed '(1 1 2))))
      (proof-proof-tidy core rewritten))))

(defun h1-book-expt-sum-not-zip (proof exponent nonzero normalizer)
  (proof-with-checked-results
      ((typed (h1-book-expt-checked-pair (h1-book-field-require normalizer (library-integer exponent))))
       (step (library-library-cite (h1-tactics-prover-library proof)
                                   "NO-ZIP-FROM-NONZERO" (list exponent) (list (car typed) nonzero))))
    (cons step (cdr typed))))

(defun h1-book-expt-sum-power-shift (proof base earlier later up normalizer)
  (let ((label (if up "EXPT-SUCCESSOR" "EXPT-PREDECESSOR"))
        (lib (h1-tactics-prover-library proof))
        (core (h1-tactics-prover-proof proof)))
    (proof-with-checked-results
        ((numeric (h1-book-expt-checked-pair (h1-book-field-require normalizer (h1-book-expt-sum-number base))))
         (nonzero (h1-book-expt-checked-pair (h1-book-field-require (cdr numeric) (proof-neg (proof-eq base *proof-zero*)))))
         (integral (h1-book-expt-checked-pair (h1-book-field-require (cdr nonzero) (library-integer earlier))))
         (equation (library-library-cite lib label (list base earlier)
                                         (list (car numeric) (car nonzero) (car integral))))
         (exponent (h1-book-expt-sum-step-at equation '(1 2)))
         (normalizer (h1-book-arithmetic-algebra-with-work (cdr integral) 150))
         (aligned (h1-book-expt-checked-pair (h1-book-arithmetic-algebra-equality normalizer exponent later)))
         (rewritten (proof-proof-rewrite core equation (car aligned) '(1 1 2)))
         (step (proof-proof-tidy core rewritten)))
      (cons step (cdr aligned)))))

(defun h1-book-expt-sum-successor-negative (proof tests negative child later right)
  (let ((lib (h1-tactics-prover-library proof))
        (core (h1-tactics-prover-proof proof)))
    (proof-with-checked-results
        ((backwards (h1-book-field-field-normalizer proof (append tests (list (list negative t)))))
         (nz (h1-book-expt-checked-pair (h1-book-field-require backwards (proof-neg (proof-eq *library-y* *proof-zero*)))))
         (not-zip (h1-book-expt-sum-not-zip proof *library-y* (car nz) (cdr nz)))
         (backwards (h1-book-field-remember (cdr not-zip) (list (car not-zip))))
         (equation (h1-book-expt-open-power proof child backwards))
         (identity (h1-propositions-propositional-proof-reflexive lib right))
         (reduced (proof-proof-rewrite core identity (car equation) '(1 2 2)))
         (value (h1-book-expt-sum-step-at reduced '(2)))
         (arranged (h1-book-expt-checked-pair (h1-book-arithmetic-algebra-equality (cdr equation) value later)))
         (joined (proof-proof-chain core reduced (list (car arranged))))
         (reversed (h1-propositions-proof-symmetric core joined)))
      (proof-proof-tidy core reversed))))

(defun h1-book-expt-sum-successor-nonnegative (proof tests negative later)
  (let ((lib (h1-tactics-prover-library proof))
        (core (h1-tactics-prover-proof proof)))
    (proof-with-checked-results
        ((onwards (h1-book-field-field-normalizer proof (append tests (list (list negative nil)))))
         (integral (h1-book-expt-checked-pair (h1-book-field-require onwards (library-integer *library-y*))))
         (nonnegative (h1-book-expt-checked-pair (h1-book-field-require (cdr integral) (proof-neg negative))))
         (positive-next (library-library-cite lib "POSITIVE-ONE-PLUS" (list *library-y*)
                                              (list (car integral) (car nonnegative))))
         (swapped (library-library-axiom lib "COMMUTATIVITY-OF-+" (list *library-y* *proof-one*)))
         (positive-next (h1-propositions-library-transport-argument lib positive-next swapped 2))
         (exponent (proof-term-at later 2))
         (nonzero (h1-book-order-nonzero-from-sign proof positive-next exponent))
         (no-zip (h1-book-expt-sum-not-zip proof exponent nonzero (cdr nonnegative)))
         (onwards (h1-book-field-remember (cdr no-zip) (list positive-next (car no-zip))))
         (expanded (h1-book-expt-open-power proof later onwards))
         (inside (h1-book-expt-sum-step-at (car expanded) '(2 2 2)))
         (aligned (h1-book-expt-checked-pair (h1-book-arithmetic-algebra-equality (cdr expanded) inside *library-y*)))
         (rewritten (proof-proof-rewrite core (car expanded) (car aligned) '(1 2 2 2))))
      (proof-proof-tidy core rewritten))))

(defun h1-book-expt-sum-predecessor (proof tests child)
  (let ((lib (h1-tactics-prover-library proof))
        (core (h1-tactics-prover-proof proof)))
    (proof-with-checked-results
        ((norm (h1-book-field-field-normalizer proof tests))
         (previous (library-plus *library-y* *proof-neg-one*))
         (step (h1-book-expt-sum-power-shift proof *library-x* previous *library-y* t norm))
         (factor (list *h1-book-arithmetic-reciprocal* *library-x*))
         (multiply (h1-propositions-propositional-proof-reflexive lib (h1-book-order-product factor child)))
         (multiply (proof-proof-rewrite core multiply (car step) '(1 2 2)))
         (value (h1-book-expt-sum-step-at multiply '(2)))
         (cancelled (h1-book-expt-checked-pair
                     (h1-book-arithmetic-algebra-equality
                      (cdr step) value (h1-book-expt-sum-power *library-x* previous))))
         (joined (proof-proof-chain core multiply (list (car cancelled))))
         (reversed (h1-propositions-proof-symmetric core joined)))
      (proof-proof-tidy core reversed))))

(defun h1-book-expt-sum-power-shifts (proof)
  (let* ((lib (h1-tactics-prover-library proof))
         (numeric (h1-book-expt-sum-number *library-x*))
         (zero (proof-eq *library-x* *proof-zero*))
         (integral (library-integer *library-y*))
         (tests (list (list numeric t) (list zero nil) (list integral t)))
         (guards (list (proof-neg numeric) zero (proof-neg integral)))
         (negative (library-lt *library-y* *proof-zero*))
         (child (h1-book-expt-sum-power *library-x* *library-y*))
         (later (h1-book-expt-sum-power *library-x* (library-plus *library-y* *proof-one*)))
         (right (h1-book-order-product *library-x* child)))
    (proof-with-checked-results
        ((yes (h1-book-expt-sum-successor-negative proof tests negative child later right))
         (no (h1-book-expt-sum-successor-nonnegative proof tests negative later))
         (successor (proof-proof-cases (h1-tactics-prover-proof proof) negative yes no))
         (claim (proof-step-first successor))
         (lib (library-library-lemma lib "EXPT-SUCCESSOR" claim successor guards))
         (proof (h1-tactics-prover-with-library proof lib))
         (predecessor (h1-book-expt-sum-predecessor proof tests child))
         (claim (proof-step-first predecessor))
         (lib (library-library-lemma lib "EXPT-PREDECESSOR" claim predecessor guards)))
      (h1-tactics-prover-with-library proof lib))))

(defun h1-book-expt-sum-conjunction-term (conditions)
  (if (or (endp conditions) (endp (cdr conditions)))
      (car conditions)
    (proof-ite (car conditions) (h1-book-expt-sum-conjunction-term (cdr conditions)) *proof-false*)))

(defun h1-book-expt-sum-addition-base (proof tests zip-test total goal formula)
  (let ((lib (h1-tactics-prover-library proof))
        (core (h1-tactics-prover-proof proof)))
    (proof-with-checked-results
        ((norm (h1-book-field-field-normalizer proof (append tests (list (list zip-test t)))))
         (integral (h1-book-expt-checked-pair (h1-book-field-require norm (library-integer *library-y*))))
         (zip (h1-book-expt-checked-pair (h1-book-field-require (cdr integral) zip-test)))
         (zero (library-library-cite lib "ZERO-FROM-ZIP" (list *library-y*) (list (car integral) (car zip))))
         (norm (h1-book-field-remember (cdr zip) (list zero)))
         (lowered (h1-propositions-propositional-proof-reflexive lib total))
         (aligned (h1-book-expt-checked-pair (h1-book-arithmetic-algebra-equality norm (caddr total) *library-z*)))
         (lowered (proof-proof-rewrite core lowered (car aligned) '(1 2 2)))
         (factors (h1-propositions-propositional-proof-reflexive lib (caddr goal)))
         (at-zero (h1-book-expt-sum-power-at-zero proof *library-x* zero))
         (factors (proof-proof-rewrite core factors at-zero '(1 2 1)))
         (a (h1-book-expt-sum-step-at lowered '(2)))
         (b (h1-book-expt-sum-step-at factors '(2)))
         (middle (h1-book-expt-checked-pair (h1-book-arithmetic-algebra-equality (cdr aligned) a b)))
         (reversed (h1-propositions-proof-symmetric core factors))
         (base (proof-proof-chain core lowered (list (car middle) reversed))))
      (h1-propositions-propositional-proof-implies-from lib formula base))))

(defun h1-book-expt-sum-addition-evidence-one (normalizer condition bindings)
  (proof-with-checked-results ((literal (proof-subst condition bindings)))
    (h1-book-expt-checked-pair (h1-book-field-require normalizer literal))))

(defun h1-book-expt-sum-addition-evidence (conditions bindings result steps)
  (declare (xargs :measure (acl2-count conditions)))
  (cond ((failure-p result) result)
        ((endp conditions) (cons (reverse steps) (cdr result)))
        (t (let ((next (h1-book-expt-sum-addition-evidence-one (cdr result) (car conditions) bindings)))
             (h1-book-expt-sum-addition-evidence (cdr conditions) bindings next
                                                 (cons (car next) steps))))))

(defun h1-book-expt-sum-addition-shift (proof tests zip-test total goal formula conditions upward plan)
  (let ((lib (h1-tactics-prover-library proof))
        (core (h1-tactics-prover-proof proof))
        (bindings (proof-bindings-table (car plan) nil))
        (descent (cadr plan)))
    (proof-with-checked-results
        ((earlier (let ((entry (assoc-equal *library-y* bindings)))
                    (if entry (cdr entry) '(:failure "failure" ""))))
         (norm (h1-book-field-field-normalizer
                proof (append tests (list (list zip-test nil) (list (library-positive *library-y*) upward)))))
         (left (h1-book-expt-sum-power-shift
                proof *library-x* (library-plus earlier *library-z*) (caddr total) upward norm))
         (right-shift (h1-book-expt-sum-power-shift proof *library-x* earlier *library-y* upward (cdr left)))
         (right (h1-propositions-propositional-proof-reflexive lib (caddr goal)))
         (right (proof-proof-rewrite core right (car right-shift) '(1 2 1)))
         (child-formula (proof-subst formula bindings))
         (decrease (proof-step-first descent))
         (hypothesis (proof-ite decrease child-formula *proof-true*))
         (assumed (proof-proof-assume core hypothesis t))
         (child (h1-propositions-proof-prove-if core assumed descent))
         (evidence (h1-book-expt-sum-addition-evidence conditions bindings (cons nil (cdr right-shift)) nil))
         (premise (h1-arithmetic-conjunction lib (cadr child-formula) (car evidence)))
         (child (h1-propositions-propositional-proof-modus-ponens lib child premise))
         (left (proof-proof-rewrite core (car left) child '(1 2 2)))
         (norm (h1-book-arithmetic-algebra-with-work (cdr evidence) 150))
         (a (h1-book-expt-sum-step-at left '(2)))
         (b (h1-book-expt-sum-step-at right '(2)))
         (middle (h1-book-expt-checked-pair (h1-book-arithmetic-algebra-equality norm a b)))
         (reversed (h1-propositions-proof-symmetric core right))
         (step (proof-proof-chain core left (list (car middle) reversed))))
      (h1-propositions-propositional-proof-implies-from lib formula step))))

(defun h1-book-expt-sum-addition-for-nonzero-base (proof)
  (let* ((parent (h1-book-expt-sum-power *library-x* *library-y*))
         (other (h1-book-expt-sum-power *library-x* *library-z*))
         (total (h1-book-expt-sum-power *library-x* (library-plus *library-y* *library-z*)))
         (goal (proof-eq total (h1-book-order-product parent other)))
         (conditions (list (h1-book-expt-sum-number *library-x*)
                           (proof-neg (proof-eq *library-x* *proof-zero*))
                           (library-integer *library-y*) (library-integer *library-z*)))
         (premise (h1-book-expt-sum-conjunction-term conditions))
         (formula (list *library-implies* premise goal))
         (zip-test (list *h1-arithmetic-zip* *library-y*))
         (tests (list (list premise t))))
    (proof-with-checked-results
        ((base (h1-book-expt-sum-addition-base proof tests zip-test total goal formula))
         (plan (h1-book-expt-checked-pair (h1-book-expt-signed-countdowns proof *library-y*)))
         (measure (caar plan))
         (countdowns (cadar plan))
         (proof (cdr plan))
         (core (h1-tactics-prover-proof proof))
         (lib (h1-tactics-prover-library proof))
         (down (h1-book-expt-sum-addition-shift proof tests zip-test total goal formula conditions t (car countdowns)))
         (up (h1-book-expt-sum-addition-shift proof tests zip-test total goal formula conditions nil (cadr countdowns)))
         (shifted (proof-proof-cases core (library-positive *library-y*) down up))
         (step (proof-proof-cases core zip-test base shifted))
         (ordinal (descent-measure-ordinal lib measure))
         (result (proof-proof-induct core ordinal step formula measure (strip-cars countdowns)))
         (assumed (h1-tactics-prover-conjunction-assumption proof premise))
         (consequence (h1-propositions-propositional-proof-modus-ponens lib result assumed))
         (lib (library-library-lemma lib "EXPT-ADD" goal consequence (library-guards conditions))))
      (h1-tactics-prover-with-library proof lib))))

(defun h1-book-expt-sum-install-power-addition (proof)
  (proof-with-checked-results
      ((proof (h1-book-expt-sum-zip-when-integer proof))
       (proof (h1-book-expt-sum-power-shifts proof))
       (proof (h1-book-expt-sum-addition-for-nonzero-base proof))
       (zip-test (list *h1-arithmetic-zip* *library-y*))
       (test (h1-book-expt-sum-fixed-zero *library-x*))
       (norm (h1-book-field-field-normalizer proof (list (list test t) (list zip-test nil))))
       (default (h1-book-expt-open-power proof (h1-book-expt-sum-power *library-x* *library-y*) norm))
       (claim (proof-step-first (car default)))
       (lib (library-library-lemma (h1-tactics-prover-library proof) "EXPT-ZERO-BASE" claim
                                   (car default) (list (proof-neg test) zip-test))))
    (h1-tactics-prover-with-library proof lib)))

(defun h1-book-expt-sum-find-nonzero (proof normalizer term)
  (proof-with-checked-results
      ((known (h1-book-expt-find normalizer (proof-neg (proof-eq term *proof-zero*)))))
    (if (car known)
        known
      (proof-with-checked-results
          ((reversed (h1-book-expt-find (cdr known) (proof-neg (proof-eq *proof-zero* term)))))
        (if (not (car reversed))
            reversed
          (let ((lib (h1-tactics-prover-library proof)))
            (proof-with-checked-results
                ((symmetry (library-library-axiom lib "H1-EQUALITY-SYMMETRIC-VALUE" (list term *proof-zero*)))
                 (step (h1-propositions-library-transport-argument lib (car reversed) symmetry 1)))
              (cons step (cdr reversed)))))))))

(defun h1-book-expt-sum-negative-sum (proof normalizer left right total)
  (let ((core (h1-tactics-prover-proof proof))
        (lib (h1-tactics-prover-library proof)))
    (proof-with-checked-results
        ((a (h1-book-expt-checked-pair (h1-book-field-require normalizer (library-lt left *proof-zero*))))
         (b (h1-book-expt-checked-pair (h1-book-field-require (cdr a) (library-lt right *proof-zero*))))
         (a-as-positive (library-library-cite lib "NEGATIVE-AS-POSITIVE" (list left) nil))
         (a-positive (h1-propositions-proof-transport core (car a) a-as-positive))
         (b-as-positive (library-library-cite lib "NEGATIVE-AS-POSITIVE" (list right) nil))
         (b-positive (h1-propositions-proof-transport core (car b) b-as-positive))
         (left (library-minus left))
         (right (library-minus right))
         (sign (h1-book-order-positive-sum proof left right a-positive b-positive))
         (normalizer (h1-book-arithmetic-algebra-with-work (cdr b) 150))
         (aligned (h1-book-expt-checked-pair
                   (h1-book-arithmetic-algebra-equality normalizer (library-plus left right) (library-minus total))))
         (sign (proof-proof-rewrite core sign (car aligned) '(1 2)))
         (sign (proof-proof-tidy core sign))
         (rule (library-library-cite lib "NEGATIVE-AS-POSITIVE" (list total) nil))
         (sign (proof-proof-rewrite core sign rule '(1)))
         (sign (proof-proof-tidy core sign)))
      (cons sign (cdr aligned)))))

(defun h1-book-expt-sum-same-sign-sum (proof normalizer left right total)
  (proof-with-checked-results
      ((a (h1-book-expt-find normalizer (library-positive left)))
       (b (h1-book-expt-find (cdr a) (library-positive right)))
       (signed (if (and (car a) (car b))
                   (proof-with-checked-results
                       ((sign (h1-book-order-positive-sum proof left right (car a) (car b))))
                     (cons sign (cdr b)))
                 (h1-book-expt-sum-negative-sum proof (cdr b) left right total)))
       (step (h1-book-order-nonzero-from-sign proof (car signed) total)))
    (cons step (cdr signed))))

(defun h1-book-expt-sum-zero-of-sum (proof normalizer left right)
  (let* ((total (library-plus left right))
         (test (proof-eq total *proof-zero*))
         (core (h1-tactics-prover-proof proof))
         (lib (h1-tactics-prover-library proof)))
    (proof-with-checked-results
        ((value (h1-book-expt-checked-pair (h1-book-arithmetic-algebra-normal normalizer test)))
         (right-side (h1-book-expt-sum-step-at (car value) '(2))))
      (cond ((equal right-side *proof-true*)
             (proof-with-checked-results ((step (proof-proof-true-from-eq core (car value))))
               (cons step (cdr value))))
            ((equal right-side *proof-false*)
             (proof-with-checked-results
                 ((not-nil (proof-proof-not-nil core))
                  (step (h1-propositions-library-transport-argument lib not-nil (car value) 1)))
               (cons step (cdr value))))
            (t (h1-book-expt-sum-same-sign-sum proof (cdr value) left right total))))))

(defun h1-book-expt-sum-power-on-zero-base (proof base exponent zero-base case normalizer)
  (proof-with-checked-results ((literal (proof-step-first case)))
    (if (equal literal (proof-eq exponent *proof-zero*))
        (proof-with-checked-results ((step (h1-book-expt-sum-power-at-zero proof base case)))
          (cons step normalizer))
      (proof-with-checked-results
          ((no-zip (h1-book-expt-sum-not-zip proof exponent case normalizer))
           (step (library-library-cite (h1-tactics-prover-library proof) "EXPT-ZERO-BASE"
                                       (list base exponent) (list zero-base (car no-zip)))))
        (cons step (cdr no-zip))))))

(defun h1-book-expt-sum-eliminate-zero-power (proof term index base zero-base result)
  (proof-with-checked-results
        ((exponent (proof-term-at term 2))
         (zero (proof-eq exponent *proof-zero*))
         (yes (h1-book-expt-find (cdr result) zero))
         (evidence (if (car yes)
                       yes
                     (h1-book-expt-checked-pair (h1-book-field-require (cdr yes) (proof-neg zero)))))
         (inner (h1-book-expt-sum-power-on-zero-base proof base exponent zero-base (car evidence) (cdr evidence)))
         (eliminated (proof-proof-rewrite (h1-tactics-prover-proof proof) (car result) (car inner) (list 1 2 index))))
    (cons eliminated (cdr inner))))

(defun h1-book-expt-sum-eliminate-zero-powers (proof terms index base zero-base result)
  (declare (xargs :measure (acl2-count terms)))
  (cond ((failure-p result) result)
        ((endp terms) (car result))
        (t (h1-book-expt-sum-eliminate-zero-powers
            proof (cdr terms) (1+ index) base zero-base
            (h1-book-expt-sum-eliminate-zero-power proof (car terms) index base zero-base result)))))

(defun h1-book-expt-sum-zero-base-product-at-leaf (premises proof goal base left right)
  (let ((core (h1-tactics-prover-proof proof))
        (lib (h1-tactics-prover-library proof)))
    (proof-with-checked-results
        ((norm (h1-book-field-field-normalizer proof premises))
         (zero-base (h1-book-expt-checked-pair (h1-book-field-require norm (h1-book-expt-sum-fixed-zero base))))
         (total (library-plus left right))
         (test (proof-eq total *proof-zero*))
         (sum-zero (h1-book-expt-sum-zero-of-sum proof (cdr zero-base) left right))
         (literal (proof-step-first (car sum-zero)))
         (holds (equal literal test))
         (other (h1-book-expt-find (cdr sum-zero) (if holds (proof-neg test) test))))
      (if (car other)
          (proof-with-checked-results
              ((conflict (if holds
                             (proof-proof-cut core (car sum-zero) (car other))
                           (proof-proof-cut core (car other) (car sum-zero)))))
            (proof-proof-subsume core conflict (cons goal (proof-step-clause conflict))))
        (proof-with-checked-results
            ((value (h1-book-expt-sum-power-on-zero-base proof base total (car zero-base) (car sum-zero) (cdr other)))
             (product (proof-term-at goal 2))
             (eliminated (h1-propositions-propositional-proof-reflexive lib product))
             (eliminated (h1-book-expt-sum-eliminate-zero-powers
                          proof (cdr product) 1 base (car zero-base) (cons eliminated (cdr value))))
             (right-side (h1-book-expt-sum-step-at eliminated '(2)))
             (constant (h1-tactics-prover-constant proof right-side))
             (reduced (proof-proof-chain core eliminated (list constant)))
             (reversed (h1-propositions-proof-symmetric core reduced)))
          (proof-proof-chain core (car value) (list reversed)))))))

(defun h1-book-expt-sum-zero-base-product-split (tests-to-split premises proof goal base left right)
  (if (endp tests-to-split)
      (h1-book-expt-sum-zero-base-product-at-leaf premises proof goal base left right)
    (let ((test (car tests-to-split)))
      (proof-with-checked-results
          ((yes (h1-book-expt-sum-zero-base-product-split
                 (cdr tests-to-split) (append premises (list (list test t))) proof goal base left right))
           (no (h1-book-expt-sum-zero-base-product-split
                (cdr tests-to-split) (append premises (list (list test nil))) proof goal base left right)))
        (proof-proof-cases (h1-tactics-prover-proof proof) test yes no)))))

(defun h1-book-expt-sum-zero-base-product (proof goal base left right tests)
  (h1-book-expt-sum-zero-base-product-split
   (list (proof-eq left *proof-zero*) (proof-eq right *proof-zero*)) tests proof goal base left right))

(defun h1-book-expt-sum-power-addition-nonzero (norm numeric known proof base left right multiplication standard)
  (let ((lib (h1-tactics-prover-library proof))
        (core (h1-tactics-prover-proof proof)))
    (proof-with-checked-results
        ((a (h1-book-expt-checked-pair (h1-book-field-require norm (library-integer left))))
         (b (h1-book-expt-checked-pair (h1-book-field-require (cdr a) (library-integer right))))
         (step (library-library-cite lib "EXPT-ADD" (list base left right) (list numeric known (car a) (car b)))))
      (if (equal multiplication standard)
          step
        (proof-with-checked-results ((swapped (library-library-axiom lib "COMMUTATIVITY-OF-*" (cdr standard))))
          (proof-proof-chain core step (list swapped)))))))

(defun h1-book-expt-sum-power-addition-by-base (branch-tests proof base left right multiplication standard product-goal)
  (proof-with-checked-results
      ((normalizer (h1-book-field-field-normalizer proof branch-tests))
       (numeric (h1-book-expt-find normalizer (h1-book-expt-sum-number base)))
       (known (h1-book-expt-sum-find-nonzero proof (cdr numeric) base)))
    (if (and (car numeric) (car known))
        (h1-book-expt-sum-power-addition-nonzero (cdr known) (car numeric) (car known) proof base left right multiplication standard)
      (proof-with-checked-results
          ((test (h1-book-expt-sum-fixed-zero base))
           (yes (h1-book-expt-sum-zero-base-product proof product-goal base left right (append branch-tests (list (list test t)))))
           (excluded (h1-book-field-field-normalizer proof (append branch-tests (list (list test nil)))))
           (numeric (h1-book-expt-checked-pair (h1-book-field-require excluded (h1-book-expt-sum-number base))))
           (known (h1-book-expt-checked-pair (h1-book-field-require (cdr numeric) (proof-neg (proof-eq base *proof-zero*)))))
           (no (h1-book-expt-sum-power-addition-nonzero
                (cdr known) (car numeric) (car known) proof base left right multiplication standard)))
        (proof-proof-cases (h1-tactics-prover-proof proof) test yes no)))))

(defun h1-book-expt-sum-power-addition-guarded (proof goal result sum-zero tests base left right multiplication standard)
  (let* ((core (h1-tactics-prover-proof proof))
         (lib (h1-tactics-prover-library proof))
         (product-goal (proof-eq (cadr goal) multiplication)))
    (proof-with-checked-results
        ((zero (proof-proof-assume core sum-zero t))
         (unit (h1-book-expt-sum-power-at-zero proof base zero))
         (chosen (h1-propositions-propositional-proof-select lib result zero))
         (reversed (h1-propositions-proof-symmetric core chosen))
         (yes (proof-proof-chain core unit (list reversed)))
         (no (h1-book-expt-sum-power-addition-by-base
              (append tests (list (list sum-zero nil))) proof base left right multiplication standard product-goal))
         (not-zero (proof-proof-assume core sum-zero nil))
         (chosen (h1-propositions-propositional-proof-select lib result not-zero))
         (reversed (h1-propositions-proof-symmetric core chosen))
         (no (proof-proof-chain core no (list reversed))))
      (proof-proof-cases core sum-zero yes no))))

(defun h1-book-expt-sum-power-addition-premises (n goal premises)
  (declare (xargs :measure (nfix n)))
  (cond ((zp n) '(:failure "Fuel" "h1-book-expt-sum-power-addition-premises"))
        ((proof-is-call goal *library-implies*)
         (proof-with-checked-results ((body (proof-term-at goal 2)))
           (h1-book-expt-sum-power-addition-premises (1- n) body (cons goal premises))))
        (t (list premises goal))))

(defun h1-book-expt-sum-power-addition-tests (premises)
  (if (endp premises)
      nil
    (proof-with-checked-results
        ((test (proof-term-at (car premises) 1))
         (rest (h1-book-expt-sum-power-addition-tests (cdr premises))))
      (cons (list test t) rest))))

(defun h1-book-expt-sum-power-addition-restore (lib premises step)
  (declare (xargs :measure (acl2-count premises)))
  (if (or (endp premises) (failure-p step))
      step
    (h1-book-expt-sum-power-addition-restore
     lib (cdr premises) (h1-propositions-propositional-proof-implies-from lib (car premises) step))))

(defun h1-book-expt-sum-power-addition-guard-p (result sum-zero)
  (and (proof-is-call result *proof-if*)
       (proof-with-checked-results ((test (proof-term-at result 1)))
         (and (equal test sum-zero)
              (proof-with-checked-results ((yes (proof-term-at result 2)))
                (equal yes *proof-one*))))))

(defun h1-book-expt-sum-power-addition-goal (proof goal call total premises)
  (proof-with-checked-results
      ((call (proof-list-of-length call 3))
       (operands (proof-list-of-length (cdr total) 2))
       (base (cadr call))
       (left (car operands))
       (right (cadr operands))
       (standard (h1-book-order-product (h1-book-expt-sum-power base left) (h1-book-expt-sum-power base right)))
       (reversed (h1-book-order-product (h1-book-expt-sum-power base right) (h1-book-expt-sum-power base left)))
       (sum-zero (proof-eq total *proof-zero*))
       (result (proof-term-at goal 2))
       (guarded (h1-book-expt-sum-power-addition-guard-p result sum-zero))
       (multiplication (if guarded (proof-term-at result 3) result)))
    (if (not (or (equal multiplication standard) (equal multiplication reversed)))
        '(:failure "Unproved" "")
      (proof-with-checked-results
          ((tests (h1-book-expt-sum-power-addition-tests (reverse premises)))
           (step (if guarded
                     (h1-book-expt-sum-power-addition-guarded proof goal result sum-zero tests base left right multiplication standard)
                   (h1-book-expt-sum-power-addition-by-base
                    tests proof base left right multiplication standard (proof-eq (cadr goal) multiplication)))))
        (h1-book-expt-sum-power-addition-restore (h1-tactics-prover-library proof) premises step)))))

(defun h1-book-expt-sum-power-addition (proof formula)
  (proof-with-checked-results ((parts (h1-book-expt-sum-power-addition-premises 1000000 formula nil)))
    (let ((goal (cadr parts)))
      (if (not (proof-is-call goal *proof-equal*))
          '(:failure "Unproved" "")
        (proof-with-checked-results ((call (proof-term-at goal 1)))
          (if (not (proof-is-call call *h1-arithmetic-expt*))
              '(:failure "Unproved" "")
            (proof-with-checked-results ((total (proof-term-at call 2)))
              (if (not (proof-is-call total *proof-plus*))
                  '(:failure "Unproved" "")
                (h1-book-expt-sum-power-addition-goal proof goal call total (car parts))))))))))
