(in-package "BOYMOO-PROVER")

(set-verify-guards-eagerness 0)

(defconst *h1-book-expt-parity-half* (proof-quote '("ratio" 1 2)))
(defconst *h1-book-expt-parity-two* (proof-quote 2))

(defun h1-book-expt-parity-half (value)
  (h1-book-order-product *h1-book-expt-parity-half* value))

(defun h1-book-expt-parity-even (value)
  (library-integer (h1-book-expt-parity-half value)))

(defun h1-book-expt-parity-half-at-zero (prover zero)
  (let ((lib (h1-tactics-prover-library prover))
        (proof (h1-tactics-prover-proof prover)))
    (proof-with-checked-results
        ((integer (library-library-type-of lib *proof-zero* nil))
         (constant (h1-tactics-prover-constant prover (h1-book-expt-parity-half *proof-zero*)))
         (half-zero (h1-propositions-library-transport-argument lib integer constant 1))
         (reversed (h1-propositions-proof-symmetric proof zero)))
      (proof-proof-rewrite proof half-zero reversed '(1 1 2)))))

(defun h1-book-expt-parity-prove-disjunction (prover choice argument)
  (let ((lib (h1-tactics-prover-library prover))
        (proof (h1-tactics-prover-proof prover)))
    (proof-with-checked-results ((literal (proof-step-first argument))
                                 (test (proof-term-at choice 1)))
      (if (equal literal test)
          (proof-with-checked-results
              ((selected (h1-propositions-propositional-proof-select lib choice argument)))
            (h1-propositions-proof-transport proof argument selected))
        (proof-with-checked-results ((alternative (proof-term-at choice 3)))
          (if (not (equal literal alternative))
              '(:failure "failure" "")
            (proof-with-checked-results
                ((holds (h1-arithmetic-proof-assume proof test t))
                 (selected (h1-propositions-propositional-proof-select lib choice holds))
                 (yes (h1-propositions-proof-transport proof holds selected))
                 (fails (h1-arithmetic-proof-assume proof test nil))
                 (selected (h1-propositions-propositional-proof-select lib choice fails))
                 (no (h1-propositions-proof-transport proof argument selected)))
              (proof-proof-cases proof test yes no))))))))

(defun h1-book-expt-parity-align-branch (prover norm previous child-even child-odd down)
  (let ((lib (h1-tactics-prover-library prover)))
    (if down
        (proof-with-checked-results
            ((half-child (h1-book-expt-order-step-term child-odd 1))
             (shifted (library-library-type-of lib (library-plus *proof-one* half-child) (list child-odd)))
             (odd-here (h1-book-cofactors-aligned-integer
                        prover norm (h1-book-expt-parity-half *library-x*) shifted))
             (odd-step (car odd-here)))
          (list child-even odd-step))
      (proof-with-checked-results
          ((half-child (h1-book-expt-order-step-term child-even 1))
           (shifted (library-library-type-of lib (library-plus *proof-neg-one* half-child) (list child-even)))
           (even-here (h1-book-cofactors-aligned-integer
                       prover norm (h1-book-expt-parity-half previous) shifted))
           (even-step (car even-here))
           (odd-here (h1-book-cofactors-aligned-integer
                      prover (cdr even-here) (h1-book-expt-parity-half *library-x*) child-odd))
           (odd-step (car odd-here)))
        (list even-step odd-step)))))

(defun h1-book-expt-parity-adjacent-branch (prover formula integral previous down countdown)
  (let* ((lib (h1-tactics-prover-library prover))
         (proof (library-library-proof lib))
         (descent (cadr countdown)))
    (proof-with-checked-results
        ((bindings (h1-book-expt-order-bindings (car countdown) nil))
         (child (proof-subst formula bindings))
         (descent-term (proof-step-first descent))
         (hypothesis (h1-arithmetic-proof-assume proof (proof-ite descent-term child *proof-true*) t))
         (evidence (h1-propositions-proof-prove-if proof hypothesis descent))
         (child-type (library-library-type-of lib (cadadr child) (list integral)))
         (evidence (h1-propositions-propositional-proof-modus-ponens lib evidence child-type))
         (child-test (h1-book-expt-order-step-term evidence 1))
         (child-even (h1-arithmetic-proof-assume proof child-test t))
         (not-even (h1-arithmetic-proof-assume proof child-test nil))
         (child-odd (h1-propositions-proof-prove-if proof evidence not-even))
         (norm (h1-book-field-field-normalizer prover (list (list (cadr formula) t))))
         (aligned (h1-book-expt-parity-align-branch prover norm previous child-even child-odd down))
         (even-here (h1-book-expt-parity-prove-disjunction prover (caddr formula) (car aligned)))
         (odd-here (h1-book-expt-parity-prove-disjunction prover (caddr formula) (cadr aligned)))
         (by-parity (proof-proof-cases proof child-test even-here odd-here)))
      (h1-propositions-propositional-proof-implies-from lib formula by-parity))))

(defun h1-book-expt-parity-install-adjacent-parity (prover)
  (let* ((lib (h1-tactics-prover-library prover))
         (proof (library-library-proof lib))
         (x *library-x*)
         (typed (library-integer x))
         (even-x (h1-book-expt-parity-even x))
         (previous (library-plus x *proof-neg-one*))
         (choice (proof-ite even-x even-x (h1-book-expt-parity-even previous)))
         (formula (list *library-implies* typed choice))
         (zip-test (list *h1-arithmetic-zip* x)))
    (proof-with-checked-results
        ((integral (h1-arithmetic-proof-assume proof typed t))
         (zipped (h1-arithmetic-proof-assume proof zip-test t))
         (zero (library-library-cite lib "ZERO-FROM-ZIP" (list x) (list integral zipped)))
         (half-zero (h1-book-expt-parity-half-at-zero prover zero))
         (base (h1-book-expt-parity-prove-disjunction prover choice half-zero))
         (base (h1-propositions-propositional-proof-implies-from lib formula base))
         (countdowns (h1-book-expt-signed-countdowns prover x))
         (countdown-data (car countdowns))
         (prover (cdr countdowns))
         (lib (h1-tactics-prover-library prover))
         (proof (library-library-proof lib))
         (measure (car countdown-data))
         (cases (cadr countdown-data))
         (down (h1-book-expt-parity-adjacent-branch prover formula integral previous t (car cases)))
         (up (h1-book-expt-parity-adjacent-branch prover formula integral previous nil (cadr cases)))
         (by-sign (proof-proof-cases proof (library-positive x) down up))
         (step (proof-proof-cases proof zip-test base by-sign))
         (ordinal (descent-measure-ordinal lib measure))
         (induction (proof-proof-induct proof ordinal step formula measure (list (caar cases) (caadr cases))))
         (lib (library-library-lemma lib "ADJACENT-INTEGER-PARITY" formula induction nil)))
      (h1-tactics-prover-with-library prover lib))))

(defun h1-book-expt-parity-install-negative-one-even (prover typed exponent-is-even)
  (let* ((lib (h1-tactics-prover-library prover))
         (proof (library-library-proof lib))
         (two *h1-book-expt-parity-two*)
         (halves (h1-book-expt-parity-half *library-x*)))
    (proof-with-checked-results
        ((composition (library-library-cite lib "EXPT-COMPOSITION" (list *proof-neg-one* two halves) nil))
         (premise (h1-book-expt-order-step-term composition 1))
         (typed-two (library-library-type-of lib two nil))
         (even-step (h1-arithmetic-proof-assume proof exponent-is-even t))
         (evidence (h1-propositions-propositional-proof-conjoin lib premise typed-two even-step))
         (square-power (h1-propositions-propositional-proof-modus-ponens lib composition evidence))
         (norm (h1-book-field-field-normalizer prover (list (list typed t))))
         (doubled (h1-book-arithmetic-algebra-equality
                   norm (h1-book-order-product two halves) *library-x*))
         (doubled-step (car doubled))
         (square-power (proof-proof-rewrite proof square-power doubled-step '(1 2 2)))
         (squared (h1-tactics-prover-solve
                   prover (proof-eq (h1-book-expt-sum-power *proof-neg-one* two) *proof-one*)
                   (list (cons *h1-arithmetic-expt* 4) (cons *h1-arithmetic-zip* 2)) 160))
         (unit-power (proof-proof-rewrite proof square-power squared '(1 1 1)))
         (reversed (h1-propositions-proof-symmetric proof unit-power))
         (one-power (library-library-axiom lib "H1-ONE-TO-POWER" (list halves)))
         (at-even (proof-proof-chain proof reversed (list one-power)))
         (claim (proof-step-first at-even))
         (lib (library-library-lemma lib "EVEN-POWER-OF-NEGATIVE-ONE" claim at-even
                                     (list (proof-neg typed) (proof-neg exponent-is-even)))))
      (h1-tactics-prover-with-library prover lib))))

(defun h1-book-expt-parity-install-negative-one-powers (prover)
  (let* ((x *library-x*)
         (typed (library-integer x))
         (exponent-is-even (h1-book-expt-parity-even x))
         (previous (library-plus x *proof-neg-one*)))
    (proof-with-checked-results
        ((integral (h1-arithmetic-proof-assume (h1-tactics-prover-proof prover) typed t))
         (prover (h1-book-expt-parity-install-negative-one-even prover typed exponent-is-even))
         (lib (h1-tactics-prover-library prover))
         (proof (library-library-proof lib))
         (adjacent (library-library-cite lib "ADJACENT-INTEGER-PARITY" (list x) nil))
         (choice (h1-propositions-propositional-proof-modus-ponens lib adjacent integral))
         (not-even (h1-arithmetic-proof-assume proof exponent-is-even nil))
         (even-previous (h1-propositions-proof-prove-if proof choice not-even))
         (norm (h1-book-field-field-normalizer prover (list (list typed t))))
         (succession (h1-book-expt-sum-power-shift prover *proof-neg-one* previous x t norm))
         (previous-type (library-library-type-of lib previous (list integral)))
         (previous-power (library-library-cite lib "EVEN-POWER-OF-NEGATIVE-ONE" (list previous)
                                               (list previous-type even-previous)))
         (reduced (proof-proof-rewrite proof (car succession) previous-power '(1 2 2)))
         (value (h1-book-expt-order-step-term reduced 2))
         (constant (h1-tactics-prover-constant prover value))
         (at-odd (proof-proof-chain proof reduced (list constant)))
         (claim (proof-step-first at-odd))
         (lib (library-library-lemma lib "ODD-POWER-OF-NEGATIVE-ONE" claim at-odd
                                     (list (proof-neg typed) exponent-is-even))))
      (h1-tactics-prover-with-library prover lib))))

(defun h1-book-expt-parity-symmetry-result (prover odd result)
  (if odd
      result
    (proof-with-checked-results
        ((norm (h1-book-field-field-normalizer prover nil))
         (value (h1-book-expt-order-step-term result 2))
         (equality (h1-book-arithmetic-algebra-equality
                    norm value (h1-book-expt-sum-power *library-x* *library-y*)))
         (step (car equality)))
      (proof-proof-chain (h1-tactics-prover-proof prover) result (list step)))))

(defun h1-book-expt-parity-install-base-symmetry (prover odd)
  (let* ((lib (h1-tactics-prover-library prover))
         (proof (library-library-proof lib))
         (label (if odd "ODD" "EVEN"))
         (name (concatenate 'string "NEGATED-BASE-" label))
         (exponent (library-integer *library-y*)))
    (proof-with-checked-results
        ((parity (h1-arithmetic-proof-assume proof (h1-book-expt-parity-even *library-y*) (not odd)))
         (integer (h1-arithmetic-proof-assume proof exponent t))
         (negative (library-library-cite lib (concatenate 'string label "-POWER-OF-NEGATIVE-ONE")
                                         (list *library-y*) (list integer parity)))
         (multiplication (library-library-cite lib "EXPT-PRODUCT" (list *proof-neg-one* *library-x* *library-y*) nil))
         (result (proof-proof-rewrite proof multiplication negative '(1 2 1)))
         (result (h1-book-expt-parity-symmetry-result prover odd result))
         (claim (proof-step-first result))
         (condition (proof-term-at (proof-step-clause parity) 1))
         (lib (library-library-lemma lib name claim result (list (proof-neg exponent) condition)))
         (prover (h1-tactics-prover-with-library prover lib))
         (proof (library-library-proof lib))
         (parity-test (proof-step-first parity))
         (premise (h1-book-cofactors-combine (list (h1-book-order-rational *library-x*) exponent parity-test)))
         (assumed (h1-arithmetic-proof-assume proof premise t))
         (parts (h1-book-cofactors-components prover assumed))
         (parts (proof-list-of-length parts 3))
         (under-premise (library-library-cite lib name (list *library-x* *library-y*) (cdr parts)))
         (implication (h1-propositions-propositional-proof-implies-from
                       lib (list *library-implies* premise claim) under-premise))
         (recorded (h1-tactics-prover-record-formula prover (concatenate 'string "EXPT-BASE-NEGATION-" label)
                                                     implication nil)))
      (cdr recorded))))

(defun h1-book-expt-parity-negative-odd (lib signed target)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((minus (library-library-axiom lib "H1-MINUS-AS-PRODUCT" (list target)))
         (minus (h1-propositions-proof-symmetric proof minus))
         (signed (proof-proof-rewrite proof signed minus '(1 2)))
         (negative (library-library-cite lib "NEGATIVE-AS-POSITIVE" (list target) nil)))
      (proof-proof-rewrite proof signed negative '(1)))))

(defun h1-book-expt-parity-power-on-negative-base (prover label premise)
  (let* ((lib (h1-tactics-prover-library prover))
         (proof (library-library-proof lib))
         (x *library-x*)
         (y *library-y*)
         (target (h1-book-expt-sum-power x y)))
    (proof-with-checked-results
        ((assumed (h1-arithmetic-proof-assume proof premise t))
         (parts (h1-book-cofactors-components prover assumed))
         (parts (proof-list-of-length parts 4))
         (negative-equation (library-library-cite lib "NEGATIVE-AS-POSITIVE" (list x) nil))
         (positive-base (h1-propositions-proof-transport proof (car parts) negative-equation))
         (minus (library-library-axiom lib "H1-MINUS-AS-PRODUCT" (list x)))
         (negative (proof-proof-rewrite proof positive-base minus '(1 2)))
         (base (h1-book-expt-order-step-term negative 2))
         (base-test (proof-step-first (cadr parts)))
         (norm (h1-book-field-field-normalizer prover (list (list base-test t))))
         (typed-base (h1-book-field-require norm (h1-book-order-rational base)))
         (typed (car typed-base))
         (typed (proof-proof-discharge proof typed (cadr parts)))
         (signed (library-library-cite lib "POSITIVE-POWER" (list base y) (list typed negative)))
         (symmetry (library-library-cite lib (concatenate 'string "NEGATED-BASE-" label)
                                         (list x y) (cddr parts)))
         (signed (proof-proof-rewrite proof signed symmetry '(1 2))))
      (if (equal label "ODD") (h1-book-expt-parity-negative-odd lib signed target) signed))))

(defun h1-book-expt-parity-zero-exponent (lib zip-test typed)
  (proof-with-checked-results
      ((zipped (h1-arithmetic-proof-assume (library-library-proof lib) zip-test t)))
    (library-library-cite lib "ZERO-FROM-ZIP" (list *library-y*) (list typed zipped))))

(defun h1-book-expt-parity-bound-at-zero-base (prover odd zero typed parity)
  (let* ((lib (h1-tactics-prover-library prover))
         (proof (library-library-proof lib))
         (zip-test (list *h1-arithmetic-zip* *library-y*)))
    (proof-with-checked-results
        ((not-zipped
          (if odd
              (proof-with-checked-results
                  ((zero-exponent (h1-book-expt-parity-zero-exponent lib zip-test typed))
                   (half-zero (h1-book-expt-parity-half-at-zero prover zero-exponent))
                   (cut (proof-proof-cut proof half-zero parity)))
                (proof-proof-front proof cut (proof-neg zip-test)))
            (h1-arithmetic-proof-assume proof zip-test nil)))
         (fixed (h1-book-expt-composition-fixed-at-zero prover zero))
         (zero-power (library-library-cite lib "EXPT-ZERO-BASE" (list *library-x* *library-y*)
                                           (list fixed not-zipped)))
         (zero-axiom (library-library-axiom lib "ZERO" nil))
         (reversed (h1-propositions-proof-symmetric proof zero-power))
         (result (proof-proof-rewrite proof zero-axiom reversed (list 1 1 (if odd 2 1)))))
      (if odd
          result
        (proof-with-checked-results
            ((zero-exponent (h1-book-expt-parity-zero-exponent lib zip-test typed))
             (unit (h1-book-expt-sum-power-at-zero prover *library-x* zero-exponent))
             (constant (h1-tactics-prover-constant prover (library-lt *proof-one* *proof-zero*)))
             (nonnegative (h1-propositions-computed-test lib constant))
             (reversed (h1-propositions-proof-symmetric proof unit))
             (at-unit (proof-proof-rewrite proof nonnegative reversed '(1 1 1))))
          (proof-proof-cases proof zip-test at-unit result))))))

(defun h1-book-expt-parity-weak-sign (prover strict strict-premise weak-premise base-negative odd)
  (let* ((lib (h1-tactics-prover-library prover))
         (proof (library-library-proof lib))
         (target (h1-book-expt-sum-power *library-x* *library-y*)))
    (proof-with-checked-results
        ((assumed (h1-arithmetic-proof-assume proof weak-premise t))
         (parts (h1-book-cofactors-components prover assumed))
         (parts (proof-list-of-length parts 4))
         (negative (h1-arithmetic-proof-assume proof base-negative t))
         (supplied (h1-arithmetic-conjunction lib strict-premise (cons negative (cdr parts))))
         (strict-sign (h1-propositions-propositional-proof-modus-ponens lib strict supplied))
         (exclusion (library-library-cite lib "POSITIVE-EXCLUDES-NEGATIVE" (list target) nil))
         (nonpositive-power
          (if odd
              (proof-with-checked-results ((cut (proof-proof-cut proof strict-sign exclusion)))
                (proof-proof-front proof cut (proof-neg (library-positive target))))
            (proof-proof-discharge proof exclusion strict-sign)))
         (nonnegative (h1-arithmetic-proof-assume proof base-negative nil))
         (zero-base (library-library-cite lib "ORDER-ZERO" (list *library-x*)
                                           (list (cadr parts) (car parts) nonnegative)))
         (zero-case (h1-book-expt-parity-bound-at-zero-base prover odd zero-base (caddr parts) (cadddr parts)))
         (result (proof-proof-cases proof base-negative nonpositive-power zero-case))
         (claim (proof-step-first result)))
      (h1-propositions-propositional-proof-implies-from lib (list *library-implies* weak-premise claim) result))))

(defun h1-book-expt-parity-install-sign-for-parity (prover odd)
  (let* ((lib (h1-tactics-prover-library prover))
         (label (if odd "ODD" "EVEN"))
         (base-negative (library-lt *library-x* *proof-zero*))
         (even (h1-book-expt-parity-even *library-y*))
         (common (list (h1-book-order-rational *library-x*) (library-integer *library-y*)
                       (if odd (proof-neg even) even))))
    (proof-with-checked-results
        ((strict-premise (h1-book-cofactors-combine (cons base-negative common)))
         (strict-sign (h1-book-expt-parity-power-on-negative-base prover label strict-premise))
         (claim (proof-step-first strict-sign))
         (step (h1-propositions-propositional-proof-implies-from
                lib (list *library-implies* strict-premise claim) strict-sign))
         (strict (h1-tactics-prover-record-formula
                  prover (concatenate 'string "EXPT-NEGATIVE-SIGN-" label) step nil))
         (weak-premise (h1-book-cofactors-combine (cons (proof-neg (library-positive *library-x*)) common)))
         (result (h1-book-expt-parity-weak-sign (cdr strict) (car strict) strict-premise weak-premise base-negative odd))
         (weak (h1-tactics-prover-record-formula
                (cdr strict) (concatenate 'string "EXPT-NONPOSITIVE-SIGN-" label) result nil)))
      (cdr weak))))

(defun h1-book-expt-parity-install-power-parity (prover)
  (let* ((x *library-x*)
         (y *library-y*)
         (z *library-z*)
         (multiplication (proof-eq
                          (h1-book-expt-sum-power (h1-book-order-product x y) z)
                          (h1-book-order-product (h1-book-expt-sum-power x z)
                                                 (h1-book-expt-sum-power y z)))))
    (proof-with-checked-results
        ((equality (h1-book-expt-power-equality prover multiplication))
         (step (car equality))
         (recorded (h1-tactics-prover-record-formula (cdr equality) "EXPT-PRODUCT" step nil))
         (prover (h1-book-expt-parity-install-adjacent-parity (cdr recorded)))
         (prover (h1-book-expt-parity-install-negative-one-powers prover))
         (prover (h1-book-expt-parity-install-base-symmetry prover nil))
         (prover (h1-book-expt-parity-install-sign-for-parity prover nil))
         (prover (h1-book-expt-parity-install-base-symmetry prover t)))
      (h1-book-expt-parity-install-sign-for-parity prover t))))
