        ((zero (h1-tactics-prover-solve proof (h1-book-expt-sum-fixed-zero *proof-zero*) nil 160))
         (symmetric (h1-propositions-proof-symmetric p equality))
         (rewritten (proof-proof-rewrite p zero symmetric '(1 1 1))))
      (proof-proof-tidy p rewritten))))

