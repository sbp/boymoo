(in-package "BOYMOO-PROVER")
(set-verify-guards-eagerness 0)

(defun h1-book-expt-composition-zip-at-zero (proof zero)
  (let ((p (h1-tactics-prover-proof proof)))
    (proof-with-checked-results
        ((step (h1-tactics-prover-solve proof
                                       (proof-eq (list *h1-arithmetic-zip* *proof-zero*) *proof-true*)
                                       (list *h1-arithmetic-zip*) 160))
         (symmetric (h1-propositions-proof-symmetric p zero))
         (rewritten (proof-proof-rewrite p step symmetric '(1 1 1))))
      (proof-proof-tidy p rewritten))))

(defun h1-book-expt-composition-zip-without-integer (proof exponent noninteger)
  (let ((library (h1-tactics-prover-library proof)))
    (proof-with-checked-results
        ((equation (proof-proof-unfold (h1-tactics-prover-proof proof)
                                       (list *h1-arithmetic-zip* exponent))))
      (h1-propositions-select-value library equation noninteger))))

(defun h1-book-expt-composition-zip-negation (proof)
  (let* ((library (h1-tactics-prover-library proof))
         (p (h1-tactics-prover-proof proof))
         (x *library-x*)
         (opposite (library-minus x))
         (typed (library-integer x))
         (translated (library-integer opposite))
         (zero (proof-eq x *proof-zero*))
         (opposite-zero (proof-eq opposite *proof-zero*)))
    (proof-with-checked-results
        ((integral (h1-arithmetic-proof-assume p typed t))
         (minus-zero (proof-proof-compute p (library-minus *proof-zero*) 0))
         (zero-x (h1-arithmetic-proof-assume p zero t))
         (zero-x-symmetric (h1-propositions-proof-symmetric p zero-x))
         (zero-opposite (proof-proof-rewrite p minus-zero zero-x-symmetric '(1 1 1)))
         (zip-opposite (h1-book-expt-composition-zip-at-zero proof zero-opposite))
         (zip-x (h1-book-expt-composition-zip-at-zero proof zero-x))
         (zip-x-symmetric (h1-propositions-proof-symmetric p zip-x))
         (both-zero (proof-proof-chain p zip-opposite (list zip-x-symmetric)))

         (double (library-library-cite library "DOUBLE-NEGATION" (list x) (list integral)))
         (assumed-opposite (h1-arithmetic-proof-assume p opposite-zero t))
         (symmetric-opposite (h1-propositions-proof-symmetric p assumed-opposite))
         (at-zero (proof-proof-rewrite p minus-zero symmetric-opposite '(1 1 1)))
         (double-symmetric (h1-propositions-proof-symmetric p double))
         (forced-zero (proof-proof-chain p double-symmetric (list at-zero)))
         (denied-zero (h1-arithmetic-proof-assume p zero nil))
         (conflict (proof-proof-cut p forced-zero denied-zero))
         (opposite-nz (proof-proof-front p conflict (proof-neg opposite-zero)))
         (opposite-integer (library-library-type-of library opposite (list integral)))
         (denied-zero (h1-arithmetic-proof-assume p zero nil))
         (no-zip (library-library-cite library "NO-ZIP-FROM-NONZERO" (list opposite)
                                       (list opposite-integer opposite-nz)))
         (opposite-false (h1-tactics-prover-false-equation proof no-zip))
         (no-zip (library-library-cite library "NO-ZIP-FROM-NONZERO" (list x)
                                       (list integral denied-zero)))
         (x-false (h1-tactics-prover-false-equation proof no-zip))
         (x-false-symmetric (h1-propositions-proof-symmetric p x-false))
         (both-nonzero (proof-proof-chain p opposite-false (list x-false-symmetric)))
         (integers (proof-proof-cases p zero both-zero both-nonzero))

         (noninteger (h1-arithmetic-proof-assume p typed nil))
         (zip-x (h1-book-expt-composition-zip-without-integer proof x noninteger))
         (numeric (h1-book-expt-sum-number x))
         (norm (h1-book-field-field-normalizer proof (list (list numeric t))))
         (normalized (h1-book-arithmetic-algebra-equality norm (library-minus opposite) x))
         (double (car normalized))
         (assumed-translated (h1-arithmetic-proof-assume p translated t))
         (would-be-int (library-library-type-of library (library-minus opposite) (list assumed-translated)))
         (would-be-int (proof-proof-rewrite p would-be-int double '(1 1)))
         (contradiction (proof-proof-cut p would-be-int noninteger))
         (not-translated (proof-proof-front p contradiction (proof-neg translated)))
         (zip-opposite (h1-book-expt-composition-zip-without-integer proof opposite not-translated))
         (default (library-library-axiom library "COMPLETION-OF-UNARY-MINUS" (list x)))
         (value (h1-book-modulo-first-at default '(2)))
         (nonnumeric (h1-arithmetic-proof-assume p numeric nil))
         (selected (h1-propositions-propositional-proof-select library value nonnumeric))
         (default (proof-proof-chain p default (list selected)))
         (zip-default (h1-book-expt-composition-zip-at-zero proof default))
         (other (proof-proof-cases p numeric zip-opposite zip-default))
         (zip-x-symmetric (h1-propositions-proof-symmetric p zip-x))
         (nonintegers (proof-proof-chain p other (list zip-x-symmetric))))
      (proof-proof-cases p typed integers nonintegers))))

(defun h1-book-expt-composition-install-inverse-exponent (proof)
  (let* ((library (h1-tactics-prover-library proof))
         (p (h1-tactics-prover-proof proof))
         (x *library-x*)
         (y *library-y*)
         (negative-y (library-minus y))
         (original (h1-book-expt-sum-power x y))
         (opposite (h1-book-expt-sum-power x negative-y))
         (typed (h1-book-expt-sum-number x))
         (zero (proof-eq x *proof-zero*))
         (integral (library-integer y)))
    (proof-with-checked-results
        ((int-y (h1-arithmetic-proof-assume p integral t))
         (numeric (h1-arithmetic-proof-assume p typed t))
         (nonzero (h1-arithmetic-proof-assume p zero nil))
         (int-negative (library-library-type-of library negative-y (list int-y)))
         (total (library-library-cite library "EXPT-ADD" (list x y negative-y)
                                      (list numeric nonzero int-y int-negative)))
         (total-symmetric (h1-propositions-proof-symmetric p total))
         (zero-sum (library-library-axiom library "INVERSE-OF-+" (list y)))
         (unit-power (h1-book-expt-sum-power-at-zero proof x zero-sum))
         (unit (proof-proof-chain p total-symmetric (list unit-power)))
         (inverse (proof-proof-use p *h1-book-field-inverse-unique*
                                   (list (list x original) (list y opposite)) (list unit))))
      (h1-book-modulo-lemma proof "EXPT-NEGATIVE-RECIPROCAL" inverse
                            (list (proof-neg typed) zero (proof-neg integral))))))

(defun h1-book-expt-composition-fixed-at-zero (proof equality)
  (let ((p (h1-tactics-prover-proof proof)))
