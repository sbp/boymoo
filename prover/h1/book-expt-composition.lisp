(defun h1-book-expt-composition-negate-exponent (proof equal-reciprocal)
  (let* ((library (h1-tactics-prover-library proof))
         (p (h1-tactics-prover-proof proof))
         (x *library-x*)
         (y *library-y*)
         (negative-y (library-minus y))
         (reciprocal-x (h1-book-field-reciprocal x))
         (opposite (h1-book-expt-sum-power x negative-y))
         (other (h1-book-expt-sum-power reciprocal-x y))
         (zip-y (list *h1-arithmetic-zip* y))
         (integer-y (library-integer y))
         (test (h1-book-expt-sum-fixed-zero x)))
    (proof-with-checked-results
        ((zipped (h1-arithmetic-proof-assume p zip-y t))
         (zip-eq (library-library-axiom library "H1-ZIP-NEGATION" (list y)))
         (same-zip (h1-propositions-proof-transport p zipped zip-eq))
         (opposite-one (h1-book-expt-composition-negate-exponent-at-zip opposite same-zip proof))
         (other-one (h1-book-expt-composition-negate-exponent-at-zip other zipped proof))
         (other-symmetric (h1-propositions-proof-symmetric p other-one))
         (both-one (proof-proof-chain p opposite-one (list other-symmetric)))
         (not-zipped (h1-arithmetic-proof-assume p zip-y nil))
         (not-opposite (h1-propositions-library-transport-argument library not-zipped zip-eq 1))
         (not-integer (h1-arithmetic-proof-assume p integer-y nil))
         (zip-eq-default (h1-book-expt-composition-zip-without-integer proof y not-integer))
         (zip-default (proof-proof-true-from-eq p zip-eq-default))
         (conflict (proof-proof-cut p zip-default not-zipped))
         (integral (proof-proof-front p conflict integer-y))

         (zero-x (h1-arithmetic-proof-assume p test t))
         (zero-reciprocal (proof-proof-use p (proof-sym "H1-RECIPROCAL-FIX-ZERO" "ACL2")
                                           (list (list x x)) (list zero-x)))
         (left (library-library-cite library "EXPT-ZERO-BASE" (list x negative-y)
                                     (list zero-x not-opposite)))
         (fixed (h1-book-expt-composition-fixed-at-zero proof zero-reciprocal))
         (right (library-library-cite library "EXPT-ZERO-BASE" (list reciprocal-x y)
                                      (list fixed not-zipped)))
         (right-symmetric (h1-propositions-proof-symmetric p right))
         (both-zero (proof-proof-chain p left (list right-symmetric)))

         (norm (h1-book-field-field-normalizer proof (list (list test nil))))
         (numeric (h1-book-expt-checked-pair
                   (h1-book-field-require norm (h1-book-expt-sum-number x))))
         (nonzero (h1-book-expt-checked-pair
                   (h1-book-field-require (cdr numeric) (proof-neg (proof-eq x *proof-zero*)))))
         (opposite-power (library-library-cite library "EXPT-NEGATIVE-RECIPROCAL" (list x y)
                                               (list (car numeric) (car nonzero) integral)))
         (regular (proof-proof-chain p opposite-power (list equal-reciprocal)))
         (non-zip (proof-proof-cases p test both-zero regular)))
      (proof-proof-cases p zip-y both-one non-zip))))

(defun h1-book-expt-composition-product-at-zero (proof factor exponent zero index)
  (let ((library (h1-tactics-prover-library proof))
        (p (h1-tactics-prover-proof proof)))
    (proof-with-checked-results
        ((original (h1-propositions-propositional-proof-reflexive
                    library (h1-book-order-product factor exponent)))
         (product-zero (proof-proof-rewrite p original zero (list 1 2 index)))
         (value (h1-book-modulo-first-at product-zero (list 2 (- 3 index))))
         (lemma (library-library-axiom library "H1-PRODUCT-ZERO" (list value)))
         (lemma (if (equal index 1)
                    (proof-with-checked-results
                        ((commuted (library-library-axiom library "COMMUTATIVITY-OF-*"
                                                          (list *proof-zero* exponent))))
                      (proof-proof-chain p commuted (list lemma)))
                  lemma)))
      (proof-proof-chain p product-zero (list lemma)))))

(defun h1-book-expt-composition-composition-at-zero-base (proof norm)
  (let* ((library (h1-tactics-prover-library proof))
         (p (h1-tactics-prover-proof proof))
         (x *library-x*)
         (y *library-y*)
         (z *library-z*)
         (inner (h1-book-expt-sum-power x y))
         (i-zero (proof-eq y *proof-zero*))
         (j-zero (proof-eq z *proof-zero*))
         (product (h1-book-order-product y z)))
    (proof-with-checked-results
        ((base (h1-book-expt-checked-pair
                (h1-book-field-require norm (h1-book-expt-sum-fixed-zero x))))
         (base-zero (car base))
         (zero-j (h1-arithmetic-proof-assume p j-zero t))
         (product-zero (h1-book-expt-composition-product-at-zero proof y z zero-j 2))
         (right (h1-book-expt-sum-power-at-zero proof x product-zero))
         (left (h1-book-expt-sum-power-at-zero proof inner zero-j))
         (right-symmetric (h1-propositions-proof-symmetric p right))
         (at-zero (proof-proof-chain p left (list right-symmetric)))

         (zero-i (h1-arithmetic-proof-assume p i-zero t))
         (at-one (library-library-axiom library "H1-ONE-TO-POWER" (list z)))
         (inner-zero (h1-book-expt-sum-power-at-zero proof x zero-i))
         (inner-symmetric (h1-propositions-proof-symmetric p inner-zero))
         (left (proof-proof-rewrite p at-one inner-symmetric '(1 1 1)))
         (product-zero (h1-book-expt-composition-product-at-zero proof y z zero-i 1))
         (right (h1-book-expt-sum-power-at-zero proof x product-zero))
         (right-symmetric (h1-propositions-proof-symmetric p right))
         (inner-one (proof-proof-chain p left (list right-symmetric)))

         (nonzero-i (h1-arithmetic-proof-assume p i-zero nil))
         (nonzero-j (h1-arithmetic-proof-assume p j-zero nil))
         (numeric-y (h1-book-expt-checked-pair
                     (h1-book-field-require (cdr base) (h1-book-expt-sum-number y))))
         (numeric-z (h1-book-expt-checked-pair
                     (h1-book-field-require (cdr numeric-y) (h1-book-expt-sum-number z))))
         (nonzero-product (proof-proof-use p (proof-sym "H1-NONZERO-PRODUCT" "ACL2")
                                           (list (list x y) (list y z))
                                           (list (car numeric-y) (car numeric-z) nonzero-i nonzero-j)))
         (zip-i (h1-book-expt-sum-not-zip proof y nonzero-i (cdr numeric-z)))
         (inner-zero (library-library-cite library "EXPT-ZERO-BASE" (list x y)
                                           (list base-zero (car zip-i))))
         (fixed-inner (h1-book-expt-composition-fixed-at-zero proof inner-zero))
         (zip-j (h1-book-expt-sum-not-zip proof z nonzero-j (cdr zip-i)))
         (left (library-library-cite library "EXPT-ZERO-BASE" (list inner z)
                                     (list fixed-inner (car zip-j))))
         (zip-product (h1-book-expt-sum-not-zip proof product nonzero-product (cdr zip-j)))
         (right (library-library-cite library "EXPT-ZERO-BASE" (list x product)
                                      (list base-zero (car zip-product))))
         (right-symmetric (h1-propositions-proof-symmetric p right))
         (both (proof-proof-chain p left (list right-symmetric)))
         (nonzero-j-case (proof-proof-cases p i-zero inner-one both))
         (step (proof-proof-cases p j-zero at-zero nonzero-j-case)))
      (cons step (cdr zip-product)))))

(defun h1-book-expt-composition-composition-branch
    (proof inner exponent formula zip-z tests upward countdown)
  (let* ((library (h1-tactics-prover-library proof))
         (p (h1-tactics-prover-proof proof))
         (x *library-x*)
         (y *library-y*)
         (z *library-z*)
         (bindings (car countdown))
         (descent (cadr countdown)))
    (proof-with-checked-results
        ((norm (h1-book-field-field-normalizer
                proof (append tests (list (list zip-z nil) (list (library-positive z) upward)))))
         (inner-type (library-library-axiom library "H1-EXPT-NUMBER" (list x y)))
         (nonzero (proof-proof-fact p (proof-sym "EXPT-TYPE-PRESCRIPTION-NON-ZERO-BASE" "ACL2")
                                    (list (list (proof-sym "R" "ACL2") x)
                                          (list (proof-sym "I" "ACL2") y))))
         (numeric (h1-book-expt-checked-pair
                   (h1-book-field-require norm (h1-book-expt-sum-number x))))
         (nonzero-base (h1-book-expt-checked-pair
                        (h1-book-field-require (cdr numeric) (proof-neg (proof-eq x *proof-zero*)))))
         (base-type (car numeric))
         (base-nz (car nonzero-base))
         (nonzero-premise (h1-book-modulo-first-at nonzero '(1)))
         (conjoined (h1-propositions-propositional-proof-conjoin library nonzero-premise base-type base-nz))
         (inner-nz (h1-propositions-propositional-proof-modus-ponens library nonzero conjoined))
         (norm (h1-book-field-remember (cdr nonzero-base) (list inner-type inner-nz)))
         (binding-map (proof-bindings-table bindings nil))
         (child-z (if (assoc-equal z binding-map)
                      (cdr (assoc-equal z binding-map))
                    '(:failure "failure" "")))
         (left-shift (h1-book-expt-sum-power-shift proof inner child-z z upward norm))

         (child (proof-subst formula binding-map))
         (decreased (proof-step-first descent))
         (hypothesis (h1-arithmetic-proof-assume p (proof-ite decreased child *proof-true*) t))
         (given (h1-propositions-proof-prove-if p hypothesis descent))
         (premise (proof-term-at child 1))
         (typed-y (h1-book-expt-checked-pair
                   (h1-book-field-require (cdr left-shift) (library-integer y))))
         (typed-child (h1-book-expt-checked-pair
                       (h1-book-field-require (cdr typed-y) (library-integer child-z))))
         (evidence (h1-propositions-propositional-proof-conjoin library premise
                                                               (car typed-y) (car typed-child)))
         (equality (h1-propositions-propositional-proof-modus-ponens library given evidence))
         (left (proof-proof-rewrite p (car left-shift) equality '(1 2 2)))

         (before (h1-book-order-product y child-z))
         (increment (if upward y (library-minus y)))
         (typed-before (h1-book-expt-checked-pair
                        (h1-book-field-require (cdr typed-child) (library-integer before))))
         (typed-increment (h1-book-expt-checked-pair
                           (h1-book-field-require (cdr typed-before) (library-integer increment))))
         (addition (library-library-cite library "EXPT-ADD" (list x before increment)
                                         (list base-type base-nz (car typed-before) (car typed-increment))))
         (norm (h1-book-arithmetic-algebra-with-work (cdr typed-increment) 150))
         (aligned (h1-book-expt-checked-pair
                   (h1-book-arithmetic-algebra-equality norm (library-plus before increment) exponent)))
         (right (proof-proof-rewrite p addition (car aligned) '(1 1 2)))
         (right (if upward
                    right
                  (proof-with-checked-results
                      ((typed-y (h1-book-expt-checked-pair
                                 (h1-book-field-require (cdr aligned) (library-integer y))))
                       (inverse (library-library-cite library "EXPT-NEGATIVE-RECIPROCAL" (list x y)
                                                      (list base-type base-nz (car typed-y)))))
                    (proof-proof-rewrite p right inverse '(1 2 2)))))
         (left-value (h1-book-modulo-first-at left '(2)))
         (commute (library-library-axiom library "COMMUTATIVITY-OF-*" (cdr left-value)))
         (right-symmetric (h1-propositions-proof-symmetric p right))
         (consequence (proof-proof-chain p left (list commute right-symmetric))))
      (h1-propositions-propositional-proof-implies-from library formula consequence))))

(defun h1-book-expt-composition-composition (proof)
  (let* ((library (h1-tactics-prover-library proof))
         (p (h1-tactics-prover-proof proof))
         (x *library-x*)
         (y *library-y*)
         (z *library-z*)
         (inner (h1-book-expt-sum-power x y))
         (exponent (h1-book-order-product y z))
         (goal (proof-eq (h1-book-expt-sum-power inner z)
                         (h1-book-expt-sum-power x exponent)))
         (premise (proof-ite (library-integer y) (library-integer z) *proof-false*))
         (formula (list *library-implies* premise goal))
         (zip-z (list *h1-arithmetic-zip* z))
         (base-zero (h1-book-expt-sum-fixed-zero x))
         (tests (list (list premise t) (list base-zero nil))))
    (proof-with-checked-results
        ((norm (h1-book-field-field-normalizer proof (append tests (list (list zip-z t)))))
         (int-z (h1-book-expt-checked-pair (h1-book-field-require norm (library-integer z))))
         (zipped (h1-arithmetic-proof-assume p zip-z t))
         (zero-z (library-library-cite library "ZERO-FROM-ZIP" (list z) (list (car int-z) zipped)))
         (left (h1-book-expt-sum-power-at-zero proof inner zero-z))
         (product-zero (h1-book-expt-composition-product-at-zero proof y z zero-z 2))
         (right (h1-book-expt-sum-power-at-zero proof x product-zero))
         (right-symmetric (h1-propositions-proof-symmetric p right))
         (identity (proof-proof-chain p left (list right-symmetric)))
         (at-zero (h1-propositions-propositional-proof-implies-from library formula identity))
         (plan (h1-book-expt-checked-pair (h1-book-expt-signed-countdowns proof z)))
         (measure (caar plan))
         (countdowns (cadar plan))
         (proof (cdr plan))
         (library (h1-tactics-prover-library proof))
         (p (h1-tactics-prover-proof proof))
         (upward (h1-book-expt-composition-composition-branch proof inner exponent formula zip-z tests
                                                             t (car countdowns)))
         (downward (h1-book-expt-composition-composition-branch proof inner exponent formula zip-z tests
                                                               nil (cadr countdowns)))
         (norm (h1-book-field-field-normalizer proof (list (list premise t) (list base-zero t))))
         (at-zero-base (h1-book-expt-composition-composition-at-zero-base proof norm))
         (zero-case (h1-propositions-propositional-proof-implies-from library formula (car at-zero-base)))
         (nonzero-exponent (proof-proof-cases p (library-positive z) upward downward))
         (regular (proof-proof-cases p zip-z at-zero nonzero-exponent))
         (step (proof-proof-cases p base-zero zero-case regular))
         (ordinal (descent-measure-ordinal library measure))
         (induction (proof-proof-induct p ordinal step formula measure
                                        (list (caar countdowns) (caadr countdowns)))))
      (cons induction proof))))

(defun h1-book-expt-composition-install-power-composition (proof)
  (let ((x *library-x*)
        (y *library-y*)
        (z *library-z*))
    (proof-with-checked-results
        ((zip-negation (h1-book-expt-composition-zip-negation proof))
         (helper (h1-tactics-prover-helper proof "ZIP-NEGATION" zip-negation nil nil))
         (proof (cdr helper))
         (commutation (proof-eq (h1-book-field-reciprocal (h1-book-expt-sum-power x y))
                                (h1-book-expt-sum-power (h1-book-field-reciprocal x) y)))
         (equality (h1-book-expt-checked-pair (h1-book-expt-power-equality proof commutation)))
         (recorded (h1-book-modulo-record-formula (cdr equality) "EXPT-RECIPROCAL-BASE" (car equality)))
         (equal-reciprocal (car recorded))
         (proof (h1-book-expt-composition-install-inverse-exponent (cdr recorded)))
         (negation (h1-book-expt-composition-negate-exponent proof equal-reciprocal))
         (recorded (h1-book-modulo-record-formula proof "EXPT-NEGATE-EXPONENT" negation))
         (proof (cdr recorded))
         (p (h1-tactics-prover-proof proof))
         (product-exponent (h1-book-order-product y z))
         (instance (proof-proof-instantiate p (car recorded) (list (list y product-exponent))))
         (norm (h1-book-field-field-normalizer proof nil))
         (normalized (h1-book-expt-checked-pair
                      (h1-book-arithmetic-algebra-equality norm (library-minus product-exponent)
                                                           (h1-book-order-product (library-minus y) z))))
         (opposite-product (proof-proof-rewrite p instance (car normalized) '(1 1 2)))
         (symmetric (h1-propositions-proof-symmetric p opposite-product))
         (recorded (h1-book-modulo-record-formula proof "EXPT-NEGATE-FACTOR" symmetric))
         (composition (h1-book-expt-composition-composition (cdr recorded)))
         (recorded (h1-book-modulo-record-formula (cdr composition) "EXPT-COMPOSITION" (car composition))))
      (cdr recorded))))
