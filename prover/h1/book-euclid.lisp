(in-package "BOYMOO-PROVER")
(set-verify-guards-eagerness 0)

(defconst *h1-book-euclid-gcd* '("sym" "ACL2" "NONNEG-INT-GCD"))
(defconst *h1-book-euclid-multiplier1* '("sym" "ACL2" "NONNEG-INT-GCD-MULTIPLIER1"))
(defconst *h1-book-euclid-multiplier2* '("sym" "ACL2" "NONNEG-INT-GCD-MULTIPLIER2"))

(defun h1-book-euclid-gcd-positive-base (stop proof equation either-positive signed)
  (let ((library (h1-tactics-prover-library proof))
        (p (h1-tactics-prover-proof proof))
        (x *library-x*)
        (y *library-y*))
    (proof-with-checked-results
        ((value (h1-propositions-select-value library equation stop))
         (relation (library-library-cite library "ZP-IS-NOT-POSP" (list y) nil))
         (not-pos-y (proof-proof-rewrite p stop relation '(1)))
         (assumed (h1-arithmetic-proof-assume p either-positive t))
         (positive-x (h1-propositions-proof-prove-if p assumed not-pos-y))
         (parts (h1-book-cofactors-positive-parts proof positive-x))
         (natural (h1-book-modulo-natural-from-positive proof (car parts) (cadr parts)))
         (fixed (h1-book-modulo-fix-value proof x natural))
         (exact (proof-proof-chain p value (list fixed)))
         (positive-gcd (h1-propositions-library-transport-argument library (cadr parts) exact 2)))
      (h1-propositions-propositional-proof-implies-from library signed positive-gcd))))

(defun h1-book-euclid-gcd-positive-advance (test induction proof equation signed)
  (let ((library (h1-tactics-prover-library proof))
        (p (h1-tactics-prover-proof proof)))
    (proof-with-checked-results
        ((value (h1-propositions-select-value library equation test))
         (choice (h1-book-modulo-first-at induction '(1)))
         (positive-y (h1-book-modulo-positive-divisor proof *library-y* test))
         (test-term (proof-term-at choice 1))
         (is-positive (h1-arithmetic-proof-assume p test-term t))
         (is-other (h1-arithmetic-proof-assume p test-term nil))
         (positive-select (h1-propositions-propositional-proof-select library choice is-positive))
         (yes (h1-propositions-proof-transport p is-positive positive-select))
         (other-select (h1-propositions-propositional-proof-select library choice is-other))
         (no (h1-propositions-proof-transport p positive-y other-select))
         (premise (proof-proof-cases p test-term yes no))
         (child-sign (h1-propositions-propositional-proof-modus-ponens library induction premise))
         (parent-sign (h1-propositions-library-transport-argument library child-sign value 2)))
      (h1-propositions-propositional-proof-implies-from library signed parent-sign))))

(defun h1-book-euclid-bezout-open-at (test proof expansions polynomial)
  (let ((library (h1-tactics-prover-library proof))
        (p (h1-tactics-prover-proof proof)))
    (proof-with-checked-results
        ((g (h1-propositions-select-value library (car expansions) test))
         (a (h1-propositions-select-value library (cadr expansions) test))
         (b (h1-propositions-select-value library (caddr expansions) test))
         (identity (h1-propositions-propositional-proof-reflexive library polynomial))
         (reduced (proof-proof-rewrite p identity a '(1 2 1 2)))
         (rhs (proof-proof-rewrite p reduced b '(1 2 2 2))))
      (list g a b rhs))))

(defun h1-book-euclid-bezout-base (stop proof expansions polynomial typed formula)
  (let ((library (h1-tactics-prover-library proof))
        (p (h1-tactics-prover-proof proof)))
    (proof-with-checked-results
        ((opened (h1-book-euclid-bezout-open-at stop proof expansions polynomial))
         (g (car opened))
         (a (cadr opened))
         (b (caddr opened))
         (rhs (cadddr opened))
         (norm (h1-book-field-field-normalizer proof nil))
         (norm (h1-book-field-remember norm typed))
         (right (h1-book-modulo-first-at rhs '(2)))
         (value (h1-book-modulo-first-at g '(2)))
         (aligned (h1-book-arithmetic-algebra-equality norm right value))
         (alignment (car aligned))
         (inverse (h1-propositions-proof-symmetric p alignment))
         (rhs-symmetric (h1-propositions-proof-symmetric p rhs))
         (equation (proof-proof-chain p g (list inverse rhs-symmetric)))
         (a-value (h1-book-modulo-first-at a '(2)))
         (a-type (library-library-type-of library a-value nil))
         (a-integral (h1-propositions-library-transport-argument library a-type a 1))
         (b-value (h1-book-modulo-first-at b '(2)))
         (b-type (library-library-type-of library b-value nil))
         (b-integral (h1-propositions-library-transport-argument library b-type b 1)))
      (h1-arithmetic-conjunction library formula (list a-integral b-integral equation)))))

(defun h1-book-euclid-bezout-advance
    (test induction proof expansions polynomial typed quotient remainder formula)
  (let ((library (h1-tactics-prover-library proof))
        (p (h1-tactics-prover-proof proof))
        (x *library-x*)
        (y *library-y*))
    (proof-with-checked-results
        ((opened (h1-book-euclid-bezout-open-at test proof expansions polynomial))
         (g (car opened))
         (a (cadr opened))
         (b (caddr opened))
         (rhs (cadddr opened))
         (parts (h1-book-cofactors-components proof induction))
         (parts (proof-list-of-length parts 3))
         (integral-u (car parts))
         (integral-v (cadr parts))
         (child-eq (caddr parts))
         (q-nat (library-library-cite library "QUOTIENT-NATURAL" (list x y) nil))
         (integer-q (library-library-cite library "NATURAL-INTEGER" (list quotient) (list q-nat)))
         (b-value (h1-book-modulo-first-at b '(2)))
         (new-v (library-library-type-of library b-value (list integral-u integral-v integer-q)))
         (a-integral (h1-propositions-library-transport-argument library integral-v a 1))
         (b-integral (h1-propositions-library-transport-argument library new-v b 1))

         (r-nat (library-library-cite library "REMAINDER-NATURAL" (list x y) nil))
         (r-type (library-library-cite library "NATURAL-INTEGER" (list remainder) (list r-nat)))
         (norm (h1-book-field-field-normalizer proof nil))
         (norm (h1-book-field-remember norm (append typed (list integral-u integral-v integer-q r-type))))
         (division (library-library-cite library "QUOTIENT-REMAINDER-IDENTITY" (list x y) nil))
         (total (h1-book-modulo-first-at division '(1)))
         (extracted (proof-term-at total 2))
         (normalized (h1-book-arithmetic-algebra-equality norm remainder (library-diff total extracted)))
         (raw-difference (car normalized))
         (difference (proof-proof-rewrite p raw-difference division '(1 2 1)))
         (left (proof-proof-chain p g (list child-eq)))
         (fixed (h1-book-modulo-fix-value proof remainder r-nat))
         (left (proof-proof-rewrite p left fixed '(1 2 2 1)))
         (left (proof-proof-rewrite p left difference '(1 2 2 1)))
         (norm (h1-book-arithmetic-algebra-with-work (cdr normalized) 150))
         (left-value (h1-book-modulo-first-at left '(2)))
         (right-value (h1-book-modulo-first-at rhs '(2)))
         (normalized (h1-book-arithmetic-algebra-equality norm left-value right-value))
         (aligned (car normalized))
         (rhs-symmetric (h1-propositions-proof-symmetric p rhs))
         (equality (proof-proof-chain p left (list aligned rhs-symmetric))))
      (h1-arithmetic-conjunction library formula (list a-integral b-integral equality)))))

(defun h1-book-euclid-euclidean-induction (proof formula base recursive)
  (let* ((library (h1-tactics-prover-library proof))
         (p (h1-tactics-prover-proof proof))
         (x *library-x*)
         (y *library-y*)
         (divisor-test (list *h1-arithmetic-zp* y))
         (child (list *h1-book-modulo-mod* x y))
         (bindings (list (list x y) (list y child))))
    (proof-with-checked-results
        ((descent (h1-book-modulo-bounded-decrease proof y child (list (list divisor-test nil))))
         (decrease (proof-step-first descent))
         (child-formula (proof-subst formula (list (cons x y) (cons y child))))
         (hypothesis (proof-ite decrease child-formula *proof-true*))
         (assumed (h1-arithmetic-proof-assume p hypothesis t))
         (given (h1-propositions-proof-prove-if p assumed descent))
         (stop (h1-arithmetic-proof-assume p divisor-test t))
         (initial (case (car base)
                    (:gcd-positive
                     (h1-book-euclid-gcd-positive-base stop proof (cadr base) (caddr base) formula))
                    (:bezout
                     (h1-book-euclid-bezout-base
                      stop proof (cadr base) (caddr base) (cadddr base) formula))
                    (otherwise '(:failure "failure" ""))))
         (test (h1-arithmetic-proof-assume p divisor-test nil))
         (advanced (case (car recursive)
                     (:gcd-positive
                      (h1-book-euclid-gcd-positive-advance test given proof (cadr recursive) formula))
                     (:bezout
                      (h1-book-euclid-bezout-advance
                       test given proof (cadr recursive) (caddr recursive) (cadddr recursive)
                       (nth 4 recursive) (nth 5 recursive) formula))
                     (otherwise '(:failure "failure" ""))))
         (step (proof-proof-cases p divisor-test initial advanced))
         (ordinal (library-library-cite library "NFIX-ORDINAL" (list y) nil)))
      (proof-proof-induct p ordinal step formula (list *library-nfix* y) (list bindings)))))

(defun h1-book-euclid-gcd-positive (proof)
  (let* ((gcd (list *h1-book-euclid-gcd* *library-x* *library-y*))
         (pos-x (list *h1-book-cofactors-posp* *library-x*))
         (pos-y (list *h1-book-cofactors-posp* *library-y*))
         (either-positive (proof-ite pos-y pos-y pos-x))
         (signed (list *library-implies* either-positive (library-positive gcd))))
    (proof-with-checked-results
        ((equation (proof-proof-unfold (h1-tactics-prover-proof proof) gcd)))
      (h1-book-euclid-euclidean-induction proof signed
                                        (list :gcd-positive equation either-positive)
                                        (list :gcd-positive equation)))))

(defun h1-book-euclid-install-gcd (proof)
  (let ((p (h1-tactics-prover-proof proof)))
    (proof-with-checked-results
        ((signed (h1-book-euclid-gcd-positive proof))
         (pos-y (proof-proof-unfold p (list *h1-book-cofactors-posp* *library-y*)))
         (pos-x (proof-proof-unfold p (list *h1-book-cofactors-posp* *library-x*)))
         (signed (proof-proof-rewrite p signed pos-y '(1 1 1)))
         (signed (proof-proof-rewrite p signed pos-y '(1 1 2)))
         (signed (proof-proof-rewrite p signed pos-x '(1 1 3)))
         (recorded (h1-book-modulo-record-formula proof "GCD-POSITIVE" signed)))
      (cdr recorded))))

(defun h1-book-euclid-bezout (proof)
  (let* ((library (h1-tactics-prover-library proof))
         (p (h1-tactics-prover-proof proof))
         (x *library-x*)
         (y *library-y*)
         (gcd (list *h1-book-euclid-gcd* x y))
         (first (list *h1-book-euclid-multiplier1* x y))
         (second (list *h1-book-euclid-multiplier2* x y))
         (fixed-x (list *h1-book-modulo-fix* x))
         (fixed-y (list *h1-book-modulo-fix* y))
         (remainder (list *h1-book-modulo-mod* x y))
         (quotient (list *h1-book-modulo-quotient* x y))
         (polynomial (library-plus (h1-book-order-product fixed-x first)
                                   (h1-book-order-product fixed-y second)))
         (identity (proof-eq gcd polynomial)))
    (proof-with-checked-results
        ((formula (h1-book-cofactors-combine
                   (list (library-integer first) (library-integer second) identity)))
         (g-equation (proof-proof-unfold p gcd))
         (first-equation (proof-proof-unfold p first))
         (second-equation (proof-proof-unfold p second))
         (nat-x (library-library-cite library "ACL2-NFIX-NATURAL" (list x) nil))
         (nat-y (library-library-cite library "ACL2-NFIX-NATURAL" (list y) nil))
         (x-types (h1-book-modulo-fixed-natural proof fixed-x nat-x))
         (y-types (h1-book-modulo-fixed-natural proof fixed-y nat-y)))
      (let ((expansions (list g-equation first-equation second-equation))
            (typed (list (car x-types) (car y-types))))
        (h1-book-euclid-euclidean-induction
         proof formula (list :bezout expansions polynomial typed)
         (list :bezout expansions polynomial typed quotient remainder))))))

(defun h1-book-euclid-install-bezout (proof)
  (proof-with-checked-results
      ((invariant (h1-book-euclid-bezout proof))
       (proof (h1-book-modulo-lemma proof "GCD-LINEAR-COMBINATION-INVARIANT" invariant nil))
       (library (h1-tactics-prover-library proof))
       (instance (library-library-cite library "GCD-LINEAR-COMBINATION-INVARIANT"
                                       (list *library-x* *library-y*) nil))
       (parts (h1-book-cofactors-components proof instance))
       (parts (proof-list-of-length parts 3))
       (recorded (h1-book-modulo-record-formula proof "GCD-LINEAR-COMBINATION" (caddr parts))))
    (cdr recorded)))
