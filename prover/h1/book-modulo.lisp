(in-package "BOYMOO-PROVER")
(set-verify-guards-eagerness 0)

(defconst *h1-book-modulo-fix* '("sym" "ACL2" "NFIX"))
(defconst *h1-book-modulo-ifix* '("sym" "ACL2" "IFIX"))
(defconst *h1-book-modulo-mod* '("sym" "ACL2" "NONNEG-INT-MOD"))
(defconst *h1-book-modulo-quotient* '("sym" "ACL2" "NONNEGATIVE-INTEGER-QUOTIENT"))

(defun h1-book-modulo-first-at (step place)
  (proof-with-checked-results ((literal (proof-step-first step)))
    (h1-book-arithmetic-at literal place)))

(defun h1-book-modulo-lemma (proof name step conditions)
  (proof-with-checked-results
      ((claim (proof-step-first step))
       (library (library-library-lemma (h1-tactics-prover-library proof)
                                      name claim step conditions)))
    (h1-tactics-prover-with-library proof library)))

(defun h1-book-modulo-record-formula (proof label step)
  (h1-tactics-prover-record-formula proof label step nil))

(defun h1-book-modulo-fixed-natural (proof term natural)
  (let ((library (h1-tactics-prover-library proof)))
    (proof-with-checked-results
        ((shown (library-library-cite library "NATURAL-INTEGER" (list term) (list natural)))
         (nonnegative (library-library-cite library "NATURAL-NONNEGATIVE" (list term)
                                             (list natural))))
      (list shown nonnegative))))

(defun h1-book-modulo-natural-from-positive (proof integral sign)
  (let ((library (h1-tactics-prover-library proof)))
    (proof-with-checked-results
        ((term (h1-book-modulo-first-at integral '(1)))
         (nonnegative (library-library-cite library "POSITIVE-NONNEGATIVE" (list term)
                                             (list integral sign))))
      (library-library-cite library "NATURAL-FROM-BOUNDS" (list term)
                            (list integral nonnegative)))))

(defun h1-book-modulo-fix-value (proof term natural)
  (let ((library (h1-tactics-prover-library proof))
        (p (h1-tactics-prover-proof proof)))
    (proof-with-checked-results
        ((equation (proof-proof-unfold p (list *h1-book-modulo-fix* term)))
         (test (proof-proof-unfold p (list *library-natp* term)))
         (literal (proof-step-first natural))
         (left (h1-book-modulo-first-at test '(1)))
         (evidence (proof-proof-rewrite p natural test
                                        (if (equal literal left) '(1) '(1 1)))))
      (h1-propositions-select-value library equation evidence))))

(defun h1-book-modulo-ifix-value (proof term integral)
  (proof-with-checked-results
      ((equation (proof-proof-unfold (h1-tactics-prover-proof proof)
                                     (list *h1-book-modulo-ifix* term))))
    (h1-propositions-select-value (h1-tactics-prover-library proof) equation integral)))

(defun h1-book-modulo-positive-divisor (proof term not-zp)
  (let ((library (h1-tactics-prover-library proof))
        (p (h1-tactics-prover-proof proof))
        (test (list *h1-book-cofactors-posp* term)))
    (proof-with-checked-results
        ((relation (library-library-cite library "ZP-IS-NOT-POSP" (list term) nil))
         (double-negative (proof-proof-rewrite p not-zp relation '(1 1)))
         (assumed (h1-arithmetic-proof-assume p test nil))
         (cut (proof-proof-cut p assumed double-negative)))
      (proof-proof-front p cut test))))

(defun h1-book-modulo-subtraction-conditions (before amount)
  (list (list (list *h1-arithmetic-zp* amount) nil)
        (list (library-lt (list *h1-book-modulo-fix* before) amount) nil)))

(defun h1-book-modulo-subtraction-facts (proof before amount not-zp enough)
  (let ((library (h1-tactics-prover-library proof))
        (p (h1-tactics-prover-proof proof)))
    (proof-with-checked-results
        ((positive-amount (h1-book-modulo-positive-divisor proof amount not-zp))
         (parts (h1-book-cofactors-positive-parts proof positive-amount)))
      (let ((integral (car parts))
            (sign (cadr parts))
            (parent-test (list *library-natp* before))
            (difference (library-diff before amount)))
        (proof-with-checked-results
            ((assumed (h1-arithmetic-proof-assume p parent-test nil))
             (default (h1-book-modulo-fix-value proof before assumed))
             (impossible (proof-proof-rewrite p enough default '(1 1 1)))
             (cut (proof-proof-cut p sign impossible))
             (parent (proof-proof-front p cut parent-test))
             (fixed (h1-book-modulo-fix-value proof before parent))
             (enough (proof-proof-rewrite p enough fixed '(1 1 1)))
             (at-zero (library-library-axiom library "<-ON-OTHERS" (list before amount)))
             (nonnegative (proof-proof-rewrite p enough at-zero '(1 1)))
             (parent-integral (library-library-cite library "NATURAL-INTEGER"
                                                     (list before) (list parent)))
             (typed (library-library-type-of library difference (list parent-integral integral)))
             (child (library-library-cite library "NATURAL-FROM-BOUNDS"
                                           (list difference) (list typed nonnegative))))
          (list parent child positive-amount enough))))))

(defun h1-book-modulo-subtraction-decreases (proof before amount not-zp enough)
  (let ((library (h1-tactics-prover-library proof))
        (p (h1-tactics-prover-proof proof)))
    (proof-with-checked-results
        ((facts (h1-book-modulo-subtraction-facts proof before amount not-zp enough))
         (parts (h1-book-cofactors-positive-parts proof (caddr facts)))
         (typed-parent (library-library-cite library "NATURAL-INTEGER" (list before)
                                             (list (car facts))))
         (typed-zero (library-library-type-of library *proof-zero* nil))
         (positive-parent (library-library-cite library "LESS-THEN-WEAK"
                                                 (list *proof-zero* amount before)
                                                 (list typed-zero (car parts) typed-parent
                                                       (cadr parts) (cadddr facts)))))
      (let ((after (library-diff before amount)))
        (proof-with-checked-results
            ((typed-child (library-library-cite library "NATURAL-INTEGER" (list after)
                                                (list (cadr facts))))
             (norm (h1-book-field-field-normalizer proof nil))
             (norm (h1-book-field-remember norm (list typed-child typed-parent (car parts))))
             (comparison (h1-book-order-by-difference proof (library-lt after before)
                                                        (library-positive amount) norm))
             (comparison-step (car comparison))
             (closer (h1-propositions-proof-transport p (cadr parts) comparison-step)))
          (library-library-cite library "NFIX-DECREASE" (list after before)
                                (list typed-child typed-parent positive-parent closer)))))))

(defund h1-book-modulo-natural-reduction (p term)
  (if (equal term *proof-true*)
      (proof-proof-prove p term nil nil)
    (proof-with-checked-results
        ((equality (h1-propositions-proof-simplify p term nil (list *library-natp* *proof-not*)))
         (right (and equality (h1-book-modulo-first-at equality '(2)))))
      (cond ((or (not equality) (equal term right)) '(:failure "failure" ""))
            ((equal right *proof-true*) (proof-proof-true-from-eq p equality))
            (t (list :transport right equality))))))

(defun h1-book-modulo-prove-natural (n p term)
  (declare (xargs :measure (nfix n)))
  (if (zp n)
      '(:failure "fuel" "h1-book-modulo-prove-natural")
    (let ((result (h1-book-modulo-natural-reduction p term)))
      (if (eq (car result) :transport)
          (proof-with-checked-results
              ((step (h1-book-modulo-prove-natural (1- n) p (cadr result))))
            (h1-propositions-proof-transport p step (caddr result)))
        result))))

(defun h1-book-modulo-natural (library term)
  (h1-book-modulo-prove-natural 1000000 (library-library-proof library)
                               (list *library-natp* term)))

(defun h1-book-modulo-rational (library term evidence)
  (proof-with-checked-results
      ((axiom (library-library-axiom library "INTEGER-IMPLIES-RATIONAL" (list term)))
       (typed (library-library-type-of library term evidence)))
    (h1-propositions-propositional-proof-modus-ponens library axiom typed)))

(defun h1-book-modulo-install-subtraction (proof)
  (let ((zp (list *h1-arithmetic-zp* *library-x*))
        (natural (list *library-natp* *library-x*)))
    (proof-with-checked-results
        ((relation (h1-tactics-prover-solve
                    proof (proof-eq zp (proof-neg (list *h1-book-cofactors-posp* *library-x*)))
                    (list *h1-arithmetic-zp* *h1-book-cofactors-posp*) 160))
         (proof (h1-book-modulo-lemma proof "ZP-IS-NOT-POSP" relation nil))
         (library (h1-tactics-prover-library proof))
         (p (h1-tactics-prover-proof proof))
         (assumed (h1-arithmetic-proof-assume p natural t))
         (exact (h1-book-modulo-fix-value proof *library-x* assumed))
         (denied (h1-arithmetic-proof-assume p natural nil))
         (default (h1-book-modulo-fix-value proof *library-x* denied))
         (assumed (h1-arithmetic-proof-assume p natural t))
         (exact-nat (h1-propositions-library-transport-argument library assumed exact 1))
         (zero-nat (h1-book-modulo-natural library *proof-zero*))
         (default-nat (h1-propositions-library-transport-argument library zero-nat default 1))
         (fixed (proof-proof-cases p natural exact-nat default-nat))
         (proof (h1-book-modulo-lemma proof "ACL2-NFIX-NATURAL" fixed nil))
         (library (h1-tactics-prover-library proof))
         (p (h1-tactics-prover-proof proof))
         (assumed (h1-arithmetic-proof-assume p natural t))
         (evidence (h1-book-modulo-fixed-natural proof *library-x* assumed))
         (assumed-zp (h1-arithmetic-proof-assume p zp t))
         (unfolded-zp (proof-proof-unfold p zp))
         (opened-zp (proof-proof-rewrite p assumed-zp unfolded-zp '(1)))
         (nonpositive (h1-propositions-proof-prove-if p opened-zp (car evidence)))
         (rational (h1-book-modulo-rational library *library-x* (list (car evidence))))
         (zero (library-library-cite library "ORDER-ZERO" (list *library-x*)
                                     (list rational nonpositive (cadr evidence))))
         (exact-zero (proof-proof-chain p exact (list zero)))
         (fixed-zero (proof-proof-cases p natural exact-zero default))
         (proof (h1-book-modulo-lemma proof "ACL2-NFIX-WHEN-ZP" fixed-zero (list (proof-neg zp)))))
      (let* ((conditions (h1-book-modulo-subtraction-conditions *library-x* *library-y*))
             (divisor (caar conditions))
             (boundary (caadr conditions))
             (p (h1-tactics-prover-proof proof)))
        (proof-with-checked-results
            ((not-zp (h1-arithmetic-proof-assume p divisor nil))
             (enough (h1-arithmetic-proof-assume p boundary nil))
             (decreases (h1-book-modulo-subtraction-decreases
                         proof *library-x* *library-y* not-zp enough)))
          (h1-book-modulo-lemma proof "SUBTRACTION-DECREASE" decreases
                                (list divisor boundary)))))))

(defun h1-book-modulo-subtraction-amount (before after tests)
  (if (proof-is-call after *proof-plus*)
      (proof-with-checked-results ((left (proof-term-at after 1)))
        (if (equal left before)
            (proof-with-checked-results ((right (proof-term-at after 2)))
              (if (proof-is-call right *proof-minus*)
                  (proof-with-checked-results ((amount (proof-term-at right 1)))
                    (let ((conditions (h1-book-modulo-subtraction-conditions before amount)))
                      (if (and (member-equal (car conditions) tests)
                               (member-equal (cadr conditions) tests))
                          amount
                        :none)))
                :none))
          :none))
    :none))

(defun h1-book-modulo-bounded-remainder (before after tests)
  (and (proof-is-call after *h1-book-modulo-mod*)
       (proof-with-checked-results ((divisor (proof-term-at after 2)))
         (and (equal divisor before)
              (if (member-equal (list (list *h1-arithmetic-zp* before) nil) tests)
                  t
                nil)))))

(defun h1-book-modulo-bounded-decrease (proof before after tests)
  (let ((library (h1-tactics-prover-library proof))
        (p (h1-tactics-prover-proof proof)))
    (proof-with-checked-results ((amount (h1-book-modulo-subtraction-amount before after tests)))
      (if (not (eq amount :none))
          (let ((conditions (h1-book-modulo-subtraction-conditions before amount)))
            (proof-with-checked-results
                ((divisor (h1-arithmetic-proof-assume p (caar conditions) (cadar conditions)))
                 (boundary (h1-arithmetic-proof-assume p (caadr conditions) (cadadr conditions))))
              (library-library-cite library "SUBTRACTION-DECREASE" (list before amount)
                                    (list divisor boundary))))
        (proof-with-checked-results ((bounded (h1-book-modulo-bounded-remainder before after tests)))
          (if (not bounded)
              nil
            (proof-with-checked-results
                ((not-zp (h1-arithmetic-proof-assume p (list *h1-arithmetic-zp* before) nil))
                 (divisor (h1-book-modulo-positive-divisor proof before not-zp))
                 (parts (h1-book-cofactors-positive-parts proof divisor))
                 (smaller (library-library-cite library "REMAINDER-BOUNDED" (cdr after)
                                               (list divisor)))
                 (natural (library-library-cite library "REMAINDER-NATURAL" (cdr after) nil))
                 (typed (library-library-cite library "NATURAL-INTEGER" (list after)
                                               (list natural))))
              (library-library-cite library "NFIX-DECREASE" (list after before)
                                    (list typed (car parts) (cadr parts) smaller)))))))))

(defun h1-book-modulo-ifix-inside (proof dividend divisor bound sign typed-divisor)
  (let ((library (h1-tactics-prover-library proof))
        (p (h1-tactics-prover-proof proof))
        (nat (list *library-natp* dividend))
        (typed (library-integer dividend))
        (below-zero (library-lt dividend *proof-zero*)))
    (proof-with-checked-results
        ((natural (h1-arithmetic-proof-assume p nat t))
         (fixed-facts (h1-book-modulo-fixed-natural proof dividend natural))
         (ifixed (h1-book-modulo-ifix-value proof dividend (car fixed-facts)))
         (fixed (h1-book-modulo-fix-value proof dividend natural))
         (fixed-symmetric (h1-propositions-proof-symmetric p fixed))
         (exact (proof-proof-chain p ifixed (list fixed-symmetric)))
         (yes (h1-propositions-library-transport-argument library bound exact 1))
         (integral (h1-arithmetic-proof-assume p typed t))
         (definition (proof-proof-unfold p nat))
         (value (h1-book-modulo-first-at definition '(2)))
         (selected (h1-propositions-propositional-proof-select library value integral))
         (shape (proof-proof-chain p definition (list selected)))
         (not-nat (h1-arithmetic-proof-assume p nat nil))
         (double-negative (proof-proof-rewrite p not-nat shape '(1 1)))
         (not-below-zero (h1-arithmetic-proof-assume p below-zero nil))
         (cut (proof-proof-cut p not-below-zero double-negative))
         (negative (proof-proof-front p cut below-zero))
         (typed-zero (library-library-type-of library *proof-zero* nil))
         (below-divisor (library-library-cite library "LESS-TRANSITIVE"
                                              (list dividend *proof-zero* divisor)
                                              (list integral typed-zero typed-divisor negative sign)))
         (exact-ifix (h1-book-modulo-ifix-value proof dividend integral))
         (int-below (h1-propositions-library-transport-argument library below-divisor exact-ifix 1))
         (not-integral (h1-arithmetic-proof-assume p typed nil))
         (default-ifix (h1-book-modulo-ifix-value proof dividend not-integral))
         (default-below (h1-propositions-library-transport-argument library sign default-ifix 1))
         (other (proof-proof-cases p typed int-below default-below)))
      (proof-proof-cases p nat yes other))))

(defun h1-book-modulo-open-quotient
    (proof dividend divisor divisor-fixed divisor-type ifix-bound)
  (let ((library (h1-tactics-prover-library proof))
        (p (h1-tactics-prover-proof proof)))
    (proof-with-checked-results
        ((equation (proof-proof-unfold p (list *h1-book-modulo-quotient* dividend divisor)))
         (test (h1-book-modulo-first-at equation '(2 1)))
         (parts (h1-book-cofactors-positive-parts proof divisor-type))
         (zero-call (proof-term-at test 1))
         (zero-test (proof-proof-unfold p zero-call))
         (zero-test (proof-proof-rewrite p zero-test divisor-fixed '(1 2 1)))
         (nonzero (h1-book-order-nonzero-from-sign proof (cadr parts) divisor))
         (false-equation (h1-tactics-prover-false-equation proof nonzero))
         (no-zero (proof-proof-chain p zero-test (list false-equation)))
         (computed (h1-propositions-computed-test library no-zero))
         (comparison (h1-propositions-propositional-proof-select library test computed))
         (bound (proof-step-first ifix-bound))
         (right (h1-book-modulo-first-at comparison '(2)))
         (stop (if (equal bound right)
                   (h1-propositions-proof-transport p ifix-bound comparison)
                 (h1-propositions-library-transport-argument library ifix-bound comparison 1))))
      (h1-propositions-select-value library equation stop))))

(defun h1-book-modulo-quotient-at-zero-divisor (proof dividend divisor divisor-is-zero)
  (let ((library (h1-tactics-prover-library proof))
        (p (h1-tactics-prover-proof proof)))
    (proof-with-checked-results
        ((equation (proof-proof-unfold p (list *h1-book-modulo-quotient* dividend divisor)))
         (branch (h1-book-modulo-first-at equation '(2 1)))
         (zero-call (proof-term-at branch 1))
         (zero-test (proof-proof-unfold p zero-call))
         (reduced (proof-proof-rewrite p zero-test divisor-is-zero '(1 2 1)))
         (right (h1-book-modulo-first-at reduced '(2)))
         (constant (h1-tactics-prover-constant proof right))
         (computed (proof-proof-chain p reduced (list constant)))
         (numeric (h1-propositions-computed-test library computed))
         (selected (h1-propositions-propositional-proof-select library branch numeric))
         (test (h1-propositions-proof-transport p numeric selected)))
      (h1-propositions-select-value library equation test))))

(defun h1-book-modulo-remainder-spec (remainder)
  (if (integerp remainder)
      (proof-term-at remainder 1)
    (proof-with-checked-results
        ((arguments (proof-list-of-length (cdr remainder) 2)))
      (let* ((dividend (car arguments))
             (divisor (cadr arguments))
             (divisor-type (list *h1-book-cofactors-posp* divisor))
             (quotient (list *h1-book-modulo-quotient* dividend divisor))
             (identity
              (proof-eq
               (library-plus remainder
                             (h1-book-order-product (list *h1-book-modulo-fix* divisor)
                                                    quotient))
               (list *h1-book-modulo-fix* dividend))))
        (list (list *library-natp* remainder)
              (list *library-natp* quotient)
              (list *library-implies* divisor-type (library-lt remainder divisor))
              identity)))))

(defun h1-book-modulo-prove-remainder-reconstruct
    (remainder-eq quotient-eq norm proof identity)
  (let ((library (h1-tactics-prover-library proof))
        (p (h1-tactics-prover-proof proof)))
    (proof-with-checked-results
        ((zero (library-library-axiom library "H1-PRODUCT-ZERO"
                                      (list (list *h1-book-modulo-fix* *library-y*))))
         (quotient-symmetric (h1-propositions-proof-symmetric p quotient-eq))
         (product-eq (proof-proof-rewrite p zero quotient-symmetric '(1 1 2)))
         (step (h1-propositions-propositional-proof-reflexive library (cadr identity)))
         (step (proof-proof-rewrite p step remainder-eq '(1 2 1)))
         (step (proof-proof-rewrite p step product-eq '(1 2 2)))
         (right (h1-book-modulo-first-at step '(2)))
         (normalized (h1-book-arithmetic-algebra-equality norm right (caddr identity)))
         (alignment (car normalized))
         (step (proof-proof-chain p step (list alignment))))
      (cons step (cdr normalized)))))

(defun h1-book-modulo-prove-remainder (proof)
  (let* ((library (h1-tactics-prover-library proof))
         (p (h1-tactics-prover-proof proof))
         (x *library-x*)
         (y *library-y*)
         (remainder (list *h1-book-modulo-mod* x y))
         (measure (list *library-nfix* x))
         (difference (library-diff x y))
         (bindings (list (list x difference)))
         (conditions (h1-book-modulo-subtraction-conditions x y))
         (zero (caar conditions))
         (inside (caadr conditions))
         (fixed-x (list *h1-book-modulo-fix* x))
         (fixed-y (list *h1-book-modulo-fix* y)))
    (proof-with-checked-results
        ((facts (h1-book-modulo-remainder-spec remainder))
         (bounded (caddr facts))
         (identity (cadddr facts))
         (formula (h1-book-cofactors-combine facts))
         (not-zp (h1-arithmetic-proof-assume p zero nil))
         (divisor-type (h1-book-modulo-positive-divisor proof y not-zp))
         (divisor-parts (h1-book-cofactors-positive-parts proof divisor-type))
         (typed-divisor (car divisor-parts))
         (sign (cadr divisor-parts))
         (divisor-nat (h1-book-modulo-natural-from-positive proof typed-divisor sign))
         (divisor-fixed (h1-book-modulo-fix-value proof y divisor-nat))
         (definition (proof-proof-unfold p remainder))
         (fixed-parent (library-library-cite library "ACL2-NFIX-NATURAL" (list x) nil))
         (assumed-zero (h1-arithmetic-proof-assume p zero t))
         (zero-divisor (library-library-cite library "ACL2-NFIX-WHEN-ZP" (list y)
                                            (list assumed-zero)))
         (assumed-zero (h1-arithmetic-proof-assume p zero t))
         (if-zero (h1-propositions-select-value library definition assumed-zero))
         (default-nat (h1-propositions-library-transport-argument library fixed-parent if-zero 1))
         (nat-zero (h1-book-modulo-natural library *proof-zero*))
         (zero-quotient (h1-book-modulo-quotient-at-zero-divisor proof x y zero-divisor))
         (default-quotient-nat
          (h1-propositions-library-transport-argument library nat-zero zero-quotient 1))
         (norm (h1-book-field-field-normalizer proof nil))
         (fixed-facts (h1-book-modulo-fixed-natural proof fixed-x fixed-parent))
         (norm (h1-book-field-remember norm fixed-facts))
         (first-result (h1-book-modulo-prove-remainder-reconstruct
                        if-zero zero-quotient norm proof identity))
         (first-identity (car first-result))
         (assumed-zero (h1-arithmetic-proof-assume p zero t))
         (relation (library-library-cite library "ZP-IS-NOT-POSP" (list y) nil))
         (not-positive (proof-proof-rewrite p assumed-zero relation '(1)))
         (assumed-bound (h1-arithmetic-proof-assume p (cadr bounded) t))
         (conflict (proof-proof-cut p assumed-bound not-positive))
         (consequence (proof-proof-subsume p conflict (cons (caddr bounded)
                                                           (proof-step-clause conflict))))
         (impossible-bound (h1-propositions-propositional-proof-implies-from
                            library bounded consequence))
         (base-zero (h1-arithmetic-conjunction
                     library formula
                     (list default-nat default-quotient-nat impossible-bound first-identity)))

         (regular (h1-propositions-select-value library definition not-zp))
         (compare (h1-arithmetic-proof-assume p inside t))
         (small-remainder (h1-propositions-select-value library regular compare))
         (ifix-bound (h1-book-modulo-ifix-inside proof x y compare sign typed-divisor))
         (small-quotient (h1-book-modulo-open-quotient
                          proof x y divisor-fixed divisor-type ifix-bound))
         (norm (h1-book-arithmetic-algebra-with-work (cdr first-result) 150))
         (small-result (h1-book-modulo-prove-remainder-reconstruct
                        small-remainder small-quotient norm proof identity))
         (small-identity (car small-result))
         (small-less (h1-propositions-library-transport-argument library compare small-remainder 1))
         (small-bound (h1-propositions-propositional-proof-implies-from library bounded small-less))
         (small-nat (h1-propositions-library-transport-argument library fixed-parent small-remainder 1))
         (small-q-nat (h1-propositions-library-transport-argument library nat-zero small-quotient 1))
         (small (h1-arithmetic-conjunction library formula
                                           (list small-nat small-q-nat small-bound small-identity)))

         (enough (h1-arithmetic-proof-assume p inside nil))
         (subtraction (h1-book-modulo-subtraction-facts proof x y not-zp enough))
         (parent (car subtraction))
         (child (cadr subtraction))
         (at-least (cadddr subtraction))
         (step-down (library-library-cite library "SUBTRACTION-DECREASE" (list x y)
                                          (list not-zp enough)))
         (descent (proof-step-first step-down))
         (child-formula (proof-subst formula (list (cons x difference))))
         (hypothesis (proof-ite descent child-formula *proof-true*))
         (induction (h1-arithmetic-proof-assume p hypothesis t))
         (given (h1-propositions-proof-prove-if p induction step-down))
         (components (h1-book-cofactors-components proof given))
         (components (proof-list-of-length components 4))
         (ih-natural (car components))
         (ih-q-natural (cadr components))
         (ih-bounded (caddr components))
         (ih-identity (cadddr components))
         (recursive-remainder (h1-propositions-select-value library regular enough))
         (typed-x (library-library-cite library "NATURAL-INTEGER" (list x) (list parent)))
         (ifix-x (h1-book-modulo-ifix-value proof x typed-x))
         (ifix-symmetric (h1-propositions-proof-symmetric p ifix-x))
         (ifix-enough (proof-proof-rewrite p at-least ifix-symmetric '(1 1 1)))
         (recursive-quotient (h1-book-modulo-open-quotient
                              proof x y divisor-fixed divisor-type ifix-enough))
         (successor-term (h1-book-modulo-first-at recursive-quotient '(2)))
         (nat-one (h1-book-modulo-natural library *proof-one*))
         (successor (library-library-cite library "NATURAL-SUM" (cdr successor-term)
                                          (list nat-one ih-q-natural)))
         (quotient-natural (h1-propositions-library-transport-argument
                            library successor recursive-quotient 1))
         (parent-nat (h1-propositions-library-transport-argument
                      library ih-natural recursive-remainder 1))
         (assumed-bound (h1-arithmetic-proof-assume p (cadr bounded) t))
         (ih-less (h1-propositions-propositional-proof-modus-ponens library ih-bounded assumed-bound))
         (parent-less (h1-propositions-library-transport-argument library ih-less recursive-remainder 1))
         (parent-bound (h1-propositions-propositional-proof-implies-from library bounded parent-less))

         (norm (h1-book-field-field-normalizer proof nil))
         (fixed-divisor (library-library-cite library "ACL2-NFIX-NATURAL" (list y) nil))
         (child-remainder (h1-book-modulo-first-at ih-natural '(1)))
         (child-types (h1-book-modulo-fixed-natural proof child-remainder ih-natural))
         (divisor-types (h1-book-modulo-fixed-natural proof fixed-y fixed-divisor))
         (norm (h1-book-field-remember norm (append (list typed-x typed-divisor)
                                                   child-types divisor-types)))
         (start (h1-propositions-propositional-proof-reflexive library (cadr identity)))
         (start (proof-proof-rewrite p start recursive-remainder '(1 2 1)))
         (start (proof-proof-rewrite p start recursive-quotient '(1 2 2 2)))
         (ih-left (h1-book-modulo-first-at ih-identity '(1)))
         (regrouped (library-plus ih-left fixed-y))
         (start-right (h1-book-modulo-first-at start '(2)))
         (normalized (h1-book-arithmetic-algebra-equality norm start-right regrouped))
         (alignment (car normalized))
         (arranged (proof-proof-chain p start (list alignment)))
         (arranged (proof-proof-rewrite p arranged ih-identity '(1 2 1)))
         (fixed-diff (h1-book-modulo-fix-value proof difference child))
         (arranged (proof-proof-rewrite p arranged fixed-diff '(1 2 1)))
         (arranged (proof-proof-rewrite p arranged divisor-fixed '(1 2 2)))
         (norm (h1-book-arithmetic-algebra-with-work (cdr normalized) 150))
         (arranged-right (h1-book-modulo-first-at arranged '(2)))
         (normalized (h1-book-arithmetic-algebra-equality norm arranged-right x))
         (alignment (car normalized))
         (parent-fixed (h1-book-modulo-fix-value proof x parent))
         (parent-symmetric (h1-propositions-proof-symmetric p parent-fixed))
         (induction-eq (proof-proof-chain p arranged (list alignment parent-symmetric)))
         (recursive (h1-arithmetic-conjunction library formula
                                               (list parent-nat quotient-natural parent-bound induction-eq)))
         (nonzero-case (proof-proof-cases p inside small recursive))
         (step (proof-proof-cases p zero base-zero nonzero-case))
         (ordinal (library-library-cite library "NFIX-ORDINAL" (list x) nil)))
      (proof-proof-induct p ordinal step formula measure (list bindings)))))

(defun h1-book-modulo-install-small-remainders (proof)
  (let* ((x *library-x*)
         (y *library-y*)
         (remainder (list *h1-book-modulo-mod* x y))
         (test (list *h1-arithmetic-zp* y))
         (below (library-lt x y))
         (natural (list *library-natp* x)))
    (proof-with-checked-results
        ((library (h1-tactics-prover-library proof))
         (p (h1-tactics-prover-proof proof))
         (initial (proof-proof-unfold p remainder))
         (assumed-natural (h1-arithmetic-proof-assume p natural t))
         (shape (h1-book-modulo-fix-value proof x assumed-natural))
         (assumed-below (h1-arithmetic-proof-assume p below t))
         (small (h1-propositions-library-transport-argument library assumed-below shape 1))
         (assumed-test (h1-arithmetic-proof-assume p test t))
         (yes (h1-propositions-select-value library initial assumed-test))
         (denied-test (h1-arithmetic-proof-assume p test nil))
         (nonzero (h1-propositions-select-value library initial denied-test))
         (no (h1-propositions-select-value library nonzero small))
         (cases (proof-proof-cases p test yes no))
         (result (proof-proof-chain p cases (list shape)))
         (proof (h1-book-modulo-lemma proof "REMAINDER-BELOW-DIVISOR" result
                                    (list (proof-neg natural) (proof-neg below))))

         (library (h1-tactics-prover-library proof))
         (p (h1-tactics-prover-proof proof))
         (premise (h1-book-cofactors-combine (list (library-integer x) (library-positive x)
                                                  (proof-eq remainder *proof-zero*))))
         (formula (list *library-implies* premise (proof-neg below)))
         (assumption (h1-arithmetic-proof-assume p premise t))
         (parts (h1-book-cofactors-components proof assumption))
         (parts (proof-list-of-length parts 3))
         (natural-step (h1-book-modulo-natural-from-positive proof (car parts) (cadr parts)))
         (assumed-below (h1-arithmetic-proof-assume p below t))
         (exact (library-library-cite library "REMAINDER-BELOW-DIVISOR" (list x y)
                                     (list natural-step assumed-below)))
         (equation (proof-proof-rewrite p (caddr parts) exact '(1 1)))
         (nonzero (h1-book-order-nonzero-from-sign proof (cadr parts) x))
         (contradiction (proof-proof-cut p equation nonzero))
         (consequence (proof-proof-front p contradiction (proof-neg below)))
         (bound (h1-propositions-propositional-proof-implies-from library formula consequence))
         (recorded (h1-book-modulo-record-formula proof "DIVISOR-BOUND" bound))
         (proof (cdr recorded))

         (library (h1-tactics-prover-library proof))
         (p (h1-tactics-prover-proof proof))
         (mod-one (list *h1-book-modulo-mod* x *proof-one*))
         (natural-step (library-library-cite library "REMAINDER-NATURAL" (list x *proof-one*) nil))
         (facts (h1-book-modulo-fixed-natural proof mod-one natural-step))
         (one-positive (h1-tactics-prover-solve proof (list *h1-book-cofactors-posp* *proof-one*)
                                               (list *h1-book-cofactors-posp*) 160))
         (bound (library-library-cite library "REMAINDER-BOUNDED" (list x *proof-one*)
                                     (list one-positive)))
         (positive (library-positive mod-one))
         (assumed-positive (h1-arithmetic-proof-assume p positive t))
         (discrete (h1-arithmetic-discrete library (car facts) assumed-positive))
         (contradiction (proof-proof-cut p bound discrete))
         (nonpositive (proof-proof-front p contradiction (proof-neg positive)))
         (rational (h1-book-modulo-rational library mod-one (list (car facts))))
         (mod-one-zero (library-library-cite library "ORDER-ZERO" (list mod-one)
                                            (list rational nonpositive (cadr facts))))
         (recorded (h1-book-modulo-record-formula proof "REMAINDER-ONE" mod-one-zero)))
      (cdr recorded))))

(defun h1-book-modulo-install-remainder (proof)
  (let ((x *library-x*)
        (y *library-y*))
    (proof-with-checked-results
        ((invariant (h1-book-modulo-prove-remainder proof))
         (proof (h1-book-modulo-lemma proof "REMAINDER-INVARIANT" invariant nil))
         (library (h1-tactics-prover-library proof))
         (instance (library-library-cite library "REMAINDER-INVARIANT" (list x y) nil))
         (components (h1-book-cofactors-components proof instance))
         (components (proof-list-of-length components 4))
         (bounded (caddr components))
         (proof (h1-book-modulo-lemma proof "REMAINDER-NATURAL" (car components) nil))
         (proof (h1-book-modulo-lemma proof "QUOTIENT-NATURAL" (cadr components) nil))
         (library (h1-tactics-prover-library proof))
         (p (h1-tactics-prover-proof proof))
         (type-term (h1-book-modulo-first-at bounded '(1)))
         (divisor-type (h1-arithmetic-proof-assume p type-term t))
         (remainder-bound (h1-propositions-propositional-proof-modus-ponens library bounded divisor-type))
         (type-literal (proof-step-first divisor-type))
         (proof (h1-book-modulo-lemma proof "REMAINDER-BOUNDED" remainder-bound
                                    (list (proof-neg type-literal))))
         (p (h1-tactics-prover-proof proof))
         (bounds (proof-proof-unfold p type-term))
         (public-bound (proof-proof-rewrite p bounded bounds '(1 1)))
         (recorded (h1-book-modulo-record-formula proof "REMAINDER-BOUND" public-bound))
         (proof (cdr recorded))
         (recorded (h1-book-modulo-record-formula proof "QUOTIENT-REMAINDER-IDENTITY"
                                                (cadddr components)))
         (identity (car recorded))
         (proof (cdr recorded))
         (library (h1-tactics-prover-library proof))
         (p (h1-tactics-prover-proof proof))
         (coefficient (h1-book-modulo-first-at identity '(1 2)))
         (zero (proof-eq (list *h1-book-modulo-mod* x y) *proof-zero*))
         (assumed-zero (h1-arithmetic-proof-assume p zero t))
         (reduced (proof-proof-rewrite p identity assumed-zero '(1 1 1)))
         (norm (h1-book-field-field-normalizer proof nil))
         (left (h1-book-modulo-first-at reduced '(1)))
         (normalized (h1-book-arithmetic-algebra-equality norm coefficient left))
         (alignment (car normalized))
         (identity (proof-proof-chain p alignment (list reduced)))
         (claim (proof-step-first identity))
         (formula (list *library-implies* zero claim))
         (implied (h1-propositions-propositional-proof-implies-from library formula identity))
         (recorded (h1-book-modulo-record-formula proof "DIVISOR-QUOTIENT" implied)))
      (h1-book-modulo-install-small-remainders (cdr recorded)))))
