(in-package "BOYMOO-PROVER")
(set-verify-guards-eagerness 0)

(defconst *h1-book-list-size-nth* (proof-cl "NTH"))
(defconst *h1-book-list-size-true-list* (proof-sym "TRUE-LISTP" "ACL2"))
(defconst *h1-book-list-size-two* (proof-quote 2))

(defun h1-book-list-size-counting (term)
  (list *library-count* term))

(defun h1-book-list-size-length (term)
  (list *library-len* term))

(defun h1-book-list-size-step-at (step place)
  (if (not step)
      '(:failure "failure" "")
    (proof-with-checked-results ((first (proof-step-first step)))
      (h1-book-arithmetic-at first place))))

(mutual-recursion
 (defun h1-book-list-size-simplify-visit (n proof term evidence definitions)
   (declare (xargs :measure (nfix n)))
   (let ((core (h1-tactics-prover-proof proof))
         (head (car term)))
     (cond
      ((zp n) '(:failure "fuel" "h1-book-list-size-simplify-visit"))
      ((or (not (proof-compound term)) (equal head *proof-quote*)) nil)
      ((endp term) '(:failure "failure" ""))
      ((or (proof-compound head) (member-equal head definitions))
       (proof-with-checked-results
           ((expansion (proof-simplify-expansion core term))
            (next (h1-book-list-size-simplify-visit
                   (1- n) proof (cadr expansion) evidence definitions)))
         (proof-proof-chain core (car expansion) (list next))))
      ((equal head *proof-if*)
       (proof-with-checked-results
           ((test (proof-term-at term 1))
            (first (h1-book-list-size-simplify-visit (1- n) proof test evidence definitions))
            (redex (proof-simplify-if-redex term first))
            (branch (h1-arithmetic-simplify-branch core redex evidence))
            (selected (h1-arithmetic-simplify-chain core term first branch))
            (right (and selected (proof-rewritten-term selected))))
         (if (or (not selected) (equal right redex))
             selected
           (proof-with-checked-results
               ((next (h1-book-list-size-simplify-visit (1- n) proof right evidence definitions)))
             (proof-proof-chain core selected (list next))))))
      (t
       (proof-with-checked-results
           ((result (h1-book-list-size-simplify-arguments (1- n) proof term (cdr term) 1 nil
                                                          evidence definitions))
            (current (if result (proof-rewritten-term result) term))
            (constant (h1-tactics-prover-constant proof current)))
         (cond ((not constant) result)
               (result (proof-proof-chain core result (list constant)))
               (t constant)))))))
 (defun h1-book-list-size-simplify-arguments (n proof term args index result evidence definitions)
   (declare (xargs :measure (nfix n)))
   (cond
    ((zp n) '(:failure "fuel" "h1-book-list-size-simplify-arguments"))
    ((endp args) result)
    (t
     (let ((core (h1-tactics-prover-proof proof)))
       (proof-with-checked-results
           ((equality (h1-book-list-size-simplify-visit (1- n) proof (car args) evidence definitions))
            (next (if equality
                      (proof-with-checked-results
                          ((prior (or result (h1-arithmetic-proof-reflexive core term))))
                        (proof-proof-rewrite core prior equality (list 1 2 index)))
                    result)))
         (h1-book-list-size-simplify-arguments (1- n) proof term (cdr args) (1+ index) next
                                               evidence definitions)))))))

(defun h1-book-list-size-simplify (proof term evidence definitions)
  (h1-book-list-size-simplify-visit 1000000 proof term evidence definitions))

(defun h1-book-list-size-comparison-types (library terms)
  (if (endp terms)
      nil
    (proof-with-checked-results
        ((step (library-library-type-of library (car terms) nil))
         (rest (h1-book-list-size-comparison-types library (cdr terms))))
      (cons step rest))))

(defun h1-book-list-size-measure-subterms (terms)
  (if (endp terms)
      nil
    (let ((head (h1-tactics-call-head (car terms))))
      (if (or (equal head *library-count*) (equal head *library-len*))
          (cons (car terms) (h1-book-list-size-measure-subterms (cdr terms)))
        (h1-book-list-size-measure-subterms (cdr terms))))))

(defun h1-book-list-size-align-comparison (proof desired known)
  (proof-with-checked-results
      ((normalizer (h1-book-field-field-normalizer proof nil))
       (desired-terms (h1-tactics-subterms desired))
       (known-terms (h1-tactics-subterms known))
       (typed (h1-book-list-size-comparison-types
               (h1-tactics-prover-library proof)
               (proof-unique (h1-book-list-size-measure-subterms
                              (append desired-terms known-terms)))))
       (normalizer (h1-book-field-remember normalizer typed))
       (aligned (h1-book-order-by-difference proof desired known normalizer)))
    (car aligned)))

(defun h1-book-list-size-shifted-bound (proof comparison original)
  (proof-with-checked-results
      ((known (h1-book-list-size-step-at original '(1)))
       (aligned (h1-book-list-size-align-comparison proof comparison known)))
    (h1-propositions-library-transport-argument
     (h1-tactics-prover-library proof) original aligned 1)))

(defun h1-book-list-size-bound-delta (proof bound)
  (proof-with-checked-results
      ((comparison (h1-book-list-size-step-at bound '(1)))
       (arguments (h1-arithmetic-term-tail comparison))
       (delta (library-library-axiom (h1-tactics-prover-library proof)
                                     "<-ON-OTHERS" arguments)))
    (proof-proof-rewrite (h1-tactics-prover-proof proof) bound delta '(1 1))))

(defun h1-book-list-size-sum-of-bounds (proof target first second)
  (let ((library (h1-tactics-prover-library proof)))
    (proof-with-checked-results
        ((first-delta (h1-book-list-size-bound-delta proof first))
         (second-delta (h1-book-list-size-bound-delta proof second))
         (left (h1-book-list-size-step-at first-delta '(1 1)))
         (right (h1-book-list-size-step-at second-delta '(1 1)))
         (typed-left (library-library-type-of library left nil))
         (typed-right (library-library-type-of library right nil))
         (combined (library-library-cite library "NONNEGATIVE-SUM" (list left right)
                                         (list typed-left typed-right first-delta second-delta))))
      (h1-book-list-size-shifted-bound proof target combined))))

(defun h1-book-list-size-count-nonnegative (proof term)
  (let ((library (h1-tactics-prover-library proof))
        (size (h1-book-list-size-counting term)))
    (proof-with-checked-results ((natural (library-library-natural library size)))
      (library-library-cite library "NATURAL-NONNEGATIVE" (list size) (list natural)))))

(defun h1-book-list-size-length-positive (proof cons-step)
  (let ((library (h1-tactics-prover-library proof)))
    (proof-with-checked-results ((term (h1-book-list-size-step-at cons-step '(1))))
      (let ((size (h1-book-list-size-length term))
            (tail (h1-book-list-size-length (list *library-cdr* term))))
        (proof-with-checked-results
            ((less (library-library-cite library "LEN-CDR-LESS" (list term) (list cons-step)))
             (natural (library-library-natural library tail))
             (nonnegative (library-library-cite library "NATURAL-NONNEGATIVE"
                                                 (list tail) (list natural)))
             (zero-type (library-library-type-of library *proof-zero* nil))
             (tail-type (library-library-type-of library tail nil))
             (size-type (library-library-type-of library size nil)))
          (library-library-cite library "WEAK-THEN-LESS" (list *proof-zero* tail size)
                                (list zero-type tail-type size-type nonnegative less)))))))

(defun h1-book-list-size-list-size-induction-fold (bound length-position proof count-eq length-eq)
  (let ((core (h1-tactics-prover-proof proof)))
    (proof-with-checked-results
        ((count-reversed (h1-propositions-proof-symmetric core count-eq))
         (folded (proof-proof-rewrite core bound count-reversed '(1 1 1)))
         (length-reversed (h1-propositions-proof-symmetric core length-eq)))
      (proof-proof-rewrite core folded length-reversed length-position))))

(defun h1-book-list-size-list-size-induction-selection-bound
    (equation method old-bounds proof actual-size actual-length count-eq length-eq)
  (let ((core (h1-tactics-prover-proof proof)))
    (proof-with-checked-results ((value (h1-book-list-size-step-at equation '(2))))
      (let ((target (library-lt actual-size
                                (library-plus (h1-book-list-size-counting value) actual-length))))
        (proof-with-checked-results
            ((bound (case method
                      (:shifted-bound (h1-book-list-size-shifted-bound proof target (car old-bounds)))
                      (:sum-of-bounds (h1-book-list-size-sum-of-bounds proof target
                                                                     (car old-bounds) (cadr old-bounds)))))
             (folded (h1-book-list-size-list-size-induction-fold
                      bound '(1 1 2 2) proof count-eq length-eq))
             (reversed (h1-propositions-proof-symmetric core equation)))
          (proof-proof-rewrite core folded reversed '(1 1 2 1 1)))))))

(defun h1-book-list-size-list-size-induction (proof)
  (let* ((library (h1-tactics-prover-library proof))
         (core (h1-tactics-prover-proof proof))
         (nth-call (list *h1-book-list-size-nth* *library-y* *library-x*))
         (size (h1-book-list-size-counting *library-x*))
         (spine (h1-book-list-size-length *library-x*))
         (selected (h1-book-list-size-counting nth-call))
         (sum (library-plus selected spine))
         (formula (proof-ite (proof-neg (library-lt size spine))
                             (proof-neg (library-lt size sum)) *proof-false*)))
    (proof-with-checked-results
        ((expansion (proof-proof-unfold core nth-call))
         (endp-test (h1-book-list-size-step-at expansion '(2 1)))
         (stop (h1-arithmetic-proof-assume core endp-test t))
         (spine-expansion (proof-proof-unfold core spine))
         (noncons (h1-book-termination-endp-noncons proof stop))
         (nil-len (h1-propositions-select-value library spine-expansion noncons))
         (nil-nth (h1-propositions-select-value library expansion stop))
         (size-bound (h1-book-list-size-count-nonnegative proof *library-x*))
         (nil-len-reversed (h1-propositions-proof-symmetric core nil-len))
         (empty-length (proof-proof-rewrite core size-bound nil-len-reversed '(1 1 2)))
         (score (h1-propositions-propositional-proof-reflexive library sum))
         (score (proof-proof-rewrite core score nil-nth '(1 2 1 1)))
         (score (proof-proof-rewrite core score nil-len '(1 2 2)))
         (score-value (h1-book-list-size-step-at score '(2)))
         (score-computed (h1-book-list-size-simplify proof score-value nil (list *library-count*)))
         (score (proof-proof-chain core score (list score-computed)))
         (score-reversed (h1-propositions-proof-symmetric core score))
         (empty-selection (proof-proof-rewrite core size-bound score-reversed '(1 1 2)))
         (empty (h1-propositions-propositional-proof-conjoin library formula empty-length empty-selection))
         (not-end (h1-arithmetic-proof-assume core endp-test nil))
         (cons-step (h1-book-termination-cons-from-nonatom proof not-end))
         (spine-expansion (proof-proof-unfold core spine))
         (length-eq (h1-propositions-select-value library spine-expansion cons-step))
         (count-axiom (library-library-axiom library "ACL2-COUNT-CAR-CDR-LINEAR" (list *library-x*)))
         (count-eq (h1-propositions-propositional-proof-modus-ponens library count-axiom cons-step))
         (actual-size (h1-book-list-size-step-at count-eq '(2)))
         (actual-length (h1-book-list-size-step-at length-eq '(2)))
         (start (h1-propositions-select-value library expansion not-end))
         (test (h1-book-list-size-step-at start '(2 1)))
         (first-test (h1-arithmetic-proof-assume core test t))
         (first (h1-propositions-select-value library start first-test))
         (later-test (h1-arithmetic-proof-assume core test nil))
         (recurse (h1-propositions-select-value library start later-test))
         (child (h1-book-list-size-step-at recurse '(2)))
         (actuals (h1-arithmetic-term-tail child))
         (actuals (proof-list-of-length actuals 2))
         (built-in (library-library-builtin library 3 *library-x*))
         (descent (proof-proof-discharge core built-in cons-step))
         (descent-claim (proof-step-first descent)))
      (let* ((bindings (list (list *library-x* (cadr actuals))
                             (list *library-y* (car actuals))))
             (changes (list (cons *library-x* (cadr actuals))
                            (cons *library-y* (car actuals)))))
        (proof-with-checked-results
            ((child-formula (proof-subst formula changes))
             (hypothesis (h1-arithmetic-proof-assume core (proof-ite descent-claim child-formula *proof-true*) t))
             (induction (h1-propositions-proof-prove-if core hypothesis descent))
             (child-bounds (h1-propositions-propositional-proof-conjunct library induction))
             (head (h1-book-list-size-count-nonnegative proof (list *library-car* *library-x*)))
             (length-bound (h1-book-list-size-sum-of-bounds proof (library-lt actual-size actual-length)
                                                            head (car child-bounds)))
             (length-bound (h1-book-list-size-list-size-induction-fold
                            length-bound '(1 1 2) proof count-eq length-eq))
             (at-head (h1-book-list-size-list-size-induction-selection-bound
                       first :shifted-bound (list (car child-bounds)) proof actual-size
                       actual-length count-eq length-eq))
             (in-tail (h1-book-list-size-list-size-induction-selection-bound
                       recurse :sum-of-bounds (list head (cadr child-bounds)) proof actual-size
                       actual-length count-eq length-eq))
             (selection (proof-proof-cases core test at-head in-tail))
             (advanced (h1-propositions-propositional-proof-conjoin library formula length-bound selection))
             (ordinal (descent-measure-ordinal library size))
             (cases (proof-proof-cases core endp-test empty advanced)))
          (proof-proof-induct core ordinal cases formula size (list bindings)))))))

(defun h1-book-list-size-install-length-zero (proof)
  (let* ((library (h1-tactics-prover-library proof))
         (core (h1-tactics-prover-proof proof))
         (cons-test (list *proof-consp* *library-x*))
         (typed (list *h1-book-list-size-true-list* *library-x*)))
    (proof-with-checked-results ((typed-list (h1-arithmetic-proof-assume core typed t)))
      (let* ((size (h1-book-list-size-length *library-x*))
             (zero-length (proof-eq size *proof-zero*)))
        (proof-with-checked-results
            ((negation (proof-proof-unfold core (proof-neg *library-x*)))
             (cons-step (h1-arithmetic-proof-assume core cons-test t))
             (sign (h1-book-list-size-length-positive proof cons-step))
             (nonzero (h1-book-order-nonzero-from-sign proof sign size))
             (absent (h1-tactics-prover-false-equation proof nonzero))
             (cons-step (h1-arithmetic-proof-assume core cons-test t))
             (true-cons (h1-book-termination-cons-implies-truth proof *library-x* cons-step))
             (present (h1-propositions-select-value library negation true-cons))
             (present-reversed (h1-propositions-proof-symmetric core present))
             (nonempty (proof-proof-chain core absent (list present-reversed)))
             (atom-step (h1-arithmetic-proof-assume core cons-test nil))
             (typed-expansion (proof-proof-unfold core typed))
             (proper (proof-proof-rewrite core typed-list typed-expansion '(1)))
             (proper (h1-propositions-proof-prove-if core proper atom-step))
             (proper-claim (proof-step-first proper))
             (proper-expansion (proof-proof-unfold core proper-claim))
             (nil-eq (proof-proof-rewrite core proper proper-expansion '(1)))
             (not-nil (proof-proof-not-nil core))
             (nil-step (h1-propositions-library-transport-argument library not-nil nil-eq 1))
             (size-expansion (proof-proof-unfold core size))
             (zero (h1-propositions-select-value library size-expansion atom-step))
             (zero (h1-tactics-prover-equality-is-true proof zero))
             (empty-negation (h1-propositions-select-value library negation nil-step))
             (empty-reversed (h1-propositions-proof-symmetric core empty-negation))
             (empty (proof-proof-chain core zero (list empty-reversed)))
             (equality (proof-proof-cases core cons-test nonempty empty))
             (claim (proof-step-first equality))
             (bridge (h1-propositions-propositional-proof-implies-from
                      library (list *library-implies* typed claim) equality))
             (record (h1-tactics-prover-record-formula proof "TRUE-LIST-LENGTH-ZERO" bridge nil)))
          (let* ((proof (cdr record))
                 (library (h1-tactics-prover-library proof))
                 (core (h1-tactics-prover-proof proof))
                 (premise (proof-ite *library-x* typed *proof-false*)))
            (proof-with-checked-results
                ((evidence (h1-arithmetic-proof-assume core premise t))
                 (parts (h1-propositions-propositional-proof-conjunct library evidence))
                 (zero-test (h1-arithmetic-proof-assume core zero-length t))
                 (conversion (h1-propositions-propositional-proof-modus-ponens library (car record) (cadr parts)))
                 (denied (proof-proof-rewrite core zero-test conversion '(1)))
                 (conflict (proof-proof-cut core (car parts) denied))
                 (conflict (proof-proof-front core conflict (proof-neg zero-length)))
                 (claim (proof-step-first conflict))
                 (implication (h1-propositions-propositional-proof-implies-from
                               library (list *library-implies* premise claim) conflict))
                 (record (h1-tactics-prover-record-formula proof "NONEMPTY-TRUE-LIST-LENGTH" implication nil)))
              (cdr record))))))))

(defun h1-book-list-size-selector-bound (proof index selector known size)
  (let ((library (h1-tactics-prover-library proof))
        (core (h1-tactics-prover-proof proof)))
    (proof-with-checked-results
        ((built-in (library-library-builtin library index *library-x*))
         (bound (proof-proof-discharge core built-in known))
         (comparison (library-library-ordinal-comparison
                      library (h1-book-list-size-counting (list selector *library-x*)) size)))
      (proof-proof-rewrite core bound comparison '(1)))))

(defun h1-book-list-size-install-count-bounds (proof)
  (let* ((library (h1-tactics-prover-library proof))
         (core (h1-tactics-prover-proof proof))
         (cons-test (list *proof-consp* *library-x*)))
    (proof-with-checked-results ((known (h1-arithmetic-proof-assume core cons-test t)))
      (let ((size (h1-book-list-size-counting *library-x*))
            (spine (h1-book-list-size-length *library-x*))
            (element (h1-book-list-size-counting
                      (list *h1-book-list-size-nth* *library-y* *library-x*))))
        (proof-with-checked-results
            ((size-type (library-library-type-of library size nil))
             (spine-type (library-library-type-of library spine nil))
             (count-type (library-library-type-of library element nil))
             (strict-car (h1-book-list-size-selector-bound proof 2 *library-car* known size))
             (strict-cdr (h1-book-list-size-selector-bound proof 3 *library-cdr* known size))
             (car-claim (proof-step-first strict-car))
             (cdr-claim (proof-step-first strict-cdr))
             (conclusion (h1-propositions-propositional-proof-conjoin
                          library (proof-ite car-claim cdr-claim *proof-false*) strict-car strict-cdr))
             (claim (proof-step-first conclusion))
             (implication (h1-propositions-propositional-proof-implies-from
                           library (list *library-implies* cons-test claim) conclusion))
             (record (h1-tactics-prover-record-formula proof "CONS-STRICT-SELECTORS" implication nil))
             (proof (cdr record))
             (induction (h1-book-list-size-list-size-induction proof))
             (invariant (proof-step-first induction))
             (library (library-library-lemma (h1-tactics-prover-library proof)
                                            "LIST-SIZE-INVARIANT" invariant induction nil))
             (proof (h1-tactics-prover-with-library proof library))
             (core (h1-tactics-prover-proof proof))
             (fact (library-library-cite library "LIST-SIZE-INVARIANT" (list *library-x* *library-y*) nil))
             (bounds (h1-propositions-propositional-proof-conjunct library fact))
             (total (library-plus element spine))
             (total-type (library-library-type-of library total nil))
             (positive (h1-book-list-size-length-positive proof known))
             (alignment (h1-book-list-size-align-comparison proof (library-lt element total)
                                                           (library-positive spine)))
             (strictly-added (h1-propositions-proof-transport core positive alignment))
             (strict-count (library-library-cite library "LESS-THEN-WEAK" (list element total size)
                                                 (list count-type total-type size-type strictly-added (cadr bounds))))
             (claim (proof-step-first strict-count))
             (implication (h1-propositions-propositional-proof-implies-from
                           library (list *library-implies* cons-test claim) strict-count))
             (record (h1-tactics-prover-record-formula proof "NTH-STRICT-SIZE" implication nil))
             (proof (cdr record))
             (library (h1-tactics-prover-library proof))
             (core (h1-tactics-prover-proof proof))
             (no-size (proof-eq size *proof-zero*))
             (zero-evidence (h1-arithmetic-proof-assume core no-size t))
             (zero-bound (proof-proof-rewrite core (car bounds) zero-evidence '(1 1 1)))
             (zero-type (library-library-type-of library *proof-zero* nil))
             (below-one (library-library-cite library "LESS-THAN-NEXT" (list *proof-zero* spine)
                                              (list zero-type spine-type zero-bound)))
             (one (h1-tactics-prover-constant proof (library-plus *proof-one* *proof-zero*)))
             (below-one (proof-proof-rewrite core below-one one '(1 2)))
             (claim (proof-step-first below-one))
             (implication (h1-propositions-propositional-proof-implies-from
                           library (list *library-implies* no-size claim) below-one))
             (record (h1-tactics-prover-record-formula proof "COUNT-ZERO-LENGTH-BOUND" implication nil))
             (proof (cdr record))
             (library (h1-tactics-prover-library proof))
             (core (h1-tactics-prover-proof proof))
             (successor (library-library-cite library "SUCCESSOR-WEAK-BOUND" (list element size)
                                              (list count-type size-type strict-count)))
             (claim (proof-step-first successor))
             (first (h1-propositions-propositional-proof-implies-from
                     library (list *library-implies* cons-test claim) successor))
             (two-or-more (proof-neg (library-lt spine *h1-book-list-size-two*)))
             (one-type (library-library-type-of library *proof-one* nil))
             (two-type (library-library-type-of library *h1-book-list-size-two* nil))
             (one-below-two (h1-tactics-prover-solve proof (library-lt *proof-one* *h1-book-list-size-two*) nil 160))
             (two-or-more-proof (h1-arithmetic-proof-assume core two-or-more t))
             (long-spine (library-library-cite library "LESS-THEN-WEAK" (list *proof-one* *h1-book-list-size-two* spine)
                                              (list one-type two-type spine-type one-below-two two-or-more-proof)))
             (next-size (library-plus *proof-one* element))
             (alignment (h1-book-list-size-align-comparison proof (library-lt next-size total)
                                                           (library-lt *proof-one* spine)))
             (separates (h1-propositions-proof-transport core long-spine alignment))
             (next-type (library-library-type-of library next-size nil))
             (strong-count (library-library-cite library "LESS-THEN-WEAK" (list next-size total size)
                                                 (list next-type total-type size-type separates (cadr bounds))))
             (claim (proof-step-first strong-count))
             (second (h1-propositions-propositional-proof-implies-from
                      library (list *library-implies* two-or-more claim) strong-count))
             (first-claim (proof-step-first first))
             (second-claim (proof-step-first second))
             (conclusion (h1-propositions-propositional-proof-conjoin
                          library (proof-ite first-claim second-claim *proof-false*) first second))
             (record (h1-tactics-prover-record-formula proof "NTH-BOUNDED-SIZE" conclusion nil)))
          (cdr record))))))

(defun h1-book-list-size-install-list-sizes (proof)
