(defun h1-book-fraction-denominator-negation (proof)
  (let* ((lib (h1-tactics-prover-library proof))
         (core (h1-tactics-prover-proof proof))
         (ratio (h1-book-order-rational *library-x*))
         (opposite (library-minus *library-x*))
         (d (h1-book-fraction-denominator *library-x*))
         (e (h1-book-fraction-denominator opposite)))
    (proof-with-checked-results
        ((norm (h1-book-field-field-normalizer proof (list (list ratio t))))
         (type-d (h1-book-fraction-positive-denominator proof norm d))
         (type-e (h1-book-fraction-positive-denominator proof (cdr type-d) e))
         (a-int (h1-book-fraction-scaled-numerator-is-integer proof (cdr type-e) *library-x*))
         (opposite-int (h1-book-fraction-scaled-numerator-is-integer proof (cdr a-int) opposite))
         (b-int (h1-book-fraction-negative-integer-value
                 proof (cdr opposite-int) (h1-book-order-product *library-x* e) (car opposite-int)))
         (lemma (library-library-cite lib "POSITIVE-COFACTORS" (list d e *library-x*) nil))
         (premise (h1-book-fraction-step-at lemma '(1)))
         (rational-x (h1-book-fraction-require (cdr b-int) ratio))
         (premise (h1-arithmetic-conjunction lib premise (list (car type-d) (car type-e) (car rational-x)
                                                          (car a-int) (car b-int))))
         (specification (h1-propositions-propositional-proof-modus-ponens lib lemma premise))
         (parts (h1-book-cofactors-components proof specification))
         (parts (proof-list-of-length parts 6))
         (g (car parts))
         (a (cadr parts))
         (b (caddr parts))
         (left (cadddr parts))
         (right (nth 4 parts))
         (scaled (nth 5 parts))
         (norm (h1-book-fraction-remember-positive proof (cdr rational-x) g a b))
         (common (h1-book-fraction-step-at g '(1)))
         (first-cofactor (h1-book-fraction-step-at a '(1)))
         (first (h1-book-fraction-reduced-denominator proof norm *library-x* common first-cofactor left scaled))
         (reverse-scaled (h1-book-fraction-negative-integer-value
                          proof (cdr first) (h1-book-order-product opposite common) scaled))
         (second-cofactor (h1-book-fraction-step-at b '(1)))
         (second (h1-book-fraction-reduced-denominator
                  proof (cdr reverse-scaled) opposite common second-cofactor right (car reverse-scaled)))
         (reversed (h1-propositions-proof-symmetric core (car first)))
         (equality (proof-proof-chain core (car second) (list reversed)))
         (claim (proof-step-first equality))
         (formula (list *library-implies* ratio claim)))
      (h1-book-fraction-record-consequence proof "DENOMINATOR-NEGATION" formula equality nil))))

(defun h1-book-fraction-numerator-negation-rational (proof ratio opposite)
  (let ((lib (h1-tactics-prover-library proof))
        (core (h1-tactics-prover-proof proof))
