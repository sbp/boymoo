(in-package "BOYMOO-PROVER")
(set-verify-guards-eagerness 0)

(defconst *h1-book-fraction-numerator* (proof-cl "NUMERATOR"))
(defconst *h1-book-fraction-denominator* (proof-cl "DENOMINATOR"))

(defun h1-book-fraction-numerator (value)
  (list *h1-book-fraction-numerator* value))

(defun h1-book-fraction-denominator (value)
  (list *h1-book-fraction-denominator* value))

(defun h1-book-fraction-step-at (step indices)
  (proof-with-checked-results ((literal (proof-step-first step)))
    (h1-book-arithmetic-at literal indices)))

(defun h1-book-fraction-checked-pair (result)
  (cond ((failure-p result) result)
        ((failure-p (car result)) (car result))
        (t result)))

(defun h1-book-fraction-require (norm literal)
  (h1-book-fraction-checked-pair (h1-book-field-require norm literal)))

(defun h1-book-fraction-equality (norm left right)
  (h1-book-fraction-checked-pair (h1-book-arithmetic-algebra-equality norm left right)))

(defun h1-book-fraction-lemma (proof label step guards)
  (proof-with-checked-results
      ((claim (proof-step-first step))
       (lib (library-library-lemma (h1-tactics-prover-library proof) label claim step guards)))
    (h1-tactics-prover-with-library proof lib)))

(defun h1-book-fraction-record-consequence (proof label formula consequence rewrite)
  (proof-with-checked-results
      ((step (h1-propositions-propositional-proof-implies-from
              (h1-tactics-prover-library proof) formula consequence))
       (recorded (h1-tactics-prover-record-formula proof label step rewrite)))
    (cdr recorded)))

(defun h1-book-fraction-default-value (proof value head nonrational)
  (let ((lib (h1-tactics-prover-library proof)))
    (proof-with-checked-results
        ((name (proof-term-at head 2))
         (axiom (library-library-axiom lib (concatenate 'string "DEFAULT-" name) (list value))))
      (h1-propositions-propositional-proof-modus-ponens lib axiom nonrational))))

(defun h1-book-fraction-multiply-denominator (proof)
  (let ((lib (h1-tactics-prover-library proof))
        (core (h1-tactics-prover-proof proof))
        (typed (h1-book-order-rational *library-x*))
        (d (h1-book-fraction-denominator *library-x*))
        (n (h1-book-fraction-numerator *library-x*)))
    (proof-with-checked-results
        ((norm (h1-book-field-field-normalizer proof (list (list typed t))))
         (positive-d (h1-book-fraction-require norm (library-positive d)))
         (nonzero-d (h1-book-order-nonzero-from-sign proof (car positive-d) d))
         (norm (h1-book-field-remember (cdr positive-d) (list nonzero-d)))
         (axiom (library-library-axiom lib "RATIONAL-IMPLIES2" (list *library-x*)))
         (rational-x (h1-book-fraction-require norm typed))
         (representation (h1-propositions-propositional-proof-modus-ponens lib axiom (car rational-x)))
         (product (h1-book-fraction-step-at representation '(1)))
         (commute (library-library-axiom lib "COMMUTATIVITY-OF-*" (reverse (cdr product))))
         (decomposition (proof-proof-chain core commute (list representation)))
         (claim (proof-step-first decomposition))
         (formula (list *library-implies* typed claim))
         (proof (h1-book-fraction-record-consequence
                 proof "NUMERATOR-TIMES-RECIPROCAL-DENOMINATOR" formula decomposition nil))
         (lib (h1-tactics-prover-library proof))
         (core (h1-tactics-prover-proof proof))
         (norm (h1-book-arithmetic-algebra-with-proof (cdr rational-x) proof))
         (initial (h1-propositions-propositional-proof-reflexive lib (h1-book-order-product *library-x* d)))
         (reversed (h1-propositions-proof-symmetric core representation))
         (initial (proof-proof-rewrite core initial reversed '(1 2 1)))
         (value (h1-book-fraction-step-at initial '(2)))
         (aligned (h1-book-fraction-equality norm value n))
         (identity (proof-proof-chain core initial (list (car aligned)))))
      (h1-book-fraction-lemma proof "MULTIPLY-DENOMINATOR" identity (list (proof-neg typed))))))

(defun h1-book-fraction-integer-values (proof)
  (let* ((lib (h1-tactics-prover-library proof))
         (core (h1-tactics-prover-proof proof))
         (typed (library-integer *library-x*))
         (d (h1-book-fraction-denominator *library-x*))
         (n (h1-book-fraction-numerator *library-x*)))
    (proof-with-checked-results
        ((norm (h1-book-field-field-normalizer proof (list (list typed t))))
         (int-x (h1-book-fraction-require norm typed))
         (rat-x (h1-book-fraction-require (cdr int-x) (h1-book-order-rational *library-x*)))
         (cross (library-library-cite lib "MULTIPLY-DENOMINATOR" (list *library-x*) (list (car rat-x))))
         (reversed (h1-propositions-proof-symmetric core cross))
         (commute (library-library-axiom lib "COMMUTATIVITY-OF-*" (list *library-x* d)))
         (numerator-factor (proof-proof-chain core reversed (list commute)))
         (aligned (h1-book-fraction-equality (cdr rat-x) (h1-book-order-product d *proof-one*) d))
         (denominator-factor (h1-propositions-proof-symmetric core (car aligned)))
         (lowest (proof-proof-fact core (proof-sym "LOWEST-TERMS" "ACL2")
                                   (list (list (proof-sym "N" "ACL2") d)
                                         (list (proof-sym "R" "ACL2") *library-x*)
                                         (list (proof-sym "Q" "ACL2") *proof-one*))))
         (int-d (h1-book-fraction-require (cdr aligned) (library-integer d)))
         (int-one (h1-book-fraction-require (cdr int-d) (library-integer *proof-one*)))
         (pos-d (h1-book-fraction-require (cdr int-one) (library-positive d)))
         (premise (h1-book-fraction-step-at lowest '(1)))
         (conjoined (h1-arithmetic-conjunction lib premise
                     (list (car int-d) (car rat-x) (car int-x) (car int-one) (car pos-d)
                           numerator-factor denominator-factor)))
         (d-one (h1-propositions-propositional-proof-modus-ponens lib lowest conjoined))
         (claim (proof-step-first d-one))
         (implication (list *library-implies* typed claim))
         (proof (h1-book-fraction-record-consequence proof "INTEGER-DENOMINATOR-ONE" implication d-one t))
         (core (h1-tactics-prover-proof proof))
         (value (proof-proof-rewrite core cross d-one '(1 1 2)))
         (value (h1-propositions-proof-symmetric core value))
         (norm (h1-book-arithmetic-algebra-with-proof (cdr pos-d) proof))
         (aligned (h1-book-fraction-equality norm (h1-book-order-product *library-x* *proof-one*) *library-x*))
         (value (proof-proof-chain core value (list (car aligned))))
         (statement (list *library-implies* typed (proof-eq n *library-x*))))
      (h1-book-fraction-record-consequence proof "INTEGER-NUMERATOR-VALUE" statement value t))))

(defun h1-book-fraction-numerator-sign (proof norm label left right d typed d-sign a b)
  (let ((lib (h1-tactics-prover-library proof))
        (core (h1-tactics-prover-proof proof)))
    (proof-with-checked-results
        ((rat-left (h1-book-fraction-require norm (h1-book-order-rational left)))
         (rat-right (h1-book-fraction-require (cdr rat-left) (h1-book-order-rational right)))
         (rat-d (h1-book-fraction-require (cdr rat-right) (h1-book-order-rational d)))
         (relation (library-library-cite lib "SCALE-COMPARISON-POSITIVE" (list left right d)
                                         (list (car rat-left) (car rat-right) (car rat-d) d-sign)))
         (relation (proof-proof-rewrite core relation a '(1 1 1)))
         (relation (proof-proof-rewrite core relation b '(1 1 2)))
         (claim (proof-step-first relation))
         (formula (list *library-implies* typed claim))
         (proof (h1-book-fraction-record-consequence proof label formula relation t))
         (norm (h1-book-arithmetic-algebra-with-proof (cdr rat-d) proof)))
      (cons norm proof))))

(defun h1-book-fraction-numerator-signs (proof)
  (let ((lib (h1-tactics-prover-library proof))
        (typed (h1-book-order-rational *library-x*))
        (d (h1-book-fraction-denominator *library-x*)))
    (proof-with-checked-results
        ((norm (h1-book-field-field-normalizer proof (list (list typed t))))
         (d-sign (h1-book-fraction-require norm (library-positive d)))
         (rat-x (h1-book-fraction-require (cdr d-sign) typed))
         (scaled-value (library-library-cite lib "MULTIPLY-DENOMINATOR" (list *library-x*) (list (car rat-x))))
         (scaled-zero (h1-book-fraction-equality (cdr rat-x) (h1-book-order-product *proof-zero* d) *proof-zero*))
         (first (h1-book-fraction-numerator-sign
                 proof (cdr scaled-zero) "RATIONAL-NUMERATOR-POSITIVE"
                 *proof-zero* *library-x* d typed (car d-sign) (car scaled-zero) scaled-value))
         (second (h1-book-fraction-numerator-sign
                  (cdr first) (car first) "RATIONAL-NUMERATOR-NEGATIVE"
                  *library-x* *proof-zero* d typed (car d-sign) scaled-value (car scaled-zero))))
      (cdr second))))

(defun h1-book-fraction-denominator-one-integer (proof typed result)
  (let ((lib (h1-tactics-prover-library proof))
        (core (h1-tactics-prover-proof proof)))
    (proof-with-checked-results
        ((integer-x (proof-proof-assume core typed t))
         (theorem (library-library-axiom lib "H1-INTEGER-DENOMINATOR-ONE" (list *library-x*)))
         (yes (h1-propositions-propositional-proof-modus-ponens lib theorem integer-x))
         (yes (h1-tactics-prover-equality-is-true proof yes))
         (boolean (proof-proof-fact core "booleanp-integerp" nil))
         (exact (library-library-cite lib "ORDER-BOOLEAN-TRUE" (list typed) (list integer-x boolean)))
         (exact (h1-propositions-proof-symmetric core exact))
         (value (proof-proof-if-true core result))
         (value (h1-propositions-proof-symmetric core value)))
      (proof-proof-chain core yes (list exact value)))))

(defun h1-book-fraction-denominator-one-rational (proof typed rat condition)
  (let ((lib (h1-tactics-prover-library proof))
        (core (h1-tactics-prover-proof proof)))
    (proof-with-checked-results
        ((norm (h1-book-field-field-normalizer proof (list (list rat t))))
         (known (h1-book-fraction-require norm rat))
         (cross (library-library-cite lib "MULTIPLY-DENOMINATOR" (list *library-x*) (list (car known))))
         (one (proof-proof-assume core condition t))
         (from-one (proof-proof-rewrite core cross one '(1 1 2)))
         (identity (h1-book-fraction-equality (cdr known) (h1-book-order-product *library-x* *proof-one*) *library-x*))
         (from-one (proof-proof-rewrite core from-one (car identity) '(1 1)))
         (int-n (h1-book-fraction-require (cdr identity) (library-integer (h1-book-fraction-numerator *library-x*))))
         (forced-int (h1-propositions-library-transport-argument lib (car int-n) from-one 1))
         (not-int (proof-proof-assume core typed nil))
         (denied (proof-proof-cut core forced-int not-int))
         (denied (proof-proof-front core denied (proof-neg condition))))
      (h1-tactics-prover-false-equation proof denied))))

(defun h1-book-fraction-denominator-one-result (lib no-result negative rat holds)
  (let ((core (library-library-proof lib)))
    (proof-with-checked-results
        ((right-side (h1-book-fraction-step-at negative '(2)))
         (assumed (proof-proof-assume core rat holds))
         (selected (h1-propositions-propositional-proof-select lib right-side assumed)))
      (proof-proof-chain core no-result (list negative selected)))))

(defun h1-book-fraction-equal-denominator-one (proof)
  (let* ((lib (h1-tactics-prover-library proof))
         (core (h1-tactics-prover-proof proof))
         (typed (library-integer *library-x*))
         (rat (h1-book-order-rational *library-x*))
         (condition (proof-eq (h1-book-fraction-denominator *library-x*) *proof-one*))
         (result (proof-ite typed typed (proof-neg rat))))
    (proof-with-checked-results
        ((yes (h1-book-fraction-denominator-one-integer proof typed result))
         (rat-yes (h1-book-fraction-denominator-one-rational proof typed rat condition))
         (nonrational (proof-proof-assume core rat nil))
         (rat-no (h1-book-fraction-default-value proof *library-x* *h1-book-fraction-denominator* nonrational))
         (rat-no (h1-tactics-prover-equality-is-true proof rat-no))
         (no-result (proof-proof-if-false core result))
         (negative (proof-proof-unfold core (proof-neg rat)))
         (yes-value (h1-book-fraction-denominator-one-result lib no-result negative rat t))
         (no-value (h1-book-fraction-denominator-one-result lib no-result negative rat nil))
         (yes-value (h1-propositions-proof-symmetric core yes-value))
         (rat-yes (proof-proof-chain core rat-yes (list yes-value)))
         (no-value (h1-propositions-proof-symmetric core no-value))
         (rat-no (proof-proof-chain core rat-no (list no-value)))
         (no (proof-proof-cases core rat rat-yes rat-no))
         (step (proof-proof-cases core typed yes no))
         (recorded (h1-tactics-prover-record-formula proof "DENOMINATOR-ONE-TEST" step nil)))
      (cdr recorded))))

(defun h1-book-fraction-total-denominator-product (proof)
