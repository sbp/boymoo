(defun h1-book-fraction-reduced-denominator (proof norm value common cofactor factorization typed-product)
  (let ((lib (h1-tactics-prover-library proof))
        (core (h1-tactics-prover-proof proof))
        (scaled-value (h1-book-order-product value common)))
    (proof-with-checked-results
        ((known (h1-book-fraction-require norm (h1-book-order-rational value)))
         (step (library-library-cite lib "MULTIPLY-DENOMINATOR" (list value) (list (car known))))
         (reversed (h1-propositions-proof-symmetric core step))
         (numerator-eq (proof-proof-rewrite core reversed factorization '(1 2 2)))
         (scaled (h1-book-order-product cofactor scaled-value))
         (norm (h1-book-arithmetic-algebra-with-work (cdr known) 150))
         (operand (h1-book-fraction-step-at numerator-eq '(2)))
         (aligned (h1-book-fraction-equality norm operand scaled))
         (numerator-eq (proof-proof-chain core numerator-eq (list (car aligned))))
         (commute (library-library-axiom lib "COMMUTATIVITY-OF-*" (list common cofactor)))
         (denominator-eq (proof-proof-chain core factorization (list commute)))
         (lowest (proof-proof-fact core (proof-sym "LOWEST-TERMS" "ACL2")
                                   (list (list (proof-sym "N" "ACL2") cofactor)
                                         (list *library-x* value)
                                         (list (proof-sym "R" "ACL2") scaled-value)
                                         (list (proof-sym "Q" "ACL2") common))))
         (int-cofactor (h1-book-fraction-require (cdr aligned) (library-integer cofactor)))
         (rat-value (h1-book-fraction-require (cdr int-cofactor) (h1-book-order-rational value)))
         (int-common (h1-book-fraction-require (cdr rat-value) (library-integer common)))
         (pos-cofactor (h1-book-fraction-require (cdr int-common) (library-positive cofactor)))
         (premise (h1-book-fraction-step-at lowest '(1)))
         (conjoined (h1-arithmetic-conjunction lib premise
                     (list (car int-cofactor) (car rat-value) typed-product (car int-common)
                           (car pos-cofactor) numerator-eq denominator-eq)))
         (one (h1-propositions-propositional-proof-modus-ponens lib lowest conjoined))
         (reduced (proof-proof-rewrite core factorization one '(1 2 2)))
         (operand (h1-book-fraction-step-at reduced '(2)))
         (aligned (h1-book-fraction-equality (cdr pos-cofactor) operand common))
         (step (proof-proof-chain core reduced (list (car aligned)))))
      (cons step (cdr aligned)))))

