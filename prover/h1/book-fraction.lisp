    (proof-with-checked-results
        ((rational-x (proof-proof-assume core typed t))
         (yes (library-library-cite lib "MULTIPLY-DENOMINATOR" (list *library-x*) (list rational-x)))
         (when-rational (proof-proof-if-true core output))
         (when-rational (h1-propositions-proof-symmetric core when-rational))
         (yes (proof-proof-chain core yes (list when-rational)))
         (not-rat (proof-proof-assume core typed nil))
         (identity (h1-propositions-propositional-proof-reflexive lib (h1-book-order-product *library-x* d)))
         (default (h1-book-fraction-default-value proof *library-x* *h1-book-fraction-denominator* not-rat))
         (no (proof-proof-rewrite core identity default '(1 2 2)))
         (unit (h1-book-arithmetic-right-unit proof *proof-times* *library-x*))
         (when-other (proof-proof-if-false core output))
         (when-other (h1-propositions-proof-symmetric core when-other))
         (no (proof-proof-chain core no (list unit when-other)))
         (step (proof-proof-cases core typed yes no))
         (recorded (h1-tactics-prover-record-formula proof "DENOMINATOR-PRODUCT" step nil)))
      (cdr recorded))))

(defun h1-book-fraction-numerator-nonzero (proof)
  (let* ((lib (h1-tactics-prover-library proof))
         (core (h1-tactics-prover-proof proof))
         (n (h1-book-fraction-numerator *library-x*))
         (d (h1-book-fraction-denominator *library-x*))
         (n-zero (proof-eq n *proof-zero*))
         (test (proof-neg n-zero))
         (rational-x (h1-book-order-rational *library-x*)))
    (proof-with-checked-results
        ((nonzero (proof-proof-assume core test t))
         (not-rational (proof-proof-assume core rational-x nil))
         (outside (h1-book-fraction-default-value proof *library-x* *h1-book-fraction-numerator* not-rational))
         (outside (proof-proof-front core outside n-zero))
         (typed (proof-proof-cut core outside nonzero))
         (typed (proof-proof-front core typed rational-x))
         (fact (proof-proof-fact core "rationalp-acl2-numberp" nil))
         (number (h1-propositions-propositional-proof-modus-ponens lib fact typed))
         (cross (library-library-cite lib "MULTIPLY-DENOMINATOR" (list *library-x*) (list typed)))
         (cross (h1-propositions-proof-symmetric core cross))
         (x-zero (proof-eq *library-x* *proof-zero*))
         (assumed (proof-proof-assume core x-zero t))
         (cross (proof-proof-rewrite core cross assumed '(1 2 1)))
         (commute (library-library-axiom lib "COMMUTATIVITY-OF-*" (list *proof-zero* d)))
         (product-zero (library-library-axiom lib "H1-PRODUCT-ZERO" (list d)))
         (cross (proof-proof-chain core cross (list commute product-zero)))
         (denied (proof-proof-cut core cross nonzero))
         (denied (proof-proof-front core denied (proof-neg x-zero)))
         (claim (proof-step-first number))
         (result (proof-ite (proof-neg x-zero) claim *proof-false*))
         (step (h1-propositions-propositional-proof-conjoin lib result denied number))
         (formula (list *library-implies* test result)))
      (h1-book-fraction-record-consequence proof "NUMERATOR-NONZERO-INPUT" formula step nil))))

(defun h1-book-fraction-scaled-numerator-is-integer (proof norm value)
  (let ((lib (h1-tactics-prover-library proof)))
    (proof-with-checked-results
        ((rational-value (h1-book-fraction-require norm (h1-book-order-rational value)))
         (equality (library-library-cite lib "MULTIPLY-DENOMINATOR" (list value) (list (car rational-value))))
         (integral (h1-book-fraction-require
                    (cdr rational-value) (library-integer (h1-book-fraction-numerator value))))
         (step (h1-propositions-library-transport-argument lib (car integral) equality 1)))
      (cons step (cdr integral)))))

