(in-package "BOYMOO-PROVER")
(set-verify-guards-eagerness 0)

(defconst *h1-book-order-booleanp* (proof-sym "BOOLEANP" "ACL2"))
(defconst *h1-book-order-rationalp* (proof-cl "RATIONALP"))

(defun h1-book-order-rational (value)
  (list *h1-book-order-rationalp* value))

(defun h1-book-order-product (a b)
  (list *proof-times* a b))

(defun h1-book-order-unproved-p (result)
  (and (failure-p result) (equal (cadr result) "unproved")))

(defun h1-book-order-positive-sum (proof left right first second)
  (let ((lib (h1-tactics-prover-library proof)))
    (proof-with-checked-results
        ((axiom (library-library-axiom lib "POSITIVE" (list left right)))
         (both (h1-propositions-propositional-proof-conjunct lib axiom))
         (literal (proof-step-first (car both)))
         (premise (proof-term-at literal 1))
         (supplied (h1-propositions-propositional-proof-conjoin lib premise first second)))
      (h1-propositions-propositional-proof-modus-ponens lib (car both) supplied))))

(defun h1-book-order-difference (order)
  (proof-with-checked-results ((args (h1-arithmetic-term-tail order)))
    (if (equal (len args) 2)
        (library-diff (car args) (cadr args))
      '(:failure "failure" ""))))

(defun h1-book-order-by-difference (proof left right normalizer)
  (let ((left-difference (h1-book-order-difference left)))
    (if (failure-p left-difference)
        (cons left-difference normalizer)
      (let ((right-difference (h1-book-order-difference right)))
        (if (failure-p right-difference)
            (cons right-difference normalizer)
          (let ((result (h1-book-arithmetic-algebra-equality normalizer left-difference right-difference)))
            (if (failure-p (car result))
                result
              (cons (h1-arithmetic-comparison-by-difference
                     (h1-tactics-prover-library proof) left right (car result))
                    (cdr result)))))))))

(defun h1-book-order-boolean-value (proof known)
  (let ((core (h1-tactics-prover-proof proof))
        (lib (h1-tactics-prover-library proof)))
    (proof-with-checked-results ((term (proof-step-first known)))
      (cond
       ((proof-is-call term *proof-not*) (h1-tactics-prover-false-equation proof known))
       ((integerp term) '(:failure "failure" ""))
       (t (proof-with-checked-results
              ((boolean (proof-proof-fact core "booleanp-<"
                                          (seq-zip (list *library-x* *library-y*) (cdr term)))))
            (library-library-cite lib "ORDER-BOOLEAN-TRUE" (list term) (list known boolean))))))))

(defun h1-book-order-nonzero-from-sign (proof signed value)
  (let ((core (h1-tactics-prover-proof proof))
        (equality (proof-eq value *proof-zero*)))
    (proof-with-checked-results
        ((assumed (h1-arithmetic-proof-assume core equality t))
         (at-zero (proof-proof-rewrite-first core signed assumed))
         (constant (proof-proof-compute core (library-lt *proof-zero* *proof-zero*) *proof-nil*))
         (rewritten (proof-proof-rewrite core at-zero constant '(1)))
         (tidied (proof-proof-tidy core rewritten)))
      (proof-proof-front core tidied (proof-neg equality)))))

(defun h1-book-order-lemma (proof name claim step conditions)
  (proof-with-checked-results
      ((lib (library-library-lemma (h1-tactics-prover-library proof) name claim step conditions)))
    (h1-tactics-prover-with-library proof lib)))

(defun h1-book-order-step-lemma (proof name step conditions)
  (proof-with-checked-results ((claim (proof-step-first step)))
    (h1-book-order-lemma proof name claim step conditions)))

(defun h1-book-order-install-order-boolean-true (proof)
  (let* ((core (h1-tactics-prover-proof proof))
         (lib (h1-tactics-prover-library proof))
         (typed (list *h1-book-order-booleanp* *library-x*))
         (true (proof-eq *library-x* *proof-true*)))
    (proof-with-checked-results
        ((assumed (h1-arithmetic-proof-assume core typed t))
         (typed-equation (proof-proof-unfold core typed))
         (first (proof-proof-rewrite core assumed typed-equation '(1)))
         (literal (proof-step-first first))
         (test (proof-term-at literal 1))
         (test-equation (proof-proof-unfold core test))
         (first (proof-proof-rewrite core first test-equation '(1 1)))
         (not-true (h1-arithmetic-proof-assume core true nil))
         (false (h1-propositions-proof-prove-if core first not-true))
         (literal (proof-step-first false))
         (opened (proof-proof-unfold core literal))
         (false (proof-proof-rewrite core false opened '(1)))
         (false (proof-proof-tidy core false))
         (not-nil (proof-proof-not-nil core))
         (denied (h1-propositions-library-transport-argument lib not-nil false 1))
         (given (h1-arithmetic-proof-assume core *library-x* t))
         (cut (proof-proof-cut core given denied))
         (step (proof-proof-front core cut true)))
      (h1-book-order-lemma proof "ORDER-BOOLEAN-TRUE" true step
                           (list (proof-neg *library-x*) (proof-neg typed))))))

(defun h1-book-order-install-positive-exclusion (proof relation either-and-exclusive)
  (let* ((core (h1-tactics-prover-proof proof))
         (positive (library-positive *library-x*))
         (negative (library-lt *library-x* *proof-zero*))
         (exclusive (cadr either-and-exclusive)))
    (proof-with-checked-results
        ((literal (proof-step-first exclusive))
         (if-false (h1-arithmetic-proof-if-false core literal))
         (dismissed (proof-proof-rewrite core exclusive if-false '(1)))
         (dismissed (proof-proof-tidy core dismissed))
         (assumed (h1-arithmetic-proof-assume core positive t))
         (no-minus (proof-proof-discharge core dismissed assumed))
         (rewritten (proof-proof-rewrite core no-minus relation '(1 1)))
         (no-negative (proof-proof-tidy core rewritten)))
      (h1-book-order-lemma proof "POSITIVE-EXCLUDES-NEGATIVE" (proof-neg negative)
                           no-negative (list (proof-neg positive))))))

(defun h1-book-order-install-order-zero (proof relation either-sign)
  (let ((core (h1-tactics-prover-proof proof))
        (lib (h1-tactics-prover-library proof))
        (typed (h1-book-order-rational *library-x*))
        (pos (library-positive *library-x*))
        (negative (library-lt *library-x* *proof-zero*))
        (zero (proof-eq *library-x* *proof-zero*)))
    (proof-with-checked-results
        ((rational-to-number (proof-proof-fact core "rationalp-acl2-numberp" nil))
         (rational-evidence (h1-arithmetic-proof-assume core typed t))
         (number (h1-propositions-propositional-proof-modus-ponens lib rational-to-number rational-evidence))
         (possible (h1-propositions-propositional-proof-modus-ponens lib either-sign number))
         (not-pos (h1-arithmetic-proof-assume core pos nil))
         (nonpositive (h1-propositions-proof-prove-if core possible not-pos))
         (not-zero (h1-arithmetic-proof-assume core zero nil))
         (alternative (h1-propositions-proof-prove-if core nonpositive not-zero))
         (not-negative (h1-arithmetic-proof-assume core negative nil))
         (no-negation (h1-propositions-library-transport-argument lib not-negative relation 1))
         (cut (proof-proof-cut core alternative no-negation))
         (only-zero (proof-proof-front core cut zero)))
      (h1-book-order-lemma proof "ORDER-ZERO" zero only-zero (list (proof-neg typed) pos negative)))))

(defun h1-book-order-install-rational-positive-product (proof)
  (let ((lib (h1-tactics-prover-library proof)))
    (proof-with-checked-results
        ((axiom (library-library-axiom lib "POSITIVE" (list *library-x* *library-y*)))
         (both (h1-propositions-propositional-proof-conjunct lib axiom))
         (literal (proof-step-first (cadr both)))
         (condition (proof-term-at literal 1))
         (supplied (h1-tactics-prover-conjunction-assumption proof condition))
         (product-positive (h1-propositions-propositional-proof-modus-ponens lib (cadr both) supplied)))
      (h1-book-order-step-lemma
       proof "RATIONAL-POSITIVE-PRODUCT" product-positive
       (library-guards (list (h1-book-order-rational *library-x*) (h1-book-order-rational *library-y*)
                             (library-positive *library-x*) (library-positive *library-y*)))))))

(defun h1-book-order-install-signs (proof)
  (proof-with-checked-results
      ((proof (h1-book-order-install-order-boolean-true proof))
       (normalizer (h1-book-arithmetic-algebra-init proof nil nil))
       (relation (car (h1-book-order-by-difference proof (library-positive (library-minus *library-x*))
                                                    (library-lt *library-x* *proof-zero*) normalizer)))
       (proof (h1-book-order-step-lemma proof "NEGATIVE-AS-POSITIVE" relation nil))
       (lib (h1-tactics-prover-library proof))
       (axiom (library-library-axiom lib "TRICHOTOMY" (list *library-x*)))
       (both (h1-propositions-propositional-proof-conjunct lib axiom))
       (proof (h1-book-order-install-positive-exclusion proof relation both))
       (proof (h1-book-order-install-order-zero proof relation (car both))))
    (h1-book-order-install-rational-positive-product proof)))

(defun h1-book-order-boolean-argument-value (proof term typed holds)
  (let ((core (h1-tactics-prover-proof proof))
        (lib (h1-tactics-prover-library proof)))
    (proof-with-checked-results ((premise (h1-arithmetic-proof-assume core term holds)))
      (if holds
          (proof-with-checked-results ((type-evidence (h1-arithmetic-proof-assume core typed t)))
            (library-library-cite lib "ORDER-BOOLEAN-TRUE" (list term) (list premise type-evidence)))
        (h1-tactics-prover-false-equation proof premise)))))

(defun h1-book-order-install-boolean-equality-branch (x-holds y-holds proof conditions left right)
  (let ((core (h1-tactics-prover-proof proof))
        (lib (h1-tactics-prover-library proof)))
    (proof-with-checked-results
        ((left-step (h1-propositions-propositional-proof-reflexive lib left))
         (right-step (proof-proof-unfold core right))
         (x-value (h1-book-order-boolean-argument-value proof *library-x* (car conditions) x-holds))
         (left-step (h1-propositions-rewrite-value lib left-step x-value))
         (right-step (h1-propositions-rewrite-value lib right-step x-value))
         (y-value (h1-book-order-boolean-argument-value proof *library-y* (cadr conditions) y-holds))
         (left-step (h1-propositions-rewrite-value lib left-step y-value))
         (right-step (h1-propositions-rewrite-value lib right-step y-value))
         (left-value (proof-rewritten-term left-step))
         (left-constant (h1-tactics-prover-constant proof left-value))
         (left-step (proof-proof-chain core left-step (list left-constant)))
         (right-value (proof-rewritten-term right-step))
         (right-reduced (h1-propositions-proof-simplify core right-value nil nil))
         (right-step (proof-proof-chain core right-step (list right-reduced)))
         (reverse (h1-propositions-proof-symmetric core right-step)))
      (proof-proof-chain core left-step (list reverse)))))

(defun h1-book-order-install-boolean-equality-cases (proof conditions left right x-holds)
  (proof-with-checked-results
      ((yes (h1-book-order-install-boolean-equality-branch x-holds t proof conditions left right))
       (no (h1-book-order-install-boolean-equality-branch x-holds nil proof conditions left right)))
    (proof-proof-cases (h1-tactics-prover-proof proof) *library-y* yes no)))

(defun h1-book-order-register-boolean-facts (core facts rules)
  (declare (xargs :measure (acl2-count facts)))
  (if (endp facts)
      rules
    (let ((name (caar facts)))
      (if (and (equal (car name) "str") (text-starts-with (cadr name) "booleanp-"))
          (proof-with-checked-results
              ((step (proof-proof-fact core name nil))
               (rules (h1-tactics-rules-add-formula rules step t t)))
            (h1-book-order-register-boolean-facts core (cdr facts) rules))
        (h1-book-order-register-boolean-facts core (cdr facts) rules)))))

(defun h1-book-order-install-boolean-equality (proof)
  (let ((conditions (list (list *h1-book-order-booleanp* *library-x*)
                          (list *h1-book-order-booleanp* *library-y*)))
        (left (proof-eq *library-x* *library-y*))
        (right (list *h1-book-arithmetic-iff* *library-x* *library-y*)))
    (proof-with-checked-results
        ((yes (h1-book-order-install-boolean-equality-cases proof conditions left right t))
         (no (h1-book-order-install-boolean-equality-cases proof conditions left right nil))
         (result (proof-proof-cases (h1-tactics-prover-proof proof) *library-x* yes no))
         (proof (h1-book-order-step-lemma proof "BOOLEAN-EQUALITY-IFF" result (library-guards conditions)))
         (core (h1-tactics-prover-proof proof))
         (rules (h1-book-order-register-boolean-facts core (proof-proof-facts core)
                                                       (h1-tactics-prover-rules proof))))
      (h1-tactics-prover-with-rules proof rules))))

(defun h1-book-order-find-types (context predicate arguments)
  (declare (xargs :measure (acl2-count arguments)))
  (if (endp arguments)
      (cons nil context)
    (let ((found (h1-tactics-context-find context (list predicate (car arguments)))))
      (if (failure-p found)
          (cons found context)
        (let ((rest (h1-book-order-find-types (cdr found) predicate (cdr arguments))))
          (if (failure-p (car rest))
              rest
            (cons (cons (car found) (car rest)) (cdr rest))))))))

(defun h1-book-order-boolean-equality (proof formula)
  (if (not (proof-is-call formula *proof-equal*))
      '(:failure "unproved" "")
    (proof-with-checked-results ((equality (proof-term-at formula 1)))
      (if (not (proof-is-call equality *proof-equal*))
          '(:failure "unproved" "")
        (proof-with-checked-results ((iff (proof-term-at formula 2)))
          (let ((arguments (cdr equality)))
            (if (not (equal iff (cons *h1-book-arithmetic-iff* arguments)))
                '(:failure "unproved" "")
              (proof-with-checked-results
                  ((algebra (h1-book-arithmetic-algebra-init proof nil nil))
                   (typed (h1-book-order-find-types (h1-book-arithmetic-algebra-context algebra)
                                                    *h1-book-order-booleanp* arguments))
                   (steps (car typed)))
                (if (member-equal nil steps)
                    '(:failure "unproved" "")
                  (library-library-cite (h1-tactics-prover-library proof) "BOOLEAN-EQUALITY-IFF"
                                        arguments steps))))))))))

(defun h1-book-order-scale-sign (proof)
  (let* ((core (h1-tactics-prover-proof proof))
         (lib (h1-tactics-prover-library proof))
         (x *library-x*)
         (y *library-y*)
         (value (h1-book-order-product x y))
         (sign (library-lt y *proof-zero*))
         (pos-y (library-positive y)))
    (proof-with-checked-results
        ((rational-x (h1-arithmetic-proof-assume core (h1-book-order-rational x) t))
         (rational-y (h1-arithmetic-proof-assume core (h1-book-order-rational y) t))
         (pos-x (h1-arithmetic-proof-assume core (library-positive x) t))
         (negative (h1-arithmetic-proof-assume core sign t))
         (as-positive (library-library-cite lib "NEGATIVE-AS-POSITIVE" (list y) nil))
         (positive-negation (h1-propositions-proof-transport core negative as-positive))
         (rational-minus (proof-proof-fact core "rationalp-unary--" (list (list x y))))
         (rational-negation (h1-propositions-propositional-proof-modus-ponens lib rational-minus rational-y))
         (positive-product (library-library-cite
                            lib "RATIONAL-POSITIVE-PRODUCT" (list x (library-minus y))
                            (list rational-x rational-negation pos-x positive-negation)))
         (algebra (h1-book-arithmetic-algebra-init proof nil nil))
         (sign-of-product (car (h1-book-arithmetic-algebra-equality
                                algebra (h1-book-order-product x (library-minus y)) (library-minus value))))
         (positive-product (proof-proof-rewrite core positive-product sign-of-product '(1 2)))
         (positive-product (proof-proof-tidy core positive-product))
         (as-negative (library-library-cite lib "NEGATIVE-AS-POSITIVE" (list value) nil))
         (negative-scaled (proof-proof-rewrite core positive-product as-negative '(1)))
         (negative-scaled (proof-proof-tidy core negative-scaled))
         (negative-scaled-value (h1-book-order-boolean-value proof negative-scaled))
         (negative-value (h1-book-order-boolean-value proof negative))
         (negative-value (h1-propositions-proof-symmetric core negative-value))
         (yes (proof-proof-chain core negative-scaled-value (list negative-value)))
         (no-sign (h1-arithmetic-proof-assume core sign nil))
         (assumed-pos-y (h1-arithmetic-proof-assume core pos-y t))
         (product-pos (library-library-cite lib "RATIONAL-POSITIVE-PRODUCT" (list x y)
                                            (list rational-x rational-y pos-x assumed-pos-y)))
         (not-scaled-negative (library-library-cite lib "POSITIVE-EXCLUDES-NEGATIVE" (list value)
                                                     (list product-pos)))
         (not-scaled-value (h1-book-order-boolean-value proof not-scaled-negative))
         (no-sign-value (h1-book-order-boolean-value proof no-sign))
         (no-sign-reverse (h1-propositions-proof-symmetric core no-sign-value))
         (positive-branch (proof-proof-chain core not-scaled-value (list no-sign-reverse)))
         (not-pos-y (h1-arithmetic-proof-assume core pos-y nil))
         (zero (library-library-cite lib "ORDER-ZERO" (list y) (list rational-y not-pos-y no-sign)))
         (at-zero (library-library-axiom lib "H1-PRODUCT-ZERO" (list x)))
         (zero-reversed (h1-propositions-proof-symmetric core zero))
         (at-zero (proof-proof-rewrite core at-zero zero-reversed '(1 1 2)))
         (at-zero (proof-proof-tidy core at-zero))
         (zero-computed (proof-proof-compute core (library-lt *proof-zero* *proof-zero*) *proof-nil*))
         (at-zero-reversed (h1-propositions-proof-symmetric core at-zero))
         (zero-branch (proof-proof-rewrite core zero-computed at-zero-reversed '(1 1 1)))
         (zero-branch (proof-proof-tidy core zero-branch))
         (no-sign-value (h1-book-order-boolean-value proof no-sign))
         (no-sign-reverse (h1-propositions-proof-symmetric core no-sign-value))
         (zero-branch (proof-proof-chain core zero-branch (list no-sign-reverse)))
         (no (proof-proof-cases core pos-y positive-branch zero-branch)))
      (proof-proof-cases core sign yes no))))

(defun h1-book-order-install-integer-successor-bound (proof)
  (let* ((core (h1-tactics-prover-proof proof))
         (lib (h1-tactics-prover-library proof))
         (x *library-x*)
         (y *library-y*)
         (inside (library-lt x y))
         (delta (library-diff y x)))
    (proof-with-checked-results
        ((typed (library-library-ints lib (list x y)))
         (normalizer (h1-book-arithmetic-algebra-init proof nil typed))
         (sign (h1-book-order-by-difference proof (library-positive delta) inside normalizer))
         (sign-step (car sign))
         (delta-type (library-library-type-of lib delta typed))
         (given (h1-arithmetic-proof-assume core inside t))
         (delta-pos (h1-propositions-proof-transport core given sign-step))
         (one-or-more (h1-arithmetic-discrete lib delta-type delta-pos))
         (normalizer (h1-book-arithmetic-algebra-with-work (cdr sign) 150))
         (shifted (car (h1-book-order-by-difference proof (library-lt y (library-plus *proof-one* x))
                                                   (library-lt delta *proof-one*) normalizer)))
         (result (h1-propositions-library-transport-argument lib one-or-more shifted 1)))
      (h1-book-order-step-lemma proof "SUCCESSOR-WEAK-BOUND" result
                                (library-guards (list (library-integer x) (library-integer y) inside))))))

(defun h1-book-order-install-scale-comparison (proof label factor order requires)
  (let* ((core (h1-tactics-prover-proof proof))
         (lib (h1-tactics-prover-library proof))
         (rationals (list (h1-book-order-rational *library-x*) (h1-book-order-rational *library-y*)
                          (h1-book-order-rational *library-z*)))
         (conditions (append rationals (list requires)))
         (tests (seq-zip conditions '(t t t t)))
         (difference (library-diff (cadr order) (caddr order)))
         (new-value (h1-book-order-product factor difference))
         (lhs (library-lt (h1-book-order-product *library-x* *library-z*)
                          (h1-book-order-product *library-y* *library-z*))))
    (proof-with-checked-results
        ((normalizer (h1-book-arithmetic-algebra-init proof tests nil))
         (start (car (h1-book-order-by-difference proof lhs (library-lt new-value *proof-zero*) normalizer)))
         (normalizer (h1-book-arithmetic-algebra-init proof tests nil))
         (position-found (h1-tactics-context-find (h1-book-arithmetic-algebra-context normalizer)
                                                  (library-positive factor)))
         (position (if (equal factor *library-z*)
                       (car position-found)
                     (proof-with-checked-results
                         ((required (h1-arithmetic-proof-assume core requires t))
                          (negative (library-library-cite lib "NEGATIVE-AS-POSITIVE" (list *library-z*) nil)))
                       (h1-propositions-proof-transport core required negative))))
         (typed-factor (h1-tactics-context-find (cdr position-found) (h1-book-order-rational factor)))
         (typed-difference (h1-tactics-context-find (cdr typed-factor) (h1-book-order-rational difference)))
         (removal (library-library-cite lib "POSITIVE-SCALE-SIGN" (list factor difference)
                                       (list (car typed-factor) (car typed-difference) position)))
         (normalizer (h1-book-arithmetic-algebra-with-context normalizer (cdr typed-difference)))
         (finish (car (h1-book-order-by-difference proof (library-lt difference *proof-zero*) order normalizer)))
         (equality (proof-proof-chain core start (list removal finish))))
      (h1-book-order-step-lemma proof label equality (library-guards conditions)))))

(defun h1-book-order-install-order (proof)
  (proof-with-checked-results
      ((proof (h1-book-order-install-signs proof))
       (proof (h1-book-order-install-boolean-equality proof))
       (proof (h1-book-order-install-integer-successor-bound proof))
       (sign (h1-book-order-scale-sign proof))
       (proof (h1-book-order-step-lemma
               proof "POSITIVE-SCALE-SIGN" sign
               (library-guards (list (h1-book-order-rational *library-x*)
                                     (h1-book-order-rational *library-y*)
                                     (library-positive *library-x*)))))
       (proof (h1-book-order-install-scale-comparison
               proof "SCALE-COMPARISON-POSITIVE" *library-z* (library-lt *library-x* *library-y*)
               (library-positive *library-z*))))
    (h1-book-order-install-scale-comparison
     proof "SCALE-COMPARISON-NEGATIVE" (library-minus *library-z*) (library-lt *library-y* *library-x*)
     (library-lt *library-z* *proof-zero*))))

(defun h1-book-order-read-sign (literal)
  (let ((denied (proof-is-call literal *proof-not*)))
    (proof-with-checked-results ((order (if denied (proof-term-at literal 1) literal)))
      (if (not (proof-is-call order *proof-less*))
          nil
        (proof-with-checked-results ((left (proof-term-at order 1))
                                     (right (proof-term-at order 2)))
          (if (or (equal left right) (not (member-equal *proof-zero* (cdr order))))
              nil
            (if (equal right *proof-zero*)
                (list denied 1 left)
              (list denied 2 right))))))))

(defun h1-book-order-opposite-sign (proof step side value)
  (let ((core (h1-tactics-prover-proof proof))
        (lib (h1-tactics-prover-library proof)))
    (proof-with-checked-results
        ((excludes (library-library-cite lib "POSITIVE-EXCLUDES-NEGATIVE" (list value) nil)))
      (if (equal side 1)
          (proof-with-checked-results ((cut (proof-proof-cut core step excludes)))
            (proof-proof-front core cut (proof-neg (library-positive value))))
        (proof-proof-discharge core excludes step)))))

(defun h1-book-order-collect-signs (proof evidence missing extra)
  (declare (xargs :measure (acl2-count evidence)))
  (if (endp evidence)
      (cons missing extra)
    (let ((step (cdar evidence)))
      (if (not step)
          (h1-book-order-collect-signs proof (cdr evidence) missing extra)
        (proof-with-checked-results ((literal (proof-step-first step))
                                     (sign (h1-book-order-read-sign literal)))
          (if (not sign)
              (h1-book-order-collect-signs proof (cdr evidence) missing extra)
            (let ((denied (car sign))
                  (side (cadr sign))
                  (value (caddr sign)))
              (if denied
                  (let* ((sides (table-get missing value nil))
                         (missing (table-put missing value (table-put sides side step))))
                    (h1-book-order-collect-signs proof (cdr evidence) missing extra))
                (proof-with-checked-results
                    ((nonzero (h1-book-order-nonzero-from-sign proof step value))
                     (opposite (h1-book-order-opposite-sign proof step side value)))
                  (h1-book-order-collect-signs proof (cdr evidence) missing
                                               (cons opposite (cons nonzero extra))))))))))))

(defun h1-book-order-zero-with-opposite (proof value sides typed nonzero)
  (let* ((core (h1-tactics-prover-proof proof))
         (lib (h1-tactics-prover-library proof))
         (side (if (assoc-equal 1 sides) 2 1))
         (order (if (equal side 2) (library-positive value) (library-lt value *proof-zero*))))
    (proof-with-checked-results ((denied (h1-arithmetic-proof-assume core order nil)))
      (let ((absent (table-put sides side denied)))
        (proof-with-checked-results
            ((zero (library-library-cite lib "ORDER-ZERO" (list value)
                                         (list typed (table-get absent 2 nil) (table-get absent 1 nil))))
             (cut (proof-proof-cut core zero nonzero)))
          (proof-proof-front core cut order))))))

(defun h1-book-order-resolve-signs (proof context missing extra)
  (declare (xargs :measure (acl2-count missing)))
  (if (endp missing)
      (cons (reverse extra) context)
    (let* ((value (caar missing))
           (sides (cdar missing))
           (lib (h1-tactics-prover-library proof)))
      (proof-with-checked-results
          ((found (h1-tactics-context-find context (h1-book-order-rational value))))
        (let ((typed (car found))
              (context (cdr found)))
          (cond
           ((not typed) (h1-book-order-resolve-signs proof context (cdr missing) extra))
           ((equal (len sides) 2)
            (proof-with-checked-results
                ((zero (library-library-cite lib "ORDER-ZERO" (list value)
                                             (list typed (table-get sides 2 nil) (table-get sides 1 nil)))))
              (h1-book-order-resolve-signs proof context (cdr missing) (cons zero extra))))
           (t (proof-with-checked-results
                  ((found (h1-tactics-context-find context (proof-neg (proof-eq value *proof-zero*))))
                   (step (and (car found) (h1-book-order-zero-with-opposite proof value sides typed (car found)))))
                (h1-book-order-resolve-signs proof (cdr found) (cdr missing)
                                             (if step (cons step extra) extra))))))))))

(defun h1-book-order-insert-sign-steps (context steps)
  (declare (xargs :measure (acl2-count steps)))
  (if (endp steps)
      context
    (proof-with-checked-results ((literal (proof-step-first (car steps))))
      (let* ((evidence (h1-tactics-context-evidence context))
             (context (h1-tactics-context-with-evidence context (table-put evidence literal (car steps)))))
        (proof-with-checked-results ((context (h1-tactics-context-bind-equality context (car steps))))
          (h1-book-order-insert-sign-steps context (cdr steps)))))))

(defun h1-book-order-add-signed-evidence (proof normalizer)
  (let ((context (h1-book-arithmetic-algebra-context normalizer)))
    (proof-with-checked-results
        ((signs (h1-book-order-collect-signs proof (h1-tactics-context-evidence context) nil nil))
         (extra (h1-book-order-resolve-signs proof context (car signs) (cdr signs)))
         (context (h1-book-order-insert-sign-steps (cdr extra) (car extra))))
      (h1-book-arithmetic-algebra-with-context normalizer context))))

(defun h1-book-order-factors-from-signs (tests)
  (if (endp tests)
      nil
    (let ((test (car tests)))
      (append (and (proof-is-call test *proof-less*)
                   (member-equal *proof-zero* (cdr test))
                   (remove-equal *proof-zero* (cdr test)))
              (h1-book-order-factors-from-signs (cdr tests))))))

(defun h1-book-order-factors-from-operands (operands)
  (if (endp operands)
      nil
    (append (and (proof-is-call (car operands) *proof-times*) (cdar operands))
            (h1-book-order-factors-from-operands (cdr operands)))))

(defun h1-book-order-comparison-factors (left right context)
  (let ((signed (h1-book-order-factors-from-signs (table-keys (h1-tactics-context-evidence context)))))
    (proof-with-checked-results ((left (h1-arithmetic-term-tail left))
                                 (right (h1-arithmetic-term-tail right)))
      (proof-unique (append signed (h1-book-order-factors-from-operands (append left right)))))))

(defun h1-book-order-cite-scaled-order (proof operands factor values positive below)
  (let* ((lib (h1-tactics-prover-library proof))
         (a (car operands))
         (b (cadr operands)))
    (cond
     (positive
      (library-library-cite lib "SCALE-COMPARISON-POSITIVE" (list a b factor)
                            (append values (list positive))))
     (below
      (library-library-cite lib "SCALE-COMPARISON-NEGATIVE" (list b a factor)
                            (list (cadr values) (car values) (caddr values) below)))
     (t nil))))

; Each comparison visits a factor's two signs before considering the next factor.
(defun h1-book-order-scale-with-factor (proof source factor context)
  (if (integerp source)
      (cons '(:failure "failure" "") context)
    (let* ((typed (h1-book-order-find-types context *h1-book-order-rationalp*
                                           (append (cdr source) (list factor))))
           (values (car typed)))
      (cond
       ((failure-p values) typed)
       ((member-equal nil values) (cons nil (cdr typed)))
       (t
        (let ((pos (h1-tactics-context-find (cdr typed) (library-positive factor))))
          (if (failure-p pos)
              (cons pos (cdr typed))
            (let ((below (h1-tactics-context-find (cdr pos) (library-lt factor *proof-zero*))))
              (if (failure-p below)
                  (cons below (cdr pos))
                (cons (proof-with-checked-results ((operands (proof-list-of-length (cdr source) 2)))
                        (h1-book-order-cite-scaled-order proof operands factor values (car pos) (car below)))
                      (cdr below)))))))))))

(defun h1-book-order-chain-comparison (proof equation aligned reverse)
  (let ((core (h1-tactics-prover-proof proof)))
    (proof-with-checked-results
        ((symmetric (h1-propositions-proof-symmetric core equation))
         (found (proof-proof-chain core symmetric (list aligned))))
      (if reverse
          (proof-with-checked-results ((result (h1-propositions-proof-symmetric core found)))
            (proof-proof-tidy core result))
        found))))

(defun h1-book-order-compare-orders-direction (proof source target reverse factors normalizer)
  (declare (xargs :measure (acl2-count factors)))
  (if (endp factors)
      (cons nil normalizer)
    (let* ((scaled (h1-book-order-scale-with-factor
                    proof source (car factors) (h1-book-arithmetic-algebra-context normalizer)))
           (equation (car scaled))
           (normalizer (h1-book-arithmetic-algebra-with-context normalizer (cdr scaled))))
      (cond
       ((failure-p equation) (cons equation normalizer))
       ((not equation)
        (h1-book-order-compare-orders-direction proof source target reverse (cdr factors) normalizer))
       (t
        (let* ((normalizer (h1-book-arithmetic-algebra-with-work normalizer 150))
               (value (proof-with-checked-results ((literal (proof-step-first equation)))
                        (proof-term-at literal 1)))
               (aligned (if (failure-p value)
                            (cons value normalizer)
                          (h1-book-order-by-difference proof value target normalizer))))
          (cond
           ((h1-book-order-unproved-p (car aligned))
            (h1-book-order-compare-orders-direction proof source target reverse (cdr factors) (cdr aligned)))
           ((failure-p (car aligned)) aligned)
           (t (cons (h1-book-order-chain-comparison proof equation (car aligned) reverse)
                    (cdr aligned))))))))))

(defun h1-book-order-compare-orders (proof left right normalizer)
  (let ((difference (h1-book-order-by-difference proof left right normalizer)))
    (if (not (h1-book-order-unproved-p (car difference)))
        difference
      (let* ((normalizer (cdr difference))
             (factors (h1-book-order-comparison-factors left right
                                                       (h1-book-arithmetic-algebra-context normalizer))))
        (if (failure-p factors)
            (cons factors normalizer)
          (let ((forward (h1-book-order-compare-orders-direction proof left right nil factors normalizer)))
            (if (car forward)
                forward
              (let ((backward (h1-book-order-compare-orders-direction proof right left t factors (cdr forward))))
                (if (car backward)
                    backward
                  (cons '(:failure "unproved" "")
                        (cdr backward)))))))))))

(defun h1-book-order-computed-order-finish (proof step expanded difference)
  (let ((core (h1-tactics-prover-proof proof)))
    (proof-with-checked-results
        ((value (proof-rewritten-term difference))
         (computed (h1-tactics-prover-constant proof (library-lt value *proof-zero*))))
      (if (not computed)
          nil
        (proof-with-checked-results ((reduced (proof-proof-rewrite core expanded difference '(1 2 1))))
          (proof-proof-chain core step (list reduced computed)))))))

(defun h1-book-order-computed-order (proof step normalizer)
  (let ((expanded (proof-with-checked-results ((order (proof-rewritten-term step)))
                    (if (integerp order)
                        '(:failure "failure" "")
                      (library-library-axiom (h1-tactics-prover-library proof) "<-ON-OTHERS" (cdr order))))))
    (if (failure-p expanded)
        (cons expanded normalizer)
      (let* ((normalizer (h1-book-arithmetic-algebra-with-work normalizer 150))
             (argument (proof-with-checked-results ((right (proof-rewritten-term expanded)))
                         (proof-term-at right 1))))
        (if (failure-p argument)
            (cons argument normalizer)
          (let ((difference (h1-book-arithmetic-algebra-normal normalizer argument)))
            (if (failure-p (car difference))
                difference
              (cons (h1-book-order-computed-order-finish proof step expanded (car difference))
                    (cdr difference)))))))))

(defun h1-book-order-computed-value (computed value)
  (if (or (not computed) (failure-p computed))
      computed
    (proof-with-checked-results ((right (proof-rewritten-term computed)))
      (and (equal right value) computed))))

(defun h1-book-order-compare-value-factors (proof order value factors normalizer)
  (declare (xargs :measure (acl2-count factors)))
  (if (endp factors)
      (cons nil normalizer)
    (let* ((scaled (h1-book-order-scale-with-factor
                    proof order (car factors) (h1-book-arithmetic-algebra-context normalizer)))
           (step (car scaled))
           (normalizer (h1-book-arithmetic-algebra-with-context normalizer (cdr scaled))))
      (if (not step)
          (h1-book-order-compare-value-factors proof order value (cdr factors) normalizer)
        (let* ((reversed (proof-with-checked-results ((step step))
                           (h1-propositions-proof-symmetric (h1-tactics-prover-proof proof) step)))
               (computed (if (failure-p reversed)
                             (cons reversed normalizer)
                           (h1-book-order-computed-order proof reversed normalizer)))
               (matched (h1-book-order-computed-value (car computed) value)))
          (if matched
              (cons matched (cdr computed))
            (h1-book-order-compare-value-factors proof order value (cdr factors) (cdr computed))))))))

(defun h1-book-order-compare-value-candidate (proof order candidate bounded normalizer)
  (let* ((normalizer (h1-book-arithmetic-algebra-with-work normalizer 150))
         (reduced (h1-book-order-compare-orders proof order candidate normalizer)))
    (if (failure-p (car reduced))
        reduced
      (cons (proof-with-checked-results ((known-value (h1-book-order-boolean-value proof bounded)))
              (proof-proof-chain (h1-tactics-prover-proof proof) (car reduced) (list known-value)))
            (cdr reduced)))))

(defun h1-book-order-compare-value-bounds (proof order value evidence normalizer)
  (declare (xargs :measure (acl2-count evidence)))
  (if (endp evidence)
      (cons '(:failure "unproved" "") normalizer)
    (let* ((bounded (cdar evidence))
           (candidate (and bounded
                           (proof-with-checked-results ((literal (proof-step-first bounded)))
                             (if (equal value *proof-true*)
                                 literal
                               (and (proof-is-call literal *proof-not*) (proof-term-at literal 1)))))))
      (cond
       ((failure-p candidate) (cons candidate normalizer))
       ((not (proof-is-call candidate *proof-less*))
        (h1-book-order-compare-value-bounds proof order value (cdr evidence) normalizer))
       (t
        (let ((result (h1-book-order-compare-value-candidate proof order candidate bounded normalizer)))
          (if (h1-book-order-unproved-p (car result))
              (h1-book-order-compare-value-bounds proof order value (cdr evidence) (cdr result))
            result)))))))

(defun h1-book-order-compare-value-unknown (proof order value normalizer)
  (let* ((refl (h1-propositions-propositional-proof-reflexive (h1-tactics-prover-library proof) order))
         (computed (if (failure-p refl) (cons refl normalizer)
                     (h1-book-order-computed-order proof refl normalizer)))
         (matching (h1-book-order-computed-value (car computed) value)))
    (if matching
        (cons matching (cdr computed))
      (let* ((normalizer (cdr computed))
             (context (h1-book-arithmetic-algebra-context normalizer))
             (factors (h1-book-order-comparison-factors order order context)))
        (if (failure-p factors)
            (cons factors normalizer)
          (let ((scaled (h1-book-order-compare-value-factors proof order value factors normalizer)))
            (if (car scaled)
                scaled
              (h1-book-order-compare-value-bounds
               proof order value
               (h1-tactics-context-evidence (h1-book-arithmetic-algebra-context (cdr scaled)))
               (cdr scaled)))))))))

(defun h1-book-order-compare-value (proof order value normalizer)
  (let ((known (h1-tactics-context-find (h1-book-arithmetic-algebra-context normalizer)
                                       (if (equal value *proof-true*) order (proof-neg order)))))
    (if (failure-p known)
        (cons known normalizer)
      (let ((normalizer (h1-book-arithmetic-algebra-with-context normalizer (cdr known))))
        (if (car known)
            (cons (h1-book-order-boolean-value proof (car known)) normalizer)
          (h1-book-order-compare-value-unknown proof order value normalizer))))))
