(in-package "BOYMOO-PROVER")

(set-verify-guards-eagerness 0)

(defun h1-book-expt-order-signed-tests (terms)
  (declare (xargs :measure (acl2-count terms)))
  (if (endp terms)
      nil
    (cons (list (car terms) t) (h1-book-expt-order-signed-tests (cdr terms)))))

(defun h1-book-expt-order-step-term (step index)
  (proof-with-checked-results ((literal (proof-step-first step)))
    (proof-term-at literal index)))

(defun h1-book-expt-order-bindings (pairs bindings)
  (declare (xargs :measure (acl2-count pairs)))
  (if (endp pairs)
      bindings
    (proof-with-checked-results ((pair (proof-list-of-length (car pairs) 2)))
      (h1-book-expt-order-bindings
       (cdr pairs) (table-put bindings (car pair) (cadr pair))))))

(defun h1-book-expt-order-require-all (normalizer tests)
  (declare (xargs :measure (acl2-count tests)))
  (if (endp tests)
      (cons nil normalizer)
    (proof-with-checked-results
        ((answer (h1-book-field-require normalizer (car tests)))
         (step (car answer))
         (rest (h1-book-expt-order-require-all (cdr answer) (cdr tests))))
      (cons (cons step (car rest)) (cdr rest)))))

(defun h1-book-expt-order-context-find (normalizer term)
  (proof-with-checked-results
      ((answer (h1-tactics-context-find
                (h1-book-arithmetic-algebra-context normalizer) term))
       (step (car answer)))
    (cons step (h1-book-arithmetic-algebra-with-context normalizer (cdr answer)))))

(defun h1-book-expt-order-install-transitivity (prover)
  (let* ((lib (h1-tactics-prover-library prover))
         (proof (h1-tactics-prover-proof prover))
         (x *library-x*)
         (y *library-y*)
         (z *library-z*)
         (xy (library-lt x y))
         (yz (library-lt y z))
         (xz (library-lt x z))
         (conditions (list (h1-book-order-rational x) (h1-book-order-rational y)
                           (h1-book-order-rational z) xy yz))
         (a (library-diff y x))
         (b (library-diff z y))
         (total (library-diff z x)))
    (proof-with-checked-results
        ((norm (h1-book-field-field-normalizer prover (h1-book-expt-order-signed-tests conditions)))
         (assumed-xy (h1-arithmetic-proof-assume proof xy t))
         (first-difference (h1-book-order-by-difference prover (library-positive a) xy norm))
         (first-equation (car first-difference))
         (first (h1-propositions-proof-transport proof assumed-xy first-equation))
         (norm (h1-book-arithmetic-algebra-with-work (cdr first-difference) 150))
         (assumed-yz (h1-arithmetic-proof-assume proof yz t))
         (second-difference (h1-book-order-by-difference prover (library-positive b) yz norm))
         (second-equation (car second-difference))
         (second (h1-propositions-proof-transport proof assumed-yz second-equation))
         (combined (h1-book-order-positive-sum prover a b first second))
         (norm (h1-book-arithmetic-algebra-with-work (cdr second-difference) 150))
         (delta (h1-book-arithmetic-algebra-equality norm (library-plus a b) total))
         (delta-equation (car delta))
         (combined (proof-proof-rewrite proof combined delta-equation '(1 2)))
         (combined (proof-proof-tidy proof combined))
         (norm (h1-book-arithmetic-algebra-with-work (cdr delta) 150))
         (last-difference (h1-book-order-by-difference prover xz (library-positive total) norm))
         (last-equation (car last-difference))
         (step (h1-propositions-proof-transport proof combined last-equation))
         (claim (proof-step-first step))
         (lib (library-library-lemma lib "RATIONAL-LESS-TRANSITIVE" claim step
                                     (library-guards conditions))))
      (h1-tactics-prover-with-library prover lib))))

(defun h1-book-expt-order-positive-base (prover base norm)
  (let ((arguments (list *proof-zero* *proof-one* base)))
    (proof-with-checked-results
        ((evidence (h1-book-expt-order-require-all
                    norm (list (h1-book-order-rational *proof-zero*)
                               (h1-book-order-rational *proof-one*)
                               (h1-book-order-rational base)
                               (library-lt *proof-zero* *proof-one*)
                               (library-lt *proof-one* base))))
         (step (library-library-cite (h1-tactics-prover-library prover)
                                     "RATIONAL-LESS-TRANSITIVE" arguments (car evidence))))
      (cons step (cdr evidence)))))

(defun h1-book-expt-order-scale (prover bound multiplier sign norm)
  (proof-with-checked-results
      ((literal (proof-step-first bound))
       (terms (proof-list-of-length (cdr literal) 2))
       (evidence (h1-book-expt-order-require-all
                  norm (list (h1-book-order-rational (car terms))
                             (h1-book-order-rational (cadr terms))
                             (h1-book-order-rational multiplier))))
       (equality (library-library-cite
                  (h1-tactics-prover-library prover) "SCALE-COMPARISON-POSITIVE"
                  (append terms (list multiplier)) (append (car evidence) (list sign))))
       (step (h1-propositions-proof-transport (h1-tactics-prover-proof prover) bound equality)))
    (cons step (cdr evidence))))

(defun h1-book-expt-order-factor-sign (prover factor norm)
  (let ((goal (library-positive factor)))
    (proof-with-checked-results ((answer (h1-book-expt-order-context-find norm goal)))
      (if (car answer)
          answer
        (proof-with-checked-results
            ((compared (h1-book-order-compare-value prover goal *proof-true* (cdr answer)))
             (equality (car compared))
             (sign (proof-proof-true-from-eq (h1-tactics-prover-proof prover) equality)))
          (cons sign (cdr compared)))))))

(defun h1-book-expt-order-positive-power-branch (prover term formula zip-test holds countdown)
  (let* ((lib (h1-tactics-prover-library prover))
         (proof (h1-tactics-prover-proof prover))
         (premise (cadr formula))
         (descent (cadr countdown)))
    (proof-with-checked-results
        ((norm (h1-book-field-field-normalizer
                prover (list (list premise t) (list zip-test nil)
                             (list (library-positive *library-y*) holds))))
         (opened (h1-book-expt-open-power prover term norm))
         (product (h1-book-expt-order-step-term (car opened) 2))
         (parts (proof-list-of-length product 3))
         (descent-literal (proof-step-first descent))
         (bindings (h1-book-expt-order-bindings (car countdown) nil))
         (child-formula (proof-subst formula bindings))
         (assumed (h1-arithmetic-proof-assume proof (proof-ite descent-literal child-formula *proof-true*) t))
         (smaller (h1-propositions-proof-prove-if proof assumed descent))
         (premise-step (h1-arithmetic-proof-assume proof premise t))
         (smaller (h1-propositions-propositional-proof-modus-ponens lib smaller premise-step))
         (sign (h1-book-expt-order-factor-sign prover (cadr parts) (cdr opened)))
         (typed (h1-book-expt-order-require-all
                 (cdr sign) (list (h1-book-order-rational (cadr parts))
                                  (h1-book-order-rational (caddr parts)))))
         (positive (library-library-cite lib "RATIONAL-POSITIVE-PRODUCT" (cdr parts)
                                         (append (car typed) (list (car sign) smaller))))
         (step (h1-propositions-library-transport-argument lib positive (car opened) 2)))
      (h1-propositions-propositional-proof-implies-from lib formula step))))

(defun h1-book-expt-order-install-positive-power (prover)
  (let* ((lib (h1-tactics-prover-library prover))
         (rational (h1-book-order-rational *library-x*))
         (positive (library-positive *library-x*))
         (premise (proof-ite rational positive *proof-false*))
         (term (h1-book-expt-sum-power *library-x* *library-y*))
         (goal (library-positive term))
         (formula (list *library-implies* premise goal))
         (zip-test (list *h1-arithmetic-zip* *library-y*)))
    (proof-with-checked-results
        ((norm (h1-book-field-field-normalizer prover (list (list premise t) (list zip-test t))))
         (unit (h1-book-field-require norm (library-positive *proof-one*)))
         (unit-step (car unit))
         (opened (h1-book-expt-open-power prover term (cdr unit)))
         (base (h1-propositions-library-transport-argument lib unit-step (car opened) 2))
         (base (h1-propositions-propositional-proof-implies-from lib formula base))
         (countdowns (h1-book-expt-signed-countdowns prover *library-y*))
         (countdowns-data (car countdowns))
         (prover (cdr countdowns))
         (lib (h1-tactics-prover-library prover))
         (proof (h1-tactics-prover-proof prover))
         (measure (car countdowns-data))
         (cases (cadr countdowns-data))
         (down (h1-book-expt-order-positive-power-branch prover term formula zip-test t (car cases)))
         (up (h1-book-expt-order-positive-power-branch prover term formula zip-test nil (cadr cases)))
         (sign-split (proof-proof-cases proof (library-positive *library-y*) down up))
         (split (proof-proof-cases proof zip-test base sign-split))
         (ordinal (descent-measure-ordinal lib measure))
         (induction (proof-proof-induct proof ordinal split formula measure
                                        (list (caar cases) (caadr cases))))
         (premise-step (h1-tactics-prover-conjunction-assumption prover premise))
         (result (h1-propositions-propositional-proof-modus-ponens lib induction premise-step))
         (lib (library-library-lemma lib "POSITIVE-POWER" goal result
                                     (list (proof-neg rational) (proof-neg positive)))))
      (h1-tactics-prover-with-library prover lib))))

(defun h1-book-expt-order-power-above-one-zero (prover norm expanded zero-test)
  (let ((lib (h1-tactics-prover-library prover))
        (proof (h1-tactics-prover-proof prover)))
    (proof-with-checked-results
        ((zero (h1-arithmetic-proof-assume proof zero-test t))
         (unit (h1-book-expt-sum-power-at-zero prover *library-x* zero))
         (at-zero (proof-proof-rewrite proof expanded unit '(1 2 2)))
         (value (h1-book-expt-order-step-term at-zero 2))
         (reduced (h1-book-arithmetic-algebra-equality norm value *library-x*))
         (equation (car reduced))
         (at-zero (proof-proof-chain proof at-zero (list equation)))
         (above-one (h1-book-field-require (cdr reduced) (library-lt *proof-one* *library-x*)))
         (above-one-step (car above-one))
         (yes (h1-propositions-library-transport-argument lib above-one-step at-zero 2)))
      (cons yes (cdr above-one)))))

(defun h1-book-expt-order-power-above-one-child (prover norm formula countdown previous int-y pos-y)
  (let* ((lib (h1-tactics-prover-library prover))
         (proof (h1-tactics-prover-proof prover))
         (zero-test (proof-eq previous *proof-zero*)))
    (proof-with-checked-results
        ((not-zero (h1-book-order-nonzero-from-sign prover pos-y *library-y*))
         (no-zip (h1-book-expt-sum-not-zip prover *library-y* not-zero norm))
         (descent (proof-proof-discharge proof (cadr countdown) (car no-zip)))
         (descent (proof-proof-discharge proof descent pos-y))
         (descent-literal (proof-step-first descent))
         (bindings (h1-book-expt-order-bindings (car countdown) nil))
         (child-claim (proof-subst formula bindings))
         (hypothesis (h1-arithmetic-proof-assume proof (proof-ite descent-literal child-claim *proof-true*) t))
         (child-claim-proof (h1-propositions-proof-prove-if proof hypothesis descent))
         (nonnegative (h1-arithmetic-decrease-nonnegative lib *library-y* int-y pos-y nil))
         (rational (h1-book-field-require (cdr no-zip) (h1-book-order-rational previous)))
         (rational-step (car rational))
         (nonpositive (h1-arithmetic-proof-assume proof (library-positive previous) nil))
         (child-zero (library-library-cite lib "ORDER-ZERO" (list previous)
                                           (list rational-step nonpositive nonnegative)))
         (child-nonzero (h1-arithmetic-proof-assume proof zero-test nil))
         (cut (proof-proof-cut proof child-zero child-nonzero))
         (child-sign (proof-proof-front proof cut (library-positive previous)))
         (evidence (h1-book-expt-order-require-all
                    (cdr rational) (list (h1-book-order-rational *library-x*)
                                         (library-lt *proof-one* *library-x*)
                                         (library-integer previous))))
         (and-step (h1-arithmetic-conjunction lib (cadr child-claim)
                                              (append (car evidence) (list child-sign))))
         (step (h1-propositions-propositional-proof-modus-ponens lib child-claim-proof and-step)))
      (cons step (cdr evidence)))))

(defun h1-book-expt-order-power-above-one-scale (prover norm expanded child-above child sign)
  (let* ((lib (h1-tactics-prover-library prover))
         (proof (h1-tactics-prover-proof prover))
         (x *library-x*)
         (term (h1-book-expt-sum-power x *library-y*)))
    (proof-with-checked-results
        ((scaled (h1-book-expt-order-scale prover child-above x sign norm))
         (left (h1-book-arithmetic-algebra-equality
                (cdr scaled) (h1-book-order-product *proof-one* x) x))
         (left-equation (car left))
         (commute (library-library-axiom lib "COMMUTATIVITY-OF-*" (list child x)))
         (unexpanded (h1-propositions-proof-symmetric proof expanded))
         (right (proof-proof-chain proof commute (list unexpanded)))
         (multiplied (proof-proof-rewrite proof (car scaled) left-equation '(1 1)))
         (multiplied (proof-proof-rewrite proof multiplied right '(1 2)))
         (evidence (h1-book-expt-order-require-all
                    (cdr left) (list (h1-book-order-rational *proof-one*)
                                     (h1-book-order-rational x)
                                     (h1-book-order-rational term)
                                     (library-lt *proof-one* x)))))
      (library-library-cite lib "RATIONAL-LESS-TRANSITIVE" (list *proof-one* x term)
                            (append (car evidence) (list multiplied))))))

(defun h1-book-expt-order-install-power-above-one (prover)
  (let* ((x *library-x*)
         (y *library-y*)
         (rational (h1-book-order-rational x))
         (above-one (library-lt *proof-one* x))
         (integral (library-integer y))
         (positive (library-positive y))
         (conditions (list rational above-one integral positive))
         (premise (proof-ite rational (proof-ite above-one (proof-ite integral positive *proof-false*)
                                                *proof-false*) *proof-false*))
         (goal (library-lt *proof-one* (h1-book-expt-sum-power x y)))
         (formula (list *library-implies* premise goal)))
    (proof-with-checked-results
        ((norm (h1-book-field-field-normalizer prover (list (list premise t))))
         (base-sign (h1-book-expt-order-positive-base prover x norm))
         (sign (car base-sign))
         (nonzero (h1-book-order-nonzero-from-sign prover sign x))
         (norm (h1-book-field-remember (cdr base-sign) (list sign nonzero)))
         (types (h1-book-expt-order-require-all norm (list integral positive)))
         (countdowns (h1-book-expt-signed-countdowns prover y))
         (countdowns-data (car countdowns))
         (prover (cdr countdowns))
         (lib (h1-tactics-prover-library prover))
         (proof (h1-tactics-prover-proof prover))
         (norm (if (equal prover (h1-book-arithmetic-algebra-proof (cdr types)))
                   (cdr types)
                 (h1-book-arithmetic-algebra-with-proof (cdr types) prover)))
         (measure (car countdowns-data))
         (down (caadr countdowns-data))
         (bindings (h1-book-expt-order-bindings (car down) nil))
         (previous (if (assoc-equal y bindings) (cdr (assoc-equal y bindings))
                     '(:failure "failure" "")))
         (child (h1-book-expt-sum-power x previous))
         (expanded (h1-book-expt-sum-power-shift prover x previous y t norm))
         (zero-test (proof-eq previous *proof-zero*))
         (yes (h1-book-expt-order-power-above-one-zero prover (cdr expanded) (car expanded) zero-test))
         (child-above (h1-book-expt-order-power-above-one-child
                       prover (cdr yes) formula down previous (caar types) (cadar types)))
         (no (h1-book-expt-order-power-above-one-scale
              prover (cdr child-above) (car expanded) (car child-above) child sign))
         (cases (proof-proof-cases proof zero-test (car yes) no))
         (step (h1-propositions-propositional-proof-implies-from lib formula cases))
         (ordinal (descent-measure-ordinal lib measure))
         (induction (proof-proof-induct proof ordinal step formula measure (list (car down))))
         (premise-step (h1-tactics-prover-conjunction-assumption prover premise))
         (result (h1-propositions-propositional-proof-modus-ponens lib induction premise-step))
         (lib (library-library-lemma lib "POWER-ABOVE-ONE" goal result (library-guards conditions))))
      (h1-tactics-prover-with-library prover lib))))

(defun h1-book-expt-order-install-power-order (prover)
  (proof-with-checked-results
      ((fact (proof-proof-fact (h1-tactics-prover-proof prover)
                               (proof-sym "RATIONALP-EXPT-TYPE-PRESCRIPTION" "ACL2") nil))
       (rules (h1-tactics-rules-add-formula (h1-tactics-prover-rules prover) fact t t))
       (prover (h1-tactics-prover-with-rules prover rules))
       (prover (h1-book-expt-order-install-transitivity prover))
       (prover (h1-book-expt-order-install-positive-power prover)))
    (h1-book-expt-order-install-power-above-one prover)))

(defun h1-book-expt-order-strip-antecedents (formula antecedents)
  (declare (xargs :measure (acl2-count formula)))
  (cond ((not (proof-is-call formula *library-implies*)) (cons formula antecedents))
        ((consp (cddr formula))
         (h1-book-expt-order-strip-antecedents (caddr formula) (cons formula antecedents)))
        (t '(:failure "failure" ""))))

(defun h1-book-expt-order-antecedent-tests (antecedents tests)
  (declare (xargs :measure (acl2-count antecedents)))
  (if (endp antecedents)
      tests
    (h1-book-expt-order-antecedent-tests
     (cdr antecedents) (cons (list (cadar antecedents) t) tests))))

(defun h1-book-expt-order-all-powers (terms)
  (declare (xargs :measure (acl2-count terms)))
  (if (endp terms)
      t
    (and (proof-is-call (car terms) *h1-arithmetic-expt*)
         (h1-book-expt-order-all-powers (cdr terms)))))

(defun h1-book-expt-order-restore-antecedents (lib antecedents step)
  (declare (xargs :measure (acl2-count antecedents)))
  (if (endp antecedents)
      step
    (proof-with-checked-results
        ((step (h1-propositions-propositional-proof-implies-from lib (car antecedents) step)))
      (h1-book-expt-order-restore-antecedents lib (cdr antecedents) step))))

(defun h1-book-expt-order-monotonicity-finish (prover norm base i j first distance extra-power multiplied)
  (let ((lib (h1-tactics-prover-library prover))
        (proof (h1-tactics-prover-proof prover)))
    (proof-with-checked-results
        ((norm (h1-book-arithmetic-algebra-with-work norm 150))
         (unit (h1-book-arithmetic-algebra-equality norm (h1-book-order-product *proof-one* first) first))
         (unit-equation (car unit))
         (evidence (h1-book-expt-order-require-all
                    (cdr unit) (list (h1-book-expt-sum-number base)
                                     (proof-neg (proof-eq base *proof-zero*))
                                     (library-integer i) (library-integer distance))))
         (total (library-library-cite lib "EXPT-ADD" (list base i distance) (car evidence)))
         (exponent (h1-book-arithmetic-algebra-equality (cdr evidence) (library-plus i distance) j))
         (exponent-equation (car exponent))
         (total (proof-proof-rewrite proof total exponent-equation '(1 1 2)))
         (commuted (library-library-axiom lib "COMMUTATIVITY-OF-*" (list extra-power first)))
         (reversed (h1-propositions-proof-symmetric proof total))
         (to-second (proof-proof-chain proof commuted (list reversed)))
         (conclusion (proof-proof-rewrite proof multiplied unit-equation '(1 1))))
      (proof-proof-rewrite proof conclusion to-second '(1 2)))))

(defun h1-book-expt-order-monotonicity-proof (prover antecedents first base i j)
  (let* ((lib (h1-tactics-prover-library prover))
         (proof (h1-tactics-prover-proof prover))
         (distance (library-diff j i))
         (rational (h1-book-order-rational base))
         (extra-power (h1-book-expt-sum-power base distance)))
    (proof-with-checked-results
        ((norm (h1-book-field-field-normalizer prover (h1-book-expt-order-antecedent-tests antecedents nil)))
         (base-sign (h1-book-expt-order-positive-base prover base norm))
         (nonzero (h1-book-order-nonzero-from-sign prover (car base-sign) base))
         (norm (h1-book-field-remember (cdr base-sign) (list (car base-sign) nonzero)))
         (bound (h1-book-field-require norm (library-lt i j)))
         (bound-step (car bound))
         (bound-term (proof-step-first bound-step))
         (difference (h1-book-order-by-difference prover (library-positive distance) bound-term (cdr bound)))
         (difference-equation (car difference))
         (strictly-positive (h1-propositions-proof-transport proof bound-step difference-equation))
         (evidence (h1-book-expt-order-require-all
                    (cdr difference) (list rational (library-lt *proof-one* base) (library-integer distance))))
         (above-one (library-library-cite lib "POWER-ABOVE-ONE" (list base distance)
                                          (append (car evidence) (list strictly-positive))))
         (typed-base (h1-book-field-require (cdr evidence) rational))
         (typed-base-step (car typed-base))
         (first-sign (library-library-cite lib "POSITIVE-POWER" (list base i)
                                           (list typed-base-step (car base-sign))))
         (scaled (h1-book-expt-order-scale prover above-one first first-sign (cdr typed-base)))
         (conclusion (h1-book-expt-order-monotonicity-finish
                      prover (cdr scaled) base i j first distance extra-power (car scaled))))
      (h1-book-expt-order-restore-antecedents lib antecedents conclusion))))

(defun h1-book-expt-order-power-monotonicity (prover formula)
  (proof-with-checked-results ((parts (h1-book-expt-order-strip-antecedents formula nil)))
    (let ((goal (car parts)))
      (if (and (proof-is-call goal *proof-less*) (h1-book-expt-order-all-powers (cdr goal)))
          (proof-with-checked-results
              ((goal (proof-list-of-length goal 3))
               (first (proof-list-of-length (cadr goal) 3))
               (second (proof-list-of-length (caddr goal) 3)))
            (if (equal (cadr first) (cadr second))
                (h1-book-expt-order-monotonicity-proof
                 prover (cdr parts) first (cadr first) (caddr first) (caddr second))
              '(:failure "unproved" "")))
        '(:failure "unproved" "")))))
