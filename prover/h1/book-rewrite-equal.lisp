(in-package "BOYMOO-PROVER")
(set-verify-guards-eagerness 0)

(defconst *h1-book-rewrite-equal-substitute* (proof-sym "MY-SUBST-EXPR1" "ACL2"))
(defconst *h1-book-rewrite-equal-eval* (proof-sym "EQEV" "ACL2"))
(defconst *h1-book-rewrite-equal-eval-list* (proof-sym "EQEV-LST" "ACL2"))
(defconst *h1-book-rewrite-equal-kwote-list* (proof-sym "KWOTE-LST" "ACL2"))
(defconst *h1-book-rewrite-equal-environment* (proof-sym "ALIST" "ACL2"))
(defconst *h1-book-rewrite-equal-flag* (proof-sym "FLG" "ACL2"))
(defconst *h1-book-rewrite-equal-synp* (proof-sym "SYNP" "ACL2"))
(defconst *h1-book-rewrite-equal-atom* (proof-cl "ATOM"))
(defconst *h1-book-rewrite-equal-endp* (proof-cl "ENDP"))
(defconst *h1-book-rewrite-equal-quoted* (proof-quote *proof-quote*))

(defun h1-book-rewrite-equal-evaluated (term)
  (list *h1-book-rewrite-equal-eval* term *h1-book-rewrite-equal-environment*))

(defun h1-book-rewrite-equal-evaluated-list (terms)
  (list *h1-book-rewrite-equal-eval-list* terms *h1-book-rewrite-equal-environment*))

(defun h1-book-rewrite-equal-constraint (proof index expression)
  (let ((core (h1-tactics-prover-proof proof))
        (name (proof-sym (concatenate 'string "EQEV-CONSTRAINT-" (decimal-text index)) "ACL2")))
    (proof-with-checked-results
        ((fact (proof-proof-fact core name nil))
         (call (h1-book-list-size-step-at fact '(2 1)))
         (formals (h1-arithmetic-term-tail call))
         (actuals (h1-arithmetic-term-tail expression)))
      (proof-proof-instantiate core fact (seq-zip formals actuals)))))

(defun h1-book-rewrite-equal-on-cons (proof term)
  (proof-with-checked-results ((arguments (h1-arithmetic-term-tail term)))
    (proof-proof-fact (h1-tactics-prover-proof proof) "consp-cons"
                      (seq-zip (list *library-x* *library-y*) arguments))))

(defun h1-book-rewrite-equal-projections (proof equation term)
  (let ((library (h1-tactics-prover-library proof)))
    (proof-with-checked-results
        ((arguments (h1-arithmetic-term-tail term))
         (head (library-library-axiom library "CAR-CONS" arguments))
         (equation (h1-propositions-rewrite-value library equation head))
         (tail (library-library-axiom library "CDR-CONS" arguments)))
      (h1-propositions-rewrite-value library equation tail))))

(defun h1-book-rewrite-equal-refuted-quote (proof test)
  (let ((library (h1-tactics-prover-library proof))
        (core (h1-tactics-prover-proof proof)))
    (proof-with-checked-results
        ((assumed (h1-arithmetic-proof-assume core test nil))
         (unfolded (proof-proof-unfold core test))
         (literal (proof-proof-rewrite core assumed unfolded '(1 1)))
         (other (proof-term-at test 2))
         (reversed (library-library-axiom library "H1-EQUALITY-SYMMETRIC-VALUE"
                                          (list *h1-book-rewrite-equal-quoted* other))))
      (proof-proof-rewrite core literal reversed '(1 1)))))

(defun h1-book-rewrite-equal-requote (proof term cons-step unquoted)
  (let ((library (h1-tactics-prover-library proof)))
    (proof-with-checked-results
        ((rule (h1-book-rewrite-equal-constraint proof 0 (h1-book-rewrite-equal-evaluated term)))
         (syntax-test (h1-book-list-size-step-at rule '(1 2 1)))
         (syntax (h1-tactics-prover-solve proof syntax-test (list *h1-book-rewrite-equal-synp*) 160))
         (condition (h1-book-list-size-step-at rule '(1)))
         (premise (h1-arithmetic-conjunction library condition (list cons-step syntax unquoted))))
      (h1-propositions-propositional-proof-modus-ponens library rule premise))))

(defun h1-book-rewrite-equal-substitution-invariant-child
    (selector cons-step projection proof formula same)
  (let ((library (h1-tactics-prover-library proof))
        (core (h1-tactics-prover-proof proof)))
    (proof-with-checked-results
        ((built-in (library-library-builtin library (if (equal selector *library-car*) 2 3) *library-x*))
         (decline (proof-proof-discharge core built-in cons-step))
         (smaller (proof-subst formula (list (cons *library-x* (list selector *library-x*)))))
         (decline-claim (proof-step-first decline))
         (assumed (h1-arithmetic-proof-assume core (proof-ite decline-claim smaller *proof-true*) t))
         (given (h1-propositions-proof-prove-if core assumed decline))
         (parts (h1-propositions-propositional-proof-conjunct library given))
         (projected (h1-book-arithmetic-at parts (list projection))))
      (h1-propositions-propositional-proof-modus-ponens library projected same))))

(defun h1-book-rewrite-equal-substitution-invariant-restore (step expansion proof)
  (let ((core (h1-tactics-prover-proof proof)))
    (proof-with-checked-results ((symmetric (h1-propositions-proof-symmetric core expansion)))
      (proof-proof-rewrite core step symmetric '(1 1 1)))))

(defun h1-book-rewrite-equal-substitution-invariant (proof)
  (let* ((library (h1-tactics-prover-library proof))
         (core (h1-tactics-prover-proof proof))
         (term (list *h1-book-rewrite-equal-substitute* *proof-true* *library-y* *library-z* *library-x*))
         (terms (list *h1-book-rewrite-equal-substitute* *proof-false* *library-y* *library-z* *library-x*))
         (equivalent (proof-eq (h1-book-rewrite-equal-evaluated *library-y*)
                               (h1-book-rewrite-equal-evaluated *library-z*))))
    (proof-with-checked-results ((same (h1-arithmetic-proof-assume core equivalent t)))
      (let ((term-claim (list *library-implies* equivalent
                              (proof-eq (h1-book-rewrite-equal-evaluated term)
                                        (h1-book-rewrite-equal-evaluated *library-x*))))
            (list-claim (list *library-implies* equivalent
                              (proof-eq (h1-book-rewrite-equal-evaluated-list terms)
                                        (h1-book-rewrite-equal-evaluated-list *library-x*)))))
        (proof-with-checked-results
            ((formula (h1-book-cofactors-combine (list term-claim list-claim)))
             (measure (list *library-count* *library-x*))
             (expansion (proof-proof-unfold core term))
             (truth (h1-tactics-prover-quoted-truth proof *proof-true*))
             (original (h1-propositions-select-value library expansion truth))
             (replace-test (h1-book-list-size-step-at original '(2 1)))
             (replaced (h1-arithmetic-proof-assume core replace-test t))
             (replacing (h1-propositions-select-value library original replaced))
             (replaced (h1-arithmetic-proof-assume core replace-test t))
             (reversed (h1-propositions-proof-symmetric core replaced))
             (matching (proof-proof-rewrite core same reversed '(1 2 1)))
             (match-value (h1-book-rewrite-equal-substitution-invariant-restore matching replacing proof))
             (not-replaced (h1-arithmetic-proof-assume core replace-test nil))
             (otherwise-value (h1-propositions-select-value library original not-replaced))
             (atom-test (h1-book-list-size-step-at otherwise-value '(2 1)))
             (identity (h1-propositions-propositional-proof-reflexive
                        library (h1-book-rewrite-equal-evaluated *library-x*)))
             (atom-step (h1-arithmetic-proof-assume core atom-test t))
             (atom-expansion (h1-propositions-select-value library otherwise-value atom-step))
             (atom-value (h1-book-rewrite-equal-substitution-invariant-restore identity atom-expansion proof))
             (nonatomic (h1-arithmetic-proof-assume core atom-test nil))
             (cons-step (h1-book-termination-cons-from-nonatom proof nonatomic))
             (inner (h1-propositions-select-value library otherwise-value nonatomic))
             (quote-test (h1-book-list-size-step-at inner '(2 1)))
             (quoted (h1-arithmetic-proof-assume core quote-test t))
             (quote-expansion (h1-propositions-select-value library inner quoted))
             (quoted-value (h1-book-rewrite-equal-substitution-invariant-restore identity quote-expansion proof))
             (unquoted (h1-book-rewrite-equal-refuted-quote proof quote-test))
             (not-quoted (h1-arithmetic-proof-assume core quote-test nil))
             (application (h1-propositions-select-value library inner not-quoted))
             (constructed (h1-book-list-size-step-at application '(2)))
             (arguments (h1-arithmetic-term-tail constructed))
             (new-head (library-library-axiom library "CAR-CONS" arguments))
             (reversed (h1-propositions-proof-symmetric core new-head))
             (still-unquoted (proof-proof-rewrite core unquoted reversed '(1 1 1)))
             (initial (h1-book-rewrite-equal-requote proof *library-x* cons-step unquoted))
             (constructed-cons (h1-book-rewrite-equal-on-cons proof constructed))
             (altered (h1-book-rewrite-equal-requote proof constructed constructed-cons still-unquoted))
             (altered (h1-book-rewrite-equal-projections proof altered constructed))
             (child (h1-book-rewrite-equal-substitution-invariant-child *library-cdr* cons-step 1 proof formula same))
             (altered (h1-propositions-rewrite-value library altered child))
             (initial-reversed (h1-propositions-proof-symmetric core initial))
             (app-chain (proof-proof-chain core altered (list initial-reversed)))
             (application-value (h1-book-rewrite-equal-substitution-invariant-restore app-chain application proof))
             (not-atom-value (proof-proof-cases core quote-test quoted-value application-value))
             (different (proof-proof-cases core atom-test atom-value not-atom-value))
             (replace-cases (proof-proof-cases core replace-test match-value different))
             (term-case (h1-propositions-propositional-proof-implies-from library term-claim replace-cases))
             (expansion (proof-proof-unfold core terms))
             (not-nil (proof-proof-not-nil core))
             (list-expansion (h1-propositions-select-value library expansion not-nil))
             (end-test (h1-book-list-size-step-at list-expansion '(2 1)))
             (stop (h1-arithmetic-proof-assume core end-test t))
             (not-cons (h1-book-termination-endp-noncons proof stop))
             (rule (h1-book-rewrite-equal-constraint proof 4 (h1-book-rewrite-equal-evaluated-list *library-x*)))
             (empty-eq (h1-propositions-propositional-proof-modus-ponens library rule not-cons))
             (rule (h1-book-rewrite-equal-constraint proof 4 (h1-book-rewrite-equal-evaluated-list *proof-false*)))
             (false-noncons (h1-tactics-prover-solve proof (proof-neg (list *proof-consp* *proof-false*)) nil 160))
             (empty (h1-propositions-propositional-proof-modus-ponens library rule false-noncons))
             (empty-reversed (h1-propositions-proof-symmetric core empty-eq))
             (empty-chain (proof-proof-chain core empty (list empty-reversed)))
             (selected (h1-propositions-select-value library list-expansion stop))
             (empty-value (h1-book-rewrite-equal-substitution-invariant-restore empty-chain selected proof))
             (advance (h1-arithmetic-proof-assume core end-test nil))
             (cons-step (h1-book-termination-cons-from-nonatom proof advance))
             (expanded (h1-propositions-select-value library list-expansion advance))
             (values (h1-book-list-size-step-at expanded '(2)))
             (rule (h1-book-rewrite-equal-constraint proof 5 (h1-book-rewrite-equal-evaluated-list values)))
             (values-cons (h1-book-rewrite-equal-on-cons proof values))
             (changed (h1-propositions-propositional-proof-modus-ponens library rule values-cons))
             (changed (h1-book-rewrite-equal-projections proof changed values))
             (child (h1-book-rewrite-equal-substitution-invariant-child *library-car* cons-step 0 proof formula same))
             (changed (h1-propositions-rewrite-value library changed child))
             (child (h1-book-rewrite-equal-substitution-invariant-child *library-cdr* cons-step 1 proof formula same))
             (changed (h1-propositions-rewrite-value library changed child))
             (rule (h1-book-rewrite-equal-constraint proof 5 (h1-book-rewrite-equal-evaluated-list *library-x*)))
             (before (h1-propositions-propositional-proof-modus-ponens library rule cons-step))
             (before-reversed (h1-propositions-proof-symmetric core before))
             (list-chain (proof-proof-chain core changed (list before-reversed)))
             (list-value (h1-book-rewrite-equal-substitution-invariant-restore list-chain expanded proof))
             (end-cases (proof-proof-cases core end-test empty-value list-value))
             (list-case (h1-propositions-propositional-proof-implies-from library list-claim end-cases))
             (cases (h1-propositions-propositional-proof-conjoin library formula term-case list-case))
             (bindings (list (list (list *library-x* (list *library-car* *library-x*)))
                             (list (list *library-x* (list *library-cdr* *library-x*)))))
             (ordinal (descent-measure-ordinal library measure)))
          (proof-proof-induct core ordinal cases formula measure bindings))))))

(defun h1-book-rewrite-equal-flagged-branch (proof flagged holds implication typed)
  (let* ((library (h1-tactics-prover-library proof))
         (core (h1-tactics-prover-proof proof))
         (type-test (list (proof-sym typed "ACL2") *library-x*))
         (condition (if holds *h1-book-rewrite-equal-flag* (proof-neg *h1-book-rewrite-equal-flag*))))
    (proof-with-checked-results
        ((hypothesis (h1-book-list-size-step-at implication '(1)))
         (premise (h1-book-cofactors-combine (list type-test condition hypothesis)))
         (evidence (h1-arithmetic-proof-assume core premise t))
         (components (h1-book-cofactors-components proof evidence))
         (parts (proof-list-of-length components 3))
         (call (h1-book-list-size-step-at implication '(2 1 1)))
         (expanded (proof-proof-unfold core call))
         (branch (if holds (h1-tactics-prover-quoted-truth proof *proof-true*) (proof-proof-not-nil core)))
         (canonical (h1-propositions-select-value library expanded branch))
         (expanded (proof-proof-unfold core flagged))
         (evaluated (h1-propositions-select-value library expanded (cadr parts)))
         (reversed (h1-propositions-proof-symmetric core canonical))
         (equivalent (proof-proof-chain core evaluated (list reversed)))
         (equation (h1-propositions-propositional-proof-modus-ponens library implication (caddr parts)))
         (reversed (h1-propositions-proof-symmetric core equivalent))
         (step (proof-proof-rewrite core equation reversed '(1 1 1)))
         (claim (proof-step-first step)))
      (h1-propositions-propositional-proof-implies-from library (list *library-implies* premise claim) step))))

(defun h1-book-rewrite-equal-install-eval-substitution (proof)
  (proof-with-checked-results
      ((invariant (h1-book-rewrite-equal-substitution-invariant proof))
       (claim (proof-step-first invariant))
       (library (library-library-lemma (h1-tactics-prover-library proof)
                                      "EVAL-EXPRESSION-SUBSTITUTION" claim invariant nil))
       (proof (h1-tactics-prover-with-library proof library)))
    (let ((flagged (list *h1-book-rewrite-equal-substitute* *h1-book-rewrite-equal-flag*
                         *library-y* *library-z* *library-x*)))
      (proof-with-checked-results
          ((citation (library-library-cite library "EVAL-EXPRESSION-SUBSTITUTION" nil nil))
           (premises (h1-propositions-propositional-proof-conjunct library citation))
           (yes (h1-book-rewrite-equal-flagged-branch proof flagged t (car premises) "PSEUDO-TERMP"))
           (no (h1-book-rewrite-equal-flagged-branch proof flagged nil (cadr premises) "PSEUDO-TERM-LISTP"))
           (yes-claim (proof-step-first yes))
           (no-claim (proof-step-first no))
           (formula (h1-book-cofactors-combine (list yes-claim no-claim)))
           (result (h1-propositions-propositional-proof-conjoin library formula yes no))
           (record (h1-tactics-prover-record-formula proof "FLAGGED-EXPRESSION-SUBSTITUTION" result nil)))
        (cdr record)))))
