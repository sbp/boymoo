(in-package "BOYMOO-PROVER")
(set-verify-guards-eagerness 0)

(defconst *h4-terms-atom* (proof-cl "ATOM"))
(defconst *h4-terms-eq* (proof-cl "EQ"))
(defconst *h4-terms-eql* (proof-cl "EQL"))
(defconst *h4-terms-length* (proof-cl "LENGTH"))
(defconst *h4-terms-null* (proof-cl "NULL"))
(defconst *h4-terms-stringp* (proof-cl "STRINGP"))
(defconst *h4-terms-legal-name* (proof-sym "LEGAL-VARIABLE-OR-CONSTANT-NAMEP" "ACL2"))
(defconst *h4-terms-legal-variable* (proof-sym "LEGAL-VARIABLEP" "ACL2"))
(defconst *h4-terms-symbol-list* (proof-sym "SYMBOL-LISTP" "ACL2"))
(defconst *h4-terms-true-list* (proof-sym "TRUE-LISTP" "ACL2"))
(defconst *h4-terms-arglist* (proof-sym "ARGLISTP" "ACL2"))
(defconst *h4-terms-arglist1* (proof-sym "ARGLISTP1" "ACL2"))
(defconst *h4-terms-termp* (proof-sym "TERMP" "ACL2"))
(defconst *h4-terms-term-list* (proof-sym "TERM-LISTP" "ACL2"))
(defconst *h4-terms-pseudo-term* (proof-sym "PSEUDO-TERMP" "ACL2"))
(defconst *h4-terms-pseudo-list* (proof-sym "PSEUDO-TERM-LISTP" "ACL2"))

(defun h4-terms-literal-at (step index)
  (proof-with-checked-results ((literal (proof-step-first step)))
    (proof-term-at literal index)))

(defun h4-terms-simplify-evidence (p premise evidence expand)
  (proof-with-checked-results
      ((literal (proof-step-first premise))
       (reduction (h4-tactics-tactics-normalize p literal evidence expand nil nil)))
    (proof-proof-rewrite (library-library-proof p) premise reduction '(1))))

(defun h4-terms-cons-evidence (p nonatom)
  (let ((proof (library-library-proof p)))
    (proof-with-checked-results
        ((atom-test (h4-terms-literal-at nonatom 1))
         (opened (proof-proof-unfold proof atom-test))
         (body (h4-terms-literal-at opened 2))
         (cons-test (proof-term-at body 1))
         (assumed (proof-proof-assume proof cons-test nil))
         (opened (proof-proof-unfold proof atom-test))
         (negative (proof-proof-transport proof assumed opened))
         (joined (proof-proof-cut proof negative nonatom)))
      (proof-proof-front proof joined cons-test))))

(defun h4-terms-if-false-impossible (p goal contradiction)
  (proof-with-checked-results ((literal (proof-step-first contradiction)))
    (if (equal literal *proof-false*)
        (proof-proof-subsume (library-library-proof p) contradiction
                             (cons goal (cdr (proof-step-clause contradiction))))
      '(:failure "failure" ""))))

(defun h4-terms-legal-variables-accepted (holds p)
  (proof-with-checked-results
      ((step (proof-proof-fact (library-library-proof p)
                               (proof-sym "LEGAL-VARIABLE-OR-CONSTANT-NAMEP-IMPLIES-SYMBOLP" "ACL2")
                               nil)))
    (h4-tactics-tactics-from-contrapositive p step holds)))

(defun h4-terms-legal-variables-rejected (holds p valid goal)
  (proof-with-checked-results
      ((impossible (h4-terms-simplify-evidence
                    p valid (list holds) (list *h4-terms-legal-variable* *h4-terms-eq*))))
    (h4-terms-if-false-impossible p goal impossible)))

(defun h4-terms-legal-variables (p)
  (let* ((proof (library-library-proof p))
         (x *library-x*)
         (variable (list *h4-terms-legal-variable* x))
         (name (list *h4-terms-legal-name* x))
         (goal (list *h4-tactics-symbolp* x)))
    (proof-with-checked-results
        ((valid (proof-proof-assume proof variable t))
         (accepted (proof-proof-assume proof name t))
         (yes (h4-terms-legal-variables-accepted accepted p))
         (rejected (proof-proof-assume proof name nil))
         (no (h4-terms-legal-variables-rejected rejected p valid goal))
         (step (h4-tactics-tactics-case-of p goal name yes no)))
      (h4-tactics-tactics-local-lemma p "LEGAL-VARIABLE-SYMBOL" step))))

(defun h4-terms-induct-on-tail (p formula x atom)
  (let ((proof (library-library-proof p)))
    (proof-with-checked-results
        ((descent (library-library-builtin p 5 x))
         (smaller-formula (proof-subst formula (list (cons x (list *library-cdr* x)))))
         (test (proof-step-first descent))
         (assumed (proof-proof-assume proof (proof-ite test smaller-formula *proof-true*) t))
         (decrease (proof-proof-discharge proof descent atom)))
      (proof-proof-prove-if proof assumed decrease))))

(defun h4-terms-list-recognizer-atomic (empty p source-holds source atom goal target)
  (let ((proof (library-library-proof p)))
    (proof-with-checked-results
        ((nil-test (h4-terms-simplify-evidence
                    p source-holds (list empty) (list source *h4-terms-eq* *h4-terms-null*)))
         (opened (proof-proof-unfold proof atom))
         (nonatomic (proof-proof-rewrite proof empty opened '(1))))
      (h4-tactics-tactics-establish p goal (list empty nonatomic nil-test)
                                    (list target *h4-terms-eq*) nil nil))))

(defun h4-terms-list-recognizer-pair
    (nonempty p formula source-holds source implication-for-head goal target)
  (let ((proof (library-library-proof p))
        (x *library-x*))
    (proof-with-checked-results
        ((induction (h4-terms-induct-on-tail p formula x nonempty))
         (source-open (h4-terms-simplify-evidence p source-holds (list nonempty) (list source)))
         (parts (h4-tactics-tactics-conjunct p source-open))
         (recognized-tail (h4-tactics-tactics-modus-ponens p induction (cadr parts)))
         (element (if (or (not implication-for-head) (equal implication-for-head "")
                          (equal implication-for-head 0))
                      nil
                    (proof-proof-use proof implication-for-head (list (list x (list *library-car* x)))
                                     (list (car parts)))))
         (cons-test (h4-terms-cons-evidence p nonempty)))
      (h4-tactics-tactics-establish
       p goal (append (list nonempty cons-test recognized-tail) (if element (list element) nil))
       (list target) nil nil))))

(defun h4-terms-list-recognizer (p source target implication-for-head)
  (let* ((proof (library-library-proof p))
         (x *library-x*)
         (goal (list target x)))
    (proof-with-checked-results
        ((source-holds (proof-proof-assume proof (list source x) t))
         (source-test (proof-step-first source-holds))
         (formula (list *library-implies* source-test goal))
         (atom (list *h4-terms-atom* x))
         (empty (proof-proof-assume proof atom t))
         (yes (h4-terms-list-recognizer-atomic empty p source-holds source atom goal target))
         (nonempty (proof-proof-assume proof atom nil))
         (no (h4-terms-list-recognizer-pair
              nonempty p formula source-holds source implication-for-head goal target))
         (branches (h4-tactics-tactics-case-of p goal atom yes no))
         (case-step (h4-tactics-tactics-imply p formula branches))
         (ordinal (library-library-builtin p 1 x)))
      (proof-proof-induct proof ordinal case-step formula (list *library-count* x)
                          (list (list (list x (list *library-cdr* x))))))))

(defun h4-terms-length-on-true-lists-pair (nonempty p goal)
  (proof-with-checked-results
      ((fact (proof-proof-fact (library-library-proof p) "consp-not-stringp" nil))
       (not-string (h4-tactics-tactics-modus-ponens p fact nonempty)))
    (h4-tactics-tactics-normalize p (cadr goal) (list not-string) (list *h4-terms-length*) nil nil)))

(defun h4-terms-length-on-true-lists-nil (empty p premise goal)
  (proof-with-checked-results
      ((x-is-nil (h4-terms-simplify-evidence
                  p premise (list empty) (list *h4-terms-true-list* *h4-terms-eq*)))
       (not-string (h4-tactics-tactics-establish
                    p (proof-neg (list *h4-terms-stringp* *library-x*)) nil
                    (list *proof-not*) (list x-is-nil) nil)))
    (h4-tactics-tactics-normalize p (cadr goal) (list not-string) (list *h4-terms-length*) nil nil)))

(defun h4-terms-length-on-true-lists (p)
  (let* ((proof (library-library-proof p))
         (x *library-x*)
         (goal (proof-eq (list *h4-terms-length* x) (list *library-len* x)))
         (cons-test (list *proof-consp* x)))
    (proof-with-checked-results
        ((premise (proof-proof-assume proof (list *h4-terms-true-list* x) t))
         (nonempty (proof-proof-assume proof cons-test t))
         (yes (h4-terms-length-on-true-lists-pair nonempty p goal))
         (empty (proof-proof-assume proof cons-test nil))
         (no (h4-terms-length-on-true-lists-nil empty p premise goal))
         (step (h4-tactics-tactics-case-of p goal cons-test yes no)))
      (h4-tactics-tactics-local-lemma p "LENGTH-OF-LIST" step))))

(defun h4-terms-term-implies-pseudo-induction-descent (descendant nonatomic extra p x measure)
  (let ((proof (library-library-proof p))
        (function (list *library-car* x))
        (actuals (list *library-cdr* x)))
    (if (or (equal descendant function) (equal descendant actuals))
        (proof-with-checked-results
            ((decrease (library-library-builtin p (if (equal descendant function) 4 5) x)))
          (proof-proof-discharge proof decrease nonatomic))
      (proof-with-checked-results
          ((cons-test (h4-terms-cons-evidence p nonatomic))
           (hypotheses (descent-hypotheses-init p nil (cons cons-test extra)))
           (bound (descent-selector-chain p descendant x hypotheses))
           (comparison (library-library-ordinal-comparison p (list *library-count* descendant) measure)))
        (proof-proof-transport proof (car bound) comparison)))))

(defun h4-terms-term-implies-pseudo-induction (descendant premise-step nonatomic which extra p x both)
  (let* ((proof (library-library-proof p))
         (measure (list *library-count* x))
         (smaller (list *proof-ordinal-less* (list *library-count* descendant) measure)))
    (proof-with-checked-results
        ((descent (h4-terms-term-implies-pseudo-induction-descent descendant nonatomic extra p x measure))
         (formula (proof-subst both (list (cons x descendant))))
         (assumed (proof-proof-assume proof (proof-ite smaller formula *proof-true*) t))
         (hypothesis (proof-proof-prove-if proof assumed descent))
         (parts (h4-tactics-tactics-conjunct p hypothesis))
         (step (proof-term-at parts which)))
      (h4-tactics-tactics-modus-ponens p step premise-step))))

(defun h4-terms-term-implies-pseudo-term-at (child known nonatomic p x both)
  (h4-terms-term-implies-pseudo-induction child known nonatomic 0 nil p x both))

(defun h4-terms-term-implies-pseudo-list-at (child known nonatomic p x both)
  (h4-terms-term-implies-pseudo-induction child known nonatomic 1 nil p x both))

(defun h4-terms-term-list-implies-pseudo-term-at (child known nonatomic p)
  (declare (ignore nonatomic))
  (proof-with-checked-results
      ((theorem (proof-proof-fact (library-library-proof p)
                                  (proof-sym "TERMP-IMPLIES-PSEUDO-TERMP" "ACL2")
                                  (list (list *library-x* child)))))
    (h4-tactics-tactics-modus-ponens p theorem known)))

(defun h4-terms-term-list-implies-pseudo-list-at (child known nonatomic p x formula)
  (declare (ignore child))
  (proof-with-checked-results ((induction (h4-terms-induct-on-tail p formula x nonatomic)))
    (h4-tactics-tactics-modus-ponens p induction known)))

(defun h4-terms-pseudo-list-case-call (callback child known nonatomic p x)
  (case (car callback)
    (:term-implies-pseudo-term
     (h4-terms-term-implies-pseudo-term-at child known nonatomic p x (cadr callback)))
    (:term-implies-pseudo-list
     (h4-terms-term-implies-pseudo-list-at child known nonatomic p x (cadr callback)))
    (:term-list-implies-pseudo-term
     (h4-terms-term-list-implies-pseudo-term-at child known nonatomic p))
    (:term-list-implies-pseudo-list
     (h4-terms-term-list-implies-pseudo-list-at child known nonatomic p x (cadr callback)))
    (otherwise (cdr (assoc-equal (list child known nonatomic) callback)))))

(defun h4-terms-pseudo-list-case-atomic (empty p recognized goal)
  (proof-with-checked-results
      ((same (h4-terms-simplify-evidence p recognized (list empty) (list *h4-terms-term-list*))))
    (h4-tactics-tactics-establish p goal (list empty same) (list *h4-terms-pseudo-list*) nil nil)))

(defun h4-terms-pseudo-list-case-pair (nonempty p x recognized term-proof list-proof goal)
  (proof-with-checked-results
      ((opened (h4-terms-simplify-evidence p recognized (list nonempty) (list *h4-terms-term-list*)))
       (parts (h4-tactics-tactics-conjunct p opened))
       (head (h4-terms-pseudo-list-case-call term-proof (list *library-car* x) (car parts) nonempty p x))
       (tail (h4-terms-pseudo-list-case-call list-proof (list *library-cdr* x) (cadr parts) nonempty p x)))
    (h4-tactics-tactics-establish p goal (list nonempty head tail)
                                  (list *h4-terms-pseudo-list*) nil nil)))

(defun h4-terms-pseudo-list-case (p formula term-proof list-proof)
  (let ((proof (library-library-proof p)))
    (proof-with-checked-results
        ((parts (proof-list-of-length formula 3))
         (premise (cadr parts))
         (goal (caddr parts))
         (x (proof-term-at premise 1))
         (atom (list *h4-terms-atom* x))
         (recognized (proof-proof-assume proof premise t))
         (empty (proof-proof-assume proof atom t))
         (yes (h4-terms-pseudo-list-case-atomic empty p recognized goal))
         (nonempty (proof-proof-assume proof atom nil))
         (no (h4-terms-pseudo-list-case-pair nonempty p x recognized term-proof list-proof goal))
         (step (h4-tactics-tactics-case-of p goal atom yes no)))
      (h4-tactics-tactics-imply p formula step))))

(defun h4-terms-term-implies-pseudo-prove-from-valid (context p valid)
  (h4-terms-simplify-evidence p valid context (list *h4-terms-termp*)))

(defun h4-terms-term-implies-pseudo-variable (atomic p symbol x goal valid)
  (proof-with-checked-results
      ((known (h4-terms-term-implies-pseudo-prove-from-valid (list atomic) p valid))
       (is-symbol (proof-proof-use (library-library-proof p) symbol
                                  (list (list *library-x* x)) (list known))))
    (h4-tactics-tactics-establish p goal (list atomic is-symbol)
                                  (list *h4-terms-pseudo-term*) nil nil)))

(defun h4-terms-term-implies-pseudo-form-quoted (is-quoted p nonatomic goal valid)
  (let ((context (list nonatomic is-quoted)))
    (proof-with-checked-results
        ((shape (h4-terms-term-implies-pseudo-prove-from-valid context p valid)))
      (h4-tactics-tactics-establish p goal (append context (list shape))
                                    (list *h4-terms-pseudo-term*) nil nil))))

(defun h4-terms-term-implies-pseudo-form-function-call-named
    (named p nonatomic not-quote goal valid x both)
  (let ((context (list nonatomic not-quote named))
        (actuals (list *library-cdr* x)))
    (proof-with-checked-results
        ((known (h4-terms-term-implies-pseudo-prove-from-valid context p valid))
         (parts (h4-tactics-tactics-conjunct p known))
         (arity-checked (h4-tactics-tactics-conjunct p (cadr parts)))
         (pseudo-arguments (h4-terms-term-implies-pseudo-list-at actuals (car arity-checked) nonatomic p x both)))
      (h4-tactics-tactics-establish p goal (append context (list pseudo-arguments))
                                    (list *h4-terms-pseudo-term* *proof-not*) nil nil))))

(defun h4-terms-term-implies-pseudo-lambda-tests (n p constraint tests)
  (declare (xargs :measure (nfix n)))
  (if (zp n)
      '(:failure "Fuel" "h4-terms-term-implies-pseudo-lambda-tests")
    (proof-with-checked-results ((literal (proof-step-first constraint)))
      (if (proof-is-call literal *proof-if*)
          (proof-with-checked-results ((tail (proof-term-at literal 3)))
            (if (equal tail *proof-false*)
                (proof-with-checked-results ((parts (h4-tactics-tactics-conjunct p constraint)))
                  (h4-terms-term-implies-pseudo-lambda-tests
                   (1- n) p (cadr parts) (cons (car parts) tests)))
              (list constraint (reverse tests))))
        (list constraint (reverse tests))))))

(defun h4-terms-term-implies-pseudo-form-function-call-lambda-call-list-length
    (argument known p length-equation)
  (proof-proof-use (library-library-proof p) length-equation
                   (list (list *library-x* argument)) (list known)))

(defun h4-terms-term-implies-pseudo-form-function-call-lambda-call
    (anonymous p nonatomic not-quote goal valid x both argument-symbols true-symbols length-equation)
  (let* ((proof (library-library-proof p))
         (context (list nonatomic not-quote anonymous))
         (function (list *library-car* x))
         (actuals (list *library-cdr* x))
         (lambda-formals (list *library-car* (list *library-cdr* function)))
         (lambda-body (list *library-car* (list *library-cdr* (list *library-cdr* function)))))
    (proof-with-checked-results
        ((current (h4-terms-term-implies-pseudo-prove-from-valid context p valid))
         (parts (h4-tactics-tactics-conjunct p current))
         (tests-result (h4-terms-term-implies-pseudo-lambda-tests 1000000 p (car parts) nil))
         (constraint (car tests-result))
         (tests (proof-list-of-length (cadr tests-result) 8))
         (function-cons (car tests))
         (function-list (cadr tests))
         (lambda-marker (caddr tests))
         (function-length (cadddr tests))
         (formal-args (nth 4 tests))
         (lambda-term (nth 5 tests))
         (term-args (nth 7 tests))
         (formal-test (proof-step-first formal-args))
         (opened (proof-proof-unfold proof formal-test))
         (formals (proof-proof-rewrite proof formal-args opened '(1)))
         (formals-parts (h4-tactics-tactics-conjunct p formals))
         (head-fact (proof-proof-fact proof argument-symbols (list (list *library-x* lambda-formals))))
         (formals-symbols (h4-tactics-tactics-modus-ponens p head-fact (car formals-parts)))
         (list-fact (proof-proof-fact proof true-symbols (list (list *library-x* lambda-formals))))
         (formals-list (h4-tactics-tactics-modus-ponens p list-fact formals-symbols))
         (pseudo-body (h4-terms-term-implies-pseudo-induction
                       lambda-body lambda-term nonatomic 0 (list function-cons) p x both))
         (pseudo-args (h4-terms-term-implies-pseudo-list-at actuals term-args nonatomic p x both))
         (true-fact (proof-proof-fact proof (proof-sym "PSEUDO-TERM-LISTP-FORWARD-TO-TRUE-LISTP" "ACL2")
                                     (list (list *library-x* actuals))))
         (true-args (h4-tactics-tactics-modus-ponens p true-fact pseudo-args))
         (length-test (proof-step-first function-length))
         (opened (proof-proof-unfold proof length-test))
         (definition-length (proof-proof-rewrite proof function-length opened '(1)))
         (definition-length (proof-proof-symmetric proof definition-length))
         (length-fact (h4-terms-term-implies-pseudo-form-function-call-lambda-call-list-length
                       function function-list p length-equation))
         (length3 (proof-proof-rewrite proof definition-length length-fact '(1 1)))
         (constraint-test (proof-step-first constraint))
         (opened (proof-proof-unfold proof constraint-test))
         (same-length (proof-proof-rewrite proof constraint opened '(1)))
         (length-fact (h4-terms-term-implies-pseudo-form-function-call-lambda-call-list-length
                       lambda-formals formals-list p length-equation))
         (same-length (proof-proof-rewrite proof same-length length-fact '(1 1)))
         (length-fact (h4-terms-term-implies-pseudo-form-function-call-lambda-call-list-length
                       actuals true-args p length-equation))
         (same-length (proof-proof-rewrite proof same-length length-fact '(1 2))))
      (h4-tactics-tactics-establish
       p goal (append context (list function-list lambda-marker length3 formals-symbols
                                    pseudo-body pseudo-args same-length))
       (list *h4-terms-pseudo-term* *proof-not*) nil nil))))

(defun h4-terms-term-implies-pseudo-form-function-call
    (not-quote p nonatomic goal valid x both argument-symbols true-symbols length-equation)
  (let ((proof (library-library-proof p))
        (named-function (list *h4-tactics-symbolp* (list *library-car* x))))
    (proof-with-checked-results
        ((named (proof-proof-assume proof named-function t))
         (yes (h4-terms-term-implies-pseudo-form-function-call-named
               named p nonatomic not-quote goal valid x both))
         (anonymous (proof-proof-assume proof named-function nil))
         (no (h4-terms-term-implies-pseudo-form-function-call-lambda-call
              anonymous p nonatomic not-quote goal valid x both argument-symbols true-symbols length-equation)))
      (h4-tactics-tactics-case-of p goal named-function yes no))))

(defun h4-terms-term-implies-pseudo-form
    (nonatomic p goal valid x both argument-symbols true-symbols length-equation)
  (let ((proof (library-library-proof p))
        (is-quote (list *h4-terms-eq* (list *library-car* x) (proof-quote *proof-quote*))))
    (proof-with-checked-results
        ((is-quoted (proof-proof-assume proof is-quote t))
         (yes (h4-terms-term-implies-pseudo-form-quoted is-quoted p nonatomic goal valid))
         (not-quote (proof-proof-assume proof is-quote nil))
         (no (h4-terms-term-implies-pseudo-form-function-call
              not-quote p nonatomic goal valid x both argument-symbols true-symbols length-equation)))
      (h4-tactics-tactics-case-of p goal is-quote yes no))))

(defun h4-terms-term-implies-pseudo-cases (p formula symbol argument-symbols true-symbols length-equation)
  (let ((proof (library-library-proof p)))
    (proof-with-checked-results
        ((parts (proof-list-of-length formula 3))
         (premise (cadr parts))
         (goal (caddr parts))
         (arguments (proof-list-of-length (cdr premise) 2)))
      (let* ((x (car arguments))
             (world (cadr arguments))
             (term-list-formula (list *library-implies* (list *h4-terms-term-list* x world)
                                      (list *h4-terms-pseudo-list* x)))
             (both (proof-ite formula term-list-formula *proof-false*))
             (measure (list *library-count* x))
             (atom (list *h4-terms-atom* x))
             (function (list *library-car* x))
             (actuals (list *library-cdr* x))
             (lambda-body (list *library-car* (list *library-cdr* (list *library-cdr* function))))
             (substitutions (list (list (list x function)) (list (list x actuals))
                                  (list (list x lambda-body)))))
        (proof-with-checked-results
            ((valid (proof-proof-assume proof premise t))
             (atomic (proof-proof-assume proof atom t))
             (yes (h4-terms-term-implies-pseudo-variable atomic p symbol x goal valid))
             (nonatomic (proof-proof-assume proof atom nil))
             (no (h4-terms-term-implies-pseudo-form
                  nonatomic p goal valid x both argument-symbols true-symbols length-equation))
             (term-case (h4-tactics-tactics-case-of p goal atom yes no))
             (term-case (h4-tactics-tactics-imply p formula term-case))
             (list-case (h4-terms-pseudo-list-case p term-list-formula
                                                  (list :term-implies-pseudo-term both)
                                                  (list :term-implies-pseudo-list both)))
             (case-step (h4-tactics-tactics-conjunction p both term-case list-case))
             (ordinal (library-library-builtin p 1 x))
             (result (proof-proof-induct proof ordinal case-step both measure substitutions))
             (result (h4-tactics-tactics-conjunct p result)))
          (car result))))))

; The proof library constructs these entries with the Tactics rules for
; implication elimination and conjunction extraction.

(defun h4-terms-tactics-rational (library term evidence)
  (proof-with-checked-results
   ((axiom (library-library-axiom library "INTEGER-IMPLIES-RATIONAL" (list term)))
    (type-step (library-library-type-of library term evidence)))
   (h4-tactics-tactics-modus-ponens library axiom type-step)))

(defun h4-terms-tactics-number (library term evidence)
  (let ((proof (library-library-proof library)))
    (proof-with-checked-results
     ((fact (proof-proof-fact proof "rationalp-acl2-numberp" (list (list *library-x* term))))
      (rational (h4-terms-tactics-rational library term evidence)))
     (h4-tactics-tactics-modus-ponens library fact rational))))

(defun h4-terms-tactics-integer-closure-lemmas (library both recipes)
  (declare (xargs :measure (acl2-count recipes)))
  (if (endp recipes)
      library
    (let* ((recipe (car recipes))
           (head (car recipe))
           (axiom (cadr recipe))
           (name (caddr recipe))
           (x *library-x*)
           (y *library-y*))
      (proof-with-checked-results
       ((fact (library-inherited proof-proof-fact library axiom nil))
        (step (h4-tactics-tactics-modus-ponens library fact both))
        (library (library-library-lemma library name (library-integer (list head x y)) step
                                        (library-guards (list (library-integer x)
                                                              (library-integer y))))))
       (h4-terms-tactics-integer-closure-lemmas library both (cdr recipes))))))

(defun h4-terms-tactics-logic-and-types (library)
  (let* ((x *library-x*)
         (y *library-y*)
         (z *library-z*)
         (conditional (proof-ite x y z))
         (integer-x (library-integer x))
         (integer-y (library-integer y))
         (nat (list *library-natp* x))
         (cons-test (list *proof-consp* x))
         (ordinal (list *proof-ordinalp* x))
         (ordinal-lt (list *proof-ordinal-less* x y))
         (nfix (list *library-nfix* x))
         (gap (list *library-gap* x y)))
    (proof-with-checked-results
     ((middle (library-inherited proof-proof-excluded-middle library x))
      (library (library-library-lemma library "EXCLUDED-MIDDLE" (proof-neg x) middle (list x)))
      (when-false (library-inherited proof-proof-if-false library conditional))
      (library (library-library-lemma library "IF-FALSE" (proof-eq conditional z) when-false (list x)))
      (when-true (library-inherited proof-proof-if-true library conditional))
      (library (library-library-lemma library "IF-TRUE" (proof-eq conditional y) when-true
                                      (list (proof-neg x))))
      (integers (library-library-ints library (list x y)))
      (both (library-inherited proof-proof-prove library
                               (proof-ite integer-x integer-y *proof-false*) integers nil))
      (library (h4-terms-tactics-integer-closure-lemmas
                library both (list (list *proof-plus* "integerp-binary-+" "INTEGER-SUM")
                                   (list *proof-times* "integerp-binary-*" "INTEGER-PRODUCT"))))
      (negation (library-inherited proof-proof-fact library "integerp-unary--" nil))
      (step (h4-tactics-tactics-modus-ponens library negation (car integers)))
      (library (library-library-lemma library "INTEGER-NEGATION" (library-integer (library-minus x))
                                      step (list (proof-neg integer-x))))

      (nat-hyp (library-inherited proof-proof-assume library nat t))
      (opened (library-inherited proof-proof-unfold library nat))
      (nat-open (library-inherited proof-proof-rewrite library nat-hyp opened '(1)))
      (nat-parts (h4-tactics-tactics-conjunct library nat-open))
      (library (library-library-lemma library "NATURAL-INTEGER" integer-x (car nat-parts)
                                      (list (proof-neg nat))))
      (library (library-library-lemma library "NATURAL-NONNEGATIVE" (library-nonnegative x)
                                      (cadr nat-parts) (list (proof-neg nat))))
      (neg-x (library-inherited proof-proof-assume library (library-lt x *proof-zero*) nil))
      (bounded (library-inherited proof-proof-prove library nat (list (car integers) neg-x)
                                  (list *library-natp*)))
      (library (library-library-lemma library "NATURAL-FROM-BOUNDS" nat bounded
                                      (list (proof-neg integer-x) (library-lt x *proof-zero*))))

      (consp-fact (library-inherited proof-proof-fact library "consp-not-acl2-numberp" nil))
      (consp-hyp (library-inherited proof-proof-assume library cons-test t))
      (nonnumber (h4-tactics-tactics-modus-ponens library consp-fact consp-hyp))
      (numeric (library-inherited proof-proof-assume library (list *library-numberp* x) t))
      (finite (library-inherited proof-proof-cut library numeric nonnumber))
      (finite (library-inherited proof-proof-front library finite (proof-neg cons-test)))
      (number-finite (library-inherited proof-proof-prove library (list *library-o-finp* x)
                                        (list finite) (list *library-o-finp* (proof-cl "ATOM"))))
      (numeric-first (proof-step-first numeric))
      (library (library-library-lemma library "NUMBER-FINITE" (list *library-o-finp* x)
                                      number-finite (list (proof-neg numeric-first))))
      (number-x (h4-terms-tactics-number library x (list (car integers))))
      (integer-finite (library-library-cite library "NUMBER-FINITE" (list x) (list number-x)))
      (library (library-library-lemma library "INTEGER-FINITE" (list *library-o-finp* x)
                                      integer-finite (list (proof-neg integer-x))))

      (x-finite (library-library-cite library "INTEGER-FINITE" (list x) (list (car nat-parts))))
      (natural-ordinal (library-inherited proof-proof-prove library ordinal (list x-finite nat-hyp)
                                          (list *proof-ordinalp*)))
      (library (library-library-lemma library "NATURAL-ORDINAL" ordinal natural-ordinal
                                      (list (proof-neg nat))))
      (x-finite (library-library-cite library "INTEGER-FINITE" (list x) (list (car integers))))
      (y-finite (library-library-cite library "INTEGER-FINITE" (list y) (list (cadr integers))))
      (finite-order (library-inherited proof-proof-simplify library ordinal-lt (list x-finite y-finite)
                                       (list *proof-ordinal-less* *proof-not*)))
      (library (library-library-lemma library "FINITE-ORDER" (proof-eq ordinal-lt (library-lt x y))
                                      finite-order (library-guards (list integer-x integer-y))))

      (library (library-library-definition library *library-nfix* (list x) (proof-ite nat x *proof-zero*)))
      (good-eq (library-inherited proof-proof-simplify library nfix (list nat-hyp) (list *library-nfix*)))
      (good (library-library-transport-argument library nat-hyp good-eq 1))
      (zero-natural (library-inherited proof-proof-prove library (list *library-natp* *proof-zero*)
                                        nil (list *library-natp* *proof-not*)))
      (not-natural (library-inherited proof-proof-assume library nat nil))
      (bad-eq (library-inherited proof-proof-simplify library nfix (list not-natural) (list *library-nfix*)))
      (bad (library-library-transport-argument library zero-natural bad-eq 1))
      (cases (library-inherited proof-proof-cases library nat good bad))
      (library (library-library-lemma library "NFIX-NATURAL" (list *library-natp* nfix) cases nil))
      (fixed (library-inherited proof-proof-fact library (library-lemma-name "NFIX-NATURAL") nil))
      (nfix-integer (library-library-cite library "NATURAL-INTEGER" (list nfix) (list fixed)))
      (library (library-library-lemma library "NFIX-INTEGER" (library-integer nfix) nfix-integer nil))
      (nfix-ordinal (library-library-cite library "NATURAL-ORDINAL" (list nfix) (list fixed)))
      (library (library-library-lemma library "NFIX-ORDINAL" (list *proof-ordinalp* nfix) nfix-ordinal nil))
      (library (library-library-definition library *library-gap* (list x y)
                                           (list *library-nfix* (library-diff x y))))
      (difference-ordinal (library-library-cite library "NFIX-ORDINAL" (list (library-diff x y)) nil))
      (opened (library-inherited proof-proof-unfold library gap))
      (gap-ordinal (library-library-transport-argument library difference-ordinal opened 1)))
     (library-library-lemma library "GAP-ORDINAL" (list *proof-ordinalp* gap) gap-ordinal nil))))

(defun h4-terms-tactics-additive-identities (library)
  (let ((x *library-x*)
        (y *library-y*)
        (z *library-z*)
        (zero *proof-zero*)
        (fix (proof-sym "FIX" "ACL2")))
    (proof-with-checked-results
     ((ints (library-library-ints library (list x)))
      (left-zero (library-library-axiom library "UNICITY-OF-0" (list x)))
      (x-number (h4-terms-tactics-number library x ints))
      (fixed (library-inherited proof-proof-simplify library (list fix x) (list x-number) (list fix)))
      (left-zero (library-inherited proof-proof-chain library left-zero (list fixed)))
      (library (library-library-lemma library "ADD-ZERO-LEFT" (proof-eq (library-plus zero x) x)
                                      left-zero (list (proof-neg (library-integer x)))))
      (commute (library-library-axiom library "COMMUTATIVITY-OF-+" (list x zero)))
      (right-zero (library-inherited proof-proof-chain library commute (list left-zero)))
      (library (library-library-lemma library "ADD-ZERO-RIGHT" (proof-eq (library-plus x zero) x)
                                      right-zero (list (proof-neg (library-integer x)))))
      (assoc-step (library-library-axiom library "ASSOCIATIVITY-OF-+" (list x y z)))
      (step (library-inherited proof-proof-symmetric library assoc-step))
      (commute (library-library-axiom library "COMMUTATIVITY-OF-+" (list x y)))
      (step (library-inherited proof-proof-rewrite library step commute '(1 2 1)))
      (assoc-step (library-library-axiom library "ASSOCIATIVITY-OF-+" (list y x z)))
      (step (library-inherited proof-proof-chain library step (list assoc-step)))
      (library (library-library-lemma library "ADD-SWAP"
                                      (proof-eq (library-plus x (library-plus y z))
                                                (library-plus y (library-plus x z))) step nil))

      (inverse (library-library-axiom library "INVERSE-OF-+" (list x)))
      (commute (library-library-axiom library "COMMUTATIVITY-OF-+" (list (library-minus x) x)))
      (reverse (library-inherited proof-proof-chain library commute (list inverse)))
      (involution (library-additive-identities-inverse-unique (library-minus x) x reverse ints library))
      (involution (library-inherited proof-proof-symmetric library involution))
      (library (library-library-lemma library "DOUBLE-NEGATION"
                                      (proof-eq (library-minus (library-minus x)) x)
                                      involution (list (proof-neg (library-integer x)))))
      (ints (library-library-ints library (list x y))))
     (let ((a (library-plus x y))
           (b (library-plus (library-minus x) (library-minus y))))
       (proof-with-checked-results
        ((zero-sum (library-library-linear-equal library (library-plus a b) zero ints))
         (distribute (library-additive-identities-inverse-unique a b zero-sum ints library))
         (distribute (library-inherited proof-proof-symmetric library distribute)))
        (library-library-lemma library "NEGATE-SUM" (proof-eq (library-minus a) b) distribute
                               (library-guards (list (library-integer x) (library-integer y)))))))))

(defun h4-terms-tactics-tenfold-increase (library ix px)
  (let* ((proof (library-library-proof library))
         (nine (proof-quote 9))
         (ten (proof-quote 10))
         (times-x (list *proof-times* nine *library-x*))
         (fix (proof-sym "FIX" "ACL2")))
    (proof-with-checked-results
     ((rational-nine (h4-terms-tactics-rational library nine nil))
      (rational-x (h4-terms-tactics-rational library *library-x* (list ix)))
      (positive-nine (proof-proof-prove proof (library-positive nine) nil nil))
      (pos-product (library-library-cite library "POSITIVE-PRODUCT"
                                         (list nine *library-x*)
                                         (list rational-nine rational-x positive-nine px)))
      (result (library-library-less-from-difference
               library *library-x* (library-plus *library-x* times-x) pos-product (list ix)))
      (expansion (library-library-axiom library "COMMUTATIVITY-OF-*" (list ten *library-x*)))
      (sum-ten (proof-proof-compute proof (library-plus *proof-one* nine) 10))
      (ten-sum (proof-proof-symmetric proof sum-ten))
      (expansion (proof-proof-rewrite proof expansion ten-sum '(1 2 2)))
      (distributed (library-library-axiom library "DISTRIBUTIVITY"
                                          (list *library-x* *proof-one* nine)))
      (expansion (proof-proof-chain proof expansion (list distributed)))
      (one-x (library-library-axiom library "UNICITY-OF-1" (list *library-x*)))
      (number-x (h4-terms-tactics-number library *library-x* (list ix)))
      (fixed (proof-proof-simplify proof (list fix *library-x*) (list number-x) (list fix)))
      (one-x (proof-proof-chain proof one-x (list fixed)))
      (x-one (library-library-axiom library "COMMUTATIVITY-OF-*" (list *library-x* *proof-one*)))
      (x-one (proof-proof-chain proof x-one (list one-x)))
      (expansion (proof-proof-rewrite proof expansion x-one '(1 2 1)))
      (x-nine (library-library-axiom library "COMMUTATIVITY-OF-*" (list *library-x* nine)))
      (expansion (proof-proof-rewrite proof expansion x-nine '(1 2 2)))
      (step (library-library-transport-argument library result expansion 2)))
     (library-library-lemma
      library "TENFOLD-LARGER" (library-lt *library-x* (list *proof-times* ten *library-x*))
      step (library-guards (list (library-integer *library-x*) (library-positive *library-x*)))))))

(defun h4-terms-tactics-ordered-arithmetic (library)
  (let* ((x *library-x*)
         (y *library-y*)
         (integer-x (library-integer x))
         (integer-y (library-integer y))
         (positive-x (library-positive x))
         (positive-y (library-positive y))
         (negative-x (library-lt x *proof-zero*))
         (negative-y (library-lt y *proof-zero*))
         (difference (library-diff y x))
         (compare-xy (library-lt x y))
         (proof (library-library-proof library)))
    (proof-with-checked-results
     ((ints (library-library-ints library (list x y)))
      (a (library-library-axiom library "<-ON-OTHERS" (list x y)))
      (b (library-library-axiom library "<-ON-OTHERS" (list *proof-zero* difference)))
      (delta (library-library-linear-equal
              library (library-diff *proof-zero* difference) (library-diff x y) ints))
      (b (proof-proof-rewrite proof b delta '(1 2 1)))
      (b (proof-proof-symmetric proof b))
      (step (proof-proof-chain proof a (list b)))
      (library (library-library-lemma library "LESS-DIFFERENCE"
                                      (proof-eq compare-xy (library-positive difference))
                                      step (library-guards (list integer-x integer-y))))
      (proof (library-library-proof library))

      (px (proof-proof-assume proof positive-x t))
      (py (proof-proof-assume proof positive-y t))
      (positive (library-library-axiom library "POSITIVE" (list x y)))
      (parts (h4-tactics-tactics-conjunct library positive))
      (both-positive (proof-ite positive-x positive-y *proof-false*))
      (premise (proof-proof-prove proof both-positive (list px py) nil))
      (step (h4-tactics-tactics-modus-ponens library (car parts) premise))
      (library (library-library-lemma library "POSITIVE-SUM"
                                      (library-positive (library-plus x y)) step
                                      (library-guards (list positive-x positive-y))))
      (proof (library-library-proof library))
      (r-x (list *library-rationalp* x))
      (r-y (list *library-rationalp* y))
      (rx (proof-proof-assume proof r-x t))
      (ry (proof-proof-assume proof r-y t))
      (both-rational-positive (proof-ite r-x (proof-ite r-y both-positive *proof-false*)
                                         *proof-false*))
      (premise (proof-proof-prove proof both-rational-positive (list rx ry px py) nil))
      (step (h4-tactics-tactics-modus-ponens library (cadr parts) premise))
      (library (library-library-lemma library "POSITIVE-PRODUCT"
                                      (library-positive (list *proof-times* x y)) step
                                      (library-guards (list r-x r-y positive-x positive-y))))
      (proof (library-library-proof library))

      (ix (car ints))
      (iy (cadr ints))
      (trichotomy (library-library-axiom library "TRICHOTOMY" (list x)))
      (parts (h4-tactics-tactics-conjunct library trichotomy))
      (tri (car parts))
      (exclusive (cadr parts))
      (opposite (library-library-comparison library x *proof-zero* (list ix)))
      (delta (library-library-linear-equal library (library-diff *proof-zero* x)
                                           (library-minus x) (list ix)))
      (opposite (proof-proof-rewrite proof opposite delta '(1 2 2)))
      (exclusive-first (proof-step-first exclusive))
      (test (proof-term-at exclusive-first 1))
      (test-equality (proof-proof-simplify proof test
                                           (list px) (list *proof-not*)))
      (exclusive (proof-proof-rewrite proof exclusive test-equality '(1 1)))
      (exclusive (proof-proof-simplify-first proof exclusive nil nil))
      (step (library-library-transport-argument library exclusive opposite 1))
      (library (library-library-lemma library "POSITIVE-NONNEGATIVE"
                                      (library-nonnegative x) step
                                      (library-guards (list integer-x positive-x))))
      (proof (library-library-proof library))

      (goal (library-positive (library-plus y x)))
      (good (library-library-cite library "POSITIVE-SUM" (list y x) (list py px)))
      (x-zero (proof-eq x *proof-zero*))
      (y-zero (library-library-cite library "ADD-ZERO-RIGHT" (list y) (list iy)))
      (zero-case (library-library-transport-argument library py y-zero 2))
      (x-is-zero (proof-proof-assume proof x-zero t))
      (zero-x (proof-proof-symmetric proof x-is-zero))
      (zero-case (proof-proof-rewrite proof zero-case zero-x '(1 2 2)))
      (zero-case (proof-proof-tidy proof zero-case))
      (number-x (h4-terms-tactics-number library x (list ix)))
      (disjunction (h4-tactics-tactics-modus-ponens library tri number-x))
      (x-not-positive (proof-proof-assume proof positive-x nil))
      (x-not-zero (proof-proof-assume proof x-zero nil))
      (negative-case (proof-proof-simplify-first proof disjunction
                                                  (list x-not-positive x-not-zero) nil))
      (negative-case (proof-proof-transport proof negative-case opposite))
      (x-bound (proof-proof-assume proof negative-x nil))
      (contradiction (proof-proof-cut proof negative-case x-bound))
      (impossible (proof-proof-subsume proof contradiction
                                       (cons goal (proof-step-clause contradiction))))
      (branch (proof-proof-cases proof x-zero zero-case impossible))
      (step (proof-proof-cases proof positive-x good branch))
      (library (library-library-lemma library "POSITIVE-PLUS-NONNEGATIVE" goal step
                                      (list (proof-neg integer-x) (proof-neg integer-y)
                                            (proof-neg positive-y) negative-x)))
      (proof (library-library-proof library))

      (sum (library-plus y x))
      (goal (library-nonnegative sum))
      (y-bound (proof-proof-assume proof negative-y nil))
      (sum-type (library-library-type-of library sum ints))
      (pos-sum (library-library-cite library "POSITIVE-PLUS-NONNEGATIVE"
                                      (list y x) (list iy ix px y-bound)))
      (commute (library-library-axiom library "COMMUTATIVITY-OF-+" (list x y)))
      (pos-sum (proof-proof-rewrite proof pos-sum commute '(1 2)))
      (good (library-library-cite library "POSITIVE-NONNEGATIVE"
                                   (list sum) (list sum-type pos-sum)))
      (y-zero (library-library-cite library "ADD-ZERO-RIGHT" (list y) (list iy)))
      (zero-y (proof-proof-symmetric proof y-zero))
      (zero-case (proof-proof-rewrite proof y-bound zero-y '(1 1 1)))
      (zero-case (proof-proof-tidy proof zero-case))
      (x-is-zero (proof-proof-assume proof x-zero t))
      (zero-x (proof-proof-symmetric proof x-is-zero))
      (zero-case (proof-proof-rewrite proof zero-case zero-x '(1 1 1 2)))
      (zero-case (proof-proof-tidy proof zero-case))
      (impossible (proof-proof-subsume proof contradiction
                                       (cons goal (proof-step-clause contradiction))))
      (branch (proof-proof-cases proof x-zero zero-case impossible))
      (step (proof-proof-cases proof positive-x good branch))
      (library (library-library-lemma library "NONNEGATIVE-SUM" goal step
                                      (list (proof-neg integer-x) (proof-neg integer-y)
                                            negative-x negative-y)))
      (proof (library-library-proof library))

      (nx (proof-proof-assume proof (list *library-natp* x) t))
      (ny (proof-proof-assume proof (list *library-natp* y) t))
      (ix-nat (library-library-cite library "NATURAL-INTEGER" (list x) (list nx)))
      (iy-nat (library-library-cite library "NATURAL-INTEGER" (list y) (list ny)))
      (x-nat-bound (library-library-cite library "NATURAL-NONNEGATIVE" (list x) (list nx)))
      (y-nat-bound (library-library-cite library "NATURAL-NONNEGATIVE" (list y) (list ny)))
      (sum-nat-bound (library-library-cite library "NONNEGATIVE-SUM" (list y x)
                                           (list iy-nat ix-nat y-nat-bound x-nat-bound)))
      (sum (library-plus x y))
      (sum-type (library-library-type-of library sum (list ix-nat iy-nat)))
      (sum-nat (library-library-cite library "NATURAL-FROM-BOUNDS" (list sum)
                                     (list sum-type sum-nat-bound)))
      (nat-x (proof-step-first nx))
      (nat-y (proof-step-first ny))
      (library (library-library-lemma library "NATURAL-SUM" (list *library-natp* sum)
                                      sum-nat (library-guards (list nat-x nat-y))))
      (proof (library-library-proof library))

      (pos-one (proof-proof-prove proof (library-positive *proof-one*) nil nil))
      (one-type (library-library-type-of library *proof-one* nil))
      (nonnegative-x (proof-proof-assume proof negative-x nil))
      (step (library-library-cite library "POSITIVE-PLUS-NONNEGATIVE" (list x *proof-one*)
                                   (list ix one-type pos-one nonnegative-x)))
      (one-plus-x (library-plus *proof-one* x))
      (library (library-library-lemma library "POSITIVE-ONE-PLUS" (library-positive one-plus-x)
                                      step (list (proof-neg integer-x) negative-x)))
      (step (library-library-less-from-difference library x one-plus-x pos-one (list ix)))
      (library (library-library-lemma library "SUCCESSOR-LARGER" (library-lt x one-plus-x)
                                      step (list (proof-neg integer-x))))
      (proof (library-library-proof library))

      (nonless (proof-proof-assume proof compare-xy nil))
      (delta (library-diff x y))
      (offset (library-library-axiom library "<-ON-OTHERS" (list x y)))
      (nonneg-delta (proof-proof-rewrite proof nonless offset '(1 1)))
      (delta-type (library-library-type-of library delta ints))
      (bound (library-library-cite library "POSITIVE-ONE-PLUS" (list delta)
                                    (list delta-type nonneg-delta)))
      (step (library-library-less-from-difference library y one-plus-x bound ints))
      (library (library-library-lemma
                library "LESS-THAN-NEXT" (library-lt y one-plus-x) step
                (append (library-guards (list integer-x integer-y)) (list compare-xy)))))
     (h4-terms-tactics-tenfold-increase library ix px))))

(defun h4-terms-tactics-count-leaf (leaf library integer-abs length)
  (cond
   ((proof-is-call leaf *proof-plus*)
    (library-library-cite library "SUM-NUMBER" (cdr leaf) nil))
   ((proof-is-call leaf *proof-minus*)
    (library-library-cite library "NEGATION-NUMBER" (cdr leaf) nil))
   ((or (proof-is-call leaf integer-abs) (proof-is-call leaf length))
    (library-library-cite library (if (equal (car leaf) integer-abs)
                                      "ABS-NUMBER" "LENGTH-NUMBER")
                          (cdr leaf) nil))
   (t
    (let ((proof (library-library-proof library)))
      (proof-with-checked-results
          ((evidence (if (equal leaf *library-x*)
                         (proof-with-checked-results
                             ((integer-x (proof-proof-assume proof (library-integer *library-x*) t)))
                           (list integer-x))
                       nil)))
        (h4-terms-tactics-number library leaf evidence))))))

(defun h4-terms-tactics-count-leaf-proofs (requests library integer-abs length)
  (if (endp requests)
      nil
    (let* ((request (car requests))
           (step (h4-terms-tactics-count-leaf (car request) library integer-abs length)))
      (cons (cons request step)
            (h4-terms-tactics-count-leaf-proofs (cdr requests) library integer-abs length)))))

(defun h4-terms-tactics-count-numeric-lemma (library function name integer-abs length)
  (let* ((proof (library-library-proof library))
         (call (list function *library-x*))
         (template (list *library-numberp* *proof-result*)))
    (proof-with-checked-results
     ((opened (proof-proof-unfold proof call))
      (opened-first (proof-step-first opened))
      (body (proof-term-at opened-first 2))
      (requests (proof-proof-by-value-leaves proof body nil))
      (leaf (h4-terms-tactics-count-leaf-proofs requests library integer-abs length))
      (step (proof-proof-by-value proof body template leaf nil))
      (closed (proof-proof-symmetric proof opened))
      (step (proof-proof-rewrite-result proof step closed template *proof-result*)))
     (library-library-lemma library name (list *library-numberp* call) step nil))))

(defun h4-terms-tactics-count-lemmas (library)
  (let* ((x *library-x*)
         (y *library-y*)
         (integer-abs (proof-sym "INTEGER-ABS" "ACL2"))
         (length (proof-cl "LENGTH"))
         (size (list *library-count* x)))
    (proof-with-checked-results
     ((closure (library-library-axiom library "CLOSURE" (list x y)))
      (parts (h4-tactics-tactics-conjunct library closure))
      (add (car parts))
      (parts (h4-tactics-tactics-conjunct library (cadr parts)))
      (parts (h4-tactics-tactics-conjunct library (cadr parts)))
      (minus-number (car parts))
      (library (library-library-lemma library "SUM-NUMBER"
                                      (list *library-numberp* (library-plus x y)) add nil))
      (library (library-library-lemma library "NEGATION-NUMBER"
                                      (list *library-numberp* (library-minus x)) minus-number nil))
      (library (h4-terms-tactics-count-numeric-lemma
                library integer-abs "ABS-NUMBER" integer-abs length))
      (library (h4-terms-tactics-count-numeric-lemma
                library length "LENGTH-NUMBER" integer-abs length))
      (library (h4-terms-tactics-count-numeric-lemma
                library *library-count* "COUNT-NUMBER" integer-abs length))
      (proof (library-library-proof library))
      (count-number (library-library-cite library "COUNT-NUMBER" (list x) nil))
      (is-finite (library-library-cite library "NUMBER-FINITE" (list size) (list count-number)))
      (ordinal (library-library-builtin library 1 x))
      (step (proof-proof-simplify-first proof ordinal (list is-finite) (list *proof-ordinalp*)))
      (library (library-library-lemma library "COUNT-NATURAL" (list *library-natp* size) step nil))
      (natural-size (library-library-natural library size))
      (step (library-library-cite library "NATURAL-INTEGER" (list size) (list natural-size))))
     (library-library-lemma library "COUNT-INTEGER" (library-integer size) step nil))))

(defun h4-terms-tactics-build (p)
  (proof-with-checked-results
      ((p (h4-terms-tactics-logic-and-types p))
       (p (h4-terms-tactics-additive-identities p))
       (p (h4-terms-tactics-ordered-arithmetic p))
       (p (library-library-order-lemmas p))
       (p (library-library-length-lemmas p))
       (p (h4-terms-tactics-count-lemmas p)))
    (library-library-build-after-count p)))

(defun h4-terms-term-implies-pseudo (p formula)
  (proof-with-checked-results
      ((p (h4-tactics-tactics-propositional-lemmas p))
       (p (h4-terms-tactics-build p))
       (symbol (h4-terms-legal-variables p))
       (p (cdr symbol))
       (proof-step (h4-terms-list-recognizer p *h4-terms-arglist1* *h4-terms-symbol-list* (car symbol)))
       (argument-symbols (h4-tactics-tactics-local-lemma p "ARGUMENTS-SYMBOL-LIST" proof-step))
       (p (cdr argument-symbols))
       (proof-step (h4-terms-list-recognizer p *h4-terms-symbol-list* *h4-terms-true-list* nil))
       (true-symbols (h4-tactics-tactics-local-lemma p "SYMBOLS-TRUE-LIST" proof-step))
       (length-equation (h4-terms-length-on-true-lists (cdr true-symbols)))
       (p (cdr length-equation))
       (result (h4-terms-term-implies-pseudo-cases
                p formula (car symbol) (car argument-symbols) (car true-symbols) (car length-equation))))
    (cons result p)))

(defun h4-terms-term-list-implies-pseudo (p formula)
  (proof-with-checked-results
      ((premise (proof-term-at formula 1))
       (x (proof-term-at premise 1))
       (case-step (h4-terms-pseudo-list-case p formula
                                           (list :term-list-implies-pseudo-term)
                                           (list :term-list-implies-pseudo-list formula)))
       (ordinal (library-library-builtin p 1 x)))
    (proof-proof-induct (library-library-proof p) ordinal case-step formula (list *library-count* x)
                        (list (list (list x (list *library-cdr* x)))))))
