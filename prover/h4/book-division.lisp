(defun h4-book-division-floor-bounds (p)
  (let ((proof (library-library-proof p)))
    (proof-with-checked-results
     ((dividend-integer (proof-proof-assume proof (library-integer *library-x*) t))
      (dividend-positive (proof-proof-assume proof (library-positive *library-x*) t))
      (divisor-integer (proof-proof-assume proof (library-integer *library-y*) t))
      (above-one (proof-proof-assume proof (library-lt *proof-one* *library-y*) t))
      (premises (h4-book-division-conjunction
                 p (list dividend-integer dividend-positive divisor-integer above-one)))
      (premise (proof-step-first premises))
      (assumed (proof-proof-assume proof premise t))
      (conjuncts (h4-association-conjunct p assumed))
      (dividend-integer (car conjuncts))
      (conjuncts (h4-association-conjunct p (cadr conjuncts)))
      (dividend-positive (car conjuncts))
      (conjuncts (h4-association-conjunct p (cadr conjuncts)))
      (divisor-integer (car conjuncts))
      (above-one (cadr conjuncts))
      (integers (list dividend-integer divisor-integer))
      (zero-type (library-library-type-of p *proof-zero* nil))
      (one-type (library-library-type-of p *proof-one* nil))
      (one-positive (h4-association-establish p (library-positive *proof-one*) nil nil nil))
      (divisor-positive (library-library-cite
                         p "LESS-TRANSITIVE" (list *proof-zero* *proof-one* *library-y*)
                         (list zero-type one-type divisor-integer one-positive above-one)))
      (reciprocal (list *h4-book-division-reciprocal* *library-y*))
      (ratio (h4-book-division-times *library-x* reciprocal))
      (fact (proof-proof-fact proof "rationalp-unary-/" (list (list *library-x* *library-y*))))
      (rational (h4-association-rational p *library-y* integers))
      (reciprocal-type (h4-association-modus-ponens p fact rational))
      (fact (proof-proof-fact proof "rationalp-binary-*" (list (list *library-y* reciprocal))))
      (rational (h4-association-rational p *library-x* integers))
      (conjunction (h4-book-division-conjunction p (list rational reciprocal-type)))
      (ratio-type (h4-association-modus-ponens p fact conjunction))
      (numerator (list *h4-book-division-numerator* ratio))
      (denominator (list *h4-book-division-denominator* ratio))
      (axiom (library-library-axiom p "RATIONAL-IMPLIES1" (list ratio)))
      (information (h4-association-modus-ponens p axiom ratio-type))
      (parts (h4-association-conjunct p information))
      (denominator-integer (car parts))
      (parts (h4-association-conjunct p (cadr parts)))
      (numerator-integer (car parts))
      (denominator-positive (cadr parts))
      (integers (append integers (list numerator-integer denominator-integer)))
      (scaling (h4-book-division-ratio-scaling
                p *library-x* *library-y* ratio numerator denominator ratio-type divisor-positive
                denominator-positive integers))
      (scaled-positive (h4-book-division-positive-product p denominator-positive dividend-positive integers))
      (symmetric (proof-proof-symmetric proof scaling))
      (scaled-positive (proof-proof-rewrite proof scaled-positive symmetric '(1 2)))
      (zero-product (h4-book-division-product-zero p *library-y* integers))
      (symmetric (proof-proof-symmetric proof zero-product))
      (scaled-positive (proof-proof-rewrite proof scaled-positive symmetric '(1 1)))
      (numerator-positive (h4-book-division-cancel-positive-factor
                           p scaled-positive *proof-zero* numerator divisor-positive integers))
      (numerator-nonnegative (library-library-cite p "POSITIVE-NONNEGATIVE" (list numerator)
                                                     (list numerator-integer numerator-positive)))
      (numerator-natural (library-library-cite p "NATURAL-FROM-BOUNDS" (list numerator)
                                                 (list numerator-integer numerator-nonnegative)))
      (comparison (library-library-comparison p *proof-one* *library-y* integers))
      (increased (proof-proof-rewrite proof above-one comparison '(1)))
      (gain (h4-book-division-positive-product p numerator-positive increased integers))
      (distribution (library-library-axiom p "DISTRIBUTIVITY"
                                           (list numerator *library-y* (library-minus *proof-one*))))
      (negation (h4-book-division-product-negative p numerator *proof-one* integers))
      (product-one (h4-book-division-product-one p numerator integers))
      (negation (proof-proof-rewrite proof negation product-one '(1 2 1)))
      (distribution (proof-proof-rewrite proof distribution negation '(1 2 2)))
      (commute (library-library-axiom p "COMMUTATIVITY-OF-*" (list numerator *library-y*)))
      (distribution (proof-proof-rewrite proof distribution commute '(1 2 1)))
      (gain (proof-proof-rewrite proof gain distribution '(1 2)))
      (numerator-bound (library-library-less-from-difference
                        p numerator (h4-book-division-times *library-y* numerator) gain integers))
      (numerator-bound (proof-proof-rewrite proof numerator-bound scaling '(1 2)))
      (floor-term (list *h4-book-division-floor* *library-x* *library-y*))
      (conclusion (proof-ite (list *library-natp* floor-term)
                             (library-lt floor-term *library-x*) *proof-false*))
      (formula (list *library-implies* premise conclusion))
      (opened (proof-proof-unfold proof floor-term))
      (test (proof-eq denominator *proof-one*))
      (assumed (proof-proof-assume proof test t))
      (yes (h4-book-division-floor-bounds-denominator-one
            assumed p denominator numerator integers numerator-integer numerator-natural numerator-bound
            denominator-positive opened numerator-nonnegative))
      (assumed (proof-proof-assume proof test nil))
      (no (h4-book-division-floor-bounds-other-denominator
           assumed p numerator denominator numerator-natural denominator-integer denominator-positive
           integers numerator-integer numerator-bound opened numerator-nonnegative))
      (cases (h4-association-case-of p conclusion test yes no))
      (proof-step (h4-association-imply p formula cases)))
     (h4-association-local-lemma p *h4-book-division-floor-bounds* proof-step))))
