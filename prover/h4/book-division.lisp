(defun h4-book-division-ratio-scaling
    (p value divisor ratio numerator denominator ratio-type divisor-positive denominator-positive integers)
  (let ((proof (library-library-proof p)))
    (proof-with-checked-results
     ((axiom (library-library-axiom p "RATIONAL-IMPLIES2" (list ratio)))
      (representation (h4-association-modus-ponens p axiom ratio-type))
      (cancelled (h4-book-division-cancel-reciprocal
                  p denominator numerator denominator-positive integers))
      (symmetric (proof-proof-symmetric proof cancelled))
      (multiplied (h4-book-division-multiply-equality p denominator representation))
      (restored (proof-proof-chain proof symmetric (list multiplied)))
      (scaled (h4-book-division-multiply-equality p divisor restored))
      (association (library-library-axiom p "ASSOCIATIVITY-OF-*" (list divisor denominator ratio)))
      (regroup (proof-proof-symmetric proof association))
      (commute (library-library-axiom p "COMMUTATIVITY-OF-*" (list divisor denominator)))
      (regroup (proof-proof-rewrite proof regroup commute '(1 2 1)))
      (association (library-library-axiom p "ASSOCIATIVITY-OF-*" (list denominator divisor ratio)))
      (regroup (proof-proof-chain proof regroup (list association)))
      (scaled (proof-proof-chain proof scaled (list regroup)))
      (flipped-ratio (library-library-axiom p "COMMUTATIVITY-OF-*"
                                            (list value (list *h4-book-division-reciprocal* divisor))))
      (multiplied (h4-book-division-multiply-equality p divisor flipped-ratio))
      (cancelled (h4-book-division-cancel-reciprocal p divisor value divisor-positive integers))
      (restored-value (proof-proof-chain proof multiplied (list cancelled))))
     (proof-proof-rewrite proof scaled restored-value '(1 2 2)))))

(defun h4-book-division-floor-bounds-finish
    (natural weak test p integers denominator numerator numerator-integer numerator-bound
             denominator-positive opened numerator-nonnegative)
  (let ((proof (library-library-proof p)))
    (proof-with-checked-results
     ((value (h4-association-step-at natural 1))
      (type (library-library-cite p "NATURAL-INTEGER" (list value) (list natural)))
      (types (append integers (list type)))
      (lower-product (h4-book-division-times denominator value))
      (upper-product (h4-book-division-times denominator *library-x*))
      (lower-type (library-library-type-of p lower-product types))
      (upper-type (library-library-type-of p upper-product types))
      (limit (library-library-cite p "WEAK-THEN-LESS" (list lower-product numerator upper-product)
                                   (list lower-type numerator-integer upper-type weak numerator-bound)))
      (lower (h4-book-division-cancel-positive-factor p limit value *library-x*
                                                      denominator-positive types))
      (right (h4-association-step-at opened 2))
      (reduction (h4-association-normalize p right (list numerator-nonnegative test)
                                          (list (proof-cl "=") *proof-not*) nil))
      (equality (proof-proof-chain proof opened (list reduction)))
      (natural (library-library-transport-argument p natural equality 1))
      (lower (library-library-transport-argument p lower equality 1)))
     (h4-book-division-conjunction p (list natural lower)))))

