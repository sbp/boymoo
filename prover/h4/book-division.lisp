(defun h4-book-division-cancel-positive-factor-impossible-zero
    (same p positive-scaled factor integers delta)
  (let ((proof (library-library-proof p)))
    (proof-with-checked-results
     ((claim (proof-proof-rewrite proof positive-scaled same '(1 2 2)))
      (zero-product (h4-book-division-product-zero p factor integers))
      (inconsistent (proof-proof-rewrite proof claim zero-product '(1 2)))
      (zero (library-library-axiom p "ZERO" nil))
      (contradiction (proof-proof-cut proof inconsistent zero)))
     (proof-proof-subsume proof contradiction
                          (cons (library-positive delta) (proof-step-clause contradiction))))))

(defun h4-book-division-cancel-positive-factor-nonpositive-impossible-negative
    (different p remaining positive-factor integers factor delta product positive-scaled)
  (let ((proof (library-library-proof p)))
    (proof-with-checked-results
     ((negative (proof-proof-prove-if proof remaining different))
      (opposite (h4-book-division-positive-product p positive-factor negative integers))
      (negated-product (h4-book-division-product-negative p factor delta integers))
      (opposite (proof-proof-rewrite proof opposite negated-product '(1 2)))
      (comparison (library-library-comparison p product *proof-zero* integers))
      (difference (library-library-linear-equal p (library-diff *proof-zero* product)
                                                 (library-minus product) integers))
      (comparison (proof-proof-rewrite proof comparison difference '(1 2 2)))
      (negative-product (proof-proof-transport proof opposite comparison))
      (product-type (library-library-type-of p product integers))
      (nonnegative-product (library-library-cite p "POSITIVE-NONNEGATIVE" (list product)
                                                  (list product-type positive-scaled)))
      (contradiction (proof-proof-cut proof negative-product nonnegative-product)))
     (proof-proof-subsume proof contradiction
                          (cons (library-positive delta) (proof-step-clause contradiction))))))

(defun h4-book-division-cancel-positive-factor-nonpositive
    (no-positive p alternatives delta positive-scaled factor integers positive-factor product)
