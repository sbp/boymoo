(defconst *h4-book-division-quotient* (proof-sym "NONNEGATIVE-INTEGER-QUOTIENT" "ACL2"))
(defconst *h4-book-division-quotient-bounds* (proof-sym "H4-NONNEGATIVE-QUOTIENT-BOUNDS" "ACL2"))
(defconst *h4-book-division-floor* (proof-cl "FLOOR"))
(defconst *h4-book-division-numerator* (proof-cl "NUMERATOR"))
(defconst *h4-book-division-denominator* (proof-cl "DENOMINATOR"))
(defconst *h4-book-division-floor-bounds* (proof-sym "H4-NATURAL-FLOOR-BOUNDS" "ACL2"))
(defconst *h4-book-division-fix* (proof-sym "FIX" "ACL2"))
(defconst *h4-book-division-ifix* (proof-sym "IFIX" "ACL2"))
(defconst *h4-book-division-acl2-nfix* (proof-sym "NFIX" "ACL2"))
(defconst *h4-book-division-reciprocal* (proof-sym "UNARY-/" "ACL2"))

(defun h4-book-division-conjunction (p proofs)
  (cond
   ((endp proofs) '(:failure "failure" ""))
   ((endp (cdr proofs)) (car proofs))
   (t
    (proof-with-checked-results
     ((result (h4-book-division-conjunction p (cdr proofs)))
      (test (proof-step-first (car proofs)))
      (rest (proof-step-first result)))
     (h4-association-conjunction p (proof-ite test rest *proof-false*) (car proofs) result)))))

(defun h4-book-division-times (a b)
  (list *proof-times* a b))

(defun h4-book-division-left-product-one (p factor integers)
  (let ((proof (library-library-proof p)))
    (proof-with-checked-results
     ((unity (library-library-axiom p "UNICITY-OF-1" (list factor)))
      (number (h4-association-number p factor integers))
      (fixed (h4-association-normalize p (list *h4-book-division-fix* factor)
                                      (list number) (list *h4-book-division-fix*) nil)))
     (proof-proof-chain proof unity (list fixed)))))

(defun h4-book-division-product-one (p factor integers)
  (proof-with-checked-results
   ((commuted (library-library-axiom p "COMMUTATIVITY-OF-*" (list factor *proof-one*)))
    (identity (h4-book-division-left-product-one p factor integers)))
   (proof-proof-chain (library-library-proof p) commuted (list identity))))

(defun h4-book-division-product-zero (p factor integers)
  (let ((proof (library-library-proof p))
        (product (h4-book-division-times factor *proof-zero*)))
    (proof-with-checked-results
     ((distribution (library-library-axiom p "DISTRIBUTIVITY" (list factor *proof-zero* *proof-zero*)))
      (computed (proof-proof-compute proof (library-plus *proof-zero* *proof-zero*) 0))
      (doubled (proof-proof-rewrite proof distribution computed '(1 1 2)))
      (identity (proof-proof-reflexive proof (library-diff product product)))
      (delta (proof-proof-rewrite proof identity doubled '(1 2 1)))
      (left (h4-association-step-at delta 1))
      (left (library-library-linear-equal p left *proof-zero* integers))
      (left (proof-proof-symmetric proof left))
      (right (h4-association-step-at delta 2))
      (right (library-library-linear-equal p right product integers))
      (zero (proof-proof-chain proof left (list delta right))))
     (proof-proof-symmetric proof zero))))

(defun h4-book-division-product-negative (p factor value integers)
  (let ((proof (library-library-proof p))
        (first (h4-book-division-times factor value))
        (last (h4-book-division-times factor (library-minus value))))
    (proof-with-checked-results
     ((together (library-library-axiom p "DISTRIBUTIVITY" (list factor value (library-minus value))))
      (left (h4-association-step-at together 1))
      (identity (proof-proof-reflexive proof left))
      (inverse (library-library-axiom p "INVERSE-OF-+" (list value)))
      (cancellation (proof-proof-rewrite proof identity inverse '(1 2 2)))
      (symmetric (proof-proof-symmetric proof together))
      (zero (h4-book-division-product-zero p factor integers))
      (sum-zero (proof-proof-chain proof symmetric (list cancellation zero)))
      (left (h4-association-step-at sum-zero 1))
      (identity (proof-proof-reflexive proof (library-diff left first)))
      (shifted (proof-proof-rewrite proof identity sum-zero '(1 2 1)))
      (left (h4-association-step-at shifted 1))
      (left (library-library-linear-equal p left last integers))
      (left (proof-proof-symmetric proof left))
      (right (h4-association-step-at shifted 2))
      (right (library-library-linear-equal p right (library-minus first) integers)))
     (proof-proof-chain proof left (list shifted right)))))

(defun h4-book-division-nonzero (p strict)
  (let ((proof (library-library-proof p)))
    (proof-with-checked-results
     ((value (h4-association-step-at strict 2))
      (test (proof-eq value *proof-zero*))
      (assumed (proof-proof-assume proof test t))
      (impossible (proof-proof-rewrite proof strict assumed '(1 2)))
      (zero (library-library-axiom p "ZERO" nil))
      (contradiction (proof-proof-cut proof impossible zero)))
     (proof-proof-front proof contradiction (proof-neg test)))))

(defun h4-book-division-shift-weak-bound (p bound offset integers)
  (let ((proof (library-library-proof p)))
    (proof-with-checked-results
     ((literal (proof-step-first bound))
      (literal (proof-list-of-length literal 2))
      (parts (proof-list-of-length (cadr literal) 3))
      (upper (cadr parts))
      (lower (caddr parts))
      (shifted-upper (library-plus offset upper))
      (shifted-lower (library-plus offset lower))
      (before (library-library-axiom p "<-ON-OTHERS" (list upper lower)))
      (after (library-library-axiom p "<-ON-OTHERS" (list shifted-upper shifted-lower)))
      (after-right (h4-association-step-at after 2))
      (after-difference (proof-term-at after-right 1))
      (before-right (h4-association-step-at before 2))
      (before-difference (proof-term-at before-right 1))
      (difference (library-library-linear-equal p after-difference before-difference integers))
      (changed (proof-proof-rewrite proof after difference '(1 2 1)))
      (symmetric (proof-proof-symmetric proof before))
      (comparison (proof-proof-chain proof changed (list symmetric)))
      (symmetric (proof-proof-symmetric proof comparison)))
     (proof-proof-rewrite proof bound symmetric '(1 1)))))

(defun h4-book-division-quotient-bounds-equation (test p unrolled recurrence-evidence)
  (proof-with-checked-results
   ((right (h4-association-step-at unrolled 2))
    (reduced (h4-association-normalize
              p right (append recurrence-evidence (list test))
              (list *h4-book-division-ifix* *h4-book-division-acl2-nfix* (proof-cl "=") *proof-not*) nil)))
   (proof-proof-chain (library-library-proof p) unrolled (list reduced))))

(defun h4-book-division-quotient-bounds-transport-result (equality natural weak p)
  (let ((proof (library-library-proof p)))
    (proof-with-checked-results
     ((ordinal-type (library-library-transport-argument p natural equality 1))
      (symmetric (proof-proof-symmetric proof equality))
      (actual-bound (proof-proof-rewrite proof weak symmetric '(1 1 2 2))))
     (h4-book-division-conjunction p (list ordinal-type actual-bound)))))

(defun h4-book-division-quotient-bounds-stop
    (test p dividend-nonnegative integers unrolled recurrence-evidence)
  (let ((proof (library-library-proof p)))
    (proof-with-checked-results
     ((zero-product (h4-book-division-product-zero p *library-y* integers))
      (symmetric (proof-proof-symmetric proof zero-product))
      (weak (proof-proof-rewrite proof dividend-nonnegative symmetric '(1 1 2)))
      (equation (h4-book-division-quotient-bounds-equation test p unrolled recurrence-evidence))
      (natural (library-library-natural p *proof-zero*)))
     (h4-book-division-quotient-bounds-transport-result equation natural weak p))))

(defun h4-book-division-quotient-bounds-continue-
    (test p difference integers divisor-integer dividend-integer divisor-positive recurse
          unrolled recurrence-evidence)
  (let ((proof (library-library-proof p)))
    (proof-with-checked-results
     ((child-integer (library-library-type-of p difference integers))
      (axiom (library-library-axiom p "<-ON-OTHERS" (list *library-x* *library-y*)))
      (child-bound (proof-proof-rewrite proof test axiom '(1 1)))
      (child-natural (library-library-cite p "NATURAL-FROM-BOUNDS" (list difference)
                                           (list child-integer child-bound)))
      (zero-type (library-library-type-of p *proof-zero* nil))
      (dividend-positive
       (library-library-cite p "LESS-THEN-WEAK" (list *proof-zero* *library-y* *library-x*)
                             (list zero-type divisor-integer dividend-integer divisor-positive test)))
      (decrease (library-library-less-from-difference
                 p difference *library-x* divisor-positive integers))
      (descent (library-library-cite p "NFIX-DECREASE" (list difference *library-x*)
                                    (list child-integer dividend-integer dividend-positive decrease)))
      (descent-first (proof-step-first descent))
      (assumed (proof-proof-assume proof (proof-ite descent-first recurse *proof-true*) t))
      (hypothesis (proof-proof-prove-if proof assumed descent))
      (conjunction (h4-book-division-conjunction p (list child-natural divisor-integer divisor-positive)))
      (instance (h4-association-modus-ponens p hypothesis conjunction))
      (conjuncts (h4-association-conjunct p instance))
      (child-type (car conjuncts))
      (child-limit (cadr conjuncts))
      (child (list *h4-book-division-quotient* difference *library-y*))
      (child-integer (library-library-cite p "NATURAL-INTEGER" (list child) (list child-type)))
      (extended (append integers (list child-integer)))
      (one-natural (library-library-natural p *proof-one*))
      (successor (library-library-cite p "NATURAL-SUM" (list *proof-one* child)
                                        (list one-natural child-type)))
      (shifted (h4-book-division-shift-weak-bound p child-limit *library-y* extended))
      (sum (library-library-linear-equal p (library-plus *library-y* difference) *library-x* extended))
      (shifted (proof-proof-rewrite proof shifted sum '(1 1 1)))
      (multiplied (library-library-axiom p "DISTRIBUTIVITY" (list *library-y* *proof-one* child)))
      (product-one (h4-book-division-product-one p *library-y* extended))
      (multiplied (proof-proof-rewrite proof multiplied product-one '(1 2 1)))
      (symmetric (proof-proof-symmetric proof multiplied))
      (weak (proof-proof-rewrite proof shifted symmetric '(1 1 2)))
      (equation (h4-book-division-quotient-bounds-equation test p unrolled recurrence-evidence)))
     (h4-book-division-quotient-bounds-transport-result equation successor weak p))))

(defun h4-book-division-quotient-bounds (p)
  (let ((proof (library-library-proof p)))
    (proof-with-checked-results
     ((dividend-natural (proof-proof-assume proof (list *library-natp* *library-x*) t))
      (divisor-integer (proof-proof-assume proof (library-integer *library-y*) t))
      (divisor-positive (proof-proof-assume proof (library-positive *library-y*) t))
      (quotient (list *h4-book-division-quotient* *library-x* *library-y*))
      (bound (library-le (h4-book-division-times *library-y* quotient) *library-x*))
      (conclusion (proof-ite (list *library-natp* quotient) bound *proof-false*))
      (premises (h4-book-division-conjunction p (list dividend-natural divisor-integer divisor-positive)))
      (premise (proof-step-first premises))
      (formula (list *library-implies* premise conclusion))
      (assumed (proof-proof-assume proof premise t))
      (conjuncts (h4-association-conjunct p assumed))
      (dividend-natural (car conjuncts))
      (conjuncts (h4-association-conjunct p (cadr conjuncts)))
      (divisor-integer (car conjuncts))
      (divisor-positive (cadr conjuncts))
      (dividend-integer (library-library-cite p "NATURAL-INTEGER" (list *library-x*)
                                             (list dividend-natural)))
      (dividend-nonnegative (library-library-cite p "NATURAL-NONNEGATIVE" (list *library-x*)
                                                  (list dividend-natural)))
      (divisor-nonnegative (library-library-cite p "POSITIVE-NONNEGATIVE" (list *library-y*)
                                                  (list divisor-integer divisor-positive)))
      (integers (list dividend-integer divisor-integer))
      (unrolled (proof-proof-unfold proof quotient))
      (nonzero (h4-book-division-nonzero p divisor-positive))
      (recurrence-evidence (append integers (list divisor-nonnegative nonzero)))
      (measure (list *library-nfix* *library-x*))
      (difference (library-diff *library-x* *library-y*))
      (substitutions (list (list *library-x* difference)))
      (recurse (proof-subst formula (list (cons *library-x* difference))))
      (test (library-lt *library-x* *library-y*))
      (ending (proof-proof-assume proof test t))
      (yes (h4-book-division-quotient-bounds-stop
            ending p dividend-nonnegative integers unrolled recurrence-evidence))
      (continuing (proof-proof-assume proof test nil))
      (no (h4-book-division-quotient-bounds-continue-
           continuing p difference integers divisor-integer dividend-integer divisor-positive
           recurse unrolled recurrence-evidence))
      (cases (h4-association-case-of p conclusion test yes no))
      (ordinal (library-library-cite p "NFIX-ORDINAL" (list *library-x*) nil))
      (case-step (h4-association-imply p formula cases))
      (induction (proof-proof-induct proof ordinal case-step formula measure (list substitutions))))
     (h4-association-local-lemma p *h4-book-division-quotient-bounds* induction))))

