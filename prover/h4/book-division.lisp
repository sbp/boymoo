(defun h4-book-division-cancel-positive-factor (p comparison left right positive-factor integers)
  (let ((proof (library-library-proof p)))
    (proof-with-checked-results
     ((factor (h4-association-step-at positive-factor 2))
      (delta (library-diff right left))
      (product (h4-book-division-times factor delta))
      (distribution (library-library-axiom p "DISTRIBUTIVITY"
                                           (list factor right (library-minus left))))
      (negative-product (h4-book-division-product-negative p factor left integers))
      (expanded (proof-proof-rewrite proof distribution negative-product '(1 2 2)))
      (comparison-left (h4-association-step-at comparison 1))
      (comparison-right (h4-association-step-at comparison 2))
      (difference (library-library-comparison p comparison-left comparison-right integers))
      (positive-delta (proof-proof-rewrite proof comparison difference '(1)))
      (symmetric (proof-proof-symmetric proof expanded))
      (positive-scaled (proof-proof-rewrite proof positive-delta symmetric '(1 2)))
      (trichotomy (library-library-axiom p "TRICHOTOMY" (list delta)))
      (parts (h4-association-conjunct p trichotomy))
      (number (h4-association-number p delta integers))
      (alternatives (h4-association-modus-ponens p (car parts) number))
      (test (library-positive delta))
      (yes (proof-proof-assume proof test t))
      (no-positive (proof-proof-assume proof test nil))
      (no (h4-book-division-cancel-positive-factor-nonpositive
           no-positive p alternatives delta positive-scaled factor integers positive-factor product))
      (result (h4-association-case-of p test test yes no))
      (comparison (library-library-comparison p left right integers)))
     (proof-proof-transport proof result comparison))))

(defun h4-book-division-cancel-reciprocal (p factor value positive-factor integers)
