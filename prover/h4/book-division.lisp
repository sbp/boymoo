      (yes (h4-book-division-cancel-positive-factor-impossible-zero
            same p positive-scaled factor integers delta))
      (different (proof-proof-assume proof zero nil))
      (no (h4-book-division-cancel-positive-factor-nonpositive-impossible-negative
