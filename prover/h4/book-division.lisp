      (inverse (h4-association-modus-ponens p inverse-axiom conjunction))
      (association (library-library-axiom p "ASSOCIATIVITY-OF-*" (list factor divisor-inverse value)))
      (grouped (proof-proof-symmetric proof association))
      (unscaled (proof-proof-rewrite proof grouped inverse '(1 2 1)))
      (identity (h4-book-division-left-product-one p value integers)))
