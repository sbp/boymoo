(in-package "BOYMOO-PROVER")
(set-verify-guards-eagerness 0)

(defconst *h4-book-arithmetic-zp* (proof-sym "ZP" "ACL2"))
(defconst *h4-book-arithmetic-natural-countdown-zero*
  (proof-sym "H4-NATURAL-COUNTDOWN-ZERO" "ACL2"))
(defconst *h4-book-arithmetic-natural-nonpositive-zero*
  (proof-sym "H4-NATURAL-NONPOSITIVE-ZERO" "ACL2"))
(defconst *h4-book-arithmetic-index-in-bounds*
  (proof-sym "H4-INDEX-IN-BOUNDS-CONSP" "ACL2"))

(defun h4-book-arithmetic-predecessor (value)
  (library-plus *proof-neg-one* value))

(defun h4-book-arithmetic-cancelled-predecessors-shifted (value offset-left)
  (if offset-left
      (h4-book-arithmetic-predecessor value)
    (library-plus value *proof-neg-one*)))

(defun h4-book-arithmetic-cancelled-predecessors-equal (hypothesis p offset-left)
  (let ((proof (library-library-proof p))
        (shifted (h4-book-arithmetic-cancelled-predecessors-shifted *library-x* offset-left)))
    (proof-with-checked-results
     ((identity (proof-proof-reflexive proof shifted))
      (child-equal (proof-proof-rewrite proof identity hypothesis
                                       (list 1 2 (if offset-left 2 1))))
      (same (proof-proof-fact proof "equal-same" (list (list *library-x* shifted))))
      (true-before (proof-proof-rewrite proof same child-equal '(1 1 2)))
      (same (proof-proof-fact proof "equal-same" nil))
      (true-after (proof-proof-rewrite proof same hypothesis '(1 1 2)))
      (symmetric (proof-proof-symmetric proof true-after)))
     (proof-proof-chain proof true-before (list symmetric)))))

(defun h4-book-arithmetic-cancelled-predecessors-distinct (hypothesis p offset-left before integers)
  (let ((proof (library-library-proof p))
        (shifted (h4-book-arithmetic-cancelled-predecessors-shifted *library-x* offset-left)))
    (proof-with-checked-results
     ((identity (proof-proof-reflexive proof (library-plus *proof-one* shifted)))
      (assumed (proof-proof-assume proof before t))
      (restored (proof-proof-rewrite proof identity assumed '(1 2 2)))
      (left (h4-association-step-at restored 1))
      (left (library-library-linear-equal p left *library-x* integers))
      (left (proof-proof-symmetric proof left))
      (right (h4-association-step-at restored 2))
      (right (library-library-linear-equal p right *library-y* integers))
      (equality (proof-proof-chain proof left (list restored right)))
      (contradiction (proof-proof-cut proof equality hypothesis))
      (no-before (proof-proof-front proof contradiction (proof-neg before)))
      (before-nil (h4-association-nil-value p no-before))
      (after-nil (h4-association-nil-value p hypothesis))
      (symmetric (proof-proof-symmetric proof after-nil)))
     (proof-proof-chain proof before-nil (list symmetric)))))

(defun h4-book-arithmetic-cancelled-predecessors (p offset-left label)
  (let* ((proof (library-library-proof p))
         (before (proof-eq
                  (h4-book-arithmetic-cancelled-predecessors-shifted *library-x* offset-left)
                  (h4-book-arithmetic-cancelled-predecessors-shifted *library-y* offset-left)))
         (after (proof-eq *library-x* *library-y*)))
    (proof-with-checked-results
     ((integers (library-library-ints p (list *library-x* *library-y*)))
      (assumed (proof-proof-assume proof after t))
      (yes (h4-book-arithmetic-cancelled-predecessors-equal assumed p offset-left))
      (assumed (proof-proof-assume proof after nil))
      (no (h4-book-arithmetic-cancelled-predecessors-distinct assumed p offset-left before integers))
      (cases (h4-association-case-of p (proof-eq before after) after yes no))
      (declared (h4-association-local-lemma p
                 (concatenate 'string "EQUAL-PREDECESSORS-" label) cases)))
     (cdr declared))))

(defun h4-book-arithmetic-index-bounds (p)
  (let* ((proof (library-library-proof p))
         (list-length (list *library-len* *library-y*))
         (shape (list *proof-consp* *library-y*)))
    (proof-with-checked-results
     ((index-natural (proof-proof-assume proof (list *library-natp* *library-x*) t))
      (bound (proof-proof-assume proof (library-lt *library-x* list-length) t))
      (atom-step (proof-proof-assume proof shape nil))
      (length-zero (h4-association-normalize p list-length (list atom-step)
                                            (list *library-len*) nil))
      (negative (proof-proof-rewrite proof bound length-zero '(1 2)))
      (nonnegative (library-library-cite p "NATURAL-NONNEGATIVE" (list *library-x*)
                                         (list index-natural)))
      (impossible (proof-proof-cut proof negative nonnegative))
      (consp-step (proof-proof-front proof impossible shape))
      (declared (h4-association-local-lemma p *h4-book-arithmetic-index-in-bounds* consp-step))
      (p (cdr declared))
      (proof (library-library-proof p))
      (pair (proof-proof-assume proof shape t))
      (opened (proof-proof-unfold proof list-length))
      (right (h4-association-step-at opened 2))
      (selected (proof-proof-select proof right pair))
      (length-equation (proof-proof-chain proof opened (list selected)))
      (original (proof-proof-rewrite proof bound length-equation '(1 2)))
      (child-index (h4-book-arithmetic-predecessor *library-x*))
      (tail-length (list *library-len* (list *library-cdr* *library-y*)))
      (integer-x (library-library-cite p "NATURAL-INTEGER" (list *library-x*) (list index-natural)))
      (integer-tail (library-library-type-of p tail-length nil))
      (integers (list integer-x integer-tail))
      (child (library-library-comparison p child-index tail-length integers))
      (original-left (h4-association-step-at original 1))
      (original-right (h4-association-step-at original 2))
      (parent (library-library-comparison p original-left original-right integers))
      (child-right (h4-association-step-at child 2))
      (child-difference (proof-term-at child-right 2))
      (parent-right (h4-association-step-at parent 2))
      (parent-difference (proof-term-at parent-right 2))
      (delta (library-library-linear-equal p child-difference parent-difference integers))
      (child (proof-proof-rewrite proof child delta '(1 2 2)))
      (symmetric (proof-proof-symmetric proof parent))
      (comparison (proof-proof-chain proof child (list symmetric)))
      (bounded (proof-proof-transport proof original comparison))
      (declared (h4-association-local-lemma p "INDEX-BOUND-ON-CDR" bounded)))
     (cdr declared))))

(defun h4-book-arithmetic-countdown-lemmas (p)
  (let* ((proof (library-library-proof p))
         (test (list *h4-book-arithmetic-zp* *library-x*))
         (integral (library-integer *library-x*))
         (positive (library-positive *library-x*)))
    (proof-with-checked-results
     ((active (proof-proof-assume proof test nil))
      (invalid (proof-proof-assume proof integral nil))
      (stopped (h4-association-establish p test (list invalid)
                                         (list *h4-book-arithmetic-zp*) nil))
      (contradiction (proof-proof-cut proof stopped active))
      (integer-x (proof-proof-front proof contradiction integral))
      (declared (h4-association-local-lemma p "COUNTDOWN-INTEGER" integer-x))
      (p (cdr declared))
      (proof (library-library-proof p))
      (not-positive (proof-proof-assume proof positive nil))
      (stopped (h4-association-establish p test (list integer-x not-positive)
                                         (list *h4-book-arithmetic-zp* *proof-not*) nil))
      (contradiction (proof-proof-cut proof stopped active))
      (above-zero (proof-proof-front proof contradiction positive))
      (declared (h4-association-local-lemma p "COUNTDOWN-POSITIVE" above-zero))
      (p (cdr declared))
      (proof (library-library-proof p))
      (discrete (proof-proof-fact proof "integer-discrete" nil))
      (premise (h4-association-step-at discrete 1))
      (evidence (h4-association-conjunction p premise integer-x above-zero))
      (at-least-one (h4-association-modus-ponens p discrete evidence))
      (child (h4-book-arithmetic-predecessor *library-x*))
      (integers (list integer-x))
      (comparison (library-library-comparison p child *proof-zero* integers))
      (difference (library-library-linear-equal p (library-diff *proof-zero* child)
                                                 (library-diff *proof-one* *library-x*) integers))
      (shifted (proof-proof-rewrite proof comparison difference '(1 2 2)))
      (comparison (library-library-comparison p *library-x* *proof-one* integers))
      (symmetric (proof-proof-symmetric proof comparison))
      (comparison (proof-proof-chain proof shifted (list symmetric)))
      (symmetric (proof-proof-symmetric proof comparison))
      (child-bound (proof-proof-rewrite proof at-least-one symmetric '(1 1)))
      (child-integer (library-library-type-of p child integers))
      (natural (library-library-cite p "NATURAL-FROM-BOUNDS" (list child)
                                     (list child-integer child-bound)))
      (declared (h4-association-local-lemma p "COUNTDOWN-PREDECESSOR" natural))
      (p (cdr declared))
      (proof (library-library-proof p))
      (commuted (library-library-axiom p "COMMUTATIVITY-OF-+" (cdr child)))
      (right (proof-proof-rewrite proof natural commuted '(1 1)))
      (declared (h4-association-local-lemma p "COUNTDOWN-PREDECESSOR-RIGHT" right))
      (p (cdr declared))
      (proof (library-library-proof p))
      (natural-x (proof-proof-assume proof (list *library-natp* *library-x*) t))
      (integer-x (library-library-cite p "NATURAL-INTEGER" (list *library-x*) (list natural-x)))
      (nonnegative (library-library-cite p "NATURAL-NONNEGATIVE" (list *library-x*)
                                         (list natural-x)))
      (no-positive (proof-proof-assume proof positive nil))
      (trichotomy (library-library-axiom p "TRICHOTOMY" (list *library-x*)))
      (conjuncts (h4-association-conjunct p trichotomy))
      (number (h4-association-number p *library-x* (list integer-x)))
      (alternatives (h4-association-modus-ponens p (car conjuncts) number))
      (remaining (proof-proof-prove-if proof alternatives no-positive))
      (zero (proof-eq *library-x* *proof-zero*))
      (not-zero (proof-proof-assume proof zero nil))
      (negative (proof-proof-prove-if proof remaining not-zero))
      (comparison (library-library-comparison p *library-x* *proof-zero* (list integer-x)))
      (difference (library-library-linear-equal p (library-diff *proof-zero* *library-x*)
                                                 (library-minus *library-x*) (list integer-x)))
      (opposite (proof-proof-rewrite proof comparison difference '(1 2 2)))
      (negative (proof-proof-transport proof negative opposite))
      (contradiction (proof-proof-cut proof negative nonnegative))
      (zero-value (proof-proof-front proof contradiction zero))
      (declared (h4-association-local-lemma
                 p *h4-book-arithmetic-natural-nonpositive-zero* zero-value))
      (p (cdr declared))
      (proof (library-library-proof p))
      (stopped (proof-proof-assume proof test t))
      (normal (h4-association-normalize p test (list integer-x) (list *h4-book-arithmetic-zp*) nil))
      (sign (proof-proof-rewrite proof stopped normal '(1)))
      (zero-value (proof-proof-use proof *h4-book-arithmetic-natural-nonpositive-zero* nil
                                   (list sign natural-x)))
      (declared (h4-association-local-lemma p *h4-book-arithmetic-natural-countdown-zero* zero-value))
      (p (h4-book-arithmetic-cancelled-predecessors (cdr declared) t "LEFT"))
      (p (h4-book-arithmetic-cancelled-predecessors p nil "RIGHT")))
     (h4-book-arithmetic-index-bounds p))))
