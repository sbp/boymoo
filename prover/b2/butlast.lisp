(in-package "BOYMOO-PROVER")
(set-verify-guards-eagerness 0)

(defmacro b2-butlast-declare-events ()
  '(progn

(defconst *b2-butlast-butlast* (proof-cl "BUTLAST"))
(defconst *b2-butlast-take* (proof-sym "TAKE" "ACL2"))
(defconst *b2-butlast-nfix* (proof-sym "NFIX" "ACL2"))
(defconst *b2-butlast-zp* (proof-sym "ZP" "ACL2"))

(defun b2-butlast-add-normalized-index (lib)
  (let* ((x *library-x*)
         (fixed (list *b2-butlast-nfix* x))
         (goal (proof-eq fixed (list *library-nfix* x))))
    (proof-with-checked-results
     ((same (b2-tactics-tactics-solve
             lib goal nil (list *b2-butlast-nfix* *library-nfix* *library-natp*) nil 0 nil))
      (natural (library-library-cite lib "NFIX-NATURAL" (list x) nil))
      (step (library-library-transport-argument lib natural same 1))
      (added (b2-tactics-tactics-add-lemma lib "NFIX-NATURAL" step :none)))
     (cdr added))))

(defun b2-butlast-normalized-index (lib term)
  (let* ((label (proof-sym "B2-NFIX-NATURAL" "ACL2"))
         (proof (library-library-proof lib)))
    (proof-with-checked-results
     ((lib (if (assoc-equal label (proof-proof-facts proof))
               lib
             (b2-butlast-add-normalized-index lib)))
      (step (proof-proof-fact (library-library-proof lib) label
                              (list (list *library-x* term)))))
     (cons step lib))))

(mutual-recursion
 (defun b2-butlast-simplify (n lib term)
   (declare (xargs :measure (nfix n)))
   (let ((proof (library-library-proof lib))
         (head (car term)))
     (cond
      ((zp n) '(:failure "Fuel" "b2-butlast-simplify"))
      ((or (not (proof-compound term)) (equal head *proof-quote*)) nil)
      ((endp term) '(:failure "tactic-rejected" ""))
      ((proof-compound head)
       (proof-with-checked-results
        ((expansion (proof-simplify-expansion proof term))
         (next (b2-butlast-simplify (1- n) lib (cadr expansion))))
        (proof-proof-chain proof (car expansion) (list next))))
      ((equal head *proof-if*)
       (proof-with-checked-results
        ((test (proof-term-at term 1))
         (first (b2-butlast-simplify (1- n) lib test))
         (path (proof-simplify-if-path proof term first nil)))
        (if (eq (car path) :simplify)
            (proof-with-checked-results
             ((next (b2-butlast-simplify (1- n) lib (caddr path))))
             (proof-proof-chain proof (cadr path) (list next)))
          path)))
      (t
       (proof-with-checked-results
        ((result (b2-butlast-simplify-arguments (1- n) lib term (cdr term) 1 nil))
         (current (if result (proof-rewritten-term result) term))
         (constant (b2-tactics-tactics-constant lib current)))
        (cond ((not constant) result)
              (result (proof-proof-chain proof result (list constant)))
              (t constant)))))))
 (defun b2-butlast-simplify-arguments (n lib term arguments index result)
   (declare (xargs :measure (nfix n)))
   (cond ((zp n) '(:failure "Fuel" "b2-butlast-simplify-arguments"))
         ((endp arguments) result)
         (t (proof-with-checked-results
             ((equality (b2-butlast-simplify (1- n) lib (car arguments)))
              (next (proof-simplify-argument-result
                     (library-library-proof lib) term index result equality)))
             (b2-butlast-simplify-arguments (1- n) lib term (cdr arguments) (1+ index) next))))))

(defun b2-butlast-simplify-first (lib step)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
     ((literal (proof-step-first step))
      (equality (b2-butlast-simplify 1000000 lib literal)))
     (if equality
         (proof-with-checked-results
          ((rewritten (proof-proof-rewrite proof step equality '(1))))
          (proof-proof-tidy proof rewritten))
       step))))

(defun b2-butlast-integer-after-successor (lib ordered types)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
     ((first (proof-step-first ordered))
      (fields (proof-list-of-length first 3))
      (a (cadr fields))
      (b (caddr fields))
      (difference (library-diff b a))
      (comparison (library-library-comparison lib a b types))
      (positive (proof-proof-rewrite proof ordered comparison '(1)))
      (typed (library-library-type-of lib difference types))
      (discrete (b2-tactics-tactics-use-fact
                 lib '("str" "integer-discrete") (proof-neg (library-lt difference *proof-one*))
                 (list typed positive) nil nil 0 nil))
      (equation (library-library-axiom lib "<-ON-OTHERS" (list difference *proof-one*)))
      (reduced (proof-proof-rewrite proof discrete equation '(1 1)))
      (reduced (b2-butlast-simplify-first lib reduced)))
     (b2-tactics-tactics-weak-from-difference lib (library-plus *proof-one* a) b reduced types))))

(defun b2-butlast-truncation-lib (truncation)
  (cadr truncation))

(defun b2-butlast-truncation-index (truncation)
  (caddr truncation))

(defun b2-butlast-truncation-fixed (truncation)
  (cadddr truncation))

(defun b2-butlast-truncation-natural (truncation)
  (nth 4 truncation))

(defun b2-butlast-truncation-integer (truncation)
  (nth 5 truncation))

(defun b2-butlast-truncation-nonnegative (truncation)
  (nth 6 truncation))

(defun b2-butlast-truncation-init (lib index)
  (let ((fixed (list *b2-butlast-nfix* index)))
    (proof-with-checked-results
     ((result (b2-butlast-normalized-index lib index))
      (natural (car result))
      (lib (cdr result))
      (integer (library-library-cite lib "NATURAL-INTEGER" (list fixed) (list natural)))
      (nonnegative (library-library-cite lib "NATURAL-NONNEGATIVE" (list fixed) (list natural))))
     (list :b2-butlast-truncation lib index fixed natural integer nonnegative))))

(defun b2-butlast-truncation-take (truncation lst)
  (list *b2-butlast-take*
        (library-diff (list *library-len* lst) (b2-butlast-truncation-fixed truncation))
        lst))

(defun b2-butlast-truncation-count-test (truncation length comparison want-positive)
  (let* ((lib (b2-butlast-truncation-lib truncation))
         (proof (library-library-proof lib))
         (fixed (b2-butlast-truncation-fixed truncation))
         (count (library-diff length fixed))
         (integers (list (b2-butlast-truncation-integer truncation))))
    (proof-with-checked-results
     ((equation (library-library-comparison lib fixed length integers))
      (place (if want-positive '(1) '(1 1)))
      (bound (proof-proof-rewrite proof comparison equation place))
      (integer-count (library-library-type-of lib count integers))
      (test (list *b2-butlast-zp* count)))
     (b2-tactics-tactics-solve lib (if want-positive (proof-neg test) test)
                              (list bound integer-count) (list *b2-butlast-zp*) nil 0 nil))))

(defun b2-butlast-truncation-empty (truncation lst atom)
  (let* ((lib (b2-butlast-truncation-lib truncation))
         (proof (library-library-proof lib))
         (length (list *library-len* lst)))
    (proof-with-checked-results
     ((unfolded (b2-tactics-tactics-normalize lib length (list atom) (list length) nil 1500 nil))
      (reversed (proof-proof-symmetric proof unfolded))
      (comparison (proof-proof-rewrite
                   proof (b2-butlast-truncation-nonnegative truncation) reversed '(1 1 2)))
      (comparison (proof-proof-tidy proof comparison))
      (call (list *b2-butlast-butlast* lst (b2-butlast-truncation-index truncation))))
     (b2-tactics-tactics-normalize lib call (list comparison) (list call) nil 1500 nil))))

(defun b2-butlast-truncation-take-equals-butlast (truncation lst)
  (let* ((lib (b2-butlast-truncation-lib truncation))
         (proof (library-library-proof lib))
         (length (list *library-len* lst))
         (test (library-lt (b2-butlast-truncation-fixed truncation) length))
         (call (list *b2-butlast-butlast* lst (b2-butlast-truncation-index truncation)))
         (taken (b2-butlast-truncation-take truncation lst)))
    (proof-with-checked-results
     ((yes (proof-proof-assume proof test t))
      (no (proof-proof-assume proof test nil))
      (when-nonempty (b2-tactics-tactics-normalize lib call (list yes) (list call) nil 1500 nil))
      (empty-call (b2-tactics-tactics-normalize lib call (list no) (list call) nil 1500 nil))
      (zero (b2-butlast-truncation-count-test truncation length no nil))
      (empty-take (b2-tactics-tactics-normalize lib taken (list zero) (list taken) nil 1500 nil))
      (reversed (proof-proof-symmetric proof empty-take))
      (when-empty (proof-proof-chain proof empty-call (list reversed))))
     (proof-proof-cases proof test when-nonempty when-empty))))

(defun b2-butlast-selector-call (formula)
  (proof-with-checked-results
   ((fields (proof-list-of-length formula 3))
    (selector (proof-list-of-length (cadr fields) 2)))
   (cadr selector)))

(defun b2-butlast-truncation-selector (truncation formula)
  (let* ((lib (b2-butlast-truncation-lib truncation))
         (proof (library-library-proof lib)))
    (proof-with-checked-results
     ((call (b2-butlast-selector-call formula))
      (terms (proof-list-of-length call 3))
      (lst (cadr terms))
      (length (list *library-len* lst))
      (test (library-lt (b2-butlast-truncation-fixed truncation) length))
      (yes (proof-proof-assume proof test t))
      (no (proof-proof-assume proof test nil))
      (nonempty (b2-butlast-truncation-count-test truncation length yes t))
      (taken (b2-butlast-truncation-take truncation lst))
      (good (b2-tactics-tactics-solve lib formula (list yes nonempty) (list call taken) nil 0 nil))
      (bad (b2-tactics-tactics-solve lib formula (list no) (list call) nil 0 nil)))
     (proof-proof-cases proof test good bad))))

(defun b2-butlast-truncation-cons (truncation formula)
  (let* ((lib (b2-butlast-truncation-lib truncation))
         (proof (library-library-proof lib))
         (fixed (b2-butlast-truncation-fixed truncation))
         (integer (b2-butlast-truncation-integer truncation)))
    (proof-with-checked-results
     ((fields (proof-list-of-length formula 3))
      (call (cadr fields))
      (terms (proof-list-of-length call 3))
      (pair (cadr terms))
      (tail (proof-term-at pair 2))
      (tail-length (list *library-len* tail))
      (pair-length (list *library-len* pair))
      (length-equation (b2-tactics-tactics-normalize lib pair-length nil (list pair-length) nil 1500 nil))
      (bound (library-lt tail-length fixed))
      (positive (proof-proof-assume proof bound t))
      (negative (proof-proof-assume proof bound nil))
      (big (b2-butlast-integer-after-successor lib positive (list integer)))
      (reversed (proof-proof-symmetric proof length-equation))
      (big (proof-proof-rewrite proof big reversed '(1 1 2)))
      (big (proof-proof-tidy proof big))
      (no (b2-tactics-tactics-solve lib formula (list positive big) (list call) nil 0 nil))
      (tail-integer (library-library-type-of lib tail-length nil))
      (small (library-library-cite lib "LESS-THAN-NEXT" (list tail-length fixed)
                                    (list tail-integer integer negative)))
      (small (library-library-transport-argument lib small length-equation 2))
      (nonzero (b2-butlast-truncation-count-test truncation pair-length small t))
      (taken (b2-butlast-truncation-take truncation pair))
      (suffix (library-plus *proof-neg-one* (library-diff pair-length fixed)))
      (reflexive (proof-proof-reflexive proof suffix))
      (normalized (proof-proof-rewrite proof reflexive length-equation '(1 2 2 1)))
      (first (proof-step-first normalized))
      (rhs (proof-term-at first 2))
      (linear (b2-tactics-tactics-linear-equal lib rhs (library-diff tail-length fixed) (list integer)))
      (suffix-equation (proof-proof-chain proof normalized (list linear)))
      (tail-equation (b2-butlast-truncation-take-equals-butlast truncation tail))
      (tail-equation (proof-proof-symmetric proof tail-equation))
      (yes (b2-tactics-tactics-solve
            lib formula (list negative small nonzero) (list call taken)
            (list suffix-equation tail-equation) 0 nil)))
     (proof-proof-cases proof bound no yes))))

(defun b2-butlast-truncation-cdr (truncation formula)
  (let* ((lib (b2-butlast-truncation-lib truncation))
         (proof (library-library-proof lib))
         (index (b2-butlast-truncation-index truncation))
         (fixed (b2-butlast-truncation-fixed truncation))
         (integer (b2-butlast-truncation-integer truncation)))
    (proof-with-checked-results
     ((call (b2-butlast-selector-call formula))
      (terms (proof-list-of-length call 3))
      (lst (cadr terms))
      (cons-test (list *proof-consp* lst))
      (cons-step (proof-proof-assume proof cons-test t))
      (atom (proof-proof-assume proof cons-test nil))
      (pair (list *proof-cons* (list *library-car* lst) (list *library-cdr* lst)))
      (elim (library-library-axiom lib "CAR-CDR-ELIM" (list lst)))
      (rebuilt (proof-proof-modus-ponens proof elim cons-step))
      (rule-name (proof-sym "BUTLAST-OF-CONS" "ACL2"))
      (clause (b2-arithmetic-require rule-name (proof-proof-facts proof)))
      (literal (proof-term-at clause 0))
      (pattern (proof-term-at literal 1))
      (expanded (b2-tactics-tactics-exact lib rule-name pattern
                                          (list *b2-butlast-butlast* pair index)))
      (rule (proof-proof-rewrite proof expanded rebuilt '(1 1 1)))
      (tail (list *library-cdr* lst))
      (tail-call (list *b2-butlast-butlast* tail index))
      (tail-length (list *library-len* tail))
      (bound (library-lt tail-length fixed))
      (large (proof-proof-assume proof bound t))
      (small (proof-proof-assume proof bound nil))
      (tail-typed (library-library-type-of lib tail-length nil))
      (not-large (library-library-cite lib "LESS-TO-WEAK" (list tail-length fixed)
                                        (list tail-typed integer large)))
      (yes-empty (b2-tactics-tactics-solve lib formula (list large not-large) (list tail-call) (list rule) 0 nil))
      (yes-cons (b2-tactics-tactics-solve lib formula (list small) nil (list rule) 0 nil))
      (yes (proof-proof-cases proof bound yes-empty yes-cons))
      (empty (b2-butlast-truncation-empty truncation lst atom))
      (nil-atom (b2-tactics-tactics-solve
                 lib (proof-neg (list *proof-consp* *proof-false*)) nil nil nil 0 nil))
      (nil-empty (b2-butlast-truncation-empty truncation *proof-false* nil-atom))
      (no (b2-tactics-tactics-solve lib formula (list atom) nil (list empty nil-empty) 0 nil)))
     (proof-proof-cases proof cons-test yes no))))

(defun b2-butlast-prove-butlast (lib name formula)
  (let ((empty (equal name (proof-sym "BUTLAST-OF-NIL" "ACL2")))
        (cons-case (equal name (proof-sym "BUTLAST-OF-CONS" "ACL2"))))
    (proof-with-checked-results
     ((left (proof-term-at formula 1))
      (call (cond (empty (proof-with-checked-results ((fields (proof-list-of-length formula 3)))
                           (cadr fields)))
                  (cons-case left)
                  (t (proof-with-checked-results ((fields (proof-list-of-length left 2)))
                       (cadr fields)))))
      (index (proof-term-at call 2))
      (truncation (b2-butlast-truncation-init lib index))
      (lib (b2-butlast-truncation-lib truncation))
      (step (cond
             (empty
              (proof-with-checked-results
               ((atom (b2-tactics-tactics-solve
                       lib (proof-neg (list *proof-consp* *proof-false*)) nil nil nil 0 nil)))
               (b2-butlast-truncation-empty truncation *proof-false* atom)))
             (cons-case (b2-butlast-truncation-cons truncation formula))
             ((equal name (proof-sym "CDR-OF-BUTLAST" "ACL2"))
              (b2-butlast-truncation-cdr truncation formula))
             (t (b2-butlast-truncation-selector truncation formula)))))
     (cons step lib))))
))
