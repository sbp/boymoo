(in-package "BOYMOO-PROVER")
(set-verify-guards-eagerness 0)

(defconst *b2-projections-mv-nth* (proof-sym "MV-NTH" "ACL2"))
(defconst *b2-projections-zp* (proof-sym "ZP" "ACL2"))

(defun b2-projections-mv-nth-prepare (lib index value)
  (let* ((name (concatenate 'string "MV-NTH-" (decimal-text index)))
         (symbol (proof-sym (concatenate 'string "B2-" name) "ACL2"))
         (proof (library-library-proof lib)))
    (if (assoc-equal symbol (proof-proof-facts proof))
        (proof-with-checked-results
            ((step (proof-proof-fact proof symbol (list (list *library-x* value)))))
          (cons step lib))
      (let ((call (list *b2-projections-mv-nth* (proof-quote index) *library-x*))
            (test (list *proof-consp* *library-x*)))
        (proof-with-checked-results
            ((field (b2-tactics-field *library-x* index))
             (formula (proof-eq call field))
             (has-cons (proof-proof-assume proof test t))
             (atom (proof-proof-assume proof test nil)))
          (list :projection name symbol formula test (list call *b2-projections-zp*)
                has-cons atom))))))

(defun b2-projections-mv-nth-finish (prepared child index value)
  (let* ((lib (cdr child))
         (proof (library-library-proof lib))
         (name (cadr prepared))
         (symbol (caddr prepared))
         (formula (cadddr prepared))
         (test (nth 4 prepared))
         (unfold (nth 5 prepared))
         (has-cons (nth 6 prepared))
         (atom (nth 7 prepared))
         (rules (if (equal index 0) nil (list (car child)))))
    (proof-with-checked-results
        ((yes (b2-tactics-tactics-solve lib formula (list has-cons) unfold rules 0 nil))
         (no (b2-tactics-tactics-solve lib formula (list atom) unfold nil 0 nil))
         (step (proof-proof-cases proof test yes no))
         (added (b2-tactics-tactics-add-lemma lib name step :none))
         (lib (cdr added))
         (step (proof-proof-fact (library-library-proof lib) symbol
                                 (list (list *library-x* value)))))
      (cons step lib))))

(defun b2-projections-mv-nth-with-fuel (n prepared lib index value)
  (declare (xargs :measure (nfix n)))
  (cond ((zp n) '(:failure "Fuel" "b2-projections-mv-nth-with-fuel"))
        ((not (eq (car prepared) :projection)) prepared)
        ((equal index 0) (b2-projections-mv-nth-finish prepared (cons nil lib) index value))
        (t (let* ((next-index (1- index))
                  (next-value (list *library-cdr* *library-x*))
                  (next (if (equal n 1) nil
                          (b2-projections-mv-nth-prepare lib next-index next-value))))
             (proof-with-checked-results
                 ((child (b2-projections-mv-nth-with-fuel (1- n) next lib next-index next-value)))
               (b2-projections-mv-nth-finish prepared child index value))))))

(defun b2-projections-mv-nth (lib index value)
  (b2-projections-mv-nth-with-fuel
   1000000 (b2-projections-mv-nth-prepare lib index value) lib index value))

(defun b2-projections-projected-value (lib index body evidence)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((first (proof-step-first body))
         (parts (proof-list-of-length first 3))
         (expression (list *b2-projections-mv-nth* (proof-quote index) (cadr parts)))
         (lifted (proof-proof-reflexive proof expression))
         (lifted (proof-proof-rewrite proof lifted body '(1 2 2)))
         (projection (b2-projections-mv-nth lib index (caddr parts)))
         (lib (cdr projection))
         (proof (library-library-proof lib))
         (selected (proof-proof-chain proof lifted (list (car projection))))
         (first (proof-step-first selected))
         (right (proof-term-at first 2))
         (normal (b2-tactics-tactics-normalize lib right evidence nil nil 1500 nil))
         (step (proof-proof-chain proof selected (list normal))))
      (cons step lib))))
