(in-package "BOYMOO-PROVER")

(set-verify-guards-eagerness 0)

(defconst *b2-scaling-two* (proof-quote 2))
(defconst *b2-scaling-half* (proof-quote '("ratio" 1 2)))
(defconst *b2-scaling-power* (proof-sym "POWER-OF-2-HELPER" "ACL2"))

(defun b2-scaling-rational-op (lib name term evidence)
  (b2-tactics-tactics-use-fact lib (list "str" (concatenate 'string "rationalp-" name))
                              (list *library-rationalp* term) evidence nil nil 0 nil))

(defun b2-scaling-number-of-rational (lib term rational)
  (b2-tactics-tactics-use-fact lib '("str" "rationalp-acl2-numberp")
                              (list *library-numberp* term) (list rational) nil nil 0 nil))

(defun b2-scaling-opposite-sign (lib term rational)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
     ((result (library-library-axiom lib "<-ON-OTHERS" (list *proof-zero* (library-minus term))))
      (number (b2-scaling-number-of-rational lib term rational))
      (double-minus (b2-fraction-reduction-twice-negated lib term number))
      (result (proof-proof-rewrite proof result double-minus '(1 2 1 2)))
      (sum-unit (b2-fraction-reduction-sum-unit lib term number))
      (result (proof-proof-rewrite proof result sum-unit '(1 2 1))))
     (proof-proof-tidy proof result))))

(defun b2-scaling-positive-is-nonnegative (lib term pos rational)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
     ((trichotomy (library-library-axiom lib "TRICHOTOMY" (list term)))
      (conjuncts (proof-proof-conjunct proof trichotomy))
      (not-not (b2-tactics-tactics-solve lib (proof-neg (proof-neg (library-positive term)))
                                         (list pos) nil nil 0 nil))
      (prove (proof-proof-prove-if proof (cadr conjuncts) not-not))
      (sign (b2-scaling-opposite-sign lib term rational))
      (prove (proof-proof-rewrite proof prove sign '(1 1))))
     (proof-proof-tidy proof prove))))

(defun b2-scaling-scaled-sign (lib value scale rat-value rat-scale positive-scale)
  (let* ((proof (library-library-proof lib))
         (value-test (library-lt value *proof-zero*))
         (result (b2-products-product scale value))
         (result-test (library-lt result *proof-zero*))
         (negative (library-minus value)))
    (proof-with-checked-results
     ((sign (proof-proof-assume proof value-test t))
      (nonnegative (proof-proof-assume proof value-test nil))
      (rat-product (b2-scaling-rational-op lib "binary-*" result (list rat-scale rat-value)))
      (rat-negative (b2-scaling-rational-op lib "unary--" negative (list rat-value)))
      (mirror (b2-scaling-opposite-sign lib value rat-value))
      (pos-minus (proof-proof-transport proof sign mirror))
      (positive (library-library-cite lib "POSITIVE-PRODUCT" (list scale negative)
                                      (list rat-scale rat-negative positive-scale pos-minus)))
      (negative-factor (b2-fraction-reduction-negative-factor lib scale value))
      (lib (cdr negative-factor))
      (proof (library-library-proof lib))
      (positive (proof-proof-rewrite proof positive (car negative-factor) '(1 2)))
      (positive (proof-proof-tidy proof positive))
      (opposite-sign (b2-scaling-opposite-sign lib result rat-product))
      (below-zero (proof-proof-rewrite proof positive opposite-sign '(1)))
      (below-zero (proof-proof-tidy proof below-zero))
      (goal (proof-eq result-test value-test))
      (yes (b2-tactics-tactics-solve lib goal (list sign below-zero) nil nil 0 nil))
      (test (library-lt *proof-zero* value))
      (yes-pos (proof-proof-assume proof test t))
      (no-pos (proof-proof-assume proof test nil))
      (output-pos (library-library-cite lib "POSITIVE-PRODUCT" (list scale value)
                                        (list rat-scale rat-value positive-scale yes-pos)))
      (output-nonnegative (b2-scaling-positive-is-nonnegative lib result output-pos rat-product))
      (plus-branch (b2-tactics-tactics-solve lib goal (list nonnegative output-nonnegative)
                                            nil nil 0 nil))
      (trichotomy (library-library-axiom lib "TRICHOTOMY" (list value)))
      (conjuncts (proof-proof-conjunct proof trichotomy))
      (number (b2-scaling-number-of-rational lib value rat-value))
      (tri (proof-proof-modus-ponens proof (car conjuncts) number))
      (not-mirror (library-library-transport-argument lib nonnegative mirror 1))
      (zero (b2-tactics-tactics-from-impossible lib (proof-eq value *proof-zero*) tri
                                                (list no-pos nonnegative not-mirror) nil nil 1500 nil))
      (zero-product (b2-products-zero-product lib scale))
      (lib (cdr zero-product))
      (proof (library-library-proof lib))
      (zero-branch (b2-tactics-tactics-solve lib goal (list zero) nil (list (car zero-product)) 0 nil))
      (nonnegative-case (proof-proof-cases proof test plus-branch zero-branch))
      (step (proof-proof-cases proof value-test yes nonnegative-case)))
     (cons step lib))))

(defun b2-scaling-install-rational-scale-order (lib)
  (let* ((proof (library-library-proof lib))
         (x *library-x*)
         (y *library-y*)
         (z *library-z*)
         (delta (library-diff x y)))
    (proof-with-checked-results
     ((a-rat (proof-proof-assume proof (list *library-rationalp* x) t))
      (b-rat (proof-proof-assume proof (list *library-rationalp* y) t))
      (scale-rat (proof-proof-assume proof (list *library-rationalp* z) t))
      (pos (proof-proof-assume proof (library-positive z) t))
      (negative (b2-scaling-rational-op lib "unary--" (library-minus y) (list b-rat)))
      (difference-rat (b2-scaling-rational-op lib "binary-+" delta (list a-rat negative)))
      (sign-eq (b2-scaling-scaled-sign lib delta z difference-rat scale-rat pos))
      (lib (cdr sign-eq))
      (prod-a (b2-products-product z x))
      (prod-b (b2-products-product z y))
      (expansion (library-library-axiom lib "DISTRIBUTIVITY" (list z x (library-minus y))))
      (negative-factor (b2-fraction-reduction-negative-factor lib z y))
      (lib (cdr negative-factor))
      (proof (library-library-proof lib))
      (expansion (proof-proof-rewrite proof expansion (car negative-factor) '(1 2 2)))
      (output (library-library-axiom lib "<-ON-OTHERS" (list prod-a prod-b)))
      (expansion (proof-proof-symmetric proof expansion))
      (output (proof-proof-rewrite proof output expansion '(1 2 1)))
      (original (library-library-axiom lib "<-ON-OTHERS" (list x y)))
      (original (proof-proof-symmetric proof original))
      (result (proof-proof-chain proof output (list (car sign-eq) original)))
      (result-first (proof-step-first result))
      (a-first (proof-step-first a-rat))
      (b-first (proof-step-first b-rat))
      (scale-first (proof-step-first scale-rat))
      (pos-first (proof-step-first pos))
      (added (b2-tactics-tactics-add-lemma lib "RATIONAL-SCALE-ORDER" result
                                         (list result-first (proof-neg a-first) (proof-neg b-first)
                                               (proof-neg scale-first) (proof-neg pos-first)))))
     (cdr added))))

(defun b2-scaling-rational-scale-order (lib a b scale rationals positive-scale)
  (let* ((name (proof-sym "B2-RATIONAL-SCALE-ORDER" "ACL2"))
         (facts (proof-proof-facts (library-library-proof lib))))
    (proof-with-checked-results
     ((lib (if (assoc-equal name facts) lib (b2-scaling-install-rational-scale-order lib)))
      (step (proof-proof-use (library-library-proof lib) name
                            (list (list *library-x* a) (list *library-y* b) (list *library-z* scale))
                            (append rationals (list positive-scale)))))
     (cons step lib))))

(defun b2-scaling-fraction-data (lib value rational)
  (let ((d (list *b2-products-den* value))
        (n (list *b2-products-num* value)))
    (proof-with-checked-results
     ((factors (b2-products-rational-factors lib value rational))
      (representation (b2-products-rational-product lib value rational))
      (lib (cdr representation))
      (commute (library-library-axiom lib "COMMUTATIVITY-OF-*" (list d value)))
      (commuted (proof-proof-chain (library-library-proof lib) commute (list (car representation)))))
     (cons (list d n (car factors) (cadr factors) (caddr factors) commuted) lib))))

(defun b2-scaling-doubled (lib term typed)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
     ((first (library-library-axiom lib "COMMUTATIVITY-OF-*" (list *b2-scaling-two* term)))
      (sum-one (proof-proof-compute proof (library-plus *proof-one* *proof-one*) 2))
      (sum-one (proof-proof-symmetric proof sum-one))
      (first (proof-proof-rewrite proof first sum-one '(1 2 2)))
      (distribute (library-library-axiom lib "DISTRIBUTIVITY" (list term *proof-one* *proof-one*)))
      (first (proof-proof-chain proof first (list distribute)))
      (commute (library-library-axiom lib "COMMUTATIVITY-OF-*" (list term *proof-one*)))
      (number (library-library-number lib term (list typed)))
      (unit (b2-products-multiplicative-unit lib term number))
      (unity (proof-proof-chain proof commute (list unit))))
     (proof-proof-rewrite-first proof first unity))))

(defun b2-scaling-rank-gap-large (lib d n d-type n-type dp regime scale-eq types)
  (let ((proof (library-library-proof lib))
        (den-product (b2-products-product d *b2-scaling-two*)))
    (proof-with-checked-results
     ((reversed (proof-proof-symmetric proof scale-eq))
      (scaled-bound (proof-proof-rewrite proof regime reversed '(1 1)))
      (scaled-bound (proof-proof-tidy proof scaled-bound))
      (two (b2-scaling-doubled lib d d-type))
      (step (b2-tactics-tactics-less-from-difference lib d (library-plus d d) dp types))
      (step (library-library-transport-argument lib step two 2))
      (commute (library-library-axiom lib "COMMUTATIVITY-OF-*" (list d *b2-scaling-two*)))
      (step (library-library-transport-argument lib step commute 2))
      (product-type (library-library-type-of lib den-product types))
      (bound (library-library-cite lib "LESS-THEN-WEAK" (list d den-product n)
                                   (list d-type product-type n-type step scaled-bound)))
      (comparison (library-library-comparison lib d n types))
      (pos (proof-proof-rewrite proof bound comparison '(1)))
      (pos (proof-proof-tidy proof pos)))
     (cons (list (library-diff n d) pos) lib))))

(defun b2-scaling-rank-gap-small (lib d n regime scale-eq types)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
     ((commute (library-library-axiom lib "COMMUTATIVITY-OF-*" (list d *proof-one*)))
      (number (library-library-number lib d types))
      (unit (b2-products-multiplicative-unit lib d number))
      (unity (proof-proof-chain proof commute (list unit)))
      (scale-eq (proof-proof-rewrite proof scale-eq unity '(1 1 2)))
      (scale-eq (proof-proof-symmetric proof scale-eq))
      (bound (proof-proof-rewrite proof regime scale-eq '(1)))
      (bound (proof-proof-tidy proof bound))
      (comparison (library-library-comparison lib n d types))
      (pos (proof-proof-rewrite proof bound comparison '(1)))
      (pos (proof-proof-tidy proof pos)))
     (cons (list (library-diff d n) pos) lib))))

(defun b2-scaling-rank-gap (lib value rational regime large)
  (proof-with-checked-results
   ((fraction (b2-scaling-fraction-data lib value rational))
    (lib (cdr fraction))
    (parts (car fraction))
    (d (car parts))
    (n (cadr parts))
    (d-type (caddr parts))
    (n-type (cadddr parts))
    (dp (nth 4 parts))
    (rep (nth 5 parts))
    (types (list d-type n-type))
    (d-rat (library-library-rational lib d types))
    (factor (if large *b2-scaling-two* *proof-one*))
    (factor-rat (library-library-rational lib factor nil))
    (scale-eq (b2-scaling-rational-scale-order lib value factor d (list rational factor-rat d-rat) dp))
    (lib (cdr scale-eq))
    (scale-eq (proof-proof-rewrite (library-library-proof lib) (car scale-eq) rep '(1 1 1))))
   (if large
       (b2-scaling-rank-gap-large lib d n d-type n-type dp regime scale-eq types)
     (b2-scaling-rank-gap-small lib d n regime scale-eq types))))

(defun b2-scaling-evidence-at (found literal)
  (let ((entry (assoc-equal literal found)))
    (if entry
        (cdr entry)
      '(:failure "tactic-rejected" ""))))

(defun b2-scaling-expanded-fraction (lib value rational denominator representation
                                         d-type n-type d-positive)
  (let ((reduced (list *b2-products-den* value)))
    (proof-with-checked-results
     ((factors (b2-products-rational-factors lib value rational))
      (int-d (car factors))
      (int-n (cadr factors))
      (pos-d (caddr factors))
      (canonical (b2-products-rational-product lib value rational))
      (lib (cdr canonical))
      (canonical (car canonical))
      (int-candidate (library-library-transport-argument lib n-type representation 1))
      (int-canonical (library-library-transport-argument lib int-n canonical 1))
      (lemma (b2-fraction-reduction-common-lemma lib))
      (lib (cdr lemma))
      (proof (library-library-proof lib))
      (fact (proof-proof-fact proof (car lemma)
                             (list (list *library-z* value) (list *library-x* denominator)
                                   (list *library-y* reduced))))
      (literal (proof-step-first fact))
      (hypothesis (proof-term-at literal 1))
      (solved (b2-tactics-tactics-solve lib hypothesis
                                       (list d-type d-positive int-d pos-d int-candidate int-canonical)
                                       nil nil 0 nil))
      (proven (proof-proof-modus-ponens proof fact solved))
      (found (b2-tactics-tactics-evidence lib (list proven)))
      (triple (list *b2-fraction-reduction-common* denominator reduced))
      (g (b2-tactics-field triple 0))
      (scale (b2-tactics-field triple 1))
      (right (b2-tactics-field triple 2))
      (int-g (b2-scaling-evidence-at found (library-integer g)))
      (int-scale (b2-scaling-evidence-at found (library-integer scale)))
      (pos-scale (b2-scaling-evidence-at found (library-positive scale)))
      (right-eq (b2-scaling-evidence-at found (proof-eq reduced (b2-products-product right g))))
      (int-value-g (b2-scaling-evidence-at found (library-integer (b2-products-product value g))))
      (int-right (b2-scaling-evidence-at found (library-integer right)))
      (pos-right (b2-scaling-evidence-at found (library-positive right)))
      (divisor (b2-fraction-reduction-reduces-to-unit lib value rational canonical right-eq right g
                                                     (list int-g int-value-g int-right pos-right)))
      (g-is-reduced (proof-proof-rewrite proof right-eq divisor '(1 2 1)))
      (numeric (library-library-number lib g (list int-g)))
      (unit (b2-products-multiplicative-unit lib g numeric))
      (g-is-reduced (proof-proof-chain proof g-is-reduced (list unit)))
      (denom (b2-scaling-evidence-at found (proof-eq denominator (b2-products-product scale g))))
      (g-is-reduced (proof-proof-symmetric proof g-is-reduced))
      (denom (proof-proof-rewrite proof denom g-is-reduced '(1 2 2)))
      (denom (proof-proof-tidy proof denom))
      (reversed (proof-proof-symmetric proof representation))
      (numer (proof-proof-rewrite proof reversed denom '(1 2 2)))
      (swapped (b2-products-product-swap lib value scale reduced))
      (numer (proof-proof-chain proof numer (list swapped)))
      (numer (proof-proof-rewrite proof numer canonical '(1 2 2)))
      (numer (proof-proof-tidy proof numer)))
     (cons (list scale int-scale pos-scale denom numer) lib))))

(defun b2-scaling-fraction-for-scaled-large (lib x d n d-type n-type d-pos original)
  (let ((proof (library-library-proof lib))
        (twice (b2-products-product *b2-scaling-two* d)))
    (proof-with-checked-results
     ((step (library-library-axiom lib "ASSOCIATIVITY-OF-*" (list *b2-scaling-half* x twice)))
      (swapped (b2-products-product-swap lib *b2-scaling-half* x twice))
      (step (proof-proof-chain proof step (list swapped)))
      (inner (library-library-axiom lib "ASSOCIATIVITY-OF-*" (list *b2-scaling-half* *b2-scaling-two* d)))
      (inner (proof-proof-symmetric proof inner))
      (unit (b2-tactics-tactics-normalize lib (b2-products-product *b2-scaling-half* *b2-scaling-two*)
                                         nil nil nil 1500 nil))
      (inner (if unit
                 (proof-proof-rewrite proof inner unit '(1 2 1))
               '(:failure "failure" "")))
      (numeric (library-library-number lib d (list d-type)))
      (unit (b2-products-multiplicative-unit lib d numeric))
      (inner (proof-proof-chain proof inner (list unit)))
      (step (proof-proof-rewrite proof step inner '(1 2 2)))
      (step (proof-proof-chain proof step (list original)))
      (twice-rat (library-library-rational lib *b2-scaling-two* nil))
      (d-rat (library-library-rational lib d (list d-type)))
      (two-pos (b2-tactics-tactics-solve lib (library-positive *b2-scaling-two*) nil nil nil 0 nil))
      (pos (library-library-cite lib "POSITIVE-PRODUCT" (list *b2-scaling-two* d)
                                 (list twice-rat d-rat two-pos d-pos)))
      (twice-type (library-library-type-of lib twice (list d-type))))
     (cons (list twice n twice-type n-type pos step) lib))))

(defun b2-scaling-fraction-for-scaled (lib x rationals large)
  (proof-with-checked-results
   ((before-rat (proof-term-at rationals 0))
    (data (b2-scaling-fraction-data lib x before-rat))
    (lib (cdr data))
    (parts (car data))
    (d (car parts))
    (n (cadr parts))
    (d-type (caddr parts))
    (n-type (cadddr parts))
    (d-pos (nth 4 parts))
    (original (b2-products-rational-product lib x before-rat))
    (lib (cdr original))
    (original (car original)))
   (if large
       (b2-scaling-fraction-for-scaled-large lib x d n d-type n-type d-pos original)
     (let ((proof (library-library-proof lib))
           (twice (b2-products-product *b2-scaling-two* n)))
       (proof-with-checked-results
        ((step (library-library-axiom lib "ASSOCIATIVITY-OF-*" (list *b2-scaling-two* x d)))
         (step (proof-proof-rewrite proof step original '(1 2 2)))
         (step (proof-proof-tidy proof step))
         (twice-type (library-library-type-of lib twice (list n-type))))
        (cons (list d twice d-type twice-type d-pos step) lib))))))

(defun b2-scaling-power-measure (term)
  (let ((d (list *b2-products-den* term))
        (n (list *b2-products-num* term)))
    (list *library-nfix*
          (proof-ite (library-lt term *proof-one*) (library-diff d n)
                     (proof-ite (library-lt term *b2-scaling-two*) *proof-zero*
                                (library-diff n d))))))

(defun b2-scaling-power-decrease-measure-value (measure value sign selected lib types evidence)
  (proof-with-checked-results
   ((natural (if (equal value *proof-zero*)
                 (library-library-natural lib *proof-zero*)
               (proof-with-checked-results
                ((typed (library-library-type-of lib value types))
                 (nonnegative (library-library-cite lib "POSITIVE-NONNEGATIVE" (list value)
                                                     (list typed sign))))
                (b2-quotients-natural-proof lib value typed nonnegative)))))
   (b2-tactics-tactics-normalize lib measure (append evidence selected (list natural))
                                 (list *library-nfix*) nil 1500 nil)))

(defun b2-scaling-power-decrease-ordination (result child-value equation lib old-gap old-equation types)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
     ((child-type (library-library-type-of lib child-value types))
      (old-type (library-library-type-of lib old-gap types))
      (cmp (library-library-cite lib "FINITE-ORDER" (list child-value old-gap) (list child-type old-type)))
      (result (proof-proof-transport proof result cmp))
      (result (if equation
                  (library-library-transport-argument lib result equation 1)
                '(:failure "failure" ""))))
     (if old-equation
         (library-library-transport-argument lib result old-equation 2)
       '(:failure "failure" "")))))

(defun b2-scaling-power-decrease-value (measure)
  (proof-with-checked-results
   ((conditional (proof-term-at measure 1))
    (test (proof-term-at conditional 1)))
   (proof-term-at test 1)))

(defun b2-scaling-power-decrease-positive-atom (lib large x x-rat px x-div pos-d original types)
  (if large
      pos-d
    (let ((proof (library-library-proof lib)))
      (proof-with-checked-results
       ((d-rat (library-library-rational lib x-div types))
        (product-pos (library-library-cite lib "POSITIVE-PRODUCT" (list x-div x)
                                           (list d-rat x-rat pos-d px)))
        (pos-atom (proof-proof-rewrite proof product-pos original '(1 2))))
       (proof-proof-tidy proof pos-atom)))))

(defun b2-scaling-power-decrease (lib goal evidence)
  (proof-with-checked-results
   ((facts (b2-tactics-tactics-evidence lib evidence))
    (parts (proof-list-of-length goal 3))
    (smaller (cadr parts))
    (parent (caddr parts))
    (x (b2-scaling-power-decrease-value parent))
    (y (b2-scaling-power-decrease-value smaller))
    (factor (proof-term-at y 1))
    (large (equal factor *b2-scaling-half*))
    (multiplier (if large *b2-scaling-half* *b2-scaling-two*))
    (x-rat (b2-scaling-evidence-at facts (list *library-rationalp* x)))
    (px (b2-scaling-evidence-at facts (library-positive x)))
    (multiplier-rat (b2-tactics-tactics-solve lib (list *library-rationalp* multiplier) nil nil nil 0 nil))
    (y-rat (b2-scaling-rational-op lib "binary-*" y (list multiplier-rat x-rat)))
    (x-fraction (b2-scaling-fraction-data lib x x-rat))
    (lib (cdr x-fraction))
    (x-fraction (car x-fraction))
    (x-div (car x-fraction))
    (x-num (cadr x-fraction))
    (int-d (caddr x-fraction))
    (int-n (cadddr x-fraction))
    (pos-d (nth 4 x-fraction))
    (original (nth 5 x-fraction))
    (y-fraction (b2-scaling-fraction-data lib y y-rat))
    (lib (cdr y-fraction))
    (y-fraction (car y-fraction))
    (y-div (car y-fraction))
    (y-num (cadr y-fraction))
    (int-yd (caddr y-fraction))
    (int-yn (cadddr y-fraction))
    (types (list int-d int-n int-yd int-yn))
    (old-ruler (b2-scaling-evidence-at facts (if large
                                               (proof-neg (library-lt x *b2-scaling-two*))
                                             (library-lt x *proof-one*))))
    (old-rank (b2-scaling-rank-gap lib x x-rat old-ruler large))
    (lib (cdr old-rank))
    (old-gap (caar old-rank))
    (positive-old (cadar old-rank))
    (old-equation (b2-scaling-power-decrease-measure-value parent old-gap positive-old nil lib types evidence))
    (pivot (if large *b2-scaling-two* *proof-one*))
    (pivot-rat (library-library-rational lib pivot nil))
    (multiplier-rat (b2-tactics-tactics-solve lib (list *library-rationalp* multiplier) nil nil nil 0 nil))
    (positive-multiplier (b2-tactics-tactics-solve lib (library-positive multiplier) nil nil nil 0 nil))
    (theorem (b2-scaling-rational-scale-order lib x pivot multiplier
                                             (list x-rat pivot-rat multiplier-rat) positive-multiplier))
    (lib (cdr theorem))
    (proof (library-library-proof lib))
    (scale-pivot (b2-tactics-tactics-normalize lib (b2-products-product multiplier pivot) nil nil nil 1500 nil))
    (theorem (if scale-pivot
                 (proof-proof-rewrite proof (car theorem) scale-pivot '(1 1 2))
               '(:failure "failure" "")))
    (reversed (proof-proof-symmetric proof theorem))
    (child-guard (proof-proof-rewrite proof old-ruler reversed (if large '(1 1) '(1))))
    (child-guard (proof-proof-tidy proof child-guard))
    (split (library-lt y pivot))
    (child-active (proof-proof-assume proof split (not large)))
    (child-inactive (proof-proof-assume proof split large))
    (new-rank (b2-scaling-rank-gap lib y y-rat child-active large))
    (lib (cdr new-rank))
    (new-gap (caar new-rank))
    (positive-new (cadar new-rank))
    (active-eq (b2-scaling-power-decrease-measure-value smaller new-gap positive-new
                                                        (list child-guard child-active) lib types evidence))
    (inactive-eq (b2-scaling-power-decrease-measure-value smaller *proof-zero* nil
                                                          (list child-guard child-inactive) lib types evidence))
    (fraction (b2-scaling-fraction-for-scaled lib x (list x-rat y-rat) large))
    (lib (cdr fraction))
    (fraction (car fraction))
    (den (car fraction))
    (num (cadr fraction))
    (den-type (caddr fraction))
    (num-type (cadddr fraction))
    (den-pos (nth 4 fraction))
    (representation (nth 5 fraction))
    (expanded (b2-scaling-expanded-fraction lib y y-rat den representation den-type num-type den-pos))
    (lib (cdr expanded))
    (proof (library-library-proof lib))
    (expanded (car expanded))
    (ratio (car expanded))
    (int-ratio (cadr expanded))
    (pos-ratio (caddr expanded))
    (den-equation (cadddr expanded))
    (num-equation (nth 4 expanded))
    (types (append types (list int-ratio)))
    (candidate (if large (library-diff num den) (library-diff den num)))
    (a-eq (if large num-equation den-equation))
    (b-eq (if large den-equation num-equation))
    (as-diff (proof-proof-reflexive proof candidate))
    (as-diff (proof-proof-rewrite proof as-diff a-eq '(1 2 1)))
    (as-diff (proof-proof-rewrite proof as-diff b-eq '(1 2 2 1)))
    (start (if large y-div y-num))
    (finish (if large y-num y-div))
    (product-difference (b2-quotients-product-difference lib ratio start finish types))
    (lib (cdr product-difference))
    (proof (library-library-proof lib))
    (reversed (proof-proof-symmetric proof (car product-difference)))
    (as-diff (proof-proof-chain proof as-diff (list reversed)))
    (ratio-bound (b2-tactics-tactics-use-fact lib '("str" "integer-discrete")
                                             (library-le *proof-one* ratio) (list int-ratio pos-ratio)
                                             nil nil 0 nil))
    (weak (b2-quotients-scaled lib ratio-bound new-gap positive-new types nil))
    (lib (cdr weak))
    (weak (car weak))
    (proof (library-library-proof lib))
    (commute-unit (library-library-axiom lib "COMMUTATIVITY-OF-*" (list new-gap *proof-one*)))
    (numeric-gap (library-library-number lib new-gap types))
    (unit (b2-products-multiplicative-unit lib new-gap numeric-gap))
    (unit-gap (proof-proof-chain proof commute-unit (list unit)))
    (weak (proof-proof-rewrite proof weak unit-gap '(1 1 2)))
    (commute (library-library-axiom lib "COMMUTATIVITY-OF-*" (list new-gap ratio)))
    (weak (proof-proof-rewrite proof weak commute '(1 1 1)))
    (as-diff (proof-proof-symmetric proof as-diff))
    (weak (proof-proof-rewrite proof weak as-diff '(1 1 1)))
    (weak (proof-proof-tidy proof weak))
    (doubled-atom (if large x-div x-num))
    (atom-type (if large int-d int-n))
    (relative (library-library-comparison lib candidate old-gap types))
    (expansion (b2-scaling-doubled lib doubled-atom atom-type))
    (relative (proof-proof-rewrite proof relative expansion '(1 2 2 2 1 2 1)))
    (relative-first (proof-step-first relative))
    (relative-rhs (proof-term-at relative-first 2))
    (difference (proof-term-at relative-rhs 2))
    (margin (b2-tactics-tactics-linear-equal lib difference doubled-atom types))
    (relative (proof-proof-rewrite proof relative margin '(1 2 2)))
    (relative (proof-proof-tidy proof relative))
    (pos-atom (b2-scaling-power-decrease-positive-atom lib large x x-rat px x-div pos-d original types))
    (more (proof-proof-transport proof pos-atom relative))
    (new-type (library-library-type-of lib new-gap types))
    (candidate-type (library-library-type-of lib candidate types))
    (old-type (library-library-type-of lib old-gap types))
    (less (library-library-cite lib "WEAK-THEN-LESS" (list new-gap candidate old-gap)
                                (list new-type candidate-type old-type weak more)))
    (active (b2-scaling-power-decrease-ordination less new-gap active-eq lib old-gap old-equation types))
    (inactive (b2-scaling-power-decrease-ordination positive-old *proof-zero* inactive-eq
                                                   lib old-gap old-equation types))
    (step (if large (proof-proof-cases proof split inactive active)
            (proof-proof-cases proof split active inactive))))
   (cons step lib)))
