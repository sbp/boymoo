(in-package "BOYMOO-PROVER")
(set-verify-guards-eagerness 0)

(defconst *b2-next-recipes-keyword-theorems*
  '(("sym" "ACL2" "<=-OF-LEN-OF-ASSOC-KEYWORD-FORWARD-LINEAR")
    ("sym" "ACL2" "ASSOC-KEYWORD-OF-CONS-DIFF")
    ("sym" "ACL2" "ASSOC-KEYWORD-OF-CONS-SAME")
    ("sym" "ACL2" "CDR-OF-ASSOC-KEYWORD-IFF")
    ("sym" "ACL2" "CONSP-OF-CDR-OF-ASSOC-KEYWORD")
    ("sym" "ACL2" "KEYWORDP-OF-CAR-OF-ASSOC-KEYWORD")
    ("sym" "ACL2" "KEYWORDP-WHEN-ASSOC-KEYWORD")
    ("sym" "ACL2" "SYMBOLP-WHEN-ASSOC-KEYWORD")))

(defun b2-next-recipes-with-library (step lib)
  (if (failure-p step) step (cons step lib)))

(defun b2-next-recipes-fact-name (facts formula)
  (cond ((endp facts) :none)
        ((equal (cdar facts) (list formula)) (caar facts))
        (t (b2-next-recipes-fact-name (cdr facts) formula))))

(defun b2-next-recipes-zero-factor (formula)
  (if (proof-is-call formula *proof-equal*)
      (proof-with-checked-results ((right (proof-term-at formula 2)))
        (if (equal right *proof-zero*)
            (proof-with-checked-results ((left (proof-term-at formula 1)))
              (if (proof-is-call left *proof-times*)
                  (proof-with-checked-results ((first (proof-term-at left 1)))
                    (if (equal first *proof-zero*)
                        (proof-term-at left 2)
                      :none))
                :none))
          :none))
    :none))

(defun b2-next-recipes-prove-new-theorem-establish
    (nonempty lib condition goal)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((call (proof-term-at condition 1))
         (value (proof-term-at call 1))
         (step (b2-measures-set-tail-decrease lib value nonempty))
         (literal (proof-step-first step)))
      (if (equal goal literal)
          step
        (proof-with-checked-results
            ((order (proof-list-of-length (cdr literal) 2))
             (comparison (library-library-ordinal-comparison
                          lib (car order) (cadr order)))
             (changed (proof-proof-rewrite proof step comparison '(1))))
          (proof-proof-tidy proof changed))))))

(defun b2-next-recipes-prove-new-theorem-tail (lib formula)
  (proof-with-checked-results
      ((parts (proof-list-of-length formula 3))
       (condition (cadr parts))
       (goal (caddr parts))
       (nonempty (proof-proof-assume (library-library-proof lib) condition t))
       (step (b2-next-recipes-prove-new-theorem-establish nonempty lib condition goal)))
    (b2-tactics-tactics-implication lib condition goal (cons step lib))))

(defun b2-next-recipes-modulus-resume (result solver)
  (if (b2-floor-intervals-floor-type-request-p result)
      (let ((lib (b2-floor-intervals-floor-type-library result))
            (dividend (b2-floor-intervals-floor-type-i result))
            (divisor (b2-floor-intervals-floor-type-j result)))
        (proof-with-checked-results
            ((typed (b2-numeric-types-types-floor
                     (b2-numeric-types-types-with-library solver lib)
                     dividend divisor))
             (next (b2-floor-intervals-modulus-theorem-resume
                    result (cons (car typed) (b2-numeric-types-types-lib (cdr typed))))))
          (cons next (cdr typed))))
    (cons result solver)))

(defun b2-next-recipes-modulus (lib formula)
  (proof-with-checked-results
      ((solver (b2-numeric-types-types-init lib))
       (request (b2-floor-intervals-modulus-theorem lib formula nil))
       (first (b2-next-recipes-modulus-resume request solver))
       (second (b2-next-recipes-modulus-resume (car first) (cdr first))))
    (car second)))

(defun b2-next-recipes-prove-new-theorem-search (lib formula)
  (let ((equivalence (b2-equivalences-prove-equivalence lib formula)))
    (if (b2-tactics-unproved-p equivalence)
        (let ((searched (b2-search-search-theorem lib formula)))
          (b2-next-recipes-with-library
           (if (b2-tactics-unproved-p searched)
               (b2-structural-list-induction lib formula)
             searched)
           lib))
      (b2-next-recipes-with-library equivalence lib))))

(defun b2-next-recipes-prove-new-theorem-type (lib formula)
  (let* ((typed (b2-numeric-types-type-theorem lib formula))
         (failure (failure-p typed))
         (value (if failure typed (car typed))))
    (cond ((not (failure-p value)) typed)
          ((member-equal (cadr value) '("value" "inapplicable" "Unproved"))
           (b2-next-recipes-prove-new-theorem-search (if failure lib (cdr typed)) formula))
          (t value))))

(defun b2-next-recipes-prove-new-theorem-fallback (lib formula)
  (proof-with-checked-results
      ((plan (b2-list-properties-preservation-plan lib formula)))
    (if plan
        (let* ((search (b2-search-search-init lib 32 nil))
               (step (if (failure-p search)
                         search
                       (b2-list-properties-preserve-list
                        lib formula (car plan) nil (cadr plan) search))))
          (if (b2-tactics-unproved-p step)
              (b2-next-recipes-prove-new-theorem-type lib formula)
            (b2-next-recipes-with-library step lib)))
      (b2-next-recipes-prove-new-theorem-type lib formula))))

(defun b2-next-recipes-prove-new-theorem-named (lib name formula)
  (cond
   ((member-equal name *b2-next-recipes-keyword-theorems*)
    (b2-keywords-assoc-keyword lib name formula))
   ((assoc-equal name *b2-bags-formulas*)
    (b2-bags-prove-bag lib name formula))
   ((member-equal name *b2-meta-cancel-meta-cancellation*)
    (b2-meta-cancel-prove-meta-cancel lib name formula))
   ((member-equal name *b2-mv-evaluation-mv-evaluation*)
    (b2-mv-evaluation-mv-evaluation-theorem lib name formula))
   ((or (member-equal name *b2-term-trees-tree-openers*)
        (member-equal name *b2-term-trees-tree-types*))
    (b2-next-recipes-with-library (b2-term-trees-prove-tree lib name formula) lib))
   ((member-equal name *b2-xdoc-xdoc-theorems*)
    (b2-xdoc-xdoc-theorem lib name formula))
   ((member-equal name *b2-pair-products-pair-theorems*)
    (b2-next-recipes-with-library (b2-pair-products-pair-theorem lib name formula) lib))
   ((member-equal name *b2-character-lists-pack-theorems*)
    (b2-character-lists-pack-characters lib name formula))
   ((member-equal name *b2-completions-completion-theorems*)
    (b2-completions-completion-theorem lib name formula))
   ((member-equal name *b2-delimiters-delimiter-types*)
    (b2-delimiters-delimiter-theorem lib name formula))
   ((equal name '("sym" "ACL2" "TRUE-LISTP-DEL"))
    (b2-next-recipes-with-library
     (b2-list-properties-preserve-list
      lib formula 1 nil *b2-list-properties-recognizers* nil)
     lib))
   ((equal name '("sym" "ACL2" "TRUE-LISTP-BAGDIFF"))
    (b2-next-recipes-with-library
     (b2-list-properties-preserve-list
      lib formula 1 '(("sym" "ACL2" "TRUE-LISTP-DEL"))
      *b2-list-properties-recognizers* nil)
     lib))
   ((member-equal name *b2-pseudo-terms-pseudo-theorems*)
    (b2-pseudo-terms-preserve-pseudo lib name formula))
   ((equal name '("sym" "U" "TRUE-LISTP-CDR-GET-OPTION-ENTRY"))
    (b2-next-recipes-with-library (b2-pseudo-terms-typed-options lib formula) lib))
   ((member-equal name *b2-strict-order-order-theorems*)
    (b2-next-recipes-with-library (b2-strict-order-strict-order lib name formula) lib))
   ((equal name '("sym" "ACL2" "FAST-LEXORDER-IS-LEXORDER"))
    (b2-next-recipes-with-library (b2-lexicographic-lexorder-equivalence lib formula) lib))
   ((equal name '("sym" "ACL2" "FAST-<<-IS-<<"))
    (b2-next-recipes-with-library
     (b2-strict-lexicographic-strict-lexorder-equivalence lib formula) lib))
   ((member-equal name *b2-record-update-record-laws*)
    (b2-record-update-record-law lib name formula))
   ((member-equal name *b2-record-extensionality-extensional*)
    (b2-record-extensionality-record-extensionality lib name formula))
   ((member-equal name *b2-records-record-corollaries*)
    (b2-next-recipes-with-library (b2-records-record-corollary lib name formula) lib))
   ((member-equal name *b2-algebra-arithmetic-theorems*)
    (b2-algebra-arithmetic-identity lib name formula))
   ((member-equal name *b2-reciprocal-reciprocal-theorems*)
    (b2-reciprocal-reciprocal-theorem lib name formula))
   ((member-equal name *b2-exponent-types-exponent-types*)
    (b2-exponent-types-exponent-type lib name formula))
   ((member-equal name *b2-floor-intervals-floor-theorems*)
    (b2-floor-intervals-floor-theorem lib name formula))
   ((equal name *b2-truncate-intervals-truncate-bounds*)
    (b2-truncate-intervals-truncation-bounds lib formula))
   ((member-equal name *b2-quotient-algebra-quotient-identities*)
    (b2-quotient-algebra-quotient-identity lib name formula))
   ((member-equal name *b2-floor-translation-translations*)
    (b2-floor-translation-floor-translation-theorem lib name formula))
   ((member-equal name *b2-floor-ranges-floor-ranges*)
    (b2-floor-ranges-floor-range-theorem lib name formula))
   ((equal name *b2-rounding-relations-floor-as-truncate*)
    (b2-rounding-relations-floor-as-truncate lib formula))
   ((member-equal name *b2-remainder-properties-remainder-properties*)
    (b2-remainder-properties-remainder-theorem lib name formula))
   ((equal name *b2-floor-intervals-mod-bound*)
    (b2-next-recipes-modulus lib formula))
   ((member-equal name '(("sym" "ACL2" "NIQ-BOUNDS") ("sym" "ACL2" "NIQ-TYPE")))
    (b2-quotient-interval-niq-theorem lib name formula))
   ((member-equal name '(("sym" "SET" "TAIL-COUNT") ("sym" "SET" "TAIL-COUNT-BUILT-IN")))
    (b2-next-recipes-prove-new-theorem-tail lib formula))
   (t (b2-next-recipes-prove-new-theorem-fallback lib formula))))

(defun b2-next-recipes-prove-new-theorem (lib name formula)
  (let* ((proof (library-library-proof lib))
         (fact (b2-next-recipes-fact-name (proof-proof-facts proof) formula)))
    (if (eq fact :none)
        (proof-with-checked-results ((factor (b2-next-recipes-zero-factor formula)))
          (if (eq factor :none)
              (b2-next-recipes-prove-new-theorem-named lib name formula)
            (b2-products-zero-left-product lib factor)))
      (b2-next-recipes-with-library (proof-proof-fact proof fact nil) lib))))
