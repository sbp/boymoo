(in-package "BOYMOO-PROVER")
(set-verify-guards-eagerness 0)

(defun b2-rational-order-reverse-negations (lib a b)
  (let ((proof (library-library-proof lib))
        (minus-a (library-minus a))
        (minus-b (library-minus b)))
    (proof-with-checked-results
        ((first (library-library-axiom lib "<-ON-OTHERS" (list minus-a minus-b)))
         (twice (b2-fraction-reduction-twice-negated lib b nil))
         (first (proof-proof-rewrite proof first twice '(1 2 1 2)))
         (commute (library-library-axiom lib "COMMUTATIVITY-OF-+"
                                         (list minus-a (list *b2-products-fix* b))))
         (first (proof-proof-rewrite proof first commute '(1 2 1)))
         (fixed (b2-algebra-fixed-operand lib (library-plus b minus-a) 1))
         (fixed (proof-proof-symmetric proof fixed))
         (first (proof-proof-rewrite proof first fixed '(1 2 1)))
         (other (library-library-axiom lib "<-ON-OTHERS" (list b a)))
         (other (proof-proof-symmetric proof other)))
      (proof-proof-chain proof first (list other)))))

(defun b2-rational-order-difference-orders (lib a b typed-a typed-b)
  (let ((proof (library-library-proof lib))
        (delta (library-diff a b))
        (minus-b (library-minus b)))
    (proof-with-checked-results
        ((neg-b (b2-scaling-rational-op lib "unary--" minus-b (list typed-b)))
         (typed (b2-scaling-rational-op lib "binary-+" delta (list typed-a neg-b)))
         (unfold (library-library-axiom lib "DISTRIBUTIVITY-OF-MINUS-OVER-+"
                                        (list a minus-b)))
         (number-b (b2-scaling-number-of-rational lib b typed-b))
         (twice (b2-fraction-reduction-twice-negated lib b number-b))
         (computed (proof-proof-rewrite proof unfold twice '(1 2 2)))
         (commute (library-library-axiom lib "COMMUTATIVITY-OF-+"
                                         (list (library-minus a) b)))
         (computed (proof-proof-chain proof computed (list commute)))
         (positive-delta (library-library-axiom lib "<-ON-OTHERS" (list *proof-zero* delta)))
         (numeric (b2-products-numeric-closure lib (library-minus delta)))
         (unit (b2-fraction-reduction-sum-unit lib (library-minus delta) numeric))
         (positive-delta (proof-proof-rewrite proof positive-delta unit '(1 2 1)))
         (positive-delta (proof-proof-rewrite proof positive-delta computed '(1 2 1)))
         (other (library-library-axiom lib "<-ON-OTHERS" (list b a)))
         (positive-delta (proof-proof-symmetric proof positive-delta))
         (reverse (proof-proof-chain proof other (list positive-delta)))
         (opened (library-library-axiom lib "<-ON-OTHERS" (list a b))))
      (list delta typed opened reverse))))

(defun b2-rational-order-weak-from-strict (lib comparison typed-a typed-b)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((literal (proof-step-first comparison))
         (parts (proof-list-of-length literal 3))
         (orders (b2-rational-order-difference-orders lib (cadr parts) (caddr parts)
                                                     typed-a typed-b)))
      (let ((delta (car orders))
            (typed (cadr orders))
            (opened (caddr orders))
            (reverse (cadddr orders)))
        (proof-with-checked-results
            ((sign (proof-proof-rewrite proof comparison opened '(1)))
             (sign (proof-proof-tidy proof sign))
             (opposite (b2-scaling-opposite-sign lib delta typed))
             (opposite (proof-proof-symmetric proof opposite))
             (positive-minus (proof-proof-rewrite proof sign opposite '(1)))
             (positive-minus (proof-proof-tidy proof positive-minus))
             (trichotomy (library-library-axiom lib "TRICHOTOMY" (list delta)))
             (trichotomy (proof-proof-conjunct proof trichotomy))
             (not-positive (b2-tactics-tactics-from-impossible
                            lib (proof-neg (library-positive delta)) (cadr trichotomy)
                            (list positive-minus) nil nil 1500 nil))
             (reverse (proof-proof-symmetric proof reverse))
             (rewritten (proof-proof-rewrite proof not-positive reverse '(1 1))))
          (proof-proof-tidy proof rewritten))))))

(defun b2-rational-order-strict-from-weak-complete (lib equality position term typed)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((equation (proof-proof-unfold proof (list *b2-products-fix* term)))
         (first (proof-step-first equation))
         (body (proof-term-at first 2))
         (number (b2-scaling-number-of-rational lib term typed))
         (selected (proof-proof-select proof body number))
         (rule (proof-proof-chain proof equation (list selected)))
         (changed (proof-proof-rewrite proof equality rule (list 1 position))))
      (proof-proof-tidy proof changed))))

(defun b2-rational-order-strict-from-weak (lib weak unequal typed-a typed-b)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((literal (proof-step-first weak))
         (parts (proof-list-of-length literal 2))
         (parts (proof-list-of-length (cadr parts) 3)))
      (let* ((a (caddr parts))
             (b (cadr parts))
             (goal (library-lt a b)))
        (proof-with-checked-results
            ((orders (b2-rational-order-difference-orders lib a b typed-a typed-b))
             (delta (car orders))
             (typed (cadr orders))
             (opened (caddr orders))
             (reverse (cadddr orders))
             (negative (proof-proof-assume proof goal nil))
             (no-neg (proof-proof-rewrite proof negative opened '(1 1)))
             (no-neg (proof-proof-tidy proof no-neg))
             (no-pos (proof-proof-rewrite proof weak reverse '(1 1)))
             (no-pos (proof-proof-tidy proof no-pos))
             (opposite (b2-scaling-opposite-sign lib delta typed))
             (opposite (proof-proof-symmetric proof opposite))
             (no-mirror (proof-proof-rewrite proof no-neg opposite '(1 1)))
             (no-mirror (proof-proof-tidy proof no-mirror))
             (trichotomy (library-library-axiom lib "TRICHOTOMY" (list delta)))
             (trichotomy (proof-proof-conjunct proof trichotomy))
             (number (b2-scaling-number-of-rational lib delta typed))
             (alternatives (proof-proof-modus-ponens proof (car trichotomy) number))
             (zero (b2-tactics-tactics-from-impossible lib (proof-eq delta *proof-zero*)
                                                      alternatives (list no-pos no-mirror)
                                                      nil nil 1500 nil))
             (zero-first (proof-step-first zero))
             (completed (b2-algebra-cancel-inverse lib zero-first
                                                  (proof-eq (list *b2-products-fix* a)
                                                            (list *b2-products-fix* b))))
             (equal-step (proof-proof-rewrite proof zero completed '(1)))
             (equal-step (proof-proof-tidy proof equal-step))
             (equal-step (b2-rational-order-strict-from-weak-complete lib equal-step 1 a typed-a))
             (equal-step (b2-rational-order-strict-from-weak-complete lib equal-step 2 b typed-b))
             (unequal-first (proof-step-first unequal))
             (equal-step (if (equal unequal-first (proof-neg (proof-eq b a)))
                             (proof-proof-symmetric proof equal-step)
                           equal-step))
             (cut (proof-proof-cut proof equal-step unequal)))
          (proof-proof-front proof cut goal))))))

(defun b2-rational-order-rational-lexorder-atom (lib term typed)
  (let ((proof (library-library-proof lib))
        (test (list *proof-consp* term)))
    (proof-with-checked-results
        ((number (b2-scaling-number-of-rational lib term typed))
         (fact (proof-proof-fact proof "consp-not-acl2-numberp" (list (list *library-x* term))))
         (assumption (proof-proof-assume proof test t))
         (negative (proof-proof-modus-ponens proof fact assumption))
         (cut (proof-proof-cut proof number negative)))
      (proof-proof-front proof cut (proof-neg test)))))

(defun b2-rational-order-rational-lexorder (lib a b typed-a typed-b)
  (let ((proof (library-library-proof lib))
        (call (list (proof-sym "LEXORDER" "ACL2") a b)))
    (proof-with-checked-results
        ((atom-a (b2-rational-order-rational-lexorder-atom lib a typed-a))
         (atom-b (b2-rational-order-rational-lexorder-atom lib b typed-b))
         (ordinary (b2-tactics-tactics-normalize
                    lib call (list typed-a typed-b atom-a atom-b)
                    (list call (proof-sym "ALPHORDER" "ACL2")) nil 1500 nil))
         (weak (proof-proof-unfold proof (library-le a b)))
         (weak (proof-proof-symmetric proof weak)))
      (if ordinary
          (proof-proof-chain proof ordinary (list weak))
        '(:failure "failure" "")))))

(defun b2-rational-order-weak-order-chain (lib a b c typed-a typed-b typed-c first second)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((equation (b2-rational-order-rational-lexorder lib a b typed-a typed-b))
         (left (proof-proof-transport proof first equation))
         (equation (b2-rational-order-rational-lexorder lib b c typed-b typed-c))
         (right (proof-proof-transport proof second equation))
         (law (proof-proof-fact proof (proof-sym "LEXORDER-TRANSITIVE" "ACL2")
                                   (list (list *library-x* a) (list *library-y* b) (list *library-z* c))))
         (law-first (proof-step-first law))
         (condition (proof-term-at law-first 1))
         (premise (b2-tactics-tactics-solve lib condition (list left right) nil nil 0 nil))
         (chain (proof-proof-modus-ponens proof law premise))
         (equation (b2-rational-order-rational-lexorder lib a c typed-a typed-c))
         (step (proof-proof-rewrite proof chain equation '(1))))
      (proof-proof-tidy proof step))))

(defun b2-rational-order-rational-order-chain (lib first second types)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((left (proof-step-first first))
         (left (b2-bounds-comparison left))
         (left (or left '(:failure "tactic-rejected" "")))
         (right (proof-step-first second))
         (right (b2-bounds-comparison right))
         (right (or right '(:failure "tactic-rejected" "")))
         (types (proof-list-of-length types 3)))
      (let ((a (car left))
            (b (cadr left))
            (c (cadr right))
            (left-strict (caddr left))
            (right-strict (caddr right))
            (ra (car types))
            (rb (cadr types))
            (rc (caddr types)))
        (if (and (not left-strict) (not right-strict))
            (b2-rational-order-weak-order-chain lib a b c ra rb rc first second)
          (let ((target (library-lt a c)))
            (proof-with-checked-results ((reverse (proof-proof-assume proof target nil)))
              (if left-strict
                  (proof-with-checked-results
                      ((last (if right-strict
                                 (b2-rational-order-weak-from-strict lib second rb rc)
                               second))
                       (contradicts (b2-rational-order-weak-order-chain
                                     lib b c a rb rc ra last reverse))
                       (cut (proof-proof-cut proof first contradicts)))
                    (proof-proof-front proof cut target))
                (proof-with-checked-results
                    ((contradicts (b2-rational-order-weak-order-chain
                                   lib c a b rc ra rb reverse first))
                     (cut (proof-proof-cut proof second contradicts)))
                  (proof-proof-front proof cut target))))))))))

(defun b2-rational-order-sign-cases-branch (negative facts lib value typed distinct zero)
  (if (endp facts)
      '(:failure "tactic-rejected" "")
    (let ((sign (car (last facts))))
      (if negative
          (proof-with-checked-results
              ((weak (b2-rational-order-weak-from-strict lib sign typed zero)))
            (list :call t sign (append facts (list weak))))
        (proof-with-checked-results
            ((other (b2-strict-order-flipped-distinct lib value *proof-zero* distinct))
             (positive (b2-rational-order-strict-from-weak lib sign other zero typed)))
          (list :call nil positive (append facts (list positive))))))))

(defun b2-rational-order-sign-cases-replies
    (lib test value typed distinct zero prove replies)
  (declare (xargs :measure (acl2-count prove)))
  (proof-with-checked-results ((answer (b2-tactics-choose lib test nil replies)))
    (let ((request (car answer)))
      (if (and (consp request) (eq (car request) :call))
          (proof-with-checked-results
              ((arguments (b2-rational-order-sign-cases-branch
                           (cadddr request) (car (cddddr request)) (cdr answer)
                           value typed distinct zero)))
            (if (endp prove)
                (cons arguments (cdr answer))
              (b2-rational-order-sign-cases-replies
               lib test value typed distinct zero (cdr prove)
               (append replies (list (car prove))))))
        answer))))

(defun b2-rational-order-sign-cases (lib value typed distinct prove)
  (proof-with-checked-results ((zero (library-library-rational lib *proof-zero* nil)))
    (b2-rational-order-sign-cases-replies lib (library-lt value *proof-zero*)
                                        value typed distinct zero prove nil)))
