(in-package "BOYMOO-PROVER")
(set-verify-guards-eagerness 0)

(defconst *b2-powers-expt* (proof-cl "EXPT"))
(defconst *b2-powers-zip* (proof-sym "ZIP" "ACL2"))
(defconst *b2-powers-zp* (proof-sym "ZP" "ACL2"))
(defconst *b2-powers-i* (proof-sym "I" "ACL2"))
(defconst *b2-powers-j* (proof-sym "J" "ACL2"))

(defun b2-powers-expt (base exponent)
  (list *b2-powers-expt* base exponent))

(defun b2-powers-and-terms (terms)
  (cond ((endp terms) '(:failure "tactic-rejected" ""))
        ((endp (cdr terms)) (car terms))
        (t (proof-ite (car terms) (b2-powers-and-terms (cdr terms)) *proof-false*))))

(defun b2-powers-evidence-step (evidence term)
  (let ((entry (assoc-equal term evidence)))
    (if entry
        (cdr entry)
      '(:failure "tactic-rejected" ""))))

(defun b2-powers-linear-equal (lib left right types)
  (b2-tactics-tactics-linear-equal lib left right types))

(defun b2-powers-zero-from-signs (lib term typed not-negative not-positive)
  (let ((proof (library-library-proof lib))
        (minus-term (library-minus term))
        (types (list typed)))
    (proof-with-checked-results
        ((tri (library-library-axiom lib "TRICHOTOMY" (list term)))
         (conjuncts (proof-proof-conjunct proof tri))
         (number (library-library-number lib term types))
         (available (proof-proof-modus-ponens proof (car conjuncts) number))
         (reversed-order (library-library-comparison lib term *proof-zero* types))
         (minus-type (library-library-type-of lib minus-term types))
         (simplify (library-library-cite lib "ADD-ZERO-LEFT" (list minus-term) (list minus-type)))
         (reversed-order (proof-proof-rewrite proof reversed-order simplify '(1 2 2)))
         (reversed-order (proof-proof-tidy proof reversed-order))
         (opposite (proof-proof-rewrite proof not-negative reversed-order '(1 1)))
         (opposite (proof-proof-tidy proof opposite)))
      (b2-tactics-tactics-from-impossible lib (proof-eq term *proof-zero*) available
                                          (list not-positive not-negative opposite)
                                          nil nil 1500 nil))))

(defun b2-powers-integer-count (lib term typed sign)
  (let* ((proof (library-library-proof lib))
         (cons-term (list *proof-consp* term)))
    (proof-with-checked-results
        ((number (library-library-number lib term (list typed)))
         (consp-fact (proof-proof-fact proof "consp-not-acl2-numberp"
                                      (list (list *library-x* term))))
         (cons-assumption (proof-proof-assume proof cons-term t))
         (impossible (proof-proof-modus-ponens proof consp-fact cons-assumption))
         (atom (proof-proof-cut proof number impossible))
         (atom (proof-proof-front proof atom (proof-neg cons-term)))
         (rational (library-library-rational lib term (list typed))))
      (b2-tactics-tactics-normalize
       lib (list *library-count* term) (list typed rational atom sign)
       (list *library-count* (proof-sym "INTEGER-ABS" "ACL2")) nil 1500 nil))))

(defun b2-powers-negated-count-lemma (lib)
  (let* ((proof (library-library-proof lib))
         (x *library-x*)
         (minus-x (library-minus x))
         (negative (library-lt x *proof-zero*))
         (positive-x (library-positive x)))
    (proof-with-checked-results
        ((typed (proof-proof-assume proof (library-integer x) t))
         (typed-minus (library-library-type-of lib minus-x (list typed)))
         (types (list typed typed-minus))
         (low (proof-proof-assume proof negative t))
         (not-low (proof-proof-assume proof negative nil))
         (high (proof-proof-assume proof positive-x t))
         (not-high (proof-proof-assume proof positive-x nil))
         (swap (library-library-comparison lib x *proof-zero* types))
         (swap-first (proof-step-first swap))
         (swap-right (proof-term-at swap-first 2))
         (actual (proof-term-at swap-right 2))
         (reduced (b2-powers-linear-equal lib actual minus-x types))
         (swap (proof-proof-rewrite proof swap reduced '(1 2 2)))
         (swap (proof-proof-tidy proof swap))
         (positive-minus (proof-proof-rewrite proof low swap '(1)))
         (positive-minus (proof-proof-tidy proof positive-minus))
         (minus-nonnegative
          (library-library-cite lib "POSITIVE-NONNEGATIVE" (list minus-x)
                                (list typed-minus positive-minus)))
         (less (b2-powers-integer-count lib minus-x typed-minus minus-nonnegative))
         (low-count (b2-powers-integer-count lib x typed low))
         (low-count (proof-proof-symmetric proof low-count))
         (less (proof-proof-chain proof less (list low-count)))
         (swap (library-library-axiom lib "<-ON-OTHERS" (list *proof-zero* x)))
         (swap-first (proof-step-first swap))
         (swap-right (proof-term-at swap-first 2))
         (actual (proof-term-at swap-right 1))
         (reduced (b2-powers-linear-equal lib actual minus-x types))
         (swap (proof-proof-rewrite proof swap reduced '(1 2 1)))
         (swap (proof-proof-tidy proof swap))
         (negative-minus (proof-proof-rewrite proof high swap '(1)))
         (negative-minus (proof-proof-tidy proof negative-minus))
         (no-neg (library-library-cite lib "POSITIVE-NONNEGATIVE" (list x)
                                        (list typed high)))
         (greater (b2-powers-integer-count lib minus-x typed-minus negative-minus))
         (double (library-library-cite lib "DOUBLE-NEGATION" (list x) (list typed)))
         (high-count (b2-powers-integer-count lib x typed no-neg))
         (high-count (proof-proof-symmetric proof high-count))
         (greater (proof-proof-chain proof greater (list double high-count)))
         (zero (b2-powers-zero-from-signs lib x typed not-low not-high))
         (raw (proof-eq (list *library-count* minus-x) (list *library-count* x)))
         (equal-step (b2-tactics-tactics-solve lib raw (list zero) nil nil 0 nil))
         (conclusion (proof-proof-cases proof positive-x greater equal-step))
         (conclusion (proof-proof-cases proof negative less conclusion)))
      (b2-tactics-tactics-add-lemma lib "NEGATED-COUNT" conclusion
                                    (list raw (proof-neg (library-integer x)))))))

(defun b2-powers-negated-count (lib term typed)
  (let* ((name (proof-sym "B2-NEGATED-COUNT" "ACL2"))
         (proof (library-library-proof lib)))
    (proof-with-checked-results
        ((lib (if (assoc-equal name (proof-proof-facts proof))
                  lib
                (proof-with-checked-results ((added (b2-powers-negated-count-lemma lib)))
                  (cdr added))))
         (step (proof-proof-use (library-library-proof lib) name
                                (list (list *library-x* term)) (list typed))))
      (cons step lib))))

(defun b2-powers-below-zero-count (lib term typed negative)
  (let* ((proof (library-library-proof lib))
         (child (library-plus *proof-one* term))
         (types (list typed))
         (minus-term (library-minus term)))
    (proof-with-checked-results
        ((opposite (library-library-comparison lib term *proof-zero* types))
         (first (proof-step-first opposite))
         (right (proof-term-at first 2))
         (actual (proof-term-at right 2))
         (reduced (b2-powers-linear-equal lib actual minus-term types))
         (opposite (proof-proof-rewrite proof opposite reduced '(1 2 2)))
         (opposite (proof-proof-tidy proof opposite))
         (positive-minus (proof-proof-rewrite proof negative opposite '(1)))
         (positive-minus (proof-proof-tidy proof positive-minus))
         (smaller (library-library-builtin lib 14 minus-term))
         (minus-type (library-library-type-of lib minus-term types))
         (smaller (proof-proof-discharge proof smaller minus-type))
         (smaller (proof-proof-discharge proof smaller positive-minus))
         (child-equation (b2-powers-linear-equal lib (library-plus *proof-neg-one* minus-term)
                                                (library-minus child) types))
         (smaller (proof-proof-rewrite proof smaller child-equation '(1 1 1)))
         (smaller (proof-proof-tidy proof smaller))
         (child-type (library-library-type-of lib child types))
         (negated-child (b2-powers-negated-count lib child child-type))
         (lib (cdr negated-child))
         (proof (library-library-proof lib))
         (smaller (proof-proof-rewrite proof smaller (car negated-child) '(1 1)))
         (smaller (proof-proof-tidy proof smaller))
         (negated-term (b2-powers-negated-count lib term typed))
         (lib (cdr negated-term))
         (proof (library-library-proof lib))
         (smaller (proof-proof-rewrite proof smaller (car negated-term) '(1 2)))
         (smaller (proof-proof-tidy proof smaller)))
      (cons smaller lib))))

(defun b2-powers-exp-number-leaf (term tests lib)
  (declare (ignore tests))
  (if (proof-is-call term *proof-times*)
      (b2-products-numeric-closure lib term)
    (b2-tactics-tactics-solve lib (list *library-numberp* term) nil nil nil 0 nil)))

(defun b2-powers-exp-number-leaves (requests lib)
  (if (endp requests)
      nil
    (let* ((request (car requests))
           (step (b2-powers-exp-number-leaf (car request) (cadr request) lib))
           (entry (cons request step)))
      (if (failure-p step)
          (list entry)
        (cons entry (b2-powers-exp-number-leaves (cdr requests) lib))))))

(defun b2-powers-exp-number-lemma (lib)
  (let ((proof (library-library-proof lib))
        (call (b2-powers-expt *library-x* *b2-powers-i*))
        (template (list *library-numberp* *proof-result*)))
    (proof-with-checked-results
        ((equation (proof-proof-unfold proof call))
         (first (proof-step-first equation))
         (value (proof-term-at first 2))
         (requests (proof-proof-by-value-leaves proof value nil))
         (step (proof-proof-by-value proof value template
                                     (b2-powers-exp-number-leaves requests lib) nil))
         (reverse (proof-proof-symmetric proof equation))
         (step (proof-proof-rewrite-result proof step reverse template *proof-result*)))
      (b2-tactics-tactics-add-lemma lib "EXPT-NUMBER" step :none))))

