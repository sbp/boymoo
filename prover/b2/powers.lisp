(defun b2-powers-predecessor (lib base exponent typed number nonzero)
  (let ((reciprocal (list *b2-products-recip* base)))
    (proof-with-checked-results
        ((equation (b2-powers-successor lib base exponent typed number nonzero))
         (lib (cdr equation))
         (equation (car equation))
         (proof (library-library-proof lib))
         (unit (b2-products-reciprocal-identity lib base number nonzero))
         (swap (library-library-axiom lib "COMMUTATIVITY-OF-*" (list reciprocal base)))
         (unit (proof-proof-chain proof swap (list unit)))
         (power-number (b2-powers-exp-number lib base exponent))
         (lib (cdr power-number))
         (proof (library-library-proof lib))
         (cancel (b2-products-distribute-cancel lib reciprocal base (b2-powers-expt base exponent)
                                                unit (car power-number)))
         (reverse (proof-proof-symmetric proof equation))
         (equation (proof-proof-rewrite proof cancel reverse '(1 1 2)))
         (equation (proof-proof-tidy proof equation))
         (equation (proof-proof-symmetric proof equation)))
      (cons equation lib))))

(defun b2-powers-expt-add-lemma-consequent-equation-for
    (hypothesis shift ordinal-down lib x i j total types it jt xn nz)
  (let* ((proof (library-library-proof lib))
         (shifted-total (library-plus shift j)))
    (proof-with-checked-results
        ((new-type (library-library-type-of lib shift types))
         (first (proof-step-first hypothesis))
         (premise (proof-term-at first 1))
         (given (b2-tactics-tactics-solve lib premise (list new-type jt xn nz) nil nil 0 nil))
         (inductive (proof-proof-modus-ponens proof hypothesis given))
         (left-type (library-library-type-of lib (if ordinal-down shifted-total total) types))
         (left (if ordinal-down
                   (b2-powers-successor lib x shifted-total left-type xn nz)
                 (b2-powers-predecessor lib x total left-type xn nz)))
         (lib (cdr left))
         (left (car left))
         (proof (library-library-proof lib))
         (first (proof-step-first left))
         (actual (if ordinal-down
                     (proof-with-checked-results ((call (proof-term-at first 1)))
                       (proof-term-at call 2))
                   (proof-with-checked-results
                       ((product (proof-term-at first 2))
                        (call (proof-term-at product 2)))
                     (proof-term-at call 2))))
         (linear (b2-powers-linear-equal lib actual (if ordinal-down total shifted-total) types))
         (left (proof-proof-rewrite proof left linear
                                    (if ordinal-down '(1 1 2) '(1 2 2 2))))
         (parent (if ordinal-down
                     (b2-powers-successor lib x shift new-type xn nz)
                   (b2-powers-predecessor lib x i it xn nz)))
         (lib (cdr parent))
         (parent (car parent))
         (proof (library-library-proof lib))
         (parent (if ordinal-down
                     (proof-with-checked-results
                         ((first (proof-step-first parent))
                          (call (proof-term-at first 1))
                          (actual (proof-term-at call 2))
                          (linear (b2-powers-linear-equal lib actual i types)))
                       (proof-proof-rewrite proof parent linear '(1 1 2)))
                   parent))
         (left (proof-proof-rewrite proof left inductive '(1 2 2)))
         (first (proof-step-first left))
         (right (proof-term-at first 2))
         (outer (proof-list-of-length (cdr right) 2))
         (inner (proof-list-of-length (cadr outer) 3))
         (assoc (library-library-axiom lib "ASSOCIATIVITY-OF-*"
                                       (list (car outer) (cadr inner) (caddr inner))))
         (assoc (proof-proof-symmetric proof assoc))
         (left (proof-proof-chain proof left (list assoc)))
         (parent (proof-proof-symmetric proof parent))
         (left (proof-proof-rewrite proof left parent '(1 2 1)))
         (left (proof-proof-tidy proof left)))
      (cons left lib))))

(defun b2-powers-expt-add-lemma-consequent
    (assumption lib x i j int-i int-j number nonzero total target formula measure
                down up decreased increased)
  (let* ((proof (library-library-proof lib))
         (pos (library-positive i))
         (neg-i (library-lt i *proof-zero*)))
    (proof-with-checked-results
        ((evidence (b2-tactics-tactics-evidence lib (list assumption)))
         (it (b2-powers-evidence-step evidence int-i))
         (jt (b2-powers-evidence-step evidence int-j))
         (xn (b2-powers-evidence-step evidence number))
         (nz (b2-powers-evidence-step evidence nonzero))
         (types (list it jt))
         (positive-i (proof-proof-assume proof pos t))
         (not-positive-i (proof-proof-assume proof pos nil))
         (negative-i (proof-proof-assume proof neg-i t))
         (not-negative-i (proof-proof-assume proof neg-i nil))
         (non-zp (b2-tactics-tactics-solve lib (proof-neg (list *b2-powers-zp* i))
                                           (list it positive-i) (list *b2-powers-zp*) nil 0 nil))
         (smaller (library-library-builtin lib 8 i))
         (smaller (proof-proof-discharge proof smaller non-zp))
         (child1 (b2-tactics-tactics-induction-hypothesis lib formula measure decreased smaller))
         (below (b2-powers-below-zero-count lib i it negative-i))
         (lib (cdr below))
         (child2 (b2-tactics-tactics-induction-hypothesis lib formula measure increased (car below)))
         (forward (b2-powers-expt-add-lemma-consequent-equation-for
                   child1 down t lib x i j total types it jt xn nz))
         (lib (cdr forward))
         (backward (b2-powers-expt-add-lemma-consequent-equation-for
                    child2 up nil lib x i j total types it jt xn nz))
         (lib (cdr backward))
         (zero (b2-powers-zero-from-signs lib i it not-negative-i not-positive-i))
         (exp-number (b2-powers-exp-number lib x j))
         (lib (cdr exp-number))
         (proof (library-library-proof lib))
         (unit (b2-products-multiplicative-unit lib (b2-powers-expt x j) (car exp-number)))
         (add-zero (library-library-cite lib "ADD-ZERO-LEFT" (list j) (list jt)))
         (start (b2-tactics-tactics-solve lib target (list zero)
                                          (list (b2-powers-expt x *proof-zero*) *b2-powers-zip*)
                                          (list unit add-zero) 0 nil))
         (step (proof-proof-cases proof neg-i (car backward) start))
         (step (proof-proof-cases proof pos (car forward) step)))
      (cons step lib))))

(defun b2-powers-expt-add-lemma (lib)
  (let* ((proof (library-library-proof lib))
         (label (proof-sym "B2-EXPT-ADD" "ACL2")))
    (if (assoc-equal label (proof-proof-facts proof))
        (cons label lib)
      (let* ((x *library-x*)
             (i *b2-powers-i*)
             (j *b2-powers-j*)
             (int-i (library-integer i))
             (int-j (library-integer j))
             (number (list *library-numberp* x))
             (nonzero (proof-neg (proof-eq x *proof-zero*)))
             (premise (b2-powers-and-terms (list int-i int-j number nonzero)))
             (total (library-plus i j))
             (target (proof-eq (b2-powers-expt x total)
                               (b2-products-product (b2-powers-expt x i)
                                                    (b2-powers-expt x j))))
             (formula (list *library-implies* premise target))
             (measure (list *library-count* i))
             (down (library-plus i *proof-neg-one*))
             (up (library-plus *proof-one* i))
             (decreased (list (list i down)))
             (increased (list (list i up))))
        (proof-with-checked-results
            ((pending (b2-tactics-tactics-implication lib premise target nil))
             (request (car pending))
             (reply (b2-powers-expt-add-lemma-consequent
                     (cadddr request) (caddr request)
                     x i j int-i int-j number nonzero total target formula measure
                     down up decreased increased))
             (cases (b2-tactics-tactics-implication lib premise target reply))
             (lib (cdr cases))
             (ordinal (library-library-builtin lib 1 i))
             (step (proof-proof-induct (library-library-proof lib) ordinal (car cases)
                                       formula measure (list decreased increased))))
          (b2-tactics-tactics-add-lemma lib "EXPT-ADD" step :none))))))

(defun b2-powers-expt-add-terms (goal aggressive)
  (proof-with-checked-results ((parts (proof-list-of-length goal 3)))
    (if aggressive
        (proof-with-checked-results
            ((call (proof-list-of-length (cadr parts) 3))
             (total (caddr call))
             (terms (proof-list-of-length total 3)))
          (list (cadr call) (cadr terms) (caddr terms) total))
      (proof-with-checked-results
          ((product (proof-list-of-length (cadr parts) 3))
           (left (proof-list-of-length (cadr product) 3))
           (right (proof-list-of-length (caddr product) 3)))
        (let ((i (caddr left))
              (j (caddr right)))
          (list (cadr left) i j (library-plus i j)))))))

(defun b2-powers-expt-add-consequent (assumption lib i j total zero x unfixed lemma aggressive goal)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((facts (b2-tactics-tactics-evidence lib (list assumption)))
         (it (b2-powers-evidence-step facts (library-integer i)))
         (jt (b2-powers-evidence-step facts (library-integer j)))
         (typed (list it jt))
         (total-type (library-library-type-of lib total typed))
         (has-zero (proof-proof-assume proof zero t))
         (has-number (proof-proof-assume proof zero nil))
         (fix (list *b2-products-fix*))
         (nx (b2-tactics-tactics-from-impossible lib (list *library-numberp* x)
                                                has-number nil fix nil 1500 nil))
         (fixed (b2-tactics-tactics-normalize lib unfixed (list nx) fix nil 1500 nil))
         (nz (proof-proof-rewrite proof has-number fixed '(1 1 1)))
         (nz (proof-proof-tidy proof nz))
         (identities (proof-proof-fact proof lemma (list (list *library-x* x)
                                                         (list *b2-powers-i* i)
                                                         (list *b2-powers-j* j))))
         (first (proof-step-first identities))
         (premise (proof-term-at first 1))
         (given (b2-tactics-tactics-solve lib premise (append typed (list nx nz)) nil nil 0 nil))
         (exact (proof-proof-modus-ponens proof identities given))
         (open-total (list (b2-powers-expt x total) *b2-powers-zip*)))
      (if aggressive
          (let ((equality (proof-eq total *proof-zero*)))
            (proof-with-checked-results
                ((yes (proof-proof-assume proof equality t))
                 (no (proof-proof-assume proof equality nil))
                 (same (b2-tactics-tactics-solve lib goal (append typed (list yes))
                                                 open-total nil 0 nil))
                 (other (b2-tactics-tactics-solve lib goal (append typed (list no has-number))
                                                  nil (list exact) 0 nil))
                 (nonzero (proof-proof-cases proof equality same other))
                 (zero-base (b2-tactics-tactics-solve lib goal (append typed (list total-type has-zero))
                                                      open-total nil 1 nil)))
              (proof-proof-cases proof zero zero-base nonzero)))
        (proof-with-checked-results
            ((result (proof-term-at goal 2))
             (test (proof-term-at result 1))
             (both-zero (proof-proof-assume proof test t))
             (some-nonzero (proof-proof-assume proof test nil))
             (use (proof-proof-symmetric proof exact))
             (base-case (b2-tactics-tactics-solve lib goal (append typed (list has-number both-zero))
                                                  open-total (list use) 0 nil))
             (rest (b2-tactics-tactics-solve lib goal (append typed (list has-number some-nonzero))
                                              nil (list use) 0 nil))
             (nonzero (proof-proof-cases proof test base-case rest))
             (zero-base (b2-tactics-tactics-solve lib goal (append typed (list has-zero))
                                                  (list (b2-powers-expt x i) (b2-powers-expt x j)
                                                        *b2-powers-zip*)
                                                  nil 2 nil)))
          (proof-proof-cases proof zero zero-base nonzero))))))

(defun b2-powers-expt-add (lib name formula)
  (let ((aggressive (equal name (proof-sym "EXPTS-ADD-AGGRESSIVE" "ACL2"))))
    (proof-with-checked-results
        ((parts (proof-list-of-length formula 3))
         (premise (cadr parts))
         (goal (caddr parts))
         (terms (b2-powers-expt-add-terms goal aggressive))
         (added (b2-powers-expt-add-lemma lib))
         (lib (cdr added))
         (lemma (car added))
         (x (car terms))
         (i (cadr terms))
         (j (caddr terms))
         (total (cadddr terms))
         (unfixed (list *b2-products-fix* x))
         (zero (proof-eq unfixed *proof-zero*))
         (pending (b2-tactics-tactics-implication lib premise goal nil))
         (request (car pending))
         (step (b2-powers-expt-add-consequent (cadddr request) (caddr request)
                                              i j total zero x unfixed lemma aggressive goal)))
      (b2-tactics-tactics-implication lib premise goal (cons step lib)))))
