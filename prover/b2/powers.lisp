(defun b2-powers-open-nonzero-expt (lib base exponent typed sign number nonzero)
  (let ((call (b2-powers-expt base exponent)))
    (proof-with-checked-results
        ((not-zero (b2-tactics-tactics-from-impossible
                    lib (proof-neg (proof-eq exponent *proof-zero*)) sign
                    nil nil nil 1500 nil))
         (signed (proof-step-first sign))
         (extra (if (equal signed (library-lt exponent *proof-zero*))
                    (proof-with-checked-results
                        ((negative (b2-powers-open-nonzero-expt-negative lib exponent typed sign)))
                      (list negative))
                  nil)))
      (b2-tactics-tactics-normalize
       lib call (append (list typed sign number nonzero not-zero) extra)
       (list call *b2-powers-zip* *b2-products-fix*) nil 1500 nil))))

(defun b2-powers-successor-lemma (lib)
  (let* ((proof (library-library-proof lib))
         (x *library-x*)
         (i *b2-powers-i*)
         (test (library-lt i *proof-zero*))
         (next-i (library-plus *proof-one* i)))
    (proof-with-checked-results
        ((numeric (proof-proof-assume proof (list *library-numberp* x) t))
         (nonzero (proof-proof-assume proof (proof-eq x *proof-zero*) nil))
         (int-i (proof-proof-assume proof (library-integer i) t))
         (negative (proof-proof-assume proof test t))
         (nonnegative (proof-proof-assume proof test nil))
         (types (list int-i))
         (pos-i1 (library-library-cite lib "POSITIVE-ONE-PLUS" (list i)
                                       (list int-i nonnegative)))
         (next-type (library-library-type-of lib next-i types))
         (forward (b2-powers-open-nonzero-expt lib x next-i next-type pos-i1 numeric nonzero))
         (first (proof-step-first forward))
         (right (proof-term-at first 2))
         (child (proof-term-at right 2))
         (actual (proof-term-at child 2))
         (cancellation (b2-powers-linear-equal lib actual i types))
         (forward (proof-proof-rewrite proof forward cancellation '(1 2 2 2)))
         (forward (proof-proof-tidy proof forward))
         (backward (b2-powers-open-nonzero-expt lib x i int-i negative numeric nonzero))
         (first (proof-step-first backward))
         (right (proof-term-at first 2))
         (child (proof-term-at right 2))
         (actual (proof-term-at child 2))
         (reduced (b2-powers-linear-equal lib actual next-i types))
         (backward (proof-proof-rewrite proof backward reduced '(1 2 2 2)))
         (backward (proof-proof-tidy proof backward))
         (unit (b2-products-reciprocal-identity lib x numeric nonzero))
         (power-number (b2-powers-exp-number lib x next-i))
         (lib (cdr power-number))
         (proof (library-library-proof lib))
         (inverted (b2-products-distribute-cancel
                    lib x (list *b2-products-recip* x) (b2-powers-expt x next-i)
                    unit (car power-number)))
         (backward (proof-proof-symmetric proof backward))
         (inverted (proof-proof-rewrite proof inverted backward '(1 1 2)))
         (inverted (proof-proof-tidy proof inverted))
         (inverted (proof-proof-symmetric proof inverted))
         (step (proof-proof-cases proof test inverted forward))
         (first (proof-step-first step)))
      (b2-tactics-tactics-add-lemma lib "EXPT-SUCCESSOR" step
                                    (list first (proof-neg (library-integer i))
                                          (proof-neg (list *library-numberp* x))
                                          (proof-eq x *proof-zero*))))))

