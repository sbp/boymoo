(in-package "BOYMOO-PROVER")
(set-verify-guards-eagerness 0)

(defconst *b2-keywords-assoc* (proof-sym "ASSOC-KEYWORD" "ACL2"))
(defconst *b2-keywords-keywords* (proof-sym "KEYWORD-VALUE-LISTP" "ACL2"))
(defconst *b2-keywords-key* (proof-sym "KEY" "ACL2"))
(defconst *b2-keywords-keywordp* (proof-cl "KEYWORDP"))

(defun b2-keywords-evidence-step (facts term)
  (let ((entry (assoc-equal term facts)))
    (if entry (cdr entry)
      '(:failure "tactic-rejected" ""))))

(defun b2-keywords-lookup-property-base (atom-step lib source goal lookup)
  (proof-with-checked-results
      ((request (b2-tactics-tactics-implication lib source goal nil))
       (outcome (b2-tactics-tactics-solve (cdr request) goal (list atom-step)
                                          (list lookup) nil 0 nil))
       (proved (b2-tactics-tactics-implication lib source goal (cons outcome (cdr request)))))
    (car proved)))

(defun b2-keywords-lookup-property-consequent
    (typed lib cons-step hypothesis source lookup property-of-result key records tail rest)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((equation (b2-tactics-tactics-normalize lib source (list cons-step)
                                                 (list source) nil 1500 nil))
         (condition (proof-proof-rewrite proof typed equation '(1)))
         (condition (proof-proof-tidy proof condition))
         (facts (b2-tactics-tactics-evidence lib (list condition)))
         (head (list *library-car* records))
         (keyword (b2-keywords-evidence-step facts (list *b2-keywords-keywordp* head)))
         (cons-tail (b2-keywords-evidence-step facts (list *proof-consp* tail)))
         (typed-tail (b2-keywords-evidence-step facts (list *b2-keywords-keywords* rest)))
         (compares (proof-eq key head))
         (same (proof-proof-assume proof compares t))
         (different (proof-proof-assume proof compares nil))
         (inverted (proof-proof-symmetric proof same))
         (typed-key (proof-proof-rewrite proof keyword inverted '(1 1)))
         (typed-key (proof-proof-tidy proof typed-key))
         (nonempty (b2-tactics-tactics-from-impossible lib records cons-step
                                                       nil nil nil 1500 nil))
         (yes-eq (b2-tactics-tactics-normalize lib lookup (list cons-step same)
                                               (list lookup) nil 1500 nil))
         (yes-goal (proof-subst property-of-result (list (cons *proof-result* records))))
         (yes (b2-tactics-tactics-solve lib yes-goal
                                        (list nonempty cons-step cons-tail inverted typed-key)
                                        nil nil 0 nil))
         (yes-back (proof-proof-symmetric proof yes-eq))
         (yes (proof-proof-rewrite-result proof yes yes-back property-of-result *proof-result*))
         (no-eq (b2-tactics-tactics-normalize lib lookup (list cons-step different)
                                              (list lookup) nil 1500 nil))
         (no (proof-proof-modus-ponens proof hypothesis typed-tail))
         (no-back (proof-proof-symmetric proof no-eq))
         (no (proof-proof-rewrite-result proof no no-back property-of-result *proof-result*)))
      (proof-proof-cases proof compares yes no))))

(defun b2-keywords-lookup-property-advance
    (cons-step hypothesis lib source goal lookup property-of-result key records tail rest)
  (proof-with-checked-results
      ((typed (proof-proof-assume (library-library-proof lib) source t))
       (outcome (b2-keywords-lookup-property-consequent
                 typed lib cons-step hypothesis source lookup property-of-result key records tail rest))
       (proved (b2-tactics-tactics-implication lib source goal (cons outcome lib))))
    (car proved)))

(defun b2-keywords-install-lookup-property (lib)
  (let* ((proof (library-library-proof lib))
         (key *b2-keywords-key*)
         (records *library-x*)
         (tail (list *library-cdr* records))
         (rest (list *library-cdr* tail))
         (lookup (list *b2-keywords-assoc* key records))
         (source (list *b2-keywords-keywords* records))
         (result *proof-result*))
    (proof-with-checked-results
        ((checks (b2-powers-and-terms
                  (list (list *proof-consp* result)
                        (list *proof-consp* (list *library-cdr* result))
                        (proof-eq (list *library-car* result) key)
                        (list *b2-keywords-keywordp* key))))
         (property (proof-ite result checks *proof-true*))
         (goal (proof-subst property (list (cons result lookup))))
         (formula (list *library-implies* source goal))
         (test (list *proof-consp* records))
         (cons-step (proof-proof-assume proof test t))
         (measure (list *proof-ordinal-less* (list *library-count* rest)
                        (list *library-count* records)))
         (rulers (b2-measures-rulers-init lib (list cons-step)))
         (smaller (b2-measures-rulers-selector-decrease lib measure rulers))
         (bindings (list (list records rest)))
         (advance (b2-tactics-tactics-by-induction lib formula records test (car smaller)
                                                   bindings nil nil t))
         (args (car advance))
         (advance-step (b2-keywords-lookup-property-advance
                        (cadddr args) (nth 4 args) (cdr advance)
                        source goal lookup property key records tail rest))
         (advance-reply (cons advance-step (cdr advance)))
         (base (b2-tactics-tactics-by-induction lib formula records test (car smaller)
                                                bindings nil advance-reply t))
         (base-step (b2-keywords-lookup-property-base (cadddr (car base)) (cdr base)
                                                     source goal lookup))
         (proved (b2-tactics-tactics-by-induction lib formula records test (car smaller)
                                                  bindings (cons base-step (cdr base))
                                                  advance-reply t)))
      (b2-tactics-tactics-add-lemma (cdr proved) "ASSOC-KEYWORD-PROPERTY" (car proved) :none))))

(defun b2-keywords-lookup-property (lib)
  (let ((label (proof-sym "B2-ASSOC-KEYWORD-PROPERTY" "ACL2")))
    (if (assoc-equal label (proof-proof-facts (library-library-proof lib)))
        (cons label lib)
      (b2-keywords-install-lookup-property lib))))

(defun b2-keywords-length-at-least-two (lib term cons-step tail-cons)
  (let* ((proof (library-library-proof lib))
         (tail (list *library-cdr* term))
         (length (list *library-len* term))
         (rest (list *library-len* (list *library-cdr* tail))))
    (proof-with-checked-results
        ((exposed (b2-tactics-tactics-normalize lib length (list cons-step tail-cons)
                                                (list length (list *library-len* tail)) nil 1500 nil))
         (nature (library-library-natural lib rest))
         (bound (library-library-cite lib "NATURAL-NONNEGATIVE" (list rest) (list nature)))
         (first (if exposed (proof-step-first exposed)
                  '(:failure "failure" "")))
         (rhs (proof-term-at first 2))
         (result (b2-tactics-tactics-weak-from-difference lib (proof-quote 2) rhs bound nil))
         (back (proof-proof-symmetric proof exposed))
         (result (proof-proof-rewrite proof result back '(1 1 1))))
      (proof-proof-tidy proof result))))

(defun b2-keywords-derive (lib goal result found property-step)
  (let* ((proof (library-library-proof lib))
         (tail (list *library-cdr* result)))
    (proof-with-checked-results
        ((fact (proof-proof-prove-if proof property-step found))
         (predicates (b2-tactics-tactics-evidence lib (list fact)))
         (cons-step (b2-keywords-evidence-step predicates (list *proof-consp* result)))
         (tail-cons (b2-keywords-evidence-step predicates (list *proof-consp* tail)))
         (arguments (proof-list-of-length result 3))
         (key (cadr arguments))
         (keyword (b2-keywords-evidence-step predicates (list *b2-keywords-keywordp* key)))
         (literal (proof-step-first keyword)))
      (cond
       ((equal goal literal) keyword)
       ((equal goal (list *b2-tactics-symbolp* key))
        (proof-with-checked-results
            ((opened (b2-tactics-tactics-normalize lib literal nil (list *b2-keywords-keywordp*)
                                                   nil 1500 nil))
             (typed (proof-proof-rewrite proof keyword opened '(1)))
             (typed (proof-proof-tidy proof typed))
             (parts (proof-proof-conjunct proof typed)))
          (car parts)))
       ((proof-is-call goal *proof-not*)
        (b2-keywords-length-at-least-two lib result cons-step tail-cons))
       (t
        (proof-with-checked-results
            ((test (proof-term-at goal 1))
             (tail-test (proof-step-first tail-cons))
             (evidence
              (cond
               ((equal test tail-test) tail-cons)
               ((equal test tail)
                (b2-tactics-tactics-from-impossible lib test tail-cons nil nil nil 1500 nil))
               (t
                (proof-with-checked-results
                    ((head-eq (b2-keywords-evidence-step
                               predicates (proof-eq (list *library-car* result) key))))
                  (library-library-transport-argument lib keyword head-eq 1))))))
          (b2-tactics-tactics-solve lib goal (list evidence found) nil nil 0 nil)))))))

(defun b2-keywords-assoc-keyword-consequent (premise lib goal equivalence result source test)
  (let ((proof (library-library-proof lib)))
    (if (not equivalence)
        (proof-with-checked-results
            ((types (b2-tactics-tactics-evidence lib (list premise)))
             (typed-source (b2-keywords-evidence-step types source))
             (evidence (proof-proof-modus-ponens proof test typed-source))
             (found (b2-keywords-evidence-step types result)))
          (b2-keywords-derive lib goal result found evidence))
      (proof-with-checked-results
          ((evidence (proof-proof-modus-ponens proof test premise))
           (positive (proof-proof-assume proof result t))
           (absent (proof-proof-assume proof result nil))
           (yes (b2-keywords-derive lib goal result positive evidence))
           (closed (b2-tactics-tactics-close-false lib result absent))
           (no (b2-tactics-tactics-solve lib goal (list absent) (list *b2-keywords-keywordp*)
                                         (list closed) 0 nil)))
        (proof-proof-cases proof result yes no)))))

(defun b2-keywords-assoc-keyword (lib name formula)
  (if (equal name (proof-sym "ASSOC-KEYWORD-OF-CONS-SAME" "ACL2"))
      (proof-with-checked-results
          ((call (proof-term-at formula 1))
           (step (b2-tactics-tactics-solve lib formula nil (list call) nil 0 nil)))
        (cons step lib))
    (proof-with-checked-results
        ((parts (proof-list-of-length formula 3))
         (condition (cadr parts))
         (goal (caddr parts)))
      (if (equal name (proof-sym "ASSOC-KEYWORD-OF-CONS-DIFF" "ACL2"))
          (proof-with-checked-results
              ((given (proof-proof-assume (library-library-proof lib) condition t))
               (call (proof-term-at goal 1))
               (step (b2-tactics-tactics-solve lib goal (list given) (list call) nil 0 nil)))
            (b2-tactics-tactics-implication lib condition goal (cons step lib)))
        (proof-with-checked-results
            ((property (b2-keywords-lookup-property lib))
             (lib (cdr property))
             (proof (library-library-proof lib))
             (equivalence (proof-is-call goal *b2-tactics-iff*))
             (result (if equivalence (proof-term-at goal 2) (proof-term-at condition 1)))
             (application (proof-list-of-length result 3))
             (key (cadr application))
             (records (caddr application))
             (source (list *b2-keywords-keywords* records))
             (test (proof-proof-fact proof (car property)
                                     (list (list *b2-keywords-key* key)
                                           (list *library-x* records))))
             (premise (proof-proof-assume proof condition t))
             (outcome (b2-keywords-assoc-keyword-consequent
                       premise lib goal equivalence result source test)))
          (b2-tactics-tactics-implication lib condition goal (cons outcome lib)))))))
