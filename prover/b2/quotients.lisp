(in-package "BOYMOO-PROVER")

(set-verify-guards-eagerness 0)

(defconst *b2-quotients-niq* (proof-sym "NONNEGATIVE-INTEGER-QUOTIENT" "ACL2"))
(defconst *b2-quotients-nfix* (proof-sym "NFIX" "ACL2"))
(defconst *b2-quotients-ifix* (proof-sym "IFIX" "ACL2"))
(defconst *b2-quotients-zp* (proof-sym "ZP" "ACL2"))
(defconst *b2-quotients-floor* (proof-cl "FLOOR"))

(defmacro b2-quotients-normalize (lib term &optional evidence unfold rules)
  `(b2-tactics-tactics-normalize ,lib ,term ,evidence ,unfold ,rules 1500 nil))

(defmacro b2-quotients-solve (lib goal &optional evidence unfold rules)
  `(b2-tactics-tactics-solve ,lib ,goal ,evidence ,unfold ,rules 0 nil))

(defmacro b2-quotients-from-impossible (lib goal premise &optional evidence unfold)
  `(b2-tactics-tactics-from-impossible ,lib ,goal ,premise ,evidence ,unfold
                                      nil 1500 nil))

(defmacro b2-quotients-use-fact (lib name target &optional evidence)
  `(b2-tactics-tactics-use-fact ,lib ,name ,target ,evidence nil nil 0 nil))

(defun b2-quotients-first (step)
  (if step
      (proof-step-first step)
    '(:failure "failure" "")))

(defun b2-quotients-evidence-at (known term)
  (let ((entry (assoc-equal term known)))
    (if entry
        (cdr entry)
      '(:failure "tactic-rejected" ""))))

(defun b2-quotients-step-literals (steps)
  (if (endp steps)
      nil
    (proof-with-checked-results
     ((first (b2-quotients-first (car steps)))
      (rest (b2-quotients-step-literals (cdr steps))))
     (cons first rest))))

(defun b2-quotients-add-product-negation (lib)
  (let* ((proof (library-library-proof lib))
         (x *library-x*)
         (y *library-y*)
         (p (b2-products-product x y))
         (q (b2-products-product x (library-minus y))))
    (proof-with-checked-results
     ((ints (library-library-ints lib (list x y)))
      (distributed (library-library-axiom lib "DISTRIBUTIVITY" (list x y (library-minus y))))
      (inverse (library-library-axiom lib "INVERSE-OF-+" (list y)))
      (distributed (proof-proof-rewrite proof distributed inverse '(1 1 2)))
      (reverse (proof-proof-symmetric proof distributed))
      (zero (b2-products-zero-product lib x))
      (lib (cdr zero))
      (proof (library-library-proof lib))
      (sum-zero (proof-proof-chain proof reverse (list (car zero))))
      (minus-p (library-minus p))
      (equation (b2-tactics-tactics-linear-equal lib (library-plus (library-plus p q) minus-p)
                                                q ints))
      (equation (proof-proof-rewrite proof equation sum-zero '(1 1 1)))
      (unary (library-library-type-of lib minus-p ints))
      (reduction (library-library-cite lib "ADD-ZERO-LEFT" (list minus-p) (list unary)))
      (equation (proof-proof-rewrite proof equation reduction '(1 1)))
      (equation (proof-proof-tidy proof equation))
      (result (proof-proof-symmetric proof equation))
      (literal (proof-step-first result))
      (lemma (b2-tactics-tactics-add-lemma
              lib "INTEGER-PRODUCT-NEGATION" result
              (list literal (proof-neg (library-integer x)) (proof-neg (library-integer y))))))
     (cdr lemma))))

(defun b2-quotients-product-negation (lib a b types)
  (let ((label (proof-sym "B2-INTEGER-PRODUCT-NEGATION" "ACL2")))
    (proof-with-checked-results
     ((lib (if (assoc-equal label (proof-proof-facts (library-library-proof lib)))
               lib
             (b2-quotients-add-product-negation lib)))
      (a-type (library-library-type-of lib a types))
      (b-type (library-library-type-of lib b types))
      (result (proof-proof-use (library-library-proof lib) label
                               (list (list *library-x* a) (list *library-y* b))
                               (list a-type b-type))))
     (cons result lib))))

(defun b2-quotients-product-difference (lib scale a b types)
  (proof-with-checked-results
   ((equality (library-library-axiom lib "DISTRIBUTIVITY" (list scale b (library-minus a))))
    (negation (b2-quotients-product-negation lib scale a types))
    (lib (cdr negation))
    (proof (library-library-proof lib))
    (rewritten (proof-proof-rewrite proof equality (car negation) '(1 2 2)))
    (step (proof-proof-tidy proof rewritten)))
   (cons step lib)))

(defun b2-quotients-scaled-sign (lib comparison types strict)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results ((literal (b2-quotients-first comparison)))
      (if strict
          (proof-with-checked-results
           ((parts (proof-list-of-length literal 3))
            (a (cadr parts))
            (b (caddr parts))
            (equation (library-library-comparison lib a b types))
            (sign (proof-proof-rewrite proof comparison equation '(1)))
            (sign (proof-proof-tidy proof sign)))
           (list a b sign))
        (proof-with-checked-results
         ((parts (proof-list-of-length literal 2))
          (inner (proof-list-of-length (cadr parts) 3))
          (b (cadr inner))
          (a (caddr inner))
          (equation (library-library-axiom lib "<-ON-OTHERS" (list b a)))
          (sign (proof-proof-rewrite proof comparison equation '(1 1)))
          (sign (proof-proof-tidy proof sign)))
         (list a b sign))))))

(defun b2-quotients-scaled-nonnegative (lib scale delta rationals scale-positive sign types)
  (let* ((proof (library-library-proof lib))
         (test (library-positive delta))
         (value (b2-products-product scale delta)))
    (proof-with-checked-results
     ((pos (proof-proof-assume proof test t))
      (not-positive (proof-proof-assume proof test nil))
      (value-positive (library-library-cite lib "POSITIVE-PRODUCT" (list scale delta)
                                            (append rationals (list scale-positive pos))))
      (value-type (library-library-type-of lib value types))
      (nonnegative (library-library-cite lib "POSITIVE-NONNEGATIVE" (list value)
                                         (list value-type value-positive)))
      (delta-type (library-library-type-of lib delta types))
      (zero (b2-powers-zero-from-signs lib delta delta-type sign not-positive))
      (zero-product (b2-products-zero-product lib scale))
      (lib (cdr zero-product))
      (zero-bound (b2-quotients-solve lib (proof-neg (library-lt value *proof-zero*))
                                     (list zero) nil (list (car zero-product))))
      (multiplied (proof-proof-cases (library-library-proof lib) test nonnegative zero-bound)))
     (cons multiplied lib))))

(defun b2-quotients-scaled-result (lib multiplied difference left right types strict)
  (let ((proof (library-library-proof lib)))
    (if strict
        (proof-with-checked-results
         ((explicit (library-library-comparison lib left right types))
          (explicit (proof-proof-rewrite proof explicit difference '(1 2 2)))
          (explicit (proof-proof-tidy proof explicit)))
         (proof-proof-transport proof multiplied explicit))
      (proof-with-checked-results
       ((explicit (library-library-axiom lib "<-ON-OTHERS" (list right left)))
        (explicit (proof-proof-rewrite proof explicit difference '(1 2 1)))
        (explicit (proof-proof-tidy proof explicit)))
       (library-library-transport-argument lib multiplied explicit 1)))))

(defun b2-quotients-scaled (lib comparison scale scale-positive types strict)
  (proof-with-checked-results
   ((parts (b2-quotients-scaled-sign lib comparison types strict))
    (a (car parts))
    (b (cadr parts))
    (sign (caddr parts))
    (delta (library-diff b a))
    (scale-rational (library-library-rational lib scale types))
    (delta-rational (library-library-rational lib delta types))
    (rationals (list scale-rational delta-rational))
    (multiplied (if strict
                    (proof-with-checked-results
                     ((step (library-library-cite lib "POSITIVE-PRODUCT" (list scale delta)
                                                  (append rationals (list scale-positive sign)))))
                     (cons step lib))
                  (b2-quotients-scaled-nonnegative lib scale delta rationals
                                                   scale-positive sign types)))
    (lib (cdr multiplied))
    (difference (b2-quotients-product-difference lib scale a b types))
    (lib (cdr difference))
    (reverse (proof-proof-symmetric (library-library-proof lib) (car difference)))
    (left (b2-products-product scale a))
    (right (b2-products-product scale b))
    (result (b2-quotients-scaled-result lib (car multiplied) reverse left right types strict)))
   (cons result lib)))

(defun b2-quotients-natural-proof (lib term typed nonnegative)
  (library-library-cite lib "NATURAL-FROM-BOUNDS" (list term) (list typed nonnegative)))

(defun b2-quotients-quotient-upper (lib upper-child i j child successor ints unit)
  (let* ((proof (library-library-proof lib))
         (high (b2-products-product j successor)))
    (proof-with-checked-results
     ((comparison (library-library-comparison lib child high ints))
      (increase (proof-proof-rewrite proof upper-child comparison '(1)))
      (shifted (b2-tactics-tactics-less-from-difference lib i (library-plus j high)
                                                        increase ints))
      (expanded (library-library-axiom lib "DISTRIBUTIVITY" (list j *proof-one* successor)))
      (expanded (proof-proof-rewrite proof expanded unit '(1 2 1)))
      (expanded (proof-proof-tidy proof expanded)))
     (library-library-transport-argument lib shifted expanded 2))))

(defun b2-quotients-quotient-step
    (lib upper i j child call formula measure binding test long nonzero-j equality-tests
         unit int-i int-j pos-j i-nonnegative stop)
  (let ((proof (library-library-proof lib))
        (types (list int-i int-j)))
    (proof-with-checked-results
     ((comparison (library-library-axiom lib "<-ON-OTHERS" (list i j)))
      (nonnegative-child (proof-proof-rewrite proof long comparison '(1 1)))
      (nonnegative-child (proof-proof-tidy proof nonnegative-child))
      (child-int (library-library-type-of lib child types))
      (child-nat (b2-quotients-natural-proof lib child child-int nonnegative-child))
      (decrease (b2-tactics-tactics-less-from-difference lib child i pos-j types))
      (old-count (b2-powers-integer-count lib i int-i i-nonnegative))
      (new-count (b2-powers-integer-count lib child child-int nonnegative-child))
      (decrease (library-library-transport-argument lib decrease old-count 2))
      (decrease (library-library-transport-argument lib decrease new-count 1))
      (comparison (library-library-ordinal-comparison lib (list *library-count* child) measure))
      (ordinal (proof-proof-transport proof decrease comparison))
      (hypothesis (b2-tactics-tactics-induction-hypothesis lib formula measure binding ordinal))
      (literal (proof-step-first hypothesis))
      (antecedent (proof-term-at literal 1))
      (reached (b2-quotients-solve lib antecedent (list child-nat int-j pos-j)))
      (prior (proof-proof-modus-ponens proof hypothesis reached))
      (parts (proof-proof-conjunct proof prior))
      (nat-quot (car parts))
      (bounds (if upper
                  (proof-proof-conjunct proof (cadr parts))
                (list (cadr parts) nil)))
      (bound (car bounds))
      (upper-child (cadr bounds))
      (child-call (list *b2-quotients-niq* child j))
      (successor (library-plus *proof-one* child-call))
      (simple (b2-quotients-normalize lib call (list nonzero-j long) (list call) equality-tests))
      (natural-one (library-library-natural lib *proof-one*))
      (nat-result (library-library-cite lib "NATURAL-SUM" (list *proof-one* child-call)
                                        (list natural-one nat-quot)))
      (distributed (library-library-axiom lib "DISTRIBUTIVITY" (list j *proof-one* child-call)))
      (distributed (proof-proof-rewrite proof distributed unit '(1 2 1)))
      (distributed (proof-proof-tidy proof distributed))
      (quotient-int (library-library-cite lib "NATURAL-INTEGER" (list child-call)
                                          (list nat-quot)))
      (ints (append types (list quotient-int)))
      (j-times-child (b2-products-product j child-call))
      (comparison (library-library-axiom lib "<-ON-OTHERS" (list child j-times-child)))
      (delta (proof-proof-rewrite proof bound comparison '(1 1)))
      (delta (proof-proof-tidy proof delta))
      (longer (b2-tactics-tactics-weak-from-difference lib (library-plus j j-times-child) i
                                                       delta ints))
      (reverse (proof-proof-symmetric proof distributed))
      (longer (proof-proof-rewrite proof longer reverse '(1 1 2)))
      (longer (proof-proof-tidy proof longer))
      (facts (if upper
                 (proof-with-checked-results
                  ((high (b2-quotients-quotient-upper lib upper-child i j child
                                                      successor ints unit)))
                  (list nat-result longer high))
               (list nat-result longer)))
      (literals (b2-quotients-step-literals facts))
      (target (b2-powers-and-terms literals))
      (collected (b2-quotients-solve lib target facts))
      (reverse (proof-proof-symmetric proof simple))
      (step (proof-proof-rewrite-first proof collected reverse))
      (result (proof-proof-cases proof test stop step)))
     (cons result lib))))

(defun b2-quotients-nonnegative-quotient-consequent
    (premise lib upper i j call target formula measure child binding)
  (let ((proof (library-library-proof lib))
        (test (library-lt i j)))
    (proof-with-checked-results
     ((info (b2-tactics-tactics-evidence lib (list premise)))
      (nat-i (b2-quotients-evidence-at info (list *library-natp* i)))
      (int-j (b2-quotients-evidence-at info (library-integer j)))
      (pos-j (b2-quotients-evidence-at info (library-positive j)))
      (int-i (library-library-cite lib "NATURAL-INTEGER" (list i) (list nat-i)))
      (i-nonnegative (library-library-cite lib "NATURAL-NONNEGATIVE" (list i) (list nat-i)))
      (j-nonnegative (library-library-cite lib "POSITIVE-NONNEGATIVE" (list j)
                                          (list int-j pos-j)))
      (nonzero-j (b2-quotients-from-impossible lib (proof-neg (proof-eq j *proof-zero*)) pos-j))
      (fixed-i (b2-quotients-normalize lib (list *b2-quotients-ifix* i) (list int-i)
                                       (list *b2-quotients-ifix*)))
      (fixed-j (b2-quotients-normalize lib (list *b2-quotients-nfix* j)
                                       (list int-j j-nonnegative) (list *b2-quotients-nfix*)))
      (equality-tests (list fixed-i fixed-j))
      (short (proof-proof-assume proof test t))
      (long (proof-proof-assume proof test nil))
      (empty (b2-quotients-normalize lib call (list nonzero-j short) (list call)
                                     equality-tests))
      (commutes (library-library-axiom lib "COMMUTATIVITY-OF-*" (list j *proof-one*)))
      (numeric-j (library-library-number lib j (list int-j)))
      (unit (b2-products-multiplicative-unit lib j numeric-j))
      (unit (proof-proof-chain proof commutes (list unit)))
      (natural-zero (library-library-natural lib *proof-zero*))
      (zero (b2-products-zero-product lib j))
      (lib (cdr zero))
      (stop (b2-quotients-solve lib target (list natural-zero i-nonnegative short)
                                nil (list empty (car zero) unit))))
     (b2-quotients-quotient-step lib upper i j child call formula measure binding
                                 test long nonzero-j equality-tests unit int-i int-j pos-j
                                 i-nonnegative stop))))

(defun b2-quotients-nonnegative-quotient (lib upper)
  (let* ((label (proof-sym (if upper "B2-QUOTIENT-INTERVAL" "B2-QUOTIENT-BOUND") "ACL2"))
         (proof (library-library-proof lib)))
    (if (assoc-equal label (proof-proof-facts proof))
        (cons label lib)
      (let* ((i *library-x*)
             (j *library-y*)
             (call (list *b2-quotients-niq* i j))
             (basic-bounds (list (list *library-natp* call)
                                 (library-le (b2-products-product j call) i)))
             (measure (list *library-count* i))
             (child (library-diff i j))
             (binding (list (list i child))))
        (proof-with-checked-results
         ((conditions (b2-powers-and-terms (list (list *library-natp* i)
                                                (library-integer j) (library-positive j))))
          (bounds (if upper
                      (append basic-bounds
                              (list (library-lt i (b2-products-product j
                                                                       (library-plus *proof-one*
                                                                                     call)))))
                    basic-bounds))
          (target (b2-powers-and-terms bounds))
          (formula (list *library-implies* conditions target))
          (ordinal (library-library-builtin lib 1 i))
          (premise (proof-proof-assume proof conditions t))
          (consequent (b2-quotients-nonnegative-quotient-consequent
                       premise lib upper i j call target formula measure child binding))
          (implication (b2-tactics-tactics-implication lib conditions target consequent))
          (lib (cdr implication))
          (step (proof-proof-induct (library-library-proof lib) ordinal (car implication)
                                    formula measure (list binding))))
         (b2-tactics-tactics-add-lemma lib (if upper "QUOTIENT-INTERVAL" "QUOTIENT-BOUND")
                                      step :none))))))

(defun b2-quotients-cross-product (lib i j d n represented divisor-inverse integer-i)
  (let* ((proof (library-library-proof lib))
         (recip-j (list *b2-products-recip* j))
         (q (b2-products-product i recip-j)))
    (proof-with-checked-results
     ((goal (proof-proof-reflexive proof (b2-products-product j n)))
      (reverse (proof-proof-symmetric proof represented))
      (goal (proof-proof-rewrite proof goal reverse '(1 2 2)))
      (association (library-library-axiom lib "ASSOCIATIVITY-OF-*" (list j q d)))
      (reverse (proof-proof-symmetric proof association))
      (goal (proof-proof-chain proof goal (list reverse)))
      (swap (b2-products-product-swap lib j i recip-j))
      (goal (proof-proof-rewrite proof goal swap '(1 2 1)))
      (goal (proof-proof-rewrite proof goal divisor-inverse '(1 2 1 2)))
      (commutes (library-library-axiom lib "COMMUTATIVITY-OF-*" (list i *proof-one*)))
      (number (library-library-number lib i (list integer-i)))
      (unit (b2-products-multiplicative-unit lib i number))
      (i-times-one (proof-proof-chain proof commutes (list unit)))
      (goal (proof-proof-rewrite proof goal i-times-one '(1 2 1)))
      (commutes (library-library-axiom lib "COMMUTATIVITY-OF-*" (list i d))))
     (proof-proof-chain proof goal (list commutes)))))

(defun b2-quotients-floor-numerator (lib i j d n pos-i pos-j pos-d crossed types int-n)
  (let ((proof (library-library-proof lib))
        (test (library-lt n *proof-zero*)))
    (proof-with-checked-results
     ((negative (proof-proof-assume proof test t))
      (scaled (b2-quotients-scaled lib negative j pos-j types t))
      (lib (cdr scaled))
      (proof (library-library-proof lib))
      (multiplied (proof-proof-rewrite proof (car scaled) crossed '(1 1)))
      (zero (b2-products-zero-product lib j))
      (lib (cdr zero))
      (proof (library-library-proof lib))
      (multiplied (proof-proof-rewrite proof multiplied (car zero) '(1 2)))
      (multiplied (proof-proof-tidy proof multiplied))
      (d-rational (library-library-rational lib d types))
      (i-rational (library-library-rational lib i types))
      (expected (library-library-cite lib "POSITIVE-PRODUCT" (list d i)
                                       (list d-rational i-rational pos-d pos-i)))
      (positive-product (b2-products-product d i))
      (product-typed (library-library-type-of lib positive-product types))
      (nonnegative (library-library-cite lib "POSITIVE-NONNEGATIVE" (list positive-product)
                                         (list product-typed expected)))
      (nn-n (proof-proof-cut proof multiplied nonnegative))
      (nn-n (proof-proof-front proof nn-n (proof-neg test)))
      (nat-n (b2-quotients-natural-proof lib n int-n nn-n)))
     (cons (list nat-n nn-n) lib))))

(defun b2-quotients-floor-quotient (lib division d n int-d int-n pos-d nat-n nn-n)
  (let ((test (proof-eq d *proof-one*)))
    (proof-with-checked-results
     ((quotient (b2-quotients-nonnegative-quotient lib nil))
      (lib (cdr quotient))
      (proof (library-library-proof lib))
      (lemma (proof-proof-fact proof (car quotient)
                               (list (list *library-x* n) (list *library-y* d))))
      (literal (proof-step-first lemma))
      (antecedent (proof-term-at literal 1))
      (condition (b2-quotients-solve lib antecedent (list nat-n int-d pos-d)))
      (use (proof-proof-modus-ponens proof lemma condition))
      (parts (proof-proof-conjunct proof use))
      (quotient-nat (car parts))
      (quotient-bound (cadr parts))
      (unit (proof-proof-assume proof test t))
      (other (proof-proof-assume proof test nil))
      (equn (b2-quotients-normalize lib division (list unit) (list division)))
      (eqother (b2-quotients-normalize lib division (list other nn-n) (list division)))
      (nat-unit (library-library-transport-argument lib nat-n equn 1))
      (nat-other (library-library-transport-argument lib quotient-nat eqother 1))
      (nat (proof-proof-cases proof test nat-unit nat-other))
      (number (library-library-number lib n (list int-n)))
      (unit-product (b2-products-multiplicative-unit lib n number))
      (same (library-library-cite lib "WEAK-REFLEXIVE" (list n) (list int-n)))
      (product-in-unit (proof-proof-reflexive proof (b2-products-product d division)))
      (product-in-unit (proof-proof-rewrite proof product-in-unit unit '(1 2 1)))
      (product-in-unit (proof-proof-tidy proof product-in-unit))
      (product-in-unit (proof-proof-rewrite proof product-in-unit equn '(1 2 2)))
      (product-in-unit (proof-proof-chain proof product-in-unit (list unit-product)))
      (reverse (proof-proof-symmetric proof product-in-unit))
      (weak-unit (proof-proof-rewrite proof same reverse '(1 1 2)))
      (weak-unit (proof-proof-tidy proof weak-unit))
      (reverse (proof-proof-symmetric proof eqother))
      (weak-other (proof-proof-rewrite proof quotient-bound reverse '(1 1 2 2)))
      (weak-other (proof-proof-tidy proof weak-other))
      (upper (proof-proof-cases proof test weak-unit weak-other)))
     (cons (list nat upper) lib))))

(defun b2-quotients-floor-product-bound (lib i j d division pos-j pos-d upper crossed types)
  (proof-with-checked-results
   ((scaled (b2-quotients-scaled lib upper j pos-j types nil))
    (lib (cdr scaled))
    (proof (library-library-proof lib))
    (upper (proof-proof-rewrite proof (car scaled) crossed '(1 1 1)))
    (upper (proof-proof-tidy proof upper))
    (rearranged (b2-products-product-swap lib j d division))
    (upper (proof-proof-rewrite proof upper rearranged '(1 1 2)))
    (upper (proof-proof-tidy proof upper))
    (larger-than-i (library-lt i (b2-products-product j division)))
    (larger (proof-proof-assume proof larger-than-i t))
    (contradiction (b2-quotients-scaled lib larger d pos-d types t))
    (lib (cdr contradiction))
    (proof (library-library-proof lib))
    (product-bound (proof-proof-cut proof (car contradiction) upper))
    (product-bound (proof-proof-front proof product-bound (proof-neg larger-than-i))))
   (cons (list product-bound upper) lib)))

(defun b2-quotients-floor-strict
    (lib i j d division int-i pos-i pos-d greater-j upper types)
  (let* ((proof (library-library-proof lib))
         (smaller (library-lt division i)))
    (proof-with-checked-results
     ((failure (proof-proof-assume proof smaller nil))
      (ptype (library-library-type-of lib division types))
      (zero-type (library-library-type-of lib *proof-zero* nil))
      (positive-f (library-library-cite lib "LESS-THEN-WEAK" (list *proof-zero* i division)
                                         (list zero-type int-i ptype pos-i failure)))
      (gap (library-diff j *proof-one*))
      (comparison (library-library-comparison lib *proof-one* j types))
      (gap-positive (proof-proof-rewrite proof greater-j comparison '(1)))
      (gap-positive (proof-proof-tidy proof gap-positive))
      (division-rational (library-library-rational lib division types))
      (gap-rational (library-library-rational lib gap types))
      (product-gap (library-library-cite lib "POSITIVE-PRODUCT" (list division gap)
                                         (list division-rational gap-rational
                                               positive-f gap-positive)))
      (algebra (b2-quotients-product-difference lib division *proof-one* j types))
      (lib (cdr algebra))
      (proof (library-library-proof lib))
      (commutes (library-library-axiom lib "COMMUTATIVITY-OF-*" (list division *proof-one*)))
      (number (library-library-number lib division (list ptype)))
      (unit (b2-products-multiplicative-unit lib division number))
      (unity (proof-proof-chain proof commutes (list unit)))
      (algebra (proof-proof-rewrite proof (car algebra) unity '(1 2 2 1)))
      (commutes (library-library-axiom lib "COMMUTATIVITY-OF-*" (list division j)))
      (algebra (proof-proof-rewrite proof algebra commutes '(1 2 1)))
      (algebra (proof-proof-tidy proof algebra))
      (product (b2-products-product j division))
      (compare (library-library-comparison lib division product types))
      (reverse (proof-proof-symmetric proof algebra))
      (compare (proof-proof-rewrite proof compare reverse '(1 2 2)))
      (compare (proof-proof-tidy proof compare))
      (grows (proof-proof-transport proof product-gap compare))
      (product-type (library-library-type-of lib product types))
      (exceed (library-library-cite lib "WEAK-THEN-LESS" (list i division product)
                                     (list int-i ptype product-type failure grows)))
      (too-large (b2-quotients-scaled lib exceed d pos-d types t))
      (lib (cdr too-large))
      (proof (library-library-proof lib))
      (decrease (proof-proof-cut proof (car too-large) upper))
      (decrease (proof-proof-front proof decrease smaller)))
     (cons decrease lib))))

(defun b2-quotients-floor-bounds (lib i j int-i int-j pos-i pos-j greater-j)
  (let* ((reciprocal (list *b2-products-recip* j))
         (q (b2-products-product i reciprocal))
         (division (list *b2-quotients-floor* i j)))
    (proof-with-checked-results
     ((j-rational (library-library-rational lib j (list int-j)))
      (reciprocal-rational (b2-quotients-use-fact lib '("str" "rationalp-unary-/")
                                                 (list *library-rationalp* reciprocal)
                                                 (list j-rational)))
      (i-rational (library-library-rational lib i (list int-i)))
      (rational (b2-quotients-use-fact lib '("str" "rationalp-binary-*")
                                      (list *library-rationalp* q)
                                      (list i-rational reciprocal-rational)))
      (d (list *b2-products-den* q))
      (n (list *b2-products-num* q))
      (factors (b2-products-rational-factors lib q rational))
      (int-d (car factors))
      (int-n (cadr factors))
      (pos-d (caddr factors))
      (nonzero (proof-neg (proof-eq j *proof-zero*)))
      (not-zero (if (proof-is-call j *proof-quote*)
                    (b2-quotients-solve lib nonzero)
                  (b2-quotients-from-impossible lib nonzero pos-j)))
      (numeric-j (library-library-number lib j (list int-j)))
      (inverse (b2-products-reciprocal-identity lib j numeric-j not-zero))
      (relation (b2-products-rational-product lib q rational))
      (lib (cdr relation))
      (crossed (b2-quotients-cross-product lib i j d n (car relation) inverse int-i))
      (types (list int-i int-j int-d int-n))
      (numerator (b2-quotients-floor-numerator lib i j d n pos-i pos-j pos-d
                                                crossed types int-n))
      (lib (cdr numerator))
      (nat-n (caar numerator))
      (nn-n (cadar numerator))
      (quotient (b2-quotients-floor-quotient lib division d n int-d int-n pos-d nat-n nn-n))
      (lib (cdr quotient))
      (nat (caar quotient))
      (upper (cadar quotient))
      (int-division (library-library-cite lib "NATURAL-INTEGER" (list division) (list nat)))
      (types (append types (list int-division)))
      (product-bound (b2-quotients-floor-product-bound lib i j d division
                                                        pos-j pos-d upper crossed types))
      (lib (cdr product-bound))
      (upper (cadar product-bound))
      (decrease (b2-quotients-floor-strict lib i j d division int-i pos-i pos-d
                                           greater-j upper types)))
     (cons (list nat (car decrease) (caar product-bound)) (cdr decrease)))))

(defun b2-quotients-floor-descent-consequent (given lib goal)
  (let ((x *library-x*) (y *library-y*))
    (proof-with-checked-results
     ((premises (b2-tactics-tactics-evidence lib (list given)))
      (int-x (b2-quotients-evidence-at premises (library-integer x)))
      (int-y (b2-quotients-evidence-at premises (library-integer y)))
      (pos-x (b2-quotients-evidence-at premises (library-positive x)))
      (pos-y (b2-quotients-evidence-at premises (library-positive y)))
      (greater-y (b2-quotients-evidence-at premises (library-lt *proof-one* y)))
      (bounds (b2-quotients-floor-bounds lib x y int-x int-y pos-x pos-y greater-y))
      (lib (cdr bounds))
      (step (b2-quotients-solve lib goal (car bounds))))
     (cons step lib))))

(defun b2-quotients-add-floor-bounds (lib)
  (let* ((x *library-x*)
         (y *library-y*)
         (division (list *b2-quotients-floor* x y)))
    (proof-with-checked-results
     ((conditions (b2-powers-and-terms
                   (list (library-integer x) (library-integer y)
                         (library-positive x) (library-positive y) (library-lt *proof-one* y))))
      (goal (b2-powers-and-terms
             (list (list *library-natp* division) (library-lt division x)
                   (library-le (b2-products-product y division) x))))
      (given (proof-proof-assume (library-library-proof lib) conditions t))
      (reply (b2-quotients-floor-descent-consequent given lib goal))
      (implication (b2-tactics-tactics-implication lib conditions goal reply))
      (lemma (b2-tactics-tactics-add-lemma (cdr implication) "FLOOR-BOUNDS" (car implication) :none)))
     (cdr lemma))))

(defun b2-quotients-floor-descent (lib i j int-i int-j pos-i pos-j greater-j)
  (let ((label (proof-sym "B2-FLOOR-BOUNDS" "ACL2")))
    (proof-with-checked-results
     ((lib (if (assoc-equal label (proof-proof-facts (library-library-proof lib)))
               lib
             (b2-quotients-add-floor-bounds lib)))
      (proof (library-library-proof lib))
      (statement (proof-proof-fact proof label (list (list *library-x* i) (list *library-y* j))))
      (literal (proof-step-first statement))
      (condition (proof-term-at literal 1))
      (precondition (b2-quotients-solve lib condition (list int-i int-j pos-i pos-j greater-j)))
      (instance (proof-proof-modus-ponens proof statement precondition))
      (parts (proof-proof-conjunct proof instance))
      (more (proof-proof-conjunct proof (cadr parts))))
     (cons (cons (car parts) more) lib))))

(defun b2-quotients-ilog-decrease (lib goal evidence)
  (let ((two (proof-quote 2)))
    (proof-with-checked-results
     ((known (b2-tactics-tactics-evidence lib evidence))
      (parts (if (integerp goal)
                 '(:failure "tactic-rejected" "")
               (proof-list-of-length (cdr goal) 2)))
      (child (car parts))
      (parent (cadr parts))
      (child-parts (proof-list-of-length child 2))
      (floor-parts (proof-list-of-length (cadr child-parts) 3))
      (x (cadr floor-parts))
      (base (caddr floor-parts))
      (nx (b2-quotients-evidence-at known (proof-neg (list *b2-quotients-zp* x))))
      (nb (b2-quotients-evidence-at known (proof-neg (list *b2-quotients-zp* base))))
      (int-x (b2-quotients-from-impossible lib (library-integer x) nx
                                          nil (list *b2-quotients-zp*)))
      (int-b (b2-quotients-from-impossible lib (library-integer base) nb
                                          nil (list *b2-quotients-zp*)))
      (pos-x (b2-quotients-from-impossible lib (library-positive x) nx
                                          (list int-x) (list *b2-quotients-zp*)))
      (pos-b (b2-quotients-from-impossible lib (library-positive base) nb
                                          (list int-b) (list *b2-quotients-zp*)))
      (one-type (library-library-type-of lib *proof-one* nil))
      (two-type (library-library-type-of lib two nil))
      (one-less-two (b2-quotients-solve lib (library-lt *proof-one* two)))
      (base-bound (b2-quotients-evidence-at known (proof-neg (library-lt base two))))
      (larger-than-one (library-library-cite lib "LESS-THEN-WEAK" (list *proof-one* two base)
                                             (list one-type two-type int-b
                                                   one-less-two base-bound)))
      (floor (b2-quotients-floor-descent lib x base int-x int-b pos-x pos-b larger-than-one))
      (lib (cdr floor))
      (natural (caar floor))
      (less (cadar floor))
      (value (proof-term-at child 1))
      (value-type (library-library-cite lib "NATURAL-INTEGER" (list value) (list natural)))
      (no-negative (library-library-cite lib "NATURAL-NONNEGATIVE" (list value) (list natural)))
      (parent-nonnegative (library-library-cite lib "POSITIVE-NONNEGATIVE" (list x)
                                                (list int-x pos-x)))
      (value-count (b2-powers-integer-count lib value value-type no-negative))
      (less (library-library-transport-argument lib less value-count 1))
      (parent-count (b2-powers-integer-count lib x int-x parent-nonnegative))
      (less (library-library-transport-argument lib less parent-count 2))
      (compare (library-library-ordinal-comparison lib child parent))
      (result (proof-proof-transport (library-library-proof lib) less compare)))
     (cons result lib))))
