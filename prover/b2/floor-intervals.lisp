(defun b2-floor-intervals-cases (lib test prove)
  (proof-with-checked-results ((yes (car prove))
                               (no (cadr prove)))
    (proof-proof-cases (library-library-proof lib) test yes no)))

(defun b2-floor-intervals-fact-step (facts term)
  (let ((entry (assoc-equal term facts)))
    (if entry (cdr entry)
      '(:failure "tactic-rejected" ""))))

(defun b2-floor-intervals-floor-interval-collect (lower upper evidence lib expression goal)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((opened (b2-tactics-tactics-normalize lib expression evidence (list expression) nil 1500 nil))
         (back (if opened (proof-proof-symmetric proof opened)
                 '(:failure "failure" "")))
         (low (proof-proof-rewrite proof lower back '(1 1 2)))
         (low (proof-proof-tidy proof low))
         (high (proof-proof-rewrite proof upper back '(1 2 2)))
         (high (proof-proof-tidy proof high)))
      (b2-tactics-tactics-solve lib goal (list low high) nil nil 0 nil))))

(defun b2-floor-intervals-floor-interval-numerator
    (sign negative lib unit-test n d nt dt dp rn ratio rat-ratio alias expression goal)
