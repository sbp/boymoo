(defun b2-floor-intervals-modulus-theorem-request (lib formula branches negative proofs)
  (if (endp branches)
      (proof-with-checked-results
          ((step (b2-tactics-tactics-solve lib formula (reverse proofs) nil nil 0 nil)))
        (cons step lib))
    (proof-with-checked-results
        ((branch (proof-list-of-length (car branches) 3))
         (goal (caddr branch))
         (modulus (proof-term-at goal (if negative 2 1)))
         (arguments (proof-list-of-length modulus 3)))
      (list :b2-floor-type lib (cadr arguments) (caddr arguments)
            formula negative (cadr branch) goal (cdr branches) proofs))))

(defun b2-floor-intervals-modulus-theorem-resume (request floor-type)
  (proof-with-checked-results ((typed floor-type))
    (let ((lib (cdr typed))
          (formula (nth 4 request))
          (negative (nth 5 request))
          (premise (nth 6 request))
          (goal (nth 7 request)))
      (proof-with-checked-results
          ((given (proof-proof-assume (library-library-proof lib) premise t))
           (outcome (b2-floor-intervals-modulus-theorem-prove
                     given lib (b2-floor-intervals-floor-type-i request)
                     (b2-floor-intervals-floor-type-j request) (car typed) negative))
           (proved (b2-tactics-tactics-implication lib premise goal outcome)))
        (b2-floor-intervals-modulus-theorem-request
         (cdr proved) formula (nth 8 request) t (cons (car proved) (nth 9 request)))))))

(defun b2-floor-intervals-modulus-theorem-replies (replies result)
  (if (and (consp replies) (b2-floor-intervals-floor-type-request-p result))
      (b2-floor-intervals-modulus-theorem-replies
       (cdr replies) (b2-floor-intervals-modulus-theorem-resume result (car replies)))
    result))

(defun b2-floor-intervals-modulus-theorem (lib formula prove-floor-type)
  (b2-floor-intervals-modulus-theorem-replies
   prove-floor-type
   (b2-floor-intervals-modulus-theorem-request lib formula (seq-slice formula 1 3) nil nil)))

(defun b2-floor-intervals-floor-theorem-bound (lib premise goal)
  (proof-with-checked-results
      ((lower (proof-term-at goal 1))
       (lower (proof-list-of-length lower 3))
       (floor (proof-list-of-length (caddr lower) 3))
       (forced (b2-floor-intervals-force-facts lib premise))
       (i (cadr floor))
       (j (caddr floor))
       (ri (b2-floor-intervals-fact-step forced (list *library-rationalp* i)))
       (rj (b2-floor-intervals-fact-step forced (list *library-rationalp* j)))
       (bounds (b2-floor-intervals-floor-interval lib i j ri rj))
       (lib (cdr bounds))
       (shifted (b2-quotient-interval-shift-bound lib (cadar bounds)))
       (step (b2-tactics-tactics-solve lib goal (list (caar bounds) shifted) nil nil 0 nil)))
    (cons step lib)))

(defun b2-floor-intervals-floor-theorem-numeric (lib name value premise)
  (if (equal name *b2-floor-intervals-mod-elim*)
      premise
    (proof-with-checked-results
        ((forced (b2-floor-intervals-force-facts lib premise))
         (rational (b2-floor-intervals-fact-step forced (list *library-rationalp* value))))
      (b2-scaling-number-of-rational lib value rational))))

(defun b2-floor-intervals-floor-theorem-product (lib equation factor)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((first (proof-step-first equation))
         (right (proof-term-at first 2))
         (difference (proof-term-at right 2))
         (product (proof-term-at difference 1)))
      (if (equal product factor)
          equation
        (proof-with-checked-results
            ((swapped (library-library-axiom lib "COMMUTATIVITY-OF-*" (cdr product)))
             (equation (proof-proof-rewrite proof equation swapped '(1 2 2 1))))
          (proof-proof-tidy proof equation))))))

(defun b2-floor-intervals-floor-theorem-consequent (premise lib name goal)
  (if (equal name *b2-floor-intervals-floor-bound*)
      (b2-floor-intervals-floor-theorem-bound lib premise goal)
    (let ((proof (library-library-proof lib)))
      (proof-with-checked-results
          ((parts (proof-list-of-length goal 3))
           (sum (proof-list-of-length (cadr parts) 3))
           (remainder (cadr sum))
           (factor (caddr sum))
           (value (caddr parts))
           (numeric (b2-floor-intervals-floor-theorem-numeric lib name value premise))
           (equation (proof-proof-unfold proof remainder))
           (equation (b2-floor-intervals-floor-theorem-product lib equation factor))
           (opposite (library-minus factor))
           (joined (library-library-axiom lib "ASSOCIATIVITY-OF-+" (list value opposite factor)))
           (commute (library-library-axiom lib "COMMUTATIVITY-OF-+" (list opposite factor)))
           (inverse (library-library-axiom lib "INVERSE-OF-+" (list factor)))
           (pair (proof-proof-chain proof commute (list inverse)))
           (joined (proof-proof-rewrite proof joined pair '(1 2 2)))
           (commute (library-library-axiom lib "COMMUTATIVITY-OF-+" (list value *proof-zero*)))
           (zero (library-library-axiom lib "UNICITY-OF-0" (list value)))
           (unit (proof-proof-chain proof commute (list zero)))
           (fixed (proof-proof-unfold proof (list (proof-sym "FIX" "ACL2") value)))
           (first (proof-step-first fixed))
           (body (proof-term-at first 2))
           (selected (proof-proof-select proof body numeric))
           (completed (proof-proof-chain proof unit (list fixed selected)))
           (joined (proof-proof-chain proof joined (list completed)))
           (step (b2-tactics-tactics-solve lib goal nil nil (list equation joined) 0 nil)))
        (cons step lib)))))

(defun b2-floor-intervals-floor-theorem (lib name formula)
  (proof-with-checked-results
      ((parts (proof-list-of-length formula 3))
       (condition (cadr parts))
       (goal (caddr parts))
       (premise (proof-proof-assume (library-library-proof lib) condition t))
       (outcome (b2-floor-intervals-floor-theorem-consequent premise lib name goal)))
    (b2-tactics-tactics-implication lib condition goal outcome)))
