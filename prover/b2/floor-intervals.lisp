  (proof-with-checked-results
      ((known (b2-tactics-tactics-evidence lib (list premise))))
    (b2-floor-intervals-force-steps known lib nil)))

(defun b2-floor-intervals-modulus-theorem-prove (given lib i j floor-type negative)
  (proof-with-checked-results
      ((parts (proof-proof-conjunct (library-library-proof lib) given))
       (info (b2-floor-intervals-force-facts lib (cadr parts)))
       (ri (b2-floor-intervals-fact-step info (list *library-rationalp* i)))
       (rj (b2-floor-intervals-fact-step info (list *library-rationalp* j))))
    (b2-floor-intervals-modulus-upper lib i j ri rj (car parts) floor-type negative)))

