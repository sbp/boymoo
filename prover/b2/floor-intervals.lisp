      (proof-with-checked-results
          ((quotient (b2-quotient-interval-quotient-data lib n d nt sign dt dp))
           (lib (cdr quotient))
           (proof (library-library-proof lib))
           (low (proof-proof-rewrite proof (cadar quotient) alias '(1 1 1)))
           (high (proof-proof-rewrite proof (caddar quotient) alias '(1 1)))
           (step (b2-floor-intervals-floor-interval-collect
                  low high (list unit-test sign) lib expression goal)))
        (cons step lib))
    (let ((z (library-minus n)))
      (proof-with-checked-results
          ((proof (library-library-proof lib))
           (rat-z (b2-scaling-rational-op lib "unary--" z (list rn)))
           (opposite (b2-scaling-opposite-sign lib n rn))
           (back (proof-proof-symmetric proof opposite))
           (positive-z (proof-proof-rewrite proof sign back '(1)))
           (positive-z (proof-proof-tidy proof positive-z))
           (natural-z (b2-scaling-positive-is-nonnegative lib z positive-z rat-z))
           (typed-z (library-library-type-of lib z (list nt)))
           (quotient (b2-quotient-interval-quotient-data lib z d typed-z natural-z dt dp))
           (lib (cdr quotient))
           (p-int (caar quotient))
           (p-literal (proof-step-first p-int))
           (p (proof-term-at p-literal 1))
           (rp (library-library-rational lib p (list p-int)))
           (negative-ratio (library-minus ratio))
           (rat-mirror (b2-scaling-rational-op lib "unary--" negative-ratio (list rat-ratio)))
           (negative-first (b2-fraction-reduction-negative-first
                            lib n (list *b2-products-recip* d)))
           (lib (cdr negative-first))
           (proof (library-library-proof lib))
           (identity (proof-proof-rewrite proof (car negative-first) alias '(1 2 1)))
           (identity (proof-proof-tidy proof identity))
           (lower (proof-proof-rewrite proof (cadar quotient) identity '(1 1 1)))
           (lower (proof-proof-tidy proof lower))
           (upper (proof-proof-rewrite proof (caddar quotient) identity '(1 1)))
           (upper (proof-proof-tidy proof upper))
           (ratio-number (b2-scaling-number-of-rational lib ratio rat-ratio))
           (double-ratio (b2-fraction-reduction-twice-negated lib ratio ratio-number))
           (integer-test (library-integer negative-ratio))
           (is-integer (proof-proof-assume proof integer-test t))
           (integer-ratio (library-library-type-of lib (library-minus negative-ratio)
                                                  (list is-integer)))
           (integer-ratio (proof-proof-rewrite proof integer-ratio double-ratio '(1 1)))
           (integer-ratio (proof-proof-tidy proof integer-ratio))
           (denominator-one (b2-products-integer-denominator lib ratio integer-ratio))
           (lib (cdr denominator-one))
           (proof (library-library-proof lib))
           (test (proof-eq p negative-ratio))
           (same (proof-proof-assume proof test t))
           (typed-if-equal (proof-proof-rewrite proof p-int same '(1 1)))
           (typed-if-equal (proof-proof-tidy proof typed-if-equal))
           (not-integral (proof-proof-cut proof (car denominator-one) unit-test))
           (not-integral (proof-proof-front proof not-integral (proof-neg integer-test)))
           (distinct (proof-proof-cut proof typed-if-equal not-integral))
           (distinct (proof-proof-front proof distinct (proof-neg test)))
           (strict-lower (b2-rational-order-strict-from-weak lib lower distinct rp rat-mirror))
           (reverse (b2-rational-order-reverse-negations lib (library-plus *proof-one* p)
                                                       negative-ratio))
           (turned (proof-proof-transport proof upper reverse))
           (turned (proof-proof-rewrite proof turned double-ratio '(1 2)))
           (turned (proof-proof-tidy proof turned))
           (np (library-minus p))
           (floor-value (library-plus np *proof-neg-one*))
           (negated-sum (library-library-axiom lib "DISTRIBUTIVITY-OF-MINUS-OVER-+"
                                              (list *proof-one* p)))
           (negative-one (proof-proof-compute proof (library-minus *proof-one*) -1))
           (negated-sum (proof-proof-rewrite proof negated-sum negative-one '(1 2 1)))
           (exchange (library-library-axiom lib "COMMUTATIVITY-OF-+" (list *proof-neg-one* np)))
           (negated-sum (proof-proof-chain proof negated-sum (list exchange)))
           (below (proof-proof-rewrite proof turned negated-sum '(1 1)))
           (below (proof-proof-tidy proof below))
           (rat-floor (library-library-rational lib floor-value (list p-int)))
           (weak (b2-rational-order-weak-from-strict lib below rat-floor rat-ratio))
           (reverse (b2-rational-order-reverse-negations lib negative-ratio p))
           (strict (proof-proof-transport proof strict-lower reverse))
           (strict (proof-proof-rewrite proof strict double-ratio '(1 1)))
           (strict (proof-proof-tidy proof strict))
           (successor (b2-tactics-tactics-linear-equal
                       lib (library-plus *proof-one* floor-value) np (list p-int)))
           (strict (library-library-transport-argument lib strict successor 2))
           (step (b2-floor-intervals-floor-interval-collect
