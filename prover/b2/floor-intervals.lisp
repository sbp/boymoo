(defun b2-floor-intervals-force-steps (known lib facts)
  (if (endp known)
      facts
    (let* ((proof (library-library-proof lib))
           (given (cdar known)))
      (proof-with-checked-results
          ((literal (proof-step-first given))
           (head (proof-term-at literal 0)))
        (if (not (equal head (proof-sym "FORCE" "ACL2")))
            (b2-floor-intervals-force-steps (cdr known) lib facts)
          (proof-with-checked-results
              ((opened (proof-proof-unfold proof literal))
               (step (proof-proof-rewrite proof given opened '(1)))
               (step (proof-proof-tidy proof step))
               (literal (proof-step-first step)))
            (b2-floor-intervals-force-steps (cdr known) lib
                                             (table-put facts literal step))))))))

