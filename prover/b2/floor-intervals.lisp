         (product-position (if negative 1 2)))
    (proof-with-checked-results
        ((bounds (b2-floor-intervals-floor-interval lib i j ri rj))
         (lib (cdr bounds))
         (reciprocal (b2-scaling-rational-op lib "unary-/" (caddr ratio) (list rj)))
         (ratio-type (b2-scaling-rational-op lib "binary-*" ratio (list ri reciprocal)))
         (next-type (library-library-rational lib next-q (list floor-type)))
