(defun b2-floor-intervals-floor-interval-denominator
    (unit-test unit lib n d nt dt dp rn ratio rat-ratio alias expression goal)
  (let ((proof (library-library-proof lib)))
    (if unit
        (proof-with-checked-results
            ((same (proof-proof-rewrite proof alias unit-test '(1 1 2 1)))
             (commute (library-library-axiom lib "COMMUTATIVITY-OF-*" (list n *proof-one*)))
             (numeric (library-library-number lib n (list nt)))
             (unit (b2-products-multiplicative-unit lib n numeric))
             (rule (proof-proof-chain proof commute (list unit)))
             (literal (proof-step-first same))
             (left (proof-term-at literal 1))
             (reduced (b2-tactics-tactics-normalize lib left nil nil (list rule) 1500 nil))
             (eq-ratio (proof-proof-rewrite proof same reduced '(1 1)))
             (eq-ratio (proof-proof-tidy proof eq-ratio))
             (low (library-library-cite lib "WEAK-REFLEXIVE" (list n) (list nt)))
             (high (library-library-cite lib "SUCCESSOR-LARGER" (list n) (list nt)))
             (low (proof-proof-rewrite proof low eq-ratio '(1 1 1)))
             (high (proof-proof-rewrite proof high eq-ratio '(1 1)))
             (step (b2-floor-intervals-floor-interval-collect
                    low high (list unit-test) lib expression goal)))
          (cons step lib))
      (let ((test (library-lt n *proof-zero*)))
        (proof-with-checked-results
            ((yes (proof-proof-assume proof test t))
             (negative (b2-floor-intervals-floor-interval-numerator
                        yes t lib unit-test n d nt dt dp rn ratio rat-ratio alias expression goal))
             (lib (cdr negative))
             (no (proof-proof-assume (library-library-proof lib) test nil))
             (nonnegative (b2-floor-intervals-floor-interval-numerator
                           no nil lib unit-test n d nt dt dp rn ratio rat-ratio alias expression goal))
             (lib (cdr nonnegative))
             (step (b2-floor-intervals-cases lib test (list (car negative) (car nonnegative)))))
          (cons step lib))))))

(defun b2-floor-intervals-floor-interval-consequent (premise lib expression ratio goal)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((types (proof-proof-conjunct proof premise))
         (reciprocal (b2-scaling-rational-op lib "unary-/" (caddr ratio) (list (cadr types))))
         (rat-ratio (b2-scaling-rational-op lib "binary-*" ratio (list (car types) reciprocal)))
         (d (list *b2-products-den* ratio))
         (n (list *b2-products-num* ratio))
         (factors (b2-products-rational-factors lib ratio rat-ratio))
         (rn (library-library-rational lib n (list (cadr factors))))
         (representation (library-library-axiom lib "RATIONAL-IMPLIES2" (list ratio)))
         (representation (proof-proof-modus-ponens proof representation rat-ratio))
         (commuted (library-library-axiom lib "COMMUTATIVITY-OF-*"
                                          (list n (list *b2-products-recip* d))))
         (alias (proof-proof-chain proof commuted (list representation)))
         (test (proof-eq d *proof-one*))
         (yes (proof-proof-assume proof test t))
         (unit (b2-floor-intervals-floor-interval-denominator
                yes t lib n d (cadr factors) (car factors) (caddr factors)
                rn ratio rat-ratio alias expression goal))
         (lib (cdr unit))
         (no (proof-proof-assume (library-library-proof lib) test nil))
         (nonunit (b2-floor-intervals-floor-interval-denominator
                   no nil lib n d (cadr factors) (car factors) (caddr factors)
                   rn ratio rat-ratio alias expression goal))
         (lib (cdr nonunit))
         (step (b2-floor-intervals-cases lib test (list (car unit) (car nonunit)))))
      (cons step lib))))

(defun b2-floor-intervals-install-floor-interval (lib)
  (let* ((x *library-x*)
         (y *library-y*)
         (expression (list *b2-floor-intervals-floor* x y))
         (ratio (b2-products-product x (list *b2-products-recip* y))))
    (proof-with-checked-results
        ((condition (b2-powers-and-terms
                     (list (list *library-rationalp* x) (list *library-rationalp* y))))
         (goal (b2-powers-and-terms
                (list (proof-neg (library-lt ratio expression))
                      (library-lt ratio (library-plus *proof-one* expression)))))
         (premise (proof-proof-assume (library-library-proof lib) condition t))
         (outcome (b2-floor-intervals-floor-interval-consequent premise lib expression ratio goal))
         (proved (b2-tactics-tactics-implication lib condition goal outcome))
         (added (b2-tactics-tactics-add-lemma (cdr proved) "FLOOR-INTERVAL" (car proved) :none)))
      (cdr added))))

(defun b2-floor-intervals-floor-interval (lib i j rational-i rational-j)
  (let ((name (proof-sym "B2-FLOOR-INTERVAL" "ACL2")))
    (proof-with-checked-results
        ((lib (if (assoc-equal name (proof-proof-facts (library-library-proof lib)))
                  lib
                (b2-floor-intervals-install-floor-interval lib)))
         (proof (library-library-proof lib))
         (step (proof-proof-fact proof name (list (list *library-x* i) (list *library-y* j))))
         (literal (proof-step-first step))
         (condition (proof-term-at literal 1))
         (known (b2-tactics-tactics-solve lib condition (list rational-i rational-j) nil nil 0 nil))
         (result (proof-proof-modus-ponens proof step known))
         (bounds (proof-proof-conjunct proof result)))
      (cons bounds lib))))

