(in-package "BOYMOO-PROVER")
(set-verify-guards-eagerness 0)

(defconst *b2-fraction-reduction-common* (proof-sym "B2-COMMON-DENOMINATORS" "ACL2"))

(defun b2-fraction-reduction-triple (a b c)
  (list *proof-cons* a (list *proof-cons* b (list *proof-cons* c *proof-false*))))

(defun b2-fraction-reduction-sum-unit (lib value number)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((axiom (library-library-axiom lib "UNICITY-OF-0" (list value)))
         (fixed (proof-proof-unfold proof (list *b2-products-fix* value)))
         (first (proof-step-first fixed))
         (branch (proof-term-at first 2))
         (branch (proof-proof-select proof branch number)))
      (proof-proof-chain proof axiom (list fixed branch)))))

(defun b2-fraction-reduction-negative-factor-lemma (lib)
  (let* ((proof (library-library-proof lib))
         (x *library-x*)
         (y *library-y*)
         (minus-y (library-minus y))
         (p (b2-products-product x y))
         (q (b2-products-product x minus-y))
         (minus-p (library-minus p)))
    (proof-with-checked-results
        ((distributivity (library-library-axiom lib "DISTRIBUTIVITY" (list x y minus-y)))
         (inverse-y (library-library-axiom lib "INVERSE-OF-+" (list y)))
         (left (proof-proof-rewrite proof distributivity inverse-y '(1 1 2)))
         (left (proof-proof-symmetric proof left))
         (zero-product (b2-products-zero-product lib x))
         (lib (cdr zero-product))
         (proof (library-library-proof lib))
         (zero-sum (proof-proof-chain proof left (list (car zero-product))))
         (number (b2-products-numeric-closure lib minus-p))
         (equation (b2-fraction-reduction-sum-unit lib minus-p number))
         (swap (library-library-axiom lib "COMMUTATIVITY-OF-+" (list *proof-zero* minus-p)))
         (equation (proof-proof-rewrite proof equation swap '(1 1)))
         (zero-sum (proof-proof-symmetric proof zero-sum))
         (equation (proof-proof-rewrite proof equation zero-sum '(1 1 2)))
         (assoc (library-library-axiom lib "ASSOCIATIVITY-OF-+" (list minus-p p q)))
         (assoc (proof-proof-symmetric proof assoc))
         (equation (proof-proof-rewrite proof equation assoc '(1 1)))
         (swap (library-library-axiom lib "COMMUTATIVITY-OF-+" (list minus-p p)))
         (inverse-p (library-library-axiom lib "INVERSE-OF-+" (list p)))
         (reverse (proof-proof-chain proof swap (list inverse-p)))
         (equation (proof-proof-rewrite proof equation reverse '(1 1 1)))
         (number (b2-products-numeric-closure lib q))
         (unit (b2-fraction-reduction-sum-unit lib q number))
         (equation (proof-proof-rewrite proof equation unit '(1 1)))
         (equation (proof-proof-tidy proof equation)))
      (b2-tactics-tactics-add-lemma lib "PRODUCT-NEGATIVE" equation :none))))

(defun b2-fraction-reduction-negative-factor (lib a b)
  (let* ((label (proof-sym "B2-PRODUCT-NEGATIVE" "ACL2"))
         (proof (library-library-proof lib)))
    (proof-with-checked-results
        ((lib (if (assoc-equal label (proof-proof-facts proof))
                  lib
                (proof-with-checked-results
                    ((added (b2-fraction-reduction-negative-factor-lemma lib)))
                  (cdr added))))
         (step (proof-proof-fact (library-library-proof lib) label
                                 (list (list *library-x* a) (list *library-y* b)))))
      (cons step lib))))

(defun b2-fraction-reduction-negative-first (lib a b)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((commute (proof-proof-reflexive proof (library-minus (b2-products-product b a))))
         (swap (library-library-axiom lib "COMMUTATIVITY-OF-*" (list b a)))
         (commute (proof-proof-rewrite proof commute swap '(1 2 1)))
         (initial (library-library-axiom lib "COMMUTATIVITY-OF-*" (list (library-minus a) b)))
         (negative (b2-fraction-reduction-negative-factor lib b a))
         (lib (cdr negative))
         (step (proof-proof-chain (library-library-proof lib) initial (list (car negative) commute))))
      (cons step lib))))

(defun b2-fraction-reduction-twice-negated (lib term typed)
  (let* ((proof (library-library-proof lib))
         (m (library-minus term))
         (n (library-minus m)))
    (proof-with-checked-results
        ((unit (if typed
                   (b2-fraction-reduction-sum-unit lib term typed)
                 (library-library-axiom lib "UNICITY-OF-0" (list term))))
         (inverse-m (library-library-axiom lib "INVERSE-OF-+" (list m)))
         (inverse-m (proof-proof-symmetric proof inverse-m))
         (unit (proof-proof-rewrite proof unit inverse-m '(1 1 1)))
         (step (proof-proof-symmetric proof unit))
         (assoc (library-library-axiom lib "ASSOCIATIVITY-OF-+" (list m n term)))
         (step (proof-proof-chain proof step (list assoc)))
         (swap (library-library-axiom lib "COMMUTATIVITY-OF-+" (list n term)))
         (step (proof-proof-rewrite proof step swap '(1 2 2)))
         (assoc (library-library-axiom lib "ASSOCIATIVITY-OF-+" (list m term n)))
         (assoc (proof-proof-symmetric proof assoc))
         (step (proof-proof-rewrite proof step assoc '(1 2)))
         (swap (library-library-axiom lib "COMMUTATIVITY-OF-+" (list m term)))
         (inverse (library-library-axiom lib "INVERSE-OF-+" (list term)))
         (opposite (proof-proof-chain proof swap (list inverse)))
         (step (proof-proof-rewrite proof step opposite '(1 2 1)))
         (number (b2-products-numeric-closure lib n))
         (unit (b2-fraction-reduction-sum-unit lib n number))
         (step (proof-proof-chain proof step (list unit))))
      (proof-proof-symmetric proof step))))

(defun b2-fraction-reduction-positive-denominators (x y)
  (b2-powers-and-terms
   (list (library-integer x) (library-positive x)
         (library-integer y) (library-positive y))))

(defun b2-fraction-reduction-common-conditions (value x y)
  (b2-powers-and-terms
   (list (b2-fraction-reduction-positive-denominators x y)
         (library-integer (b2-products-product value x))
         (library-integer (b2-products-product value y)))))

(defun b2-fraction-reduction-common-properties (value x y g a b)
  (b2-powers-and-terms
   (list (library-integer g) (library-positive g)
         (library-integer a) (library-positive a)
         (library-integer b) (library-positive b)
         (proof-eq x (b2-products-product a g))
         (proof-eq y (b2-products-product b g))
         (library-integer (b2-products-product value g)))))

(defun b2-fraction-reduction-projected-properties (value x y result)
  (b2-fraction-reduction-common-properties value x y
                                           (b2-tactics-field result 0)
                                           (b2-tactics-field result 1)
                                           (b2-tactics-field result 2)))

(defun b2-fraction-reduction-difference-bounds
    (lib larger smaller positive-large positive-small compare types)
  (let ((proof (library-library-proof lib))
        (delta (library-diff larger smaller)))
    (proof-with-checked-results
        ((comparison (library-library-comparison lib smaller larger types))
         (pos (proof-proof-rewrite proof compare comparison '(1)))
         (pos (proof-proof-tidy proof pos))
         (comparison (b2-tactics-tactics-less-from-difference lib delta larger positive-small types))
         (delta-type (library-library-type-of lib delta types))
         (nat (library-library-cite lib "POSITIVE-NONNEGATIVE" (list delta)
                                     (list delta-type pos)))
         (larger-type (library-library-type-of lib larger types))
         (nat-parent (library-library-cite lib "POSITIVE-NONNEGATIVE" (list larger)
                                            (list larger-type positive-large)))
         (larger-type (library-library-type-of lib larger types))
         (larger-count (b2-powers-integer-count lib larger larger-type nat-parent))
         (delta-type (library-library-type-of lib delta types))
         (delta-count (b2-powers-integer-count lib delta delta-type nat))
         (order (library-library-transport-argument lib comparison larger-count 2))
         (order (library-library-transport-argument lib order delta-count 1)))
      (list pos order))))

(defun b2-fraction-reduction-assume-tests (proof tests)
  (if (endp tests)
      nil
    (proof-with-checked-results
        ((step (proof-proof-assume proof (caar tests) (cadar tests)))
         (rest (b2-fraction-reduction-assume-tests proof (cdr tests))))
      (cons step rest))))

(defun b2-fraction-reduction-install-common-case (lib clause call measure)
  (if (not call)
      (descent-measure-ordinal lib measure)
    (let* ((proof (library-library-proof lib))
           (x *library-x*)
           (y *library-y*))
      (proof-with-checked-results
          ((assumptions (b2-fraction-reduction-assume-tests proof (termination-call-tests call)))
           (evidence (b2-tactics-tactics-evidence lib assumptions))
           (actual (proof-term-at (termination-call-actuals call) 0))
           (first (not (equal actual x)))
           (big (if first x y))
           (small (if first y x))
           (int-x (b2-powers-evidence-step evidence (library-integer x)))
           (int-y (b2-powers-evidence-step evidence (library-integer y)))
           (positive-big (b2-powers-evidence-step evidence (library-positive big)))
           (positive-small (b2-powers-evidence-step evidence (library-positive small)))
           (compare (b2-powers-evidence-step evidence (library-lt small big)))
           (bounds (b2-fraction-reduction-difference-bounds
                    lib big small positive-big positive-small compare (list int-x int-y)))
           (shifted (descent-shift lib (cadr bounds) (list *library-count* small) (not first)))
           (literal (proof-term-at clause (max 0 (1- (len clause)))))
           (sides (proof-list-of-length (cdr literal) 2))
           (ordinal (library-library-ordinal-comparison lib (car sides) (cadr sides)))
           (decrease (proof-proof-transport proof shifted ordinal)))
        (proof-proof-subsume proof decrease clause)))))

(defun b2-fraction-reduction-install-common-proofs (lib cases measure)
  (if (endp cases)
      nil
    (proof-with-checked-results
        ((step (b2-fraction-reduction-install-common-case lib (caar cases) (cadar cases) measure))
         (steps (b2-fraction-reduction-install-common-proofs lib (cdr cases) measure)))
      (cons step steps))))

(defun b2-fraction-reduction-install-common (lib)
  (let* ((x *library-x*)
         (y *library-y*)
         (name *b2-fraction-reduction-common*)
         (value (proof-sym "B2-FACTORS" "ACL2"))
         (g (b2-tactics-field value 0))
         (a (b2-tactics-field value 1))
         (b (b2-tactics-field value 2))
         (lam (proof-cl "LAMBDA"))
         (next-y (list (list lam (list value)
                             (b2-fraction-reduction-triple g a (library-plus a b)))
                       (list name x (library-diff y x))))
         (next-x (list (list lam (list value)
                             (b2-fraction-reduction-triple g (library-plus a b) b))
                       (list name (library-diff x y) y)))
         (seed (b2-fraction-reduction-triple x *proof-one* *proof-one*))
         (body (proof-ite (b2-fraction-reduction-positive-denominators x y)
                          (proof-ite (library-lt x y) next-y
                                     (proof-ite (library-lt y x) next-x seed))
                          (b2-fraction-reduction-triple *proof-one* *proof-one* *proof-one*)))
         (formals (list x y))
         (definitions (list (list name formals body)))
         (measure (library-plus (list *library-count* x) (list *library-count* y))))
    (proof-with-checked-results
        ((source (proof-line "define" (cons *termination-all* definitions)))
         (lib (library-library-with-entries
               lib (append (library-library-entries lib) (list (list "define" name nil source)))))
         (calls (termination-recursive-calls *termination-all* definitions))
         (cases (termination-obligation-cases definitions (list (cons name measure)) calls))
         (proofs (b2-fraction-reduction-install-common-proofs lib cases measure))
         (entry (proof-proof-entry "measure" name (list name measure) proofs))
         (lib (library-library-with-entries lib (append (library-library-entries lib) (list entry))))
         (proof (proof-proof-add-definition (library-library-proof lib) name formals body)))
      (library-library-with-proof lib proof))))

(defun b2-fraction-reduction-integer-product-difference (lib value larger smaller evidence)
  (let ((x (b2-products-product value larger))
        (y (b2-products-product value smaller)))
    (proof-with-checked-results
        ((distribute (library-library-axiom lib "DISTRIBUTIVITY"
                                            (list value larger (library-minus smaller))))
         (negative (b2-fraction-reduction-negative-factor lib value smaller))
         (lib (cdr negative))
         (equation (proof-proof-rewrite (library-library-proof lib) distribute
                                        (car negative) '(1 2 2)))
         (typed (library-library-type-of lib (library-diff x y) evidence))
         (step (library-library-transport-argument lib typed equation 1)))
      (cons step lib))))

(defun b2-fraction-reduction-common-lemma-consequent-transport-result
    (branch g left right evidence lib template)
  (let ((proof (library-library-proof lib))
        (expanded (b2-fraction-reduction-common-properties
                   *library-z* *library-x* *library-y* g left right)))
    (proof-with-checked-results
        ((proposition (b2-tactics-tactics-solve lib expanded evidence nil nil 0 nil))
         (first (proof-step-first branch))
         (value (proof-term-at first 2))
         (first (b2-tactics-tactics-normalize lib (b2-tactics-field value 0)
                                             nil nil nil 1500 nil))
         (second (b2-tactics-tactics-normalize lib (b2-tactics-field value 1)
                                              nil nil nil 1500 nil))
         (third (b2-tactics-tactics-normalize lib (b2-tactics-field value 2)
                                             nil nil nil 1500 nil))
         (goal (proof-subst template (list (cons *proof-result* value))))
         (equality (b2-sorting-apply-equations lib goal (list first second third)))
         (proposition (proof-proof-transport proof proposition equality))
         (reverse (proof-proof-symmetric proof branch)))
      (proof-proof-rewrite-result proof proposition reverse template *proof-result*))))

(defun b2-fraction-reduction-compose-factor (lib composition conclusions position term factor g)
  (let ((proof (library-library-proof lib))
        (place (list 1 2 position)))
    (proof-with-checked-results
        ((equation (b2-powers-evidence-step conclusions (proof-eq term (b2-products-product factor g))))
         (composition (proof-proof-rewrite proof composition equation place))
         (commute (library-library-axiom lib "COMMUTATIVITY-OF-*" (list factor g))))
      (proof-proof-rewrite proof composition commute place))))

(defun b2-fraction-reduction-common-lemma-consequent-descend
    (direction comparison tests lib directions given types formula measure prior call template)
  (let* ((proof (library-library-proof lib))
         (x *library-x*)
         (y *library-y*)
         (z *library-z*)
         (first-direction (equal direction 0))
         (big (if first-direction y x))
         (small (if first-direction x y))
         (binding (nth direction directions))
         (child (cadar binding)))
    (proof-with-checked-results
        ((big-pos (b2-powers-evidence-step given (library-positive big)))
         (small-pos (b2-powers-evidence-step given (library-positive small)))
         (bounds (b2-fraction-reduction-difference-bounds lib big small big-pos small-pos
                                                          comparison types))
         (strict (descent-shift lib (cadr bounds) (list *library-count* small) first-direction))
         (first (proof-step-first strict))
         (sides (proof-list-of-length (cdr first) 2))
         (ordinal (library-library-ordinal-comparison lib (car sides) (cadr sides)))
         (ordinal (proof-proof-transport proof strict ordinal))
         (hypothesis (b2-tactics-tactics-induction-hypothesis lib formula measure binding ordinal))
         (integer-product (b2-fraction-reduction-integer-product-difference lib z big small prior))
         (lib (cdr integer-product))
         (proof (library-library-proof lib))
         (first (proof-step-first hypothesis))
         (condition (proof-term-at first 1))
         (child-type (library-library-type-of lib child types))
         (child-conditions
          (b2-tactics-tactics-solve lib condition
                                   (append prior (list child-type (car bounds) (car integer-product)))
                                   nil nil 0 nil))
         (conclusions (proof-proof-modus-ponens proof hypothesis child-conditions))
         (conclusions (b2-tactics-tactics-evidence lib (list conclusions)))
         (a (if first-direction x child))
         (b (if first-direction child y))
         (result (list *b2-fraction-reduction-common* a b))
         (g (b2-tactics-field result 0))
         (left (b2-tactics-field result 1))
         (right (b2-tactics-field result 2))
         (smaller-factor (if first-direction left right))
         (larger-factor (if first-direction right left))
         (left-type (b2-powers-evidence-step conclusions (library-integer left)))
         (right-type (b2-powers-evidence-step conclusions (library-integer right)))
         (g-type (b2-powers-evidence-step conclusions (library-integer g)))
         (factor-types (list left-type right-type g-type))
         (new-factor (library-plus left right))
         (composition (b2-powers-linear-equal lib big (library-plus child small) types))
         (composition (b2-fraction-reduction-compose-factor lib composition conclusions
                                                            1 child larger-factor g))
         (composition (b2-fraction-reduction-compose-factor lib composition conclusions
                                                            2 small smaller-factor g))
         (composition (if first-direction
                          (proof-with-checked-results
                              ((swapped (library-library-axiom
                                         lib "COMMUTATIVITY-OF-+"
                                         (list (b2-products-product g right)
                                               (b2-products-product g left)))))
                            (proof-proof-chain proof composition (list swapped)))
                        composition))
         (combine (library-library-axiom lib "DISTRIBUTIVITY" (list g left right)))
         (combine (proof-proof-symmetric proof combine))
         (swap (library-library-axiom lib "COMMUTATIVITY-OF-*" (list g new-factor)))
         (composition (proof-proof-chain proof composition (list combine swap)))
         (left-pos (b2-powers-evidence-step conclusions (library-positive left)))
         (right-pos (b2-powers-evidence-step conclusions (library-positive right)))
         (pos-sum (library-library-cite lib "POSITIVE-SUM" (list left right)
                                       (list left-pos right-pos)))
         (factor-type (library-library-type-of lib new-factor factor-types))
         (evidence (append (table-values conclusions) (list factor-type pos-sum composition)))
         (branch (b2-tactics-tactics-normalize lib call (append prior tests)
                                              (list call) nil 1500 nil))
         (step (b2-fraction-reduction-common-lemma-consequent-transport-result
                branch g (if first-direction left new-factor)
                (if first-direction new-factor right) evidence lib template)))
      (cons step lib))))

(defun b2-fraction-reduction-common-lemma-consequent
    (premise lib small-x small-y directions formula measure call template)
  (let* ((proof (library-library-proof lib))
         (x *library-x*)
         (y *library-y*))
    (proof-with-checked-results
        ((given (b2-tactics-tactics-evidence lib (list premise)))
         (int-x (b2-powers-evidence-step given (library-integer x)))
         (int-y (b2-powers-evidence-step given (library-integer y)))
         (types (list int-x int-y))
         (prior (table-values given))
         (x-smaller (proof-proof-assume proof small-x t))
         (x-not-smaller (proof-proof-assume proof small-x nil))
         (y-smaller (proof-proof-assume proof small-y t))
         (y-not-smaller (proof-proof-assume proof small-y nil))
         (lower (b2-fraction-reduction-common-lemma-consequent-descend
                 0 x-smaller (list x-smaller) lib directions given types formula measure prior call template))
         (lib (cdr lower))
         (greater (b2-fraction-reduction-common-lemma-consequent-descend
                   1 y-smaller (list x-not-smaller y-smaller)
                   lib directions given types formula measure prior call template))
         (lib (cdr greater))
         (proof (library-library-proof lib))
         (d (library-diff y x))
         (reversed (library-library-axiom lib "<-ON-OTHERS" (list y x)))
         (nonnegative (proof-proof-rewrite proof y-not-smaller reversed '(1 1)))
         (nonnegative (proof-proof-tidy proof nonnegative))
         (compare (library-library-comparison lib x y types))
         (nonpositive (proof-proof-rewrite proof x-not-smaller compare '(1 1)))
         (nonpositive (proof-proof-tidy proof nonpositive))
         (d-type (library-library-type-of lib d types))
         (zero (b2-powers-zero-from-signs lib d d-type nonnegative nonpositive))
         (equality (b2-powers-linear-equal lib y (library-plus d x) types))
         (equality (proof-proof-rewrite proof equality zero '(1 2 1)))
         (add-zero (library-library-cite lib "ADD-ZERO-LEFT" (list x) (list int-x)))
         (equality (proof-proof-chain proof equality (list add-zero)))
         (x-number (library-library-number lib x types))
         (unity (b2-products-multiplicative-unit lib x x-number))
         (unity (proof-proof-symmetric proof unity))
         (second (proof-proof-chain proof equality (list unity)))
         (root (b2-tactics-tactics-normalize lib call (append prior (list x-not-smaller y-not-smaller))
                                            (list call) nil 1500 nil))
         (one-type (library-library-type-of lib *proof-one* nil))
         (one-pos (b2-tactics-tactics-solve lib (library-positive *proof-one*) nil nil nil 0 nil))
         (same (b2-fraction-reduction-common-lemma-consequent-transport-result
                root x *proof-one* *proof-one*
                (append prior (list one-type one-pos unity second)) lib template))
         (cases (proof-proof-cases proof small-y (car greater) same))
         (cases (proof-proof-cases proof small-x (car lower) cases)))
      (cons cases lib))))

(defun b2-fraction-reduction-common-lemma (lib)
  (let* ((proof (library-library-proof lib))
         (label (proof-sym "B2-COMMON-REPRESENTATION" "ACL2")))
    (if (assoc-equal label (proof-proof-facts proof))
        (cons label lib)
      (proof-with-checked-results ((lib (b2-fraction-reduction-install-common lib)))
        (let* ((x *library-x*)
               (y *library-y*)
               (z *library-z*)
               (call (list *b2-fraction-reduction-common* x y))
               (measure (library-plus (list *library-count* x) (list *library-count* y)))
               (conditions (b2-fraction-reduction-common-conditions z x y))
               (goal (b2-fraction-reduction-projected-properties z x y call))
               (template (b2-fraction-reduction-projected-properties z x y *proof-result*))
               (formula (list *library-implies* conditions goal))
               (small-x (library-lt x y))
               (small-y (library-lt y x))
               (directions (list (list (list y (library-diff y x)))
                                 (list (list x (library-diff x y))))))
          (proof-with-checked-results
              ((pending (b2-tactics-tactics-implication lib conditions goal nil))
               (request (car pending))
               (reply (b2-fraction-reduction-common-lemma-consequent
                       (cadddr request) (caddr request)
                       small-x small-y directions formula measure call template))
               (case (b2-tactics-tactics-implication lib conditions goal reply))
               (lib (cdr case))
               (ordinal (descent-measure-ordinal lib measure))
               (step (proof-proof-induct (library-library-proof lib) ordinal (car case)
                                         formula measure directions)))
            (b2-tactics-tactics-add-lemma lib "COMMON-REPRESENTATION" step :none)))))))

(defun b2-fraction-reduction-reduces-to-unit
    (lib value rational represented denominator factor unit evidence)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((represented (proof-proof-symmetric proof represented))
         (numerator (proof-proof-rewrite proof represented denominator '(1 2 2)))
         (swap (b2-products-product-swap lib value factor unit))
         (numerator (proof-proof-chain proof numerator (list swap)))
         (claim (proof-proof-fact
                 proof (proof-sym "LOWEST-TERMS" "ACL2")
                 (list (list *library-x* value)
                       (list (proof-sym "N" "ACL2") factor)
                       (list (proof-sym "R" "ACL2") (b2-products-product value unit))
                       (list (proof-sym "Q" "ACL2") unit))))
         (first (proof-step-first claim))
         (premise (proof-term-at first 1))
         (premise (b2-tactics-tactics-solve lib premise
                                           (append evidence (list rational numerator denominator))
                                           nil nil 0 nil)))
      (proof-proof-modus-ponens proof claim premise))))

(defun b2-fraction-reduction-negated-fraction (lib value rational want-denominator)
  (let* ((inverse (library-minus value))
         (d1 (list *b2-products-den* value))
         (d2 (list *b2-products-den* inverse))
         (v1 (b2-products-product value d1))
         (v2 (b2-products-product value d2))
         (args (list *b2-fraction-reduction-common* d1 d2)))
    (declare (ignore v1))
    (proof-with-checked-results
        ((inverse-rational
          (b2-tactics-tactics-use-fact lib '("str" "rationalp-unary--")
                                       (list *library-rationalp* inverse) (list rational)
                                       nil nil 0 nil))
         (factors1 (b2-products-rational-factors lib value rational))
         (factors2 (b2-products-rational-factors lib inverse inverse-rational))
         (rep1 (b2-products-rational-product lib value rational))
         (lib (cdr rep1))
         (rep1 (car rep1))
         (rep2 (b2-products-rational-product lib inverse inverse-rational))
         (lib (cdr rep2))
         (rep2 (car rep2))
         (v1-type (library-library-transport-argument lib (cadr factors1) rep1 1))
         (negative (b2-fraction-reduction-negative-first lib value d2))
         (lib (cdr negative))
         (proof (library-library-proof lib))
         (reverse (proof-proof-symmetric proof (car negative)))
         (minus-product (proof-proof-chain proof reverse (list rep2)))
         (same (proof-proof-reflexive proof (library-minus (library-minus v2))))
         (same (proof-proof-rewrite proof same minus-product '(1 2 1)))
         (v2-number (b2-products-numeric-closure lib v2))
         (twice (b2-fraction-reduction-twice-negated lib v2 v2-number))
         (twice (proof-proof-symmetric proof twice))
         (same (proof-proof-chain proof twice (list same)))
         (first (proof-step-first same))
         (subterm (proof-term-at first 2))
         (subtype (library-library-type-of lib subterm (list (cadr factors2))))
         (v2-type (library-library-transport-argument lib subtype same 1))
         (lemma (b2-fraction-reduction-common-lemma lib))
         (lib (cdr lemma))
         (proof (library-library-proof lib))
         (instance (proof-proof-fact proof (car lemma)
                                     (list (list *library-z* value)
                                           (list *library-x* d1) (list *library-y* d2))))
         (first (proof-step-first instance))
         (precondition (proof-term-at first 1))
         (precondition
          (b2-tactics-tactics-solve lib precondition
                                   (list (car factors1) (caddr factors1)
                                         (car factors2) (caddr factors2) v1-type v2-type)
                                   nil nil 0 nil))
         (facts (proof-proof-modus-ponens proof instance precondition))
         (facts (b2-tactics-tactics-evidence lib (list facts)))
         (g (b2-tactics-field args 0))
         (a (b2-tactics-field args 1))
         (b (b2-tactics-field args 2))
         (int-g (b2-powers-evidence-step facts (library-integer g)))
         (d1-eq (b2-powers-evidence-step facts (proof-eq d1 (b2-products-product a g))))
         (d2-eq (b2-powers-evidence-step facts (proof-eq d2 (b2-products-product b g))))
         (type-g (b2-powers-evidence-step facts (library-integer (b2-products-product value g))))
         (int-a (b2-powers-evidence-step facts (library-integer a)))
         (pos-a (b2-powers-evidence-step facts (library-positive a)))
         (old (b2-fraction-reduction-reduces-to-unit
               lib value rational rep1 d1-eq a g (list int-a pos-a int-g type-g)))
         (inverse-eq (b2-fraction-reduction-negative-first lib value g))
         (lib (cdr inverse-eq))
         (inverse-eq (car inverse-eq))
         (proof (library-library-proof lib))
         (first (proof-step-first inverse-eq))
         (subterm (proof-term-at first 2))
         (subtype (library-library-type-of lib subterm (list type-g)))
         (inverse-type (library-library-transport-argument lib subtype inverse-eq 1))
         (int-b (b2-powers-evidence-step facts (library-integer b)))
         (pos-b (b2-powers-evidence-step facts (library-positive b)))
         (new (b2-fraction-reduction-reduces-to-unit
               lib inverse inverse-rational rep2 d2-eq b g (list int-b pos-b int-g inverse-type)))
         (number (library-library-number lib g (list int-g)))
         (unit-g (b2-products-multiplicative-unit lib g number))
         (first (proof-proof-rewrite proof d1-eq old '(1 2 1)))
         (first (proof-proof-chain proof first (list unit-g)))
         (second (proof-proof-rewrite proof d2-eq new '(1 2 1)))
         (second (proof-proof-chain proof second (list unit-g)))
         (first (proof-proof-symmetric proof first))
         (denom (proof-proof-chain proof second (list first))))
      (if want-denominator
          (cons denom lib)
        (proof-with-checked-results
            ((opened (proof-proof-symmetric proof rep2))
             (opened (proof-proof-rewrite proof opened denom '(1 2 2)))
             (negative (b2-fraction-reduction-negative-first lib value d1))
             (lib (cdr negative))
             (proof (library-library-proof lib))
             (opened (proof-proof-chain proof opened (list (car negative))))
             (opened (proof-proof-rewrite proof opened rep1 '(1 2 1)))
             (step (proof-proof-tidy proof opened)))
          (cons step lib))))))

(defun b2-fraction-reduction-fraction-minus-denominator (lib test goal)
  (proof-with-checked-results
      ((pending (b2-tactics-tactics-implication lib test goal nil))
       (request (car pending))
       (value (proof-term-at test 1))
       (reply (b2-fraction-reduction-negated-fraction (caddr request) value (cadddr request) t)))
    (b2-tactics-tactics-implication lib test goal reply)))

(defun b2-fraction-reduction-fraction-minus-numerator (lib formula left)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((parts (proof-list-of-length left 2))
         (inverse (proof-list-of-length (cadr parts) 2))
         (value (cadr inverse))
         (recognizer (list *library-rationalp* value))
         (rational (proof-proof-assume proof recognizer t))
         (nonrational (proof-proof-assume proof recognizer nil))
         (exact (b2-fraction-reduction-negated-fraction lib value rational nil))
         (lib (cdr exact))
         (proof (library-library-proof lib))
         (test (list *library-numberp* value))
         (number (proof-proof-assume proof test t))
         (other (proof-proof-assume proof test nil))
         (reflected (library-minus value))
         (reflects (list *library-rationalp* reflected))
         (assumed (proof-proof-assume proof reflects t))
         (twice (b2-tactics-tactics-use-fact lib '("str" "rationalp-unary--")
                                             (list *library-rationalp* (library-minus reflected))
                                             (list assumed) nil nil 0 nil))
         (double (b2-fraction-reduction-twice-negated lib value number))
         (original (proof-proof-rewrite proof twice double '(1 1)))
         (original (proof-proof-tidy proof original))
         (not-reflected (proof-proof-cut proof original nonrational))
         (not-reflected (proof-proof-front proof not-reflected (proof-neg reflects)))
         (before (b2-products-completion-branch lib "COMPLETION-OF-NUMERATOR"
                                                value (list nonrational)))
         (after (b2-products-completion-branch lib "COMPLETION-OF-NUMERATOR"
                                               reflected (list not-reflected)))
         (numeric (b2-tactics-tactics-solve lib formula nil nil (list before after) 0 nil))
         (zero (b2-products-completion-branch lib "COMPLETION-OF-UNARY-MINUS"
                                              value (list other)))
         (not-number (b2-tactics-tactics-solve lib formula nil nil (list before zero) 0 nil))
         (steps (proof-proof-cases proof test numeric not-number))
         (step (proof-proof-cases proof recognizer (car exact) steps)))
      (cons step lib))))

(defun b2-fraction-reduction-fraction-minus (lib name formula)
  (proof-with-checked-results ((parts (proof-list-of-length formula 3)))
    (if (equal name (proof-sym "DENOMINATOR-MINUS" "ACL2"))
        (b2-fraction-reduction-fraction-minus-denominator lib (cadr parts) (caddr parts))
      (b2-fraction-reduction-fraction-minus-numerator lib formula (cadr parts)))))
