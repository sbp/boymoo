(defun b2-products-numerator-denominator-consequent (typed lib name value)
  (proof-with-checked-results
   ((denom (b2-products-integer-denominator lib value typed)))
   (if (equal name "INTEGERP==>DENOMINATOR=1")
       denom
     (let ((lib (cdr denom)))
       (proof-with-checked-results
        ((rational (library-library-rational lib value (list typed)))
         (relation (b2-products-rational-product lib value rational))
         (lib (cdr relation))
         (proof (library-library-proof lib))
         (result (proof-proof-rewrite proof (car relation) (car denom) '(1 1 2)))
         (commute (library-library-axiom lib "COMMUTATIVITY-OF-*" (list value *proof-one*)))
         (numeric (library-library-number lib value (list typed)))
         (unit (b2-products-multiplicative-unit lib value numeric))
         (unit (proof-proof-chain proof commute (list unit)))
         (result (proof-proof-rewrite proof result unit '(1 1)))
         (result (proof-proof-tidy proof result))
         (step (proof-proof-symmetric proof result)))
        (cons step lib))))))

(defun b2-products-denominator-right (lib formula value)
  (let* ((proof (library-library-proof lib))
         (test (list *library-rationalp* value)))
    (proof-with-checked-results
     ((yes (proof-proof-assume proof test t))
      (no (proof-proof-assume proof test nil))
      (exact (b2-products-rational-product lib value yes))
      (lib (cdr exact))
      (proof (library-library-proof lib))
      (true-branch (b2-tactics-tactics-solve lib formula (list yes) nil (list (car exact)) 0 nil))
      (denominator (b2-products-completion-branch lib "COMPLETION-OF-DENOMINATOR" value (list no)))
      (commute (library-library-axiom lib "COMMUTATIVITY-OF-*" (list value *proof-one*)))
      (unit (library-library-axiom lib "UNICITY-OF-1" (list value)))
      (fixed (proof-proof-chain proof commute (list unit)))
      (false-branch (b2-tactics-tactics-solve lib formula (list no) nil (list denominator fixed) 0 nil))
      (step (proof-proof-cases proof test true-branch false-branch)))
     (cons step lib))))

(defun b2-products-denominator-integer (lib formula equation value)
  (let* ((proof (library-library-proof lib))
         (typed (library-integer value))
         (rational (list *library-rationalp* value)))
    (proof-with-checked-results
     ((int-yes (proof-proof-assume proof typed t))
      (int-no (proof-proof-assume proof typed nil))
      (rat-yes (proof-proof-assume proof rational t))
      (rat-no (proof-proof-assume proof rational nil))
      (exact (b2-tactics-tactics-use-fact
              lib (proof-sym "INTEGERP==>DENOMINATOR=1" "ACL2") equation
              (list int-yes) nil nil 0 nil))
      (yes (b2-tactics-tactics-solve lib formula (list int-yes) nil (list exact) 0 nil))
      (denominator (b2-products-completion-branch lib "COMPLETION-OF-DENOMINATOR" value (list rat-no)))
      (irr (b2-tactics-tactics-solve lib formula (list int-no rat-no) nil (list denominator) 0 nil))
      (d1 (proof-proof-assume proof equation t))
      (product-eq (b2-products-rational-product lib value rat-yes))
      (lib (cdr product-eq))
      (proof (library-library-proof lib))
      (product-eq (proof-proof-rewrite proof (car product-eq) d1 '(1 1 2)))
      (product-eq (proof-proof-tidy proof product-eq))
      (number (b2-tactics-tactics-use-fact
               lib '("str" "rationalp-acl2-numberp") (list *library-numberp* value)
               (list rat-yes) nil nil 0 nil))
      (commute (library-library-axiom lib "COMMUTATIVITY-OF-*" (list value *proof-one*)))
      (unit (b2-products-multiplicative-unit lib value number))
      (unity (proof-proof-chain proof commute (list unit)))
      (product-eq (proof-proof-rewrite proof product-eq unity '(1 1)))
      (product-eq (proof-proof-tidy proof product-eq))
      (factors (b2-products-rational-factors lib value rat-yes))
      (inferred (library-library-transport-argument lib (cadr factors) product-eq 1))
      (contrary (proof-proof-cut proof inferred int-no))
      (not-one (proof-proof-front proof contrary (proof-neg equation)))
      (rat-not-int (b2-tactics-tactics-solve lib formula (list int-no rat-yes not-one) nil nil 0 nil))
      (rat-case (proof-proof-cases proof rational rat-not-int irr))
      (step (proof-proof-cases proof typed yes rat-case)))
     (cons step lib))))

(defun b2-products-numerator-denominator (lib name formula)
  (proof-with-checked-results
   ((name (proof-term-at name 2))
    (fields (proof-list-of-length formula 3)))
   (let ((left (cadr fields))
         (right (caddr fields)))
     (cond
      ((member-equal name '("NUMERATOR-WHEN-INTEGERP" "INTEGERP==>DENOMINATOR=1"))
       (proof-with-checked-results
        ((value (proof-term-at left 1))
         (call (b2-tactics-tactics-implication lib left right nil))
         (outcome (b2-products-numerator-denominator-consequent
                   (cadddr (car call)) (caddr (car call)) name value)))
        (b2-tactics-tactics-implication lib left right outcome)))
      ((equal name "*-R-DENOMINATOR-R")
       (proof-with-checked-results ((value (proof-term-at left 1)))
         (b2-products-denominator-right lib formula value)))
      (t
       (proof-with-checked-results
        ((denominator (proof-term-at left 1))
         (value (proof-term-at denominator 1)))
        (b2-products-denominator-integer lib formula left value)))))))

(defun b2-products-required-evidence (term facts)
  (let ((found (assoc-equal term facts)))
    (if found
        (cdr found)
      '(:failure "tactic-rejected" ""))))

(defun b2-products-floor-reassociate-consequent (evidence lib x z reciprocal-x reciprocal-z
                                                         divisor candidate quotient zero operation opposite)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
     ((facts (b2-tactics-tactics-evidence lib (list evidence)))
      (rx (b2-products-required-evidence (list *library-rationalp* x) facts))
      (nx (b2-tactics-tactics-use-fact
           lib '("str" "rationalp-acl2-numberp") (list *library-numberp* x) (list rx) nil nil 0 nil))
      (rz (b2-products-required-evidence (list *library-rationalp* z) facts))
      (nz (b2-tactics-tactics-use-fact
           lib '("str" "rationalp-acl2-numberp") (list *library-numberp* z) (list rz) nil nil 0 nil))
      (nonzero-x (proof-proof-assume proof zero nil))
      (nonzero-z (b2-products-required-evidence (proof-neg (proof-eq z *proof-zero*)) facts))
      (unit-z (b2-products-reciprocal-identity lib z nz nonzero-z))
      (unit-x (b2-products-reciprocal-identity lib x nx nonzero-x))
      (commute (library-library-axiom lib "COMMUTATIVITY-OF-*" (list reciprocal-x x)))
      (unit-x (proof-proof-chain proof commute (list unit-x)))
      (numeric-z (b2-products-numeric-closure lib reciprocal-z))
      (cancel (b2-products-distribute-cancel lib reciprocal-x x reciprocal-z unit-x numeric-z))
      (multiplied (library-library-axiom lib "ASSOCIATIVITY-OF-*" (list z reciprocal-x candidate)))
      (multiplied (proof-proof-rewrite proof multiplied cancel '(1 2 2)))
      (multiplied (proof-proof-tidy proof multiplied))
      (multiplied (proof-proof-chain proof multiplied (list unit-z)))
      (zero-candidate (b2-products-zero-left-product lib candidate))
      (lib (cdr zero-candidate))
      (proof (library-library-proof lib))
      (divisor-nonzero (b2-tactics-tactics-from-impossible
                        lib (proof-neg (proof-eq divisor *proof-zero*)) multiplied
                        nil nil (list (car zero-candidate)) 1500 nil))
      (numeric-divisor (b2-products-numeric-closure lib divisor))
      (inverse (b2-products-inverse-from-product lib multiplied numeric-divisor divisor-nonzero))
      (y (caddr (cadr operation)))
      (associate (library-library-axiom lib "ASSOCIATIVITY-OF-*" (list x y reciprocal-z)))
      (swapped (b2-products-product-swap lib x y reciprocal-z))
      (associate (proof-proof-chain proof associate (list swapped)))
      (yes (proof-proof-rewrite proof associate inverse '(1 2 2)))
      (yes (proof-proof-tidy proof yes))
      (zero-test (proof-proof-assume proof zero t))
      (zero-y (b2-products-zero-left-product lib y))
      (zero-reciprocal (b2-products-zero-left-product (cdr zero-y) reciprocal-z))
      (z-zero (b2-products-zero-product (cdr zero-reciprocal) z))
      (y-zero (b2-products-zero-product (cdr z-zero) y))
      (lib (cdr y-zero))
      (proof (library-library-proof lib))
      (no (b2-tactics-tactics-solve lib quotient (list zero-test) nil
                                    (list (car zero-y) (car zero-reciprocal) (car z-zero) (car y-zero))
                                    0 nil))
      (equation (proof-proof-cases proof zero no yes))
      (first (proof-proof-unfold proof operation))
      (last (proof-proof-unfold proof opposite))
      (first (proof-proof-rewrite proof first equation '(1 2 1)))
      (first (proof-proof-tidy proof first))
      (last (proof-proof-symmetric proof last))
      (step (proof-proof-chain proof first (list last))))
     (cons step lib))))

(defun b2-products-floor-reassociate (lib formula)
  (proof-with-checked-results
   ((claim (proof-list-of-length formula 3))
    (goal (proof-list-of-length (caddr claim) 3))
    (operation (proof-list-of-length (cadr goal) 3))
    (outer-product (proof-list-of-length (cadr operation) 3)))
   (let* ((x (cadr outer-product))
          (y (caddr outer-product))
          (z (caddr operation))
          (reciprocal-x (list *b2-products-recip* x))
          (reciprocal-z (list *b2-products-recip* z))
          (divisor (b2-products-product z reciprocal-x))
          (candidate (b2-products-product x reciprocal-z))
          (numerator (b2-products-product x y))
          (quotient (proof-eq (b2-products-product numerator reciprocal-z)
                              (b2-products-product y (list *b2-products-recip* divisor))))
          (zero (proof-eq x *proof-zero*))
          (premise (cadr claim))
          (conclusion (caddr claim)))
     (proof-with-checked-results
      ((call (b2-tactics-tactics-implication lib premise conclusion nil))
       (outcome (b2-products-floor-reassociate-consequent
                 (cadddr (car call)) (caddr (car call)) x z reciprocal-x reciprocal-z
                 divisor candidate quotient zero (cadr goal) (caddr goal))))
      (b2-tactics-tactics-implication lib premise conclusion outcome)))))
))
