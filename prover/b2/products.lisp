(in-package "BOYMOO-PROVER")
(set-verify-guards-eagerness 0)

(defmacro b2-products-declare-events ()
  '(progn

(defconst *b2-products-fix* (proof-sym "FIX" "ACL2"))
(defconst *b2-products-recip* (proof-sym "UNARY-/" "ACL2"))
(defconst *b2-products-num* (proof-cl "NUMERATOR"))
(defconst *b2-products-den* (proof-cl "DENOMINATOR"))

(defun b2-products-product (a b)
  (list *proof-times* a b))

(defun b2-products-numeric-closure (lib term)
  (let ((proof (library-library-proof lib)))
    (if (< (len term) 2)
        (if (integerp term)
            '(:failure "tactic-rejected" "")
          '(:failure "inapplicable" ""))
      (proof-with-checked-results
       ((closure (library-library-axiom
                  lib "CLOSURE" (list (cadr term) (if (cddr term) (caddr term) *proof-zero*))))
        (additive (proof-proof-conjunct proof closure))
        (multiplicative (proof-proof-conjunct proof (cadr additive)))
        (negative (proof-proof-conjunct proof (cadr multiplicative))))
       (cond ((equal (car term) *proof-plus*) (car additive))
             ((equal (car term) *proof-times*) (car multiplicative))
             ((equal (car term) *proof-minus*) (car negative))
             ((equal (car term) *b2-products-recip*) (cadr negative))
             (t '(:failure "inapplicable" "")))))))

(defun b2-products-multiplicative-unit (lib term numeric)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
     ((step (library-library-axiom lib "UNICITY-OF-1" (list term)))
      (fixed (proof-proof-unfold proof (list *b2-products-fix* term)))
      (first (proof-step-first fixed))
      (rhs (proof-term-at first 2))
      (selected (proof-proof-select proof rhs numeric)))
     (proof-proof-chain proof step (list fixed selected)))))

(defun b2-products-add-zero-product (lib)
  (let* ((proof (library-library-proof lib))
         (x *library-x*)
         (zero *proof-zero*)
         (a (b2-products-product x zero)))
    (proof-with-checked-results
     ((split (library-library-axiom lib "DISTRIBUTIVITY" (list x zero zero)))
      (sum-zero (proof-proof-compute proof (library-plus zero zero) 0))
      (split (proof-proof-rewrite proof split sum-zero '(1 1 2)))
      (inverse (library-library-axiom lib "INVERSE-OF-+" (list a)))
      (rewritten (proof-proof-rewrite proof inverse split '(1 1 1)))
      (associate (library-library-axiom lib "ASSOCIATIVITY-OF-+"
                                        (list a a (library-minus a))))
      (rewritten (proof-proof-rewrite proof rewritten associate '(1 1)))
      (rewritten (proof-proof-rewrite proof rewritten inverse '(1 1 2)))
      (commute (library-library-axiom lib "COMMUTATIVITY-OF-+" (list a zero)))
      (rewritten (proof-proof-rewrite proof rewritten commute '(1 1)))
      (identity (library-library-axiom lib "UNICITY-OF-0" (list a)))
      (rewritten (proof-proof-rewrite proof rewritten identity '(1 1)))
      (numeric (b2-products-numeric-closure lib a))
      (fixed (b2-tactics-tactics-normalize lib (list *b2-products-fix* a)
                                         (list numeric) (list *b2-products-fix*) nil 1500 nil))
      (rewritten (proof-proof-rewrite proof rewritten fixed '(1 1)))
      (rewritten (proof-proof-tidy proof rewritten))
      (added (b2-tactics-tactics-add-lemma lib "ZERO-PRODUCT" rewritten :none)))
     (cdr added))))

(defun b2-products-zero-product (lib value)
  (let* ((name (proof-sym "B2-ZERO-PRODUCT" "ACL2"))
         (proof (library-library-proof lib)))
    (proof-with-checked-results
     ((lib (if (assoc-equal name (proof-proof-facts proof))
               lib
             (b2-products-add-zero-product lib)))
      (step (proof-proof-fact (library-library-proof lib) name
                              (list (list *library-x* value)))))
     (cons step lib))))

(defun b2-products-product-completion (lib a b evidence)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
     ((equation (library-library-axiom lib "COMPLETION-OF-*" (list a b)))
      (first (proof-step-first equation))
      (rhs (proof-term-at first 2))
      (normal (b2-tactics-tactics-normalize lib rhs evidence nil nil 1500 nil)))
     (proof-proof-chain proof equation (list normal)))))

(defun b2-products-reciprocal-identity (lib value numeric nonzero)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
     ((axiom (library-library-axiom lib "INVERSE-OF-*" (list value)))
      (first (proof-step-first axiom))
      (test (proof-term-at first 1))
      (condition (b2-tactics-tactics-solve lib test (list numeric nonzero) nil nil 0 nil)))
     (proof-proof-modus-ponens proof axiom condition))))

(defun b2-products-distribute-cancel (lib a b c unit numeric-c)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
     ((associate (library-library-axiom lib "ASSOCIATIVITY-OF-*" (list a b c)))
      (step (proof-proof-symmetric proof associate))
      (stepped (proof-proof-rewrite proof step unit '(1 2 1)))
      (identity (b2-products-multiplicative-unit lib c numeric-c)))
     (proof-proof-chain proof stepped (list identity)))))

(defun b2-products-product-swap (lib a b c)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
     ((associate (library-library-axiom lib "ASSOCIATIVITY-OF-*" (list a b c)))
      (step (proof-proof-symmetric proof associate))
      (commute (library-library-axiom lib "COMMUTATIVITY-OF-*" (list a b)))
      (step (proof-proof-rewrite proof step commute '(1 2 1)))
      (associate (library-library-axiom lib "ASSOCIATIVITY-OF-*" (list b a c))))
     (proof-proof-chain proof step (list associate)))))

(defun b2-products-zero-left-product (lib value)
  (proof-with-checked-results
   ((commute (library-library-axiom lib "COMMUTATIVITY-OF-*" (list *proof-zero* value)))
    (zero (b2-products-zero-product lib value))
    (step (proof-proof-chain (library-library-proof (cdr zero)) commute (list (car zero)))))
   (cons step (cdr zero))))

(defun b2-products-inverse-from-product (lib equality numeric-a nonzero-a)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
     ((first (proof-step-first equality))
      (equation (proof-list-of-length first 3))
      (product (proof-list-of-length (cadr equation) 3)))
     (let* ((a (cadr product))
            (b (caddr product))
            (numerator (list *library-numberp* b)))
       (proof-with-checked-results
        ((not-number (proof-proof-assume proof numerator nil))
         (zero (b2-products-product-completion lib a b (list numeric-a not-number)))
         (impossible (proof-proof-rewrite proof equality zero '(1 1)))
         (false (proof-proof-compute proof (proof-eq *proof-zero* *proof-one*) *proof-nil*))
         (impossible (proof-proof-rewrite proof impossible false '(1)))
         (impossible (proof-proof-tidy proof impossible))
         (numeric-b (proof-proof-front proof impossible numerator))
         (inv (list *b2-products-recip* a))
         (right-inverse (b2-products-reciprocal-identity lib a numeric-a nonzero-a))
         (commute (library-library-axiom lib "COMMUTATIVITY-OF-*" (list inv a)))
         (left-inverse (proof-proof-chain proof commute (list right-inverse)))
         (step (b2-products-distribute-cancel lib inv a b left-inverse numeric-b))
         (step (proof-proof-rewrite proof step equality '(1 1 2)))
         (commute (library-library-axiom lib "COMMUTATIVITY-OF-*" (list inv *proof-one*)))
         (step (proof-proof-rewrite proof step commute '(1 1)))
         (numeric-inv (b2-products-numeric-closure lib inv))
         (unit (b2-products-multiplicative-unit lib inv numeric-inv))
         (step (proof-proof-rewrite proof step unit '(1 1)))
         (step (proof-proof-tidy proof step)))
        (proof-proof-symmetric proof step))))))

(defun b2-products-unique-inverse (lib formula)
  (proof-with-checked-results
   ((formula-fields (proof-list-of-length formula 3))
    (result-fields (proof-list-of-length (cadr formula-fields) 3))
    (product (proof-list-of-length (cadr result-fields) 3)))
   (let* ((proof (library-library-proof lib))
          (result (cadr formula-fields))
          (a (cadr product))
          (b (caddr product))
          (number (list *library-numberp* a)))
     (proof-with-checked-results
      ((numeric (proof-proof-assume proof number t))
       (other (proof-proof-assume proof number nil))
       (test (proof-eq a *proof-zero*))
       (zero (proof-proof-assume proof test t))
       (nonzero (proof-proof-assume proof test nil))
       (commute (library-library-axiom lib "COMMUTATIVITY-OF-*" (list *proof-zero* b)))
       (zero-right (b2-products-zero-product lib b))
       (lib (cdr zero-right))
       (proof (library-library-proof lib))
       (zero-left (proof-proof-chain proof commute (list (car zero-right))))
       (yes-zero (b2-tactics-tactics-solve lib formula (list numeric zero)
                                          (list *b2-products-fix*) (list zero-left) 0 nil))
       (completed (b2-products-product-completion lib a b (list other)))
       (no-number (b2-tactics-tactics-solve lib formula (list other)
                                           (list *b2-products-fix*) (list completed) 0 nil))
       (matches (proof-proof-assume proof result t))
       (differs (proof-proof-assume proof result nil))
       (root (b2-products-inverse-from-product lib matches numeric nonzero))
       (yes (b2-tactics-tactics-solve lib formula (list numeric nonzero matches root)
                                     (list *b2-products-fix*) nil 0 nil))
       (rhs (proof-eq b (list *b2-products-recip* a)))
       (same (proof-proof-assume proof rhs t))
       (different (proof-proof-assume proof rhs nil))
       (inverse (b2-products-reciprocal-identity lib a numeric nonzero))
       (same (proof-proof-symmetric proof same))
       (given (proof-proof-rewrite proof inverse same '(1 1 2)))
       (given (proof-proof-tidy proof given))
       (conflict (proof-proof-cut proof given differs))
       (contradicted (proof-proof-subsume proof conflict (cons formula (proof-step-clause conflict))))
       (no (b2-tactics-tactics-solve lib formula (list numeric nonzero differs different)
                                    (list *b2-products-fix*) nil 0 nil))
       (unequal-result (proof-proof-cases proof rhs contradicted no))
       (common (proof-proof-cases proof result yes unequal-result))
       (numeric-case (proof-proof-cases proof test yes-zero common))
       (step (proof-proof-cases proof number numeric-case no-number)))
      (cons step lib)))))

(defun b2-products-rational-factors (lib value rational)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
     ((axiom (library-library-axiom lib "RATIONAL-IMPLIES1" (list value)))
      (typed (proof-proof-modus-ponens proof axiom rational))
      (den-more (proof-proof-conjunct proof typed))
      (num-positive (proof-proof-conjunct proof (cadr den-more))))
     (cons (car den-more) num-positive))))

(defun b2-products-add-rational-product (lib)
  (let* ((proof (library-library-proof lib))
         (x *library-x*))
    (proof-with-checked-results
     ((rat (proof-proof-assume proof (list *library-rationalp* x) t))
      (d (list *b2-products-den* x))
      (n (list *b2-products-num* x))
      (factors (b2-products-rational-factors lib x rat))
      (zero (proof-eq d *proof-zero*))
      (not-zero (b2-tactics-tactics-from-impossible
                 lib (proof-neg zero) (caddr factors) nil nil nil 1500 nil))
      (d-numeric (library-library-number lib d (list (car factors))))
      (n-numeric (library-library-number lib n (list (cadr factors))))
      (representation (library-library-axiom lib "RATIONAL-IMPLIES2" (list x)))
      (representation (proof-proof-modus-ponens proof representation rat))
      (unit (b2-products-reciprocal-identity lib d d-numeric not-zero))
      (step (b2-products-distribute-cancel lib d (list *b2-products-recip* d) n unit n-numeric))
      (step (proof-proof-rewrite proof step representation '(1 1 2)))
      (commute (library-library-axiom lib "COMMUTATIVITY-OF-*" (list d x)))
      (step (proof-proof-rewrite proof step commute '(1 1)))
      (step (proof-proof-tidy proof step))
      (added (b2-tactics-tactics-add-lemma lib "RATIONAL-PRODUCT" step :none)))
     (cdr added))))

(defun b2-products-rational-product (lib value rational)
  (let* ((name (proof-sym "B2-RATIONAL-PRODUCT" "ACL2"))
         (proof (library-library-proof lib)))
    (proof-with-checked-results
     ((lib (if (assoc-equal name (proof-proof-facts proof))
               lib
             (b2-products-add-rational-product lib)))
      (proof (library-library-proof lib))
      (fact (proof-proof-fact proof name (list (list *library-x* value))))
      (step (proof-proof-discharge proof fact rational)))
     (cons step lib))))

(defun b2-products-integer-denominator (lib value typed)
  (let ((d (list *b2-products-den* value)))
    (proof-with-checked-results
     ((rational (library-library-rational lib value (list typed)))
      (factors (b2-products-rational-factors lib value rational))
      (represented (b2-products-rational-product lib value rational))
      (lib (cdr represented))
      (proof (library-library-proof lib))
      (commute (library-library-axiom lib "COMMUTATIVITY-OF-*" (list d value)))
      (represented (proof-proof-chain proof commute (list (car represented))))
      (numerator (proof-proof-symmetric proof represented))
      (commute (library-library-axiom lib "COMMUTATIVITY-OF-*" (list d *proof-one*)))
      (d-number (library-library-number lib d (list (car factors))))
      (unit (b2-products-multiplicative-unit lib d d-number))
      (denominator (proof-proof-chain proof commute (list unit)))
      (typed-one (library-library-type-of lib *proof-one* nil))
      (denominator (proof-proof-symmetric proof denominator))
      (conditions (list (car factors) rational typed typed-one (caddr factors) numerator denominator))
      (low (proof-proof-fact proof (proof-sym "LOWEST-TERMS" "ACL2")
                             (list (list (proof-sym "N" "ACL2") d)
                                   (list *library-x* value)
                                   (list (proof-sym "R" "ACL2") value)
                                   (list (proof-sym "Q" "ACL2") *proof-one*))))
      (first (proof-step-first low))
      (test (proof-term-at first 1))
      (condition (b2-tactics-tactics-solve lib test conditions nil nil 0 nil))
      (step (proof-proof-modus-ponens proof low condition)))
     (cons step lib))))

(defun b2-products-completion-branch (lib name value evidence)
  (proof-with-checked-results
   ((fact (library-library-axiom lib name (list value)))
    (first (proof-step-first fact))
    (rhs (proof-term-at first 2))
    (normal (b2-tactics-tactics-normalize lib rhs evidence nil nil 1500 nil)))
