(in-package "BOYMOO-PROVER")

(set-verify-guards-eagerness 0)

(defconst *b2-algebra-names*
  (list (cons *proof-plus* "+") (cons *proof-times* "*")))

(defconst *b2-algebra-cancellation*
  '(("sym" "ACL2" "LEFT-CANCELLATION-FOR-*")
    ("sym" "ACL2" "LEFT-CANCELLATION-FOR-+")
    ("sym" "ACL2" "RIGHT-CANCELLATION-FOR-*")
    ("sym" "ACL2" "RIGHT-CANCELLATION-FOR-+")))

(defconst *b2-algebra-arithmetic-theorems*
  '(("sym" "ACL2" "COMMUTATIVITY-2-OF-*")
    ("sym" "ACL2" "EQUAL-MINUS-MINUS")
    ("sym" "ACL2" "FOLD-CONSTS-IN-*")
    ("sym" "ACL2" "FUNCTIONAL-COMMUTATIVITY-OF-MINUS-*-LEFT")
    ("sym" "ACL2" "FUNCTIONAL-COMMUTATIVITY-OF-MINUS-*-RIGHT")
    ("sym" "ACL2" "FUNCTIONAL-SELF-INVERSION-OF-MINUS")
    ("sym" "ACL2" "INVERSE-OF-+-AS=0")
    ("sym" "ACL2" "LEFT-CANCELLATION-FOR-*")
    ("sym" "ACL2" "LEFT-CANCELLATION-FOR-+")
    ("sym" "ACL2" "MINUS-CANCELLATION-ON-LEFT")
    ("sym" "ACL2" "MINUS-CANCELLATION-ON-RIGHT")
    ("sym" "ACL2" "RIGHT-CANCELLATION-FOR-*")
    ("sym" "ACL2" "RIGHT-CANCELLATION-FOR-+")))

(defun b2-algebra-boolean-equivalence-positive (lib goal yes forward)
  (if (failure-p forward)
      forward
    (b2-tactics-tactics-solve lib goal (list yes forward) nil nil 0 nil)))

(defun b2-algebra-boolean-equivalence-negative (lib left right no positive backward)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
     ((positive positive)
      (backward backward)
      (failure (proof-proof-cut proof backward no))
      (failure (proof-proof-front proof failure (proof-neg right)))
      (negative (b2-tactics-tactics-solve lib (proof-eq left right)
                                          (list no failure) nil nil 0 nil)))
     (proof-proof-cases proof left positive negative))))

(defun b2-algebra-boolean-equivalence (lib left right forward backward)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
     ((yes (proof-proof-assume proof left t))
      (no (proof-proof-assume proof left nil))
      (positive (b2-algebra-boolean-equivalence-positive lib (proof-eq left right)
                                                        yes forward))
      (right-assumption (proof-proof-assume proof right t)))
     (b2-algebra-boolean-equivalence-negative lib left right no positive backward))))

(defun b2-algebra-congruence (lib equality term path)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
     ((step (proof-proof-reflexive proof term))
      (step (proof-proof-rewrite proof step equality (list* 1 2 path))))
     (proof-proof-tidy proof step))))

(defun b2-algebra-install-fix-number (lib)
  (let* ((proof (library-library-proof lib))
         (test (list *library-numberp* *library-x*))
         (goal (list *library-numberp* (list *b2-products-fix* *library-x*)))
         (unfold (list *b2-products-fix*)))
    (proof-with-checked-results
     ((yes (proof-proof-assume proof test t))
      (positive (b2-tactics-tactics-solve lib goal (list yes) unfold nil 0 nil))
      (no (proof-proof-assume proof test nil))
      (negative (b2-tactics-tactics-solve lib goal (list no) unfold nil 0 nil))
      (cases (proof-proof-cases proof test positive negative))
      (added (b2-tactics-tactics-add-lemma lib "FIX-NUMBER" cases :none)))
     (cdr added))))

(defun b2-algebra-fix-number (lib value)
  (let* ((name (proof-sym "B2-FIX-NUMBER" "ACL2"))
         (facts (proof-proof-facts (library-library-proof lib))))
    (proof-with-checked-results
     ((lib (if (assoc-equal name facts) lib (b2-algebra-install-fix-number lib)))
      (step (proof-proof-fact (library-library-proof lib) name
                             (list (list *library-x* value)))))
     (cons step lib))))

(defun b2-algebra-operation-name (op)
  (let ((entry (assoc-equal op *b2-algebra-names*)))
    (if entry
        (cdr entry)
      '(:failure "tactic-rejected" ""))))

(defun b2-algebra-fixed-operand (lib term position)
  (proof-with-checked-results
   ((parts (proof-list-of-length term 3)))
   (let* ((proof (library-library-proof lib))
          (op (car parts))
          (a (cadr parts))
          (b (caddr parts))
          (first (or (equal position 1) (eq position t)))
          (axis (if first a b))
          (other (if first b a))
          (addition (equal op *proof-plus*))
          (unit (if addition *proof-zero* *proof-one*))
          (axiom (if addition "UNICITY-OF-0" "UNICITY-OF-1"))
          (ordered (list op axis other)))
     (proof-with-checked-results
      ((operator (b2-algebra-operation-name op))
       (regroup (library-library-axiom lib (concatenate 'string "ASSOCIATIVITY-OF-" operator)
                                        (list unit axis other)))
       (axis-unit (library-library-axiom lib axiom (list axis)))
       (fixed (proof-proof-rewrite proof regroup axis-unit '(1 1 1)))
       (numeric (proof-proof-unfold proof (list *b2-products-fix* ordered)))
       (ordered-unit (library-library-axiom lib axiom (list ordered)))
       (numeric-first (proof-step-first numeric))
       (numeric-rhs (proof-term-at numeric-first 2))
       (closure (b2-products-numeric-closure lib ordered))
       (selection (proof-proof-select proof numeric-rhs closure))
       (eliminated (proof-proof-chain proof ordered-unit (list numeric selection)))
       (fixed (proof-proof-chain proof fixed (list eliminated)))
       (fixed (proof-proof-symmetric proof fixed)))
      (if (equal position 2)
          (let ((comm (concatenate 'string "COMMUTATIVITY-OF-" operator)))
            (proof-with-checked-results
             ((first-swap (library-library-axiom lib comm (list a b)))
              (last-swap (library-library-axiom lib comm (list (list *b2-products-fix* b) a))))
             (proof-proof-chain proof first-swap (list fixed last-swap))))
        fixed)))))

(defun b2-algebra-minus-fix (lib value)
  (let* ((proof (library-library-proof lib))
         (test (list *library-numberp* value))
         (fixed (list *b2-products-fix* value))
         (goal (proof-eq (library-minus value) (library-minus fixed)))
         (unfold (list *b2-products-fix*)))
    (proof-with-checked-results
     ((yes (proof-proof-assume proof test t))
      (no (proof-proof-assume proof test nil))
      (completion (library-library-axiom lib "COMPLETION-OF-UNARY-MINUS" (list value)))
      (completion-first (proof-step-first completion))
      (rhs (proof-term-at completion-first 2))
      (normal (b2-tactics-tactics-normalize lib rhs (list no) nil nil 1500 nil))
      (reduced (proof-proof-chain proof completion (list normal)))
      (positive (b2-tactics-tactics-solve lib goal (list yes) unfold nil 0 nil))
      (negative (b2-tactics-tactics-solve lib goal (list no) unfold (list reduced) 0 nil)))
     (proof-proof-cases proof test positive negative))))

(defun b2-algebra-cancel-sum (lib value offset)
  (let ((proof (library-library-proof lib))
        (opposite (library-minus offset)))
    (proof-with-checked-results
     ((step (library-library-axiom lib "ASSOCIATIVITY-OF-+" (list value offset opposite)))
      (inverse (library-library-axiom lib "INVERSE-OF-+" (list offset)))
      (step (proof-proof-rewrite proof step inverse '(1 2 2)))
      (commute (library-library-axiom lib "COMMUTATIVITY-OF-+" (list value *proof-zero*)))
      (unit (library-library-axiom lib "UNICITY-OF-0" (list value))))
     (proof-proof-chain proof step (list commute unit)))))

(defun b2-algebra-fixed-order (lib a b)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
     ((original (library-library-axiom lib "<-ON-OTHERS" (list a b)))
      (fixed (b2-algebra-fixed-operand lib (library-diff a b) 1))
      (step (proof-proof-rewrite proof original fixed '(1 2 1)))
      (fixed-minus (b2-algebra-minus-fix lib b))
      (step (proof-proof-rewrite proof step fixed-minus '(1 2 1 2)))
      (completed (library-library-axiom lib "<-ON-OTHERS"
                                        (list (list *b2-products-fix* a)
                                              (list *b2-products-fix* b))))
      (reversed (proof-proof-symmetric proof completed)))
     (proof-proof-chain proof step (list reversed)))))

(defun b2-algebra-cancel-shift-difference (lib offset a b)
  (let ((proof (library-library-proof lib))
        (first (library-plus offset a))
        (second (library-plus offset b)))
    (proof-with-checked-results
     ((step (proof-proof-reflexive proof (library-diff first second)))
      (negative-sum (library-library-axiom lib "DISTRIBUTIVITY-OF-MINUS-OVER-+" (list offset b)))
      (step (proof-proof-rewrite proof step negative-sum '(1 2 2)))
      (regroup (library-library-axiom lib "ASSOCIATIVITY-OF-+"
                                      (list first (library-minus offset) (library-minus b))))
      (separate (proof-proof-symmetric proof regroup))
      (step (proof-proof-rewrite proof step separate '(1 2)))
      (swapped (library-library-axiom lib "COMMUTATIVITY-OF-+" (list offset a)))
      (step (proof-proof-rewrite proof step swapped '(1 2 1 1)))
      (cancelled (b2-algebra-cancel-sum lib a offset))
      (step (proof-proof-rewrite proof step cancelled '(1 2 1)))
      (completed (b2-algebra-fixed-operand lib (library-diff a b) 1))
      (completed (proof-proof-symmetric proof completed)))
     (proof-proof-chain proof step (list completed)))))

(defun b2-algebra-cancel-common-shift (lib offset a b)
  (let ((proof (library-library-proof lib))
        (first (library-plus offset a))
        (second (library-plus offset b)))
    (proof-with-checked-results
     ((expanded (library-library-axiom lib "<-ON-OTHERS" (list first second)))
      (cancelled (b2-algebra-cancel-shift-difference lib offset a b))
      (step (proof-proof-rewrite proof expanded cancelled '(1 2 1)))
      (original (library-library-axiom lib "<-ON-OTHERS" (list a b)))
      (original (proof-proof-symmetric proof original)))
     (proof-proof-chain proof step (list original)))))

(defun b2-algebra-term-tail (term)
  (if (integerp term)
      '(:failure "tactic-rejected" "")
    (cdr term)))

(defun b2-algebra-tail-of-size (term size)
  (proof-with-checked-results
   ((tail (b2-algebra-term-tail term)))
   (proof-list-of-length tail size)))

(defun b2-algebra-minus-equality-operands (left)
  (proof-with-checked-results
   ((terms (b2-algebra-term-tail left)))
   (cond ((endp terms) (proof-list-of-length terms 2))
         (t (proof-with-checked-results
             ((a (proof-term-at (car terms) 1)))
             (if (endp (cdr terms))
                 (proof-list-of-length terms 2)
               (proof-with-checked-results
                ((b (proof-term-at (cadr terms) 1)))
                (if (consp (cddr terms))
                    (proof-with-checked-results
                     ((extra (proof-term-at (caddr terms) 1)))
                     (proof-list-of-length terms 2))
                  (list a b)))))))))

(defun b2-algebra-minus-equality-equation (lib value from-negations)
  (if from-negations
      (b2-fraction-reduction-twice-negated lib value nil)
    (proof-with-checked-results
     ((equation (b2-algebra-minus-fix lib value)))
     (proof-proof-symmetric (library-library-proof lib) equation))))

(defun b2-algebra-minus-equality-change (evidence from-negations lib a b)
  (let* ((proof (library-library-proof lib))
         (inner (list (if from-negations *proof-minus* *b2-products-fix*) a)))
    (proof-with-checked-results
     ((bundled (b2-algebra-congruence lib evidence (library-minus inner) '(1)))
      (equation (b2-algebra-minus-equality-equation lib a from-negations))
      (bundled (proof-proof-rewrite proof bundled equation '(1 1)))
      (equation (b2-algebra-minus-equality-equation lib b from-negations))
      (bundled (proof-proof-rewrite proof bundled equation '(1 2))))
     (proof-proof-tidy proof bundled))))

(defun b2-algebra-minus-equality (lib left right)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
     ((operands (b2-algebra-minus-equality-operands left))
      (yes (proof-proof-assume proof left t))
      (no (proof-proof-assume proof left nil))
      (forward (b2-algebra-minus-equality-change yes t lib (car operands) (cadr operands)))
      (positive (b2-algebra-boolean-equivalence-positive lib (proof-eq left right)
                                                        yes forward))
      (right-assumption (proof-proof-assume proof right t))
      (backward (b2-algebra-minus-equality-change right-assumption nil lib
                                                  (car operands) (cadr operands))))
     (b2-algebra-boolean-equivalence-negative lib left right no positive backward))))

(defun b2-algebra-operand-cancellation-remove (term tail lib op common factor inverse)
  (let ((proof (library-library-proof lib))
        (target (list op term common)))
    (if (equal op *proof-plus*)
        (proof-with-checked-results
         ((step (b2-algebra-cancel-sum lib term common)))
         (cons step lib))
      (proof-with-checked-results
       ((fixed (b2-algebra-fixed-operand lib target 1))
        (fixed-first (proof-step-first fixed))
        (fixed-rhs (proof-term-at fixed-first 2))
        (second (b2-algebra-fixed-operand lib fixed-rhs 2))
        (fixed (proof-proof-chain proof fixed (list second)))
        (fixed-term (list *b2-products-fix* term))
        (commute (library-library-axiom lib "COMMUTATIVITY-OF-*" (list fixed-term factor)))
        (fixed (proof-proof-chain proof fixed (list commute)))
        (lifted (b2-algebra-congruence lib fixed (list *proof-times* inverse target) '(2)))
        (number (b2-algebra-fix-number lib term))
        (lib (cdr number))
        (cancellation (b2-products-distribute-cancel lib inverse factor fixed-term tail (car number)))
        (step (proof-proof-chain (library-library-proof lib) lifted (list cancellation))))
       (cons step lib)))))

(defun b2-algebra-operand-cancellation-backward (step lib left)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
     ((one (proof-term-at left 1))
      (prefix (b2-algebra-fixed-operand lib one 1))
      (chain (proof-proof-rewrite proof prefix step '(1 2 1)))
      (two (proof-term-at left 2))
      (suffix (b2-algebra-fixed-operand lib two 1))
      (suffix (proof-proof-symmetric proof suffix)))
     (proof-proof-chain proof chain (list suffix)))))

(defun b2-algebra-operand-cancellation-forward (step lib left op a b common factor inverse unit)
  (let* ((addition (equal op *proof-plus*))
         (left-operand (cadr left))
         (term (if addition
                   (library-plus left-operand (library-minus common))
                 (list *proof-times* inverse left-operand)))
         (path (if addition '(1) '(2))))
    (proof-with-checked-results
     ((lifted (b2-algebra-congruence lib step term path))
      (removed (b2-algebra-operand-cancellation-remove a unit lib op common factor inverse))
      (lib (cdr removed))
      (lifted (proof-proof-rewrite (library-library-proof lib) lifted (car removed) '(1 1)))
      (removed (b2-algebra-operand-cancellation-remove b unit lib op common factor inverse))
      (lib (cdr removed))
      (proof (library-library-proof lib))
      (lifted (proof-proof-rewrite proof lifted (car removed) '(1 2)))
      (lifted (proof-proof-tidy proof lifted)))
     (cons lifted lib))))

(defun b2-algebra-operand-cancellation-equivalence (lib left right op a b common factor inverse unit)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
     ((yes (proof-proof-assume proof left t))
      (no (proof-proof-assume proof left nil))
      (forward (b2-algebra-operand-cancellation-forward yes lib left op a b common factor inverse unit))
      (lib (cdr forward))
      (positive (b2-algebra-boolean-equivalence-positive lib (proof-eq left right)
                                                        yes (car forward)))
      (right-assumption (proof-proof-assume (library-library-proof lib) right t))
      (backward (b2-algebra-operand-cancellation-backward right-assumption lib left))
      (step (b2-algebra-boolean-equivalence-negative lib left right no positive backward)))
     (cons step lib))))

(defun b2-algebra-operand-cancellation-vanishes (term lib common zero)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
     ((step (b2-algebra-fixed-operand lib (list *proof-times* term common) 2))
      (step (proof-proof-rewrite proof step zero '(1 2 2)))
      (product (b2-products-zero-product lib term))
      (lib (cdr product))
      (step (proof-proof-chain (library-library-proof lib) step (list (car product)))))
     (cons step lib))))

(defun b2-algebra-operand-cancellation-nonzero (proof factor no)
  (let ((test (proof-eq factor *proof-zero*)))
    (proof-with-checked-results
     ((assumption (proof-proof-assume proof test t))
      (reversed (proof-proof-symmetric proof assumption))
      (failure (proof-proof-cut proof reversed no)))
     (proof-proof-front proof failure (proof-neg test)))))

(defun b2-algebra-operand-cancellation-product (lib left right op a b common)
  (let* ((proof (library-library-proof lib))
         (factor (list *b2-products-fix* common))
         (inverse (list *b2-products-recip* factor)))
    (proof-with-checked-results
     ((parts (b2-algebra-tail-of-size right 3))
      (test (car parts))
      (result (caddr parts))
      (yes (proof-proof-assume proof test t))
      (no (proof-proof-assume proof test nil))
      (right-operand (proof-term-at test 2))
      (zero-on-right (equal right-operand *proof-zero*))
      (zero (if zero-on-right yes (proof-proof-symmetric proof yes)))
      (nonzero (if zero-on-right no (b2-algebra-operand-cancellation-nonzero proof factor no)))
      (vanishing-a (b2-algebra-operand-cancellation-vanishes a lib common zero))
      (lib (cdr vanishing-a))
      (vanishing-b (b2-algebra-operand-cancellation-vanishes b lib common zero))
      (lib (cdr vanishing-b))
      (closed (b2-tactics-tactics-solve lib (proof-eq left right) (list yes) nil
                                       (list (car vanishing-a) (car vanishing-b)) 0 nil))
      (commute (library-library-axiom lib "COMMUTATIVITY-OF-*" (list inverse factor)))
      (numeric (b2-algebra-fix-number lib common))
      (lib (cdr numeric))
      (reciprocal (b2-products-reciprocal-identity lib factor (car numeric) nonzero))
      (unit (proof-proof-chain (library-library-proof lib) commute (list reciprocal)))
      (open-case (b2-algebra-operand-cancellation-equivalence lib left result op a b
                                                            common factor inverse unit))
      (lib (cdr open-case))
      (proof (library-library-proof lib))
      (selected (proof-proof-select proof right no))
      (selected (proof-proof-symmetric proof selected))
      (open-case (proof-proof-rewrite proof (car open-case) selected '(1 2)))
      (open-case (proof-proof-tidy proof open-case))
      (step (proof-proof-cases proof test closed open-case)))
     (cons step lib))))

(defun b2-algebra-operand-cancellation (lib left right)
  (proof-with-checked-results
   ((first (proof-term-at left 1))
    (parts (proof-list-of-length first 3))
    (second (proof-term-at left 2))
    (b (proof-term-at second 1)))
   (let ((op (car parts))
         (a (cadr parts))
         (common (caddr parts)))
     (if (equal op *proof-plus*)
         (b2-algebra-operand-cancellation-equivalence lib left right op a b common nil nil nil)
       (b2-algebra-operand-cancellation-product lib left right op a b common)))))

(defun b2-algebra-common-operand-swapped (lib left right a b)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
     ((op (proof-term-at a 0))
      (op-name (b2-algebra-operation-name op))
      (comm (concatenate 'string "COMMUTATIVITY-OF-" op-name))
      (transform (proof-proof-reflexive proof left))
      (args-a (b2-algebra-term-tail a))
      (swap-a (library-library-axiom lib comm args-a))
      (transform (proof-proof-rewrite proof transform swap-a '(1 2 1)))
      (args-b (b2-algebra-term-tail b))
      (swap-b (library-library-axiom lib comm args-b))
      (transform (proof-proof-rewrite proof transform swap-b '(1 2 2)))
      (literal (proof-step-first transform))
      (rhs (proof-term-at literal 2))
      (cancelled (b2-algebra-operand-cancellation lib rhs right))
      (lib (cdr cancelled))
      (proof (library-library-proof lib))
      (transform (proof-proof-symmetric proof transform))
      (step (proof-proof-rewrite proof (car cancelled) transform '(1 1)))
      (step (proof-proof-tidy proof step)))
     (cons step lib))))

(defun b2-algebra-common-operand (lib formula)
  (proof-with-checked-results
   ((parts (b2-algebra-tail-of-size formula 2))
    (left (car parts))
    (right (cadr parts))
    (operands (b2-algebra-tail-of-size left 2))
    (a (car operands))
    (b (cadr operands))
    (a-tail (proof-term-at a 2))
    (b-tail (proof-term-at b 2)))
   (if (equal a-tail b-tail)
       (b2-algebra-operand-cancellation lib left right)
     (b2-algebra-common-operand-swapped lib left right a b))))

(defun b2-algebra-product-zero-test (lib a b)
  (let* ((fixed-a (list *b2-products-fix* a))
         (fixed-b (list *b2-products-fix* b))
         (fixed-zero (list *b2-products-fix* *proof-zero*))
         (test (proof-eq *proof-zero* fixed-a))
         (residual (proof-eq *proof-zero* fixed-b))
         (product (list *proof-times* a b))
         (multiplied (proof-eq (list *proof-times* a *proof-zero*) product))
         (cancel-formula (proof-eq multiplied (proof-ite test test (proof-eq fixed-zero fixed-b)))))
    (proof-with-checked-results
     ((cancellation (b2-algebra-common-operand lib cancel-formula))
      (lib (cdr cancellation))
      (zero (b2-products-zero-product lib a))
      (lib (cdr zero))
      (proof (library-library-proof lib))
      (cancellation (proof-proof-rewrite proof (car cancellation) (car zero) '(1 1 1)))
      (zero (b2-tactics-tactics-normalize lib fixed-zero nil (list fixed-zero) nil 1500 nil))
      (cancellation (if zero
                        (proof-proof-rewrite proof cancellation zero '(1 2 3 1))
                      '(:failure "failure" "")))
      (cancellation (proof-proof-tidy proof cancellation))
      (formula (proof-eq (proof-eq *proof-zero* product) (proof-ite test *proof-true* residual)))
      (yes (proof-proof-assume proof test t))
      (positive (b2-tactics-tactics-solve lib formula (list yes) nil (list cancellation) 0 nil))
      (no (proof-proof-assume proof test nil))
      (negative (b2-tactics-tactics-solve lib formula (list no) nil (list cancellation) 0 nil))
      (step (proof-proof-cases proof test positive negative)))
     (cons step lib))))

(defun b2-algebra-cancel-inverse-forward (step lib left-plus-b reduce b)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
     ((lifted (b2-algebra-congruence lib step left-plus-b '(1)))
      (lifted (proof-proof-rewrite proof lifted reduce '(1 1)))
      (unit (library-library-axiom lib "UNICITY-OF-0" (list b)))
      (lifted (proof-proof-rewrite proof lifted unit '(1 2))))
     (proof-proof-tidy proof lifted))))

(defun b2-algebra-cancel-inverse-backward (step lib left b opposite)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
     ((first (proof-term-at left 1))
      (fixed (b2-algebra-fixed-operand lib first 1))
      (fixed (proof-proof-rewrite proof fixed step '(1 2 1)))
      (second (b2-algebra-fixed-operand lib (library-plus b opposite) 1))
      (second (proof-proof-symmetric proof second))
      (fixed (proof-proof-chain proof fixed (list second)))
      (inverse (library-library-axiom lib "INVERSE-OF-+" (list b))))
     (proof-proof-chain proof fixed (list inverse)))))

(defun b2-algebra-cancel-inverse (lib left right)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
     ((first (proof-term-at left 1))
      (terms (b2-algebra-tail-of-size first 2))
      (a (car terms))
      (opposite (cadr terms))
      (b (proof-term-at opposite 1))
      (left-plus-b (library-plus first b))
      (reduce (library-library-axiom lib "ASSOCIATIVITY-OF-+" (list a opposite b)))
      (commute (library-library-axiom lib "COMMUTATIVITY-OF-+" (list opposite b)))
      (inverse (library-library-axiom lib "INVERSE-OF-+" (list b)))
      (pair (proof-proof-chain proof commute (list inverse)))
      (reduce (proof-proof-rewrite proof reduce pair '(1 2 2)))
      (commute (library-library-axiom lib "COMMUTATIVITY-OF-+" (list a *proof-zero*)))
      (unit (library-library-axiom lib "UNICITY-OF-0" (list a)))
      (reduce (proof-proof-chain proof reduce (list commute unit)))
      (yes (proof-proof-assume proof left t))
      (no (proof-proof-assume proof left nil))
      (forward (b2-algebra-cancel-inverse-forward yes lib left-plus-b reduce b))
      (positive (b2-algebra-boolean-equivalence-positive lib (proof-eq left right)
                                                        yes forward))
      (right-assumption (proof-proof-assume proof right t))
      (backward (b2-algebra-cancel-inverse-backward right-assumption lib left b opposite)))
     (b2-algebra-boolean-equivalence-negative lib left right no positive backward))))

(defun b2-algebra-arithmetic-identity-minus-cancellation (lib formula)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
     ((first (proof-term-at formula 1))
      (parts (b2-algebra-tail-of-size first 2))
      (outer (car parts))
      (suffix (cadr parts))
      (inner (proof-term-at suffix 1)))
     (if (equal inner (library-minus outer))
         (proof-with-checked-results
          ((args (b2-algebra-term-tail suffix))
           (reassociate (library-library-axiom lib "ASSOCIATIVITY-OF-+" (cons outer args)))
           (combined (proof-proof-symmetric proof reassociate))
           (cancel (library-library-axiom lib "INVERSE-OF-+" (list outer)))
           (combined (proof-proof-rewrite proof combined cancel '(1 2 1)))
           (last (proof-term-at suffix 2))
           (unit (library-library-axiom lib "UNICITY-OF-0" (list last))))
          (proof-proof-chain proof combined (list unit)))
       (proof-with-checked-results
        ((equation (b2-algebra-cancel-sum lib inner outer))
         (last (proof-term-at suffix 2))
         (exchange (library-library-cite lib "ADD-SWAP" (list outer inner last) nil))
         (reassociate (library-library-axiom lib "ASSOCIATIVITY-OF-+" (list inner outer last)))
         (reassociate (proof-proof-symmetric proof reassociate)))
        (proof-proof-chain proof exchange (list reassociate equation)))))))

(defun b2-algebra-arithmetic-identity-fold (lib formula)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
     ((parts (b2-algebra-tail-of-size formula 2))
      (implication (car parts))
      (target (cadr parts))
      (left (proof-term-at target 1))
      (operands (b2-algebra-tail-of-size left 2))
      (nested (proof-list-of-length (cadr operands) 3))
      (reassociate (library-library-axiom lib "ASSOCIATIVITY-OF-*"
                                          (list (car operands) (cadr nested) (caddr nested))))
      (reassociate (proof-proof-symmetric proof reassociate)))
     (b2-tactics-tactics-implication lib implication target (cons reassociate lib)))))

(defun b2-algebra-arithmetic-identity-binary-arguments (formula)
  (proof-with-checked-results
   ((args (b2-algebra-term-tail formula)))
   (if (equal (len args) 2)
       args
     '(:failure "tactic-rejected" ""))))

(defun b2-algebra-arithmetic-identity-product-swap (lib formula)
  (proof-with-checked-results
   ((left (proof-term-at formula 1))
    (a (proof-term-at left 1))
    (tail (proof-term-at left 2))
    (args (b2-algebra-arithmetic-identity-binary-arguments tail)))
   (b2-products-product-swap lib a (car args) (cadr args))))

(defun b2-algebra-arithmetic-identity (lib name formula)
  (cond
   ((equal name (proof-sym "FUNCTIONAL-SELF-INVERSION-OF-MINUS" "ACL2"))
    (proof-with-checked-results
     ((left (proof-term-at formula 1))
      (inner (proof-term-at left 1))
      (value (proof-term-at inner 1))
      (step (b2-fraction-reduction-twice-negated lib value nil)))
     (cons step lib)))
   ((member-equal name *b2-algebra-cancellation*)
    (b2-algebra-common-operand lib formula))
   ((or (equal name (proof-sym "MINUS-CANCELLATION-ON-RIGHT" "ACL2"))
        (equal name (proof-sym "MINUS-CANCELLATION-ON-LEFT" "ACL2")))
    (proof-with-checked-results
     ((step (b2-algebra-arithmetic-identity-minus-cancellation lib formula)))
     (cons step lib)))
   ((equal name (proof-sym "EQUAL-MINUS-MINUS" "ACL2"))
    (proof-with-checked-results
     ((args (b2-algebra-arithmetic-identity-binary-arguments formula))
      (step (b2-algebra-minus-equality lib (car args) (cadr args))))
     (cons step lib)))
   ((equal name (proof-sym "INVERSE-OF-+-AS=0" "ACL2"))
    (proof-with-checked-results
     ((args (b2-algebra-arithmetic-identity-binary-arguments formula))
      (step (b2-algebra-cancel-inverse lib (car args) (cadr args))))
     (cons step lib)))
   ((equal name (proof-sym "FOLD-CONSTS-IN-*" "ACL2"))
    (b2-algebra-arithmetic-identity-fold lib formula))
   ((equal name (proof-sym "COMMUTATIVITY-2-OF-*" "ACL2"))
    (proof-with-checked-results
     ((step (b2-algebra-arithmetic-identity-product-swap lib formula)))
     (cons step lib)))
   ((equal name (proof-sym "FUNCTIONAL-COMMUTATIVITY-OF-MINUS-*-LEFT" "ACL2"))
    (proof-with-checked-results
     ((left (proof-term-at formula 1))
      (minus-a (proof-term-at left 1))
      (a (proof-term-at minus-a 1))
      (b (proof-term-at left 2)))
     (b2-fraction-reduction-negative-first lib a b)))
   ((equal name (proof-sym "FUNCTIONAL-COMMUTATIVITY-OF-MINUS-*-RIGHT" "ACL2"))
    (proof-with-checked-results
     ((left (proof-term-at formula 1))
      (a (proof-term-at left 1))
      (minus-b (proof-term-at left 2))
      (b (proof-term-at minus-b 1)))
     (b2-fraction-reduction-negative-factor lib a b)))
   (t (b2-tactics-unproved))))
