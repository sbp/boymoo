(in-package "BOYMOO-PROVER")

(set-verify-guards-eagerness 0)

(defconst *subtraction-nfix* (proof-sym "NFIX" "ACL2"))
(defconst *subtraction-ifix* (proof-sym "IFIX" "ACL2"))
(defconst *subtraction-integer-abs* (proof-sym "INTEGER-ABS" "ACL2"))
(defconst *subtraction-numeric-equal* (proof-cl "="))

(defun subtraction-positive-nfix-input (lib value nonzero)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
     ((first (proof-step-first nonzero))
      (application (proof-term-at first 1))
      (equation (proof-proof-unfold proof application))
      (nonzero (proof-proof-rewrite proof nonzero equation '(1 1)))
      (opened (proof-proof-unfold proof (list *subtraction-nfix* value)))
      (first (proof-step-first opened))
      (body (proof-term-at first 2))
      (when-false (proof-proof-if-false proof body))
      (clipped (proof-proof-chain proof opened (list when-false)))
      (cut (proof-proof-cut proof clipped nonzero))
      (test (proof-term-at body 1))
      (natural-test (proof-proof-front proof cut test))
      (parts (proof-proof-conjunct proof natural-test))
      (int-proof (car parts))
      (bound (cadr parts))
      (select (proof-proof-select proof body natural-test))
      (identity (proof-proof-chain proof opened (list select)))
      (nonzero (proof-proof-rewrite proof nonzero identity '(1 1 1)))
      (nonzero (proof-proof-tidy proof nonzero))
      (positive (lemmas-positive-nonzero-integer lib value int-proof nonzero bound)))
     (cons (list int-proof (car positive)) (cdr positive)))))

(defun subtraction-prove-count-identity (lib value int-proof bound)
  (let ((cons-term (list *proof-consp* value)))
    (proof-with-checked-results
     ((numeric (lemmas-slice-library-number lib value (list int-proof)))
      (lib (cdr numeric))
      (proof (library-library-proof lib))
      (nonnumber (proof-proof-fact proof "consp-not-acl2-numberp" (list (list *library-x* value))))
      (cons-proof (proof-proof-assume proof cons-term t))
      (nonnumber (proof-proof-modus-ponens proof nonnumber cons-proof))
      (cut (proof-proof-cut proof (car numeric) nonnumber))
      (atom (proof-proof-front proof cut (proof-neg cons-term)))
      (rational (lemmas-slice-library-rational lib value (list int-proof)))
      (lib (cdr rational))
      (step (proof-proof-simplify (library-library-proof lib) (list *library-count* value)
                                  (list atom (car rational) int-proof bound)
                                  (list *library-count* *subtraction-integer-abs*))))
     (cons step lib))))

(defun subtraction-count-identity (lib value int-proof bound)
  (let ((name "COUNT-OF-NONNEGATIVE-INTEGER")
        (integrality (library-integer *library-x*))
        (negative (library-lt *library-x* *proof-zero*))
        (proof (library-library-proof lib)))
    (proof-with-checked-results
     ((lib (if (lemmas-has-fact lib (lemmas-self-name name))
               lib
             (proof-with-checked-results
              ((typed (proof-proof-assume proof integrality t))
               (bounded (proof-proof-assume proof negative nil))
               (derived (subtraction-prove-count-identity lib *library-x* typed bounded)))
              (library-library-lemma (cdr derived) name
                                     (proof-eq (list *library-count* *library-x*) *library-x*)
                                     (car derived) (list (proof-neg integrality) negative)))))
      (step (library-library-cite lib name (list value) (list int-proof bound))))
     (cons step lib))))

(defun subtraction-goal-amount (goal)
  (proof-with-checked-results ((goal (proof-list-of-length goal 3)))
   (let ((child (cadr goal))
         (parent (caddr goal)))
     (if (not (and (proof-is-call child *library-count*) (proof-is-call parent *library-count*)))
         nil
       (proof-with-checked-results
        ((value (proof-term-at parent 1))
         (difference (proof-term-at child 1)))
        (if (not (proof-is-call difference *proof-plus*))
            nil
          (proof-with-checked-results ((left (proof-term-at difference 1)))
           (if (not (equal left value))
               nil
             (proof-with-checked-results ((right (proof-term-at difference 2)))
              (if (not (proof-is-call right *proof-minus*))
                  nil
                (proof-with-checked-results ((amount (proof-term-at right 1)))
                 (list value difference amount))))))))))))

(defun subtraction-decrease-from-evidence (lib value difference amount nonzero not-below)
  (let* ((integer (library-integer value))
         (fixed (list *subtraction-ifix* value))
         (negative-value (library-lt value *proof-zero*)))
    (proof-with-checked-results
     ((positive (subtraction-positive-nfix-input lib amount nonzero))
      (lib (cdr positive))
      (proof (library-library-proof lib))
      (int-amount (caar positive))
      (pos-amount (cadar positive))
      (noninteger (proof-proof-assume proof integer nil))
      (zero-value (proof-proof-simplify proof fixed (list noninteger) (list *subtraction-ifix*)))
      (less-on-noninteger (library-library-transport-argument lib pos-amount zero-value 1))
      (cut (proof-proof-cut proof less-on-noninteger not-below))
      (int-value (proof-proof-front proof cut integer))
      (fixed-value (proof-proof-simplify proof fixed (list int-value) (list *subtraction-ifix*)))
      (at-least (proof-proof-rewrite proof not-below fixed-value '(1 1 1)))
      (at-least (proof-proof-tidy proof at-least))
      (integers (list int-value int-amount))
      (int-zero (lemmas-slice-library-type-of lib *proof-zero* nil))
      (lib (cdr int-zero))
      (proof (library-library-proof lib))
      (assume-negative (proof-proof-assume proof negative-value t))
      (below-if-negative (library-library-cite lib "LESS-TRANSITIVE" (list value *proof-zero* amount)
                                                (list int-value (car int-zero) int-amount assume-negative pos-amount)))
      (cut (proof-proof-cut proof below-if-negative at-least))
      (value-bound (proof-proof-front proof cut (proof-neg negative-value)))
      (compare (library-library-axiom lib "<-ON-OTHERS" (list value amount)))
      (difference-bound (proof-proof-rewrite proof at-least compare '(1 1)))
      (difference-bound (proof-proof-tidy proof difference-bound))
      (int-difference (lemmas-slice-library-type-of lib difference integers))
      (lib (cdr int-difference))
      (int-difference (car int-difference))
      (count-value (subtraction-count-identity lib value int-value value-bound))
      (count-difference (subtraction-count-identity (cdr count-value) difference int-difference difference-bound))
      (lib (cdr count-difference))
      (proof (library-library-proof lib))
      (smaller (library-library-less-from-difference lib difference value pos-amount integers))
      (comparison (library-library-cite lib "FINITE-ORDER" (list difference value) (list int-difference int-value)))
      (ordinal (proof-proof-transport proof smaller comparison))
      (symmetric (proof-proof-symmetric proof (car count-difference)))
      (ordinal (proof-proof-rewrite proof ordinal symmetric '(1 1)))
      (symmetric (proof-proof-symmetric proof (car count-value)))
      (ordinal (proof-proof-rewrite proof ordinal symmetric '(1 2)))
      (step (proof-proof-tidy proof ordinal)))
     (cons step lib))))

(defun subtraction-subtraction-decrease-with-rulers (lib goal rulers)
  (proof-with-checked-results ((parts (subtraction-goal-amount goal)))
   (if (not parts)
       (cons (list nil rulers) lib)
     (let* ((value (car parts))
            (difference (cadr parts))
            (amount (caddr parts))
            (zero-test (list *subtraction-numeric-equal* (list *subtraction-nfix* amount) *proof-zero*))
            (below (library-lt (list *subtraction-ifix* value) amount)))
       (proof-with-checked-results
        ((nonzero (rulers-rulers-find rulers (proof-neg zero-test)))
         (not-below (rulers-rulers-find (cdr nonzero) (proof-neg below)))
         (rulers (cdr not-below)))
        (if (and (car nonzero) (car not-below))
            (proof-with-checked-results
             ((result (subtraction-decrease-from-evidence lib value difference amount (car nonzero) (car not-below))))
             (let* ((latest-lib (cdr result))
                    (latest-rulers (if (equal (rulers-rulers-proof rulers) lib)
                                       (rulers-rulers-with-proof rulers latest-lib)
                                     rulers)))
               (cons (list (car result) latest-rulers) latest-lib)))
          (cons (list nil rulers) lib)))))))

