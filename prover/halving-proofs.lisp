(in-package "BOYMOO-PROVER")
(set-verify-guards-eagerness 0)

(defconst *halving-proofs-mv-nth* (proof-sym "MV-NTH" "ACL2"))
(defconst *halving-proofs-zp* (proof-sym "ZP" "ACL2"))
(defconst *halving-proofs-first* (proof-sym "SELF-FIRST-LENGTH" "ACL2"))
(defconst *halving-proofs-second* (proof-sym "SELF-SECOND-LENGTH" "ACL2"))

(defun halving-proofs-length (value)
  (list *library-len* value))

(defun halving-proofs-length-equation (lib value test)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
     ((opened (proof-proof-unfold proof (halving-proofs-length value)))
      (opening (proof-step-first opened))
      (body (proof-term-at opening 2))
      (selected (proof-proof-select proof body test)))
     (proof-proof-chain proof opened (list selected)))))

(defun halving-proofs-cons-length (lib head tail)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
     ((fact (proof-proof-fact proof "consp-cons"
                              (list (list *library-x* head) (list *library-y* tail))))
      (equation (halving-proofs-length-equation lib (list *proof-cons* head tail) fact))
      (axiom (library-library-axiom lib "CDR-CONS" (list head tail)))
      (equation (proof-proof-rewrite proof equation axiom '(1 2 2 1))))
     (proof-proof-tidy proof equation))))

(defun halving-proofs-positive-length (lib equation)
  (proof-with-checked-results
   ((first (proof-step-first equation))
    (length-sum (proof-term-at first 2))
    (tail (proof-term-at length-sum 2))
    (natural (library-library-natural lib tail))
    (natural (library-library-cite lib "NATURAL-NONNEGATIVE" (list tail) (list natural)))
    (integral (library-library-type-of lib tail nil))
    (proper (library-library-cite lib "POSITIVE-ONE-PLUS" (list tail)
                                  (list integral natural))))
   (library-library-transport-argument lib proper equation 2)))

(defun halving-proofs-cons-by-length (lib value positive-value)
  (let ((test (list *proof-consp* value))
        (proof (library-library-proof lib)))
    (proof-with-checked-results
     ((assumed (proof-proof-assume proof test nil))
      (zero (halving-proofs-length-equation lib value assumed))
      (false (proof-proof-rewrite proof positive-value zero '(1 2)))
      (constant (proof-proof-compute proof (library-lt *proof-zero* *proof-zero*) *proof-nil*))
      (false (proof-proof-rewrite proof false constant '(1)))
      (false (proof-proof-tidy proof false)))
     (proof-proof-front proof false test))))

(defun halving-proofs-split-test (fast)
  (let ((test (list *rulers-atom* fast)))
    (proof-ite test test (list *rulers-atom* (list *library-cdr* fast)))))

(defun halving-proofs-lengths (result)
  (list (halving-proofs-length (list *halving-proofs-mv-nth* *proof-zero* result))
        (halving-proofs-length (list *halving-proofs-mv-nth* *proof-one* result))))

(defun halving-proofs-properties (first second middle accumulator)
  (let ((kept (library-plus (halving-proofs-length accumulator)
                            (halving-proofs-length middle))))
    (product-arithmetic-conjunction
     (list (proof-eq (library-plus first second) kept)
           (library-le (halving-proofs-length accumulator) first)
           (library-positive second)))))

(defun halving-proofs-split-hypothesis (fast middle)
  (product-arithmetic-conjunction
   (list (library-le (halving-proofs-length fast) (halving-proofs-length middle))
         (library-positive (halving-proofs-length middle)))))

(defun halving-proofs-take-step (lib fast middle cons-fast cons-tail bound)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
     ((fast-eq (halving-proofs-length-equation lib fast cons-fast))
      (positive-fast (halving-proofs-positive-length lib fast-eq))
      (positive-middle (library-library-compare-chain lib positive-fast bound))
      (middle-cons (halving-proofs-cons-by-length lib middle positive-middle))
      (middle-eq (halving-proofs-length-equation lib middle middle-cons))
      (fast-tail (list *library-cdr* fast))
      (middle-tail (list *library-cdr* middle))
      (delta-eq (library-library-axiom lib "<-ON-OTHERS"
                                      (list (halving-proofs-length middle)
                                            (halving-proofs-length fast))))
      (delta (proof-proof-rewrite proof bound delta-eq '(1 1)))
      (delta (proof-proof-tidy proof delta))
      (delta (proof-proof-rewrite-first proof delta middle-eq))
      (delta (proof-proof-rewrite-first proof delta fast-eq))
      (difference (library-diff (halving-proofs-length middle-tail)
                                (halving-proofs-length fast-tail)))
      (first (proof-step-first delta))
      (difference-test (proof-term-at first 1))
      (before (proof-term-at difference-test 1))
      (cancelled (library-library-linear-equal lib before difference nil))
      (delta (proof-proof-rewrite proof delta cancelled '(1 1 1)))
      (delta (proof-proof-tidy proof delta))
      (tails (library-library-weak-from-difference
              lib (halving-proofs-length fast-tail) (halving-proofs-length middle-tail)
              delta nil))
      (small-tail (halving-proofs-length-equation lib fast-tail cons-tail))
      (positive-small (halving-proofs-positive-length lib small-tail))
      (positive-middle (library-library-compare-chain lib positive-small tails))
      (fine (library-library-cite lib "LEN-CDR-LESS" (list fast-tail) (list cons-tail)))
      (fits (library-library-compare-chain lib fine tails))
      (fits (library-library-as-weak lib fits))
      (condition (product-arithmetic-conjoin lib (list fits positive-middle))))
     (list condition middle-eq))))

(defun halving-proofs-halving-rule (lib function)
  (let* ((proof (library-library-proof lib))
         (definition (assoc-equal function (proof-proof-definitions proof)))
         (x *library-x*)
         (y *library-y*)
         (z *library-z*))
    (if (not (and definition (equal (len (cadr definition)) 3)))
        nil
      (proof-with-checked-results
       ((opened (proof-proof-unfold proof (list function y x z)))
        (first (proof-step-first opened))
        (actual (proof-term-at first 2))
        (pair (list *proof-cons* z (list *proof-cons* y *proof-false*)))
        (child (list function (list *library-cdr* y) (list *library-cdr* (list *library-cdr* x))
                     (list *proof-cons* (list *library-car* y) z))))
       (and (equal actual (proof-ite (halving-proofs-split-test x) pair child))
            opened)))))

(defun halving-proofs-base-projection (proof base reducer slot indexed projections)
  (proof-with-checked-results
   ((reduction (book-logic-reducer-reduce reducer indexed nil))
    (reduced (car reduction))
    (reverse (proof-proof-symmetric proof reduced))
    (base (proof-proof-rewrite-result proof base reverse projections slot)))
   (cons base (cdr reduction))))

(defun halving-proofs-lemma-base (lib opening conditional pair template positive-middle)
  (let* ((proof (library-library-proof lib))
         (z *library-z*)
         (y *library-y*)
         (length-z (halving-proofs-length z))
         (kept (library-plus length-z (halving-proofs-length y))))
    (proof-with-checked-results
     ((reflexive (proof-proof-reflexive proof kept))
      (type-z (library-library-type-of lib length-z nil))
      (weak (library-library-cite lib "WEAK-REFLEXIVE" (list length-z) (list type-z)))
      (base (product-arithmetic-conjoin lib (list reflexive weak positive-middle)))
      (projections (halving-proofs-properties *halving-proofs-first* *halving-proofs-second* y z))
      (reducer (book-logic-reducer-init
                lib nil
                (list *halving-proofs-mv-nth* *halving-proofs-zp* *rulers-atom* *rulers-endp*
                      *proof-not*)
                nil 130 160 nil nil))
      (indexed (halving-proofs-lengths pair))
      (first (halving-proofs-base-projection proof base reducer *halving-proofs-first*
                                             (car indexed) projections))
      (second (halving-proofs-base-projection proof (car first) (cdr first) *halving-proofs-second*
                                              (cadr indexed) projections))
      (selected (proof-proof-if-true proof conditional))
      (selected (proof-proof-chain proof opening (list selected)))
      (reverse (proof-proof-symmetric proof selected)))
     (proof-proof-rewrite-result proof (car second) reverse template *proof-result*))))

(defun halving-proofs-lemma-step (lib opening conditional child template induction bound test)
  (let* ((x *library-x*)
         (y *library-y*)
         (z *library-z*)
         (next-middle (cadr child))
         (next-fast (caddr child))
         (next-acc (cadddr child)))
    (proof-with-checked-results
     ((rulers (rulers-rulers-init lib (list (list test nil)) nil))
      (found-fast (rulers-rulers-require rulers (list *proof-consp* x)))
      (found-tail (rulers-rulers-require (cdr found-fast)
                                         (list *proof-consp* (list *library-cdr* x))))
      (advance (halving-proofs-take-step lib x y (car found-fast) (car found-tail) bound))
      (condition (car advance))
      (middle-eq (cadr advance))
      (decrease-result (termination-proofs-structural-decrease
                        lib (list *proof-ordinal-less* (list *library-count* next-fast)
                                  (list *library-count* x)) (cdr found-tail)))
      (decrease (car decrease-result))
      (lib (cdr decrease-result))
      (proof (library-library-proof lib))
      (at (book-logic-tree-induction-at induction next-fast decrease
                                        (list (list y next-middle) (list z next-acc))))
      (ih (car at))
      (induction (cdr at))
      (ih (proof-proof-modus-ponens proof ih condition))
      (retained-and-rests (proof-proof-conjunct proof ih))
      (retained (car retained-and-rests))
      (properties (proof-proof-conjunct proof (cadr retained-and-rests)))
      (first (car properties))
      (second (cadr properties))
      (new-acc (halving-proofs-cons-length lib (cadr next-acc) (caddr next-acc)))
      (moved (proof-proof-rewrite proof retained new-acc '(1 2 1)))
      (moved-first (proof-step-first moved))
      (middle-first (proof-step-first middle-eq))
      (total (library-library-linear-equal
              lib (caddr moved-first) (library-plus (halving-proofs-length z) (caddr middle-first))
              nil))
      (moved (proof-proof-chain proof moved (list total)))
      (reverse (proof-proof-symmetric proof middle-eq))
      (equal-step (proof-proof-rewrite proof moved reverse '(1 2 2)))
      (equal-step (proof-proof-tidy proof equal-step))
      (type-z (library-library-type-of lib (halving-proofs-length z) nil))
      (grew (library-library-cite lib "SUCCESSOR-LARGER" (list (halving-proofs-length z))
                                  (list type-z)))
      (grew (library-library-transport-argument lib grew new-acc 2))
      (first (library-library-compare-chain lib grew first))
      (first (library-library-as-weak lib first))
      (selected (proof-proof-if-false proof conditional))
      (selected (proof-proof-chain proof opening (list selected)))
      (step (product-arithmetic-conjoin lib (list equal-step first second)))
      (reverse (proof-proof-symmetric proof selected))
      (step (proof-proof-rewrite-result proof step reverse template *proof-result*)))
     (cons (list step induction) lib))))

(defun halving-proofs-halving-lemma (lib opening)
  (let ((x *library-x*)
        (y *library-y*)
        (z *library-z*)
        (proof (library-library-proof lib)))
    (proof-with-checked-results
     ((first (proof-step-first opening))
      (source (proof-write first))
      (suffix (text-upper (seq-slice (siphash-hexdigest source) 0 16)))
      (label (string-append "SPLIT-LENGTHS-" suffix)))
     (if (assoc-equal (proof-sym (string-append "SELF-" label) "ACL2")
                      (proof-proof-facts proof))
         (cons label lib)
       (proof-with-checked-results
        ((equation (proof-list-of-length (cdr first) 2))
         (call (car equation))
         (conditional (cadr equation))
         (branches (proof-list-of-length (cdr conditional) 3))
         (test (car branches))
         (pair (cadr branches))
         (child (proof-list-of-length (caddr branches) 4))
         (premise (proof-proof-assume proof (halving-proofs-split-hypothesis x y) t))
         (hypotheses (proof-proof-conjunct proof premise))
         (bound (car hypotheses))
         (positive-middle (cadr hypotheses))
         (premise-term (proof-step-first premise))
         (pair-lengths (halving-proofs-lengths call))
         (formula (list *library-implies* premise-term
                        (halving-proofs-properties (car pair-lengths) (cadr pair-lengths) y z)))
         (induction (book-logic-tree-induction-init lib formula x))
         (template-lengths (halving-proofs-lengths *proof-result*))
         (template (halving-proofs-properties (car template-lengths) (cadr template-lengths) y z))
         (base (halving-proofs-lemma-base lib opening conditional pair template positive-middle))
         (step-result (halving-proofs-lemma-step
                       lib opening conditional child template induction bound test))
         (lib (cdr step-result))
         (proof (library-library-proof lib))
         (step (caar step-result))
         (induction (cadar step-result))
         (both (proof-proof-cases proof test base step))
         (implication (witnesses-prove-implication lib formula premise both))
         (inductive (book-logic-tree-induction-finish induction implication))
         (lib (library-library-lemma lib label formula inductive nil)))
        (cons label lib))))))

(defun halving-proofs-descent-step (lib index child parent opened call value cons-proof cons-tail label)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
     ((equation (proof-proof-unfold proof call))
      (first (proof-step-first equation))
      (conditional (caddr first))
      (reducer (book-logic-reducer-init lib (list cons-proof cons-tail)
                                       (list *rulers-atom* *proof-not*) nil 34 120 nil nil))
      (stop (book-logic-reducer-prove reducer (proof-neg (cadr conditional))))
      (stop (car stop))
      (selected (proof-proof-select proof conditional stop))
      (selected (proof-proof-chain proof equation (list selected)))
      (first (proof-step-first selected))
      (result (caddr first))
      (middle (cadr result))
      (fast (caddr result))
      (acc (cadddr result))
      (shorter (library-library-cite lib "LEN-CDR-LESS" (list middle) (list cons-tail)))
      (middle-eq (halving-proofs-length-equation lib middle cons-tail))
      (pos-middle (halving-proofs-positive-length lib middle-eq))
      (fits (library-library-as-weak lib shorter))
      (condition (product-arithmetic-conjoin lib (list fits pos-middle)))
      (cited (library-library-cite lib label (list fast middle acc) nil))
      (premise (proof-proof-modus-ponens proof cited condition))
      (retained-and-rests (proof-proof-conjunct proof premise))
      (retained (car retained-and-rests))
      (order (proof-proof-conjunct proof (cadr retained-and-rests)))
      (at-least (car order))
      (positive-second (cadr order))
      (acc-eq (halving-proofs-cons-length lib (cadr acc) (caddr acc)))
      (positive-acc (halving-proofs-positive-length lib acc-eq))
      (positive-first (library-library-compare-chain lib positive-acc at-least))
      (nil-test (proof-proof-prove proof (proof-neg (list *proof-consp* *proof-false*))
                                  nil (list *proof-not*)))
      (nil-length (halving-proofs-length-equation lib *proof-false* nil-test))
      (acc-eq (proof-proof-rewrite proof acc-eq nil-length '(1 2 2)))
      (acc-eq (proof-proof-tidy proof acc-eq))
      (constant (proof-proof-compute proof (library-plus *proof-one* *proof-zero*) 1))
      (acc-eq (proof-proof-chain proof acc-eq (list constant)))
      (total (proof-proof-rewrite proof retained acc-eq '(1 2 1)))
      (total (proof-proof-tidy proof total))
      (parent-length (halving-proofs-length-equation lib value cons-proof))
      (reverse (proof-proof-symmetric proof parent-length))
      (total (proof-proof-chain proof total (list reverse)))
      (pair (halving-proofs-lengths result))
      (position (cadr index))
      (positive-other (if (equal position 0) positive-second positive-first))
      (first (proof-step-first total))
      (smaller (library-library-less-from-difference
                lib (nth position pair) (cadr first) positive-other nil))
      (smaller (proof-proof-rewrite proof smaller total '(1 2)))
      (equivalence (proof-proof-chain proof opened (list selected)))
      (reverse (proof-proof-symmetric proof equivalence))
      (smaller (proof-proof-rewrite proof smaller reverse '(1 1 1 2)))
      (smaller (proof-proof-tidy proof smaller))
      (comparison (library-library-ordinal-comparison lib child parent)))
     (proof-proof-transport proof smaller comparison))))

(defun halving-proofs-projection-descent (lib child parent rulers index projection value)
  (if (not (and (member-equal index (list *proof-zero* *proof-one*))
                (proof-compound projection)))
      (cons (list nil rulers) lib)
    (proof-with-checked-results
     ((function (proof-term-at projection 0))
      (proof (library-library-proof lib)))
     (if (not (assoc-equal function (proof-proof-definitions proof)))
         (cons (list nil rulers) lib)
       (proof-with-checked-results
        ((reducer (book-logic-reducer-init lib nil (list function) nil 34 130 nil nil))
         (reduction (book-logic-reducer-reduce reducer projection nil))
         (opened (car reduction))
         (first (and opened (proof-step-first opened)))
         (call (and opened (proof-term-at first 2))))
        (if (not (and opened (equal (cdr call) (list value value *proof-false*))))
            (cons (list nil rulers) lib)
          (proof-with-checked-results
           ((opening (halving-proofs-halving-rule lib (car call))))
           (if (not opening)
               (cons (list nil rulers) lib)
             (proof-with-checked-results
              ((found (rulers-rulers-find rulers (list *proof-consp* value)))
               (cons-proof (car found))
               (tail (list *library-cdr* value))
               (found (rulers-rulers-find (cdr found) (list *proof-consp* tail)))
               (cons-tail (car found))
               (rulers (cdr found)))
              (if (not (and cons-proof cons-tail))
                  (cons (list nil rulers) lib)
                (proof-with-checked-results
                 ((lemma (halving-proofs-halving-lemma lib opening))
                  (rulers (halved-counters-rulers-for-library rulers lib (cdr lemma)))
                  (lib (cdr lemma))
                  (step (halving-proofs-descent-step lib index child parent opened call
                                                     value cons-proof cons-tail (car lemma))))
                 (cons (list step rulers) lib))))))))))))

(defun halving-proofs-halving-descent-with-rulers (lib goal rulers)
  (proof-with-checked-results
   ((goal (proof-list-of-length goal 3)))
   (let ((child (cadr goal))
         (parent (caddr goal)))
     (if (not (and (proof-is-call parent *library-len*)
                   (proof-is-call child *library-len*)))
         (cons (list nil rulers) lib)
       (proof-with-checked-results
        ((projection-call (proof-term-at child 1)))
        (if (not (proof-is-call projection-call *halving-proofs-mv-nth*))
            (cons (list nil rulers) lib)
          (proof-with-checked-results
           ((projection-call (proof-list-of-length projection-call 3))
            (value (proof-term-at parent 1)))
           (halving-proofs-projection-descent lib child parent rulers
                                              (cadr projection-call)
                                              (caddr projection-call) value))))))))

(defun halving-proofs-halving-descent (lib goal rulers)
  (proof-with-checked-results
   ((result (halving-proofs-halving-descent-with-rulers lib goal rulers)))
   (cons (caar result) (cdr result))))
