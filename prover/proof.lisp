(in-package "BOYMOO-PROVER")
(set-verify-guards-eagerness 0)

(defun proof-make-proof (facts definitions primitives)
  (list :proof facts definitions primitives))

(defun proof-proof-facts (proof)
  (cadr proof))

(defun proof-proof-definitions (proof)
  (caddr proof))

(defun proof-proof-primitives (proof)
  (cadddr proof))

(defun proof-proof-kind (proof)
  (or (car (cddddr proof)) :base))

(defun proof-proof-with-kind (proof kind)
  (let ((base (proof-make-proof (proof-proof-facts proof)
                                (proof-proof-definitions proof)
                                (proof-proof-primitives proof))))
    (if (eq kind :base)
        base
      (append base (list kind)))))

(defun proof-proof-with-facts (proof facts)
  (proof-proof-with-kind
   (proof-make-proof facts
                     (proof-proof-definitions proof)
                     (proof-proof-primitives proof))
   (proof-proof-kind proof)))

(defun proof-make-step (word data clause)
  (list :step word data clause))

(defun proof-step-p (value)
  (and (consp value)
       (eq (car value) :step)
       (consp (cdr value))
       (consp (cddr value))
       (consp (cdddr value))
       (null (cddddr value))))

(defun proof-step-word (step)
  (cadr step))

(defun proof-step-data (step)
  (caddr step))

(defun proof-step-clause (step)
  (cadddr step))

(defun proof-index-failure ()
  '(:failure "index" ""))

(defun proof-step-first (step)
  (let ((clause (proof-step-clause step)))
    (if (consp clause)
        (car clause)
      (proof-index-failure))))

(defun proof-sym (name package)
  (list "sym" package name))

(defun proof-cl (name)
  (proof-sym name "COMMON-LISP"))

(defconst *proof-nil* (proof-cl "NIL"))
(defconst *proof-t* (proof-cl "T"))
(defconst *proof-quote* (proof-cl "QUOTE"))
(defconst *proof-if* (proof-cl "IF"))
(defconst *proof-equal* (proof-cl "EQUAL"))
(defconst *proof-not* (proof-cl "NOT"))
(defconst *proof-cons* (proof-cl "CONS"))
(defconst *proof-consp* (proof-cl "CONSP"))
(defconst *proof-integerp* (proof-cl "INTEGERP"))
(defconst *proof-less* (proof-cl "<"))
(defconst *proof-plus* (proof-sym "BINARY-+" "ACL2"))
(defconst *proof-times* (proof-sym "BINARY-*" "ACL2"))
(defconst *proof-minus* (proof-sym "UNARY--" "ACL2"))
(defconst *proof-ordinalp* (proof-sym "O-P" "ACL2"))
(defconst *proof-ordinal-less* (proof-sym "O<" "ACL2"))
(defconst *proof-result* (proof-sym "SELF-RESULT" "ACL2"))

(defun proof-quote (datum)
  (list *proof-quote* datum))

(defconst *proof-false* (proof-quote *proof-nil*))
(defconst *proof-true* (proof-quote *proof-t*))
(defconst *proof-zero* (proof-quote 0))
(defconst *proof-one* (proof-quote 1))
(defconst *proof-neg-one* (proof-quote -1))

(defun proof-eq (left right)
  (list *proof-equal* left right))

(defun proof-neg (term)
  (list *proof-not* term))

(defun proof-ite (test yes no)
  (list *proof-if* test yes no))

(defun proof-freeze (datum)
  datum)

(defun proof-compound (datum)
  (or (null datum)
      (and (consp datum) (not (stringp (car datum))))))

(defun proof-is-call (term head)
  (and (consp term)
       (proof-compound term)
       (equal (car term) head)))

(mutual-recursion
 (defun proof-thaw (datum)
   (declare (xargs :measure (1+ (* 2 (acl2-count datum)))))
   (cond ((null datum) *proof-nil*)
         ((and (consp datum) (proof-compound datum))
          (proof-thaw-list datum))
         ((and (consp datum) (equal (car datum) "dot"))
          (if (endp (cdr datum))
              (proof-index-failure)
            (let ((tail (proof-thaw (cadr datum))))
              (if (failure-p tail) tail (list "dot" tail)))))
         (t datum)))
 (defun proof-thaw-list (data)
   (declare (xargs :measure (* 2 (acl2-count data))))
   (if (endp data)
       nil
     (let ((datum (proof-thaw (car data))))
       (if (failure-p datum)
           datum
         (let ((rest (proof-thaw-list (cdr data))))
           (if (failure-p rest) rest (cons datum rest))))))))

(defun proof-write (datum)
  (let ((thawed (proof-thaw datum)))
    (if (failure-p thawed) thawed (reader-write thawed))))

(defun proof-write-list (data)
  (if (endp data)
      nil
    (let ((datum (proof-write (car data))))
      (if (failure-p datum)
          datum
        (let ((rest (proof-write-list (cdr data))))
          (if (failure-p rest) rest (cons datum rest)))))))

(defun proof-line (word data)
  (let ((args (proof-write-list data)))
    (if (failure-p args)
        args
      (concatenate 'string "(" (text-join " " (cons word args)) ")"
                   (coerce (list #\Newline) 'string)))))

(defun proof-bytes-text (bytes)
  (concatenate 'string "b" (text-quoted bytes)))

(defun proof-paren-text (parts)
  (concatenate 'string "(" (text-join ", " parts)
               (if (and (consp parts) (endp (cdr parts))) ",)" ")")))

; The reader tags are strings. Symbol names and string datum contents are bytes.
(mutual-recursion
 (defun proof-datum-text (datum)
   (declare (xargs :measure (acl2-count datum)))
   (cond ((null datum) "()")
         ((eq datum t) "True")
         ((integerp datum) (decimal-text datum))
         ((stringp datum) (text-quoted datum))
         ((consp datum)
          (proof-paren-text
           (cons (proof-datum-text (car datum))
                 (proof-datum-text-items (cdr datum)
                                   (member-equal (car datum) '("sym" "str"))))))
         (t "")))
 (defun proof-datum-text-items (items byte-fields)
   (declare (xargs :measure (acl2-count items)))
   (if (endp items)
       nil
     (cons (if (and byte-fields (stringp (car items)))
               (proof-bytes-text (car items))
             (proof-datum-text (car items)))
           (proof-datum-text-items (cdr items) byte-fields)))))

(defun proof-length-failure (expected found)
  (list :failure "value"
        (if (< expected found)
            (concatenate 'string "too many values to unpack (expected "
                         (decimal-text expected) ")")
          (concatenate 'string "not enough values to unpack (expected "
                       (decimal-text expected) ", got " (decimal-text found) ")"))))

(mutual-recursion
 (defun proof-subst (term bindings)
   (declare (xargs :measure (acl2-count term)))
   (cond ((not (proof-compound term))
          (table-get bindings term term))
         ((endp term) (proof-index-failure))
         ((equal (car term) *proof-quote*) term)
         (t
          (let ((args (proof-subst-arguments (cdr term) bindings)))
            (if (failure-p args)
                args
              (cons (car term) args))))))
 (defun proof-subst-arguments (arguments bindings)
   (declare (xargs :measure (acl2-count arguments)))
   (if (endp arguments)
       nil
     (let ((first (proof-subst (car arguments) bindings)))
       (if (failure-p first)
           first
         (let ((rest (proof-subst-arguments (cdr arguments) bindings)))
           (if (failure-p rest) rest (cons first rest))))))))

(defun proof-change (term place old new)
  (declare (xargs :measure (acl2-count place)))
  (if (endp place)
      (if (equal term old)
          new
        (list :failure "assertion" ""))
    (let ((index (car place)))
      (cond ((not (proof-compound term)) '(:failure "assertion" ""))
            ((endp term) (proof-index-failure))
            ((or (equal (car term) *proof-quote*)
                 (not (and (integerp index) (< 0 index) (< index (len term)))))
             '(:failure "assertion" ""))
            (t
             (let ((changed (proof-change (nth index term) (cdr place) old new)))
               (if (failure-p changed)
                   changed
                 (append (take index term)
                         (cons changed (nthcdr (1+ index) term))))))))))

(defun proof-unique-items (items seen)
  (if (endp items)
      nil
    (if (member-equal (car items) seen)
        (proof-unique-items (cdr items) seen)
      (cons (car items) (proof-unique-items (cdr items) (cons (car items) seen))))))

(defun proof-unique (items)
  (proof-unique-items items nil))

; The result of a visit carries its number, the step and line dictionaries,
; and the next free number. The line dictionary has the newest entry first.
(mutual-recursion
 (defun proof-serialize-visit (step numbers emitted next)
   (declare (xargs :measure (acl2-count step)))
   (if (not (proof-step-p step))
       '(:failure "attribute" "")
     (let ((number (assoc-equal step numbers)))
       (if number
           (list (cdr number) numbers emitted next)
         (let ((args (proof-serialize-visit-args (proof-step-data step)
                                                numbers emitted next)))
           (if (failure-p args)
               args
             (let ((source (proof-line (proof-step-word step) (car args))))
               (if (failure-p source)
                   source
                 (let* ((numbers (cadr args))
                        (emitted (caddr args))
                        (next (cadddr args))
                        (old (assoc-equal source emitted)))
                   (if old
                       (list (cdr old) (acons step (cdr old) numbers) emitted next)
                     (list next (acons step next numbers) (acons source next emitted)
                           (1+ next))))))))))))
 (defun proof-serialize-visit-args (data numbers emitted next)
   (declare (xargs :measure (acl2-count data)))
   (if (endp data)
       (list nil numbers emitted next)
     (let ((first (if (proof-step-p (car data))
                      (proof-serialize-visit (car data) numbers emitted next)
                    (list (car data) numbers emitted next))))
       (if (failure-p first)
           first
         (let ((rest (proof-serialize-visit-args (cdr data) (cadr first)
                                               (caddr first) (cadddr first))))
           (if (failure-p rest)
               rest
             (cons (cons (car first) (car rest)) (cdr rest)))))))))

(defun proof-emitted-lines (emitted lines)
  (if (endp emitted)
      lines
    (proof-emitted-lines (cdr emitted) (cons (caar emitted) lines))))

(defun proof-serialize (last)
  (let ((visited (proof-serialize-visit last nil nil 1)))
    (if (failure-p visited)
        visited
      (proof-emitted-lines (caddr visited) nil))))

(defun proof-entry-proofs (proofs)
  (if (endp proofs)
      (list nil nil)
    (let ((steps (proof-serialize (car proofs))))
      (if (failure-p steps)
          steps
        (let ((rest (proof-entry-proofs (cdr proofs))))
          (if (failure-p rest)
              rest
            (list (cons (len steps) (car rest))
                  (append steps (cons (proof-line "qed" nil) (cadr rest))))))))))

(defun proof-proof-entry (kind name fields proofs)
  (let ((header (proof-line kind fields)))
    (if (failure-p header)
        header
      (let ((body (proof-entry-proofs proofs)))
        (if (failure-p body)
            body
          (list kind name (car body) (text-join "" (cons header (cadr body)))))))))

(defun proof-proof-add-definition (proof name formals body)
  (let* ((formals (if (equal formals *proof-nil*) nil formals))
         (definitions (table-put (proof-proof-definitions proof)
                                   name (list formals body)))
         (clause (list (proof-eq (cons name formals) body)))
         (facts (table-put (proof-proof-facts proof) name clause)))
    (proof-proof-with-kind
     (proof-make-proof facts definitions (proof-proof-primitives proof))
     (proof-proof-kind proof))))

(defun proof-add-ground-definitions (definitions proof)
  (if (endp definitions)
      proof
    (let ((definition (car definitions)))
      (proof-add-ground-definitions
       (cdr definitions)
       (proof-proof-add-definition proof (car definition) (cadr definition)
                                   (caddr definition))))))

(defun proof-init-records (records proof)
  (if (endp records)
      (proof-make-proof (proof-proof-facts proof)
                        (proof-proof-definitions proof)
                        (seq-sorted (proof-proof-primitives proof)))
    (let* ((record (car records))
           (word (car record))
           (data (cdr record))
           (name (car data))
           (next (cond ((equal word "clause")
                        (proof-proof-with-facts
                         proof (table-put (proof-proof-facts proof) name (cdr data))))
                       ((equal word "define")
                        (proof-add-ground-definitions (cdr data) proof))
                       ((and (equal word "primitive")
                             (not (member-equal name (proof-proof-primitives proof))))
                        (proof-make-proof (proof-proof-facts proof)
                                          (proof-proof-definitions proof)
                                          (cons name (proof-proof-primitives proof))))
                       (t proof))))
      (proof-init-records (cdr records) next))))

(defun proof-nonidentity-pairs (bindings)
  (if (endp bindings)
      nil
    (let* ((pair (car bindings))
           (size (len pair)))
      (if (equal size 2)
          (let ((rest (proof-nonidentity-pairs (cdr bindings))))
            (cond ((failure-p rest) rest)
                  ((equal (car pair) (cadr pair)) rest)
                  (t (cons pair rest))))
        (proof-length-failure 2 size)))))

(defun proof-bindings-table (pairs bindings)
  (if (endp pairs)
      bindings
    (proof-bindings-table (cdr pairs)
                         (table-put bindings (caar pairs) (cadar pairs)))))

(defun proof-proof-instantiate (proof step bindings)
  (declare (ignore proof))
  (let ((pairs (proof-nonidentity-pairs bindings)))
    (cond ((failure-p pairs) pairs)
          ((endp pairs) step)
          (t
           (let ((mapping (proof-bindings-table pairs nil)))
             (if (equal (len mapping) (len pairs))
                 (let ((clause (proof-subst-arguments (proof-step-clause step) mapping)))
                   (if (failure-p clause)
                       clause
                     (proof-make-step "instantiate" (list step pairs) clause)))
               '(:failure "assertion" "")))))))

(defun proof-proof-fact (proof name bindings)
  (let* ((name (if (stringp name) (list "str" name) name))
         (fact (assoc-equal name (proof-proof-facts proof))))
    (if fact
        (proof-proof-instantiate proof (proof-make-step "fact" (list name) (cdr fact))
                                 bindings)
      (list :failure "key" ""))))

(defun proof-subsumed-p (source clause)
  (if (endp source)
      t
    (and (or (equal (car source) *proof-false*)
             (member-equal (car source) clause))
         (proof-subsumed-p (cdr source) clause))))

(defun proof-proof-subsume (proof step clause)
  (declare (ignore proof))
  (let ((original (proof-step-clause step)))
    (cond ((equal original clause) step)
          ((proof-subsumed-p original clause)
           (proof-make-step "subsume" (cons step clause) clause))
          (t (list :failure "assertion" "")))))

(defun proof-without-literal (clause literal)
  (if (endp clause)
      nil
    (if (equal (car clause) literal)
        (proof-without-literal (cdr clause) literal)
      (cons (car clause) (proof-without-literal (cdr clause) literal)))))

(defun proof-proof-tidy (proof step)
  (proof-proof-subsume proof step
                       (proof-unique (proof-without-literal
                                      (proof-step-clause step) *proof-false*))))

(defun proof-proof-front (proof step literal)
  (let ((clause (proof-step-clause step)))
    (if (member-equal literal clause)
        (proof-proof-subsume
         proof step (cons literal (proof-without-literal clause literal)))
      '(:failure "assertion" ""))))

(defun proof-proof-cut (proof positive negative)
  (let* ((negative-first (proof-step-first negative))
         (positive-first (proof-step-first positive)))
    (cond ((failure-p negative-first) negative-first)
          ((failure-p positive-first) positive-first)
          ((equal negative-first (proof-neg positive-first))
           (proof-proof-tidy
            proof (proof-make-step "cut" (list positive negative)
                                   (append (cdr (proof-step-clause positive))
                                           (cdr (proof-step-clause negative))))))
          (t '(:failure "assertion" "")))))

(defun proof-discharge-error (step evidence-first)
  (let ((first (proof-write evidence-first)))
    (if (failure-p first)
        first
      (let ((clause (proof-write-list (proof-step-clause step))))
        (if (failure-p clause)
            clause
          '(:failure "value" ""))))))

(defun proof-discharge-sides (sides proof step evidence main evidence-first)
  (if (endp sides)
      (proof-discharge-error step evidence-first)
    (let* ((side (car sides))
           (positive (equal side (proof-neg evidence-first))))
      (cond ((and (not positive) (not (equal evidence-first (proof-neg side))))
             (proof-discharge-sides (cdr sides) proof step evidence main evidence-first))
            ((equal (proof-step-clause evidence) (list evidence-first side)) step)
            (t
             (let ((guard (proof-proof-front proof step side)))
               (if (failure-p guard)
                   guard
                 (let ((result (if positive
                                   (proof-proof-cut proof evidence guard)
                                 (proof-proof-cut proof guard evidence))))
                   (if (failure-p result)
                       result
                     (proof-proof-front proof result main))))))))))

(defun proof-discharge (proof step evidence)
  (let* ((main (proof-step-first step))
         (evidence-first (proof-step-first evidence)))
    (cond ((failure-p main) main)
          ((failure-p evidence-first) evidence-first)
          (t (proof-discharge-sides (cdr (proof-step-clause step))
                                     proof step evidence main evidence-first)))))

(defun proof-use-evidence (evidence proof step used)
  (if (endp evidence)
      step
    (let* ((premise (car evidence))
           (first (proof-step-first premise)))
      (cond ((failure-p first) first)
            ((member-equal first used)
             (proof-use-evidence (cdr evidence) proof step used))
            (t
             (let ((discharged (proof-discharge proof step premise)))
               (if (failure-p discharged)
                   discharged
                 (proof-use-evidence
                  (cdr evidence) proof discharged (cons first used)))))))))

(defun proof-proof-use (proof name bindings evidence)
  (let ((step (proof-proof-fact proof name bindings)))
    (if (failure-p step) step (proof-use-evidence evidence proof step nil))))

(defun proof-rewrite-at (step equality place old new)
  (if (endp place)
      (proof-index-failure)
    (let* ((clause (proof-step-clause step))
           (size (len clause))
           (index (1- (car place)))
           (offset (if (< index 0) (+ size index) index)))
      (if (or (< offset 0) (<= size offset))
          (proof-index-failure)
        (let ((literal (proof-change (nth offset clause) (cdr place) old new)))
          (if (failure-p literal)
              literal
            (let ((replaced (append (seq-slice clause 0 index)
                                    (cons literal (seq-slice clause (1+ index) :none)))))
              (proof-make-step "substitute" (list* equality step place)
                               (append replaced (cdr (proof-step-clause equality)))))))))))

(defun proof-proof-rewrite (proof step equality place)
  (declare (ignore proof))
  (let ((first (proof-step-first equality)))
    (cond ((failure-p first) first)
          ((integerp first) '(:failure "type" ""))
          ((not (equal (len first) 3)) (proof-length-failure 3 (len first)))
          ((not (equal (car first) *proof-equal*)) '(:failure "assertion" ""))
          (t (proof-rewrite-at step equality place (cadr first) (caddr first))))))

; A traversal can yield places before trying to inspect an empty tuple.
(mutual-recursion
 (defun proof-locate-places (term place slot)
   (declare (xargs :measure (acl2-count term)))
   (cond ((equal term slot) (list (list place) nil))
         ((not (proof-compound term)) (list nil nil))
         ((endp term) (list nil (proof-index-failure)))
         ((equal (car term) *proof-quote*) (list nil nil))
         (t (proof-places-arguments (cdr term) place slot 1))))
 (defun proof-places-arguments (arguments place slot index)
   (declare (xargs :measure (acl2-count arguments)))
   (if (endp arguments)
       (list nil nil)
     (let ((first (proof-locate-places (car arguments) (append place (list index)) slot)))
       (if (cadr first)
           first
         (let ((rest (proof-places-arguments (cdr arguments) place slot (1+ index))))
           (list (append (car first) (car rest)) (cadr rest))))))))

(defun proof-rewrite-places (places failure proof step equality)
  (if (endp places)
      (or failure (proof-proof-tidy proof step))
    (let ((step (proof-proof-rewrite proof step equality (car places))))
      (if (failure-p step)
          step
        (proof-rewrite-places (cdr places) failure proof step equality)))))

(defun proof-proof-rewrite-result (proof step equality template slot)
  (let ((located (proof-locate-places template '(1) slot)))
    (proof-rewrite-places (car located) (cadr located) proof step equality)))

(defun proof-proof-rewrite-first (proof step equality)
  (let* ((first (proof-step-first step))
         (equation (proof-step-first equality)))
    (cond ((failure-p first) first)
          ((failure-p equation) equation)
          ((integerp equation) '(:failure "type" ""))
          ((endp (cdr equation)) (proof-index-failure))
          (t (proof-proof-rewrite-result proof step equality first (cadr equation))))))

(defun proof-proof-beta (proof term)
  (declare (ignore proof))
  (if (endp term)
      '(:failure "value" "")
    (let ((head (car term)))
      (cond ((integerp head) '(:failure "type" ""))
            ((not (equal (len head) 3)) (proof-length-failure 3 (len head)))
            (t
             (let* ((bindings (proof-bindings-table (seq-zip (cadr head) (cdr term)) nil))
                    (body (proof-subst (caddr head) bindings)))
               (if (failure-p body)
                   body
                 (proof-make-step "beta" (list term) (list (proof-eq term body))))))))))

(defun proof-all-quoted-p (arguments)
  (if (endp arguments)
      t
    (and (proof-is-call (car arguments) *proof-quote*)
         (proof-all-quoted-p (cdr arguments)))))

(defun proof-proof-compute (proof term value)
  (cond ((integerp term) '(:failure "type" ""))
        ((endp term) (proof-index-failure))
        ((and (member-equal (car term) (proof-proof-primitives proof))
              (proof-all-quoted-p (cdr term)))
         (proof-make-step "compute" (list term) (list (proof-eq term (proof-quote value)))))
        (t '(:failure "assertion" ""))))

(defun proof-proof-induct-hypothesis (pairs formula measure)
  (let* ((bindings (proof-bindings-table pairs nil))
         (smaller (proof-subst measure bindings)))
    (if (failure-p smaller)
        smaller
      (let ((claim (proof-subst formula bindings)))
        (if (failure-p claim)
            claim
          (proof-neg (proof-ite (list *proof-ordinal-less* smaller measure)
                                claim *proof-true*)))))))

(defun proof-induction-hypotheses (substitutions formula measure)
  (if (endp substitutions)
      (list formula)
    (let ((first (proof-proof-induct-hypothesis (car substitutions) formula measure)))
      (if (failure-p first)
          first
        (let ((rest (proof-induction-hypotheses (cdr substitutions) formula measure)))
          (if (failure-p rest) rest (cons first rest)))))))

(defun proof-proof-induct (proof ordinal case formula measure substitutions)
  (if (equal (proof-step-clause ordinal) (list (list *proof-ordinalp* measure)))
      (let ((clause (proof-induction-hypotheses substitutions formula measure)))
        (if (failure-p clause)
            clause
          (let ((case (proof-proof-subsume proof case clause)))
            (if (failure-p case)
                case
              (proof-make-step "induct" (list ordinal case formula measure substitutions)
                               (list formula))))))
    '(:failure "assertion" "")))

; The clauses, definitions and primitives of spec/ground.txt.
(defconst *proof-ground*
  (proof-init-records
   '(
     ("primitive" ("sym" "ACL2" "ACL2-NUMBERP") 1)
     ("primitive" ("sym" "ACL2" "BAD-ATOM<=") 2)
     ("primitive" ("sym" "ACL2" "BINARY-*") 2)
     ("primitive" ("sym" "ACL2" "BINARY-+") 2)
     ("primitive" ("sym" "ACL2" "UNARY--") 1)
     ("primitive" ("sym" "ACL2" "UNARY-/") 1)
     ("primitive" ("sym" "COMMON-LISP" "<") 2)
     ("primitive" ("sym" "COMMON-LISP" "CAR") 1)
     ("primitive" ("sym" "COMMON-LISP" "CDR") 1)
     ("primitive" ("sym" "COMMON-LISP" "CHAR-CODE") 1)
     ("primitive" ("sym" "COMMON-LISP" "CHARACTERP") 1)
