(in-package "BOYMOO-PROVER")
(set-verify-guards-eagerness 0)

(defconst *book-proofs-newline* (coerce (list #\Newline) 'string))
(defconst *book-proofs-fact-kinds*
  '("(define " "(theorem " "(axiom " "(constrain "))

(defmacro book-proofs-let* (bindings body)
  (if (endp bindings)
      body
    (let ((name (caar bindings)))
      `(let (,(car bindings))
         (if (failure-p ,name)
             ,name
           (book-proofs-let* ,(cdr bindings) ,body))))))

(defun run-helper-name-char-p (char)
  (and (characterp char)
       (let ((byte (char-code char)))
         (or (and (<= 65 byte) (<= byte 90))
             (and (<= 48 byte) (<= byte 57))
             (eql char #\-)))))

(defun run-helper-name-suffix (chars suffix)
  (cond ((endp chars) nil)
        ((run-helper-name-char-p (car chars))
         (run-helper-name-suffix (cdr chars) (cons (car chars) suffix)))
        ((and (consp suffix) (member-equal (car chars) '(#\Space #\))))
         (reverse suffix))
        (t nil)))

(defun run-helper-name-at (chars)
  (let ((prefix (cond ((equal (take 11 chars) '(#\A #\C #\L #\2 #\: #\: #\S #\E #\L #\F #\-))
                       "ACL2::SELF-")
                      ((equal (take 9 chars) '(#\A #\C #\L #\2 #\: #\: #\T #\1 #\-))
                       "ACL2::T1-")
                      (t nil))))
    (and prefix
         (let ((suffix (run-helper-name-suffix
                        (nthcdr (length prefix) chars) nil)))
           (and suffix (concatenate 'string prefix (coerce suffix 'string)))))))

(defun run-helper-names-scan (chars)
  (if (endp chars)
      nil
    (let ((matched (and (member-equal (car chars) '(#\Space #\())
                        (eql (cadr chars) #\A)
                        (run-helper-name-at (cdr chars)))))
      (if matched
          (cons matched (run-helper-names-scan (cdr chars)))
        (run-helper-names-scan (cdr chars))))))

(defun run-helper-names (source)
  (run-helper-names-scan (coerce source 'list)))

(defun run-split-byte-lines-scan (chars reversed)
  (cond ((endp chars) (and reversed (list (coerce (reverse reversed) 'string))))
        ((eql (car chars) #\Newline)
         (cons (coerce (reverse reversed) 'string)
               (run-split-byte-lines-scan (cdr chars) nil)))
        ((eql (car chars) #\Return)
         (cons (coerce (reverse reversed) 'string)
               (if (and (consp (cdr chars)) (eql (cadr chars) #\Newline))
                   (run-split-byte-lines-scan (cddr chars) nil)
                 (run-split-byte-lines-scan (cdr chars) nil))))
        (t (run-split-byte-lines-scan (cdr chars) (cons (car chars) reversed)))))

(defun run-split-byte-lines (source)
  (run-split-byte-lines-scan (coerce source 'list) nil))

(defun run-parse-line (raw)
  (book-proofs-let* ((parsed (reader-reader-line (reader-reader-init raw))))
    (list (caar parsed) (proof-freeze (cadar parsed)))))

(defun run-definition-names (definitions)
  (if (endp definitions)
      nil
    (book-proofs-let* ((name (proof-term-at (car definitions) 0))
                      (rest (run-definition-names (cdr definitions))))
      (cons name rest))))

(defun run-entry-names (entry)
  (book-proofs-let* ((entry (proof-list-of-length entry 4)))
    (if (equal (car entry) "define")
        (book-proofs-let* ((parsed (run-parse-line
                                   (car (text-split-max (cadddr entry)
                                                      *book-proofs-newline* 1)))))
          (run-definition-names (cdr (cadr parsed))))
      (list (cadr entry)))))

(defun run-needed-entry-p (names needed)
  (if (endp names)
      nil
    (book-proofs-let* ((spelling (proof-write (car names))))
      (if (member-equal spelling needed)
          t
        (run-needed-entry-p (cdr names) needed)))))

(defun run-required-entries-select (entries needed selected)
  (if (endp entries)
      selected
    (let ((entry (car entries)))
      (book-proofs-let* ((names (run-entry-names entry))
                        (needed-p (run-needed-entry-p names needed)))
        (if needed-p
            (run-required-entries-select
             (cdr entries)
             (append (run-helper-names (cadddr entry)) needed)
             (cons entry selected))
          (run-required-entries-select (cdr entries) needed selected))))))

(defun run-required-entries (entries last)
  (book-proofs-let* ((source (proof-term-at last 3)))
    (run-required-entries-select (reverse entries) (run-helper-names source) (list last))))

(defun run-add-statement-definition (proof definition)
  (let ((size (len definition))
        (formals (cadr definition)))
    (cond ((integerp definition)
           '(:failure "failure" ""))
          ((equal size 0)
           '(:failure "failure" ""))
          ((equal size 1)
           '(:failure "failure" ""))
          ((equal size 2)
           '(:failure "failure" ""))
          ((< 3 size)
           '(:failure "failure" ""))
          ((integerp formals) '(:failure "failure" ""))
          ((stringp formals) '(:failure "failure" ""))
          (t (proof-proof-add-definition proof (car definition) formals (caddr definition))))))

(defun run-add-statement-definitions (proof definitions)
  (declare (xargs :measure (acl2-count definitions)))
  (if (endp definitions)
      proof
    (book-proofs-let* ((proof (run-add-statement-definition proof (car definitions))))
      (run-add-statement-definitions proof (cdr definitions)))))

(defun run-add-statement-formulas (facts formulas)
  (declare (xargs :measure (acl2-count formulas)))
  (if (endp formulas)
      facts
    (book-proofs-let* ((pair (proof-list-of-length (car formulas) 2)))
      (run-add-statement-formulas (table-put facts (car pair) (list (cadr pair))) (cdr formulas)))))

(defun run-add-statement (lib kind data)
  (let* ((proof (library-library-proof lib))
         (facts (proof-proof-facts proof)))
    (cond ((equal kind "define")
           (book-proofs-let* ((proof (run-add-statement-definitions proof (cdr data))))
             (library-library-with-proof lib proof)))
          ((member-equal kind '("axiom" "theorem"))
           (book-proofs-let* ((formula (proof-term-at data 1)))
             (library-library-with-proof
              lib (proof-proof-with-facts proof (table-put facts (car data) (list formula))))))
          ((equal kind "constrain")
           (book-proofs-let* ((formulas (proof-term-at data 1)))
             (if (equal formulas *proof-nil*)
                 lib
               (book-proofs-let* ((facts (run-add-statement-formulas facts formulas)))
                 (library-library-with-proof lib (proof-proof-with-facts proof facts))))))
          (t lib))))

(defun run-quoted-input (data)
  (concatenate 'string "(COMMON-LISP::QUOTE \"" (reader-escape data 34) "\")"))

(defun book-proofs-make-certificate (entries requirements reason)
  (list :certificate entries requirements reason))

(defun book-proofs-certificate-entries (certificate)
  (cadr certificate))

(defun book-proofs-certificate-requirements (certificate)
  (caddr certificate))

(defun book-proofs-certificate-reason (certificate)
  (cadddr certificate))

; An obligation needs the first call yielded by the termination walk.
(mutual-recursion
 (defun book-proofs-recursive-call-p (term env ruled rulers names)
   (declare (xargs :measure (acl2-count term)))
   (cond ((not (proof-compound term)) nil)
         ((endp term) '(:failure "failure" ""))
         ((equal (car term) *proof-quote*) nil)
         (t
          (let ((head (car term))
                (args (cdr term)))
            (cond ((proof-compound head)
                   (if (and (consp head) (consp (cdr head))
                            (consp (cddr head)) (endp (cdddr head)))
                       (or (book-proofs-recursive-call-args-p
                            args env
                            (and ruled (termination-recursive-calls-extends *termination-lambdas* rulers))
                            rulers names)
                           (book-proofs-let* ((bindings (termination-lambda-bindings (cadr head) args env nil)))
                             (book-proofs-recursive-call-p (caddr head) bindings ruled rulers names)))
                     (proof-list-of-length head 3)))
                  ((and (equal head *termination-return-last*) (endp args))
                   '(:failure "failure" ""))
                  ((and (equal head *termination-return-last*) (equal (car args) *termination-mbe*))
                   (if (consp (cddr args))
                       (book-proofs-recursive-call-p (caddr args) env ruled rulers names)
                     '(:failure "failure" "")))
                  ((and (equal head *proof-if*) ruled)
                   (if (and (consp args) (consp (cdr args))
                            (consp (cddr args)) (endp (cdddr args)))
                       (or (book-proofs-recursive-call-p
                            (car args) env (termination-recursive-calls-extends *proof-if* rulers) rulers names)
                           (book-proofs-let* ((literal (proof-subst (car args) env)))
                             (or (book-proofs-recursive-call-p (cadr args) env t rulers names)
                                 (book-proofs-recursive-call-p (caddr args) env t rulers names))))
                     (proof-list-of-length args 3)))
                  ((member-equal head names)
                   (book-proofs-let* ((actuals (proof-subst term env))) t))
                  (t
                   (book-proofs-recursive-call-args-p
                    args env (and ruled (termination-recursive-calls-extends head rulers)) rulers names)))))))

 (defun book-proofs-recursive-call-args-p (args env ruled rulers names)
   (declare (xargs :measure (acl2-count args)))
   (and (consp args)
        (or (book-proofs-recursive-call-p (car args) env ruled rulers names)
            (book-proofs-recursive-call-args-p (cdr args) env ruled rulers names)))))

(defun book-proofs-recursive-definition-p (definitions rulers names)
  (and (consp definitions)
       (book-proofs-let* ((definition (proof-list-of-length (car definitions) 3)))
         (or (book-proofs-recursive-call-p (caddr definition) nil t rulers names)
             (book-proofs-recursive-definition-p (cdr definitions) rulers names)))))

(defun book-proofs-obligation-name (kind data)
  (cond ((equal kind "theorem") (proof-term-at data 0))
        ((equal kind "define")
         (book-proofs-let* ((rulers (proof-term-at data 0))
                           (names (run-definition-names (cdr data)))
                           (recursive (book-proofs-recursive-definition-p (cdr data) rulers names)))
           (and recursive (car names))))
        ((equal kind "constrain")
         (book-proofs-let* ((formulas (proof-term-at data 1)))
           (and (not (equal formulas *proof-nil*))
                (book-proofs-let* ((first-function (proof-term-at (car data) 0)))
                  (proof-term-at first-function 0)))))
        (t nil)))

(defun book-proofs-auxiliary-names (entries)
  (declare (xargs :measure (acl2-count entries)))
  (if (or (endp entries) (endp (cdr entries)))
      nil
    (book-proofs-let* ((names (run-entry-names (car entries)))
                      (rest (book-proofs-auxiliary-names (cdr entries))))
      (append names rest))))

(defun book-proofs-fact-requirements (lines facts auxiliary requirements)
  (if (endp lines)
      requirements
    (let ((line (car lines)))
      (if (and (> (length line) 7)
               (text-starts-with line "(fact ")
               (text-ends-with line ")"))
          (book-proofs-let* ((parsed (reader-reader-datum
                                     (reader-reader-init (seq-slice line 6 -1)))))
            (let* ((name (car parsed))
                   (present (assoc-equal name facts)))
              (cond ((member-equal name auxiliary)
                     (book-proofs-fact-requirements (cdr lines) facts auxiliary requirements))
                    (present
                     (book-proofs-fact-requirements
                      (cdr lines) facts auxiliary (table-put requirements name (cdr present))))
                    (t '(:failure "failure" "")))))
        (book-proofs-fact-requirements (cdr lines) facts auxiliary requirements)))))

(defun book-proofs-certificate-require (entries facts auxiliary requirements)
  (if (endp entries)
      requirements
    (book-proofs-let* ((entry (proof-list-of-length (car entries) 4))
                      (lines (text-split (cadddr entry) *book-proofs-newline*))
                      (requirements (book-proofs-fact-requirements
                                     lines facts auxiliary requirements)))
      (book-proofs-certificate-require (cdr entries) facts auxiliary requirements))))

(defun book-proofs-certificate (lib raw-entry)
  (book-proofs-let* ((entries (run-required-entries (library-library-entries lib) raw-entry))
                    (auxiliary (book-proofs-auxiliary-names entries))
                    (requirements (book-proofs-certificate-require
                                   entries (proof-proof-facts (library-library-proof lib))
                                   auxiliary nil)))
    (book-proofs-make-certificate entries requirements "")))

(defun book-proofs-library-result (result lib)
  (if (failure-p result) (cons result lib) result))

(defun book-proofs-index-with-library (index before after)
  (if (equal (proof-search-fact-index-lib index) before)
      (proof-search-fact-index-with-lib index after)
    index))

(defun book-proofs-rulers-with-library (rulers before after)
  (if (equal (rulers-rulers-proof rulers) before)
      (rulers-rulers-with-proof rulers after)
    rulers))

(defun book-proofs-rewrite-opened (lib step opened)
  (let ((proof (library-library-proof lib)))
    (book-proofs-let* ((reverse-opening (proof-proof-symmetric proof opened))
                      (rewritten (proof-proof-rewrite proof step reverse-opening '(1 1 1))))
      (proof-proof-tidy proof rewritten))))

(defun book-proofs-cons-from-guard-scan (premises lib cons-test index)
  (if (endp premises)
      (cons nil lib)
    (let* ((proof (library-library-proof lib))
           (premise (car premises))
           (literal (proof-step-first premise))
           (test (cadr literal)))
      (cond ((failure-p literal) (cons literal lib))
            ((not (and (proof-is-call literal *proof-not*)
                       (proof-compound test)
                       (assoc-equal (car test) (proof-proof-definitions proof))
                       (member-equal (cadr cons-test) (cdr test))))
             (book-proofs-cons-from-guard-scan (cdr premises) lib cons-test index))
            (t
             (let ((assumption (proof-proof-assume proof cons-test nil)))
               (if (failure-p assumption)
                   (cons assumption lib)
                 (let* ((search (proof-search-search-init lib index 26 nil t))
                        (proved (proof-search-search-prove search test (list assumption) 2))
                        (empty (car proved))
                        (lib (proof-search-search-lib (cdr proved)))
                        (index (proof-search-search-index (cdr proved)))
                        (proof (library-library-proof lib)))
                   (cond ((terms-unproved-p empty)
                          (book-proofs-cons-from-guard-scan (cdr premises) lib cons-test index))
                         ((failure-p empty) (cons empty lib))
                         (t
                          (cons (book-proofs-let* ((contradiction (proof-proof-cut proof empty premise))
                                                  (subsume (proof-proof-subsume
                                                            proof contradiction
                                                            (cons cons-test (proof-step-clause contradiction)))))
                                  (proof-proof-tidy proof subsume))
                                lib)))))))))))

(defun book-proofs-cons-from-guard (lib base rulers index)
  (let ((derived (rulers-rulers-derived rulers)))
    (if (failure-p derived)
        (cons derived lib)
      (book-proofs-cons-from-guard-scan (table-values derived) lib (list *proof-consp* base) index))))

(defun book-proofs-wrapped-selector-decrease-opened (lib opened base parent rulers index)
  (let* ((reduced (proof-step-first opened))
         (edges (if (failure-p reduced) reduced (terms-selector-edges (caddr reduced) base))))
    (cond ((failure-p edges) (cons (list edges rulers) lib))
          ((not edges) (cons (list nil rulers) lib))
          (t
           (let* ((found (rulers-rulers-find rulers (list *proof-consp* base)))
                  (evidence (cond ((failure-p found) (cons found lib))
                                  ((car found) (cons (car found) lib))
                                  (t (book-proofs-cons-from-guard lib base (cdr found) index))))
                  (cons-step (car evidence))
                  (rulers (if (failure-p found) rulers (cdr found)))
                  (lib (cdr evidence)))
             (if (or (failure-p cons-step) (not cons-step))
                 (cons (list cons-step rulers) lib)
               (let ((enlarged (rulers-rulers-init
                                lib (rulers-rulers-tests rulers)
                                (append (table-values (rulers-rulers-extra rulers)) (list cons-step)))))
                 (if (failure-p enlarged)
                     (cons (list enlarged rulers) lib)
                   (let* ((goal (list *proof-ordinal-less* (list *library-count* (caddr reduced)) parent))
                          (result (book-proofs-library-result
                                   (termination-proofs-structural-decrease lib goal enlarged) lib))
                          (step (car result))
                          (lib (cdr result)))
                     (cons (list (if (or (failure-p step) (not step))
                                     step
                                   (book-proofs-rewrite-opened lib step opened))
                                 rulers)
                           lib))))))))))

(defun book-proofs-wrapped-selector-decrease-actual (lib actual parent rulers index)
  (let ((parameters (book-proofs-let* ((base (proof-term-at parent 1))
                                      (function (proof-term-at actual 0)))
                      (list base function))))
    (if (failure-p parameters)
        (cons (list parameters rulers) lib)
      (let ((function (cadr parameters)))
        (if (or (assoc-equal function (proof-proof-definitions (library-library-proof lib)))
                (member-equal function (list *library-car* *library-cdr*)))
            (let ((derived (rulers-rulers-derived rulers)))
              (if (failure-p derived)
                  (cons (list derived rulers) lib)
                (let* ((reducer (book-logic-reducer-init lib (table-values derived) :none nil 60 145 nil nil))
                       (result (book-logic-reducer-reduce reducer actual nil))
                       (opened (car result))
                       (reduced-lib (book-logic-reducer-lib (cdr result))))
                  (if (or (failure-p opened) (not opened))
                      (cons (list opened rulers) reduced-lib)
                    (book-proofs-wrapped-selector-decrease-opened
                     reduced-lib opened (car parameters) parent rulers
                     (book-proofs-index-with-library index lib reduced-lib))))))
          (cons (list nil rulers) lib))))))

(defun book-proofs-wrapped-selector-decrease-with-rulers (lib goal rulers index)
  (let* ((parts (proof-list-of-length goal 3))
         (child (cadr parts))
         (parent (caddr parts)))
    (cond ((failure-p parts) (cons (list parts rulers) lib))
          ((not (and (proof-is-call child *library-count*) (proof-is-call parent *library-count*)))
           (cons (list nil rulers) lib))
          (t
           (let ((actual (proof-term-at child 1)))
             (cond ((failure-p actual) (cons (list actual rulers) lib))
                   ((not (proof-compound actual)) (cons (list nil rulers) lib))
                   (t (book-proofs-wrapped-selector-decrease-actual lib actual parent rulers index))))))))

(defun book-proofs-wrapped-selector-decrease (lib goal rulers index)
  (let ((result (book-proofs-wrapped-selector-decrease-with-rulers lib goal rulers index)))
    (cons (caar result) (cdr result))))

(defun book-proofs-conditional-count-decrease-leaf (value tests lib rulers wrappers before cons-step)
  (let ((branch (rulers-rulers-init lib (append (rulers-rulers-tests rulers) tests) nil)))
    (if (failure-p branch)
        (cons branch lib)
      (let* ((reducer (book-logic-reducer-init lib nil wrappers nil 35 140 nil nil))
             (result (book-logic-reducer-reduce reducer value nil))
             (reduced (car result))
             (lib (book-logic-reducer-lib (cdr result)))
             (final (if (and reduced (not (failure-p reduced)))
                        (caddr (proof-step-first reduced))
                      value)))
        (if (failure-p reduced)
            (cons reduced lib)
          (let* ((result (if (equal final *proof-false*)
                             (let ((extended (selector-proofs-count-nil-bound lib)))
                               (if (failure-p extended)
                                   (cons extended lib)
                                 (cons (library-library-cite
                                        extended "COUNT-NIL-LESS" (cdr before) (list cons-step))
                                       extended)))
                           (book-proofs-library-result
                            (termination-proofs-structural-decrease
                             lib (list *proof-ordinal-less* (list *library-count* final) before) branch)
                            lib)))
                 (step (car result))
                 (lib (cdr result)))
            (cond ((failure-p step) result)
                  ((not step) (cons *terms-unproved* lib))
                  (reduced (cons (book-proofs-rewrite-opened lib step reduced) lib))
                  (t result))))))))

(defun book-proofs-conditional-count-leaves (leaves lib rulers wrappers before cons-step replies)
  (if (endp leaves)
      (cons (reverse replies) lib)
    (let* ((leaf (car leaves))
           (result (book-proofs-conditional-count-decrease-leaf
                    (car leaf) (cadr leaf) lib rulers wrappers before cons-step))
           (step (car result))
           (lib (cdr result)))
      (if (failure-p step)
          result
        (book-proofs-conditional-count-leaves
         (cdr leaves) lib rulers wrappers before cons-step (acons leaf step replies))))))

(defun book-proofs-conditional-count-by-value (lib normalized template rulers wrappers before cons-step)
  (let ((leaves (proof-proof-by-value-leaves (library-library-proof lib) normalized nil)))
    (if (failure-p leaves)
        (cons leaves lib)
      (let* ((replies (book-proofs-conditional-count-leaves leaves lib rulers wrappers before cons-step nil))
             (values (car replies))
             (lib (cdr replies)))
        (cons (if (failure-p values)
                  values
                (lemmas-slice-library-by-value lib normalized template values nil))
              lib)))))

(defun book-proofs-conditional-count-proof (lib actual before rulers cons-step)
  (let* ((wrappers (list (proof-sym "HARD-ERROR" "ACL2") (proof-sym "THE-CHECK" "ACL2")))
         (reducer (book-logic-reducer-init lib nil wrappers t 45 140 nil nil))
         (result (book-logic-reducer-reduce reducer actual nil))
         (opened (car result))
         (lib (book-logic-reducer-lib (cdr result)))
         (normalized (if (and opened (not (failure-p opened)))
                         (book-proofs-let* ((equation (proof-step-first opened)))
                           (proof-term-at equation 2))
                       actual)))
    (cond ((failure-p opened) (cons opened lib))
          ((failure-p normalized) (cons normalized lib))
          ((not (or opened (proof-is-call normalized *proof-if*) (equal normalized *proof-false*)))
           (cons nil lib))
          (t
           (let* ((template (list *proof-ordinal-less* (list *library-count* *proof-result*) before))
                  (result (book-proofs-conditional-count-by-value lib normalized template rulers wrappers before cons-step))
                  (step (car result))
                  (lib (cdr result)))
             (cond ((terms-unproved-p step) (cons nil lib))
                   ((failure-p step) result)
                   (opened (cons (book-proofs-rewrite-opened lib step opened) lib))
                   (t result)))))))

(defun book-proofs-conditional-count-decrease-with-rulers (lib goal rulers)
  (let* ((parts (proof-list-of-length goal 3))
         (after (cadr parts))
         (before (caddr parts)))
    (cond ((failure-p parts) (cons (list parts rulers) lib))
          ((not (and (proof-is-call after *library-count*) (proof-is-call before *library-count*)))
           (cons (list nil rulers) lib))
          (t
           (let ((found (book-proofs-let* ((base (proof-term-at before 1)))
                          (rulers-rulers-find rulers (list *proof-consp* base)))))
             (if (failure-p found)
                 (cons (list found rulers) lib)
               (let ((cons-step (car found))
                     (rulers (cdr found)))
                 (if (not cons-step)
                     (cons (list nil rulers) lib)
                   (let* ((actual (proof-term-at after 1))
                          (result (if (failure-p actual)
                                      (cons actual lib)
                                    (book-proofs-conditional-count-proof lib actual before rulers cons-step))))
                     (cons (list (car result) (book-proofs-rulers-with-library rulers lib (cdr result)))
                           (cdr result)))))))))))

(defun book-proofs-conditional-count-decrease (lib goal rulers)
  (let ((result (book-proofs-conditional-count-decrease-with-rulers lib goal rulers)))
    (cons (caar result) (cdr result))))

(defun book-proofs-earlier-decrease-require (term rulers search evidence derived)
  (let ((found (rulers-rulers-find rulers term)))
    (cond ((failure-p found) (list found search rulers))
          ((car found) (list (car found) search (cdr found)))
          (t
           (let* ((result (proof-search-search-premise search term evidence derived))
                  (rulers (book-proofs-rulers-with-library (cdr found) (proof-search-search-lib search)
                                                          (proof-search-search-lib (cdr result)))))
             (list (car result) (cdr result) rulers))))))

(defun book-proofs-earlier-decrease-index (n goal search rulers evidence derived replies)
  (declare (xargs :measure (nfix n)))
  (if (zp n)
      (list '(:failure "Fuel" "book-proofs-earlier-decrease-index") search rulers)
    (let* ((index (proof-search-search-index search))
           (step (proof-search-fact-index-prove index goal replies)))
      (if (proof-search-request-p step)
          (let* ((term (cadr step))
                 (answer (book-proofs-earlier-decrease-require term rulers search evidence derived)))
            (book-proofs-earlier-decrease-index
             (1- n) goal (cadr answer) (caddr answer) evidence derived (acons term (car answer) replies)))
        (list step search rulers)))))

(defun book-proofs-ordinal-equality (lib child parent)
  (if (eq (proof-proof-kind (library-library-proof lib)) :base)
      (cons (library-library-ordinal-comparison lib child parent) lib)
    (let ((child-type (lemmas-slice-library-type-of lib child nil)))
      (if (failure-p child-type)
          (cons child-type lib)
        (let* ((lib (cdr child-type))
               (parent-type (lemmas-slice-library-type-of lib parent nil)))
          (if (failure-p parent-type)
              (cons parent-type lib)
            (let ((lib (cdr parent-type)))
              (cons (library-library-cite lib "FINITE-ORDER" (list child parent)
                                          (list (car child-type) (car parent-type)))
                    lib))))))))

(defun book-proofs-earlier-decrease-ordinal-comparison (goal search rulers evidence derived)
  (let ((parts (proof-list-of-length goal 3)))
    (if (failure-p parts)
        (list parts search rulers)
      (let* ((child (cadr parts))
             (parent (caddr parts))
             (lib (proof-search-search-lib search))
             (result (book-proofs-ordinal-equality lib child parent))
             (equality (car result))
             (search (proof-search-search-with-lib search (cdr result)))
             (rulers (book-proofs-rulers-with-library rulers lib (cdr result))))
        (if (failure-p equality)
            (list equality search rulers)
          (let* ((result (book-proofs-earlier-decrease-index
                          1000000 (library-lt child parent) search rulers evidence derived nil))
                 (step (car result))
                 (search (cadr result))
                 (rulers (caddr result))
                 (proof (library-library-proof (proof-search-search-lib search))))
            (list (if (failure-p step) step (proof-proof-transport proof step equality))
                  search rulers)))))))

(defun book-proofs-earlier-decrease-integer-tactics (tactics lib goal rulers)
  (if (endp tactics)
      (cons (list nil rulers) lib)
    (let* ((result (case (car tactics)
                     (:quotient (quotient-proofs-quotient-decrease-with-rulers lib goal rulers))
                     (:shift (shift-arithmetic-shift-decrease-with-rulers lib goal rulers))
                     (:halving (halving-proofs-halving-descent-with-rulers lib goal rulers))
                     (otherwise (halved-counters-halved-counter-descent-with-rulers lib goal rulers))))
           (result (if (failure-p result) (cons (list result rulers) lib) result)))
      (if (caar result)
          result
        (let ((rulers (book-proofs-rulers-with-library (cadar result) lib (cdr result))))
          (book-proofs-earlier-decrease-integer-tactics (cdr tactics) (cdr result) goal rulers))))))

(defun book-proofs-earlier-decrease-selector-tactics (lib goal rulers index)
  (let* ((result (book-proofs-wrapped-selector-decrease-with-rulers lib goal rulers index))
         (step (caar result)))
    (if step
        result
      (book-proofs-conditional-count-decrease-with-rulers
       (cdr result) goal (book-proofs-rulers-with-library (cadar result) lib (cdr result))))))

(defun book-proofs-earlier-decrease-prepare-lexicographic (goal search rulers evidence derived)
  (let* ((result (book-proofs-earlier-decrease-integer-tactics
                  '(:quotient :shift :halving :halved-counter) (proof-search-search-lib search) goal rulers))
         (step (caar result))
         (rulers (cadar result))
         (lib (cdr result))
         (search (proof-search-search-with-lib search lib)))
    (if step
        result
      (let ((formula (lexicographic-descent-goal lib goal)))
        (cond ((failure-p formula) (cons (list formula rulers) lib))
              ((not formula)
               (book-proofs-earlier-decrease-selector-tactics lib goal rulers (proof-search-search-index search)))
              (t
               (let* ((answer (book-proofs-earlier-decrease-index 1000000 formula search rulers evidence derived nil))
                      (search (cadr answer)))
                 (list :lexicographic (proof-search-search-lib search) (caddr answer) (car answer)
                       (proof-search-search-index search)))))))))

(defund book-proofs-earlier-decrease-prepare (lib goal rulers index)
  (let ((derived (rulers-rulers-derived rulers)))
    (if (failure-p derived)
        (cons (list derived rulers) lib)
      (let* ((evidence (table-values derived))
             (search (proof-search-search-init lib index 48 nil nil))
             (direct (book-proofs-earlier-decrease-index 1000000 goal search rulers evidence derived nil))
             (step (car direct))
             (search (cadr direct))
             (rulers (caddr direct)))
        (if (not (terms-unproved-p step))
            (cons (list step rulers) (proof-search-search-lib search))
          (let* ((result (book-proofs-earlier-decrease-ordinal-comparison goal search rulers evidence derived))
                 (step (car result))
                 (search (cadr result))
                 (rulers (caddr result)))
            (if (terms-proof-fallback-p step)
                (book-proofs-earlier-decrease-prepare-lexicographic goal search rulers evidence derived)
              (cons (list step rulers) (proof-search-search-lib search)))))))))

(defund book-proofs-earlier-decrease-lexicographic-pass (lib goal rulers equation replies)
  (let ((attempt (lexicographic-descent-with-rulers lib goal rulers equation (cons t replies))))
    (if (failure-p attempt) (cons (list attempt rulers) lib) attempt)))

(mutual-recursion
 (defun book-proofs-earlier-decrease-fuel (n lib goal rulers index)
   (declare (xargs :measure (nfix n)))
   (if (zp n)
       (cons (list '(:failure "Fuel" "book-proofs-earlier-decrease-fuel") rulers) lib)
     (let ((prepared (book-proofs-earlier-decrease-prepare lib goal rulers index)))
       (if (eq (car prepared) :lexicographic)
           (book-proofs-earlier-decrease-lexicographic
            (1- n) (cadr prepared) goal (caddr prepared) (car (cddddr prepared)) (cadddr prepared) nil)
         prepared))))

 (defun book-proofs-earlier-decrease-lexicographic (n lib goal rulers index equation replies)
   (declare (xargs :measure (nfix n)))
   (if (zp n)
       (cons (list '(:failure "Fuel" "book-proofs-earlier-decrease-lexicographic") rulers) lib)
     (let* ((result (book-proofs-earlier-decrease-lexicographic-pass lib goal rulers equation replies))
            (value (caar result)))
       (cond ((termination-proofs-callback-p value)
              (let* ((request-lib (caddr value))
                     (request-index (book-proofs-index-with-library index lib request-lib))
                     (reply (book-proofs-earlier-decrease-fuel
                             (1- n) request-lib (cadddr value) (car (cddddr value)) request-index))
                     (reply (termination-proofs-descent-reply (caar reply) (cdr reply) (cadar reply))))
                (book-proofs-earlier-decrease-lexicographic
                 (1- n) lib goal rulers index equation (append replies (list reply)))))
             (value result)
             (t (book-proofs-earlier-decrease-selector-tactics
                 (cdr result) goal (cadar result) (book-proofs-index-with-library index lib (cdr result)))))))))

(defun book-proofs-earlier-decrease (lib goal rulers index)
  (let ((result (book-proofs-earlier-decrease-fuel 1000000 lib goal rulers index)))
    (cons (caar result) (cdr result))))

(defun book-proofs-book-termination-extra (proof goal rulers index)
  (let ((result (book-proofs-earlier-decrease-fuel 1000000 proof goal rulers index)))
    (termination-proofs-descent-reply (caar result) (cdr result) (cadar result))))

(defun book-proofs-book-termination-ordinal (lib measure index)
  (let* ((goal (list *proof-ordinalp* measure))
         (equality (proof-search-fact-index-prove index (proof-eq goal *proof-true*) :none))
         (step (if (failure-p equality)
                   equality
                 (proof-proof-true-from-eq (library-library-proof lib) equality))))
    (if (terms-unproved-p step)
        (let* ((search (proof-search-search-init lib index 25 nil t))
               (result (proof-search-search-prove search goal nil 2))
               (step (car result))
               (lib (proof-search-search-lib (cdr result))))
          (cons (if (terms-unproved-p step) nil step) lib))
      (cons step lib))))

(defund book-proofs-book-termination-pass (lib data measures descents ordinalities)
  (book-proofs-library-result
   (termination-proofs-termination-proofs lib data measures (cons t descents) (cons t ordinalities))
   lib))

(defun book-proofs-book-termination-try (n lib data measures index descents ordinalities)
  (declare (xargs :measure (nfix n)))
  (if (zp n)
      (cons '(:failure "Fuel" "book-proofs-book-termination-try") lib)
    (let* ((result (book-proofs-book-termination-pass lib data measures descents ordinalities))
           (value (car result)))
      (if (termination-proofs-callback-p value)
          (let* ((request-lib (caddr value))
                 (request-index (book-proofs-index-with-library index lib request-lib)))
            (if (eq (cadr value) :descent)
                (let ((reply (book-proofs-book-termination-extra
                              request-lib (cadddr value) (car (cddddr value)) request-index)))
                  (book-proofs-book-termination-try
                   (1- n) lib data measures index (append descents (list reply)) ordinalities))
              (let ((reply (book-proofs-book-termination-ordinal request-lib (cadddr value) request-index)))
                (book-proofs-book-termination-try
                 (1- n) lib data measures index descents (append ordinalities (list reply))))))
        result))))

(defun book-proofs-normalize-measures (defs lib measures normalized)
  (if (endp defs)
      (cons normalized lib)
    (let* ((function (caar defs))
           (stored (cdr (assoc-equal function measures)))
           (measure (car stored)))
      (if (not (proof-compound measure))
          (book-proofs-normalize-measures (cdr defs) lib measures normalized)
        (let* ((reducer (book-logic-reducer-init lib nil (list (car measure)) nil 42 165 nil nil))
               (result (book-logic-reducer-reduce reducer measure nil))
               (opened (car result))
               (lib (book-logic-reducer-lib (cdr result))))
          (cond ((failure-p opened) (cons opened lib))
                (opened
                 (let* ((literal (proof-step-first opened))
                        (normalized (table-put normalized function (cons (caddr literal) (cdr stored)))))
                   (book-proofs-normalize-measures (cdr defs) lib measures normalized)))
                (t (book-proofs-normalize-measures (cdr defs) lib measures normalized))))))))

(defun book-proofs-book-termination (lib data measures index)
  (let* ((initial-lib lib)
         (result (book-proofs-book-termination-try 1000000 lib data measures index nil nil))
         (value (car result))
         (lib (cdr result)))
    (if (equal value *terms-missing-measure-ordinality*)
        (let* ((result (book-proofs-normalize-measures (cdr data) lib measures measures))
               (normalized (car result))
               (lib (cdr result)))
          (cond ((failure-p normalized) result)
                ((equal normalized measures) (cons value lib))
                (t
                 (let* ((index (book-proofs-index-with-library index initial-lib lib))
                        (result (book-proofs-book-termination-try
                                 1000000 lib data normalized index nil nil))
                        (value (car result)))
                   (cons (if (failure-p value) value (car value)) (cdr result))))))
      (cons (if (failure-p value) value (car value)) lib))))

(defun book-proofs-witness-entry (lib index data name)
  (if (and (equal (cadr name) "ACL2")
           (assoc-equal (caddr name) *witnesses-witnesses*))
      (let* ((result (book-proofs-library-result (witnesses-witness-proofs lib data) lib))
             (value (car result)))
        (cons (if (failure-p value) value (car value)) (cdr result)))
    (book-proofs-library-result (constraint-proofs-construct-witnesses lib index data) lib)))

(defun book-proofs-theorem-entry (lib index data name)
  (let* ((formula (proof-term-at data 1))
         (initial-lib lib)
         (split (if (failure-p formula)
                    (cons formula lib)
                  (book-proofs-library-result (strsplit-proofs-split-tactic lib formula) lib)))
         (step (car split))
         (lib (cdr split))
         (result (if (or (not step) (terms-unproved-p step)
                         (and (failure-p step) (equal (cadr step) "key")))
                     (book-proofs-library-result
                      (proof-search-prove-theorem lib (book-proofs-index-with-library index initial-lib lib) formula) lib)
                   split))
         (step (car result))
         (lib (cdr result)))
    (cons (book-proofs-let* ((step step)
                            (step (proof-proof-subsume (library-library-proof lib) step (list formula))))
            (proof-proof-entry "theorem" name (list name) (list step)))
          lib)))

(defun book-proofs-remove-auxiliary (names proof)
  (if (endp names)
      proof
    (let ((facts (proof-proof-facts proof))
          (definitions (proof-proof-definitions proof))
          (name (car names)))
      (if (not (assoc-equal name facts))
          '(:failure "failure" "")
        (book-proofs-remove-auxiliary
         (cdr names) (proof-proof-with-kind
                      (proof-make-proof (table-delete facts name)
                                        (if (assoc-equal name definitions)
                                            (table-delete definitions name)
                                          definitions)
                                        (proof-proof-primitives proof))
                      (proof-proof-kind proof)))))))

(defun book-proofs-rollback-proof (added proof)
  (if (endp added)
      proof
    (book-proofs-let* ((names (run-entry-names (car added)))
                      (proof (book-proofs-remove-auxiliary names proof)))
      (book-proofs-rollback-proof (cdr added) proof))))

(defun book-proofs-skip-certificate (lib start name reason)
  (let* ((entries (library-library-entries lib))
         (proof (book-proofs-rollback-proof (nthcdr start entries) (library-library-proof lib))))
    (if (failure-p proof)
        (cons proof lib)
      (let* ((lib (library-make-library proof (take start entries)))
             (source (proof-line "skip" (list name))))
        (cons (if (failure-p source)
                  source
                (book-proofs-make-certificate (list (list "skip" name nil source)) nil reason))
              lib)))))

(defun book-proofs-book-prover-prove (lib kind data name measures index)
  (let* ((start (len (library-library-entries lib)))
         (entry (cond ((equal kind "define") (book-proofs-book-termination lib data measures index))
                      ((equal kind "constrain") (book-proofs-witness-entry lib index data name))
                      (t (book-proofs-theorem-entry lib index data name))))
         (lib (cdr entry))
         (certificate (if (failure-p (car entry))
                          (car entry)
                        (book-proofs-certificate lib (car entry)))))
    (if (terms-unproved-p certificate)
        (book-proofs-skip-certificate lib start name (cadr certificate))
      (cons certificate lib))))

(defun run-statement-fact-names (kind data)
  (cond ((equal kind "define") (run-definition-names (cdr data)))
        ((and (equal kind "constrain") (not (equal (cadr data) *proof-nil*)))
         (run-definition-names (cadr data)))
        ((member-equal kind '("axiom" "theorem" "choose")) (list (car data)))
        (t nil)))

(defun run-index-names (index names)
  (declare (xargs :measure (acl2-count names)))
  (if (endp names)
      index
    (book-proofs-let* ((index (proof-search-fact-index-add index (car names))))
      (run-index-names index (cdr names)))))

(defun book-proofs-make-book-prover (base lines measures skipped proved seen)
  (list :book-prover base lines measures skipped proved seen))

(defun book-proofs-book-prover-base (prover)
  (cadr prover))

(defun book-proofs-book-prover-library-lines (prover)
  (caddr prover))

(defun book-proofs-book-prover-library-measures (prover)
  (cadddr prover))

(defun book-proofs-book-prover-skipped-by-book (prover)
  (car (cddddr prover)))

(defun book-proofs-book-prover-distinct-proved (prover)
  (cadr (cddddr prover)))

(defun book-proofs-book-prover-distinct-seen (prover)
  (caddr (cddddr prover)))

(defun book-proofs-book-prover-statement (raw)
  (run-parse-line (text-strip-right raw *book-proofs-newline*)))

(defun book-proofs-book-prover-base-measures (lines measures)
  (if (endp lines)
      measures
    (book-proofs-let* ((parsed (run-parse-line (seq-slice (car lines) 0 -1))))
      (let ((data (cadr parsed)))
        (if (consp data)
            (book-proofs-book-prover-base-measures
             (cdr lines) (table-put measures (car data) (cdr data)))
          '(:failure "failure" ""))))))

(defun book-proofs-book-prover-base-statements (lines lib)
  (if (endp lines)
      lib
    (book-proofs-let* ((parsed (run-parse-line (seq-slice (car lines) 0 -1)))
                      (lib (run-add-statement lib (car parsed) (cadr parsed))))
      (book-proofs-book-prover-base-statements (cdr lines) lib))))

(defun book-proofs-book-prover-init (statement-lines measure-lines)
  (book-proofs-let* ((lib (book-library-book-library-build (book-library-book-library-init (proof-proof-init))))
                    (measures (book-proofs-book-prover-base-measures measure-lines nil))
                    (lib (book-proofs-book-prover-base-statements statement-lines lib)))
    (book-proofs-make-book-prover lib (proof-unique statement-lines) measures nil nil nil)))

(defun book-proofs-book-prover-find-certificate (lib kind data name measures index)
  (book-proofs-book-prover-prove lib kind data name measures index))

(defun book-proofs-book-prover-aid-measures (lines measures)
  (cond ((endp lines) measures)
        ((text-starts-with (car lines) "(measure ")
         (book-proofs-let* ((parsed (book-proofs-book-prover-statement (car lines))))
           (let ((data (cadr parsed)))
             (if (consp data)
                 (book-proofs-book-prover-aid-measures
                  (cdr lines) (table-put measures (car data) (cdr data)))
               '(:failure "failure" "")))))
        (t (book-proofs-book-prover-aid-measures (cdr lines) measures))))

(defun book-proofs-set-add (item members)
  (if (member-equal item members) members (cons item members)))

(defun book-proofs-book-prover-generate-lines
    (lines number lib index measures seen rows skipped proved distinct-seen)
  (if (endp lines)
      (list (reverse rows) skipped proved distinct-seen)
    (let ((raw (car lines)))
      (if (or (not (text-starts-with raw *book-proofs-fact-kinds*)) (member-equal raw seen))
          (book-proofs-book-prover-generate-lines
           (cdr lines) (1+ number) lib index measures seen rows skipped proved distinct-seen)
        (book-proofs-let* ((parsed (book-proofs-book-prover-statement raw))
                          (name (book-proofs-obligation-name (car parsed) (cadr parsed))))
          (let* ((kind (car parsed))
                 (data (cadr parsed))
                 (result (if name
                             (book-proofs-book-prover-find-certificate lib kind data name measures index)
                           (cons nil lib)))
                 (certificate (car result))
                 (failed (and certificate (not (equal (book-proofs-certificate-reason certificate) "")))))
            (book-proofs-let* ((certificate certificate)
                              (lib (run-add-statement (cdr result) kind data))
                              (names (run-statement-fact-names kind data))
                              (index (run-index-names (proof-search-fact-index-with-lib index lib) names)))
              (book-proofs-book-prover-generate-lines
               (cdr lines) (1+ number) lib index measures (cons raw seen)
               (if name (cons (list number kind name certificate) rows) rows)
               (if failed (cons raw skipped) skipped)
               (if (and name (not failed)) (book-proofs-set-add raw proved) proved)
               (if name (book-proofs-set-add raw distinct-seen) distinct-seen)))))))))

(defun book-proofs-book-prover-generate (prover input-name raw-lines aid-lines)
  (let ((base (book-proofs-book-prover-base prover))
        (lines (book-proofs-book-prover-library-lines prover))
        (base-measures (book-proofs-book-prover-library-measures prover)))
    (book-proofs-let* ((measures (book-proofs-book-prover-aid-measures aid-lines base-measures))
                      (index (proof-search-fact-index-init base))
                      (generated (book-proofs-book-prover-generate-lines
                                  raw-lines 1 base index measures lines nil nil
                                  (book-proofs-book-prover-distinct-proved prover)
                                  (book-proofs-book-prover-distinct-seen prover))))
      (cons (car generated)
            (book-proofs-make-book-prover
             base lines base-measures
             (table-put (book-proofs-book-prover-skipped-by-book prover) input-name (cadr generated))
             (caddr generated) (cadddr generated))))))
