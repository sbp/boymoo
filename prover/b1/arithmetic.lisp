(in-package "BOYMOO-PROVER")

(set-verify-guards-eagerness 0)

(defconst *b1-arithmetic-fix* (proof-sym "FIX" "ACL2"))
(defconst *b1-arithmetic-reciprocal* (proof-sym "UNARY-/" "ACL2"))
(defconst *b1-arithmetic-numerator* (proof-cl "NUMERATOR"))
(defconst *b1-arithmetic-denominator* (proof-cl "DENOMINATOR"))

(defun b1-arithmetic-product (a b)
  (list *proof-times* a b))

(defun b1-arithmetic-reciprocal (a)
  (list *b1-arithmetic-reciprocal* a))

(defun b1-arithmetic-step-at (step index)
  (proof-with-checked-results ((first (proof-step-first step)))
    (proof-term-at first index)))

(defun b1-arithmetic-known-type-evidence (library recognizer term evidence)
  (if (endp evidence)
      nil
    (proof-with-checked-results ((first (proof-step-first (car evidence))))
      (cond
       ((equal first (list recognizer term)) (car evidence))
       ((and (equal recognizer *library-rationalp*)
             (equal first (library-integer term)))
        (proof-with-checked-results
         ((fact (library-library-axiom library "INTEGER-IMPLIES-RATIONAL" (list term))))
         (proof-proof-modus-ponens (library-library-proof library) fact (car evidence))))
       (t (b1-arithmetic-known-type-evidence library recognizer term (cdr evidence)))))))

(defun b1-arithmetic-known-type-start (library recognizer term evidence)
  (proof-with-checked-results
   ((known (b1-arithmetic-known-type-evidence library recognizer term evidence)))
   (cond
    (known known)
    ((proof-is-call term *proof-quote*)
     (proof-with-checked-results
      ((step (b1-logic-bookproof-constant library (list recognizer term))))
      (if step
          (proof-with-checked-results ((value (b1-arithmetic-step-at step 2)))
            (if (equal value *proof-false*)
                nil
              (proof-proof-true-from-eq (library-library-proof library) step)))
        nil)))
    (t nil))))

(defun b1-arithmetic-closure-index (term)
  (cond ((proof-is-call term *proof-plus*) 0)
        ((proof-is-call term *proof-times*) 1)
        ((proof-is-call term *proof-minus*) 2)
        ((proof-is-call term *b1-arithmetic-reciprocal*) 3)
        (t nil)))

(defun b1-arithmetic-rational-closure-name (term)
  (cond ((proof-is-call term *proof-plus*) "rationalp-binary-+")
        ((proof-is-call term *proof-times*) "rationalp-binary-*")
        ((proof-is-call term *proof-minus*) "rationalp-unary--")
        ((proof-is-call term *b1-arithmetic-reciprocal*) "rationalp-unary-/")
        (t nil)))

(mutual-recursion
 (defun b1-arithmetic-known-rational (library term evidence)
   (declare (xargs :measure (acl2-count term)))
   (let ((proof (library-library-proof library)))
     (proof-with-checked-results
      ((known (b1-arithmetic-known-type-start library *library-rationalp* term evidence)))
      (if known
          known
        (let ((name (b1-arithmetic-rational-closure-name term)))
          (if (and (consp term) name)
              (proof-with-checked-results
               ((facts (b1-arithmetic-known-rational-arguments library (cdr term) evidence))
                (fact (proof-proof-fact proof name
                                       (seq-zip (list *library-x* *library-y*) (cdr term))))
                (test (b1-arithmetic-step-at fact 1))
                (condition (b1-logic-bookproof-normalize-proof library test facts nil nil nil)))
               (proof-proof-modus-ponens proof fact condition))
            (proof-with-checked-results
             ((fact (library-library-axiom library "INTEGER-IMPLIES-RATIONAL" (list term)))
              (int (library-library-type-of library term evidence)))
             (proof-proof-modus-ponens proof fact int))))))))

 (defun b1-arithmetic-known-rational-arguments (library terms evidence)
   (declare (xargs :measure (acl2-count terms)))
   (if (endp terms)
       nil
     (proof-with-checked-results
      ((first (b1-arithmetic-known-rational library (car terms) evidence))
       (rest (b1-arithmetic-known-rational-arguments library (cdr terms) evidence)))
      (cons first rest)))))

(defun b1-arithmetic-known-type (library recognizer term evidence)
  (if (equal recognizer *library-rationalp*)
      (b1-arithmetic-known-rational library term evidence)
    (proof-with-checked-results
     ((known (b1-arithmetic-known-type-start library recognizer term evidence)))
     (cond
      (known known)
      ((equal recognizer *library-numberp*)
       (let ((index (b1-arithmetic-closure-index term))
             (proof (library-library-proof library)))
         (if index
             (proof-with-checked-results
              ((fact (library-library-axiom library "CLOSURE" (cdr term)))
               (parts (b1-logic-bookproof-split-conjuncts library fact)))
              (proof-term-at parts index))
           (proof-with-checked-results
            ((rational (b1-arithmetic-known-rational library term evidence))
             (fact (proof-proof-fact proof "rationalp-acl2-numberp"
                                     (list (list *library-x* term)))))
            (proof-proof-modus-ponens proof fact rational)))))
      (t '(:failure "Unproved" ""))))))

(defun b1-arithmetic-add-zero (library term evidence)
  (let ((proof (library-library-proof library)))
    (proof-with-checked-results
     ((opened (proof-proof-unfold proof (list *b1-arithmetic-fix* term)))
      (body (b1-arithmetic-step-at opened 2))
      (numeric (b1-arithmetic-known-type library *library-numberp* term evidence))
      (selected (proof-proof-select proof body numeric))
      (value (proof-proof-chain proof opened (list selected)))
      (identity (library-library-axiom library "UNICITY-OF-0" (list term))))
     (proof-proof-chain proof identity (list value)))))

(defun b1-arithmetic-multiply-one (library term evidence left)
  (let ((proof (library-library-proof library)))
    (proof-with-checked-results
     ((opened (proof-proof-unfold proof (list *b1-arithmetic-fix* term)))
      (body (b1-arithmetic-step-at opened 2))
      (numeric (b1-arithmetic-known-type library *library-numberp* term evidence))
      (selected (proof-proof-select proof body numeric))
      (value (proof-proof-chain proof opened (list selected)))
      (unit (library-library-axiom library "UNICITY-OF-1" (list term)))
      (identity (proof-proof-chain proof unit (list value))))
     (if left
         identity
       (proof-with-checked-results
        ((commute (library-library-axiom library "COMMUTATIVITY-OF-*"
                                         (list term *proof-one*))))
        (proof-proof-chain proof commute (list identity)))))))

(defun b1-arithmetic-multiply-zero (library term)
  (let ((a (b1-arithmetic-product term *proof-zero*))
        (proof (library-library-proof library)))
    (proof-with-checked-results ((ground (b1-logic-bookproof-constant library a)))
      (if ground
          ground
        (proof-with-checked-results
         ((split (library-library-axiom library "DISTRIBUTIVITY"
                                        (list term *proof-zero* *proof-zero*)))
          (zero (b1-logic-bookproof-constant library (library-plus *proof-zero* *proof-zero*)))
          (double (proof-proof-rewrite proof split zero '(1 1 2)))
          (step (proof-proof-reflexive proof (library-plus a (library-minus a))))
          (step (proof-proof-rewrite proof step double '(1 2 1)))
          (associate (library-library-axiom library "ASSOCIATIVITY-OF-+"
                                            (list a a (library-minus a))))
          (step (proof-proof-chain proof step (list associate)))
          (inverse (library-library-axiom library "INVERSE-OF-+" (list a)))
          (step (proof-proof-rewrite proof step inverse '(1 2 2)))
          (commute (library-library-axiom library "COMMUTATIVITY-OF-+" (list a *proof-zero*)))
          (unit (b1-arithmetic-add-zero library a nil))
          (step (proof-proof-chain proof step (list commute unit)))
          (step (proof-proof-symmetric proof step))
          (inverse (library-library-axiom library "INVERSE-OF-+" (list a))))
         (proof-proof-chain proof step (list inverse)))))))

(defun b1-arithmetic-positive-nonzero (library step)
  (let ((proof (library-library-proof library)))
    (proof-with-checked-results
     ((term (b1-arithmetic-step-at step 2))
      (test (proof-eq term *proof-zero*))
      (assumed (proof-proof-assume proof test t))
      (impossible (proof-proof-rewrite proof step assumed '(1 2)))
      (zero (library-library-axiom library "ZERO" nil))
      (result (proof-proof-cut proof impossible zero)))
     (proof-proof-front proof result (proof-neg test)))))

(defun b1-arithmetic-inverse-product (library term numeric nonzero)
  (proof-with-checked-results
   ((fact (library-library-axiom library "INVERSE-OF-*" (list term)))
    (test (b1-arithmetic-step-at fact 1))
    (condition (b1-logic-bookproof-normalize-proof library test (list numeric nonzero) nil nil nil)))
   (proof-proof-modus-ponens (library-library-proof library) fact condition)))

(defun b1-arithmetic-product-unique (library inverse product-is-one right-numeric)
  (let ((proof (library-library-proof library)))
    (proof-with-checked-results
     ((product (b1-arithmetic-step-at product-is-one 1))
      (parts (proof-list-of-length product 3)))
     (let* ((a (cadr parts))
            (b (caddr parts))
            (inv (b1-arithmetic-reciprocal a)))
       (proof-with-checked-results
        ((commute (library-library-axiom library "COMMUTATIVITY-OF-*" (list inv a)))
         (commute (proof-proof-chain proof commute (list inverse)))
         (step (b1-arithmetic-multiply-one library b (list right-numeric) t))
         (step (proof-proof-symmetric proof step))
         (commute (proof-proof-symmetric proof commute))
         (step (proof-proof-rewrite proof step commute '(1 2 1)))
         (associate (library-library-axiom library "ASSOCIATIVITY-OF-*" (list inv a b)))
         (step (proof-proof-chain proof step (list associate)))
         (step (proof-proof-rewrite proof step product-is-one '(1 2 2)))
         (unit (b1-arithmetic-multiply-one library inv nil nil)))
        (proof-proof-chain proof step (list unit)))))))

(defun b1-arithmetic-nonnumeric-product (library term nonnumeric evidence)
  (proof-with-checked-results
   ((completion (library-library-axiom library "COMPLETION-OF-*" (cdr term)))
    (body (b1-arithmetic-step-at completion 2))
    (normalized (b1-logic-bookproof-normalize library body (cons nonnumeric evidence)
                                               nil nil nil nil nil)))
   (proof-proof-chain (library-library-proof library) completion (list normalized))))

(defun b1-arithmetic-inverse-uniqueness-rules (equations)
  (if (endp equations)
      nil
    (cons (b1-logic-equal-to (car equations))
          (b1-arithmetic-inverse-uniqueness-rules (cdr equations)))))

(defun b1-arithmetic-inverse-uniqueness-finish
  (product-equation fix-equation extra equations library formula)
  (b1-logic-bookproof-normalize-proof
   library formula extra (list *proof-not*)
   (b1-arithmetic-inverse-uniqueness-rules
    (cons product-equation (cons fix-equation equations))) nil))

(defun b1-arithmetic-inverse-uniqueness (library formula)
  (let ((proof (library-library-proof library)))
    (proof-with-checked-results
     ((parts (proof-list-of-length formula 3))
      (lhs (cadr parts))
      (rhs (caddr parts))
      (factor (proof-term-at lhs 1))
      (operands (proof-list-of-length factor 3)))
     (let* ((x (cadr operands))
            (y (caddr operands))
            (number-x (list *library-numberp* x))
            (number-y (list *library-numberp* y))
            (fix (list *b1-arithmetic-fix* x))
            (test (proof-eq x *proof-zero*)))
       (proof-with-checked-results
        ((numeric (proof-proof-assume proof number-x t))
         (not-numeric (proof-proof-assume proof number-x nil))
         (fix-x (b1-logic-bookproof-normalize library fix (list numeric)
                                              (list *b1-arithmetic-fix*) nil nil nil nil))
         (fix-zero (b1-logic-bookproof-normalize library fix (list not-numeric)
                                                 (list *b1-arithmetic-fix*) nil nil nil nil))
         (zero-x (proof-proof-assume proof test t))
         (nonzero-x (proof-proof-assume proof test nil))
         (nonnumber (b1-arithmetic-nonnumeric-product library factor not-numeric nil))
         (nonnumber (b1-arithmetic-inverse-uniqueness-finish nonnumber fix-zero nil nil library formula))
         (commute (library-library-axiom library "COMMUTATIVITY-OF-*" (list *proof-zero* y)))
         (zero-factor (b1-arithmetic-multiply-zero library y))
         (zero-factor (proof-proof-chain proof commute (list zero-factor)))
         (reverse-zero (proof-proof-symmetric proof zero-x))
         (zero-factor (proof-proof-rewrite proof zero-factor reverse-zero '(1 1 1)))
         (fix-x-zero (proof-proof-chain proof fix-x (list zero-x)))
         (zero (b1-arithmetic-inverse-uniqueness-finish zero-factor fix-x-zero nil nil library formula))
         (inverse (b1-arithmetic-inverse-product library x numeric nonzero-x))
         (rhs-equality (proof-term-at rhs 2))
         (y-inverse (proof-proof-assume proof rhs-equality t))
         (reverse-inverse (proof-proof-symmetric proof y-inverse))
         (good (proof-proof-rewrite proof inverse reverse-inverse '(1 1 2)))
         (y-inverse-true (b1-logic-bookproof-equality-true library y-inverse))
         (yes (b1-arithmetic-inverse-uniqueness-finish good fix-x (list nonzero-x)
                                                      (list y-inverse-true) library formula))
         (lhs-true (proof-proof-assume proof lhs t))
         (y-nonnumber (proof-proof-assume proof number-y nil))
         (product-zero (b1-arithmetic-nonnumeric-product library factor y-nonnumber (list numeric)))
         (impossible (proof-proof-rewrite proof lhs-true product-zero '(1 1)))
         (unequal (b1-logic-bookproof-constant library (proof-eq *proof-zero* *proof-one*)))
         (impossible (proof-proof-rewrite proof impossible unequal '(1)))
         (impossible (proof-proof-tidy proof impossible))
         (y-numeric (proof-proof-front proof impossible number-y))
         (unique (b1-arithmetic-product-unique library inverse lhs-true y-numeric))
         (rhs-false (proof-proof-assume proof rhs-equality nil))
         (lhs-false (proof-proof-cut proof unique rhs-false))
         (lhs-false (proof-proof-front proof lhs-false (proof-neg lhs)))
         (no-value (b1-logic-bookproof-false-value library lhs-false))
         (rhs-false-value (b1-logic-bookproof-false-value library rhs-false))
         (no (b1-arithmetic-inverse-uniqueness-finish no-value fix-x (list nonzero-x)
                                                     (list rhs-false-value) library formula))
         (nonzero (proof-proof-cases proof rhs-equality yes no))
         (number (proof-proof-cases proof test zero nonzero)))
        (proof-proof-cases proof number-x number nonnumber))))))

(defun b1-arithmetic-numerator-product (library rational)
  (let ((proof (library-library-proof library)))
    (proof-with-checked-results ((x (b1-arithmetic-step-at rational 1)))
      (let ((n (list *b1-arithmetic-numerator* x))
            (d (list *b1-arithmetic-denominator* x)))
        (proof-with-checked-results
         ((types (library-library-axiom library "RATIONAL-IMPLIES1" (list x)))
          (types (proof-proof-modus-ponens proof types rational))
          (types (b1-logic-bookproof-split-conjuncts library types))
          (types (proof-list-of-length types 3))
          (d-int (car types))
          (n-int (cadr types))
          (d-pos (caddr types))
          (rep (library-library-axiom library "RATIONAL-IMPLIES2" (list x)))
          (rep (proof-proof-modus-ponens proof rep rational))
          (d-number (b1-arithmetic-known-type library *library-numberp* d (list d-int)))
          (d-nonzero (b1-arithmetic-positive-nonzero library d-pos))
          (inverse (b1-arithmetic-inverse-product library d d-number d-nonzero))
          (step (proof-proof-reflexive proof (b1-arithmetic-product d x)))
          (rep (proof-proof-symmetric proof rep))
          (step (proof-proof-rewrite proof step rep '(1 2 2)))
          (associate (library-library-axiom library "ASSOCIATIVITY-OF-*"
                                            (list d (b1-arithmetic-reciprocal d) n)))
          (associate (proof-proof-symmetric proof associate))
          (step (proof-proof-chain proof step (list associate)))
          (step (proof-proof-rewrite proof step inverse '(1 2 1)))
          (unit (b1-arithmetic-multiply-one library n (list n-int) t))
          (step (proof-proof-chain proof step (list unit)))
          (commute (library-library-axiom library "COMMUTATIVITY-OF-*" (list x d)))
          (step (proof-proof-chain proof commute (list step))))
         (list step (list d-int n-int d-pos)))))))

(defun b1-arithmetic-denominator-of-integer (library int-x)
  (let ((proof (library-library-proof library)))
    (proof-with-checked-results
     ((x (b1-arithmetic-step-at int-x 1))
      (rational (b1-arithmetic-known-type library *library-rationalp* x (list int-x)))
      (result (b1-arithmetic-numerator-product library rational))
      (equation (car result))
      (types (cadr result))
      (int-d (car types))
      (d-positive (caddr types))
      (d (list *b1-arithmetic-denominator* x))
      (num (proof-proof-symmetric proof equation))
      (commute (library-library-axiom library "COMMUTATIVITY-OF-*" (list x d)))
      (num (proof-proof-chain proof num (list commute)))
      (denom (b1-arithmetic-multiply-one library d (list int-d) nil))
      (denom (proof-proof-symmetric proof denom))
      (fact (proof-proof-fact proof (proof-sym "LOWEST-TERMS" "ACL2")
                             (list (list *library-x* x)
                                   (list (proof-sym "N" "ACL2") d)
                                   (list (proof-sym "R" "ACL2") x)
                                   (list (proof-sym "Q" "ACL2") *proof-one*))))
      (test (b1-arithmetic-step-at fact 1))
      (int-one (library-library-type-of library *proof-one* nil))
      (condition (b1-logic-bookproof-normalize-proof
                  library test (list int-d rational int-x int-one d-positive num denom)
                  nil nil nil)))
     (proof-proof-modus-ponens proof fact condition))))

(defun b1-arithmetic-numerator-when-integer-consequence (int-x library)
  (let ((proof (library-library-proof library)))
    (proof-with-checked-results
     ((x (b1-arithmetic-step-at int-x 1))
      (rational (b1-arithmetic-known-type library *library-rationalp* x (list int-x)))
      (result (b1-arithmetic-numerator-product library rational))
      (denominator (b1-arithmetic-denominator-of-integer library int-x))
      (step (proof-proof-rewrite proof (car result) denominator '(1 1 2)))
      (step (proof-proof-symmetric proof step))
      (unit (b1-arithmetic-multiply-one library x (list int-x) nil)))
     (proof-proof-chain proof step (list unit)))))

(defun b1-arithmetic-numerator-when-integer (library formula)
  (proof-with-checked-results
   ((premise (b1-logic-bookproof-prove-implication-premise library formula))
    (consequence (b1-arithmetic-numerator-when-integer-consequence premise library)))
   (b1-logic-bookproof-prove-implication-with-premise library formula premise consequence)))

(defun b1-arithmetic-denominator-when-integer (library formula)
  (proof-with-checked-results
   ((premise (b1-logic-bookproof-prove-implication-premise library formula))
    (consequence (b1-arithmetic-denominator-of-integer library premise)))
   (b1-logic-bookproof-prove-implication-with-premise library formula premise consequence)))

(defun b1-arithmetic-denominator-one (library formula)
  (let ((proof (library-library-proof library)))
    (proof-with-checked-results
     ((lhs (proof-term-at formula 1))
      (argument (proof-term-at lhs 1))
      (x (proof-term-at argument 1)))
     (let* ((d (list *b1-arithmetic-denominator* x))
            (int-x (library-integer x))
            (rat-x (list *library-rationalp* x))
            (d-is-one (proof-eq d *proof-one*)))
       (proof-with-checked-results
        ((has-int (proof-proof-assume proof int-x t))
         (lacks-int (proof-proof-assume proof int-x nil))
         (has-rat (proof-proof-assume proof rat-x t))
         (lacks-rat (proof-proof-assume proof rat-x nil))
         (boolean (proof-proof-fact proof "booleanp-integerp" (list (list *library-x* x))))
         (int-true (b1-logic-bookproof-boolean-value library has-int boolean))
         (denominator (b1-arithmetic-denominator-of-integer library has-int))
         (yes (b1-logic-bookproof-normalize-proof
               library formula nil nil
               (list (b1-logic-equal-to denominator) (b1-logic-equal-to int-true)) nil))
         (default (library-library-axiom library "DEFAULT-DENOMINATOR" (list x)))
         (default (proof-proof-modus-ponens proof default lacks-rat))
         (nonrat (b1-logic-bookproof-normalize-proof
                  library formula (list lacks-int lacks-rat) (list *proof-not*)
                  (list (b1-logic-equal-to default)) nil))
         (rep (b1-arithmetic-numerator-product library has-rat))
         (int-n (cadr (cadr rep)))
         (assumed (proof-proof-assume proof d-is-one t))
         (step (proof-proof-rewrite proof (car rep) assumed '(1 1 2)))
         (step (proof-proof-symmetric proof step))
         (unit (b1-arithmetic-multiply-one library x (list has-rat) nil))
         (step (proof-proof-chain proof step (list unit)))
         (contradiction (proof-proof-rewrite proof int-n step '(1 1)))
         (contradiction (proof-proof-cut proof contradiction lacks-int))
         (d-not-one (proof-proof-front proof contradiction (proof-neg d-is-one)))
         (false-value (b1-logic-bookproof-false-value library d-not-one))
         (rat (b1-logic-bookproof-normalize-proof
               library formula (list lacks-int has-rat) (list *proof-not*)
               (list (b1-logic-equal-to false-value)) nil))
         (no (proof-proof-cases proof rat-x rat nonrat)))
        (proof-proof-cases proof int-x yes no))))))

(defun b1-arithmetic-times-denominator (library formula)
  (let ((proof (library-library-proof library)))
    (proof-with-checked-results
     ((lhs (proof-term-at formula 1))
      (x (proof-term-at lhs 1)))
     (let ((rat (list *library-rationalp* x)))
       (proof-with-checked-results
        ((rational (proof-proof-assume proof rat t))
         (multiplied (b1-arithmetic-numerator-product library rational))
         (yes (b1-logic-bookproof-normalize-proof
               library formula (list rational) nil (list (b1-logic-equal-to (car multiplied))) nil))
         (not-rational (proof-proof-assume proof rat nil))
         (default (library-library-axiom library "DEFAULT-DENOMINATOR" (list x)))
         (default (proof-proof-modus-ponens proof default not-rational))
         (step (proof-proof-reflexive proof lhs))
         (step (proof-proof-rewrite proof step default '(1 2 2)))
         (commute (library-library-axiom library "COMMUTATIVITY-OF-*" (list x *proof-one*)))
         (unit (library-library-axiom library "UNICITY-OF-1" (list x)))
         (step (proof-proof-chain proof step (list commute unit)))
         (no (b1-logic-bookproof-normalize-proof
              library formula (list not-rational) nil (list (b1-logic-equal-to step)) nil)))
        (proof-proof-cases proof rat yes no))))))

(defun b1-arithmetic-additive-inverse (library a b sum-zero)
  (let ((inverse (library-minus a))
        (proof (library-library-proof library)))
    (proof-with-checked-results
     ((commute (library-library-axiom library "COMMUTATIVITY-OF-+" (list inverse a)))
      (cancel (library-library-axiom library "INVERSE-OF-+" (list a)))
      (cancel (proof-proof-chain proof commute (list cancel)))
      (start (b1-arithmetic-add-zero library b nil))
      (start (proof-proof-symmetric proof start))
      (cancel (proof-proof-symmetric proof cancel))
      (start (proof-proof-rewrite proof start cancel '(1 2 1)))
      (associate (library-library-axiom library "ASSOCIATIVITY-OF-+" (list inverse a b)))
      (start (proof-proof-chain proof start (list associate)))
      (start (proof-proof-rewrite proof start sum-zero '(1 2 2)))
      (commute (library-library-axiom library "COMMUTATIVITY-OF-+" (list inverse *proof-zero*)))
      (unit (b1-arithmetic-add-zero library inverse nil)))
     (proof-proof-chain proof start (list commute unit)))))

(defun b1-arithmetic-number-sums-p (value)
  (and (consp value) (eq (car value) :b1-number-sums)))

(defun b1-arithmetic-number-sums-library (sums)
  (cadr sums))

(defun b1-arithmetic-number-sums-with-library (sums library)
  (list (car sums) library))

(defun b1-arithmetic-number-sums-cite (sums name args evidence)
  (library-library-cite
   (b1-arithmetic-number-sums-library sums)
   (if (member-equal name '("ADD-ZERO-LEFT" "ADD-ZERO-RIGHT" "DOUBLE-NEGATION" "NEGATE-SUM"))
       (concatenate 'string "NUMBER-" name)
     name)
   args evidence))

(defun b1-arithmetic-number-sums-type-of (sums term evidence)
