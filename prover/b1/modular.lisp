       (inverse (b1-logic-bookproof-normalize lib (b1-arithmetic-product divisor recip)
                                             nil nil nil nil nil nil))
       (unit (proof-proof-rewrite proof associated inverse '(1 2 2)))
       (identity (b1-arithmetic-multiply-one lib floor (list integral-floor) nil))
       (step (proof-proof-chain proof scaled (list unit identity))))
    (cons step lib)))

