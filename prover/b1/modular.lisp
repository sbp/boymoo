(in-package "BOYMOO-PROVER")
(set-verify-guards-eagerness 0)

(defconst *b1-modular-mod* (proof-cl "MOD"))

(defun b1-modular-modulus-init (lib integral strict)
  (proof-with-checked-results
      ((literal (proof-step-first integral))
       (divisor (proof-term-at literal 1)))
    (list :b1-modulus lib integral strict divisor)))

(defun b1-modular-modulus-lib (ring)
  (cadr ring))

(defun b1-modular-modulus-integer (ring)
  (caddr ring))

(defun b1-modular-modulus-positive (ring)
  (cadddr ring))

(defun b1-modular-modulus-divisor (ring)
  (nth 4 ring))

(defun b1-modular-modulus-with-lib (ring lib)
  (list :b1-modulus lib (b1-modular-modulus-integer ring)
        (b1-modular-modulus-positive ring) (b1-modular-modulus-divisor ring)))

(defun b1-modular-modulus-mod (ring argument)
  (list *b1-modular-mod* argument (b1-modular-modulus-divisor ring)))

(defun b1-modular-modulus-floor (ring argument)
  (list *b1-quotient-floor* argument (b1-modular-modulus-divisor ring)))

(defun b1-modular-modulus-ratio (ring argument)
  (b1-arithmetic-product argument
                        (b1-arithmetic-reciprocal (b1-modular-modulus-divisor ring))))

(defun b1-modular-modulus-rational (ring argument integral)
  (b1-arithmetic-known-type (b1-modular-modulus-lib ring) *library-rationalp*
                            (b1-modular-modulus-ratio ring argument)
                            (list integral (b1-modular-modulus-integer ring))))

(defun b1-modular-modulus-inverse (ring reverse)
  (let ((lib (b1-modular-modulus-lib ring))
        (n (b1-modular-modulus-divisor ring)))
    (proof-with-checked-results
        ((number (b1-arithmetic-known-type lib *library-numberp* n
                                         (list (b1-modular-modulus-integer ring))))
         (nonzero (b1-arithmetic-positive-nonzero lib (b1-modular-modulus-positive ring)))
         (result (b1-arithmetic-inverse-product lib n number nonzero)))
      (if reverse
          (proof-with-checked-results
              ((commuted (library-library-axiom lib "COMMUTATIVITY-OF-*"
                                               (list (b1-arithmetic-reciprocal n) n))))
            (proof-proof-chain (library-library-proof lib) commuted (list result)))
        result))))

(defun b1-modular-modulus-inverse-positive (ring)
  (let ((lib (b1-modular-modulus-lib ring)))
    (proof-with-checked-results
        ((rational (b1-arithmetic-known-type lib *library-rationalp*
                                           (b1-modular-modulus-divisor ring)
                                           (list (b1-modular-modulus-integer ring)))))
      (b1-arithmetic-positive-reciprocal lib (b1-modular-modulus-positive ring) rational))))

(defun b1-modular-modulus-scale-ratio (ring term integral)
  (let* ((lib (b1-modular-modulus-lib ring))
         (proof (library-library-proof lib))
         (n (b1-modular-modulus-divisor ring))
         (inv (b1-arithmetic-reciprocal n))
         (ratio (b1-modular-modulus-ratio ring term)))
    (proof-with-checked-results
        ((original (proof-proof-reflexive proof (b1-arithmetic-product n ratio)))
         (commuted (library-library-axiom lib "COMMUTATIVITY-OF-*" (list term inv)))
         (swapped (proof-proof-rewrite proof original commuted '(1 2 2)))
         (inverse (b1-modular-modulus-inverse ring nil))
         (numeric (b1-arithmetic-known-type lib *library-numberp* term (list integral)))
         (cancel (b1-powers-multiply-inverse lib n inv term inverse numeric)))
      (proof-proof-chain proof swapped (list cancel)))))

(defun b1-modular-remainder-lemma-consequence (premise lib x n term lower claim)
  (proof-with-checked-results
      ((conjuncts (b1-logic-bookproof-split-conjuncts lib premise))
       (parts (proof-list-of-length conjuncts 3))
       (int-x (car parts))
       (int-n (cadr parts))
       (pos-n (caddr parts))
       (ring (b1-modular-modulus-init lib int-n pos-n))
       (f (b1-modular-modulus-floor ring x))
       (rational (b1-modular-modulus-rational ring x int-x))
       (interval (b1-floor-interval lib f rational))
       (lib (cdr interval))
       (proof (library-library-proof lib))
       (ring (b1-modular-modulus-with-lib ring lib))
       (int-f (caar interval))
       (lower-q (cadar interval))
       (upper-q (caddar interval))
       (reduction (proof-proof-unfold proof term))
       (residue (caddr (proof-step-first reduction)))
       (integral (library-library-type-of lib residue (list int-x int-f int-n)))
       (integral (library-library-transport-argument lib integral reduction 1))
       (bad (proof-term-at lower 1))
       (negative (proof-proof-assume proof bad t))
       (negative (proof-proof-rewrite proof negative reduction '(1 1)))
       (difference (library-library-axiom lib "<-ON-OTHERS"
                                         (list x (b1-arithmetic-product f n))))
       (negative (proof-proof-transport proof negative difference))
       (inverse-positive (b1-modular-modulus-inverse-positive ring))
       (lib (cdr inverse-positive))
       (scaled (b1-arithmetic-multiply-strict lib (car inverse-positive) negative
                                             (list int-x int-f int-n)))
       (lib (cdr scaled))
       (proof (library-library-proof lib))
       (ring (b1-modular-modulus-with-lib ring lib))
       (inv (b1-arithmetic-reciprocal n))
       (commuted (library-library-axiom lib "COMMUTATIVITY-OF-*" (list inv x)))
       (scaled (proof-proof-rewrite proof (car scaled) commuted '(1 1)))
       (commuted (library-library-axiom lib "COMMUTATIVITY-OF-*" (list f n)))
       (scaled (proof-proof-rewrite proof scaled commuted '(1 2 2)))
       (inverse (b1-modular-modulus-inverse ring t))
       (numeric (b1-arithmetic-known-type lib *library-numberp* f (list int-f)))
       (cancel (b1-powers-multiply-inverse lib inv n f inverse numeric))
       (scaled (proof-proof-rewrite proof scaled cancel '(1 2)))
       (conflict (proof-proof-cut proof scaled lower-q))
       (nonnegative-rem (proof-proof-front proof conflict lower))

       (bound (b1-arithmetic-multiply-strict lib pos-n upper-q (list rational int-f int-n int-x)))
       (lib (cdr bound))
       (proof (library-library-proof lib))
       (ring (b1-modular-modulus-with-lib ring lib))
       (scaled (b1-modular-modulus-scale-ratio ring x int-x))
       (bound (proof-proof-rewrite proof (car bound) scaled '(1 1)))
       (distributed (library-library-axiom lib "DISTRIBUTIVITY" (list n *proof-one* f)))
       (commuted (library-library-axiom lib "COMMUTATIVITY-OF-*" (list n f)))
       (distributed (proof-proof-rewrite proof distributed commuted '(1 2 2)))
       (unit (b1-arithmetic-multiply-one lib n (list int-n) nil))
       (distributed (proof-proof-rewrite proof distributed unit '(1 2 1)))
       (bound (proof-proof-rewrite proof bound distributed '(1 2)))
       (sums (b1-arithmetic-number-sums-init lib))
       (lib (b1-arithmetic-number-sums-library sums))
       (proof (library-library-proof lib))
       (alignment (b1-arithmetic-number-sums-comparison-equation
                   sums (proof-step-first bound) (library-lt residue n) (list int-x int-n int-f)))
       (bound (proof-proof-rewrite proof bound alignment '(1)))
       (folded (proof-proof-symmetric proof reduction))
       (bound (proof-proof-rewrite proof bound folded '(1 1)))
       (upper-rem (proof-proof-tidy proof bound))
       (step (b1-logic-bookproof-normalize-proof
              lib claim (list integral nonnegative-rem upper-rem) nil nil nil)))
    (cons step lib)))

(defun b1-modular-remainder-lemma (lib)
  (let ((name (proof-sym "SELF-MOD-INTERVAL" "ACL2")))
    (if (assoc-equal name (proof-proof-facts (library-library-proof lib)))
        (cons name lib)
      (let* ((x *library-x*)
             (n *library-y*)
             (term (list *b1-modular-mod* x n))
             (lower (library-nonnegative term))
             (upper (library-lt term n))
             (claim (proof-ite (library-integer term) (proof-ite lower upper *proof-false*)
                               *proof-false*))
             (guard (proof-ite (library-integer x)
                               (proof-ite (library-integer n) (library-positive n) *proof-false*)
                               *proof-false*))
             (formula (list *library-implies* guard claim)))
        (proof-with-checked-results
            ((premise (b1-logic-bookproof-prove-implication-premise lib formula))
             (consequence (b1-modular-remainder-lemma-consequence premise lib x n term lower claim))
             (lib (cdr consequence))
             (step (b1-logic-bookproof-prove-implication-with-premise lib formula premise
                                                                   (car consequence)))
             (lib (library-library-lemma lib "MOD-INTERVAL" formula step nil)))
          (cons name lib))))))

(defun b1-modular-modulus-bounds (ring integral)
  (proof-with-checked-results
      ((lemma (b1-modular-remainder-lemma (b1-modular-modulus-lib ring)))
       (lib (cdr lemma))
       (proof (library-library-proof lib))
       (literal (proof-step-first integral))
       (argument (proof-term-at literal 1))
       (fact (proof-proof-fact proof (car lemma)
                              (list (list *library-x* argument)
                                    (list *library-y* (b1-modular-modulus-divisor ring)))))
       (guard (b1-logic-bookproof-normalize-proof lib (cadr (proof-step-first fact))
                                                (list integral (b1-modular-modulus-integer ring)
                                                      (b1-modular-modulus-positive ring))
                                                nil nil nil))
       (bounds (proof-proof-modus-ponens proof fact guard))
       (steps (b1-logic-bookproof-split-conjuncts lib bounds)))
    (cons steps lib)))

(defun b1-modular-modulus-canonical (ring integral lower upper)
  (proof-with-checked-results
      ((lib (b1-modular-modulus-lib ring))
       (n (b1-modular-modulus-divisor ring))
       (literal (proof-step-first integral))
       (x (proof-term-at literal 1))
       (q (b1-modular-modulus-ratio ring x))
       (rational (b1-modular-modulus-rational ring x integral))
       (actual (b1-floor-interval lib (b1-modular-modulus-floor ring x) rational))
       (lib (cdr actual))
       (ring (b1-modular-modulus-with-lib ring lib))
       (integers (list integral (b1-modular-modulus-integer ring)))
       (inverse-positive (b1-modular-modulus-inverse-positive ring))
       (lib (cdr inverse-positive))
       (multiply (b1-arithmetic-multiply-strict lib (car inverse-positive) upper integers))
       (lib (cdr multiply))
       (proof (library-library-proof lib))
       (ring (b1-modular-modulus-with-lib ring lib))
       (commuted (library-library-axiom lib "COMMUTATIVITY-OF-*"
                                       (list (b1-arithmetic-reciprocal n) x)))
       (bound (proof-proof-rewrite proof (car multiply) commuted '(1 1)))
       (inverse (b1-modular-modulus-inverse ring t))
       (bound (proof-proof-rewrite proof bound inverse '(1 2)))
       (bad (library-lt q *proof-zero*))
       (assumed (proof-proof-assume proof bad t))
       (multiply (b1-arithmetic-multiply-strict lib (b1-modular-modulus-positive ring) assumed
                                               (list rational (b1-modular-modulus-integer ring))))
       (lib (cdr multiply))
       (proof (library-library-proof lib))
       (ring (b1-modular-modulus-with-lib ring lib))
       (scaled (b1-modular-modulus-scale-ratio ring x integral))
       (impossible (proof-proof-rewrite proof (car multiply) scaled '(1 1)))
       (zero (b1-arithmetic-multiply-zero lib n))
       (impossible (proof-proof-rewrite proof impossible zero '(1 2)))
       (conflict (proof-proof-cut proof impossible lower))
       (nonnegative-q (proof-proof-front proof conflict (proof-neg bad)))
       (one (b1-logic-bookproof-constant lib (library-plus *proof-one* *proof-zero*)))
       (one (proof-proof-symmetric proof one))
       (upper-q (proof-proof-rewrite proof bound one '(1 2)))
       (int-zero (library-library-type-of lib *proof-zero* nil))
       (floor (b1-floor-equal-intervals lib (car actual) (list int-zero nonnegative-q upper-q) rational))
       (lib (cdr floor))
       (proof (library-library-proof lib))
       (result (proof-proof-unfold proof (b1-modular-modulus-mod ring x)))
       (result (proof-proof-rewrite proof result (car floor) '(1 2 2 1 1)))
       (commuted (library-library-axiom lib "COMMUTATIVITY-OF-*" (list *proof-zero* n)))
       (zero (b1-arithmetic-multiply-zero lib n))
       (zero (proof-proof-chain proof commuted (list zero)))
       (result (proof-proof-rewrite proof result zero '(1 2 2 1)))
       (zero (b1-logic-bookproof-constant lib (library-minus *proof-zero*)))
       (result (proof-proof-rewrite proof result zero '(1 2 2)))
       (identity (library-library-cite lib "ADD-ZERO-RIGHT" (list x) (list integral)))
       (step (proof-proof-chain proof result (list identity))))
    (cons step lib)))

(defun b1-modular-remainder-consequence-select (steps conclusion)
  (if (endp steps)
      '(:failure "failure" "")
    (proof-with-checked-results ((first (proof-step-first (car steps))))
      (if (equal first conclusion)
          (car steps)
        (b1-modular-remainder-consequence-select (cdr steps) conclusion)))))

(defun b1-modular-remainder-consequence-consequence (integral ring conclusion)
  (proof-with-checked-results
      ((bounds (b1-modular-modulus-bounds ring integral))
       (step (b1-modular-remainder-consequence-select (car bounds) conclusion)))
    (cons step (cdr bounds))))

(defun b1-modular-remainder-consequence (lib formula)
  (proof-with-checked-results
      ((conclusion (proof-term-at formula 2))
       (head (proof-term-at conclusion 0))
       (comparison (if (equal head *proof-not*) (proof-term-at conclusion 1) conclusion))
       (modulus (proof-term-at comparison 1))
       (divisor (proof-term-at modulus 2))
       (type (library-library-type-of lib divisor nil))
       (positive (b1-logic-bookproof-normalize-proof lib (library-positive divisor) nil nil nil nil))
       (ring (b1-modular-modulus-init lib type positive))
       (premise (b1-logic-bookproof-prove-implication-premise lib formula))
       (result (b1-modular-remainder-consequence-consequence premise ring conclusion))
       (lib (cdr result))
       (step (b1-logic-bookproof-prove-implication-with-premise lib formula premise (car result))))
    (cons step lib)))

(defun b1-modular-exact-remainder-quotient-consequence (premise lib quotient floor argument divisor)
  (proof-with-checked-results
      ((conjuncts (b1-logic-bookproof-split-conjuncts lib premise))
       (parts (proof-list-of-length conjuncts 2))
       (residue (car parts))
       (rational (cadr parts))
       (literal (proof-step-first residue))
       (sides (proof-list-of-length literal 3))
       (remainder (cadr sides))
       (mod (caddr sides))
       (raw (b1-arithmetic-product argument (b1-arithmetic-reciprocal divisor)))
       (rational-quotient (b1-arithmetic-known-type lib *library-rationalp* raw (list rational)))
       (interval (b1-floor-interval lib floor rational-quotient))
       (lib (cdr interval))
       (proof (library-library-proof lib))
       (integral-floor (caar interval))
       (expanded (proof-proof-unfold proof mod))
       (known-value (proof-proof-chain proof residue (list expanded)))
       (sums (b1-arithmetic-number-sums-init lib))
       (lib (b1-arithmetic-number-sums-library sums))
       (proof (library-library-proof lib))
       (numerator (proof-term-at quotient 1))
       (difference (b1-arithmetic-number-sums-linear-equal
                    sums numerator (library-diff argument remainder) (list rational)))
       (difference (proof-proof-rewrite proof difference known-value '(1 2 2 1)))
       (multiple (b1-arithmetic-product floor divisor))
       (aligned (b1-arithmetic-number-sums-linear-equal
                 sums (caddr (proof-step-first difference)) multiple (list rational integral-floor)))
       (difference (proof-proof-chain proof difference (list aligned)))
       (original (proof-proof-reflexive proof quotient))
       (scaled (proof-proof-rewrite proof original difference '(1 2 1)))
       (recip (proof-term-at quotient 2))
