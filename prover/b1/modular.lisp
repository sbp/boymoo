(defun b1-modular-shift-lemma (lib)
  (let ((name (proof-sym "SELF-MOD-INTEGER-SHIFT" "ACL2"))
        (proof (library-library-proof lib)))
    (if (assoc-equal name (proof-proof-facts proof))
        (cons name lib)
      (let* ((x *library-x*)
             (n *library-y*)
             (k *library-z*)
             (multiple (b1-arithmetic-product n k))
             (shifted (library-plus x multiple))
             (inv (b1-arithmetic-reciprocal n)))
        (proof-with-checked-results
            ((integers (library-library-ints lib (list x n k)))
             (int-x (car integers))
             (int-n (cadr integers))
             (int-k (caddr integers))
             (positive (proof-proof-assume proof (library-positive n) t))
             (ring (b1-modular-modulus-init lib int-n positive))
             (int-shifted (library-library-type-of lib shifted integers))
             (commuted (library-library-axiom lib "COMMUTATIVITY-OF-*" (list shifted inv)))
             (distributed (library-library-axiom lib "DISTRIBUTIVITY" (list inv x multiple)))
             (ratio (proof-proof-chain proof commuted (list distributed)))
             (commuted (library-library-axiom lib "COMMUTATIVITY-OF-*" (list inv x)))
             (ratio (proof-proof-rewrite proof ratio commuted '(1 2 1)))
             (inverse (b1-modular-modulus-inverse ring t))
             (numeric (b1-arithmetic-known-type lib *library-numberp* k (list int-k)))
             (cancellation (b1-powers-multiply-inverse lib inv n k inverse numeric))
             (ratio (proof-proof-rewrite proof ratio cancellation '(1 2 2)))
             (rational-x (b1-modular-modulus-rational ring x int-x))
             (rational-shifted (b1-modular-modulus-rational ring shifted int-shifted))
             (floor (b1-floor-translate-floor lib (b1-modular-modulus-floor ring x)
                                              (b1-modular-modulus-floor ring shifted)
                                              rational-x rational-shifted ratio int-k))
             (lib (cdr floor))
             (proof (library-library-proof lib))
             (lhs (proof-proof-unfold proof (b1-modular-modulus-mod ring shifted)))
             (rhs (proof-proof-unfold proof (b1-modular-modulus-mod ring x)))
             (lhs (proof-proof-rewrite proof lhs (car floor) '(1 2 2 1 1)))
             (f (b1-modular-modulus-floor ring x))
             (commuted (library-library-axiom lib "COMMUTATIVITY-OF-*" (list (library-plus f k) n)))
             (distributed (library-library-axiom lib "DISTRIBUTIVITY" (list n f k)))
             (scale (proof-proof-chain proof commuted (list distributed)))
             (commuted (library-library-axiom lib "COMMUTATIVITY-OF-*" (list n f)))
             (scale (proof-proof-rewrite proof scale commuted '(1 2 1)))
             (lhs (proof-proof-rewrite proof lhs scale '(1 2 2 1)))
             (sums (b1-arithmetic-number-sums-init lib))
             (lib (b1-arithmetic-number-sums-library sums))
             (proof (library-library-proof lib))
             (normal (b1-arithmetic-number-sums-linear-equal
                      sums (caddr (proof-step-first lhs)) (caddr (proof-step-first rhs)) integers))
             (reversed (proof-proof-symmetric proof rhs))
             (step (proof-proof-chain proof lhs (list normal reversed)))
             (lib (library-library-lemma lib "MOD-INTEGER-SHIFT" (proof-step-first step) step
                                         (list (proof-neg (proof-step-first int-x))
                                               (proof-neg (proof-step-first int-n))
                                               (proof-neg (proof-step-first int-k))
                                               (proof-neg (proof-step-first positive))))))
          (cons name lib))))))

(defun b1-modular-product-lemma (lib)
  (let ((name (proof-sym "SELF-MOD-PRODUCT" "ACL2"))
        (proof (library-library-proof lib)))
    (if (assoc-equal name (proof-proof-facts proof))
        (cons name lib)
      (let ((a *library-x*)
            (b *library-y*)
            (n *library-z*))
        (proof-with-checked-results
            ((integers (library-library-ints lib (list a b n)))
             (int-a (car integers))
             (int-b (cadr integers))
             (int-n (caddr integers))
             (positive (proof-proof-assume proof (library-positive n) t))
             (ring (b1-modular-modulus-init lib int-n positive))
             (f (b1-modular-modulus-floor ring a))
             (rational-a (b1-modular-modulus-rational ring a int-a))
             (interval (b1-floor-interval lib f rational-a))
             (lib (cdr interval))
             (proof (library-library-proof lib))
             (int-f (caar interval))
             (residue-term (b1-modular-modulus-mod ring a))
             (residue (proof-proof-unfold proof residue-term))
             (negated (b1-arithmetic-multiply-negation lib n f))
             (lib (cdr negated))
             (proof (library-library-proof lib))
             (reorient (proof-proof-symmetric proof (car negated)))
             (commuted (library-library-axiom lib "COMMUTATIVITY-OF-*" (list n f)))
             (reorient (proof-proof-rewrite proof reorient commuted '(1 1 1)))
             (residue (proof-proof-rewrite proof residue reorient '(1 2 2)))
             (expanded (caddr (proof-step-first residue)))
             (multiplied (proof-proof-reflexive proof (b1-arithmetic-product residue-term b)))
             (multiplied (proof-proof-rewrite proof multiplied residue '(1 2 1)))
             (commuted (library-library-axiom lib "COMMUTATIVITY-OF-*" (list expanded b)))
             (negative-nf (b1-arithmetic-product n (library-minus f)))
             (distributed (library-library-axiom lib "DISTRIBUTIVITY" (list b a negative-nf)))
             (multiplied (proof-proof-chain proof multiplied (list commuted distributed)))
             (commuted (library-library-axiom lib "COMMUTATIVITY-OF-*" (list b a)))
             (multiplied (proof-proof-rewrite proof multiplied commuted '(1 2 1)))
             (commuted (library-library-axiom lib "COMMUTATIVITY-OF-*" (list b negative-nf)))
             (multiplied (proof-proof-rewrite proof multiplied commuted '(1 2 2)))
             (associated (library-library-axiom lib "ASSOCIATIVITY-OF-*" (list n (library-minus f) b)))
             (multiplied (proof-proof-rewrite proof multiplied associated '(1 2 2)))
             (shift (b1-arithmetic-product (library-minus f) b))
             (types (list int-a int-b int-n int-f))
             (lemma (b1-modular-shift-lemma lib))
             (lib (cdr lemma))
             (proof (library-library-proof lib))
             (ab (b1-arithmetic-product a b))
             (int-ab (library-library-type-of lib ab types))
             (int-shift (library-library-type-of lib shift types))
             (shifted (proof-proof-use proof (car lemma)
                                       (list (list *library-x* ab) (list *library-y* n) (list *library-z* shift))
                                       (list int-ab int-n int-shift positive)))
             (term (b1-modular-modulus-mod ring (b1-arithmetic-product residue-term b)))
             (result (proof-proof-reflexive proof term))
             (result (proof-proof-rewrite proof result multiplied '(1 2 1)))
             (step (proof-proof-chain proof result (list shifted)))
             (lib (library-library-lemma lib "MOD-PRODUCT" (proof-step-first step) step
                                         (list (proof-neg (proof-step-first int-a))
                                               (proof-neg (proof-step-first int-b))
                                               (proof-neg (proof-step-first int-n))
                                               (proof-neg (proof-step-first positive))))))
          (cons name lib))))))

(defun b1-modular-modulus-product (ring first second left)
  (proof-with-checked-results
      ((lib (b1-modular-modulus-lib ring))
       (n (b1-modular-modulus-divisor ring))
       (literal (proof-step-first first))
       (a (proof-term-at literal 1))
       (literal (proof-step-first second))
       (b (proof-term-at literal 1))
       (lemma (b1-modular-product-lemma lib))
       (lib (cdr lemma))
       (proof (library-library-proof lib))
       (reduction (proof-proof-use proof (car lemma)
                                   (list (list *library-x* a) (list *library-y* b) (list *library-z* n))
                                   (list first second (b1-modular-modulus-integer ring)
                                         (b1-modular-modulus-positive ring)))))
    (if left
        (cons reduction lib)
      (proof-with-checked-results
          ((left (library-library-axiom lib "COMMUTATIVITY-OF-*"
                                        (list (b1-modular-modulus-mod ring a) b)))
           (right (library-library-axiom lib "COMMUTATIVITY-OF-*" (list a b)))
           (reduction (proof-proof-rewrite proof reduction left '(1 1 1)))
           (step (proof-proof-rewrite proof reduction right '(1 2 1))))
        (cons step lib)))))

(defun b1-modular-modulus-product-congruence (ring first second fixed equality left)
  (proof-with-checked-results
      ((before (b1-modular-modulus-product ring first fixed left))
       (ring (b1-modular-modulus-with-lib ring (cdr before)))
       (after (b1-modular-modulus-product ring second fixed left))
       (lib (cdr after))
       (proof (library-library-proof lib))
       (symmetric (proof-proof-symmetric proof (car before)))
       (result (proof-proof-rewrite proof symmetric equality (list 1 2 1 (if left 1 2))))
       (step (proof-proof-chain proof result (list (car after)))))
    (cons step lib)))
