  (proof-with-checked-results
      ((conjuncts (b1-logic-bookproof-split-conjuncts lib premise))
       (parts (proof-list-of-length conjuncts 2))
       (residue (car parts))
       (rational (cadr parts))
       (literal (proof-step-first rational))
       (argument (proof-term-at literal 1))
       (fact (b1-modular-exact-remainder-integral-fact lib formula equality claims residue argument))
       (equation (proof-proof-modus-ponens (library-library-proof lib) fact premise))
       (literal (proof-step-first equation))
       (floor (proof-term-at literal 2))
       (divisor (proof-term-at floor 2))
       (raw (b1-arithmetic-product argument (b1-arithmetic-reciprocal divisor)))
       (rational-quotient (b1-arithmetic-known-type lib *library-rationalp* raw (list rational)))
       (interval (b1-floor-interval lib floor rational-quotient))
       (lib (cdr interval))
       (step (library-library-transport-argument lib (caar interval) equation 1)))
