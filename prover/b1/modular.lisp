(defun b1-modular-exact-remainder-integral-fact (lib formula equality claims residue argument)
  (if (eq equality :none)
      (proof-with-checked-results
          ((literal (proof-step-first residue))
           (modulus (proof-term-at literal 2))
           (divisor (proof-term-at modulus 2))
           (test (proof-term-at formula 1))
           (conclusion (proof-term-at formula 2))
           (quotient (proof-term-at conclusion 1))
           (claim (list *library-implies* test (proof-eq quotient (list *b1-quotient-floor* argument divisor))))
           (name (b1-logic-matching-claim claims claim)))
        (if name
            (b1-logic-bookproof-from-fact lib name claim)
          '(:failure "failure" "")))
    (proof-proof-fact (library-library-proof lib) (proof-sym equality "ACL2")
                      (list (list *library-x* argument)))))

