(in-package "BOYMOO-PROVER")
(set-verify-guards-eagerness 0)

(defun b1-monotone-rational-expt (lib base exponent rational)
  (b1-parity-power-type lib "RATIONALP-EXPT-TYPE-PRESCRIPTION" base exponent (list rational)))

(defun b1-monotone-natural-power-bound-consequence
    (premise lib sums r n p at-zero claim formula bindings one-positive)
  (proof-with-checked-results
      ((proof (library-library-proof lib))
       (conjuncts (b1-logic-bookproof-split-conjuncts lib premise))
       (parts (proof-list-of-length conjuncts 3))
       (nat-n (car parts))
       (rational (cadr parts))
       (r-above-one (caddr parts))
       (r-number (b1-arithmetic-known-type lib *library-numberp* r (list rational)))
       (r-positive (b1-arithmetic-number-sums-strict-chain sums one-positive r-above-one (list r-number)))
       (nonzero (b1-arithmetic-comparison-excludes lib r-above-one *proof-zero* 2))
       (zero (proof-proof-assume proof at-zero t))
       (zero-power (b1-powers-expt-zero lib r))
       (base (b1-logic-bookproof-normalize-proof lib claim nil nil
                                                (list (b1-logic-equal-to zero)
                                                      (b1-logic-equal-to zero-power)) nil))
       (negative (proof-proof-assume proof at-zero nil))
       (n-int (library-library-cite lib "NATURAL-INTEGER" (list n) (list nat-n)))
       (predecessor (b1-powers-natural-predecessor lib nat-n negative))
       (nat-p (car predecessor))
       (descent (cadr predecessor))
       (child (proof-subst formula bindings))
       (assumed (proof-proof-assume proof (proof-ite (proof-step-first descent) child *proof-true*) t))
       (hypothesis (proof-proof-prove-if proof assumed descent))
       (child-guard (b1-logic-bookproof-normalize-proof lib (cadr child)
                                                       (list nat-p rational r-above-one) nil nil nil))
       (bound (proof-proof-modus-ponens proof hypothesis child-guard))
       (child-zero (cadr (proof-step-first bound)))
       (assumed (proof-proof-assume proof child-zero t))
       (zero-case (proof-proof-prove-if proof bound assumed))
       (assumed (proof-proof-assume proof child-zero nil))
       (gt-case (proof-proof-prove-if proof bound assumed))
       (int-p (library-library-type-of lib p (list n-int)))
       (expand (library-library-cite lib "EXPT-STEP-UP" (list r p) (list int-p r-number nonzero)))
       (canonical (library-library-linear-equal lib (library-plus p *proof-one*) n (list n-int)))
       (expand (proof-proof-rewrite proof expand canonical '(1 1 2)))
       (opened (proof-proof-reflexive proof (caddr (proof-step-first expand))))
       (opened (proof-proof-rewrite proof opened zero-case '(1 2 2)))
       (unit (b1-arithmetic-multiply-one lib r (list r-number) nil))
       (reduce (proof-proof-chain proof expand (list opened unit)))
       (yes (library-library-transport-argument lib r-above-one reduce 2))
       (p-rational (b1-monotone-rational-expt lib r p rational))
       (scaled (b1-arithmetic-multiply-strict lib r-positive gt-case (list rational p-rational)))
       (lib (cdr scaled))
       (proof (library-library-proof lib))
       (unit (b1-arithmetic-multiply-one lib r (list r-number) nil))
       (increase (proof-proof-rewrite proof (car scaled) unit '(1 1)))
       (exp-number (b1-powers-expt-number lib r p))
       (lib (cdr exp-number))
       (proof (library-library-proof lib))
       (sums (b1-arithmetic-number-sums-with-library sums lib))
       (no (b1-arithmetic-number-sums-strict-chain sums r-above-one increase
                                                  (list r-number (car exp-number))))
       (no (library-library-transport-argument lib no expand 2))
       (successor (proof-proof-cases proof child-zero yes no))
       (selected (proof-proof-select proof claim negative))
       (successor (proof-proof-transport proof successor selected))
       (step (proof-proof-cases proof at-zero base successor)))
    (cons step lib)))

(defun b1-monotone-natural-power-bound (lib)
  (let ((name (proof-sym "SELF-NATURAL-POWER-BOUND" "ACL2")))
    (if (assoc-equal name (proof-proof-facts (library-library-proof lib)))
        (cons name lib)
      (proof-with-checked-results
          ((lib (b1-powers-build-recurrences lib))
           (sums (b1-arithmetic-number-sums-init lib))
           (lib (b1-arithmetic-number-sums-library sums))
           (proof (library-library-proof lib))
           (r *library-x*)
           (n *library-y*)
           (p (library-plus n *proof-neg-one*))
           (value (b1-powers-expt r n))
           (at-zero (proof-eq n *proof-zero*))
           (claim (proof-ite at-zero (proof-eq value *proof-one*) (library-lt *proof-one* value)))
           (guard (proof-ite (list *library-natp* n)
                             (proof-ite (list *library-rationalp* r) (library-lt *proof-one* r) *proof-false*)
                             *proof-false*))
           (formula (list *library-implies* guard claim))
           (bindings (list (cons n p)))
           (one-positive (proof-proof-prove proof (library-positive *proof-one*) nil nil))
           (premise (b1-logic-bookproof-prove-implication-premise lib formula))
           (consequence (b1-monotone-natural-power-bound-consequence
                         premise lib sums r n p at-zero claim formula bindings one-positive))
           (lib (cdr consequence))
           (step (b1-logic-bookproof-prove-implication-with-premise lib formula premise (car consequence)))
           (ordinal (library-library-builtin lib 1 n))
           (step (proof-proof-induct (library-library-proof lib) ordinal step formula
                                     (list *library-count* n) (list (table-items bindings))))
           (lib (library-library-lemma lib "NATURAL-POWER-BOUND" formula step nil)))
        (cons name lib)))))

(defun b1-monotone-bound-for-power (lib base exponent natural rational base-bound)
  (proof-with-checked-results
      ((lemma (b1-monotone-natural-power-bound lib))
       (lib (cdr lemma))
       (proof (library-library-proof lib))
       (fact (proof-proof-fact proof (car lemma) (list (list *library-x* base) (list *library-y* exponent))))
       (premise (b1-logic-bookproof-normalize-proof lib (cadr (proof-step-first fact))
                                                   (list natural rational base-bound) nil nil nil))
       (step (proof-proof-modus-ponens proof fact premise)))
    (cons step lib)))

(defun b1-monotone-positive-power-from-natural (natural lib base rational base-bound)
  (proof-with-checked-results
      ((literal (proof-step-first natural))
       (k (proof-term-at literal 1))
       (bound (b1-monotone-bound-for-power lib base k natural rational base-bound))
       (lib (cdr bound))
       (proof (library-library-proof lib))
       (bound (car bound))
       (is-zero (cadr (proof-step-first bound)))
       (one-positive (proof-proof-prove proof (library-positive *proof-one*) nil nil))
       (zero (proof-proof-assume proof is-zero t))
       (zero-value (proof-proof-prove-if proof bound zero))
       (yes (library-library-transport-argument lib one-positive zero-value 2))
       (sums (b1-arithmetic-number-sums-init lib))
       (lib (b1-arithmetic-number-sums-library sums))
       (proof (library-library-proof lib))
       (one-positive (proof-proof-prove proof (library-positive *proof-one*) nil nil))
       (nonzero (proof-proof-assume proof is-zero nil))
       (strict (proof-proof-prove-if proof bound nonzero))
       (numeric (b1-powers-expt-number lib base k))
       (lib (cdr numeric))
       (sums (b1-arithmetic-number-sums-with-library sums lib))
       (no (b1-arithmetic-number-sums-strict-chain sums one-positive strict (list (car numeric))))
       (step (proof-proof-cases (library-library-proof lib) is-zero yes no)))
    (cons step lib)))

(defun b1-monotone-positive-power (lib base integral rational base-bound)
  (proof-with-checked-results
      ((proof (library-library-proof lib))
       (literal (proof-step-first integral))
       (exponent (proof-term-at literal 1))
       (test (library-lt exponent *proof-zero*))
       (numeric (b1-arithmetic-known-type lib *library-numberp* base (list rational)))
       (nonzero (b1-arithmetic-comparison-excludes lib base-bound *proof-zero* 2))
       (assumed (proof-proof-assume proof test nil))
       (nonnegative (library-library-cite lib "NATURAL-FROM-BOUNDS" (list exponent) (list integral assumed)))
       (positive (b1-monotone-positive-power-from-natural nonnegative lib base rational base-bound))
       (yes (car positive))
       (lib (cdr positive))
       (proof (library-library-proof lib))
       (negated (library-minus exponent))
       (neg-int (library-library-type-of lib negated (list integral)))
       (assumed (proof-proof-assume proof test t))
       (comparison (library-library-comparison lib exponent *proof-zero* (list integral)))
       (positive-neg (proof-proof-rewrite proof assumed comparison '(1)))
       (zero (library-library-cite lib "ADD-ZERO-LEFT" (list negated) (list neg-int)))
       (positive-neg (proof-proof-rewrite proof positive-neg zero '(1 2)))
       (natural-neg (b1-quotient-natural-from-positive lib negated neg-int positive-neg))
       (positive (b1-monotone-positive-power-from-natural natural-neg lib base rational base-bound))
       (opposite (car positive))
       (lib (cdr positive))
       (addition (b1-powers-signed-power-addition lib base negated exponent neg-int integral numeric nonzero))
       (lib (cdr addition))
       (proof (library-library-proof lib))
       (cancel (library-library-linear-equal lib (library-plus negated exponent) *proof-zero* (list integral)))
       (add (proof-proof-rewrite proof (car addition) cancel '(1 1 2)))
       (add (proof-proof-symmetric proof add))
       (zero-power (b1-powers-expt-zero lib base))
       (product-is-one (proof-proof-chain proof add (list zero-power)))
       (power (b1-powers-expt base negated))
       (negated-number (b1-powers-expt-number lib base negated))
       (lib (cdr negated-number))
       (power-nonzero (b1-arithmetic-positive-nonzero lib opposite))
       (inverse (b1-arithmetic-inverse-product lib power (car negated-number) power-nonzero))
       (exponent-number (b1-powers-expt-number lib base exponent))
       (lib (cdr exponent-number))
       (reciprocal-value (b1-arithmetic-product-unique lib inverse product-is-one (car exponent-number)))
       (rational-power (b1-monotone-rational-expt lib base negated rational))
       (reciprocal-positive (b1-arithmetic-positive-reciprocal lib opposite rational-power))
       (lib (cdr reciprocal-positive))
       (no (library-library-transport-argument lib (car reciprocal-positive) reciprocal-value 2))
       (step (proof-proof-cases (library-library-proof lib) test no yes)))
    (cons step lib)))

(defun b1-monotone-increasing-power-consequence (premise lib)
  (proof-with-checked-results
      ((proof (library-library-proof lib))
       (conjuncts (b1-logic-bookproof-split-conjuncts lib premise))
       (parts (proof-list-of-length conjuncts 5))
       (base-bound (car parts))
       (exponents (cadr parts))
       (rational (caddr parts))
       (integral-i (cadddr parts))
       (integral-j (nth 4 parts))
       (literal (proof-step-first rational))
       (r (proof-term-at literal 1))
       (literal (proof-step-first integral-i))
       (i (proof-term-at literal 1))
       (literal (proof-step-first integral-j))
       (j (proof-term-at literal 1))
       (n (library-diff j i))
       (integers (list integral-i integral-j))
       (comparison (library-library-comparison lib i j integers))
       (order (proof-proof-rewrite proof exponents comparison '(1)))
       (int-n (library-library-type-of lib n integers))
       (natural (b1-quotient-natural-from-positive lib n int-n order))
       (bound (b1-monotone-bound-for-power lib r n natural rational base-bound))
       (lib (cdr bound))
       (proof (library-library-proof lib))
       (n-nonzero (b1-arithmetic-positive-nonzero lib order))
       (power-bound (proof-proof-prove-if proof (car bound) n-nonzero))
       (initial (b1-monotone-positive-power lib r integral-i rational base-bound))
       (lib (cdr initial))
       (epi (b1-monotone-rational-expt lib r i rational))
       (epn (b1-monotone-rational-expt lib r n rational))
       (scaled (b1-arithmetic-multiply-strict lib (car initial) power-bound (list epi epn)))
       (lib (cdr scaled))
       (proof (library-library-proof lib))
       (unit (b1-arithmetic-multiply-one lib (b1-powers-expt r i) (list epi) nil))
       (strict (proof-proof-rewrite proof (car scaled) unit '(1 1)))
       (numeric (b1-arithmetic-known-type lib *library-numberp* r (list rational)))
       (nonzero (b1-arithmetic-comparison-excludes lib base-bound *proof-zero* 2))
       (addition (b1-powers-signed-power-addition lib r i n integral-i int-n numeric nonzero))
       (lib (cdr addition))
       (proof (library-library-proof lib))
       (index (library-library-linear-equal lib (library-plus i n) j integers))
       (add (proof-proof-rewrite proof (car addition) index '(1 1 2)))
       (add (proof-proof-symmetric proof add))
       (step (proof-proof-rewrite proof strict add '(1 2))))
    (cons step lib)))

(defun b1-monotone-increasing-power (lib formula)
  (proof-with-checked-results
      ((premise (b1-logic-bookproof-prove-implication-premise lib formula))
       (result (b1-monotone-increasing-power-consequence premise lib))
       (lib (cdr result))
       (step (b1-logic-bookproof-prove-implication-with-premise lib formula premise (car result))))
    (cons step lib)))
