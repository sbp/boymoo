(in-package "BOYMOO-PROVER")
(set-verify-guards-eagerness 0)

(defun b1-reduced-move-middle-factor (lib a b c)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((association (library-library-axiom lib "ASSOCIATIVITY-OF-*" (list a b c)))
         (equation (proof-proof-symmetric proof association))
         (commute (library-library-axiom lib "COMMUTATIVITY-OF-*" (list a b)))
         (equation (proof-proof-rewrite proof equation commute '(1 2 1)))
         (association (library-library-axiom lib "ASSOCIATIVITY-OF-*" (list b a c))))
      (proof-proof-chain proof equation (list association)))))

(defun b1-reduced-denominator-minimum-consequence
    (premise lib x k denominator x-times-k too-small formula)
  (proof-with-checked-results
      ((parts (b1-logic-bookproof-split-conjuncts lib premise))
       (parts (proof-list-of-length parts 4)))
    (let ((rational (car parts))
          (int-k (cadr parts))
          (pos-k (caddr parts))
          (int-product (cadddr parts)))
      (proof-with-checked-results
          ((representation (b1-arithmetic-numerator-product lib rational))
           (ring (b1-modular-modulus-init lib int-k pos-k)))
        (let* ((types (cadr representation))
               (representation (car representation))
               (int-d (car types))
               (int-n (cadr types))
               (pos-d (caddr types))
               (residue (b1-modular-modulus-mod ring denominator))
               (quotient (b1-modular-modulus-floor ring denominator)))
          (proof-with-checked-results
              ((bounds (b1-modular-modulus-bounds ring int-d))
               (lib (cdr bounds))
               (ring (b1-modular-modulus-with-lib ring lib))
               (rational-quotient (b1-modular-modulus-rational ring denominator int-d))
               (interval (b1-floor-interval lib quotient rational-quotient))
               (lib (cdr interval))
               (proof (library-library-proof lib))
               (residue-value (proof-proof-unfold proof residue))
               (multiple (b1-arithmetic-product quotient k))
               (regroup (b1-reduced-move-middle-factor lib x quotient k))
               (bound (proof-proof-assume proof too-small t)))
            (let* ((int-r (caar bounds))
                   (lower-r (cadar bounds))
                   (upper-r (caddar bounds))
                   (int-q (caar interval))
                   (is-zero (proof-eq residue *proof-zero*))
                   (ints (list int-d int-q int-k)))
              (proof-with-checked-results
                  ((zero (proof-proof-assume proof is-zero t))
                   (zero (proof-proof-symmetric proof zero))
                   (zero (proof-proof-chain proof zero (list residue-value)))
                   (d-factor (library-library-linear-equal
                              lib denominator
                              (library-plus (caddr (proof-step-first residue-value)) multiple)
                              ints))
                   (zero-reverse (proof-proof-symmetric proof zero))
                   (d-factor (proof-proof-rewrite proof d-factor zero-reverse '(1 2 1)))
                   (int-multiple (library-library-type-of lib multiple ints))
                   (add-zero (library-library-cite lib "ADD-ZERO-LEFT" (list multiple)
                                                   (list int-multiple)))
                   (d-factor (proof-proof-chain proof d-factor (list add-zero)))
                   (n-factor (proof-proof-symmetric proof representation))
                   (n-factor (proof-proof-rewrite proof n-factor d-factor '(1 2 2)))
                   (n-factor (proof-proof-chain proof n-factor (list regroup)))
                   (product-positive (proof-proof-rewrite proof pos-d d-factor '(1 2)))
                   (quotient-type (b1-arithmetic-known-type lib *library-rationalp* quotient
                                                            (list int-q)))
                   (scale (b1-scaling-positive-scale-test lib quotient-type pos-k))
                   (lib (cdr scale))
                   (proof (library-library-proof lib))
                   (reverse-scale (proof-proof-symmetric proof (car scale)))
                   (pos-q (proof-proof-transport proof product-positive reverse-scale))
                   (lowest (proof-proof-fact
                            proof (proof-sym "LOWEST-TERMS" "ACL2")
                            (list (list *library-x* x)
                                  (list (proof-sym "N" "ACL2") quotient)
                                  (list (proof-sym "R" "ACL2") x-times-k)
                                  (list (proof-sym "Q" "ACL2") k))))
                   (requirements (b1-logic-bookproof-normalize-proof
                                  lib (cadr (proof-step-first lowest))
                                  (list int-q rational int-product int-k pos-q n-factor d-factor)
                                  nil nil nil))
                   (unit (proof-proof-modus-ponens proof lowest requirements))
                   (same (proof-proof-rewrite proof d-factor unit '(1 2 1)))
                   (multiply-one (b1-arithmetic-multiply-one lib k (list int-k) t))
                   (same (proof-proof-chain proof same (list multiply-one)))
                   (impossible (proof-proof-rewrite proof bound same '(1 2)))
                   (weak (library-library-cite lib "WEAK-REFLEXIVE" (list k) (list int-k)))
                   (equal-case (proof-proof-cut proof impossible weak))
                   (equal-case (proof-proof-front proof equal-case (proof-neg too-small)))
                   (distribution (library-library-axiom
                                  lib "DISTRIBUTIVITY" (list x denominator (library-minus multiple))))
                   (distribution (proof-proof-rewrite proof distribution representation '(1 2 1)))
                   (negative (b1-arithmetic-multiply-negation lib x multiple))
                   (lib (cdr negative))
                   (proof (library-library-proof lib))
                   (distribution (proof-proof-rewrite proof distribution (car negative) '(1 2 2)))
                   (distribution (proof-proof-rewrite proof distribution regroup '(1 2 2 1)))
                   (expanded (proof-proof-reflexive proof (b1-arithmetic-product x residue)))
                   (expanded (proof-proof-rewrite proof expanded residue-value '(1 2 2)))
                   (product-value (proof-proof-chain proof expanded (list distribution)))
                   (integral (library-library-type-of lib (caddr (proof-step-first product-value))
                                                      (list int-n int-q int-product)))
                   (int-xr (library-library-transport-argument lib integral product-value 1))
                   (nonzero (proof-proof-assume proof is-zero nil))
                   (numeric-r (b1-arithmetic-known-type lib *library-numberp* residue (list int-r)))
                   (pos-r (b1-arithmetic-positive-from-bounds lib lower-r nonzero numeric-r))
                   (lib (cdr pos-r))
                   (proof (library-library-proof lib))
                   (descent (library-library-cite lib "NFIX-DECREASE" (list residue k)
                                                  (list int-r int-k pos-k upper-r)))
                   (child (proof-subst formula (list (cons k residue))))
                   (hypothesis (proof-proof-assume
                                proof (proof-ite (proof-step-first descent) child *proof-true*) t))
                   (hypothesis (proof-proof-prove-if proof hypothesis descent))
                   (child-guard (b1-logic-bookproof-normalize-proof
                                 lib (cadr child) (list rational int-r (car pos-r) int-xr)
                                 nil nil nil))
                   (smaller-bound (proof-proof-modus-ponens proof hypothesis child-guard))
                   (impossible (library-library-cite lib "LESS-TRANSITIVE" (list residue k denominator)
                                                     (list int-r int-k int-d upper-r bound)))
                   (smaller-case (proof-proof-cut proof impossible smaller-bound))
                   (smaller-case (proof-proof-front proof smaller-case (proof-neg too-small)))
                   (step (proof-proof-cases proof is-zero equal-case smaller-case)))
                (cons step lib)))))))))

(defun b1-reduced-denominator-minimum (lib)
  (let ((name (proof-sym "SELF-DENOMINATOR-MINIMUM" "ACL2")))
    (if (assoc-equal name (proof-proof-facts (library-library-proof lib)))
        (cons name lib)
      (let* ((x *library-x*)
             (k *library-y*)
             (denominator (list *b1-arithmetic-denominator* x))
             (x-times-k (b1-arithmetic-product x k))
             (guard (proof-ite
                     (list *library-rationalp* x)
                     (proof-ite (library-integer k)
                                (proof-ite (library-positive k) (library-integer x-times-k) *proof-false*)
                                *proof-false*)
                     *proof-false*))
             (too-small (library-lt k denominator))
             (formula (list *library-implies* guard (proof-neg too-small)))
             (measure (list *library-nfix* k)))
        (proof-with-checked-results
            ((premise (b1-logic-bookproof-prove-implication-premise lib formula))
             (result (b1-reduced-denominator-minimum-consequence
                      premise lib x k denominator x-times-k too-small formula))
             (lib (cdr result))
             (step (b1-logic-bookproof-prove-implication-with-premise lib formula premise (car result)))
             (residue (list *b1-modular-mod* denominator k))
             (ordinal (library-library-cite lib "NFIX-ORDINAL" (list k) nil))
             (step (proof-proof-induct (library-library-proof lib) ordinal step formula measure
                                      (list (list (list k residue)))))
             (lib (library-library-lemma lib "DENOMINATOR-MINIMUM" formula step nil)))
          (cons name lib))))))

(defun b1-reduced-minimum-denominator-bound
    (lib rational multiplier positive-multiplier integral-product)
  (proof-with-checked-results
      ((rational-literal (proof-step-first rational))
       (argument (proof-term-at rational-literal 1))
       (multiplier-literal (proof-step-first multiplier))
       (factor (proof-term-at multiplier-literal 1))
       (minimum-name (b1-reduced-denominator-minimum lib))
       (lib (cdr minimum-name))
       (proof (library-library-proof lib))
       (minimum (proof-proof-fact proof (car minimum-name)
                                 (list (list *library-x* argument) (list *library-y* factor))))
       (guard (b1-logic-bookproof-normalize-proof
               lib (cadr (proof-step-first minimum))
               (list rational multiplier positive-multiplier integral-product) nil nil nil))
       (step (proof-proof-modus-ponens proof minimum guard)))
    (cons step lib)))

(defun b1-reduced-denominators-of-opposites-integral-negative-product
    (a b equation integral lib)
  (proof-with-checked-results
      ((literal (proof-step-first integral))
       (term (proof-term-at literal 1))
       (negative (library-library-type-of lib (library-minus term) (list integral)))
       (proof (library-library-proof lib))
       (symmetric (proof-proof-symmetric proof equation))
       (negative (proof-proof-rewrite proof negative symmetric '(1 1 1)))
       (factor (b1-arithmetic-negative-left-factor lib a b))
       (lib (cdr factor))
       (proof (library-library-proof lib))
       (symmetric (proof-proof-symmetric proof (car factor)))
       (step (proof-proof-rewrite proof negative symmetric '(1 1))))
    (cons step lib)))

(defun b1-reduced-denominators-of-opposites (lib rational)
  (proof-with-checked-results
      ((literal (proof-step-first rational))
       (x (proof-term-at literal 1))
       (opposite (library-minus x))
       (rational-minus (b1-arithmetic-known-type lib *library-rationalp* opposite (list rational)))
       (product-x (b1-arithmetic-numerator-product lib rational))
       (product-minus (b1-arithmetic-numerator-product lib rational-minus)))
    (let* ((types-x (cadr product-x))
           (types-minus (cadr product-minus))
           (product-x (car product-x))
           (product-minus (car product-minus))
           (int-d (car types-x))
           (int-n (cadr types-x))
           (pos-d (caddr types-x))
           (int-dm (car types-minus))
           (int-nm (cadr types-minus))
           (pos-dm (caddr types-minus))
           (d (cadr (proof-step-first int-d)))
           (dm (cadr (proof-step-first int-dm))))
      (proof-with-checked-results
          ((minus-times-d (b1-reduced-denominators-of-opposites-integral-negative-product
                           x d product-x int-n lib))
           (lib (cdr minus-times-d))
           (d-ge-dm (b1-reduced-minimum-denominator-bound
                     lib rational-minus int-d pos-d (car minus-times-d)))
           (lib (cdr d-ge-dm))
           (x-times-dm (b1-reduced-denominators-of-opposites-integral-negative-product
                        opposite dm product-minus int-nm lib))
           (lib (cdr x-times-dm))
           (numeric-x (b1-arithmetic-known-type lib *library-numberp* x (list rational)))
           (sums (b1-arithmetic-number-sums-init lib))
           (lib (b1-arithmetic-number-sums-library sums))
           (double (b1-arithmetic-number-sums-cite sums "DOUBLE-NEGATION" (list x) (list numeric-x)))
           (x-times-dm (proof-proof-rewrite (library-library-proof lib) (car x-times-dm)
                                             double '(1 1 1)))
           (dm-ge-d (b1-reduced-minimum-denominator-bound lib rational int-dm pos-dm x-times-dm))
           (lib (cdr dm-ge-d))
           (proof (library-library-proof lib))
           (order (b1-arithmetic-integer-compare lib dm d (list int-dm int-d)))
           (first (proof-proof-front proof order (library-lt dm d)))
           (first (proof-proof-cut proof first (car dm-ge-d)))
           (first (proof-proof-front proof first (library-lt d dm)))
           (result (proof-proof-cut proof first (car d-ge-dm)))
           (result (proof-proof-front proof result (proof-eq dm d))))
        (cons (list result product-x product-minus) lib)))))

(defun b1-reduced-denominator-minus (lib formula)
  (proof-with-checked-results
      ((premise (b1-logic-bookproof-prove-implication-premise lib formula))
       (result (b1-reduced-denominators-of-opposites lib premise))
       (lib (cdr result))
       (step (b1-logic-bookproof-prove-implication-with-premise lib formula premise (caar result))))
    (cons step lib)))

(defun b1-reduced-numerator-minus (lib formula)
  (proof-with-checked-results
      ((left (proof-term-at formula 1))
       (opposite (proof-term-at left 1))
       (x (proof-term-at opposite 1))
       (rational-test (list *library-rationalp* x))
       (numeric-test (list *library-numberp* x))
       (rational (proof-proof-assume (library-library-proof lib) rational-test t))
       (products (b1-reduced-denominators-of-opposites lib rational))
       (lib (cdr products))
       (proof (library-library-proof lib))
       (denominators (caar products))
       (product-x (cadar products))
       (product-minus (caddar products))
       (product-minus (proof-proof-rewrite proof product-minus denominators '(1 1 2)))
       (negative (b1-arithmetic-negative-left-factor lib x (caddr (proof-step-first denominators))))
       (lib (cdr negative))
       (proof (library-library-proof lib))
       (sign (proof-proof-symmetric proof product-minus))
       (sign (proof-proof-chain proof sign (list (car negative))))
       (sign (proof-proof-rewrite proof sign product-x '(1 2 1)))
       (nonrational (proof-proof-assume proof rational-test nil))
       (num-zero (library-library-axiom lib "DEFAULT-NUMERATOR" (list x)))
       (num-zero (proof-proof-modus-ponens proof num-zero nonrational))
       (positive-type (proof-proof-assume proof numeric-test t))
       (minus-type (list *library-rationalp* (library-minus x)))
       (minus-rational (proof-proof-assume proof minus-type t))
       (double-type (b1-arithmetic-known-type lib *library-rationalp* (library-minus (library-minus x))
                                              (list minus-rational)))
       (sums (b1-arithmetic-number-sums-init lib))
       (lib (b1-arithmetic-number-sums-library sums))
       (proof (library-library-proof lib))
       (double (b1-arithmetic-number-sums-cite sums "DOUBLE-NEGATION" (list x) (list positive-type)))
       (original-type (proof-proof-rewrite proof double-type double '(1 1)))
       (neither (proof-proof-cut proof original-type nonrational))
       (neither (proof-proof-front proof neither (proof-neg minus-type)))
       (minus-zero (library-library-axiom lib "DEFAULT-NUMERATOR" (list (library-minus x))))
       (minus-zero (proof-proof-modus-ponens proof minus-zero neither))
       (complex-case (b1-logic-bookproof-normalize-proof
                      lib formula nil nil
                      (list (b1-logic-equal-to num-zero) (b1-logic-equal-to minus-zero)) nil))
       (zero-argument (library-library-axiom lib "DEFAULT-UNARY-MINUS" (list x)))
       (not-numeric (proof-proof-assume proof numeric-test nil))
       (zero-argument (proof-proof-modus-ponens proof zero-argument not-numeric))
       (nonnumeric-case (b1-logic-bookproof-normalize-proof
                         lib formula nil nil
                         (list (b1-logic-equal-to num-zero) (b1-logic-equal-to zero-argument)) nil))
       (no (proof-proof-cases proof numeric-test complex-case nonnumeric-case))
       (step (proof-proof-cases proof rational-test sign no)))
    (cons step lib)))
