(defun b1-floor-sum-zero-divisor-product (lib term z zero-product values)
  (proof-with-checked-results
      ((part (proof-term-at term 1))
       (floor (list *b1-quotient-floor* part z))
       (product (case (car zero-product)
                  (:zero (b1-floor-sum-mod-sum-consequence-product-at-zero
                          floor lib z (cadr zero-product)))
                  (:nonnumeric (b1-floor-sum-mod-sum-consequence-nonnumeric-product
                                floor lib z (cadr zero-product)))
                  (otherwise (table-get zero-product floor nil))))
       (value (b1-floor-sum-remainder-with-zero-product lib term product)))
    (cons value values)))

