(defun b1-floor-sum-floor-sum-second (work) (nth 2 work))
(defun b1-floor-sum-floor-sum-divisor (work) (nth 3 work))
(defun b1-floor-sum-floor-sum-numerator (work) (nth 4 work))
(defun b1-floor-sum-floor-sum-inverse (work) (nth 5 work))
