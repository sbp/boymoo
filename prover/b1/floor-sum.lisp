(defun b1-floor-sum-floor-sum-low-and-high (work)
  (let* ((lib (b1-floor-sum-floor-sum-lib work))
         (rationals (b1-floor-sum-floor-sum-rationals work))
         (ratio-sum (b1-floor-sum-floor-sum-ratio-sum work))
         (floor-sum (b1-floor-sum-floor-sum-floor-sum work)))
    (proof-with-checked-results
        ((ratios (proof-list-of-length (b1-floor-sum-floor-sum-ratios work) 2))
         (floors (proof-list-of-length (b1-floor-sum-floor-sum-floors work) 2))
         (rat-a (proof-term-at rationals 0))
         (interval-a (b1-floor-interval lib (car floors) rat-a))
         (lib (cdr interval-a))
         (rat-b (proof-term-at rationals 1))
         (interval-b (b1-floor-interval lib (cadr floors) rat-b))
         (lib (cdr interval-b)))
      (let* ((proof (library-library-proof lib))
             (sums (b1-arithmetic-number-sums-with-library (b1-floor-sum-floor-sum-sums work) lib))
             (b (cadr ratios))
             (f (car floors))
             (g (cadr floors))
             (low-a (cadar interval-a))
             (high-a (caddar interval-a))
             (low-b (cadar interval-b))
             (high-b (caddar interval-b))
             (evidence (append rationals (list (caar interval-a) (caar interval-b))))
             (middle (library-plus f b)))
        (proof-with-checked-results
            ((shifted-low (b1-floor-sum-translate-comparison lib sums low-a
                                                            (library-lt ratio-sum middle) evidence))
             (bad-test (library-lt ratio-sum floor-sum))
             (bad (proof-proof-assume proof bad-test t))
             (bad (b1-floor-weak-then-strict lib sums shifted-low bad evidence))
             (bad (b1-floor-sum-translate-comparison lib sums bad (library-lt b g) evidence))
             (lower (proof-proof-cut proof bad low-b))
             (lower (proof-proof-front proof lower (proof-neg bad-test)))
             (a-max (caddr (proof-step-first high-a)))
             (b-max (caddr (proof-step-first high-b)))
             (middle (library-plus a-max b))
             (upper-a (b1-floor-sum-translate-comparison lib sums high-a
                                                         (library-lt ratio-sum middle) evidence))
             (upper-b (b1-floor-sum-translate-comparison
                       lib sums high-b (library-lt middle (library-plus a-max b-max)) evidence))
             (upper (b1-arithmetic-number-sums-strict-chain sums upper-a upper-b evidence))
             (upper (b1-floor-sum-translate-comparison
                     lib sums upper
                     (library-lt ratio-sum (library-plus *proof-one* (b1-floor-sum-floor-sum-successor work)))
                     evidence)))
          (cons (list lower upper evidence) lib))))))

(defun b1-floor-sum-floor-sum-quotient-cases (work)
  (proof-with-checked-results
      ((bounds (b1-floor-sum-floor-sum-low-and-high work))
       (lib (cdr bounds))
       (lower (caar bounds))
       (upper (cadar bounds))
       (evidence (caddar bounds))
       (sum-ratio (b1-scaling-distribute-left-sum
                   lib (b1-floor-sum-floor-sum-first work) (b1-floor-sum-floor-sum-second work)
                   (b1-floor-sum-floor-sum-inverse work)))
       (rational-sum (b1-arithmetic-known-type lib *library-rationalp*
                                               (b1-floor-sum-floor-sum-ratio-sum work) evidence))
       (rational (library-library-transport-argument lib rational-sum sum-ratio 1))
       (interval (b1-floor-interval lib (list *b1-quotient-floor* (b1-floor-sum-floor-sum-numerator work)
                                            (b1-floor-sum-floor-sum-divisor work)) rational))
       (lib (cdr interval))
       (proof (library-library-proof lib))
       (low (proof-proof-rewrite proof (cadar interval) sum-ratio '(1 1 1)))
       (high (proof-proof-rewrite proof (caddar interval) sum-ratio '(1 1)))
       (actual (list (caar interval) low high))
       (int-sum (library-library-type-of lib (b1-floor-sum-floor-sum-floor-sum work) evidence))
       (int-successor (library-library-type-of lib (b1-floor-sum-floor-sum-successor work) evidence))
       (carry (proof-proof-assume proof (b1-floor-sum-floor-sum-carry-test work) t))
       (below (list int-sum lower carry))
       (no-carry (proof-proof-assume proof (b1-floor-sum-floor-sum-carry-test work) nil))
       (above (list int-successor no-carry upper))
       (below (b1-floor-equal-intervals lib actual below rational-sum))
       (lib (cdr below))
       (above (b1-floor-equal-intervals lib actual above rational-sum)))
    (cons (list (car below) (car above)) (cdr above))))

(defun b1-floor-sum-floor-sum-unscaled-remainders-align-part
    (part quotient mod index result inverse z invert)
  (let* ((lib (cdr result))
         (alignment (car result))
         (proof (library-library-proof lib)))
    (proof-with-checked-results
        ((scaled (library-library-axiom lib "ASSOCIATIVITY-OF-*" (list part inverse z)))
         (scaled (proof-proof-rewrite proof scaled invert '(1 2 2)))
         (commute (library-library-axiom lib "COMMUTATIVITY-OF-*" (list part *proof-one*)))
         (unit (library-library-axiom lib "UNICITY-OF-1" (list part)))
         (scaled (proof-proof-chain proof scaled (list commute unit)))
         (opened (proof-proof-unfold proof mod))
         (addends (cdr (caddr (proof-step-first opened))))
         (fixed (b1-floor-sum-fixed-first-addend lib (car addends) (cadr addends)))
         (opened (proof-proof-chain proof opened (list fixed)))
         (scaled (proof-proof-symmetric proof scaled))
         (opened (proof-proof-rewrite proof opened scaled '(1 2 1)))
         (ratio (b1-arithmetic-product part inverse))
         (residue (b1-scaling-distribute-left-sum lib ratio (library-minus quotient) z))
         (negative (b1-arithmetic-negative-left-factor lib quotient z))
         (lib (cdr negative))
         (proof (library-library-proof lib))
         (residue (proof-proof-rewrite proof residue (car negative) '(1 2 2)))
         (residue (proof-proof-symmetric proof residue))
         (opened (proof-proof-chain proof opened (list residue)))
         (alignment (proof-proof-rewrite proof alignment opened (list 1 2 index))))
      (cons alignment lib))))

(defun b1-floor-sum-floor-sum-unscaled-remainders-align
    (parts floors remainders index result inverse z invert)
  (declare (xargs :measure (len parts)))
  (if (or (endp parts) (endp floors) (endp remainders) (failure-p result))
      result
    (b1-floor-sum-floor-sum-unscaled-remainders-align
     (cdr parts) (cdr floors) (cdr remainders) (1+ index)
     (b1-floor-sum-floor-sum-unscaled-remainders-align-part
      (car parts) (car floors) (car remainders) index result inverse z invert)
     inverse z invert)))

(defun b1-floor-sum-floor-sum-unscaled-remainders-add-integer (floor rational result)
  (proof-with-checked-results ((interval (b1-floor-interval (cdr result) floor rational)))
    (cons (cons (caar interval) (car result)) (cdr interval))))

(defun b1-floor-sum-floor-sum-unscaled-remainders-integers (floors rationals result)
  (declare (xargs :measure (len floors)))
  (cond ((failure-p result) result)
        ((or (endp floors) (endp rationals)) (cons (reverse (car result)) (cdr result)))
        (t (b1-floor-sum-floor-sum-unscaled-remainders-integers
            (cdr floors) (cdr rationals)
            (b1-floor-sum-floor-sum-unscaled-remainders-add-integer (car floors) (car rationals) result)))))

(defun b1-floor-sum-floor-sum-unscaled-remainders (work numeric nonzero)
  (let* ((lib (b1-floor-sum-floor-sum-lib work))
         (proof (library-library-proof lib))
         (z (b1-floor-sum-floor-sum-divisor work))
         (inverse (b1-floor-sum-floor-sum-inverse work))
         (floors (b1-floor-sum-floor-sum-floors work))
         (rationals (b1-floor-sum-floor-sum-rationals work)))
    (proof-with-checked-results
        ((invert (b1-arithmetic-inverse-product lib z numeric nonzero))
         (commute (library-library-axiom lib "COMMUTATIVITY-OF-*" (list inverse z)))
         (invert (proof-proof-chain proof commute (list invert)))
         (alignment (proof-proof-reflexive proof (b1-floor-sum-floor-sum-remainder-sum work)))
         (aligned (b1-floor-sum-floor-sum-unscaled-remainders-align
                   (list (b1-floor-sum-floor-sum-first work) (b1-floor-sum-floor-sum-second work))
                   floors (b1-floor-sum-floor-sum-remainders work) 1 (cons alignment lib) inverse z invert))
         (lib (cdr aligned))
         (proof (library-library-proof lib))
         (parts (proof-list-of-length (cdr (caddr (proof-step-first (car aligned)))) 2))
         (left (proof-term-at (car parts) 1))
         (right (proof-term-at (cadr parts) 1))
         (combined (b1-scaling-distribute-left-sum lib left right z))
         (combined (proof-proof-symmetric proof combined))
         (alignment (proof-proof-chain proof (car aligned) (list combined)))
         (integers (b1-floor-sum-floor-sum-unscaled-remainders-integers floors rationals (cons nil lib)))
         (lib (cdr integers))
         (proof (library-library-proof lib))
         (evidence (append rationals (car integers)))
         (difference (library-diff (b1-floor-sum-floor-sum-ratio-sum work)
                                    (b1-floor-sum-floor-sum-floor-sum work)))
         (sums (b1-arithmetic-number-sums-with-library (b1-floor-sum-floor-sum-sums work) lib))
         (regrouped (b1-arithmetic-number-sums-linear-equal sums (library-plus left right)
                                                           difference evidence))
         (step (proof-proof-rewrite proof alignment regrouped '(1 2 1))))
      (cons (list step difference evidence) lib))))

(defun b1-floor-sum-floor-sum-residue-comparison-reverse (lib distribution difference z reverse)
  (if reverse
      (proof-with-checked-results
          ((negative (b1-arithmetic-multiply-negation lib difference z))
           (lib (cdr negative))
           (step (proof-proof-rewrite (library-library-proof lib) distribution (car negative) '(1 2 2 1))))
        (cons step lib))
    (cons distribution lib)))

(defun b1-floor-sum-floor-sum-residue-comparison
    (work unscaled difference evidence positive-factor reverse)
  (let* ((lib (b1-floor-sum-floor-sum-lib work))
         (proof (library-library-proof lib))
         (z (b1-floor-sum-floor-sum-divisor work))
         (sums (b1-floor-sum-floor-sum-sums work))
         (remainder-sum (b1-floor-sum-floor-sum-remainder-sum work)))
    (proof-with-checked-results
        ((factor-literal (proof-step-first positive-factor))
         (factor (proof-term-at factor-literal 2))
         (comparison (if reverse (library-lt z remainder-sum) (library-lt remainder-sum z)))
         (opened (proof-proof-reflexive proof comparison))
         (opened (proof-proof-rewrite proof opened unscaled (list 1 2 (if reverse 2 1))))
         (sides (cdr (caddr (proof-step-first opened))))
         (numeric-z (b1-arithmetic-known-type lib *library-numberp* z evidence))
         (order (b1-arithmetic-number-sums-comparison sums (car sides) (cadr sides) evidence))
         (signed-difference (library-diff *proof-one* difference))
         (distribution (b1-scaling-distribute-left-sum lib *proof-one* (library-minus difference) factor))
         (unit (b1-arithmetic-multiply-one lib factor (list numeric-z) t))
         (distribution (proof-proof-rewrite proof distribution unit '(1 2 1)))
         (negative (b1-arithmetic-negative-left-factor lib difference factor))
         (lib (cdr negative))
         (distribution (proof-proof-rewrite (library-library-proof lib) distribution (car negative) '(1 2 2)))
         (distribution (b1-floor-sum-floor-sum-residue-comparison-reverse
                        lib distribution difference z reverse))
         (lib (cdr distribution))
         (proof (library-library-proof lib))
         (sums (b1-arithmetic-number-sums-with-library sums lib))
         (distribution (car distribution))
         (align (b1-arithmetic-number-sums-linear-equal
                 sums (caddr (caddr (proof-step-first order))) (caddr (proof-step-first distribution))
                 evidence))
         (distribution (proof-proof-symmetric proof distribution))
         (align (proof-proof-chain proof align (list distribution)))
         (order (proof-proof-rewrite proof order align '(1 2 2)))
         (rational (b1-arithmetic-known-type lib *library-rationalp* signed-difference evidence))
         (scaled (b1-scaling-positive-scale-test lib rational positive-factor))
         (lib (cdr scaled))
         (proof (library-library-proof lib))
         (sums (b1-arithmetic-number-sums-with-library sums lib))
         (carry-test (b1-floor-sum-floor-sum-carry-test work))
         (carry (b1-arithmetic-number-sums-comparison sums (cadr carry-test) (caddr carry-test) evidence))
         (align (b1-arithmetic-number-sums-linear-equal
                 sums signed-difference (caddr (caddr (proof-step-first carry))) evidence))
         (scaled (proof-proof-rewrite proof (car scaled) align '(1 2 2)))
         (carry (proof-proof-symmetric proof carry))
         (step (proof-proof-chain proof opened (list order scaled carry))))
      (cons step lib))))

(defun b1-floor-sum-floor-sum-zero-quotient (work inverse-zero)
  (let* ((lib (b1-floor-sum-floor-sum-lib work))
         (proof (library-library-proof lib))
         (numerator (b1-floor-sum-floor-sum-numerator work))
         (divisor (b1-floor-sum-floor-sum-divisor work)))
    (proof-with-checked-results
        ((floor (b1-floor-floor-of-ratio lib (list *b1-quotient-floor* numerator divisor)))
         (ratio (proof-proof-reflexive proof (b1-arithmetic-product numerator
                                                                    (b1-floor-sum-floor-sum-inverse work))))
         (ratio (proof-proof-rewrite proof ratio inverse-zero '(1 2 2)))
         (zero (b1-arithmetic-multiply-zero lib numerator))
         (ratio (proof-proof-chain proof ratio (list zero)))
         (floor (proof-proof-rewrite proof floor ratio '(1 2 1)))
         (zero-floor (b1-logic-bookproof-normalize
                      lib (list *b1-quotient-floor* *proof-zero* *proof-one*) nil
                      (list *b1-quotient-floor* *b1-quotient-numeric-eq*) nil nil nil nil)))
      (proof-proof-chain proof floor (list zero-floor)))))

(defun b1-floor-sum-floor-sum-selection (lib choices evidence quotient)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((selected (b1-logic-bookproof-normalize lib choices evidence (list *proof-not*) nil nil nil nil))
         (selected (proof-proof-symmetric proof selected)))
      (proof-proof-chain proof quotient (list selected)))))

(defun b1-floor-sum-floor-sum-consequence-on-sign
    (sign factor reverse work choices unscaled difference evidence numeric nonzero below above)
  (proof-with-checked-results
      ((comparison (b1-floor-sum-floor-sum-residue-comparison
                    work unscaled difference (append evidence (list numeric)) factor reverse))
       (lib (cdr comparison))
       (proof (library-library-proof lib))
       (carry-test (b1-floor-sum-floor-sum-carry-test work))
       (pos (proof-proof-assume proof carry-test t))
       (pos (proof-proof-transport proof pos (car comparison)))
       (no (proof-proof-assume proof carry-test nil))
       (reverse-comparison (proof-proof-symmetric proof (car comparison)))
       (no (proof-proof-rewrite proof no reverse-comparison '(1 1)))
       (yes (b1-floor-sum-floor-sum-selection lib choices (list numeric nonzero sign pos) below))
       (no (b1-floor-sum-floor-sum-selection lib choices (list numeric nonzero sign no) above))
       (step (proof-proof-cases proof carry-test yes no)))
    (cons step lib)))

(defun b1-floor-sum-floor-sum-consequence-at-zero (hypotheses work choices)
  (let ((lib (b1-floor-sum-floor-sum-lib work)))
    (proof-with-checked-results
        ((proof (library-library-proof lib))
         (complete (library-library-axiom lib "COMPLETION-OF-UNARY-/"
                                         (list (b1-floor-sum-floor-sum-divisor work))))
         (zero (b1-logic-bookproof-normalize lib (caddr (proof-step-first complete)) hypotheses
                                            (list *proof-not*) nil nil nil nil))
         (inverse-zero (proof-proof-chain proof complete (list zero)))
         (value (b1-floor-sum-floor-sum-zero-quotient work inverse-zero))
         (selected (b1-logic-bookproof-normalize lib choices hypotheses (list *proof-not*) nil nil nil nil))
         (selected (proof-proof-symmetric proof selected)))
      (proof-proof-chain proof value (list selected)))))

(defun b1-floor-sum-floor-sum-consequence (premise lib x y z numeric-test zero-test positive-test choices)
  (proof-with-checked-results
      ((rationals (b1-logic-bookproof-split-conjuncts lib premise))
       (work (b1-floor-sum-floor-sum-init lib x y z rationals))
       (lib (b1-floor-sum-floor-sum-lib work))
       (proof (library-library-proof lib))
       (numeric (proof-proof-assume proof numeric-test t))
       (nonzero (proof-proof-assume proof zero-test nil))
       (unscaled (b1-floor-sum-floor-sum-unscaled-remainders work numeric nonzero))
       (work (b1-floor-sum-floor-sum-with-lib work (cdr unscaled)))
       (difference (cadar unscaled))
       (evidence (caddar unscaled))
       (unscaled (caar unscaled))
       (quotients (b1-floor-sum-floor-sum-quotient-cases work))
       (lib (cdr quotients))
       (work (b1-floor-sum-floor-sum-with-lib work lib))
       (below (caar quotients))
       (above (cadar quotients))
       (proof (library-library-proof lib))
       (pos-z (proof-proof-assume proof positive-test t))
       (no-pos-z (proof-proof-assume proof positive-test nil))
       (negative-z (b1-scaling-negative-from-signs lib numeric no-pos-z nonzero))
       (yes (b1-floor-sum-floor-sum-consequence-on-sign
             pos-z pos-z nil work choices unscaled difference evidence numeric nonzero below above))
       (work (b1-floor-sum-floor-sum-with-lib work (cdr yes)))
       (no (b1-floor-sum-floor-sum-consequence-on-sign
            no-pos-z negative-z t work choices unscaled difference evidence numeric nonzero below above))
       (lib (cdr no))
       (work (b1-floor-sum-floor-sum-with-lib work lib))
       (proof (library-library-proof lib))
       (nonzero-result (proof-proof-cases proof positive-test (car yes) (car no)))
       (is-zero (proof-proof-assume proof zero-test t))
       (zero-result (b1-floor-sum-floor-sum-consequence-at-zero (list numeric is-zero) work choices))
       (numeric-result (proof-proof-cases proof zero-test zero-result nonzero-result))
       (is-nonnumeric (proof-proof-assume proof numeric-test nil))
       (nonnumeric-result (b1-floor-sum-floor-sum-consequence-at-zero (list is-nonnumeric) work choices))
       (step (proof-proof-cases proof numeric-test numeric-result nonnumeric-result)))
    (cons step lib)))

(defun b1-floor-sum-addend-formula (formula)
  (proof-with-checked-results ((conclusion (proof-term-at formula 2)))
    (if (integerp conclusion)
        '(:failure "failure" "")
      (proof-with-checked-results
          ((parts (proof-list-of-length (cdr conclusion) 2))
           (left (proof-list-of-length (car parts) 3))
           (sum (proof-list-of-length (cadr left) 3)))
        (list left (cadr parts) (cadr sum) (caddr sum) (caddr left))))))

(defun b1-floor-sum-floor-sum (lib formula)
  (proof-with-checked-results ((parts (b1-floor-sum-addend-formula formula)))
    (let* ((choices (cadr parts))
           (x (caddr parts))
           (y (cadddr parts))
           (z (nth 4 parts))
           (numeric-test (list *library-numberp* z))
           (zero-test (proof-eq z *proof-zero*))
           (positive-test (library-positive z)))
      (proof-with-checked-results
          ((premise (b1-logic-bookproof-prove-implication-premise lib formula))
           (result (b1-floor-sum-floor-sum-consequence
                    premise lib x y z numeric-test zero-test positive-test choices))
           (lib (cdr result))
           (step (b1-logic-bookproof-prove-implication-with-premise lib formula premise (car result))))
        (cons step lib)))))

