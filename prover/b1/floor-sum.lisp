(in-package "BOYMOO-PROVER")
(set-verify-guards-eagerness 0)

(defconst *b1-floor-sum-floor-sum* (proof-sym "(floor (+ x y) z)" "ACL2"))

(defun b1-floor-sum-fixed-first-addend (lib a b)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((replacement (library-library-axiom lib "UNICITY-OF-0" (list a)))
         (replacement (proof-proof-symmetric proof replacement))
         (start (proof-proof-reflexive proof (library-plus (list *b1-powers-fix* a) b)))
         (start (proof-proof-rewrite proof start replacement '(1 2 1)))
         (associate (library-library-axiom lib "ASSOCIATIVITY-OF-+" (list *proof-zero* a b)))
         (zero (b1-arithmetic-add-zero lib (library-plus a b) nil))
         (start (proof-proof-chain proof start (list associate zero))))
      (proof-proof-symmetric proof start))))

(defun b1-floor-sum-fixed-addends (lib a b)
  (let ((proof (library-library-proof lib))
        (fix-a (list *b1-powers-fix* a))
        (fix-b (list *b1-powers-fix* b)))
    (proof-with-checked-results
        ((start (b1-floor-sum-fixed-first-addend lib a b))
         (commute (library-library-axiom lib "COMMUTATIVITY-OF-+" (list fix-a b)))
         (start (proof-proof-chain proof start (list commute)))
         (next (b1-floor-sum-fixed-first-addend lib b fix-a))
         (commute (library-library-axiom lib "COMMUTATIVITY-OF-+" (list fix-b fix-a))))
      (proof-proof-chain proof start (list next commute)))))

(defun b1-floor-sum-translate-comparison (lib sums step target evidence)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((literal (proof-step-first step))
         (head (proof-term-at literal 0)))
      (if (equal head *proof-not*)
          (proof-with-checked-results
              ((comparison (proof-term-at literal 1))
               (alignment (b1-arithmetic-number-sums-comparison-equation
                           sums comparison target evidence)))
            (proof-proof-rewrite proof step alignment '(1 1)))
        (proof-with-checked-results
            ((alignment (b1-arithmetic-number-sums-comparison-equation sums target literal evidence)))
          (proof-proof-transport proof step alignment))))))

(defun b1-floor-sum-floor-sum-init (lib first second divisor rationals)
  (proof-with-checked-results ((sums (b1-arithmetic-number-sums-init lib)))
    (let* ((numerator (library-plus first second))
           (inverse (b1-arithmetic-reciprocal divisor))
           (ratios (list (b1-arithmetic-product first inverse)
                         (b1-arithmetic-product second inverse)))
           (floors (list (list *b1-quotient-floor* first divisor)
                         (list *b1-quotient-floor* second divisor)))
           (remainders (list (list *b1-modular-mod* first divisor)
                             (list *b1-modular-mod* second divisor)))
           (ratio-sum (library-plus (car ratios) (cadr ratios)))
           (floor-sum (library-plus (car floors) (cadr floors)))
           (remainder-sum (library-plus (car remainders) (cadr remainders)))
           (successor (library-plus *proof-one* floor-sum))
           (carry-test (library-lt ratio-sum successor)))
      (list :b1-floor-sum first second divisor numerator inverse ratios floors remainders
            ratio-sum floor-sum remainder-sum successor carry-test rationals sums))))

