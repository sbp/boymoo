        (t (b1-floor-sum-zero-divisor-products
            lib (cdr terms) z zero-product
            (b1-floor-sum-zero-divisor-product lib (car terms) z zero-product values)))))

(defun b1-floor-sum-zero-divisor-remainders-leaf
    (term tests lib work sum-value target-sum first second zero-minus)
  (declare (ignore tests))
  (let ((proof (library-library-proof lib)))
    (if (equal term (b1-floor-sum-floor-sum-remainder-sum work))
        (proof-with-checked-results ((target (proof-proof-symmetric proof target-sum)))
          (proof-proof-chain proof sum-value (list target)))
      (proof-with-checked-results
          ((right (proof-proof-reflexive proof term))
           (right (proof-proof-rewrite proof right first '(1 2 1)))
           (right (proof-proof-rewrite proof right second '(1 2 2 1)))
           (right (proof-proof-rewrite proof right zero-minus '(1 2 2 2)))
           (y (b1-floor-sum-floor-sum-second work))
           (fixed-y (list *b1-powers-fix* y))
           (fix-is-numeric (b1-arithmetic-known-type lib *library-numberp* (library-plus *proof-zero* y) nil))
           (zero (library-library-axiom lib "UNICITY-OF-0" (list y)))
           (fix-is-numeric (proof-proof-rewrite proof fix-is-numeric zero '(1 1)))
           (neutral (library-library-axiom lib "COMMUTATIVITY-OF-+" (list fixed-y *proof-zero*)))
           (zero (b1-arithmetic-add-zero lib fixed-y (list fix-is-numeric)))
           (neutral (proof-proof-chain proof neutral (list zero)))
           (right (proof-proof-rewrite proof right neutral '(1 2 2)))
           (right (proof-proof-symmetric proof right)))
        (proof-proof-chain proof sum-value (list right))))))

(defun b1-floor-sum-zero-divisor-remainders-by-value
    (n lib value template tests work sum-value target-sum first second zero-minus)
  (declare (xargs :measure (nfix n)))
  (let ((proof (library-library-proof lib)))
    (cond
     ((failure-p value) value)
     ((zp n) '(:failure "Fuel" "b1-floor-sum-zero-divisor-remainders-by-value"))
     ((proof-is-call value *proof-if*)
      (proof-with-checked-results
          ((branches (proof-list-of-length (cdr value) 3))
           (test (car branches))
           (yes (b1-floor-sum-zero-divisor-remainders-by-value
                 (1- n) lib (cadr branches) template (append tests (list (list test t)))
                 work sum-value target-sum first second zero-minus))
           (no (b1-floor-sum-zero-divisor-remainders-by-value
                (1- n) lib (caddr branches) template (append tests (list (list test nil)))
                work sum-value target-sum first second zero-minus))
           (if-true (proof-proof-if-true proof value))
           (if-true (proof-proof-symmetric proof if-true))
           (yes (proof-proof-rewrite-result proof yes if-true template *proof-result*))
           (if-false (proof-proof-if-false proof value))
           (if-false (proof-proof-symmetric proof if-false))
           (no (proof-proof-rewrite-result proof no if-false template *proof-result*)))
        (proof-proof-cases proof test yes no)))
     ((and (proof-compound value) (endp value))
      '(:failure "failure" ""))
     ((and (proof-compound value) (proof-compound (car value)))
      (let* ((equality (proof-proof-beta proof value))
             (opened (if (failure-p equality) equality (caddr (proof-step-first equality)))))
        (proof-with-checked-results
            ((step (b1-floor-sum-zero-divisor-remainders-by-value
                    (1- n) lib opened template tests work sum-value target-sum first second zero-minus))
             (equality (proof-proof-symmetric proof equality)))
          (proof-proof-rewrite-result proof step equality template *proof-result*))))
     (t (proof-with-checked-results
            ((step (b1-floor-sum-zero-divisor-remainders-leaf
                    value tests lib work sum-value target-sum first second zero-minus))
             (literal (proof-step-first step))
             (target (proof-subst template (list (cons *proof-result* value)))))
          (if (equal literal target)
              step
            '(:failure "failure" "")))))))

(defun b1-floor-sum-zero-divisor-remainders (lib work lhs choices zero-product zero-minus)
  (let* ((terms (cons lhs (b1-floor-sum-floor-sum-remainders work)))
         (proof (library-library-proof lib))
         (numerator (b1-floor-sum-floor-sum-numerator work)))
    (proof-with-checked-results
        ((values (b1-floor-sum-zero-divisor-products lib terms (b1-floor-sum-floor-sum-divisor work)
                                                   zero-product nil))
         (values (proof-list-of-length values 3))
         (sum-value (car values))
         (first (cadr values))
         (second (caddr values))
         (fix-total (library-library-axiom lib "UNICITY-OF-0" (list numerator)))
         (fix-total (proof-proof-symmetric proof fix-total))
         (add-zero (b1-arithmetic-add-zero lib numerator nil))
         (fix-total (proof-proof-chain proof fix-total (list add-zero)))
         (fixed (b1-floor-sum-fixed-addends lib (b1-floor-sum-floor-sum-first work)
                                               (b1-floor-sum-floor-sum-second work)))
         (sum-value (proof-proof-chain proof sum-value (list fix-total fixed)))
         (target-sum (proof-proof-reflexive proof (b1-floor-sum-floor-sum-remainder-sum work)))
         (target-sum (proof-proof-rewrite proof target-sum first '(1 2 1)))
         (target-sum (proof-proof-rewrite proof target-sum second '(1 2 2))))
      (b1-floor-sum-zero-divisor-remainders-by-value
       1000000 lib choices (proof-eq lhs *proof-result*) nil work sum-value target-sum first second zero-minus))))

(defun b1-floor-sum-mod-sum-carry (lib work lhs choices numeric nonzero sign positive threshold quotient carry)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((condition (proof-proof-assume proof threshold (not carry)))
         (floor (b1-logic-bookproof-normalize lib (caddr (proof-step-first quotient))
                                              (list numeric nonzero positive condition)
                                              (list *proof-not*) nil nil nil nil))
         (floor (proof-proof-chain proof quotient (list floor)))
         (rhs (b1-logic-bookproof-normalize lib choices (list sign condition) (list *proof-not*) nil nil nil nil))
         (value (b1-floor-sum-residue-from-quotient lib work lhs (caddr (proof-step-first rhs)) floor numeric carry))
         (rhs (proof-proof-symmetric proof rhs)))
      (proof-proof-chain proof value (list rhs)))))

(defun b1-floor-sum-mod-sum-consequence-branch
    (negative work negative-test numeric nonzero lhs choices quotient)
  (let* ((lib (b1-floor-sum-floor-sum-lib work))
         (z (b1-floor-sum-floor-sum-divisor work))
         (remainder-sum (b1-floor-sum-floor-sum-remainder-sum work)))
    (proof-with-checked-results
        ((sign (proof-proof-assume (library-library-proof lib) negative-test negative))
         (positive (if negative
                       (proof-with-checked-results
                           ((step (b1-arithmetic-number-sums-weaken
                                   (b1-floor-sum-floor-sum-sums work) sign (list numeric))))
                         (cons step lib))
                     (b1-arithmetic-positive-from-bounds lib sign nonzero numeric)))
         (lib (cdr positive))
         (threshold (if negative (library-lt z remainder-sum) (library-lt remainder-sum z)))
         (without-carry (b1-floor-sum-mod-sum-carry
                         lib work lhs choices numeric nonzero sign (car positive) threshold quotient nil))
         (with-carry (b1-floor-sum-mod-sum-carry
                      lib work lhs choices numeric nonzero sign (car positive) threshold quotient t))
         (step (proof-proof-cases (library-library-proof lib) threshold without-carry with-carry)))
      (cons step lib))))

(defun b1-floor-sum-mod-sum-consequence (premise lib x y z numeric-test zero-test negative-test lhs choices)
  (proof-with-checked-results
      ((rationals (b1-logic-bookproof-split-conjuncts lib premise))
       (work (b1-floor-sum-floor-sum-init lib x y z rationals))
       (lib (b1-floor-sum-floor-sum-lib work))
       (proof (library-library-proof lib))
       (numeric (proof-proof-assume proof numeric-test t))
       (nonzero (proof-proof-assume proof zero-test nil))
       (quotient (proof-proof-fact proof *b1-floor-sum-floor-sum* nil))
       (quotient (proof-proof-modus-ponens proof quotient premise))
       (negative (b1-floor-sum-mod-sum-consequence-branch
                  t work negative-test numeric nonzero lhs choices quotient))
       (work (b1-floor-sum-floor-sum-with-lib work (cdr negative)))
       (nonnegative (b1-floor-sum-mod-sum-consequence-branch
                     nil work negative-test numeric nonzero lhs choices quotient))
       (lib (cdr nonnegative))
       (work (b1-floor-sum-floor-sum-with-lib work lib))
       (proof (library-library-proof lib))
       (nonzero-value (proof-proof-cases proof negative-test (car negative) (car nonnegative)))
       (is-zero (proof-proof-assume proof zero-test t))
       (zero-minus (b1-logic-bookproof-normalize lib (library-minus z) nil nil
                                                 (list (b1-logic-equal-to is-zero)) nil nil nil))
       (at-zero (b1-floor-sum-zero-divisor-remainders lib work lhs choices (list :zero is-zero) zero-minus))
       (not-numeric (proof-proof-assume proof numeric-test nil))
       (minus-value (library-library-axiom lib "DEFAULT-UNARY-MINUS" (list z)))
       (minus-value (proof-proof-modus-ponens proof minus-value not-numeric))
       (at-nonnumeric (b1-floor-sum-zero-divisor-remainders
                       lib work lhs choices (list :nonnumeric not-numeric) minus-value))
       (numeric-result (proof-proof-cases proof zero-test at-zero nonzero-value))
       (step (proof-proof-cases proof numeric-test numeric-result at-nonnumeric)))
    (cons step lib)))

(defun b1-floor-sum-mod-sum (lib formula)
  (proof-with-checked-results ((parts (b1-floor-sum-addend-formula formula)))
    (let* ((lhs (car parts))
           (choices (cadr parts))
           (x (caddr parts))
           (y (cadddr parts))
           (z (nth 4 parts))
           (numeric-test (list *library-numberp* z))
           (zero-test (proof-eq z *proof-zero*))
           (negative-test (library-lt z *proof-zero*)))
      (proof-with-checked-results
          ((premise (b1-logic-bookproof-prove-implication-premise lib formula))
           (result (b1-floor-sum-mod-sum-consequence
                    premise lib x y z numeric-test zero-test negative-test lhs choices))
           (lib (cdr result))
           (step (b1-logic-bookproof-prove-implication-with-premise lib formula premise (car result))))
        (cons step lib)))))
