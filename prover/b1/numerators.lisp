(in-package "BOYMOO-PROVER")
(set-verify-guards-eagerness 0)

(defun b1-numerators-step-term (step index)
  (proof-with-checked-results ((first (proof-step-first step)))
    (proof-term-at first index)))

(defun b1-numerators-numerator-is-integer (lib argument)
  (let ((proof (library-library-proof lib))
        (rational (list *library-rationalp* argument)))
    (proof-with-checked-results
        ((axiom (library-library-axiom lib "RATIONAL-IMPLIES1" (list argument)))
         (yes-test (proof-proof-assume proof rational t))
         (result (proof-proof-modus-ponens proof axiom yes-test))
         (conjuncts (b1-logic-bookproof-split-conjuncts lib result))
         (yes (if (consp (cdr conjuncts)) (cadr conjuncts)
                '(:failure "failure" "")))
         (axiom (library-library-axiom lib "DEFAULT-NUMERATOR" (list argument)))
         (no-test (proof-proof-assume proof rational nil))
         (default (proof-proof-modus-ponens proof axiom no-test))
         (zero-type (library-library-type-of lib *proof-zero* nil))
         (no (library-library-transport-argument lib zero-type default 1)))
      (proof-proof-cases proof rational yes no))))

(defun b1-numerators-equal-numerator (lib formula)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((test (proof-term-at formula 1))
         (arguments (proof-list-of-length (cdr test) 2)))
      (let* ((x (car arguments))
             (int-test (library-integer x)))
        (proof-with-checked-results
            ((true-int (proof-proof-assume proof int-test t))
             (bool-int (proof-proof-fact proof "booleanp-integerp" (list (list *library-x* x))))
             (axiom (library-library-axiom lib "NUMERATOR-WHEN-INTEGERP" (list x)))
             (rewrite (proof-proof-modus-ponens proof axiom true-int))
             (reverse (proof-proof-symmetric proof rewrite))
             (yes (b1-logic-bookproof-equality-true lib reverse))
             (boolean (b1-logic-bookproof-boolean-value lib true-int bool-int))
             (reverse (proof-proof-symmetric proof boolean))
             (yes (proof-proof-chain proof yes (list reverse)))
             (no-int (proof-proof-assume proof int-test nil))
             (int-num (b1-numerators-numerator-is-integer lib x))
             (assumed (proof-proof-assume proof test t))
             (impossible (library-library-transport-argument lib int-num assumed 1))
             (cut (proof-proof-cut proof impossible no-int))
             (unequal (proof-proof-front proof cut (proof-neg test)))
             (false-test (b1-logic-bookproof-false-value lib unequal))
             (false-int (b1-logic-bookproof-false-value lib no-int))
             (reverse (proof-proof-symmetric proof false-int))
             (no (proof-proof-chain proof false-test (list reverse))))
          (proof-proof-cases proof int-test yes no))))))

(defun b1-numerators-unit-denominator-consequence (premise lib)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((parts (b1-logic-bookproof-split-conjuncts lib premise))
         (parts (proof-list-of-length parts 2))
         (rational (car parts))
         (denominator (cadr parts))
         (argument (b1-numerators-step-term rational 1))
         (representation (b1-arithmetic-numerator-product lib rational))
         (reverse (proof-proof-symmetric proof denominator))
         (equation (proof-proof-rewrite proof (car representation) reverse '(1 1 2)))
         (reverse (proof-proof-symmetric proof equation))
         (unit (b1-arithmetic-multiply-one lib argument (list rational) nil)))
      (proof-proof-chain proof reverse (list unit)))))

(defun b1-numerators-unit-denominator (lib formula)
  (proof-with-checked-results
      ((premise (b1-logic-bookproof-prove-implication-premise lib formula))
       (consequence (b1-numerators-unit-denominator-consequence premise lib)))
    (b1-logic-bookproof-prove-implication-with-premise lib formula premise consequence)))

(defun b1-numerators-negative-numerator (lib formula)
  (proof-with-checked-results
      ((sides (proof-list-of-length (cdr formula) 2))
       (lhs (car sides))
       (rhs (cadr sides))
       (branches (proof-list-of-length (cdr rhs) 3))
       (test (car branches))
       (comparison (cadr branches))
       (x (proof-term-at test 1))
       (rational (proof-proof-assume (library-library-proof lib) test t))
       (representation (b1-arithmetic-numerator-product lib rational))
       (equation (car representation))
       (types (cadr representation))
       (product (b1-numerators-step-term equation 1))
       (factors (proof-list-of-length product 3))
       (d (caddr factors))
       (rational-d (b1-arithmetic-known-type lib *library-rationalp* d (list (car types))))
       (scaled (b1-division-positive-scale lib comparison (caddr types) rational-d (list rational)))
       (lib (cdr scaled))
       (proof (library-library-proof lib))
       (commute (library-library-axiom lib "COMMUTATIVITY-OF-*" (list d x)))
       (scale (proof-proof-rewrite proof (car scaled) commute '(1 2 1)))
       (scale (proof-proof-rewrite proof scale equation '(1 2 1)))
       (times-zero (b1-arithmetic-multiply-zero lib d))
       (scale (proof-proof-rewrite proof scale times-zero '(1 2 2)))
       (reverse (proof-proof-symmetric proof scale))
       (selected (proof-proof-if-true proof rhs))
       (reverse-selected (proof-proof-symmetric proof selected))
       (yes (proof-proof-chain proof reverse (list reverse-selected)))
       (axiom (library-library-axiom lib "DEFAULT-NUMERATOR" (list x)))
       (not-rational (proof-proof-assume proof test nil))
       (default (proof-proof-modus-ponens proof axiom not-rational))
       (left-zero (b1-logic-bookproof-normalize
                   lib lhs nil nil (list (b1-logic-equal-to default)) nil nil nil))
       (selected (proof-proof-if-false proof rhs))
       (reverse-selected (proof-proof-symmetric proof selected))
       (no (proof-proof-chain proof left-zero (list reverse-selected)))
       (step (proof-proof-cases proof test yes no)))
    (cons step lib)))

(defun b1-numerators-numerator-negation (lib argument)
  (let ((name (proof-sym "SELF-NUMERATOR-NEGATION" "ACL2")))
    (proof-with-checked-results
        ((lib (if (assoc-equal name (proof-proof-facts (library-library-proof lib)))
                  lib
                (let ((claim (proof-eq
                              (list *b1-arithmetic-numerator* (library-minus *library-x*))
                              (library-minus (list *b1-arithmetic-numerator* *library-x*)))))
                  (proof-with-checked-results ((result (b1-reduced-numerator-minus lib claim)))
                    (library-library-lemma (cdr result) "NUMERATOR-NEGATION" claim (car result) nil)))))
         (step (proof-proof-fact (library-library-proof lib) name
                                (list (list *library-x* argument)))))
      (cons step lib))))

(defun b1-numerators-distribute-equation (lib operation left right)
  (if (equal operation *proof-times*)
      (proof-with-checked-results ((value (proof-term-at right 1)))
        (b1-arithmetic-multiply-negation lib left value))
    (proof-with-checked-results
        ((a (proof-term-at left 1))
         (b (proof-term-at right 1))
         (result (b1-arithmetic-total-sum-negation lib a b))
         (lib (cdr result))
         (equation (proof-proof-symmetric (library-library-proof lib) (car result))))
      (cons equation lib))))

(defun b1-numerators-numerator-distribute-sign (lib formula)
  (proof-with-checked-results
      ((sides (proof-list-of-length (cdr formula) 2))
       (value (car sides))
       (expression (proof-term-at value 1))
       (parts (proof-list-of-length expression 3))
       (result (b1-numerators-distribute-equation lib (car parts) (cadr parts) (caddr parts)))
       (lib (cdr result))
       (equation (car result))
       (proof (library-library-proof lib))
       (negative (b1-numerators-step-term equation 2))
       (original (proof-term-at negative 1))
       (start (proof-proof-reflexive proof value))
       (rewritten (proof-proof-rewrite proof start equation '(1 2 1)))
       (negation (b1-numerators-numerator-negation lib original))
       (lib (cdr negation))
       (step (proof-proof-chain (library-library-proof lib) rewritten (list (car negation)))))
    (cons step lib)))

(defun b1-numerators-positive-reciprocal-numerator (lib integral strict)
  (proof-with-checked-results
      ((x (b1-numerators-step-term integral 1))
       (inv (b1-arithmetic-reciprocal x))
       (numeric (b1-arithmetic-known-type lib *library-numberp* x (list integral)))
       (rational (b1-arithmetic-known-type lib *library-rationalp* x (list integral)))
       (rational-inv (b1-arithmetic-known-type lib *library-rationalp* inv (list rational)))
       (representation (b1-arithmetic-numerator-product lib rational-inv))
       (rep (car representation))
       (int-d (caadr representation))
       (int-n (cadadr representation))
       (pos-d (car (cddadr representation)))
       (d (b1-numerators-step-term int-d 1))
       (n (b1-numerators-step-term int-n 1))
       (nonzero (b1-arithmetic-positive-nonzero lib strict))
       (inverse (b1-arithmetic-inverse-product lib x numeric nonzero))
       (numeric-d (b1-arithmetic-known-type lib *library-numberp* d (list int-d)))
       (unit (b1-powers-multiply-inverse lib x inv d inverse numeric-d))
       (proof (library-library-proof lib))
       (reverse (proof-proof-symmetric proof unit))
       (factorization (proof-proof-rewrite proof reverse rep '(1 2 2)))
       (commute (library-library-axiom lib "COMMUTATIVITY-OF-*" (list x n)))
       (factorization (proof-proof-chain proof factorization (list commute)))
       (positive-inv (b1-arithmetic-positive-reciprocal lib strict rational))
       (lib (cdr positive-inv))
       (proof (library-library-proof lib))
       (pos-n (b1-arithmetic-positive-product lib (car positive-inv) pos-d (list rational-inv int-d)))
       (pos-n (proof-proof-rewrite proof pos-n rep '(1 2)))
       (unit (b1-arithmetic-multiply-one lib n (list int-n) nil))
       (numerator (proof-proof-symmetric proof unit))
       (lowest (proof-proof-fact
                proof (proof-sym "LOWEST-TERMS" "ACL2")
                (list (list *library-x* inv) (list (proof-sym "N" "ACL2") n)
                      (list (proof-sym "R" "ACL2") *proof-one*) (list (proof-sym "Q" "ACL2") x))))
       (test (b1-numerators-step-term lowest 1))
       (int-one (library-library-type-of lib *proof-one* nil))
       (guard (b1-logic-bookproof-normalize-proof
               lib test (list int-n rational-inv int-one integral pos-n numerator factorization)
               nil nil nil))
       (step (proof-proof-modus-ponens proof lowest guard)))
    (cons step lib)))

(defun b1-numerators-reciprocal-numerator-consequence
    (integral lib formula x left signum zero-test positive-test)
  (proof-with-checked-results
      ((signum-head (proof-term-at signum 0))
       (unfold (list signum-head (proof-cl "ZEROP") (proof-cl "MINUSP") *b1-logic-eql* *proof-not*))
       (proof (library-library-proof lib))
       (zero (proof-proof-assume proof zero-test t))
       (claim (proof-term-at formula 2))
       (at-zero (b1-logic-bookproof-normalize-proof lib claim nil unfold (list (b1-logic-equal-to zero)) nil))
       (nonzero (proof-proof-assume proof zero-test nil))
       (numeric (b1-arithmetic-known-type lib *library-numberp* x (list integral)))
       (strict (proof-proof-assume proof positive-test t))
       (sums (b1-arithmetic-number-sums-init lib))
       (lib (b1-arithmetic-number-sums-library sums))
       (pos-value (b1-numerators-positive-reciprocal-numerator lib integral strict))
       (lib (cdr pos-value))
       (proof (library-library-proof lib))
       (sums (b1-arithmetic-number-sums-with-library sums lib))
       (weak (b1-arithmetic-number-sums-weaken sums strict (list numeric)))
       (pos-signum (b1-logic-bookproof-normalize lib signum (list nonzero weak) unfold nil nil nil nil))
       (reverse (proof-proof-symmetric proof pos-signum))
       (yes (proof-proof-chain proof (car pos-value) (list reverse)))
       (not-positive (proof-proof-assume proof positive-test nil))
       (negative (b1-scaling-negative-from-signs lib numeric not-positive nonzero))
       (lt-zero (b1-arithmetic-number-sums-comparison sums x *proof-zero* (list numeric)))
       (cancel (b1-arithmetic-add-zero lib (library-minus x) nil))
       (lt-zero (proof-proof-rewrite proof lt-zero cancel '(1 2 2)))
       (lt-zero (proof-proof-transport proof negative lt-zero))
       (minus-int (library-library-type-of lib (library-minus x) (list integral)))
       (negative-value (b1-numerators-positive-reciprocal-numerator lib minus-int negative))
       (lib (cdr negative-value))
       (reciprocal-negation (b1-arithmetic-reciprocal-negation lib x numeric nonzero))
       (lib (cdr reciprocal-negation))
       (proof (library-library-proof lib))
       (negative-value (proof-proof-rewrite proof (car negative-value) (car reciprocal-negation) '(1 1 1)))
       (numerator-negation (b1-numerators-numerator-negation lib (b1-arithmetic-reciprocal x)))
       (lib (cdr numerator-negation))
       (proof (library-library-proof lib))
       (negative-value (proof-proof-rewrite proof negative-value (car numerator-negation) '(1 1)))
       (twice (proof-proof-reflexive proof (library-minus (library-minus left))))
       (twice (proof-proof-rewrite proof twice negative-value '(1 2 1)))
       (constant (b1-logic-bookproof-constant lib (library-minus *proof-one*)))
       (twice (proof-proof-chain proof twice (list constant)))
       (int-num (b1-numerators-numerator-is-integer lib (b1-arithmetic-reciprocal x)))
       (num-type (b1-arithmetic-known-type lib *library-numberp* left (list int-num)))
       (sums (b1-arithmetic-number-sums-with-library sums lib))
       (cancel (b1-arithmetic-number-sums-cite sums "DOUBLE-NEGATION" (list left) (list num-type)))
       (minus-value (proof-proof-rewrite proof twice cancel '(1 1)))
       (neg-signum (b1-logic-bookproof-normalize lib signum (list nonzero lt-zero) unfold nil nil nil nil))
       (reverse (proof-proof-symmetric proof neg-signum))
       (no (proof-proof-chain proof minus-value (list reverse)))
       (nonzero-value (proof-proof-cases proof positive-test yes no))
       (step (proof-proof-cases proof zero-test at-zero nonzero-value)))
    (cons step lib)))

(defun b1-numerators-reciprocal-numerator (lib formula)
  (proof-with-checked-results
      ((test (proof-term-at formula 1))
       (x (proof-term-at test 1))
       (claim (proof-term-at formula 2))
       (sides (proof-list-of-length (cdr claim) 2))
       (premise (b1-logic-bookproof-prove-implication-premise lib formula))
       (result (b1-numerators-reciprocal-numerator-consequence
                premise lib formula x (car sides) (cadr sides) (proof-eq x *proof-zero*)
                (library-positive x)))
       (lib (cdr result))
       (step (b1-logic-bookproof-prove-implication-with-premise lib formula premise (car result))))
    (cons step lib)))

(defun b1-numerators-numerator-upper-bound-consequence
    (premise lib formula comparison i ratio j zero-test)
  (proof-with-checked-results
      ((proof (library-library-proof lib))
       (conjuncts (b1-logic-bookproof-split-conjuncts lib premise))
       (conjuncts (proof-list-of-length conjuncts 2))
       (natural (car conjuncts))
       (positive-j (cadr conjuncts))
       (posp (proof-step-first positive-j))
       (opened (proof-proof-unfold proof posp))
       (positive-j (proof-proof-rewrite proof positive-j opened '(1)))
       (conjuncts (b1-logic-bookproof-split-conjuncts lib positive-j))
       (conjuncts (proof-list-of-length conjuncts 2))
       (integral-j (car conjuncts))
       (positive-j (cadr conjuncts))
       (integral-i (library-library-cite lib "NATURAL-INTEGER" (list i) (list natural)))
       (rational-i (b1-arithmetic-known-type lib *library-rationalp* i (list integral-i integral-j)))
       (rational-j (b1-arithmetic-known-type lib *library-rationalp* j (list integral-i integral-j)))
       (i-term (b1-numerators-step-term rational-i 1))
       (numeric-i (b1-arithmetic-known-type lib *library-numberp* i-term (list rational-i)))
       (j-term (b1-numerators-step-term rational-j 1))
       (numeric-j (b1-arithmetic-known-type lib *library-numberp* j-term (list rational-j)))
       (nonzero-j (b1-arithmetic-positive-nonzero lib positive-j))
       (inverse (b1-arithmetic-inverse-product lib j numeric-j nonzero-j))
       (reciprocal (b1-arithmetic-reciprocal j))
       (commute (library-library-axiom lib "COMMUTATIVITY-OF-*" (list reciprocal j)))
       (inverse (proof-proof-chain proof commute (list inverse)))
       (integral-value (library-library-axiom lib "ASSOCIATIVITY-OF-*" (list i reciprocal j)))
       (integral-value (proof-proof-rewrite proof integral-value inverse '(1 2 2)))
       (unit (b1-arithmetic-multiply-one lib i (list integral-i) nil))
       (integral-value (proof-proof-chain proof integral-value (list unit)))
       (given-product (library-library-transport-argument lib integral-i integral-value 1))
       (rationals (list rational-i rational-j))
       (rational-ratio (b1-arithmetic-known-type lib *library-rationalp* ratio rationals))
       (minimum (b1-reduced-minimum-denominator-bound lib rational-ratio integral-j positive-j given-product))
       (lib (cdr minimum))
       (proof (library-library-proof lib))
       (representation (b1-arithmetic-numerator-product lib rational-ratio))
       (product-ratio (car representation))
       (int-d (caadr representation))
       (nonnegative-i (library-library-cite lib "NATURAL-NONNEGATIVE" (list i) (list natural)))
       (nonzero-i (proof-proof-assume proof zero-test nil))
       (positive-i (b1-arithmetic-positive-from-bounds lib nonnegative-i nonzero-i numeric-i))
       (lib (cdr positive-i))
       (positive-reciprocal (b1-arithmetic-positive-reciprocal lib positive-j rational-j))
       (lib (cdr positive-reciprocal))
       (pos-ratio (b1-arithmetic-positive-product lib (car positive-i) (car positive-reciprocal) rationals))
       (less (b1-numerators-step-term (car minimum) 1))
       (ordered (b1-division-positive-scale lib less pos-ratio rational-ratio (list integral-j int-d)))
       (lib (cdr ordered))
       (proof (library-library-proof lib))
       (ordered (proof-proof-rewrite proof (car ordered) integral-value '(1 2 1)))
       (ordered (proof-proof-rewrite proof ordered product-ratio '(1 2 2)))
       (assumed (proof-proof-assume proof comparison t))
       (bad (proof-proof-transport proof assumed ordered))
       (cut (proof-proof-cut proof bad (car minimum)))
       (goal (proof-term-at formula 2))
       (strict-case (proof-proof-front proof cut goal))
       (zero (proof-proof-assume proof zero-test t))
       (commute (library-library-axiom lib "COMMUTATIVITY-OF-*" (list i reciprocal)))
       (ratio-zero (proof-proof-rewrite proof commute zero '(1 2 2)))
       (cancel (b1-arithmetic-multiply-zero lib reciprocal))
       (ratio-zero (proof-proof-chain proof ratio-zero (list cancel)))
       (at-zero (b1-logic-bookproof-normalize-proof
                 lib goal nil (list *proof-not*)
                 (list (b1-logic-equal-to zero) (b1-logic-equal-to ratio-zero)) nil))
       (step (proof-proof-cases proof zero-test at-zero strict-case)))
    (cons step lib)))

(defun b1-numerators-numerator-upper-bound (lib formula)
  (proof-with-checked-results
      ((goal (proof-term-at formula 2))
       (comparison (proof-term-at goal 1))
       (parts (proof-list-of-length comparison 3))
       (numerator (proof-list-of-length (caddr parts) 2))
       (i (cadr parts))
       (ratio (cadr numerator))
       (reciprocal (proof-term-at ratio 2))
       (j (proof-term-at reciprocal 1))
       (premise (b1-logic-bookproof-prove-implication-premise lib formula))
       (result (b1-numerators-numerator-upper-bound-consequence
                premise lib formula comparison i ratio j (proof-eq i *proof-zero*)))
       (lib (cdr result))
       (step (b1-logic-bookproof-prove-implication-with-premise lib formula premise (car result))))
    (cons step lib)))
