(in-package "BOYMOO-PROVER")
(set-verify-guards-eagerness 0)

(defconst *b1-integrality-two* (proof-quote 2))
(defconst *b1-integrality-half* (proof-quote '("ratio" 1 2)))

(defun b1-integrality-integer-value (lib step)
  (proof-with-checked-results
      ((literal (proof-step-first step))
       (term (proof-term-at literal 1))
       (boolean (proof-proof-fact (library-library-proof lib) "booleanp-integerp"
                                  (list (list *library-x* term)))))
    (b1-logic-bookproof-boolean-value lib step boolean)))

(defun b1-integrality-integer-equivalence (lib left-to-right right-to-left)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((right-to-left-literal (proof-step-first right-to-left))
         (left (proof-term-at right-to-left-literal 1))
         (left-to-right-literal (proof-step-first left-to-right))
         (right (proof-term-at left-to-right-literal 1))
         (first (library-integer left))
         (second (library-integer right))
         (integral (proof-proof-assume proof first t))
         (forward-term (proof-term-at left-to-right-literal 2))
         (forward (library-library-type-of lib forward-term (list integral)))
         (forward (library-library-transport-argument lib forward left-to-right 1))
         (first-value (b1-integrality-integer-value lib integral))
         (second-value (b1-integrality-integer-value lib forward))
         (second-value (proof-proof-symmetric proof second-value))
         (yes (proof-proof-chain proof first-value (list second-value)))
         (backward-term (proof-term-at right-to-left-literal 2))
         (second-integral (proof-proof-assume proof second t))
         (backward (library-library-type-of lib backward-term (list second-integral)))
         (backward (library-library-transport-argument lib backward right-to-left 1))
         (not-integral (proof-proof-assume proof first nil))
         (not-second (proof-proof-cut proof backward not-integral))
         (not-second (proof-proof-front proof not-second (proof-neg second)))
         (first-value (b1-logic-bookproof-false-value lib not-integral))
         (second-value (b1-logic-bookproof-false-value lib not-second))
         (second-value (proof-proof-symmetric proof second-value))
         (no (proof-proof-chain proof first-value (list second-value))))
      (proof-proof-cases proof first yes no))))

(defun b1-integrality-pair-arguments (term)
  (if (integerp term)
      '(:failure "failure" "")
    (proof-list-of-length (cdr term) 2)))

(defun b1-integrality-half-shift-consequence (rational lib left right)
  (proof-with-checked-results
      ((sums (b1-arithmetic-number-sums-init lib))
       (lib (b1-arithmetic-number-sums-library sums))
       (one-more (b1-arithmetic-number-sums-linear-equal
                  sums right (library-plus *proof-one* left) (list rational)))
       (one-less (b1-arithmetic-number-sums-linear-equal
                  sums left (library-plus *proof-neg-one* right) (list rational)))
       (step (b1-integrality-integer-equivalence lib one-more one-less)))
    (cons step lib)))

(defun b1-integrality-half-shift (lib formula)
  (proof-with-checked-results
      ((conclusion (proof-term-at formula 2))
       (parts (b1-integrality-pair-arguments conclusion))
       (left (proof-term-at (car parts) 1))
       (right (proof-term-at (cadr parts) 1))
       (premise (b1-logic-bookproof-prove-implication-premise lib formula))
       (result (b1-integrality-half-shift-consequence premise lib left right))
       (lib (cdr result))
       (step (b1-logic-bookproof-prove-implication-with-premise lib formula premise (car result))))
    (cons step lib)))

(defun b1-integrality-reflected-half-consequence (integral lib left right)
  (proof-with-checked-results
      ((sums (b1-arithmetic-number-sums-init lib))
       (lib (b1-arithmetic-number-sums-library sums))
       (back (b1-arithmetic-number-sums-linear-equal
              sums left (library-diff *proof-one* right) (list integral)))
       (forward (b1-arithmetic-number-sums-linear-equal
                 sums right (library-diff *proof-one* left) (list integral)))
       (step (b1-integrality-integer-equivalence lib forward back)))
    (cons step lib)))

(defun b1-integrality-reflected-half (lib formula)
  (proof-with-checked-results
      ((conclusion (proof-term-at formula 2))
       (parts (b1-integrality-pair-arguments conclusion))
       (left (proof-term-at (car parts) 1))
       (right (proof-term-at (cadr parts) 1))
       (premise (b1-logic-bookproof-prove-implication-premise lib formula))
       (result (b1-integrality-reflected-half-consequence premise lib left right))
       (lib (cdr result))
       (step (b1-logic-bookproof-prove-implication-with-premise lib formula premise (car result))))
    (cons step lib)))

(defun b1-integrality-negated-sum-integral (lib formula)
  (proof-with-checked-results
      ((parts (b1-integrality-pair-arguments formula))
       (left (proof-term-at (car parts) 1))
       (right (proof-term-at (cadr parts) 1))
       (addends (b1-integrality-pair-arguments right))
       (distribute (b1-arithmetic-total-sum-negation lib (car addends) (cadr addends)))
       (lib (cdr distribute)))
    (if (equal left (caddr (proof-step-first (car distribute))))
        (proof-with-checked-results
            ((sums (b1-arithmetic-number-sums-init lib))
             (lib (b1-arithmetic-number-sums-library sums))
             (proof (library-library-proof lib))
             (numeric (b1-arithmetic-known-type lib *library-numberp* right nil))
             (involution (b1-arithmetic-number-sums-cite sums "DOUBLE-NEGATION" (list right)
                                                         (list numeric)))
             (reverse (proof-proof-rewrite proof involution (car distribute) '(1 1 1)))
             (reverse (proof-proof-symmetric proof reverse))
             (symmetric-distribution (proof-proof-symmetric proof (car distribute)))
             (step (b1-integrality-integer-equivalence lib reverse symmetric-distribution)))
          (cons step lib))
      '(:failure "failure" ""))))

(defun b1-integrality-increment-half-consequence (premise lib numerator inverse desired)
  (proof-with-checked-results
      ((parts (b1-logic-bookproof-split-conjuncts lib premise))
       (parts (proof-list-of-length parts 2)))
    (let ((rational (cadr parts))
          (proof (library-library-proof lib)))
      (proof-with-checked-results
          ((previous (proof-proof-fact proof (proof-sym "HELPER-1-AUX2" "ACL2") nil))
           (previous (proof-proof-modus-ponens proof previous premise))
           (lower (cadr (cadr (proof-step-first previous))))
           (sums (b1-arithmetic-number-sums-init lib))
           (lib (b1-arithmetic-number-sums-library sums))
           (proof (library-library-proof lib))
           (add-two (b1-arithmetic-number-sums-linear-equal
                     sums numerator (library-plus lower *b1-integrality-two*) (list rational)))
           (expanded (proof-proof-reflexive proof desired))
           (expanded (proof-proof-rewrite proof expanded add-two '(1 2 1)))
           (distribute (b1-scaling-distribute-left-sum lib lower *b1-integrality-two* inverse))
           (expanded (proof-proof-chain proof expanded (list distribute)))
           (unit (b1-logic-bookproof-normalize lib (b1-arithmetic-product *b1-integrality-two* inverse)
                                             nil nil nil nil nil nil))
           (expanded (proof-proof-rewrite proof expanded unit '(1 2 2)))
           (integral (library-library-type-of lib (caddr (proof-step-first expanded)) (list previous)))
           (step (library-library-transport-argument lib integral expanded 1)))
        (cons step lib)))))

(defun b1-integrality-increment-half (lib formula)
  (proof-with-checked-results
      ((conclusion (proof-term-at formula 2))
       (desired (proof-term-at conclusion 1))
       (desired (proof-list-of-length desired 3))
       (premise (b1-logic-bookproof-prove-implication-premise lib formula))
       (result (b1-integrality-increment-half-consequence premise lib (cadr desired) (caddr desired)
                                                         desired))
       (lib (cdr result))
       (step (b1-logic-bookproof-prove-implication-with-premise lib formula premise (car result))))
    (cons step lib)))

(defun b1-integrality-binary-residue (lib integral)
  (proof-with-checked-results
      ((int-two (library-library-type-of lib *b1-integrality-two* nil))
       (pos-two (proof-proof-prove (library-library-proof lib)
                                   (library-positive *b1-integrality-two*) nil nil))
       (ring (b1-modular-modulus-init lib int-two pos-two))
       (bounds (b1-modular-modulus-bounds ring integral))
       (lib (cdr bounds))
       (proof (library-library-proof lib))
       (int-r (caar bounds))
       (lower (cadar bounds))
       (upper (caddar bounds))
       (r (cadr (proof-step-first int-r)))
       (zero (proof-eq r *proof-zero*))
       (nonzero (proof-proof-assume proof zero nil))
       (numeric-r (b1-arithmetic-known-type lib *library-numberp* r (list int-r)))
       (pos-r (b1-arithmetic-positive-from-bounds lib lower nonzero numeric-r))
       (lib (cdr pos-r))
       (proof (library-library-proof lib))
       (lower-one (b1-arithmetic-integer-discrete lib (car pos-r) int-r))
       (int-one (library-library-type-of lib *proof-one* nil))
       (either-order (b1-arithmetic-integer-compare lib r *proof-one* (list int-r int-one)))
       (higher (proof-proof-assume proof (library-lt *proof-one* r) t))
       (too-high (b1-floor-advance-bound lib higher int-one int-r))
       (lib (cdr too-high))
       (proof (library-library-proof lib))
       (two (b1-logic-bookproof-constant lib (library-plus *proof-one* *proof-one*)))
       (too-high (proof-proof-rewrite proof (car too-high) two '(1 1 2)))
       (not-higher (proof-proof-cut proof upper too-high))
       (not-higher (proof-proof-front proof not-higher (proof-neg (proof-step-first higher))))
       (above-low (proof-proof-front proof either-order (cadr (proof-step-first lower-one))))
       (above-low (proof-proof-cut proof above-low lower-one))
       (one (proof-proof-front proof above-low (proof-step-first higher)))
       (one (proof-proof-cut proof one not-higher))
       (one (proof-proof-front proof one (proof-eq r *proof-one*))))
    (cons (list zero one) lib)))

(defun b1-integrality-half-choice-branch (lib goal x rational remainder name)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((fact (proof-proof-fact proof (proof-sym name "ACL2") (list (list *library-x* x))))
         (reversed (proof-proof-symmetric proof remainder))
         (guard (b1-logic-bookproof-normalize-proof lib (cadr (proof-step-first fact))
                                                  (list rational reversed) nil nil nil))
         (integral-half (proof-proof-modus-ponens proof fact guard)))
      (if (equal name "HELPER-0")
          (proof-with-checked-results
              ((selected (proof-proof-select proof goal integral-half)))
            (proof-proof-transport proof integral-half selected))
        (proof-with-checked-results
            ((test (proof-term-at goal 1))
             (child (proof-proof-assume proof test t))
             (yes (proof-proof-select proof goal child))
             (yes (proof-proof-transport proof child yes))
             (no (proof-proof-if-false proof goal))
             (no (proof-proof-transport proof integral-half no)))
          (proof-proof-cases proof test yes no))))))

(defun b1-integrality-half-choice-consequence (integral lib x goal)
  (proof-with-checked-results
      ((bounds (b1-integrality-binary-residue lib integral))
       (lib (cdr bounds))
       (proof (library-library-proof lib))
       (zero-test (caar bounds))
       (one (cadar bounds))
       (rational (b1-arithmetic-known-type lib *library-rationalp* x (list integral)))
       (zero (proof-proof-assume proof zero-test t))
       (yes (b1-integrality-half-choice-branch lib goal x rational zero "HELPER-0"))
       (no (b1-integrality-half-choice-branch lib goal x rational one "HELPER-1"))
       (step (proof-proof-cases proof zero-test yes no)))
    (cons step lib)))

(defun b1-integrality-half-choice (lib formula)
  (proof-with-checked-results
      ((test (proof-term-at formula 1))
       (x (proof-term-at test 1))
       (goal (proof-term-at formula 2))
       (premise (b1-logic-bookproof-prove-implication-premise lib formula))
       (result (b1-integrality-half-choice-consequence premise lib x goal))
       (lib (cdr result))
       (step (b1-logic-bookproof-prove-implication-with-premise lib formula premise (car result))))
    (cons step lib)))

(defun b1-integrality-half-complement-consequence (integral lib x left right test base)
  (proof-with-checked-results
      ((shifted (proof-term-at left 1))
       (proof (library-library-proof lib))
       (have-base (proof-proof-assume proof test t))
       (have-left (proof-proof-assume proof left t))
       (difference (library-diff shifted base))
       (lower (library-library-type-of lib difference (list have-base have-left)))
       (sums (b1-arithmetic-number-sums-init lib))
       (lib (b1-arithmetic-number-sums-library sums))
       (proof (library-library-proof lib))
       (half (b1-arithmetic-number-sums-linear-equal sums difference *b1-integrality-half*
                                                    (list integral)))
       (impossible (proof-proof-rewrite proof lower half '(1 1)))
       (constant (b1-logic-bookproof-constant lib (library-integer *b1-integrality-half*)))
       (impossible (proof-proof-rewrite proof impossible constant '(1)))
       (impossible (proof-proof-tidy proof impossible))
       (no-left (proof-proof-front proof impossible (proof-neg left)))
       (false-right (b1-logic-bookproof-normalize lib right (list have-base) (list *proof-not*)
                                                 nil nil nil nil))
       (with-base (b1-logic-bookproof-false-value lib no-left))
       (false-right (proof-proof-symmetric proof false-right))
       (with-base (proof-proof-chain proof with-base (list false-right)))
       (no-base (proof-proof-assume proof test nil))
       (choice (proof-proof-fact proof (proof-sym "INTEGERP-CHOICE" "ACL2")
                                 (list (list *library-x* x))))
       (choice (proof-proof-modus-ponens proof choice integral))
       (inverse (b1-arithmetic-reciprocal *b1-integrality-two*))
       (actual-base (library-library-axiom lib "COMMUTATIVITY-OF-*" (list x inverse)))
       (inverse-value (b1-logic-bookproof-constant lib inverse))
       (actual-base (proof-proof-rewrite proof actual-base inverse-value '(1 2 1)))
       (choice (proof-proof-rewrite proof choice actual-base '(1 1 1)))
       (other (proof-proof-prove-if proof choice no-base))
       (normalized (b1-scaling-distribute-left-sum lib *proof-one* x inverse))
       (one-times-inverse (b1-logic-bookproof-normalize
                           lib (b1-arithmetic-product *proof-one* inverse) nil nil nil nil nil nil))
       (normalized (proof-proof-rewrite proof normalized one-times-inverse '(1 2 1)))
       (normalized (proof-proof-rewrite proof normalized actual-base '(1 2 2)))
       (other (proof-proof-rewrite proof other normalized '(1 1)))
       (true-right (b1-logic-bookproof-normalize lib right (list no-base) (list *proof-not*)
                                                nil nil nil nil))
       (without-base (b1-integrality-integer-value lib other))
       (true-right (proof-proof-symmetric proof true-right))
       (without-base (proof-proof-chain proof without-base (list true-right)))
       (step (proof-proof-cases proof test with-base without-base)))
    (cons step lib)))

(defun b1-integrality-half-complement (lib formula)
  (proof-with-checked-results
      ((hypothesis (proof-term-at formula 1))
       (x (proof-term-at hypothesis 1))
       (conclusion (proof-term-at formula 2))
       (parts (b1-integrality-pair-arguments conclusion))
       (left (car parts))
       (right (cadr parts))
       (test (proof-term-at right 1))
       (base (proof-term-at test 1))
       (premise (b1-logic-bookproof-prove-implication-premise lib formula))
       (result (b1-integrality-half-complement-consequence premise lib x left right test base))
       (lib (cdr result))
       (step (b1-logic-bookproof-prove-implication-with-premise lib formula premise (car result))))
    (cons step lib)))
