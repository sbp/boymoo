(in-package "BOYMOO-PROVER")
(set-verify-guards-eagerness 0)

(defconst *b1-bits-evenp* (proof-cl "EVENP"))
(defconst *b1-bits-two* (proof-quote 2))

(defun b1-bits-low-bit (n)
  (proof-ite (list *b1-bits-evenp* n) *proof-zero* *proof-one*))

(defun b1-bits-join-bits (q bit)
  (library-plus (b1-arithmetic-product *b1-bits-two* q) bit))

(defun b1-bits-even-equation (lib n)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((step (proof-proof-unfold proof (list *b1-bits-evenp* n)))
         (reciprocal (b1-logic-bookproof-constant lib (b1-arithmetic-reciprocal *b1-bits-two*)))
         (step (proof-proof-rewrite proof step reciprocal '(1 2 1 2)))
         (commute (library-library-axiom lib "COMMUTATIVITY-OF-*" (list n *b1-parity-half*))))
      (proof-proof-rewrite proof step commute '(1 2 1)))))

(defund b1-bits-half-interval-canonical (step lib commute)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((reciprocal (b1-logic-bookproof-constant lib (b1-arithmetic-reciprocal *b1-bits-two*)))
         (first (proof-proof-rewrite-first proof step reciprocal)))
      (proof-proof-rewrite-first proof first commute))))

(defun b1-bits-half-interval-canonical-bounds (bounds lib commute)
  (if (endp bounds)
      nil
    (proof-with-checked-results
        ((first (b1-bits-half-interval-canonical (car bounds) lib commute))
         (rest (b1-bits-half-interval-canonical-bounds (cdr bounds) lib commute)))
      (cons first rest))))

(defun b1-bits-half-interval (lib integral)
  (proof-with-checked-results
      ((first (proof-step-first integral))
       (n (proof-term-at first 1))
       (raw (b1-arithmetic-product n (b1-arithmetic-reciprocal *b1-bits-two*)))
       (rational (b1-arithmetic-known-type lib *library-rationalp* raw (list integral)))
       (facts (b1-floor-interval lib (list *b1-quotient-floor* n *b1-bits-two*) rational))
       (lib (cdr facts))
       (commute (library-library-axiom lib "COMMUTATIVITY-OF-*" (list n *b1-parity-half*)))
       (bounds (b1-bits-half-interval-canonical-bounds (car facts) lib commute))
       (rational (b1-bits-half-interval-canonical rational lib commute)))
    (cons (list bounds rational) lib)))

; The bound proofs use the inherited simplifier with the book's constant rule.
(mutual-recursion
 (defun b1-bits-simplify (n lib term definitions)
   (declare (xargs :measure (nfix n)))
   (let ((proof (library-library-proof lib))
         (head (car term)))
     (cond ((zp n) '(:failure "fuel" "b1-bits-simplify"))
           ((or (not (proof-compound term)) (equal head *proof-quote*)) nil)
           ((endp term) '(:failure "failure" ""))
           ((or (proof-compound head) (member-equal head definitions))
            (proof-with-checked-results
                ((expansion (proof-simplify-expansion proof term))
                 (next (b1-bits-simplify (1- n) lib (cadr expansion) definitions)))
              (proof-proof-chain proof (car expansion) (list next))))
           ((equal head *proof-if*)
            (proof-with-checked-results
                ((test (proof-term-at term 1))
                 (first (b1-bits-simplify (1- n) lib test definitions))
                 (path (proof-simplify-if-path proof term first nil)))
              (if (eq (car path) :simplify)
                  (proof-with-checked-results
                      ((next (b1-bits-simplify (1- n) lib (caddr path) definitions)))
                    (proof-proof-chain proof (cadr path) (list next)))
                path)))
           (t (proof-with-checked-results
                  ((result (b1-bits-simplify-arguments (1- n) lib term (cdr term) 1 nil definitions))
                   (current (if result (proof-rewritten-term result) term))
                   (constant (b1-logic-bookproof-constant lib current)))
                (cond ((not constant) result)
                      (result (proof-proof-chain proof result (list constant)))
                      (t constant)))))))
 (defun b1-bits-simplify-arguments (n lib term args index result definitions)
   (declare (xargs :measure (nfix n)))
   (cond ((zp n) '(:failure "fuel" "b1-bits-simplify-arguments"))
         ((endp args) result)
         (t (proof-with-checked-results
                ((equality (b1-bits-simplify (1- n) lib (car args) definitions))
                 (next (proof-simplify-argument-result
                        (library-library-proof lib) term index result equality)))
              (b1-bits-simplify-arguments (1- n) lib term (cdr args) (1+ index) next definitions))))))

(defund b1-bits-bound-equality (lib term definitions)
  (b1-bits-simplify 1000000 lib term definitions))

(defun b1-bits-prove-bound (n lib term definitions)
  (declare (xargs :measure (nfix n)))
  (let ((proof (library-library-proof lib)))
    (cond ((zp n) '(:failure "fuel" "b1-bits-prove-bound"))
          ((equal term *proof-true*) (proof-proof-prove proof term nil definitions))
          (t (proof-with-checked-results
                 ((equality (b1-bits-bound-equality lib term definitions))
                  (right (and equality (proof-rewritten-term equality))))
               (cond ((or (not equality) (equal right term)) (proof-prove-unproved-term term))
                     ((equal right *proof-true*) (proof-proof-true-from-eq proof equality))
                     (t (proof-with-checked-results
                            ((step (b1-bits-prove-bound (1- n) lib right definitions)))
                          (proof-proof-transport proof step equality)))))))))

(defun b1-bits-displaced-floor (lib bounds rational integral displacement amount)
  (proof-with-checked-results
      ((displacement-first (proof-step-first displacement))
       (displaced (proof-list-of-length (cdr displacement-first) 2))
       (shifted (cadr displaced))
       (integral-first (proof-step-first integral))
       (p (proof-term-at integral-first 1)))
    (if (not (equal shifted (library-plus p amount)))
        '(:failure "failure" "")
      (proof-with-checked-results
          ((sums (b1-arithmetic-number-sums-init lib))
           (lib (b1-arithmetic-number-sums-library sums))
           (proof (library-library-proof lib))
           (number-p (b1-arithmetic-known-type lib *library-numberp* p (list integral)))
           (lower-change (b1-arithmetic-number-sums-comparison-equation
                          sums (library-lt shifted p) (library-lt amount *proof-zero*) (list number-p)))
           (upper-change (b1-arithmetic-number-sums-comparison-equation
                          sums (library-lt shifted (library-plus *proof-one* p))
                          (library-lt amount *proof-one*) (list number-p)))
           (lower (b1-bits-prove-bound 1000000 lib (proof-neg (library-lt amount *proof-zero*))
                                       (list *proof-not*)))
           (symmetric (proof-proof-symmetric proof lower-change))
           (lower (proof-proof-rewrite proof lower symmetric '(1 1)))
           (lower (proof-proof-tidy proof lower))
           (symmetric (proof-proof-symmetric proof displacement))
           (lower (proof-proof-rewrite proof lower symmetric '(1 1 1)))
           (upper (b1-bits-prove-bound 1000000 lib (library-lt amount *proof-one*) nil))
           (upper (proof-proof-transport proof upper upper-change))
           (symmetric (proof-proof-symmetric proof displacement))
           (upper (proof-proof-rewrite proof upper symmetric '(1 1))))
        (b1-floor-equal-intervals lib bounds (list integral lower upper) rational)))))

(defun b1-bits-double-half (lib n numeric)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((associated (library-library-axiom lib "ASSOCIATIVITY-OF-*"
                                             (list *b1-bits-two* *b1-parity-half* n)))
         (start (proof-proof-symmetric proof associated))
         (constant (b1-logic-bookproof-constant lib (b1-arithmetic-product *b1-bits-two* *b1-parity-half*)))
         (start (proof-proof-rewrite proof start constant '(1 2 1)))
         (identity (b1-arithmetic-multiply-one lib n (list numeric) t)))
      (proof-proof-chain proof start (list identity)))))

(defun b1-bits-decomposition-component (floor-eq bit-case half-eq advance lib expression bits)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((opened (proof-proof-reflexive proof expression))
         (opened (proof-proof-rewrite proof opened floor-eq '(1 2 1 2)))
         (bit-eq (proof-proof-select proof bits bit-case))
         (opened (proof-proof-rewrite proof opened bit-eq '(1 2 2)))
         (opened (proof-proof-rewrite proof opened half-eq '(1 2 1)))
         (opened (proof-proof-chain proof opened (list advance))))
      (proof-proof-symmetric proof opened))))

(defun b1-bits-decomposition-lemma (lib)
  (let ((n *library-x*)
        (proof (library-library-proof lib)))
    (proof-with-checked-results
        ((int-n (proof-proof-assume proof (library-integer n) t))
         (number (b1-arithmetic-known-type lib *library-numberp* n (list int-n)))
         (floor (list *b1-quotient-floor* n *b1-bits-two*))
         (bits (b1-bits-low-bit n))
         (expression (b1-bits-join-bits floor bits))
         (interval (b1-bits-half-interval lib int-n))
         (bounds (caar interval))
         (rational (cadar interval))
         (lib (cdr interval))
         (proof (library-library-proof lib))
         (test (cadr bits))
         (even (proof-proof-assume proof test t))
         (even-eq (b1-bits-even-equation lib n))
         (integral-half (proof-proof-rewrite proof even even-eq '(1)))
         (half-number (b1-arithmetic-known-type lib *library-numberp* (b1-parity-half n) nil))
         (sums (b1-arithmetic-number-sums-init lib))
         (lib (b1-arithmetic-number-sums-library sums))
         (proof (library-library-proof lib))
         (displaced (b1-arithmetic-number-sums-cite sums "ADD-ZERO-RIGHT"
                                                   (list (b1-parity-half n)) (list half-number)))
         (displaced (proof-proof-symmetric proof displaced))
         (at-even (b1-bits-displaced-floor lib bounds rational integral-half displaced *proof-zero*))
         (lib (cdr at-even))
         (proof (library-library-proof lib))
         (odd (proof-proof-assume proof test nil))
         (even-eq (b1-bits-even-equation lib n))
         (odd (proof-proof-rewrite proof odd even-eq '(1 1)))
         (either (b1-parity-half-or-previous lib n int-n))
         (lib (cdr either))
         (proof (library-library-proof lib))
         (integral-before (proof-proof-prove-if proof (car either) odd))
         (before (library-plus n *proof-neg-one*))
         (half-after (b1-parity-adjacent-half-equation lib n before int-n))
         (at-odd (b1-bits-displaced-floor lib bounds rational integral-before half-after *b1-parity-half*))
         (lib (cdr at-odd))
         (proof (library-library-proof lib))
         (bit-case (proof-proof-assume proof test t))
         (half-eq (b1-bits-double-half lib n number))
         (sums (b1-arithmetic-number-sums-init lib))
         (lib (b1-arithmetic-number-sums-library sums))
         (proof (library-library-proof lib))
         (advance (b1-arithmetic-number-sums-cite sums "ADD-ZERO-RIGHT" (list n) (list number)))
         (yes (b1-bits-decomposition-component (car at-even) bit-case half-eq advance lib expression bits))
         (bit-case (proof-proof-assume proof test nil))
         (numeric-before (b1-arithmetic-known-type lib *library-numberp* before nil))
         (half-eq (b1-bits-double-half lib before numeric-before))
         (advance (library-library-linear-equal lib (library-plus before *proof-one*) n (list int-n)))
         (no (b1-bits-decomposition-component (car at-odd) bit-case half-eq advance lib expression bits))
         (step (proof-proof-cases proof test yes no)))
      (library-library-lemma lib "INTEGER-BIT-DECOMPOSITION" (proof-eq n expression) step
                             (list (proof-neg (library-integer n)))))))

(defun b1-bits-decomposition (lib integral)
  (let* ((name (proof-sym "SELF-INTEGER-BIT-DECOMPOSITION" "ACL2"))
         (proof (library-library-proof lib)))
    (proof-with-checked-results
        ((lib (if (assoc-equal name (proof-proof-facts proof)) lib (b1-bits-decomposition-lemma lib)))
         (proof (library-library-proof lib))
         (first (proof-step-first integral))
         (term (proof-term-at first 1))
         (step (proof-proof-use proof name (list (list *library-x* term)) (list integral))))
      (cons step lib))))

(defun b1-bits-bit-pair-zero (lib q number-q displacement integral half-n)
  (proof-with-checked-results
      ((sums (b1-arithmetic-number-sums-init lib))
       (lib (b1-arithmetic-number-sums-library sums))
       (proof (library-library-proof lib))
       (remove-zero (b1-arithmetic-number-sums-cite sums "ADD-ZERO-RIGHT" (list q) (list number-q)))
       (half-exact (proof-proof-chain proof displacement (list remove-zero)))
       (int-half (library-library-transport-argument lib integral half-exact 1))
       (bool-half (proof-proof-fact proof "booleanp-integerp" (list (list *library-x* half-n))))
       (step (b1-logic-bookproof-boolean-value lib int-half bool-half)))
    (cons step lib)))

(defun b1-bits-bit-pair-nonzero (lib q number-q displacement integral half-n)
  (let ((proof (library-library-proof lib))
        (test (library-integer half-n)))
    (proof-with-checked-results
        ((assumes-int (proof-proof-assume proof test t))
         (integer-sum (proof-proof-rewrite proof assumes-int displacement '(1 1)))
         (integer-first (proof-step-first integer-sum))
         (sum (proof-term-at integer-first 1))
         (gap (library-diff sum q))
         (int-gap (library-library-type-of lib gap (list integer-sum integral)))
         (sums (b1-arithmetic-number-sums-init lib))
         (lib (b1-arithmetic-number-sums-library sums))
         (proof (library-library-proof lib))
         (change (b1-arithmetic-number-sums-linear-equal sums gap *b1-parity-half* (list number-q)))
         (impossible (proof-proof-rewrite proof int-gap change '(1 1)))
         (impossible (proof-proof-simplify-first proof impossible nil nil))
         (impossible (proof-proof-tidy proof impossible))
         (assumed-first (proof-step-first assumes-int))
         (odd (proof-proof-front proof impossible (proof-neg assumed-first)))
         (step (b1-logic-bookproof-false-value lib odd)))
      (cons step lib))))

(defun b1-bits-bit-pair (lib integral bit)
  (proof-with-checked-results
      ((first (proof-step-first integral))
       (q (proof-term-at first 1))
       (n (b1-bits-join-bits q bit))
       (int-n (library-library-type-of lib n (list integral)))
       (interval (b1-bits-half-interval lib int-n))
       (bounds (caar interval))
       (rational (cadar interval))
       (lib (cdr interval))
       (proof (library-library-proof lib))
       (number-q (b1-arithmetic-known-type lib *library-numberp* q (list integral)))
       (displacement (library-library-axiom lib "DISTRIBUTIVITY"
                                            (list *b1-parity-half* (b1-arithmetic-product *b1-bits-two* q) bit)))
       (associated (library-library-axiom lib "ASSOCIATIVITY-OF-*" (list *b1-parity-half* *b1-bits-two* q)))
       (scaled (proof-proof-symmetric proof associated))
       (constant (b1-logic-bookproof-constant lib (b1-arithmetic-product *b1-parity-half* *b1-bits-two*)))
       (scaled (proof-proof-rewrite proof scaled constant '(1 2 1)))
       (identity (b1-arithmetic-multiply-one lib q (list number-q) t))
       (scaled (proof-proof-chain proof scaled (list identity)))
       (displacement (proof-proof-rewrite proof displacement scaled '(1 2 1)))
       (constant (b1-logic-bookproof-constant lib (b1-arithmetic-product *b1-parity-half* bit)))
       (displacement (proof-proof-rewrite proof displacement constant '(1 2 2)))
       (constant-first (proof-step-first constant))
       (amount (proof-term-at constant-first 2))
       (floor (b1-bits-displaced-floor lib bounds rational integral displacement amount))
       (lib (cdr floor))
       (half-n (b1-parity-half n))
       (equation (if (equal bit *proof-zero*)
                     (b1-bits-bit-pair-zero lib q number-q displacement integral half-n)
                   (b1-bits-bit-pair-nonzero lib q number-q displacement integral half-n)))
       (lib (cdr equation))
       (proof (library-library-proof lib))
       (even-equation (b1-bits-even-equation lib n))
       (even (proof-proof-chain proof even-equation (list (car equation)))))
    (cons (list (car floor) even) lib)))

(defun b1-bits-constant-bit-pair (lib high low)
  (let ((n (b1-bits-join-bits high low)))
    (proof-with-checked-results
        ((integral (library-library-type-of lib high nil))
         (pair (b1-bits-bit-pair lib integral low))
         (lib (cdr pair))
         (proof (library-library-proof lib))
         (normalized (b1-logic-bookproof-normalize lib n nil nil nil nil nil nil))
         (floor (proof-proof-rewrite-first proof (caar pair) normalized))
         (even (proof-proof-rewrite-first proof (cadar pair) normalized)))
      (cons (list floor even) lib))))
