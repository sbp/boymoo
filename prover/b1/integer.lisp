(in-package "BOYMOO-PROVER")

(set-verify-guards-eagerness 0)

(defconst *b1-integer-nfix* (proof-sym "NFIX" "ACL2"))

(defun b1-integer-step-at (step index)
  (proof-with-checked-results ((first (proof-step-first step)))
    (proof-term-at first index)))

(defun b1-integer-open-unit-interval-consequence (premise library conclusion)
  (let ((proof (library-library-proof library)))
    (proof-with-checked-results
     ((parts (b1-logic-bookproof-split-conjuncts library premise))
      (bounds (proof-list-of-length parts 2))
      (test (proof-term-at conclusion 1))
      (integral (proof-proof-assume proof test t))
      (outside (b1-arithmetic-integer-discrete library (car bounds) integral))
      (step (proof-proof-cut proof (cadr bounds) outside)))
     (proof-proof-front proof step conclusion))))

(defun b1-integer-open-unit-interval (library formula)
  (proof-with-checked-results
   ((conclusion (proof-term-at formula 2))
    (premise (b1-logic-bookproof-prove-implication-premise library formula))
    (step (b1-integer-open-unit-interval-consequence premise library conclusion)))
   (b1-logic-bookproof-prove-implication-with-premise library formula premise step)))

(defun b1-integer-nfix-equation (library argument)
  (let ((proof (library-library-proof library))
        (original (list *b1-integer-nfix* argument))
        (local (list *library-nfix* argument)))
    (proof-with-checked-results
     ((original-definition (proof-proof-unfold proof original))
      (test (proof-proof-unfold proof (list *library-natp* argument)))
      (test (proof-proof-symmetric proof test))
      (original-definition (proof-proof-rewrite proof original-definition test '(1 2 1)))
      (local-definition (proof-proof-unfold proof local))
      (local-definition (proof-proof-symmetric proof local-definition)))
     (proof-proof-chain proof original-definition (list local-definition)))))

(defun b1-integer-nfix-natural (library term)
  (proof-with-checked-results
   ((natural (library-library-cite library "NFIX-NATURAL" (cdr term) nil))
    (argument (proof-term-at term 1))
    (equality (b1-integer-nfix-equation library argument)))
   (library-library-transport-argument library natural equality 1)))

(defun b1-integer-nfix-identity (library natural)
  (let ((proof (library-library-proof library)))
    (proof-with-checked-results
     ((literal (proof-step-first natural))
      (pair (proof-list-of-length literal 2))
      (term (cadr pair))
      (local (proof-proof-unfold proof (list *library-nfix* term)))
      (original (b1-integer-nfix-equation library term))
      (body (b1-integer-step-at local 2))
      (selected (proof-proof-select proof body natural)))
     (proof-proof-chain proof original (list local selected)))))

(defun b1-integer-no-zp (library term negative integer)
  (let ((proof (library-library-proof library))
        (goal (library-positive term)))
    (proof-with-checked-results
     ((nonpositive (proof-proof-assume proof goal nil))
      (is-zp (b1-logic-bookproof-normalize-proof
               library (list *b1-logic-zp* term) (list integer nonpositive)
               (list *b1-logic-zp* *proof-not*) nil nil))
      (step (proof-proof-cut proof is-zp negative)))
     (proof-proof-front proof step goal))))

(defun b1-integer-clipped-ordinal (library measure)
  (proof-with-checked-results
   ((ordinal (library-library-cite library "NFIX-ORDINAL" (cdr measure) nil))
    (argument (proof-term-at measure 1))
    (equality (b1-integer-nfix-equation library argument)))
   (library-library-transport-argument library ordinal equality 1)))

(defun b1-integer-first-false-test (tests)
  (if (endp tests)
      '(:failure "failure" "")
    (proof-with-checked-results ((test (proof-list-of-length (car tests) 2)))
      (if (cadr test)
          (b1-integer-first-false-test (cdr tests))
        (car test)))))

(defun b1-integer-clipped-advance-target (library comparison bound index target reduce-next position)
  (let ((proof (library-library-proof library))
        (canonical (list *library-gap* bound index)))
    (proof-with-checked-results
     ((normalized (b1-logic-bookproof-normalize library target nil nil
                                                (list (b1-logic-equal-to reduce-next)) nil nil nil))
      (nfix (b1-integer-nfix-equation library (library-diff bound index)))
      (gap (proof-proof-unfold proof canonical))
      (gap (proof-proof-symmetric proof gap))
      (to-gap (proof-proof-chain proof normalized (list nfix gap))))
     (library-library-transport-argument library comparison to-gap position))))

(defun b1-integer-clipped-advance (library goal hypotheses)
  (let ((proof (library-library-proof library)))
    (proof-with-checked-results
     ((parts (proof-list-of-length goal 3))
      (small (cadr parts))
      (large (caddr parts))
      (difference (proof-term-at large 1))
      (operands (proof-list-of-length difference 3))
      (bound (cadr operands))
      (index (proof-term-at (caddr operands) 1))
      (before (library-diff bound index)))
     (if (not (equal large (list *b1-integer-nfix* before)))
         '(:failure "RuleInapplicable" "")
       (proof-with-checked-results
        ((nat-bound (b1-integer-nfix-natural library bound))
         (nat-index (b1-integer-nfix-natural library index))
         (term (b1-integer-step-at nat-bound 1))
         (int-bound (library-library-cite library "NATURAL-INTEGER" (list term) (list nat-bound)))
         (term (b1-integer-step-at nat-index 1))
         (int-index (library-library-cite library "NATURAL-INTEGER" (list term) (list nat-index)))
         (integers (list int-bound int-index))
         (test (b1-integer-first-false-test (descent-hypotheses-tests hypotheses)))
         (unwrapped (b1-logic-bookproof-normalize library test nil nil nil nil nil nil))
         (negative (proof-proof-assume proof test nil))
         (negative (proof-proof-rewrite proof negative unwrapped '(1 1)))
         (negative (proof-proof-tidy proof negative))
         (gap-int (library-library-type-of library before integers))
         (positive-gap (b1-integer-no-zp library before negative gap-int))
         (order (library-library-comparison library index bound integers))
         (inside (proof-proof-transport proof positive-gap order))
         (advance (library-library-cite library "SUCCESSOR-LARGER" (list index) (list int-index)))
         (next-index (library-plus *proof-one* index))
         (one-natural (library-library-natural library *proof-one*))
         (next-natural (library-library-cite library "NATURAL-SUM" (list *proof-one* index)
                                             (list one-natural nat-index)))
         (reduce-next (b1-integer-nfix-identity library next-natural))
         (next-int (library-library-type-of library next-index integers))
         (comparison (library-library-cite library "GAP-DECREASE" (list bound index next-index)
                                           (list int-bound int-index next-int inside advance)))
         (comparison (b1-integer-clipped-advance-target library comparison bound next-index small
                                                        reduce-next 1)))
        (b1-integer-clipped-advance-target library comparison bound index large reduce-next 2))))))

(defun b1-integer-successor-is-larger (library x)
  (let* ((proof (library-library-proof library))
         (successor (library-plus *proof-one* x))
         (neg-successor (library-minus successor))
         (difference (library-plus x neg-successor))
         (fix (proof-sym "FIX" "ACL2")))
    (proof-with-checked-results
     ((add-zero (library-library-axiom library "UNICITY-OF-0" (list difference)))
      (numeric (library-library-cite library "SUM-NUMBER" (cdr difference) nil))
      (normalized (b1-logic-bookproof-normalize library (list fix difference) (list numeric)
                                               (list fix) nil nil nil nil))
      (add-zero (proof-proof-chain proof add-zero (list normalized)))
      (step (proof-proof-symmetric proof add-zero))
      (zero (b1-logic-bookproof-constant library (library-plus *proof-neg-one* *proof-one*)))
      (zero (proof-proof-symmetric proof zero))
      (step (proof-proof-rewrite proof step zero '(1 2 1)))
      (associate (library-library-axiom library "ASSOCIATIVITY-OF-+"
                                        (list *proof-neg-one* *proof-one* difference)))
      (step (proof-proof-chain proof step (list associate)))
      (associate (library-library-axiom library "ASSOCIATIVITY-OF-+"
                                        (list *proof-one* x neg-successor)))
      (associate (proof-proof-symmetric proof associate))
      (step (proof-proof-rewrite proof step associate '(1 2 2)))
      (inverse (library-library-axiom library "INVERSE-OF-+" (list successor)))
      (step (proof-proof-rewrite proof step inverse '(1 2 2)))
      (neg-one (b1-logic-bookproof-constant library (library-plus *proof-neg-one* *proof-zero*)))
      (step (proof-proof-chain proof step (list neg-one)))
      (compare (library-library-axiom library "<-ON-OTHERS" (list x successor)))
      (compare (proof-proof-rewrite proof compare step '(1 2 1)))
      (less (proof-proof-prove proof (library-lt *proof-neg-one* *proof-zero*) nil nil)))
     (proof-proof-transport proof less compare))))
