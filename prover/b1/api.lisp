(defun b1-api-acl2-import-map (imports result)
  (if (endp imports)
      result
    (b1-api-acl2-import-map (cdr imports)
                           (table-put result (caddar imports) (car imports)))))

(defun b1-api-acl2-imports-in (packages)
  (cond ((endp packages) '(:failure "failure" ""))
        ((equal (caar packages) '("str" "ACL2"))
         (b1-api-acl2-import-map (cadar packages) nil))
        (t (b1-api-acl2-imports-in (cdr packages)))))

(defconst *b1-api-acl2-imports*
  (b1-api-acl2-imports-in *b1-api-ground-package-data*))

(defun b1-api-acl2-imports ()
  *b1-api-acl2-imports*)

(defun b1-api-package-fact (data)
  (proof-with-checked-results ((fields (proof-list-of-length data 2))
                               (package (proof-term-at (car fields) 1)))
    (if (not (stringp package))
        '(:failure "failure" "")
      (proof-with-checked-results ((table (b1-api-acl2-imports)))
        (let* ((label (concatenate 'string package "-PACKAGE"))
               (name (table-get table label (proof-sym label "ACL2")))
               (imports (cadr fields))
               (term (proof-eq (list (proof-sym "PKG-IMPORTS" "ACL2")
                                     (proof-quote (car fields)))
                               (proof-quote imports))))
          (list name term))))))

(defun b1-api-set-add (item seen)
  (if (member-equal item seen) seen (cons item seen)))

(defun b1-api-set-update (items seen)
  (if (endp items)
      seen
    (b1-api-set-update (cdr items) (b1-api-set-add (car items) seen))))

(defun b1-api-callproof-fork (world)
  world)

(defconst *b1-api-acl2-token* (coerce "ACL2::" 'list))
(defconst *b1-api-self-marker* (coerce "SELF-" 'list))
(defconst *b1-api-slice-marker* (coerce "B1-" 'list))
(defconst *b1-api-quote-start* (coerce "(COMMON-LISP::QUOTE " 'list))
(defconst *b1-api-plain-name-characters*
  (coerce "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789+*/<=>!?$%&_^~.@-" 'list))

(defun b1-api-escaped-token (chars delimiter width)
  (cond ((endp chars) nil)
        ((eql (car chars) delimiter) (cons (1+ width) (cdr chars)))
        (t (b1-api-escaped-token (cdr chars) delimiter (1+ width)))))

(defun b1-api-plain-token (chars width)
  (if (and (consp chars) (member-equal (car chars) *b1-api-plain-name-characters*))
      (b1-api-plain-token (cdr chars) (1+ width))
    (cons width chars)))

(defun b1-api-marker-width (chars)
  (cond ((reader-prefix-p *b1-api-self-marker* chars) 5)
        ((reader-prefix-p *b1-api-slice-marker* chars) 3)
        (t nil)))

(defun b1-api-local-token (chars)
  (if (reader-prefix-p *b1-api-acl2-token* chars)
    (let* ((part (nthcdr 6 chars))
           (escaped (eql (car part) #\|))
           (label (if escaped (cdr part) part))
           (marker (b1-api-marker-width label)))
      (if marker
        (let ((body (nthcdr marker label)))
          (if escaped
              (b1-api-escaped-token body #\| (+ 7 marker))
            (if (member-equal (car body) *b1-api-plain-name-characters*)
                (b1-api-plain-token body (+ 6 marker))
              nil)))
        nil))
    nil))

(defun b1-api-quote-body (chars)
  (if (reader-prefix-p *b1-api-quote-start* chars)
    (let* ((body (nthcdr (len *b1-api-quote-start*) chars))
           (part (nthcdr 6 body)))
      (if (or (eql (car body) #\()
              (and (reader-prefix-p *b1-api-acl2-token* body)
                   (b1-api-marker-width (if (eql (car part) #\|) (cdr part) part))))
          body
        nil))
    nil))

(defun b1-api-skip-quote (n chars position depth)
  (declare (xargs :measure (nfix n)))
  (cond
   ((zp n) '(:failure "fuel" "b1-api-skip-quote"))
   ((endp chars) '(:failure "failure" ""))
   (t
    (let* ((ch (car chars))
           (escaped (and (member-equal ch '(#\" #\|))
                         (b1-api-escaped-token (cdr chars) ch 1))))
      (cond (escaped (b1-api-skip-quote (1- n) (cdr escaped) (+ position (car escaped)) depth))
            ((and (eql ch #\)) (= depth 1)) (cons (1+ position) (cdr chars)))
            (t (b1-api-skip-quote (1- n) (cdr chars) (1+ position)
                                 (cond ((eql ch #\() (1+ depth))
                                       ((eql ch #\)) (1- depth))
                                       (t depth)))))))))

(defun b1-api-name-tokens (n source chars position previous reversed)
  (declare (xargs :measure (nfix n)))
  (cond
   ((zp n) '(:failure "fuel" "b1-api-name-tokens"))
   ((endp chars) (reverse reversed))
   (t
    (let* ((ch (car chars))
           (quote-body (and (eql ch #\() (b1-api-quote-body chars)))
           (token (and (eql ch #\A) (b1-api-local-token chars)))
           (escaped (and (member-equal ch '(#\" #\|))
                         (b1-api-escaped-token (cdr chars) ch 1))))
      (cond
       (quote-body
        (proof-with-checked-results
         ((after (b1-api-skip-quote 1000000 quote-body (+ position (len *b1-api-quote-start*)) 1)))
         (b1-api-name-tokens (1- n) source (cdr after) (car after) #\) reversed)))
       (token
        (let* ((end (+ position (car token)))
               (reversed (if (or (zp position) (member-equal previous '(#\( #\Space)))
                             (cons (list (subseq source position end) position end) reversed)
                           reversed)))
          (b1-api-name-tokens (1- n) source (cdr token) end nil reversed)))
       (escaped
        (b1-api-name-tokens (1- n) source (cdr escaped) (+ position (car escaped)) ch reversed))
       (t (b1-api-name-tokens (1- n) source (cdr chars) (1+ position) ch reversed)))))))

(defun b1-api-names-in (source)
  (b1-api-name-tokens 1000000 source (coerce source 'list) 0 nil nil))

(defun b1-api-reference-tokens (matches names reversed)
  (if (endp matches)
      (reverse reversed)
    (let ((name (caar matches)))
      (b1-api-reference-tokens (cdr matches) names
                               (if (member-equal name names) (b1-api-set-add name reversed) reversed)))))

(defun b1-api-references (source names)
  (proof-with-checked-results ((matches (b1-api-names-in source)))
    (b1-api-reference-tokens matches names nil)))

(defun b1-api-rename-tokens (matches source names position reversed)
  (if (endp matches)
      (if reversed (text-join "" (reverse (cons (subseq source position nil) reversed))) source)
    (let* ((match (car matches))
           (replacement (table-get names (car match) nil)))
      (if replacement
          (b1-api-rename-tokens (cdr matches) source names (caddr match)
                                (list* replacement (subseq source position (cadr match)) reversed))
        (b1-api-rename-tokens (cdr matches) source names position reversed)))))

(defun b1-api-rename (source names)
  (if (endp names)
      source
    (proof-with-checked-results ((matches (b1-api-names-in source)))
      (b1-api-rename-tokens matches source names 0 nil))))

(defun b1-api-entry-names (entries names)
  (if (endp entries)
      names
    (proof-with-checked-results ((name (proof-write (cadar entries))))
      (b1-api-entry-names (cdr entries) (b1-api-set-add name names)))))

(defun b1-api-select-entries (entries names needed occupied selected)
  (if (endp entries)
      (if needed '(:failure "failure" "") selected)
    (let* ((entry (car entries))
           (name (cadr entry))
           (source (cadddr entry)))
      (proof-with-checked-results ((raw (proof-write name)))
        (cond
         ((not (member-equal raw needed))
          (b1-api-select-entries (cdr entries) names needed occupied selected))
         ((member-equal name occupied)
          '(:failure "failure" ""))
         (t
          (proof-with-checked-results ((dependencies (b1-api-references source names)))
            (b1-api-select-entries
             (cdr entries) names
             (b1-api-set-update (remove-equal raw dependencies) (remove-equal raw needed))
             occupied (cons (list name raw source) selected)))))))))

(defun b1-api-label-characters (chars)
  (if (endp chars)
      nil
    (let* ((ch (car chars))
           (code (char-code ch)))
      (cons (if (or (and (<= 65 code) (<= code 90))
                    (and (<= 48 code) (<= code 57))
                    (= code 45))
                ch
              #\-)
            (b1-api-label-characters (cdr chars))))))

(defun b1-api-certificate-label (name)
  (let* ((plain (coerce (b1-api-label-characters (coerce name 'list)) 'string))
         (without-self (if (text-starts-with plain "SELF-") (subseq plain 5 nil) plain)))
    (if (text-starts-with without-self "B1-") (subseq without-self 3 nil) without-self)))

(defun b1-api-ascii-text (text)
  (if (b1-logic-ascii-characters-p (coerce text 'list))
      text
    '(:failure "failure" "")))

(defun b1-api-private-entries (selected source occupied renames reversed)
  (if (endp selected)
      (proof-with-checked-results ((renamed (b1-api-rename source renames))
                                   (entry (b1-api-ascii-text renamed)))
        (list (reverse reversed) entry))
    (let* ((item (car selected))
           (name (car item))
           (raw (cadr item)))
      (proof-with-checked-results ((canonical (b1-api-rename (caddr item) renames)))
        (let* ((digest (text-upper (siphash-hexdigest canonical)))
               (label (b1-api-certificate-label (caddr name)))
               (private (proof-sym (concatenate 'string "PROVER-" *b1-api-prefix* "-" label "-" digest)
                                   (cadr name))))
          (if (member-equal private occupied)
              '(:failure "failure" "")
            (proof-with-checked-results ((spelling (proof-write private))
                                         (renamed (b1-api-rename canonical (list (cons raw spelling))))
                                         (text (b1-api-ascii-text renamed)))
              (b1-api-private-entries (cdr selected) source occupied
                                      (table-put renames raw spelling) (cons text reversed)))))))))

(defun b1-api-certificate (entries source occupied)
  (proof-with-checked-results ((names (b1-api-entry-names entries nil))
                               (needed (b1-api-references source names))
                               (selected (b1-api-select-entries (reverse entries) names needed occupied nil)))
    (b1-api-private-entries selected source occupied nil nil)))

(defun b1-api-theorem-clause-p (clause formula)
  (or (endp clause) (and (equal (car clause) formula) (b1-api-theorem-clause-p (cdr clause) formula))))

(defun b1-api-theorem-entry (world name formula proof)
  (if (and proof (b1-api-theorem-clause-p (proof-step-clause proof) formula))
      (proof-with-checked-results
       ((discharged (proof-proof-subsume (library-library-proof world) proof (list formula)))
        (entry (proof-proof-entry "theorem" name (list name) (list discharged))))
       (cadddr entry))
    '(:failure "failure" "")))

(defun b1-api-world-add-fact (world name formula)
  (let* ((proof (library-library-proof world))
         (facts (table-put (proof-proof-facts proof) name (list formula))))
    (library-library-with-proof world (proof-proof-with-facts proof facts))))

(defun b1-api-ground-packages (packages world)
  (cond ((endp packages) world)
        ((equal (caar packages) '("str" "COMMON-LISP"))
         (b1-api-ground-packages (cdr packages) world))
        (t (proof-with-checked-results ((fact (b1-api-package-fact (car packages))))
             (b1-api-ground-packages (cdr packages)
                                     (b1-api-world-add-fact world (car fact) (cadr fact)))))))

(defun b1-api-ground-world ()
  (proof-with-checked-results ((world (library-library-build (library-library-init (proof-proof-init)))))
    (b1-api-ground-packages *b1-api-ground-package-data* world)))

(defun b1-api-unoccupied-entries (entries names)
  (if (endp entries)
      names
    (b1-api-unoccupied-entries (cdr entries) (remove-equal (cadar entries) names))))

(defun b1-api-ground-names (world)
  (let* ((proof (library-library-proof world))
         (names (b1-api-set-update (proof-proof-primitives proof)
                                   (table-keys (proof-proof-facts proof)))))
    (b1-api-unoccupied-entries (library-library-entries world) names)))

(defun b1-api-make-context (world seen formulas facts names)
  (list :b1-api-context world seen formulas facts names))

(defun b1-api-context-world (context)
  (cadr context))

(defun b1-api-context-seen (context)
  (caddr context))

(defun b1-api-context-formulas (context)
  (cadddr context))

(defun b1-api-context-facts (context)
  (nth 4 context))

(defun b1-api-context-names (context)
  (nth 5 context))

(defun b1-api-context-init (world seen formulas facts names)
  (proof-with-checked-results ((index (if (eq facts :none) (b1-search-fact-index-init world) facts)))
    (b1-api-make-context world seen formulas index names)))

(defun b1-api-ground ()
  (proof-with-checked-results ((world (b1-api-ground-world)))
    (b1-api-context-init world nil nil :none (b1-api-ground-names world))))

(defun b1-api-declared-names (fields)
  (if (endp fields)
      nil
    (proof-with-checked-results ((name (proof-term-at (car fields) 0))
                                 (rest (b1-api-declared-names (cdr fields))))
      (cons name rest))))

(defun b1-api-constraint-additions (clauses additions)
  (if (endp clauses)
      additions
    (let ((clause (car clauses)))
      (b1-api-constraint-additions (cdr clauses)
                                   (table-put additions (car clause) (list (cadr clause)))))))

(defun b1-api-context-add-statement (word data world formulas names additions)
  (proof-with-checked-results ((admitted (b1-generate-admit world word data formulas)))
    (let ((world (car admitted))
          (formulas (cdr admitted)))
      (cond
       ((equal word "define")
        (proof-with-checked-results ((declared (b1-api-declared-names (cdr data))))
          (list world formulas (b1-api-set-update declared names) additions)))
       ((equal word "constrain")
        (proof-with-checked-results ((declared (b1-api-declared-names (car data))))
          (let ((additions (if (equal (cadr data) *proof-nil*)
                               additions
                             (b1-api-constraint-additions (cadr data) additions))))
            (list world formulas (b1-api-set-update declared names) additions))))
       ((or (equal word "theorem") (equal word "axiom"))
        (list world formulas names (table-put additions (car data) (list (cadr data)))))
       ((equal word "reserve")
        (proof-with-checked-results ((name (proof-term-at data 0)))
          (list world formulas (b1-api-set-add name names) additions)))
       ((or (equal word "package") (equal word "choose"))
        (proof-with-checked-results
         ((fact (if (equal word "package") (b1-api-package-fact data) (b1-api-choice-fact data))))
         (let* ((name (car fact))
                (formula (cadr fact))
                (world (b1-api-world-add-fact world name formula))
                (additions (table-put additions name (list formula)))
                (formulas (if (assoc-equal formula formulas)
                              formulas
                            (table-put formulas formula name))))
           (list world formulas names additions))))
       (t (list world formulas names additions))))))

(defun b1-api-context-add-line (line seen result)
  (proof-with-checked-results ((raw (b1-api-raw line)))
    (if (member-equal raw seen)
        (cons seen result)
      (proof-with-checked-results
       ((fields (b1-api-parse raw))
        (updated (b1-api-context-add-statement (car fields) (cadr fields)
                                               (car result) (cadr result) (caddr result) (cadddr result))))
       (cons (cons raw seen) updated)))))

(defun b1-api-context-add-lines (lines result)
  (cond ((failure-p result) result)
        ((endp lines) result)
        (t (b1-api-context-add-lines (cdr lines)
                                     (b1-api-context-add-line (car lines) (car result) (cdr result))))))

(defun b1-api-index-additions (additions index)
  (cond ((failure-p index) index)
        ((endp additions) index)
        (t (b1-api-index-additions (cdr additions)
                                   (b1-search-fact-index-add index (caar additions) (cdar additions))))))

(defun b1-api-index-extend-table (extra prior)
  (if (endp extra)
      prior
    (let* ((key (caar extra))
           (rules (append (table-get prior key nil) (cdar extra))))
      (b1-api-index-extend-table (cdr extra) (table-put prior key rules)))))

(defun b1-api-index-extend (index additions)
  (proof-with-checked-results ((delta (b1-api-index-additions additions (b1-search-make-fact-index nil nil))))
    (b1-search-make-fact-index
     (b1-api-index-extend-table (b1-search-fact-index-claims delta) (b1-search-fact-index-claims index))
     (b1-api-index-extend-table (b1-search-fact-index-equations delta) (b1-search-fact-index-equations index)))))

(defun b1-api-context-finish (context updated)
  (proof-with-checked-results
   ((index (b1-api-index-extend (b1-api-context-facts context) (nth 4 updated))))
   (let ((names (b1-api-set-update (table-keys (nth 4 updated)) (cadddr updated))))
     (b1-api-context-init (cadr updated) (car updated) (caddr updated) index names))))

(defun b1-api-context-extend (context lines)
  (if (endp lines)
      context
    (let* ((world (b1-api-callproof-fork (b1-api-context-world context)))
           (state (list (b1-api-context-seen context) world
                        (b1-api-context-formulas context) (b1-api-context-names context) nil)))
      (proof-with-checked-results ((updated (b1-api-context-add-lines lines state)))
        (b1-api-context-finish context updated)))))

(defun b1-api-given (lines)
  (proof-with-checked-results ((ground (b1-api-ground)))
    (b1-api-context-extend ground lines)))

(defun b1-api-prefix (given lines)
  (b1-api-context-extend given lines))

(defun b1-api-context-for (library earlier)
  (if (and (or (true-listp library) (equal library ""))
           (or (true-listp earlier) (equal earlier "")))
      (proof-with-checked-results ((given (b1-api-given library)))
        (let ((boundary (* 64 (floor (len earlier) 64))))
          (proof-with-checked-results ((prefix (b1-api-prefix given (take boundary earlier))))
            (b1-api-context-extend prefix (nthcdr boundary earlier)))))
    '(:failure "failure" "")))

(defun b1-api-witness-originals (functions)
  (if (endp functions)
      nil
    (proof-with-checked-results ((function-field (proof-list-of-length (car functions) 2))
                                 (rest (b1-api-witness-originals (cdr functions))))
      (cons (car function-field) rest))))

(defun b1-api-apply-witness (recipe world originals formulas)
  (case recipe
    (b1-witnesses-identity-witness (b1-witnesses-identity-witness world originals formulas))
    (b1-witnesses-successor-witness (b1-witnesses-successor-witness world originals formulas))
    (b1-witnesses-alist-type-witness (b1-witnesses-alist-type-witness world originals formulas))
    (b1-witnesses-list-type-witness (b1-witnesses-list-type-witness world originals formulas))
    (b1-witnesses-evaluator-witness (b1-witnesses-evaluator-witness world originals formulas))
    (otherwise '(:failure "failure" ""))))

(defun b1-api-check-witness (formulas proofs substitutions)
  (if (endp formulas)
      nil
    (proof-with-checked-results
     ((fields (proof-list-of-length (car formulas) 2))
      (formula (b1-witnesses-rename-calls (cadr fields) substitutions)))
     (if (equal (proof-step-clause (car proofs)) (list formula))
         (b1-api-check-witness (cdr formulas) (cdr proofs) substitutions)
       '(:failure "failure" "")))))

(defun b1-api-witness-entry (world name data recipe index)
  (proof-with-checked-results ((fields (proof-list-of-length data 2))
                               (originals (b1-api-witness-originals (car fields))))
    (let* ((functions (car fields))
           (formulas (cadr fields)))
      (proof-with-checked-results
       ((result (if recipe
                    (b1-api-apply-witness recipe world originals formulas)
                  (b1-witnesses-small-witnesses world functions formulas index))))
       (let* ((witnesses (caar result))
              (proofs (cadar result))
              (world (cdr result)))
         (if (and (= (len witnesses) (len originals)) (= (len proofs) (len formulas)))
             (let* ((substitutions (b1-api-pair-bindings originals witnesses nil))
                    (checked (b1-api-check-witness formulas proofs substitutions)))
               (if (failure-p checked)
                   checked
                 (proof-with-checked-results
                  ((entry (proof-proof-entry "witness" name (cons name witnesses) proofs)))
                  (cons (cadddr entry) world))))
           '(:failure "failure" "")))))))

(defun b1-api-symbol-label (name)
  (proof-with-checked-results ((label (proof-term-at name 2)))
    (if (stringp label)
        (b1-api-ascii-text label)
      '(:failure "failure" ""))))

(defun b1-api-step-and-world (step world)
  (if (failure-p step) step (cons step world)))

(defun b1-api-apply-theorem (recipe world formula index)
  (cond
   ((null recipe) (b1-search-automatic world index formula))
   ((consp recipe)
    (case (car recipe)
      (:exponent-addition-goal (b1-shapes-exponent-recipe-signed world formula (cadr recipe)))
      (:natural-bit-length (b1-shapes-theorem-recipes-natural-bit-length world formula))
      (otherwise '(:failure "failure" ""))))
   (t
    (case recipe
      (b1-list-sets-appended-first-intersection
       (b1-api-step-and-world (b1-list-sets-appended-first-intersection world formula) world))
      (b1-list-sets-intersection-with-extended-second
       (b1-api-step-and-world (b1-list-sets-intersection-with-extended-second world formula) world))
      (b1-mismatch-mismatch-correct (b1-mismatch-mismatch-correct world formula))
      (b1-mismatch-mismatch-wrapped-index (b1-mismatch-mismatch-wrapped-index world formula))
      (b1-mismatch-equal-fixed-by-bits (b1-mismatch-equal-fixed-by-bits-with-index world formula index))
      (b1-modular-exact-remainder-integral
       (b1-modular-exact-remainder-integral-with-claims world formula :none
                                                       (b1-search-fact-index-logic-claims index)))
      (b1-shapes-congruence-contrapositive
       (b1-api-step-and-world (b1-shapes-congruence-contrapositive world formula) world))
      (b1-xdoc-types-tree-tag-wrapper
       (b1-api-step-and-world (b1-xdoc-types-tree-tag-wrapper world formula) world))
      (otherwise (b1-theorems-apply-recipe-id recipe world formula index))))))

(defun b1-api-theorem-attempt (recipe world name formula index)
  (let ((branch (b1-api-callproof-fork world)))
    (proof-with-checked-results ((result (b1-api-apply-theorem recipe branch formula index))
                                 (step (car result))
                                 (entry (b1-api-theorem-entry (cdr result) name formula step)))
      (list (cdr result) entry))))

(defun b1-api-theorem-attempts (result recipes world name formula index)
  (cond ((not (failure-p result)) result)
        ((endp recipes) '(:failure "failure" ""))
        (t (b1-api-theorem-attempts (b1-api-theorem-attempt (car recipes) world name formula index)
                                    (cdr recipes) world name formula index))))

(defun b1-api-solve-theorem (world context name data index)
  (proof-with-checked-results ((formula (proof-term-at data 1)))
    (let ((known (assoc-equal formula (b1-api-context-formulas context))))
      (if known
          (proof-with-checked-results ((step (proof-proof-fact (library-library-proof world) (cdr known) nil))
                                       (entry (b1-api-theorem-entry world name formula step)))
            (list world entry))
        (let ((shapes (b1-shapes-theorem-recipes-with-index world formula index)))
          (proof-with-checked-results ((label (b1-api-symbol-label name)))
            (let* ((named (table-get *b1-theorems-recipes* label nil))
                   (recipes (proof-unique (append (if (failure-p shapes) nil shapes) (list named nil))))
                   (first (b1-api-theorem-attempt (car recipes) world name formula index)))
              (b1-api-theorem-attempts first (cdr recipes) world name formula index))))))))

(defun b1-api-witness-attempt (recipe world name data index)
  (proof-with-checked-results
   ((result (b1-api-witness-entry (b1-api-callproof-fork world) name data recipe index)))
   (list (cdr result) (car result))))

(defun b1-api-witness-attempts (result recipes world name data index)
  (cond ((not (failure-p result)) result)
        ((endp recipes) '(:failure "failure" ""))
        (t (b1-api-witness-attempts (b1-api-witness-attempt (car recipes) world name data index)
                                    (cdr recipes) world name data index))))

(defun b1-api-solve-constraint (world name data index)
  (let ((shape (if (= (len data) 2) (b1-shapes-witness-recipe (car data) (cadr data)) nil)))
    (proof-with-checked-results ((label (b1-api-symbol-label name)))
      (let* ((named (table-get *b1-witnesses-witnesses* label nil))
             (recipes (proof-unique (list (if (failure-p shape) nil shape) named nil)))
             (first (b1-api-witness-attempt (car recipes) world name data index)))
        (b1-api-witness-attempts first (cdr recipes) world name data index)))))

(defun b1-api-solve (world context word data name calls measures)
  (let ((index (b1-api-context-facts context)))
    (cond ((equal word "theorem") (b1-api-solve-theorem world context name data index))
          ((equal word "constrain") (b1-api-solve-constraint world name data index))
          (t (proof-with-checked-results
              ((result (b1-generate-prove world word data name calls measures
                                         (b1-api-context-formulas context) index)))
              (list (cdr result) (cadddr (car result))))))))

(defun b1-api-occupied (word data name names)
  (cond ((equal word "define")
         (proof-with-checked-results ((declared (b1-api-declared-names (cdr data))))
           (b1-api-set-update declared names)))
        ((equal word "constrain")
         (proof-with-checked-results ((declared (b1-api-declared-names (car data)))
                                      (facts (b1-api-declared-names (cadr data))))
           (b1-api-set-update facts (b1-api-set-update declared names))))
        (t (b1-api-set-add name names))))

(defun b1-api-prove-prepared (context word data name calls measures)
  (let ((world (b1-api-callproof-fork (b1-api-context-world context))))
    (proof-with-checked-results
     ((result (b1-api-solve world context word data name calls measures))
      (names (b1-api-occupied word data name (b1-api-context-names context))))
     (b1-api-certificate (library-library-entries (car result)) (cadr result) names))))

(defun b1-api-prove-in-context (statement earlier library aids)
  (proof-with-checked-results ((raw (b1-api-raw statement))
                               (parsed (b1-api-parse raw))
                               (obligation (b1-generate-obligations (car parsed) (cadr parsed))))
    (let ((name (car obligation)))
      (if (not name)
          nil
        (proof-with-checked-results ((context (b1-api-context-for library earlier)))
          (if (member-equal raw (b1-api-context-seen context))
              nil
            (let ((word (car parsed)))
              (proof-with-checked-results
               ((measures (if (equal word "define") (b1-api-measures aids) nil)))
               (b1-api-prove-prepared context word (cadr parsed) name (cadr obligation) measures)))))))))

(defun b1-api-prove (statement earlier library aids)
  (let ((result (b1-api-prove-in-context statement earlier library aids)))
    (if (failure-p result) nil result)))
