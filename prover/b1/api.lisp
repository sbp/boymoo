(in-package "BOYMOO-PROVER")
(set-verify-guards-eagerness 0)

(defconst *b1-api-prefix* "B1")
(defconst *b1-api-line-feed* (coerce (list #\Newline) 'string))

(defun b1-api-raw (value)
  (cond ((not (stringp value)) '(:failure "failure" ""))
        ((text-ends-with value *b1-api-line-feed*) (subseq value 0 (1- (length value))))
        (t value)))

(defun b1-api-reader-dotted-tail (cursor reversed)
  (let ((tail (reader-cursor-advance cursor 2)))
    (cond
     ((= (reader-cursor-peek tail) 40)
      '(:failure "failure" ""))
     (t
      (let ((result (reader-cursor-datum 1000000 tail)))
        (cond ((failure-p result) result)
              ((equal (car result) *proof-nil*)
               '(:failure "failure" ""))
              (t (cons (cons (list "dot" (car result)) reversed) (cdr result)))))))))

; Each stack frame holds the items read so far in one list, in reverse order.
(defun b1-api-reader-next (cursor lists)
  (if (= (reader-cursor-peek cursor) 40)
      (list :next (reader-cursor-advance cursor 1) (cons nil lists))
    (proof-with-checked-results ((datum (reader-cursor-datum 1000000 cursor)))
      (list :finish (cdr datum) lists (car datum)))))

(defun b1-api-reader-finish (cursor lists value)
  (if (endp lists)
      (cons value cursor)
    (let ((reversed (cons value (car lists))))
      (if (= (reader-cursor-peek cursor) 32)
          (let ((after-space (reader-cursor-advance cursor 1)))
            (if (reader-prefix-p '(#\. #\Space) (cdr after-space))
                (proof-with-checked-results
                 ((dotted (b1-api-reader-dotted-tail after-space reversed))
                  (closed (reader-cursor-take (cdr dotted) ")")))
                 (list :finish closed (cdr lists) (reverse (car dotted))))
              (list :next after-space (cons reversed (cdr lists)))))
        (proof-with-checked-results ((closed (reader-cursor-take cursor ")")))
          (list :finish closed (cdr lists) (reverse reversed)))))))

(defun b1-api-reader-list (n result)
  (declare (xargs :measure (nfix n)))
  (cond ((zp n) '(:failure "fuel" "b1-api-reader-list"))
        ((eq (car result) :next)
         (b1-api-reader-list (1- n) (b1-api-reader-next (cadr result) (caddr result))))
        ((eq (car result) :finish)
         (b1-api-reader-list (1- n)
                             (b1-api-reader-finish (cadr result) (caddr result) (cadddr result))))
        (t result)))

(defun b1-api-reader-datum-cursor (cursor)
  (if (= (reader-cursor-peek cursor) 40)
      (b1-api-reader-list 1000000 (list :next (reader-cursor-advance cursor 1) (list nil)))
    (reader-cursor-datum 1000000 cursor)))

(defun b1-api-parse-next (cursor word reversed)
  (if (= (reader-cursor-peek cursor) 32)
    (proof-with-checked-results
     ((field (b1-api-reader-datum-cursor (reader-cursor-advance cursor 1))))
     (list :more (cdr field) word (cons (car field) reversed)))
    (proof-with-checked-results ((closed (reader-cursor-take cursor ")")))
      (if (endp (cdr closed))
          (list word (reverse reversed))
        '(:failure "failure" "")))))

(defun b1-api-parse-fields (n result)
  (declare (xargs :measure (nfix n)))
  (cond ((zp n) '(:failure "fuel" "b1-api-parse-fields"))
        ((eq (car result) :more)
         (b1-api-parse-fields (1- n)
                              (b1-api-parse-next (cadr result) (caddr result) (cadddr result))))
        (t result)))

(defun b1-api-parse (raw)
  (proof-with-checked-results
   ((opened (reader-cursor-take (reader-cursor (reader-reader raw)) "(")))
   (let* ((field (reader-scan (cdr opened) (car opened) *reader-word-chars* nil))
          (word (car field)))
     (cond ((endp (cddr field)) '(:failure "failure" ""))
           ((equal word "") '(:failure "failure" ""))
           (t (b1-api-parse-fields 1000000 (list :more (cdr field) word nil)))))))

(defun b1-api-pair-bindings (keys values mapping)
  (if (or (endp keys) (endp values))
      mapping
    (b1-api-pair-bindings (cdr keys) (cdr values)
                      (table-put mapping (car keys) (car values)))))

(defun b1-api-choice-fact-values (bound index arguments values)
  (if (endp bound)
      values
    (b1-api-choice-fact-values
     (cdr bound) (1+ index) arguments
     (table-put values (car bound)
                  (list (proof-sym "MV-NTH" "ACL2") (proof-quote index) arguments)))))

(defun b1-api-choice-fact-choose (arguments bound)
  (cond ((integerp bound) '(:failure "failure" ""))
        ((equal (len bound) 1) (list (cons (car bound) arguments)))
        (t (b1-api-choice-fact-values bound 0 arguments nil))))

(defun b1-api-choice-fact-renamed (name body bound free renamed call values result)
  (if (integerp renamed)
      '(:failure "failure" "")
    (let* ((other (cons name renamed))
           (rename (b1-api-pair-bindings free renamed nil)))
      (proof-with-checked-results
       ((other-values (b1-api-choice-fact-choose other bound))
        (same (proof-eq call other))
        (test (proof-subst body values))
        (renamed-test (proof-subst body (table-update values rename)))
        (first (proof-ite test (proof-neg renamed-test) *proof-false*))
        (other-renamed-test (proof-subst body (table-update other-values rename)))
        (other-test (proof-subst body other-values)))
       (let ((second (proof-ite other-renamed-test (proof-neg other-test) *proof-false*)))
         (proof-ite result (proof-ite same same (proof-ite first first second)) *proof-false*))))))

(defun b1-api-choice-fact (data)
  (proof-with-checked-results ((fields (proof-list-of-length data 5)))
    (let* ((name (car fields))
           (bound (cadr fields))
           (free (if (equal (caddr fields) *proof-nil*) nil (caddr fields)))
           (body (cadddr fields))
           (renamed (nth 4 fields)))
      (if (integerp free)
          '(:failure "failure" "")
        (let ((call (cons name free)))
          (proof-with-checked-results ((values (b1-api-choice-fact-choose call bound))
                                       (witnessed (proof-subst body values)))
            (let* ((implication (list (proof-sym "IMPLIES" "ACL2") body witnessed))
                   (result (if (> (len bound) 1)
                               (proof-ite (list (proof-sym "TRUE-LISTP" "ACL2") call)
                                          implication *proof-false*)
                             implication)))
              (proof-with-checked-results
               ((term (if (equal renamed *proof-nil*)
                          result
                        (b1-api-choice-fact-renamed name body bound free renamed call values result))))
               (list name term)))))))))

(defun b1-api-measure-lines (aids measures)
  (if (endp aids)
      measures
    (proof-with-checked-results ((raw (b1-api-raw (car aids))))
      (if (text-starts-with raw "(measure ")
          (proof-with-checked-results ((parsed (b1-api-parse raw)))
            (let* ((data (cadr parsed))
                   (count (len data)))
              (b1-api-measure-lines
               (cdr aids)
               (if (and (or (= count 3) (= count 4)) (equal (caddr data) *proof-ordinal-less*))
                   (table-put measures (car data) (cadr data))
                 measures))))
        (b1-api-measure-lines (cdr aids) measures)))))

(defun b1-api-measures (aids)
  (if (or (true-listp aids) (stringp aids))
      (b1-api-measure-lines aids nil)
    '(:failure "failure" "")))

