(in-package "BOYMOO-PROVER")
(set-verify-guards-eagerness 0)

(defconst *b1-parity-half* (proof-quote '("ratio" 1 2)))
(defconst *b1-parity-r* (proof-sym "R" "ACL2"))
(defconst *b1-parity-i* (proof-sym "I" "ACL2"))

(defun b1-parity-half (term)
  (b1-arithmetic-product *b1-parity-half* term))

(defun b1-parity-either-half (lib formula integer-half)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((test (proof-term-at formula 1))
         (literal (proof-step-first integer-half)))
      (if (equal literal test)
          (proof-with-checked-results
              ((selected (proof-proof-select proof formula integer-half)))
            (proof-proof-transport proof integer-half selected))
        (proof-with-checked-results
            ((assumed (proof-proof-assume proof test t))
             (true-branch (proof-proof-if-true proof formula))
             (yes (proof-proof-transport proof assumed true-branch))
             (false-branch (proof-proof-if-false proof formula))
             (no (proof-proof-transport proof integer-half false-branch)))
          (proof-proof-cases proof test yes no))))))

(defun b1-parity-parity-case-consequence-offset (integer-at shift target lib int-n)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((literal (proof-step-first integer-at))
         (product (proof-term-at literal 1))
         (arg (proof-term-at product 2)))
      (if (equal shift 0)
          (proof-with-checked-results
              ((change (library-library-linear-equal lib arg target (list int-n))))
            (proof-proof-rewrite proof integer-at change '(1 1 2)))
        (let* ((amount (proof-quote shift))
               (shifted (library-plus arg amount)))
          (proof-with-checked-results
              ((distributed (library-library-axiom lib "DISTRIBUTIVITY"
                                                    (list *b1-parity-half* arg amount)))
               (constant (b1-logic-bookproof-constant
                          lib (b1-arithmetic-product *b1-parity-half* amount)))
               (distributed (proof-proof-rewrite proof distributed constant '(1 2 2)))
               (distributed-first (proof-step-first distributed))
               (integer-sum (library-library-type-of lib (caddr distributed-first)
                                                      (list integer-at)))
               (signed-half (library-library-transport-argument lib integer-sum distributed 1))
               (change (library-library-linear-equal lib shifted target (list int-n))))
            (proof-proof-rewrite proof signed-half change '(1 1 2))))))))

(defun b1-parity-parity-case-consequence
    (natural lib negative n signed signed-before first claim formula substitutions)
  (let* ((proof (library-library-proof lib))
         (test (proof-eq n *proof-zero*)))
    (proof-with-checked-results
        ((int-n (library-library-cite lib "NATURAL-INTEGER" (list n) (list natural)))
         (zero (proof-proof-assume proof test t))
         (base-first (b1-logic-bookproof-normalize-proof
                      lib first nil nil (list (b1-logic-equal-to zero)) nil))
         (base (b1-parity-either-half lib claim base-first))
         (not-zero (proof-proof-assume proof test nil))
         (predecessor (b1-powers-natural-predecessor lib natural not-zero))
         (smaller (car predecessor))
         (descent (cadr predecessor))
         (at-child (proof-subst formula substitutions))
         (descent-first (proof-step-first descent))
         (assumed (proof-proof-assume proof (proof-ite descent-first at-child *proof-true*) t))
         (hypothesis (proof-proof-prove-if proof assumed descent))
         (options (proof-proof-modus-ponens proof hypothesis smaller))
         (options-first (proof-step-first options))
         (test-child (proof-term-at options-first 1))
         (positive-child (proof-proof-assume proof test-child t))
         (first-child (proof-proof-prove-if proof options positive-child))
         (negative-child (proof-proof-assume proof test-child nil))
         (second-child (proof-proof-prove-if proof options negative-child))
         (keep (if negative
                   (b1-parity-parity-case-consequence-offset first-child -2 signed-before lib int-n)
                 first-child))
         (move (b1-parity-parity-case-consequence-offset second-child (if negative 0 2)
                                                         signed lib int-n))
         (keep-case (b1-parity-either-half lib claim keep))
         (move-case (b1-parity-either-half lib claim move))
         (successor (proof-proof-cases proof test-child keep-case move-case)))
      (proof-proof-cases proof test base successor))))

(defun b1-parity-parity-case (lib negative)
  (let* ((negative (and negative (not (equal negative 0)) (not (equal negative ""))))
         (name (if negative "PARITY-NEGATIVE" "PARITY-POSITIVE"))
         (label (proof-sym (concatenate 'string "SELF-" name) "ACL2"))
         (proof (library-library-proof lib)))
    (if (assoc-equal label (proof-proof-facts proof))
        (cons label lib)
      (let* ((n *library-x*)
             (predecessor (library-plus n *proof-neg-one*))
             (signed (if negative (library-minus n) n))
             (signed-before (library-plus signed *proof-neg-one*))
             (first (library-integer (b1-parity-half signed)))
             (claim (proof-ite first first (library-integer (b1-parity-half signed-before))))
             (formula (list *library-implies* (list *library-natp* n) claim))
             (substitutions (list (cons n predecessor))))
        (proof-with-checked-results
            ((premise (b1-logic-bookproof-prove-implication-premise lib formula))
             (consequence (b1-parity-parity-case-consequence
                           premise lib negative n signed signed-before first claim formula substitutions))
             (step (b1-logic-bookproof-prove-implication-with-premise lib formula premise consequence))
             (ordinal (library-library-builtin lib 1 n))
             (step (proof-proof-induct proof ordinal step formula (list *library-count* n)
                                       (list (list (list n predecessor)))))
             (lib (library-library-lemma lib name formula step nil)))
          (cons label lib))))))

(defun b1-parity-half-or-previous (lib i int-i)
  (let ((proof (library-library-proof lib))
        (test (library-lt i *proof-zero*)))
    (proof-with-checked-results
        ((nonneg-i (proof-proof-assume proof test nil))
         (natural (library-library-cite lib "NATURAL-FROM-BOUNDS" (list i) (list int-i nonneg-i)))
         (positive-case (b1-parity-parity-case lib nil))
         (lib (cdr positive-case))
         (proof (library-library-proof lib))
         (positive-fact (proof-proof-fact proof (car positive-case) (list (list *library-x* i))))
         (yes (proof-proof-modus-ponens proof positive-fact natural))
         (neg-i (library-minus i))
         (int-neg (library-library-type-of lib neg-i (list int-i)))
         (pos-neg (proof-proof-assume proof test t))
         (comparison (library-library-comparison lib i *proof-zero* (list int-i)))
         (pos-neg (proof-proof-rewrite proof pos-neg comparison '(1)))
         (identity (library-library-cite lib "ADD-ZERO-LEFT" (list neg-i) (list int-neg)))
         (pos-neg (proof-proof-rewrite proof pos-neg identity '(1 2)))
         (lower (library-library-cite lib "POSITIVE-NONNEGATIVE" (list neg-i) (list int-neg pos-neg)))
         (natural-neg (library-library-cite lib "NATURAL-FROM-BOUNDS" (list neg-i) (list int-neg lower)))
         (negative-case (b1-parity-parity-case lib t))
         (lib (cdr negative-case))
         (proof (library-library-proof lib))
         (negative-fact (proof-proof-fact proof (car negative-case) (list (list *library-x* neg-i))))
         (no (proof-proof-modus-ponens proof negative-fact natural-neg))
         (double-negation (library-library-cite lib "DOUBLE-NEGATION" (list i) (list int-i)))
         (no (proof-proof-rewrite-first proof no double-negation))
         (result (proof-proof-cases proof test no yes)))
      (cons result lib))))

(defun b1-parity-power-type (lib name base exponent evidence)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((fact (proof-proof-fact proof (proof-sym name "ACL2")
                                 (list (list *b1-parity-r* base) (list *b1-parity-i* exponent))))
         (first (proof-step-first fact))
         (test (proof-term-at first 1))
         (guard-proof (b1-logic-bookproof-normalize-proof lib test evidence nil nil nil)))
      (proof-proof-modus-ponens proof fact guard-proof))))

(defun b1-parity-even-power-positive-consequence (premise lib)
  (proof-with-checked-results
      ((conjuncts (b1-logic-bookproof-split-conjuncts lib premise))
       (parts (proof-list-of-length conjuncts 4))
       (negative (car parts))
       (rat-r (cadr parts))
       (int-i (caddr parts))
       (half-integer (cadddr parts))
       (rat-r-first (proof-step-first rat-r))
       (base (proof-term-at rat-r-first 1))
       (int-i-first (proof-step-first int-i))
       (exponent (proof-term-at int-i-first 1))
       (half-first (proof-step-first half-integer))
       (half-i (proof-term-at half-first 1))
       (number (b1-arithmetic-known-type lib *library-numberp* base (list rat-r)))
       (nonzero (b1-arithmetic-comparison-excludes lib negative *proof-zero* 1))
       (addition (b1-powers-signed-power-addition
                  lib base half-i half-i half-integer half-integer number nonzero))
       (square-eq (car addition))
       (lib (cdr addition))
       (proof (library-library-proof lib))
       (commute (library-library-axiom lib "COMMUTATIVITY-OF-*" (list *b1-parity-half* exponent)))
       (double (proof-proof-reflexive proof (library-plus half-i half-i)))
       (double (proof-proof-rewrite proof double commute '(1 2 1)))
       (double (proof-proof-rewrite proof double commute '(1 2 2)))
       (distribute (library-library-axiom lib "DISTRIBUTIVITY"
                                        (list exponent *b1-parity-half* *b1-parity-half*)))
       (collect (proof-proof-symmetric proof distribute))
       (double (proof-proof-chain proof double (list collect)))
       (two-halves (b1-logic-bookproof-constant lib (library-plus *b1-parity-half* *b1-parity-half*)))
       (double (proof-proof-rewrite proof double two-halves '(1 2 2)))
       (identity (b1-arithmetic-multiply-one lib exponent (list int-i) nil))
       (double (proof-proof-chain proof double (list identity)))
       (square-eq (proof-proof-rewrite proof square-eq double '(1 1 2)))
       (square-first (proof-step-first square-eq))
       (square (proof-term-at square-first 2))
       (rat-power (b1-parity-power-type lib "RATIONALP-EXPT-TYPE-PRESCRIPTION"
                                        base half-i (list rat-r)))
       (factor (proof-term-at square 1))
       (nonnegative-product (library-library-axiom lib "NONNEGATIVE-PRODUCT" (list factor)))
       (pos-square (proof-proof-modus-ponens proof nonnegative-product rat-power))
       (bounds (proof-proof-conjunct proof pos-square))
       (exponent-nonzero (b1-parity-power-type lib "EXPT-TYPE-PRESCRIPTION-NON-ZERO-BASE"
                                               base exponent (list number nonzero)))
       (square-nonzero (proof-proof-rewrite proof exponent-nonzero square-eq '(1 1 1)))
       (square-number (b1-arithmetic-known-type lib *library-numberp* square nil))
       (positive (b1-arithmetic-positive-from-bounds lib (cadr bounds) square-nonzero square-number))
       (lib (cdr positive))
       (step (library-library-transport-argument lib (car positive) square-eq 2)))
    (cons step lib)))

(defun b1-parity-even-power-positive (lib formula)
  (proof-with-checked-results
      ((premise (b1-logic-bookproof-prove-implication-premise lib formula))
       (consequence (b1-parity-even-power-positive-consequence premise lib))
       (lib (cdr consequence))
       (step (b1-logic-bookproof-prove-implication-with-premise lib formula premise (car consequence))))
    (cons step lib)))

(defun b1-parity-odd-power-negative-consequence (premise lib)
  (proof-with-checked-results
      ((conjuncts (b1-logic-bookproof-split-conjuncts lib premise))
       (parts (proof-list-of-length conjuncts 4))
       (negative (car parts))
       (rat-r (cadr parts))
       (int-i (caddr parts))
       (odd (cadddr parts))
       (rat-r-first (proof-step-first rat-r))
       (base (proof-term-at rat-r-first 1))
       (int-i-first (proof-step-first int-i))
       (exponent (proof-term-at int-i-first 1))
       (predecessor (library-plus exponent *proof-neg-one*))
       (halves (b1-parity-half-or-previous lib exponent int-i))
       (lib (cdr halves))
       (proof (library-library-proof lib))
       (half-integer (proof-proof-prove-if proof (car halves) odd))
       (int-pred (library-library-type-of lib predecessor (list int-i)))
       (previous-positive (b1-parity-power-type
                           lib "EXPT-TYPE-PRESCRIPTION-NEGATIVE-BASE-EVEN-EXPONENT"
                           base predecessor (list negative rat-r int-pred half-integer)))
       (rat-previous (b1-parity-power-type lib "RATIONALP-EXPT-TYPE-PRESCRIPTION"
                                           base predecessor (list rat-r)))
       (negative-product (b1-arithmetic-multiply-strict lib previous-positive negative
                                                       (list rat-previous rat-r)))
       (lib (cdr negative-product))
       (proof (library-library-proof lib))
       (previous (b1-powers-expt base predecessor))
       (zero-product (b1-arithmetic-multiply-zero lib previous))
       (negative-product (proof-proof-rewrite proof (car negative-product) zero-product '(1 2)))
       (commute (library-library-axiom lib "COMMUTATIVITY-OF-*" (list previous base)))
       (negative-product (proof-proof-rewrite proof negative-product commute '(1 1)))
       (lib (b1-powers-build-recurrences lib))
       (proof (library-library-proof lib))
       (number (b1-arithmetic-known-type lib *library-numberp* base (list rat-r)))
       (nonzero (b1-arithmetic-comparison-excludes lib negative *proof-zero* 1))
       (step (library-library-cite lib "EXPT-STEP-UP" (list base predecessor)
                                   (list int-pred number nonzero)))
       (cancel (library-library-linear-equal lib (library-plus predecessor *proof-one*)
                                             exponent (list int-i)))
       (step (proof-proof-rewrite proof step cancel '(1 1 2)))
       (result (library-library-transport-argument lib negative-product step 1)))
    (cons result lib)))

(defun b1-parity-odd-power-negative (lib formula)
  (proof-with-checked-results
      ((premise (b1-logic-bookproof-prove-implication-premise lib formula))
       (consequence (b1-parity-odd-power-negative-consequence premise lib))
       (lib (cdr consequence))
       (step (b1-logic-bookproof-prove-implication-with-premise lib formula premise (car consequence))))
    (cons step lib)))

(defun b1-parity-adjacent-half-equation (lib greater lesser int-x)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((distribution (library-library-axiom lib "DISTRIBUTIVITY"
                                             (list *b1-parity-half* lesser *proof-one*)))
         (add (library-library-linear-equal lib (library-plus lesser *proof-one*) greater (list int-x)))
         (equation (proof-proof-rewrite proof distribution add '(1 1 2)))
         (constant (b1-logic-bookproof-constant
                    lib (b1-arithmetic-product *b1-parity-half* *proof-one*))))
      (proof-proof-rewrite proof equation constant '(1 2 2)))))

(defun b1-parity-adjacent-halves-cannot-both-be-integers (lib high low equation test)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((high-first (proof-step-first high))
         (high-term (proof-term-at high-first 1))
         (low-first (proof-step-first low))
         (low-term (proof-term-at low-first 1))
         (diff-halves (library-plus high-term (library-minus low-term)))
         (integral (library-library-type-of lib diff-halves (list high low)))
         (integral (proof-proof-rewrite proof integral equation '(1 1 1)))
         (sums (b1-arithmetic-number-sums-init lib))
         (lib (b1-arithmetic-number-sums-library sums))
         (proof (library-library-proof lib))
         (integral-first (proof-step-first integral))
         (diff (proof-term-at integral-first 1))
         (normal (b1-arithmetic-number-sums-linear-equal sums diff *b1-parity-half* nil))
         (integral (proof-proof-rewrite proof integral normal '(1 1)))
         (impossible (proof-proof-simplify-first proof integral nil nil))
         (impossible (proof-proof-tidy proof impossible))
         (result (proof-proof-front proof impossible (proof-neg test))))
      (cons result lib))))

(defun b1-parity-negated-base-case-consequence-conclude
    (sign child-condition current-condition lib hypothesis signed weight child-pow ordinary choices)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((hypothesis-first (proof-step-first hypothesis))
         (child-choice (proof-term-at hypothesis-first 2))
         (selected (proof-proof-select proof child-choice child-condition))
         (child-eq (proof-proof-rewrite proof hypothesis selected '(1 2)))
         (lhs (proof-proof-rewrite proof signed child-eq '(1 2 2)))
         (product-sign (if sign
                           (b1-arithmetic-negative-left-factor lib weight child-pow)
                         (b1-arithmetic-two-negative-factors lib weight child-pow)))
         (lib (cdr product-sign))
         (proof (library-library-proof lib))
         (reverse-ordinary (proof-proof-symmetric proof ordinary))
         (rhs (if sign
                  (proof-proof-rewrite proof (car product-sign) reverse-ordinary '(1 2 1))
                (proof-proof-chain proof (car product-sign) (list reverse-ordinary))))
         (step (proof-proof-chain proof lhs (list rhs)))
         (selected (proof-proof-select proof choices current-condition))
         (selected (proof-proof-symmetric proof selected))
         (step (proof-proof-rewrite proof step selected '(1 2))))
      (cons step lib))))

(defun b1-parity-negated-base-case-current-even
    (lib direction n predecessor natural natural-child negative-child test child current integer-n)
  (proof-with-checked-results
      ((up (equal direction *proof-one*))
       (parity (b1-parity-parity-case lib (not up)))
       (lib (cdr parity))
       (proof (library-library-proof lib))
       (fact (proof-proof-fact proof (car parity) (list (list *library-x* (if up n predecessor)))))
       (options (proof-proof-modus-ponens proof fact (if up natural natural-child))))
    (if up
        (proof-with-checked-results
            ((not-test (proof-proof-assume proof test nil))
             (needed (proof-proof-prove-if proof options not-test))
             (cut (proof-proof-cut proof needed negative-child))
             (step (proof-proof-front proof cut test)))
          (cons step lib))
      (proof-with-checked-results
          ((change (library-library-linear-equal lib (library-plus child *proof-neg-one*)
                                                 current (list integer-n)))
           (options (proof-proof-rewrite-first proof options change))
           (step (proof-proof-prove-if proof options negative-child)))
        (cons step lib)))))

(defun b1-parity-negated-base-case-consequence
    (premise lib direction base n current child child-pow past signed-base
             test child-test choices claim formula recurrence bindings predecessor)
  (let ((proof (library-library-proof lib))
        (n-zero (proof-eq n *proof-zero*)))
    (proof-with-checked-results
        ((conjuncts (b1-logic-bookproof-split-conjuncts lib premise))
         (parts (proof-list-of-length conjuncts 3))
         (natural (car parts))
         (numeric (cadr parts))
         (nonzero (caddr parts))
         (integer-n (library-library-cite lib "NATURAL-INTEGER" (list n) (list natural)))
         (zero (proof-proof-assume proof n-zero t))
         (base-zero (b1-powers-expt-zero lib base))
         (signed-base-zero (b1-powers-expt-zero lib signed-base))
         (base-case (b1-logic-bookproof-normalize-proof
                     lib claim nil nil (list (b1-logic-equal-to zero)
                                             (b1-logic-equal-to base-zero)
                                             (b1-logic-equal-to signed-base-zero)) nil))
         (not-zero (proof-proof-assume proof n-zero nil))
         (predecessor-steps (b1-powers-natural-predecessor lib natural not-zero))
         (natural-child (car predecessor-steps))
         (descent (cadr predecessor-steps))
         (child-formula (proof-subst formula bindings))
         (descent-first (proof-step-first descent))
         (assumed (proof-proof-assume proof (proof-ite descent-first child-formula *proof-true*) t))
         (induction (proof-proof-prove-if proof assumed descent))
         (child-guard (proof-term-at child-formula 1))
         (condition (b1-logic-bookproof-normalize-proof
                     lib child-guard (list natural-child numeric nonzero) nil nil nil))
         (hypothesis (proof-proof-modus-ponens proof induction condition))
         (integral-child (library-library-type-of lib child (list integer-n)))
         (signed-number (b1-arithmetic-known-type lib *library-numberp* signed-base nil))
         (nonzero-proof (b1-arithmetic-nonzero-negation lib base numeric nonzero))
         (signed-nonzero (car nonzero-proof))
         (lib (cdr nonzero-proof))
         (proof (library-library-proof lib))
         (ordinary (library-library-cite lib recurrence (list base child)
                                         (list integral-child numeric nonzero)))
         (signed (library-library-cite lib recurrence (list signed-base child)
                                       (list integral-child signed-number signed-nonzero)))
         (change (library-library-linear-equal lib past current (list integer-n)))
         (ordinary (proof-proof-rewrite proof ordinary change '(1 1 2)))
         (signed (proof-proof-rewrite proof signed change '(1 1 2)))
         (ordinary-first (proof-step-first ordinary))
         (product (proof-term-at ordinary-first 2))
         (weight (proof-term-at product 1))
         (signed-result
          (if (equal direction *proof-neg-one*)
              (proof-with-checked-results
                  ((reciprocal (b1-arithmetic-reciprocal-negation lib base numeric nonzero))
                   (lib (cdr reciprocal))
                   (proof (library-library-proof lib))
                   (signed (proof-proof-rewrite proof signed (car reciprocal) '(1 2 1))))
                (cons signed lib))
            (cons signed lib)))
         (signed (car signed-result))
         (lib (cdr signed-result))
         (proof (library-library-proof lib))
         (up (equal direction *proof-one*))
         (adjacent (b1-parity-adjacent-half-equation lib (if up current child)
                                                    (if up child current) integer-n))
         (positive-child (proof-proof-assume proof child-test t))
         (negative-child (proof-proof-assume proof child-test nil))
         (positive-current (proof-proof-assume proof test t))
         (current-odd (b1-parity-adjacent-halves-cannot-both-be-integers
                       lib (if up positive-current positive-child)
                       (if up positive-child positive-current) adjacent test))
         (lib (cdr current-odd))
         (current-even (b1-parity-negated-base-case-current-even
                        lib direction n predecessor natural natural-child negative-child
                        test child current integer-n))
         (lib (cdr current-even))
         (yes (b1-parity-negated-base-case-consequence-conclude
               t positive-child (car current-odd) lib hypothesis signed weight child-pow ordinary choices))
         (lib (cdr yes))
         (no (b1-parity-negated-base-case-consequence-conclude
              nil negative-child (car current-even) lib hypothesis signed weight child-pow ordinary choices))
         (lib (cdr no))
         (proof (library-library-proof lib))
         (successor (proof-proof-cases proof child-test (car yes) (car no)))
         (result (proof-proof-cases proof n-zero base-case successor)))
      (cons result lib))))

(defun b1-parity-negated-base-case (lib direction)
  (let* ((up (equal direction *proof-one*))
         (label (if up "EXPT-NEGATED-BASE-POSITIVE" "EXPT-NEGATED-BASE-NEGATIVE"))
         (name (proof-sym (concatenate 'string "SELF-" label) "ACL2"))
         (proof (library-library-proof lib)))
    (if (assoc-equal name (proof-proof-facts proof))
        (cons name lib)
      (proof-with-checked-results
          ((lib (b1-powers-build-recurrences lib))
           (base *library-x*)
           (n *library-y*)
           (predecessor (library-plus n *proof-neg-one*))
           (current (if up n (library-minus n)))
           (child (if up predecessor (library-minus predecessor)))
           (current-pow (b1-powers-expt base current))
           (child-pow (b1-powers-expt base child))
           (past (library-plus child direction))
           (signed-base (library-minus base))
           (test (library-integer (b1-parity-half current)))
           (child-test (library-integer (b1-parity-half child)))
           (choices (proof-ite test current-pow (library-minus current-pow)))
           (claim (proof-eq (b1-powers-expt signed-base current) choices))
           (guard (proof-ite (list *library-natp* n)
                             (proof-ite (list *library-numberp* base) (proof-neg (proof-eq base *proof-zero*))
                                        *proof-false*)
                             *proof-false*))
           (formula (list *library-implies* guard claim))
           (recurrence (if up "EXPT-STEP-UP" "EXPT-STEP-DOWN"))
           (bindings (list (cons n predecessor)))
           (premise (b1-logic-bookproof-prove-implication-premise lib formula))
           (consequence (b1-parity-negated-base-case-consequence
                         premise lib direction base n current child child-pow past signed-base
                         test child-test choices claim formula recurrence bindings predecessor))
           (lib (cdr consequence))
           (proof (library-library-proof lib))
           (step (b1-logic-bookproof-prove-implication-with-premise lib formula premise (car consequence)))
           (ordinal (library-library-builtin lib 1 n))
           (step (proof-proof-induct proof ordinal step formula (list *library-count* n)
                                     (list (list (list n predecessor)))))
           (lib (library-library-lemma lib label formula step nil)))
        (cons name lib)))))

(defun b1-parity-sign-rule-cite (direction n nat lib base numeric nonzero)
  (proof-with-checked-results
      ((case (b1-parity-negated-base-case lib direction))
       (lib (cdr case))
       (proof (library-library-proof lib))
       (fact (proof-proof-fact proof (car case) (list (list *library-x* base) (list *library-y* n))))
       (fact-first (proof-step-first fact))
       (test (proof-term-at fact-first 1))
       (condition (b1-logic-bookproof-normalize-proof lib test (list nat numeric nonzero) nil nil nil))
       (step (proof-proof-modus-ponens proof fact condition)))
    (cons step lib)))

(defun b1-parity-sign-rule (lib base integer-i numeric nonzero)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((integer-first (proof-step-first integer-i))
         (i (proof-term-at integer-first 1))
         (test (library-lt i *proof-zero*))
         (assumed (proof-proof-assume proof test nil))
         (nat-i (library-library-cite lib "NATURAL-FROM-BOUNDS" (list i) (list integer-i assumed)))
         (nonnegative (b1-parity-sign-rule-cite *proof-one* i nat-i lib base numeric nonzero))
         (lib (cdr nonnegative))
         (proof (library-library-proof lib))
         (negative-i (library-minus i))
         (integer-neg (library-library-type-of lib negative-i (list integer-i)))
         (positive-neg (proof-proof-assume proof test t))
         (comparison (library-library-comparison lib i *proof-zero* (list integer-i)))
         (positive-neg (proof-proof-rewrite proof positive-neg comparison '(1)))
         (identity (library-library-cite lib "ADD-ZERO-LEFT" (list negative-i) (list integer-neg)))
         (positive-neg (proof-proof-rewrite proof positive-neg identity '(1 2)))
         (bound (library-library-cite lib "POSITIVE-NONNEGATIVE" (list negative-i)
                                      (list integer-neg positive-neg)))
         (nat-neg (library-library-cite lib "NATURAL-FROM-BOUNDS" (list negative-i) (list integer-neg bound)))
         (negative-case (b1-parity-sign-rule-cite *proof-neg-one* negative-i nat-neg lib base numeric nonzero))
         (lib (cdr negative-case))
         (proof (library-library-proof lib))
         (double-negation (library-library-cite lib "DOUBLE-NEGATION" (list i) (list integer-i)))
         (negative (proof-proof-rewrite-first proof (car negative-case) double-negation))
         (step (proof-proof-cases proof test negative (car nonnegative))))
      (cons step lib))))

(defun b1-parity-negate-fixed-zero (lib base fix-zero)
  (let ((proof (library-library-proof lib))
        (test (list *library-numberp* base)))
    (proof-with-checked-results
        ((has-number (proof-proof-assume proof test t))
         (fixed (b1-logic-bookproof-normalize lib (list *b1-powers-fix* base) (list has-number)
                                             (list *b1-powers-fix*) nil nil nil nil))
         (zero (proof-proof-rewrite proof fix-zero fixed '(1 1)))
         (yes (proof-proof-reflexive proof (library-minus base)))
         (yes (proof-proof-rewrite proof yes zero '(1 2 1)))
         (minus-zero (b1-logic-bookproof-constant lib (library-minus *proof-zero*)))
         (yes (proof-proof-chain proof yes (list minus-zero)))
         (completion (library-library-axiom lib "COMPLETION-OF-UNARY-MINUS" (list base)))
         (completion-first (proof-step-first completion))
         (completion-value (proof-term-at completion-first 2))
         (other (proof-proof-if-false proof completion-value))
         (no (proof-proof-chain proof completion (list other))))
      (proof-proof-cases proof test yes no))))

(defund b1-parity-negated-base-normalize-product (term lib)
  (if (not (proof-is-call term *proof-times*))
      (cons nil lib)
    (proof-with-checked-results ((left (proof-term-at term 1)))
      (if (equal left *proof-neg-one*)
          (proof-with-checked-results ((right (proof-term-at term 2)))
            (b1-arithmetic-multiply-minus-one lib right))
        (cons nil lib)))))

(defund b1-parity-negated-base-normalize-attempt (lib term replies)
  (b1-logic-bookproof-normalize-with-library
   lib term nil nil '((:callback :b1-parity-normalize-product)) nil nil nil (reverse replies)))

(defun b1-parity-negated-base-normalize (n lib term replies)
  (declare (xargs :measure (nfix n)))
  (if (zp n)
      '(:failure "Fuel" "b1-parity-negated-base-normalize")
    (proof-with-checked-results
        ((result (b1-parity-negated-base-normalize-attempt lib term replies)))
      (if (b1-logic-call-p result)
          (proof-with-checked-results
              ((reply (b1-parity-negated-base-normalize-product
                       (b1-logic-call-term result) (b1-logic-call-library result))))
            (b1-parity-negated-base-normalize (1- n) lib term (cons reply replies)))
        result))))

(defun b1-parity-negated-base-consequence
    (premise lib base fixed-zero claim canonical i negative-base)
  (proof-with-checked-results
      ((conjuncts (b1-logic-bookproof-split-conjuncts lib premise))
       (parts (proof-list-of-length (nthcdr (nfix (- (len conjuncts) 2)) conjuncts) 2))
       (integer-i (car parts))
       (parity (cadr parts))
       (proof (library-library-proof lib))
       (not-fixed-zero (proof-proof-assume proof fixed-zero nil))
       (base-proofs (b1-powers-nonzero-fixed-base lib base not-fixed-zero))
       (signed (b1-parity-sign-rule lib base integer-i (car base-proofs) (cadr base-proofs)))
       (lib (cdr signed))
       (proof (library-library-proof lib))
       (signed-first (proof-step-first (car signed)))
       (test (proof-term-at signed-first 2))
       (selected (proof-proof-select proof test parity))
       (ordinary (proof-proof-rewrite proof (car signed) selected '(1 2)))
       (zero-base (proof-proof-assume proof fixed-zero t))
       (signed-zero (b1-parity-negate-fixed-zero lib base zero-base))
       (exponent-zero (proof-eq i *proof-zero*))
       (zero (proof-proof-assume proof exponent-zero t))
       (parity-first (proof-step-first parity))
       (at-zero
        (if (proof-is-call parity-first *proof-integerp*)
            (proof-with-checked-results
                ((base-zero (b1-powers-expt-zero lib base))
                 (negative-base-zero (b1-powers-expt-zero lib negative-base)))
              (b1-logic-bookproof-normalize-proof
               lib claim nil nil (list (b1-logic-equal-to zero) (b1-logic-equal-to base-zero)
                                       (b1-logic-equal-to negative-base-zero)) nil))
          (proof-with-checked-results
              ((not-odd (b1-logic-bookproof-normalize-proof
                         lib (library-integer (b1-parity-half i)) nil nil (list (b1-logic-equal-to zero)) nil)))
            (b1-logic-bookproof-contradiction lib not-odd parity claim))))
       (not-zero (proof-proof-assume proof exponent-zero nil))
       (ordinary-zero (b1-logic-bookproof-normalize lib (b1-powers-expt base i)
                                                    (list not-zero integer-i zero-base)
                                                    (seq-slice *b1-powers-expt-unfold* :none -1)
                                                    nil nil nil nil))
       (signed-zero (b1-logic-bookproof-normalize lib (b1-powers-expt negative-base i)
                                                  (list not-zero integer-i) *b1-powers-expt-unfold*
                                                  (list (b1-logic-equal-to signed-zero)) nil nil nil))
       (nonzero-exponent (b1-logic-bookproof-normalize-proof
                          lib claim nil nil (list (b1-logic-equal-to ordinary-zero)
                                                  (b1-logic-equal-to signed-zero)) nil))
       (degenerate (proof-proof-cases proof exponent-zero at-zero nonzero-exponent))
       (cases (proof-proof-cases proof fixed-zero degenerate ordinary))
       (step (proof-proof-transport proof cases canonical)))
    (cons step lib)))

(defun b1-parity-negated-base (lib formula)
  (proof-with-checked-results
      ((term (proof-term-at formula 2))
       (canonical (b1-parity-negated-base-normalize 1000000 lib term nil))
       (lib (cdr canonical))
       (canonical-first (proof-step-first (car canonical)))
       (claim (proof-term-at canonical-first 2))
       (signed-power (proof-term-at claim 1))
       (parts (proof-list-of-length signed-power 3))
       (negative-base (cadr parts))
       (i (caddr parts))
       (base (proof-term-at negative-base 1))
       (fixed-zero (proof-eq (list *b1-powers-fix* base) *proof-zero*))
       (premise (b1-logic-bookproof-prove-implication-premise lib formula))
       (consequence (b1-parity-negated-base-consequence
                     premise lib base fixed-zero claim (car canonical) i negative-base))
       (lib (cdr consequence))
       (step (b1-logic-bookproof-prove-implication-with-premise lib formula premise (car consequence))))
    (cons step lib)))
