(in-package "BOYMOO-PROVER")
(set-verify-guards-eagerness 0)

(defconst *b1-bitwise-logand* (proof-sym "BINARY-LOGAND" "ACL2"))
(defconst *b1-bitwise-two* (proof-quote 2))
(defconst *b1-bitwise-half* (proof-quote '("ratio" 1 2)))

(defun b1-bitwise-twice (lib argument numeric)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((distribution (library-library-axiom lib "DISTRIBUTIVITY"
                                               (list argument *proof-one* *proof-one*)))
         (doubled (proof-proof-symmetric proof distribution))
         (unit (b1-arithmetic-multiply-one lib argument (list numeric) nil))
         (doubled (proof-proof-rewrite proof doubled unit '(1 1 1)))
         (unit (b1-arithmetic-multiply-one lib argument (list numeric) nil))
         (doubled (proof-proof-rewrite proof doubled unit '(1 1 2)))
         (two (b1-logic-bookproof-constant lib (library-plus *proof-one* *proof-one*)))
         (doubled (proof-proof-rewrite proof doubled two '(1 2 2)))
         (commuted (library-library-axiom lib "COMMUTATIVITY-OF-*"
                                           (list argument *b1-bitwise-two*))))
      (proof-proof-chain proof doubled (list commuted)))))

(defun b1-bitwise-floor-half-descent-finish
    (strict sign-f sign-i reflected lib sums f i int-f int-i nums)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((strict (if reflected
                     (proof-with-checked-results
                         ((first (proof-step-first strict))
                          (reverse (b1-arithmetic-number-sums-comparison-equation
                                    sums first (library-lt (library-minus f) (library-minus i)) nums)))
                       (proof-proof-rewrite proof strict reverse '(1)))
                   strict))
         (count-f (b1-quotient-count-integer lib int-f sign-f))
         (count-i (b1-quotient-count-integer lib int-i sign-i))
         (strict (library-library-transport-argument lib strict count-f 1))
         (strict (library-library-transport-argument lib strict count-i 2))
         (ordinal (library-library-ordinal-comparison lib (list *library-count* f)
                                                       (list *library-count* i))))
      (proof-proof-transport proof strict ordinal))))

(defun b1-bitwise-floor-half-descent (lib)
  (let* ((name (proof-sym "SELF-SIGNED-HALVING-DECREASE" "ACL2"))
         (proof (library-library-proof lib)))
    (if (assoc-equal name (proof-proof-facts proof))
        (cons name lib)
      (let* ((i *library-x*)
             (f (list *b1-quotient-floor* i *b1-bitwise-two*))
             (zip (list *b1-quotient-zip* i))
             (nonzero-i (proof-eq i *proof-zero*))
             (minus-one-i (proof-eq i *proof-neg-one*))
             (recip (b1-arithmetic-reciprocal *b1-bitwise-two*)))
        (proof-with-checked-results
            ((no-zip (proof-proof-assume proof zip nil))
             (not-minus-one (proof-proof-assume proof minus-one-i nil))
             (int-i (b1-logic-bookproof-forces
                     lib (library-integer i) no-zip nil
                     (list *b1-quotient-zip* *b1-quotient-numeric-eq* *proof-not*) nil))
             (is-zero (proof-proof-assume proof nonzero-i t))
             (zip-zero (b1-logic-bookproof-normalize-proof
                        lib zip (list int-i is-zero)
                        (list *b1-quotient-zip* *b1-quotient-numeric-eq*) nil nil))
             (nonzero-cut (proof-proof-cut proof zip-zero no-zip))
             (nonzero (proof-proof-front proof nonzero-cut (proof-neg nonzero-i)))
             (rat-i (b1-arithmetic-known-type lib *library-rationalp* i (list int-i)))
             (num-i (b1-arithmetic-known-type lib *library-numberp* i (list int-i)))
             (raw-ratio (b1-arithmetic-product i recip))
             (ratio (b1-arithmetic-product i *b1-bitwise-half*))
             (rat-raw (b1-arithmetic-known-type lib *library-rationalp* raw-ratio (list rat-i)))
             (interval (b1-floor-interval lib f rat-raw))
             (lib (cdr interval))
             (proof (library-library-proof lib))
             (facts (car interval))
             (constant (b1-logic-bookproof-constant lib recip))
             (int-f (proof-proof-rewrite-first proof (car facts) constant))
             (constant (b1-logic-bookproof-constant lib recip))
             (lower (proof-proof-rewrite-first proof (cadr facts) constant))
             (constant (b1-logic-bookproof-constant lib recip))
             (upper (proof-proof-rewrite-first proof (caddr facts) constant))
             (rational-ratio (b1-arithmetic-known-type lib *library-rationalp* ratio (list rat-i)))
             (number-f (b1-arithmetic-known-type lib *library-numberp* f (list int-f)))
             (nums (list num-i number-f))
             (sums (b1-arithmetic-number-sums-init lib))
             (lib (b1-arithmetic-number-sums-library sums))
             (proof (library-library-proof lib))
             (half-sign (b1-logic-bookproof-constant lib (library-positive *b1-bitwise-half*)))
             (positive-half (proof-proof-true-from-eq proof half-sign))
             (numeric-ratio (b1-arithmetic-known-type lib *library-numberp* ratio nil))
             (twice-r (b1-bitwise-twice lib ratio numeric-ratio))
             (scaled (library-library-axiom lib "ASSOCIATIVITY-OF-*"
                                            (list i *b1-bitwise-half* *b1-bitwise-two*)))
             (unit (b1-logic-bookproof-constant
                    lib (b1-arithmetic-product *b1-bitwise-half* *b1-bitwise-two*)))
             (scaled (proof-proof-rewrite proof scaled unit '(1 2 2)))
             (unit (b1-arithmetic-multiply-one lib i (list num-i) nil))
             (scaled (proof-proof-chain proof scaled (list unit)))
             (commuted (library-library-axiom lib "COMMUTATIVITY-OF-*"
                                             (list *b1-bitwise-two* ratio)))
             (two-ratio (proof-proof-chain proof commuted (list scaled)))
             (double (proof-proof-chain proof twice-r (list two-ratio)))

             (pos-i (proof-proof-assume proof (library-positive i) t))
             (productive (b1-arithmetic-positive-product lib pos-i positive-half (list rat-i)))
             (half-less (b1-arithmetic-number-sums-comparison-equation
                         sums (library-lt ratio (library-plus ratio ratio))
                         (proof-step-first productive) nums))
             (half-less (proof-proof-rewrite proof half-less double '(1 1 2)))
             (half-less (proof-proof-transport proof productive half-less))
             (smaller (b1-floor-weak-then-strict lib sums lower half-less nums))
             (f-negative (proof-proof-assume proof (library-lt f *proof-zero*) t))
             (int-zero (library-library-type-of lib *proof-zero* nil))
             (advance (b1-floor-advance-bound lib f-negative int-f int-zero))
             (below-zero (car advance))
             (lib (cdr advance))
             (proof (library-library-proof lib))
             (sums (b1-arithmetic-number-sums-with-library sums lib))
             (impossible (b1-floor-strict-then-weak lib sums upper below-zero nums))
             (weak-productive (b1-arithmetic-number-sums-weaken sums productive nums))
             (f-cut (proof-proof-cut proof impossible weak-productive))
             (f-nonnegative (proof-proof-front proof f-cut (library-nonnegative f)))
             (i-nonnegative (library-library-cite lib "POSITIVE-NONNEGATIVE" (list i)
                                                 (list int-i pos-i)))
             (positive-case (b1-bitwise-floor-half-descent-finish
                             smaller f-nonnegative i-nonnegative nil lib sums f i int-f int-i nums))

             (not-positive (proof-proof-assume proof (library-positive i) nil))
             (compare (b1-arithmetic-integer-compare lib i *proof-zero* (list int-i)))
             (ordering (proof-proof-cut proof compare not-positive))
             (zero-first (proof-proof-front proof ordering nonzero-i))
             (nonzero-cut (proof-proof-cut proof zero-first nonzero))
             (negative-i (proof-proof-front proof nonzero-cut (library-lt i *proof-zero*)))
             (multiply (b1-arithmetic-multiply-strict lib positive-half negative-i (list rat-i)))
             (negative-ratio (car multiply))
             (lib (cdr multiply))
             (proof (library-library-proof lib))
             (sums (b1-arithmetic-number-sums-with-library sums lib))
             (commuted (library-library-axiom lib "COMMUTATIVITY-OF-*"
                                             (list *b1-bitwise-half* i)))
             (negative-ratio (proof-proof-rewrite proof negative-ratio commuted '(1 1)))
             (zero (b1-arithmetic-multiply-zero lib *b1-bitwise-half*))
             (negative-ratio (proof-proof-rewrite proof negative-ratio zero '(1 2)))
             (negative-f (b1-floor-weak-then-strict lib sums lower negative-ratio nums))

             (neg-i (library-minus i))
             (neg-int (library-library-type-of lib neg-i (list int-i)))
             (comparison (library-library-comparison lib i *proof-zero* (list int-i)))
             (pos-neg-i (proof-proof-rewrite proof negative-i comparison '(1)))
             (left-zero (library-library-cite lib "ADD-ZERO-LEFT" (list neg-i) (list neg-int)))
             (pos-neg-i (proof-proof-rewrite proof pos-neg-i left-zero '(1 2)))
             (neg-ge-one (b1-arithmetic-integer-discrete lib pos-neg-i neg-int))
             (neg-unit (proof-eq neg-i *proof-one*))
             (reflected (proof-proof-reflexive proof (library-minus neg-i)))
             (unit (proof-proof-assume proof neg-unit t))
             (reflected (proof-proof-rewrite proof reflected unit '(1 2 1)))
             (double-negative (library-library-cite lib "DOUBLE-NEGATION" (list i) (list int-i)))
             (reflected (proof-proof-rewrite proof reflected double-negative '(1 1)))
             (minus-one (b1-logic-bookproof-constant lib (library-minus *proof-one*)))
             (reflected (proof-proof-chain proof reflected (list minus-one)))
             (unit-cut (proof-proof-cut proof reflected not-minus-one))
             (neg-not-unit (proof-proof-front proof unit-cut (proof-neg neg-unit)))
             (larger (b1-arithmetic-integer-compare lib neg-i *proof-one* (list int-i neg-int)))
             (larger (proof-proof-discharge proof larger neg-ge-one))
             (larger (proof-proof-discharge proof larger neg-not-unit))
             (reflect (b1-arithmetic-reflect-minus-one lib i num-i))
             (lib (cdr reflect))
             (proof (library-library-proof lib))
             (below-minus-one (proof-proof-transport proof larger (car reflect)))
             (int-minus-one (library-library-type-of lib *proof-neg-one* nil))
             (advance (b1-floor-advance-bound lib below-minus-one int-i int-minus-one))
             (step-le-neg-one (car advance))
             (lib (cdr advance))
             (proof (library-library-proof lib))
             (step-i (library-plus *proof-one* i))
             (too-small (library-lt ratio step-i))
             (two-pos (proof-proof-prove proof (library-positive *b1-bitwise-two*) nil nil))
             (bad (proof-proof-assume proof too-small t))
             (multiply (b1-arithmetic-multiply-strict lib two-pos bad (list rational-ratio rat-i)))
             (doubled-bad (car multiply))
             (lib (cdr multiply))
             (proof (library-library-proof lib))
             (sums (b1-arithmetic-number-sums-with-library sums lib))
             (doubled-bad (proof-proof-rewrite proof doubled-bad two-ratio '(1 1)))
             (step-num (b1-arithmetic-known-type lib *library-numberp* step-i nil))
             (twice-step (b1-bitwise-twice lib step-i step-num))
             (twice-step (proof-proof-symmetric proof twice-step))
             (doubled-bad (proof-proof-rewrite proof doubled-bad twice-step '(1 2)))
             (aligned (b1-arithmetic-number-sums-comparison-equation
                       sums (proof-step-first doubled-bad) (cadr (proof-step-first step-le-neg-one)) nums))
             (impossible (proof-proof-rewrite proof doubled-bad aligned '(1)))
             (small-cut (proof-proof-cut proof impossible step-le-neg-one))
             (ratio-leap (proof-proof-front proof small-cut (proof-neg too-small)))

             (under (proof-proof-assume proof (library-lt i f) nil))
             (adjusted (b1-arithmetic-number-sums-comparison-equation
                        sums (cadr (proof-step-first under))
                        (library-lt step-i (library-plus *proof-one* f)) nums))
             (under (proof-proof-rewrite proof under adjusted '(1 1)))
             (impossible (b1-floor-strict-then-weak lib sums upper under nums))
             (under-cut (proof-proof-cut proof impossible ratio-leap))
             (greater-f (proof-proof-front proof under-cut (library-lt i f)))
             (negative-case (b1-bitwise-floor-half-descent-finish
                             greater-f negative-f negative-i t lib sums f i int-f int-i nums))
             (step (proof-proof-cases proof (library-positive i) positive-case negative-case))
             (claim (list *proof-ordinal-less* (list *library-count* f) (list *library-count* i)))
             (lib (library-library-lemma lib "SIGNED-HALVING-DECREASE" claim step
                                         (list zip minus-one-i))))
          (cons name lib))))))

(defun b1-bitwise-logand-commutative-rules (lib evidence flags)
  (if (or (endp evidence) (endp flags))
      nil
    (if (car flags)
        (let ((proof (library-library-proof lib)))
          (proof-with-checked-results
              ((literal (proof-step-first (car evidence)))
               (opened (proof-proof-unfold proof literal))
               (equality (proof-proof-rewrite proof (car evidence) opened '(1)))
               (rule (b1-logic-equal-to equality))
               (rest (b1-bitwise-logand-commutative-rules lib (cdr evidence) (cdr flags))))
            (cons rule rest)))
      (b1-bitwise-logand-commutative-rules lib (cdr evidence) (cdr flags)))))

(defun b1-bitwise-logand-commutative-cases
    (pending evidence flags lib formula x minus-one-x substitutions)
  (let ((proof (library-library-proof lib)))
    (cond
     ((consp pending)
      (let ((test (car pending)))
        (proof-with-checked-results
            ((assumed (proof-proof-assume proof test t))
             (yes (b1-bitwise-logand-commutative-cases
                   (cdr pending) (append evidence (list assumed)) (append flags (list t))
                   lib formula x minus-one-x substitutions))
             (lib (cdr yes))
             (proof (library-library-proof lib))
             (assumed (proof-proof-assume proof test nil))
             (no (b1-bitwise-logand-commutative-cases
                  (cdr pending) (append evidence (list assumed)) (append flags (list nil))
                  lib formula x minus-one-x substitutions))
             (lib (cdr no))
             (step (proof-proof-cases (library-library-proof lib) test (car yes) (car no))))
          (cons step lib))))
     ((member-eq t flags)
      (proof-with-checked-results
          ((opened (b1-logic-bookproof-normalize lib formula evidence (list *b1-bitwise-logand*)
                                                nil nil nil nil))
           (rules (b1-bitwise-logand-commutative-rules lib (cddr evidence) (cddr flags)))
           (step (b1-logic-bookproof-normalize-proof lib (caddr (proof-step-first opened))
                                                    nil nil rules nil))
           (result (proof-proof-transport proof step opened)))
        (cons result lib)))
     (t
      (proof-with-checked-results
          ((parts (proof-list-of-length evidence 4))
           (unfolded (proof-proof-unfold proof minus-one-x))
           (exact (proof-proof-rewrite proof (caddr parts) unfolded '(1 1)))
           (lemma (b1-bitwise-floor-half-descent lib))
           (lib (cdr lemma))
           (proof (library-library-proof lib))
           (descent (proof-proof-use proof (car lemma) (list (list *library-x* x))
                                     (list (car parts) exact)))
           (child (proof-subst formula substitutions))
           (assumed (proof-proof-assume proof (proof-ite (proof-step-first descent) child *proof-true*) t))
           (hypothesis (proof-proof-prove-if proof assumed descent))
           (result (b1-logic-bookproof-case-proof lib formula evidence (list *b1-bitwise-logand*)
                                                 (list (b1-logic-equal-to hypothesis)) 16)))
        (cons result lib))))))

(defun b1-bitwise-logand-commutative (lib formula)
  (proof-with-checked-results
      ((left (proof-term-at formula 1))
       (operands (if (integerp left)
                     (proof-term-at left 1)
                   (proof-list-of-length (seq-slice left 1 :none) 2))))
    (let* ((x (car operands))
           (y (cadr operands))
           (f (list *b1-quotient-floor* x *b1-bitwise-two*))
           (g (list *b1-quotient-floor* y *b1-bitwise-two*))
           (substitutions (table-put (list (cons x f)) y g))
           (measure (list *library-count* x))
           (zip-x (list *b1-quotient-zip* x))
           (zip-y (list *b1-quotient-zip* y))
           (minus-one-x (list *b1-logic-eql* x *proof-neg-one*))
           (minus-one-y (list *b1-logic-eql* y *proof-neg-one*)))
      (proof-with-checked-results
          ((cases (b1-bitwise-logand-commutative-cases
                   (list zip-x zip-y minus-one-x minus-one-y) nil nil
                   lib formula x minus-one-x substitutions))
           (lib (cdr cases))
           (ordinal (library-library-builtin lib 1 x))
           (step (proof-proof-induct (library-library-proof lib) ordinal (car cases) formula measure
                                     (list (table-items substitutions)))))
        (cons step lib)))))

(defun b1-bitwise-interchange-logand (lib formula)
  (proof-with-checked-results
      ((left (proof-term-at formula 1))
       (outer (proof-list-of-length left 3))
       (inner (proof-list-of-length (caddr outer) 3)))
    (let ((y (cadr outer))
          (x (cadr inner))
          (z (caddr inner))
          (assoc (proof-sym "LOGAND-ASSOC" "ACL2"))
          (proof (library-library-proof lib))
          (variables (list *library-x* *library-y* *library-z*)))
      (proof-with-checked-results
          ((yz (proof-proof-fact proof assoc (seq-zip variables (list y x z))))
           (xy (b1-logic-bookproof-from-fact
                lib (proof-sym "LOGAND-Y-X" "ACL2")
                (proof-eq (list *b1-bitwise-logand* y x) (list *b1-bitwise-logand* x y))))
           (reversed (proof-proof-symmetric proof yz))
           (group (proof-proof-rewrite proof reversed xy '(1 2 1)))
           (grouped (proof-proof-fact proof assoc (seq-zip variables (list x y z)))))
        (proof-proof-chain proof group (list grouped))))))
