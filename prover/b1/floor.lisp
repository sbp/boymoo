(in-package "BOYMOO-PROVER")
(set-verify-guards-eagerness 0)

(defun b1-floor-term-at (term place)
  (declare (xargs :measure (acl2-count place)))
  (if (endp place)
      term
    (proof-with-checked-results ((part (proof-term-at term (car place))))
      (b1-floor-term-at part (cdr place)))))

(defun b1-floor-step-at (step place)
  (proof-with-checked-results ((literal (b1-logic-step-first step)))
    (b1-floor-term-at literal place)))

(defun b1-floor-quotient-interval-cancel (lib strict terms position d inverse rational)
  (declare (xargs :measure (acl2-count terms)))
  (if (endp terms)
      strict
    (proof-with-checked-results
        ((numeric (b1-arithmetic-known-type lib *library-numberp* (car terms) (list rational)))
         (reduce-step (b1-powers-multiply-inverse lib (b1-arithmetic-reciprocal d) d
                                                  (car terms) inverse numeric))
         (strict (library-inherited proof-proof-rewrite lib strict reduce-step (list 1 position))))
      (b1-floor-quotient-interval-cancel lib strict (cdr terms) (1+ position) d inverse rational))))

(defun b1-floor-quotient-interval (lib rational representation int-n int-d pos-d nonnegative)
  (proof-with-checked-results
      ((n (b1-floor-step-at int-n '(1)))
       (d (b1-floor-step-at int-d '(1)))
       (bound (b1-quotient-quotient-bounds lib))
       (lib (cdr bound))
       (fact (library-inherited proof-proof-fact lib (car bound)
                                (list (list *library-x* n) (list *library-y* d))))
       (test (b1-floor-step-at fact '(1)))
       (premise (b1-logic-bookproof-normalize-proof lib test (list int-n int-d pos-d nonnegative)
                                                  nil nil nil))
       (supported (library-inherited proof-proof-modus-ponens lib fact premise))
       (parts (b1-logic-bookproof-split-conjuncts lib supported))
       (parts (proof-list-of-length parts 3))
       (q (b1-floor-step-at (car parts) '(1)))
       (int-q (library-library-cite lib "NATURAL-INTEGER" (list q) (list (car parts))))
       (rational-d (b1-arithmetic-known-type lib *library-rationalp* d (list int-d)))
       (numeric-d (b1-arithmetic-known-type lib *library-numberp* d (list int-d)))
       (value (b1-floor-step-at rational '(1)))
       (reciprocal-positive (b1-arithmetic-positive-reciprocal lib pos-d rational-d))
       (lib (cdr reciprocal-positive))
       (nonzero (b1-arithmetic-positive-nonzero lib pos-d))
       (inverse (b1-arithmetic-inverse-product lib d numeric-d nonzero))
       (commute (library-library-axiom lib "COMMUTATIVITY-OF-*"
                                       (list (b1-arithmetic-reciprocal d) d)))
       (inverse (library-inherited proof-proof-chain lib commute (list inverse)))
       (strict (b1-arithmetic-multiply-strict lib (car reciprocal-positive) (caddr parts)
                                             (list int-n int-d int-q)))
       (lib (cdr strict))
       (symmetric (library-inherited proof-proof-symmetric lib representation))
       (strict (library-inherited proof-proof-rewrite lib (car strict) symmetric '(1 1 2)))
       (strict (b1-floor-quotient-interval-cancel lib strict (list value (library-plus *proof-one* q))
                                                 1 d inverse rational)))
    (let ((bad (library-lt value q)))
      (proof-with-checked-results
          ((assumed (library-inherited proof-proof-assume lib bad t))
           (impossible (b1-arithmetic-multiply-strict lib pos-d assumed (list int-d rational int-q)))
           (lib (cdr impossible))
           (impossible (library-inherited proof-proof-rewrite lib (car impossible) representation '(1 1)))
           (cut (library-inherited proof-proof-cut lib impossible (cadr parts)))
           (lower-bound (library-inherited proof-proof-front lib cut (proof-neg bad))))
        (cons (list int-q lower-bound strict) lib)))))

(defun b1-floor-retarget-interval (lib equality int-p lower-p upper-p)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((int-p (library-library-transport-argument lib int-p equality 1))
         (reverse-eq (proof-proof-symmetric proof equality))
         (lower-p (proof-proof-rewrite proof lower-p reverse-eq '(1 1 2)))
         (lower-p (proof-proof-tidy proof lower-p))
         (reverse-eq (proof-proof-symmetric proof equality))
         (upper-p (proof-proof-rewrite proof upper-p reverse-eq '(1 2 2)))
         (upper-p (proof-proof-tidy proof upper-p)))
      (list int-p lower-p upper-p))))

(defun b1-floor-floor-interval-lemma-consequence-open-floor (conditions lib floor fix-value)
  (b1-logic-bookproof-normalize lib floor conditions
                                (list *b1-quotient-floor* *b1-quotient-numeric-eq* *proof-not*)
                                (list fix-value) nil nil nil))

(defun b1-floor-floor-interval-lemma-consequence-combine
    (equality int-p lower-p upper-p lib claim)
  (proof-with-checked-results
      ((parts (b1-floor-retarget-interval lib equality int-p lower-p upper-p)))
    (b1-logic-bookproof-normalize-proof lib claim parts nil nil nil)))

(defun b1-floor-floor-interval-lemma-integral
    (lib d-one representation value numeric int-n sums floor fix-value claim)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((n-identity (proof-proof-rewrite proof representation d-one '(1 1 1)))
         (one (b1-arithmetic-multiply-one lib value (list numeric) t))
         (n-identity (proof-proof-rewrite proof n-identity one '(1 1)))
         (opened (b1-floor-floor-interval-lemma-consequence-open-floor (list d-one) lib floor fix-value))
         (symmetric (proof-proof-symmetric proof n-identity))
         (equality (proof-proof-chain proof opened (list symmetric)))
         (symmetric (proof-proof-symmetric proof n-identity))
         (integer-value (proof-proof-rewrite proof int-n symmetric '(1 1)))
         (irreflexive (b1-arithmetic-number-sums-comparison-equation
                       sums (library-lt value value) (library-lt *proof-zero* *proof-zero*) (list numeric)))
         (zero (library-library-axiom lib "ZERO" nil))
         (lower-value (library-library-transport-argument lib zero irreflexive 1))
         (upper-value (b1-integer-successor-is-larger lib value)))
      (b1-floor-floor-interval-lemma-consequence-combine equality integer-value lower-value upper-value
                                                        lib claim))))

(defun b1-floor-floor-interval-lemma-negative
    (lib n d value int-n int-d pos-d rational representation d-not-one test-negative
     sums numeric floor fix-value claim)
  (let ((neg-n (library-minus n)))
    (proof-with-checked-results
        ((comparison (library-library-comparison lib n *proof-zero* (list int-n)))
         (negative (library-inherited proof-proof-rewrite lib test-negative comparison '(1)))
         (neg-int (library-library-type-of lib neg-n (list int-n)))
         (add-zero (library-library-cite lib "ADD-ZERO-LEFT" (list neg-n) (list neg-int)))
         (negative (library-inherited proof-proof-rewrite lib negative add-zero '(1 2)))
         (neg-n-nonnegative (library-library-cite lib "POSITIVE-NONNEGATIVE" (list neg-n)
                                                 (list neg-int negative)))
         (represented (b1-arithmetic-multiply-negation lib d value))
         (lib (cdr represented))
         (represented (library-inherited proof-proof-rewrite lib (car represented) representation '(1 2 1)))
         (rational-negative (b1-arithmetic-known-type lib *library-rationalp* (library-minus value)
                                                      (list rational)))
         (interval (b1-floor-quotient-interval lib rational-negative represented neg-int int-d
                                              pos-d neg-n-nonnegative))
         (lib (cdr interval))
         (sums (b1-arithmetic-number-sums-with-library sums lib))
         (q (b1-floor-step-at (caar interval) '(1))))
      (let* ((int-q (caar interval))
             (lower-neg (cadar interval))
             (upper-neg (caddar interval))
             (distinct (proof-eq (library-minus value) q)))
        (proof-with-checked-results
            ((int-q-neg (library-library-type-of lib (library-minus q) (list int-q)))
             (opposite (library-inherited proof-proof-reflexive lib (library-minus (library-minus value))))
             (assumed (library-inherited proof-proof-assume lib distinct t))
             (opposite (library-inherited proof-proof-rewrite lib opposite assumed '(1 2 1)))
             (double (b1-arithmetic-number-sums-cite sums "DOUBLE-NEGATION" (list value) (list numeric)))
             (opposite (library-inherited proof-proof-rewrite lib opposite double '(1 1)))
             (value-integer (library-library-transport-argument lib int-q-neg opposite 1))
             (impossible (b1-arithmetic-denominator-of-integer lib value-integer))
             (cut (library-inherited proof-proof-cut lib impossible d-not-one))
             (no-equal (library-inherited proof-proof-front lib cut (proof-neg distinct)))
             (q-numeric (b1-arithmetic-known-type lib *library-numberp* q (list int-q))))
          (let ((numbers (list numeric q-numeric))
                (floor-value (library-plus (library-minus q) *proof-neg-one*)))
            (proof-with-checked-results
                ((sign (b1-arithmetic-comparison-cases lib (library-minus value) q numbers sums))
                 (sign (library-inherited proof-proof-discharge lib sign lower-neg))
                 (sign (library-inherited proof-proof-discharge lib sign no-equal))
                 (int-floor-value (library-library-type-of lib floor-value (list int-q)))
                 (upper-neg-test (b1-logic-step-first upper-neg))
                 (reflected-lower (b1-arithmetic-number-sums-comparison-equation
                                   sums upper-neg-test (library-lt floor-value value) numbers))
                 (lower-value (library-inherited proof-proof-rewrite lib upper-neg reflected-lower '(1)))
                 (lower-value (b1-arithmetic-number-sums-weaken sums lower-value numbers))
                 (sign-test (b1-logic-step-first sign))
                 (reflected-upper (b1-arithmetic-number-sums-comparison-equation
                                   sums sign-test (library-lt value (library-plus *proof-one* floor-value)) numbers))
                 (upper-value (library-inherited proof-proof-rewrite lib sign reflected-upper '(1)))
                 (opened (b1-floor-floor-interval-lemma-consequence-open-floor
                          (list d-not-one test-negative) lib floor fix-value))
                 (step (b1-floor-floor-interval-lemma-consequence-combine
                        opened int-floor-value lower-value upper-value lib claim)))
              (cons step lib))))))))

(defun b1-floor-floor-interval-lemma-consequence (rational lib sums value floor claim)
  (proof-with-checked-results
      ((numerator (b1-arithmetic-numerator-product lib rational))
       (parts (cadr numerator))
       (n (b1-floor-step-at (cadr parts) '(1)))
       (d (b1-floor-step-at (car parts) '(1)))
       (commute (library-library-axiom lib "COMMUTATIVITY-OF-*" (list d value)))
       (representation (library-inherited proof-proof-chain lib commute (list (car numerator)))))
    (let ((int-d (car parts))
          (int-n (cadr parts))
          (pos-d (caddr parts))
          (unit (proof-eq d *proof-one*))
          (negative-n (library-lt n *proof-zero*)))
      (proof-with-checked-results
          ((numeric (b1-arithmetic-known-type lib *library-numberp* value (list rational)))
           (one (b1-arithmetic-multiply-one lib value (list numeric) nil))
           (fix-value (b1-logic-equal-to one))
           (d-one (library-inherited proof-proof-assume lib unit t))
           (integral-case (b1-floor-floor-interval-lemma-integral
                           lib d-one representation value numeric int-n sums floor fix-value claim))
           (d-not-one (library-inherited proof-proof-assume lib unit nil))
           (nonnegative (library-inherited proof-proof-assume lib negative-n nil))
           (positive-interval (b1-floor-quotient-interval lib rational representation int-n int-d
                                                         pos-d nonnegative))
           (lib (cdr positive-interval))
           (opened (b1-floor-floor-interval-lemma-consequence-open-floor
                    (list d-not-one nonnegative) lib floor fix-value))
           (positive-case (b1-floor-floor-interval-lemma-consequence-combine
                           opened (caar positive-interval) (cadar positive-interval)
                           (caddar positive-interval) lib claim))
           (test-negative (library-inherited proof-proof-assume lib negative-n t))
           (negative-case (b1-floor-floor-interval-lemma-negative
                           lib n d value int-n int-d pos-d rational representation d-not-one test-negative
                           sums numeric floor fix-value claim))
           (lib (cdr negative-case))
           (nonunit (library-inherited proof-proof-cases lib negative-n (car negative-case) positive-case))
           (step (library-inherited proof-proof-cases lib unit integral-case nonunit)))
        (cons step lib)))))

(defun b1-floor-floor-interval-lemma (lib)
  (let ((name (proof-sym "SELF-FLOOR-INTERVAL" "ACL2")))
    (if (assoc-equal name (proof-proof-facts (library-library-proof lib)))
        (cons name lib)
      (proof-with-checked-results
          ((sums (b1-arithmetic-number-sums-init lib))
           (lib (b1-arithmetic-number-sums-library sums)))
        (let* ((value *library-x*)
               (floor (list *b1-quotient-floor* value *proof-one*))
               (lower (proof-neg (library-lt value floor)))
               (upper (library-lt value (library-plus *proof-one* floor)))
               (claim (proof-ite (library-integer floor) (proof-ite lower upper *proof-false*) *proof-false*))
               (formula (list *library-implies* (list *library-rationalp* value) claim)))
          (proof-with-checked-results
              ((premise (b1-logic-bookproof-prove-implication-premise lib formula))
               (consequence (b1-floor-floor-interval-lemma-consequence premise lib sums value floor claim))
               (lib (cdr consequence))
               (proof (b1-logic-bookproof-prove-implication-with-premise lib formula premise (car consequence)))
               (lib (library-library-lemma lib "FLOOR-INTERVAL" formula proof nil)))
            (cons name lib)))))))

(defun b1-floor-floor-of-ratio-beta-task (result)
  (proof-with-checked-results
      ((term (b1-floor-step-at result '(2)))
       (head (proof-term-at term 0)))
    (if (proof-compound head)
        (list :beta result term)
      (list :done result))))

(defun b1-floor-floor-of-ratio-beta-next (lib pending)
  (proof-with-checked-results
      ((beta (library-inherited proof-proof-beta lib (caddr pending)))
       (result (library-inherited proof-proof-chain lib (cadr pending) (list beta))))
    (b1-floor-floor-of-ratio-beta-task result)))

(defun b1-floor-floor-of-ratio-beta (n lib pending)
  (declare (xargs :measure (nfix n)))
  (cond ((zp n) '(:failure "Fuel" "b1-floor-floor-of-ratio-beta"))
        ((failure-p pending) pending)
        ((eq (car pending) :done) (cadr pending))
        (t (b1-floor-floor-of-ratio-beta (1- n) lib (b1-floor-floor-of-ratio-beta-next lib pending)))))

(defun b1-floor-floor-of-ratio-beta-floor (term lib)
  (proof-with-checked-results ((opened (library-inherited proof-proof-unfold lib term)))
    (b1-floor-floor-of-ratio-beta 1000000 lib (b1-floor-floor-of-ratio-beta-task opened))))

(defun b1-floor-floor-of-ratio (lib floor)
  (proof-with-checked-results ((parts (proof-list-of-length floor 3)))
    (let ((proof (library-library-proof lib))
          (ratio (b1-arithmetic-product (cadr parts) (b1-arithmetic-reciprocal (caddr parts)))))
      (proof-with-checked-results
          ((original (b1-floor-floor-of-ratio-beta-floor floor lib))
           (normal (b1-floor-floor-of-ratio-beta-floor (list *b1-quotient-floor* ratio *proof-one*) lib))
           (raw (proof-proof-reflexive proof (b1-arithmetic-product ratio
                                                                    (b1-arithmetic-reciprocal *proof-one*))))
           (unit (b1-logic-bookproof-constant lib (b1-arithmetic-reciprocal *proof-one*)))
           (unit (proof-proof-rewrite proof raw unit '(1 2 2)))
           (one (b1-arithmetic-multiply-one lib ratio nil nil))
           (unit (proof-proof-chain proof unit (list one)))
           (normal (proof-proof-rewrite-first proof normal unit))
           (normal (proof-proof-symmetric proof normal)))
        (proof-proof-chain proof original (list normal))))))

(defun b1-floor-interval (lib floor rational)
  (proof-with-checked-results
      ((parts (proof-list-of-length floor 3))
       (lemma (b1-floor-floor-interval-lemma lib))
       (lib (cdr lemma)))
    (let ((ratio (b1-arithmetic-product (cadr parts) (b1-arithmetic-reciprocal (caddr parts)))))
      (proof-with-checked-results
          ((instance (library-inherited proof-proof-fact lib (car lemma) (list (list *library-x* ratio))))
           (instance (library-inherited proof-proof-modus-ponens lib instance rational))
           (conjuncts (b1-logic-bookproof-split-conjuncts lib instance))
           (interval (proof-list-of-length conjuncts 3))
           (equality (b1-floor-floor-of-ratio lib floor))
           (interval (b1-floor-retarget-interval lib equality (car interval) (cadr interval) (caddr interval))))
        (cons interval lib)))))

(defun b1-floor-strict-then-weak (lib sums strict weak numbers)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((left (b1-logic-step-first strict))
         (left (proof-list-of-length (cdr left) 2))
         (right (b1-floor-step-at weak '(1)))
         (right (proof-list-of-length (cdr right) 2)))
      (let ((b (cadr left))
            (c (car right))
            (middle (cadr right)))
        (if (not (equal b middle))
            '(:failure "RuleInapplicable" "")
          (let ((test (library-lt b c)))
            (proof-with-checked-results
                ((assumed (proof-proof-assume proof test t))
                 (yes (b1-arithmetic-number-sums-strict-chain sums strict assumed numbers))
                 (compare (b1-arithmetic-comparison-cases lib b c numbers sums))
                 (cut (proof-proof-cut proof compare weak))
                 (same (proof-proof-front proof cut (proof-eq b c)))
                 (no (proof-proof-rewrite proof strict same '(1 2))))
              (proof-proof-cases proof test yes no))))))))

(defun b1-floor-weak-then-strict (lib sums weak strict numbers)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((right (b1-logic-step-first strict))
         (right (proof-list-of-length (cdr right) 2))
         (left (b1-floor-step-at weak '(1)))
         (left (proof-list-of-length (cdr left) 2)))
      (let ((a (car right))
            (b (cadr left))
            (middle (car left)))
        (if (not (equal a middle))
            '(:failure "RuleInapplicable" "")
          (let ((test (library-lt b a)))
            (proof-with-checked-results
                ((assumed (proof-proof-assume proof test t))
                 (yes (b1-arithmetic-number-sums-strict-chain sums assumed strict numbers))
                 (compare (b1-arithmetic-comparison-cases lib b a numbers sums))
                 (cut (proof-proof-cut proof compare weak))
                 (same (proof-proof-front proof cut (proof-eq b a)))
                 (same (proof-proof-symmetric proof same))
                 (no (proof-proof-rewrite proof strict same '(1 1))))
              (proof-proof-cases proof test yes no))))))))

(defun b1-floor-advance-bound (lib strict int-a int-b)
  (proof-with-checked-results
      ((comparison (b1-logic-step-first strict))
       (parts (proof-list-of-length (cdr comparison) 2)))
    (let ((a (car parts))
          (b (cadr parts))
          (integers (list int-a int-b)))
      (proof-with-checked-results
          ((comparison (library-library-comparison lib a b integers))
           (gap (library-inherited proof-proof-rewrite lib strict comparison '(1)))
           (gap-int (library-library-type-of lib (library-diff b a) integers))
           (bound (b1-arithmetic-integer-discrete lib gap gap-int))
           (sums (b1-arithmetic-number-sums-init lib))
           (lib (b1-arithmetic-number-sums-library sums))
           (claim (b1-floor-step-at bound '(1)))
           (equation (b1-arithmetic-number-sums-comparison-equation
                      sums claim (library-lt b (library-plus *proof-one* a)) integers))
           (bound (library-inherited proof-proof-rewrite lib bound equation '(1 1))))
        (cons bound lib)))))

(defun b1-floor-unique-interval-lemma-assume (lib x)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((integral (proof-proof-assume proof (library-integer x) t))
         (lower (proof-proof-assume proof (proof-neg (library-lt *library-z* x)) t))
         (upper (proof-proof-assume proof (library-lt *library-z* (library-plus *proof-one* x)) t)))
      (list integral lower upper))))

(defun b1-floor-unique-interval-lemma-forbid (earlier later lib sums numbers)
  (proof-with-checked-results
      ((u (b1-floor-step-at (car earlier) '(1)))
       (v (b1-floor-step-at (car later) '(1))))
    (let ((test (library-lt u v)))
      (proof-with-checked-results
          ((assumed (library-inherited proof-proof-assume lib test t))
           (weak (b1-floor-advance-bound lib assumed (car earlier) (car later)))
           (lib (cdr weak))
           (sums (b1-arithmetic-number-sums-with-library sums lib))
           (contradiction (b1-floor-strict-then-weak lib sums (caddr earlier) (car weak) numbers))
           (cut (library-inherited proof-proof-cut lib contradiction (cadr later)))
           (step (library-inherited proof-proof-front lib cut (proof-neg test))))
        (cons step lib)))))

(defun b1-floor-unique-interval-lemma-conditions (steps)
  (declare (xargs :measure (acl2-count steps)))
  (if (endp steps)
      nil
    (proof-with-checked-results
        ((literal (b1-logic-step-first (car steps)))
         (rest (b1-floor-unique-interval-lemma-conditions (cdr steps))))
      (cons (proof-neg literal) rest))))

(defun b1-floor-unique-interval-lemma (lib)
  (let ((name (proof-sym "SELF-INTERVAL-UNIQUE" "ACL2")))
    (if (assoc-equal name (proof-proof-facts (library-library-proof lib)))
        (cons name lib)
      (proof-with-checked-results
          ((first (b1-floor-unique-interval-lemma-assume lib *library-x*))
           (second (b1-floor-unique-interval-lemma-assume lib *library-y*))
           (rational (library-inherited proof-proof-assume lib (list *library-rationalp* *library-z*) t))
           (sums (b1-arithmetic-number-sums-init lib))
           (lib (b1-arithmetic-number-sums-library sums))
           (a (b1-floor-step-at (car first) '(1)))
           (b (b1-floor-step-at (car second) '(1)))
           (value (b1-floor-step-at rational '(1))))
        (let* ((integers (list (car first) (car second)))
               (evidence (append integers (list rational)))
               (claim (proof-eq a b)))
          (proof-with-checked-results
              ((number-a (b1-arithmetic-known-type lib *library-numberp* a evidence))
               (number-b (b1-arithmetic-known-type lib *library-numberp* b evidence))
               (number-value (b1-arithmetic-known-type lib *library-numberp* value evidence))
               (numbers (list number-a number-b number-value))
               (either-order (b1-arithmetic-integer-compare lib a b integers))
               (backward (b1-floor-unique-interval-lemma-forbid second first lib sums numbers))
               (lib (cdr backward))
               (impossible (library-inherited proof-proof-cut lib either-order (car backward)))
               (impossible (library-inherited proof-proof-front lib impossible (library-lt a b)))
               (sums (b1-arithmetic-number-sums-with-library sums lib))
               (forward (b1-floor-unique-interval-lemma-forbid first second lib sums numbers))
               (lib (cdr forward))
               (proved (library-inherited proof-proof-cut lib impossible (car forward)))
               (proved (library-inherited proof-proof-front lib proved claim))
               (conditions (b1-floor-unique-interval-lemma-conditions (append first second (list rational))))
               (lib (library-library-lemma lib "INTERVAL-UNIQUE" claim proved conditions)))
            (cons name lib)))))))

(defun b1-floor-equal-intervals (lib first second rational)
  (proof-with-checked-results
      ((first-integral (proof-term-at first 0))
       (a (b1-floor-step-at first-integral '(1)))
       (second-integral (proof-term-at second 0))
       (b (b1-floor-step-at second-integral '(1)))
       (value (b1-floor-step-at rational '(1)))
       (lemma (b1-floor-unique-interval-lemma lib))
       (lib (cdr lemma))
       (step (library-inherited proof-proof-use lib (car lemma)
                               (list (list *library-x* a) (list *library-y* b) (list *library-z* value))
                               (append first second (list rational)))))
    (cons step lib)))

(defun b1-floor-quotient-of-mod (lib mod divisor i-value integral-i rational-xy rational-xz)
  (proof-with-checked-results ((parts (proof-list-of-length mod 3)))
    (let* ((x (cadr parts))
           (y (caddr parts))
           (f (list *b1-quotient-floor* x y)))
      (proof-with-checked-results
          ((interval (b1-floor-interval lib f rational-xy))
           (lib (cdr interval))
           (i-parts (b1-logic-step-first i-value))
