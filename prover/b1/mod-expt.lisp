(defun b1-mod-expt-squared-power-consequence
    (evidence lib statement claim square reduced twice-n before zero)
  (let ((a *library-x*) (n *library-y*))
    (proof-with-checked-results
        ((proof (library-library-proof lib))
         (parts (b1-logic-bookproof-split-conjuncts lib evidence))
         (parts (proof-list-of-length parts 4))
         (int-a (car parts))
         (nat-n (cadr parts))
         (int-d (caddr parts))
         (pos-d (cadddr parts))
         (local (b1-modular-modulus-init lib int-d pos-d))
         (at-zero (proof-proof-assume proof zero t))
         (power-zero (b1-powers-expt-zero lib a))
         (reduced-zero (b1-powers-expt-zero lib reduced))
         (base (b1-logic-bookproof-normalize-proof
                lib claim nil nil
                (list (b1-logic-equal-to at-zero) (b1-logic-equal-to power-zero)
                      (b1-logic-equal-to reduced-zero)) nil))
         (not-zero (proof-proof-assume proof zero nil))
         (predecessor (b1-powers-natural-predecessor lib nat-n not-zero))
         (nat-previous (car predecessor))
         (smaller (cadr predecessor))
         (child (proof-subst statement (list (cons n before))))
         (decrease (proof-step-first smaller))
         (assumed (proof-proof-assume proof (proof-ite decrease child *proof-true*) t))
         (hypothesis (proof-proof-prove-if proof assumed smaller))
         (test (proof-term-at child 1))
         (guard (b1-logic-bookproof-normalize-proof
                 lib test (list int-a nat-previous int-d pos-d) nil nil nil))
         (hypothesis (proof-proof-modus-ponens proof hypothesis guard))
         (int-square (library-library-type-of lib square (list int-a)))
         (bounds (b1-modular-modulus-bounds local int-square))
         (lib (cdr bounds))
         (int-reduced (caar bounds))
         (int-n (b1-mod-expt-type-nat lib nat-n))
         (num-n (b1-arithmetic-known-type lib *library-numberp* n (list int-n)))
         (num-before (b1-arithmetic-known-type lib *library-numberp* before (list int-n)))
         (n-to-previous (library-library-linear-equal lib (library-plus *proof-one* before) n (list int-n)))
         (open-left (b1-mod-expt-step-natural lib int-reduced nat-previous))
         (lib (cdr open-left))
         (proof (library-library-proof lib))
         (open-left (proof-proof-rewrite proof (car open-left) n-to-previous '(1 1 2)))
         (double-previous (b1-mod-expt-twice-natural lib nat-previous))
         (used-twice (b1-mod-expt-step-term double-previous 1))
         (twice-eq (proof-proof-reflexive proof twice-n))
         (expand-n (b1-bitwise-twice lib n num-n))
         (expand-n (proof-proof-symmetric proof expand-n))
         (twice-eq (proof-proof-rewrite proof twice-eq expand-n '(1 2)))
         (expand-before (b1-bitwise-twice lib before num-before))
         (expanded (library-plus *proof-one* (library-plus *proof-one* (library-plus before before))))
         (align (library-library-linear-equal lib (library-plus n n) expanded (list int-n)))
         (twice-eq (proof-proof-chain proof twice-eq (list align)))
         (twice-eq (proof-proof-rewrite proof twice-eq expand-before '(1 2 2 2)))
         (next (b1-mod-expt-next-natural lib double-previous))
         (open-right (b1-mod-expt-step-natural lib int-a next))
         (lib (cdr open-right))
         (proof (library-library-proof lib))
         (reverse (proof-proof-symmetric proof twice-eq))
         (open-right (proof-proof-rewrite proof (car open-right) reverse '(1 1 2)))
         (step (b1-mod-expt-step-natural lib int-a double-previous))
         (lib (cdr step))
         (proof (library-library-proof lib))
         (open-right (proof-proof-rewrite proof open-right (car step) '(1 2 2)))
         (associate (library-library-axiom
                     lib "ASSOCIATIVITY-OF-*" (list a a (b1-powers-expt a used-twice))))
         (reverse (proof-proof-symmetric proof associate))
         (open-right (proof-proof-chain proof open-right (list reverse)))
         (left-power (b1-mod-expt-integer-power lib int-reduced nat-previous))
         (right-power (b1-mod-expt-integer-power (cdr left-power) int-a double-previous))
         (local (b1-modular-modulus-with-lib local (cdr right-power)))
         (product-eq (b1-modular-modulus-product-congruence
                      local (car left-power) (car right-power) int-reduced hypothesis nil))
         (local (b1-modular-modulus-with-lib local (cdr product-eq)))
         (remove-square (b1-modular-modulus-product local int-square (car right-power) t))
         (lib (cdr remove-square))
         (proof (library-library-proof lib))
         (local (b1-modular-modulus-with-lib local lib))
         (lifted-left (b1-mod-expt-mod-lift local open-left))
         (lifted-right (b1-mod-expt-mod-lift local open-right))
         (reverse (proof-proof-symmetric proof lifted-right))
         (no (proof-proof-chain proof lifted-left (list (car product-eq) (car remove-square) reverse)))
         (step (proof-proof-cases proof zero base no)))
      (cons step lib))))

(defun b1-mod-expt-build-squared-power (lib)
  (let* ((a *library-x*) (n *library-y*) (d *library-z*)
         (square (b1-arithmetic-product a a))
         (int-d-test (library-integer d))
         (pos-d-test (library-positive d))
         (before (library-plus n *proof-neg-one*))
         (zero (proof-eq n *proof-zero*)))
    (proof-with-checked-results
        ((proof (library-library-proof lib))
         (int-d (proof-proof-assume proof int-d-test t))
         (pos-d (proof-proof-assume proof pos-d-test t))
         (r (b1-modular-modulus-init lib int-d pos-d))
         (reduced (b1-modular-modulus-mod r square))
         (twice-n (b1-arithmetic-product *b1-bits-two* n))
         (left (b1-powers-expt reduced n))
         (right (b1-powers-expt a twice-n))
         (guard (b1-mod-expt-guarded (list (library-integer a) (list *library-natp* n) int-d-test pos-d-test)))
         (claim (proof-eq (b1-modular-modulus-mod r left) (b1-modular-modulus-mod r right)))
         (statement (list *library-implies* guard claim))
         (premise (b1-logic-bookproof-prove-implication-premise lib statement))
         (result (b1-mod-expt-squared-power-consequence
                  premise lib statement claim square reduced twice-n before zero))
         (lib (cdr result))
         (case (b1-logic-bookproof-prove-implication-with-premise lib statement premise (car result)))
         (ordinal (library-library-builtin lib 1 n))
         (step (proof-proof-induct (library-library-proof lib) ordinal case statement
                                   (list *library-count* n) (list (list (list n before))))))
      (library-library-lemma lib "MOD-SQUARED-POWER" statement step nil))))

