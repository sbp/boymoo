        (acc *b1-mod-expt-acc*)
        (lib (b1-modular-modulus-lib ring)))
    (proof-with-checked-results
        ((a-acc (b1-arithmetic-product a acc))
         (int-product (library-library-type-of lib a-acc (list int-a int-acc)))
         (reduced-product (b1-modular-modulus-product ring int-product int-e2 t))
         (lib (cdr reduced-product))
         (proof (library-library-proof lib))
         (lhs (proof-proof-chain proof lhs (list (car reduced-product))))
         (e2 (b1-mod-expt-step-term int-e2 1))
         (reflexive (proof-proof-reflexive proof (b1-arithmetic-product a-acc e2)))
         (commute (library-library-axiom lib "COMMUTATIVITY-OF-*" (list a acc)))
