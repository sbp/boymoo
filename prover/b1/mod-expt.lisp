(in-package "BOYMOO-PROVER")
(set-verify-guards-eagerness 0)

(defconst *b1-mod-expt-a* (proof-sym "A" "ACL2"))
(defconst *b1-mod-expt-i* (proof-sym "I" "ACL2"))
(defconst *b1-mod-expt-n* (proof-sym "N" "ACL2"))
(defconst *b1-mod-expt-acc* (proof-sym "ACC" "ACL2"))
(defconst *b1-mod-expt-fast* (proof-sym "MOD-EXPT-FAST-1" "ACL2"))
(defconst *b1-mod-expt-wrapper* (proof-sym "MOD-EXPT-FAST" "ACL2"))
(defconst *b1-mod-expt-mod-expt* (proof-sym "MOD-EXPT" "ACL2"))
(defconst *b1-mod-expt-oddp* (proof-cl "ODDP"))

(defun b1-mod-expt-step-term (step index)
  (proof-with-checked-results ((first (proof-step-first step)))
    (proof-term-at first index)))

(defun b1-mod-expt-substitution-bindings (pairs)
  (if (endp pairs)
      nil
    (cons (cons (caar pairs) (cadar pairs))
          (b1-mod-expt-substitution-bindings (cdr pairs)))))

(defun b1-mod-expt-guarded (conditions)
  (cond
   ((endp conditions) '(:failure "failure" ""))
   ((endp (cdr conditions)) (car conditions))
   (t (proof-with-checked-results ((rest (b1-mod-expt-guarded (cdr conditions))))
        (proof-ite (car conditions) rest *proof-false*)))))

(defun b1-mod-expt-type-nat (lib natural)
  (proof-with-checked-results ((value (b1-mod-expt-step-term natural 1)))
    (library-library-cite lib "NATURAL-INTEGER" (list value) (list natural))))

(defun b1-mod-expt-next-natural (lib natural)
  (proof-with-checked-results
      ((value (b1-mod-expt-step-term natural 1))
       (one (library-library-natural lib *proof-one*)))
    (library-library-cite lib "NATURAL-SUM" (list *proof-one* value) (list one natural))))

(defun b1-mod-expt-twice-natural (lib natural)
  (proof-with-checked-results
      ((n (b1-mod-expt-step-term natural 1))
       (result (library-library-cite lib "NATURAL-SUM" (list n n) (list natural natural)))
       (integral (b1-mod-expt-type-nat lib natural))
       (number (b1-arithmetic-known-type lib *library-numberp* n (list integral)))
       (twice (b1-bitwise-twice lib n number)))
    (proof-proof-rewrite (library-library-proof lib) result twice '(1 1))))

(defun b1-mod-expt-build-step-natural (lib)
  (let* ((proof (library-library-proof lib))
         (r *library-x*)
         (n *library-y*)
         (successor (library-plus *proof-one* n))
         (test (proof-eq r *proof-zero*))
         (call (b1-powers-expt r successor)))
    (proof-with-checked-results
        ((int-r (proof-proof-assume proof (library-integer r) t))
         (nat-n (proof-proof-assume proof (list *library-natp* n) t))
         (int-n (b1-mod-expt-type-nat lib nat-n))
         (number (b1-arithmetic-known-type lib *library-numberp* r (list int-r)))
         (p (library-library-cite lib "NATURAL-NONNEGATIVE" (list n) (list nat-n)))
         (positive-succ (library-library-cite lib "POSITIVE-ONE-PLUS" (list n) (list int-n p)))
         (nat-succ (b1-mod-expt-next-natural lib nat-n))
         (int-succ (b1-mod-expt-type-nat lib nat-succ))
         (nz-succ (b1-arithmetic-comparison-excludes lib positive-succ *proof-zero* 2))
         (zip-succ (b1-conjunction-zip-from-integer lib int-succ nz-succ))
         (at-zero (proof-proof-assume proof test t))
         (nonzero (proof-proof-assume proof test nil))
         (common (list zip-succ number positive-succ))
         (yes (b1-logic-bookproof-normalize
               lib call (append common (list at-zero)) *b1-powers-expt-unfold*
               (list (b1-logic-equal-to at-zero)) nil nil nil))
         (power (b1-powers-expt r n))
         (commute (library-library-axiom lib "COMMUTATIVITY-OF-*" (list *proof-zero* power)))
         (times-zero (b1-arithmetic-multiply-zero lib power))
         (zero-product (proof-proof-chain proof commute (list times-zero)))
         (reverse (proof-proof-symmetric proof at-zero))
         (zero-product (proof-proof-rewrite proof zero-product reverse '(1 1 1)))
         (reverse (proof-proof-symmetric proof zero-product))
         (yes (proof-proof-chain proof yes (list reverse)))
         (no (b1-logic-bookproof-normalize
              lib call (append common (list nonzero)) *b1-powers-expt-unfold* nil nil nil nil))
         (cancel (library-library-linear-equal lib (library-plus successor *proof-neg-one*) n (list int-n)))
         (no (proof-proof-rewrite proof no cancel '(1 2 2 2)))
         (step (proof-proof-cases proof test yes no))
         (claim (proof-step-first step))
         (int-r-test (proof-step-first int-r))
         (nat-n-test (proof-step-first nat-n)))
      (library-library-lemma lib "EXPT-NATURAL-SUCCESSOR" claim step
                             (list (proof-neg int-r-test) (proof-neg nat-n-test))))))

(defun b1-mod-expt-step-natural (lib integral natural)
  (let ((name (proof-sym "SELF-EXPT-NATURAL-SUCCESSOR" "ACL2")))
    (proof-with-checked-results
        ((lib (if (assoc-equal name (proof-proof-facts (library-library-proof lib)))
                  lib
                (b1-mod-expt-build-step-natural lib)))
         (r (b1-mod-expt-step-term integral 1))
         (n (b1-mod-expt-step-term natural 1))
         (step (proof-proof-use (library-library-proof lib) name
                                (list (list *library-x* r) (list *library-y* n))
                                (list integral natural))))
      (cons step lib))))

(defun b1-mod-expt-integer-power-consequence (evidence lib n statement before zero)
  (let ((r *library-x*))
    (proof-with-checked-results
        ((proof (library-library-proof lib))
         (parts (b1-logic-bookproof-split-conjuncts lib evidence))
         (parts (proof-list-of-length parts 2))
         (int-r (car parts))
         (nat-n (cadr parts))
         (base (b1-powers-expt-zero lib r))
         (at-zero (proof-proof-assume proof zero t))
         (reverse (proof-proof-symmetric proof at-zero))
         (base (proof-proof-rewrite proof base reverse '(1 1 2)))
         (int-one (library-library-type-of lib *proof-one* nil))
         (yes (library-library-transport-argument lib int-one base 1))
         (not-zero (proof-proof-assume proof zero nil))
         (predecessor (b1-powers-natural-predecessor lib nat-n not-zero))
         (nat-previous (car predecessor))
         (smaller (cadr predecessor))
         (child (proof-subst statement (list (cons n before))))
         (comparison (proof-step-first smaller))
         (assumed (proof-proof-assume proof (proof-ite comparison child *proof-true*) t))
         (hypothesis (proof-proof-prove-if proof assumed smaller))
         (test (proof-term-at child 1))
         (guard (b1-logic-bookproof-normalize-proof lib test (list int-r nat-previous) nil nil nil))
         (hypothesis (proof-proof-modus-ponens proof hypothesis guard))
         (result (library-library-type-of
                  lib (b1-arithmetic-product r (b1-powers-expt r before)) (list int-r hypothesis)))
         (opened (b1-mod-expt-step-natural lib int-r nat-previous))
         (lib (cdr opened))
         (proof (library-library-proof lib))
         (int-n (b1-mod-expt-type-nat lib nat-n))
         (cancel (library-library-linear-equal lib (library-plus *proof-one* before) n (list int-n)))
         (opened (proof-proof-rewrite proof (car opened) cancel '(1 1 2)))
         (no (library-library-transport-argument lib result opened 1))
         (step (proof-proof-cases proof zero yes no)))
      (cons step lib))))

(defun b1-mod-expt-build-integer-power (lib)
  (let* ((r *library-x*)
         (n *library-y*)
         (statement (list *library-implies*
                          (proof-ite (library-integer r) (list *library-natp* n) *proof-false*)
                          (library-integer (b1-powers-expt r n))))
         (before (library-plus n *proof-neg-one*))
         (zero (proof-eq n *proof-zero*)))
    (proof-with-checked-results
        ((premise (b1-logic-bookproof-prove-implication-premise lib statement))
         (result (b1-mod-expt-integer-power-consequence premise lib n statement before zero))
         (lib (cdr result))
         (case (b1-logic-bookproof-prove-implication-with-premise lib statement premise (car result)))
         (ordinal (library-library-builtin lib 1 n))
         (step (proof-proof-induct (library-library-proof lib) ordinal case statement
                                   (list *library-count* n) (list (list (list n before))))))
      (library-library-lemma lib "EXPT-NATURAL-INTEGER" statement step nil))))

(defun b1-mod-expt-integer-power (lib integral natural)
  (let ((name (proof-sym "SELF-EXPT-NATURAL-INTEGER" "ACL2")))
    (proof-with-checked-results
