                                (b1-modular-modulus-mod ring value) equality)))

(defun b1-mod-expt-shift-natural (lib integral positive-index)
  (proof-with-checked-results
      ((index (b1-mod-expt-step-term integral 1))
       (two *b1-bits-two*)
       (shift (list *b1-quotient-ash* index *proof-neg-one*))
       (expt-two-zero (b1-powers-expt-zero lib two))
       (opened (b1-logic-bookproof-normalize
                lib shift (list integral)
                (list *b1-quotient-ash* *b1-quotient-ifix* *b1-quotient-expt* *b1-quotient-zip*
                      *b1-quotient-numeric-eq* *b1-logic-eql* *b1-powers-fix*)
                (list (b1-logic-equal-to expt-two-zero)) nil nil nil))
       (bound (b1-quotient-floor-half-bound lib index integral positive-index))
       (lib (cdr bound))
