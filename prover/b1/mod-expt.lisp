(defun b1-mod-expt-accumulator-invariant-consequence-branch
    (even ring formula term arguments current-bounds new-bounds int-a int-i
          int-next-a nat-index child-residue twice-index descent parts low no-zp-i)
  (let* ((lib (b1-modular-modulus-lib ring))
         (proof (library-library-proof lib))
         (i *b1-mod-expt-i*))
    (proof-with-checked-results
        ((even-test (proof-term-at low 1))
         (parity (proof-proof-assume proof even-test even))
         (odd-value (b1-logic-bookproof-normalize
                     lib (list *b1-mod-expt-oddp* i) (list int-i parity)
                     (list *b1-mod-expt-oddp* *proof-not*) nil nil nil nil))
         (odd (if even
                  (proof-with-checked-results
                      ((not-nil (b1-logic-proof-not-nil proof))
                       (reverse (proof-proof-symmetric proof odd-value))
                       (rewritten (proof-proof-rewrite proof not-nil reverse '(1 1))))
                    (proof-proof-tidy proof rewritten))
                (proof-proof-true-from-eq proof odd-value)))
         (child (proof-subst formula (b1-mod-expt-substitution-bindings arguments)))
         (comparison (proof-step-first descent))
         (assumed (proof-proof-assume proof (proof-ite comparison child *proof-true*) t))
         (induction (proof-proof-prove-if proof assumed descent))
         (bounds (if even current-bounds new-bounds))
         (premises (append (list int-next-a nat-index (b1-modular-modulus-integer ring)
                                 (b1-modular-modulus-positive ring)) bounds))
         (test (proof-term-at child 1))
         (guard (b1-logic-bookproof-normalize-proof lib test premises nil nil nil))
         (theorem (proof-proof-modus-ponens proof induction guard))
         (opened (b1-logic-bookproof-normalize
                  lib term (list no-zp-i odd) (list *b1-mod-expt-fast*) nil nil nil nil))
         (lhs (proof-proof-chain proof opened (list theorem)))
         (power-next (b1-mod-expt-integer-power lib int-next-a nat-index))
         (power-a (b1-mod-expt-integer-power (cdr power-next) int-a twice-index))
         (ring (b1-modular-modulus-with-lib ring (cdr power-a)))
         (congruent (b1-modular-modulus-product-congruence
                     ring (car power-next) (car power-a) (car bounds) child-residue nil))
         (lib (cdr congruent))
         (proof (library-library-proof lib))
         (lhs (proof-proof-chain proof lhs (list (car congruent))))
         (selected (proof-proof-select proof low parity))
         (index-eq (proof-proof-rewrite proof parts selected '(1 2 2)))
         (even-index (b1-mod-expt-step-term twice-index 1)))
      (if even
          (b1-mod-expt-even-index lib lhs index-eq even-index twice-index)
        (b1-mod-expt-odd-index
         (b1-modular-modulus-with-lib ring lib) lhs index-eq even-index twice-index
         int-a (car current-bounds) (car power-a))))))

(defun b1-mod-expt-accumulator-invariant-consequence
    (evidence lib term result formula index all-substitutions at-zero)
  (let ((a *b1-mod-expt-a*) (i *b1-mod-expt-i*) (acc *b1-mod-expt-acc*))
    (proof-with-checked-results
        ((proof (library-library-proof lib))
         (premises (b1-logic-bookproof-split-conjuncts lib evidence))
         (premises (proof-list-of-length premises 7))
         (int-a (car premises))
         (nat-i (cadr premises))
         (int-n (caddr premises))
         (pos-n (cadddr premises))
         (current-bounds (cddddr premises))
         (int-acc (car current-bounds))
         (nonneg-acc (cadr current-bounds))
         (acc-less (caddr current-bounds))
         (ring (b1-modular-modulus-init lib int-n pos-n))
         (int-i (b1-mod-expt-type-nat lib nat-i))
         (zero (proof-proof-assume proof at-zero t))
         (nonzero (proof-proof-assume proof at-zero nil))
         (zp (list *b1-logic-zp* i))
         (zout (b1-logic-bookproof-normalize-proof
                lib zp nil (list *b1-logic-zp* *proof-not*) (list (b1-logic-equal-to zero)) nil))
         (base-left (b1-logic-bookproof-normalize lib term (list zout) (list *b1-mod-expt-fast*)
                                                 nil nil nil nil))
         (power-zero (b1-powers-expt-zero lib a))
         (reverse (proof-proof-symmetric proof zero))
         (power-zero (proof-proof-rewrite proof power-zero reverse '(1 1 2)))
         (base-right (proof-proof-reflexive proof result))
         (base-right (proof-proof-rewrite proof base-right power-zero '(1 2 1 2)))
         (unit (b1-arithmetic-multiply-one lib acc (list int-acc) nil))
         (base-right (proof-proof-rewrite proof base-right unit '(1 2 1)))
         (canonical (b1-modular-modulus-canonical ring int-acc nonneg-acc acc-less))
         (lib (cdr canonical))
         (proof (library-library-proof lib))
         (base-right (proof-proof-chain proof base-right (list (car canonical))))
         (reverse (proof-proof-symmetric proof base-right))
         (base (proof-proof-chain proof base-left (list reverse)))
         (nonnegative-i (library-library-cite lib "NATURAL-NONNEGATIVE" (list i) (list nat-i)))
         (order (b1-arithmetic-integer-compare lib i *proof-zero* (list int-i)))
         (nonnegative (proof-proof-discharge proof order nonnegative-i))
         (pos-i (proof-proof-discharge proof nonnegative nonzero))
         (zp-false (b1-logic-bookproof-normalize lib zp (list int-i pos-i) (list *b1-logic-zp* *proof-not*)
                                               nil nil nil nil))
         (not-nil (b1-logic-proof-not-nil proof))
         (reverse (proof-proof-symmetric proof zp-false))
         (negative (proof-proof-rewrite proof not-nil reverse '(1 1)))
         (no-zp-i (proof-proof-tidy proof negative))
         (descent (b1-quotient-shift-descent
                   lib (list *proof-ordinal-less* (list *library-count* index) (list *library-count* i))))
         (lib (cdr descent))
         (proof (library-library-proof lib))
         (descent (proof-proof-discharge proof (car descent) no-zp-i))
         (shift (b1-mod-expt-shift-natural lib int-i pos-i))
         (lib (cdr shift))
         (nat-index (caar shift))
         (exact (cadar shift))
         (parts (b1-bits-decomposition lib int-i))
         (lib (cdr parts))
         (proof (library-library-proof lib))
         (reverse (proof-proof-symmetric proof exact))
         (parts (proof-proof-rewrite proof (car parts) reverse '(1 2 1 2)))
         (square-type (library-library-type-of lib (b1-arithmetic-product a a) (list int-a)))
         (ring (b1-modular-modulus-with-lib ring lib))
         (bounds-a (b1-modular-modulus-bounds ring square-type))
         (lib (cdr bounds-a))
         (int-next-a (caar bounds-a))
         (prod-type (library-library-type-of lib (b1-arithmetic-product a acc) (list int-a int-acc)))
         (ring (b1-modular-modulus-with-lib ring lib))
         (bounds-acc (b1-modular-modulus-bounds ring prod-type))
         (ring (b1-modular-modulus-with-lib ring (cdr bounds-acc)))
         (new-bounds (car bounds-acc))
         (residue (b1-mod-expt-squared-power ring int-a nat-index))
         (lib (cdr residue))
         (ring (b1-modular-modulus-with-lib ring lib))
         (twice-index (b1-mod-expt-twice-natural lib nat-index))
         (low (b1-bits-low-bit i))
         (even-test (proof-term-at low 1))
         (yes (b1-mod-expt-accumulator-invariant-consequence-branch
               t ring formula term (car all-substitutions) current-bounds new-bounds int-a int-i
               int-next-a nat-index (car residue) twice-index descent parts low no-zp-i))
         (ring (b1-modular-modulus-with-lib ring (cdr yes)))
         (no (b1-mod-expt-accumulator-invariant-consequence-branch
              nil ring formula term (cadr all-substitutions) current-bounds new-bounds int-a int-i
              int-next-a nat-index (car residue) twice-index descent parts low no-zp-i))
         (lib (cdr no))
         (proof (library-library-proof lib))
         (parity (proof-proof-cases proof even-test (car yes) (car no)))
         (step (proof-proof-cases proof at-zero base parity)))
      (cons step lib))))

(defun b1-mod-expt-build-accumulator-invariant (lib)
  (let* ((a *b1-mod-expt-a*)
         (i *b1-mod-expt-i*)
         (n *b1-mod-expt-n*)
         (acc *b1-mod-expt-acc*)
         (term (list *b1-mod-expt-fast* a i n acc))
         (result (list *b1-modular-mod* (b1-arithmetic-product acc (b1-powers-expt a i)) n))
         (index (list *b1-quotient-ash* i *proof-neg-one*))
         (next-a (list *b1-modular-mod* (b1-arithmetic-product a a) n))
         (next-acc (list *b1-modular-mod* (b1-arithmetic-product a acc) n))
         (substitutions (list (list a next-a) (list i index)))
         (all-substitutions (list substitutions (append substitutions (list (list acc next-acc)))))
         (at-zero (proof-eq i *proof-zero*)))
    (proof-with-checked-results
        ((guard (b1-mod-expt-guarded
                 (list (library-integer a) (list *library-natp* i) (library-integer n)
                       (library-positive n) (library-integer acc) (library-nonnegative acc) (library-lt acc n))))
         (formula (list *library-implies* guard (proof-eq term result)))
         (premise (b1-logic-bookproof-prove-implication-premise lib formula))
         (proof (b1-mod-expt-accumulator-invariant-consequence
                 premise lib term result formula index all-substitutions at-zero))
         (lib (cdr proof))
         (case (b1-logic-bookproof-prove-implication-with-premise lib formula premise (car proof)))
         (ordinal (library-library-builtin lib 1 i))
         (step (proof-proof-induct (library-library-proof lib) ordinal case formula
                                   (list *library-count* i) all-substitutions)))
      (library-library-lemma lib "MOD-EXPT-ACCUMULATOR" formula step nil))))

(defun b1-mod-expt-accumulator-invariant (lib)
  (let ((name (proof-sym "SELF-MOD-EXPT-ACCUMULATOR" "ACL2")))
    (if (assoc-equal name (proof-proof-facts (library-library-proof lib)))
        (cons name lib)
      (proof-with-checked-results ((lib (b1-mod-expt-build-accumulator-invariant lib)))
        (cons name lib)))))

(defun b1-mod-expt-mod-expt-fast-consequence-accumulator
    (int-a lib nat-i int-n pos-n above-one a i)
  (proof-with-checked-results
      ((name (b1-mod-expt-accumulator-invariant lib))
       (lib (cdr name))
       (proof (library-library-proof lib))
       (invariant (proof-proof-fact proof (car name) (list (list *b1-mod-expt-acc* *proof-one*))))
       (one-nonnegative (proof-proof-prove proof (library-nonnegative *proof-one*) nil (list *proof-not*)))
       (int-one (library-library-type-of lib *proof-one* nil))
       (premises (list int-a nat-i int-n pos-n int-one one-nonnegative above-one))
       (test (b1-mod-expt-step-term invariant 1))
       (guard (b1-logic-bookproof-normalize-proof lib test premises nil nil nil))
       (result (proof-proof-modus-ponens proof invariant guard))
       (number (b1-powers-expt-number lib a i))
       (lib (cdr number))
       (unit (b1-arithmetic-multiply-one lib (b1-powers-expt a i) (list (car number)) t))
       (step (proof-proof-rewrite (library-library-proof lib) result unit '(1 2 1))))
    (cons step lib)))

(defun b1-mod-expt-wrapper-cases (lib call raw a i nat-i int-n pos-n above-one)
  (let* ((proof (library-library-proof lib)) (integral (library-integer a)))
    (proof-with-checked-results
        ((yes (proof-proof-assume proof integral t))
         (no (proof-proof-assume proof integral nil))
         (yes-eq (b1-logic-bookproof-normalize
                  lib call (list yes int-n pos-n) (list *b1-mod-expt-wrapper*) nil nil nil nil))
         (no-eq (b1-logic-bookproof-normalize
                 lib call (list no int-n pos-n) (list *b1-mod-expt-wrapper*) nil nil nil nil))
         (value (b1-mod-expt-step-term yes-eq 2)))
      (if (not (equal value raw))
          '(:failure "failure" "")
        (proof-with-checked-results
            ((accumulator (b1-mod-expt-mod-expt-fast-consequence-accumulator
                           yes lib nat-i int-n pos-n above-one a i))
             (lib (cdr accumulator))
             (proof (library-library-proof lib))
             (yes (proof-proof-chain proof yes-eq (list (car accumulator))))
             (step (proof-proof-cases proof integral yes no-eq)))
          (cons step lib))))))

(defun b1-mod-expt-mod-expt-fast-consequence (premise lib formula)
  (proof-with-checked-results
      ((proof (library-library-proof lib))
       (parts (b1-logic-bookproof-split-conjuncts lib premise))
       (parts (proof-list-of-length parts 4))
       (a-type (car parts))
       (nat-i (cadr parts))
       (int-n (caddr parts))
       (above-one (cadddr parts))
       (a (b1-mod-expt-step-term a-type 1))
       (i (b1-mod-expt-step-term nat-i 1))
       (n (b1-mod-expt-step-term int-n 1))
       (int-zero (library-library-type-of lib *proof-zero* nil))
       (int-one (library-library-type-of lib *proof-one* nil))
       (pos-one (proof-proof-prove proof (library-positive *proof-one*) nil nil))
       (pos-n (library-library-cite lib "LESS-TRANSITIVE" (list *proof-zero* *proof-one* n)
                                    (list int-zero int-one int-n pos-one above-one)))
       (raw (list *b1-mod-expt-fast* a i n *proof-one*))
       (eq-rhs (proof-proof-unfold proof (list *b1-mod-expt-mod-expt* a i n)))
       (claim (proof-term-at formula 2))
       (call (proof-term-at claim 1))
       (head (proof-term-at call 0))
       (fast (if (equal head *b1-mod-expt-fast*)
                 (b1-mod-expt-mod-expt-fast-consequence-accumulator a-type lib nat-i int-n pos-n above-one a i)
               (b1-mod-expt-wrapper-cases lib call raw a i nat-i int-n pos-n above-one)))
       (lib (cdr fast))
       (proof (library-library-proof lib))
       (reverse (proof-proof-symmetric proof eq-rhs))
       (step (proof-proof-chain proof (car fast) (list reverse))))
    (cons step lib)))

(defun b1-mod-expt-mod-expt-fast (lib formula)
  (proof-with-checked-results
      ((premise (b1-logic-bookproof-prove-implication-premise lib formula))
       (result (b1-mod-expt-mod-expt-fast-consequence premise lib formula))
       (lib (cdr result))
       (step (b1-logic-bookproof-prove-implication-with-premise lib formula premise (car result))))
    (cons step lib)))
