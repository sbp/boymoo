(in-package "BOYMOO-PROVER")
(set-verify-guards-eagerness 0)

(defun b1-scaling-distribute-left-sum (lib a b factor)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((result (library-library-axiom lib "COMMUTATIVITY-OF-*" (list (library-plus a b) factor)))
         (distribution (library-library-axiom lib "DISTRIBUTIVITY" (list factor a b)))
         (result (proof-proof-chain proof result (list distribution)))
         (commute-a (library-library-axiom lib "COMMUTATIVITY-OF-*" (list factor a)))
         (result (proof-proof-rewrite proof result commute-a '(1 2 1)))
         (commute-b (library-library-axiom lib "COMMUTATIVITY-OF-*" (list factor b))))
      (proof-proof-rewrite proof result commute-b '(1 2 2)))))

(defun b1-scaling-integer-multiple-consequence (premise lib k z previous formula pairs)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((conjuncts (b1-logic-bookproof-split-conjuncts lib premise))
         (parts (proof-list-of-length conjuncts 3))
         (integral (car parts))
         (pos-k (cadr parts))
         (pos-z (caddr parts))
         (nat-k (b1-quotient-natural-from-positive lib k integral pos-k))
         (nonzero (b1-arithmetic-comparison-excludes lib pos-k *proof-zero* 2))
         (predecessor (b1-powers-natural-predecessor lib nat-k nonzero))
         (nat-previous (car predecessor))
         (descent (cadr predecessor))
         (int-previous (library-library-cite lib "NATURAL-INTEGER" (list previous) (list nat-previous)))
         (previous-nonnegative (library-library-cite lib "NATURAL-NONNEGATIVE"
                                                     (list previous) (list nat-previous)))
         (numeric-previous (b1-arithmetic-known-type lib *library-numberp* previous (list int-previous)))
         (at-zero (proof-eq previous *proof-zero*))
         (nonzero-previous (proof-proof-assume proof at-zero nil))
         (positive (b1-arithmetic-positive-from-bounds lib previous-nonnegative
                                                       nonzero-previous numeric-previous))
         (pos-previous (car positive))
         (lib (cdr positive))
         (proof (library-library-proof lib))
         (child (proof-subst formula (proof-bindings-table pairs nil)))
         (descent-first (proof-step-first descent))
         (assumed (proof-proof-assume proof (proof-ite descent-first child *proof-true*) t))
         (hypothesis (proof-proof-prove-if proof assumed descent))
         (child-test (proof-term-at child 1))
         (child-guard (b1-logic-bookproof-normalize-proof
                       lib child-test (list int-previous pos-previous pos-z) nil nil nil))
         (child-positive (proof-proof-modus-ponens proof hypothesis child-guard))
         (step (b1-arithmetic-positive-sum lib pos-z child-positive))
         (commute (library-library-axiom lib "COMMUTATIVITY-OF-*" (list previous z)))
         (zero (proof-proof-assume proof at-zero t))
         (child-zero (proof-proof-rewrite proof commute zero '(1 2 2)))
         (multiply-zero (b1-arithmetic-multiply-zero lib z))
         (child-zero (proof-proof-chain proof child-zero (list multiply-zero)))
         (first (proof-step-first step))
         (summands (proof-term-at first 2))
         (base (proof-proof-reflexive proof summands))
         (base (proof-proof-rewrite proof base child-zero '(1 2 2)))
         (numeric-z (b1-arithmetic-number-from-comparison lib pos-z 2))
         (commute (library-library-axiom lib "COMMUTATIVITY-OF-+" (list z *proof-zero*)))
         (add-zero (b1-arithmetic-add-zero lib z (list numeric-z)))
         (base (proof-proof-chain proof base (list commute add-zero)))
         (base (library-library-transport-argument lib pos-z base 2))
         (result (proof-proof-cases proof at-zero base step))
         (successor (library-library-linear-equal lib k (library-plus *proof-one* previous) (list integral)))
         (expand (proof-proof-reflexive proof (b1-arithmetic-product k z)))
         (expand (proof-proof-rewrite proof expand successor '(1 2 1)))
         (distribute (b1-scaling-distribute-left-sum lib *proof-one* previous z))
         (expand (proof-proof-chain proof expand (list distribute)))
         (multiply-one (b1-arithmetic-multiply-one lib z (list numeric-z) t))
         (expand (proof-proof-rewrite proof expand multiply-one '(1 2 1)))
         (step (library-library-transport-argument lib result expand 2)))
      (cons step lib))))

(defun b1-scaling-integer-multiple (lib)
  (let* ((name (proof-sym "SELF-POSITIVE-INTEGER-MULTIPLE" "ACL2"))
         (proof (library-library-proof lib)))
    (if (assoc-equal name (proof-proof-facts proof))
        (cons name lib)
      (let* ((k *library-x*)
             (z *library-y*)
             (product-is-positive (library-positive (b1-arithmetic-product k z)))
             (guard (proof-ite (library-integer k)
                               (proof-ite (library-positive k) (library-positive z) *proof-false*)
                               *proof-false*))
             (formula (list *library-implies* guard product-is-positive))
             (previous (library-plus k *proof-neg-one*))
             (pairs (list (list k previous))))
        (proof-with-checked-results
            ((premise (b1-logic-bookproof-prove-implication-premise lib formula))
             (consequence (b1-scaling-integer-multiple-consequence premise lib k z previous formula pairs))
             (lib (cdr consequence))
             (proof (library-library-proof lib))
             (step (b1-logic-bookproof-prove-implication-with-premise lib formula premise (car consequence)))
             (ordinal (library-library-builtin lib 1 k))
             (step (proof-proof-induct proof ordinal step formula (list *library-count* k) (list pairs)))
             (lib (library-library-lemma lib "POSITIVE-INTEGER-MULTIPLE" formula step nil)))
          (cons name lib))))))

(defun b1-scaling-positive-multiple (lib integral pos-scalar pos-factor)
  (proof-with-checked-results
      ((integer-first (proof-step-first integral))
       (scalar (proof-term-at integer-first 1))
       (factor-first (proof-step-first pos-factor))
       (factor (proof-term-at factor-first 2))
       (bindings (list (list *library-x* scalar) (list *library-y* factor)))
       (multiple (b1-scaling-integer-multiple lib))
       (lib (cdr multiple))
       (proof (library-library-proof lib))
       (rule (proof-proof-fact proof (car multiple) bindings))
       (rule-first (proof-step-first rule))
       (test (proof-term-at rule-first 1))
       (condition (b1-logic-bookproof-normalize-proof lib test (list integral pos-scalar pos-factor)
                                                       nil nil nil))
       (step (proof-proof-modus-ponens proof rule condition)))
    (cons step lib)))

(defun b1-scaling-opposite-sign (lib positive-p)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((first (proof-step-first positive-p))
         (term (proof-term-at first 2))
         (opposite (library-positive (library-minus term)))
         (assumed (proof-proof-assume proof opposite t))
         (impossible (b1-arithmetic-positive-sum lib positive-p assumed))
         (inverse (library-library-axiom lib "INVERSE-OF-+" (list term)))
         (impossible (proof-proof-rewrite proof impossible inverse '(1 2)))
         (zero (library-library-axiom lib "ZERO" nil))
         (cut (proof-proof-cut proof impossible zero)))
      (proof-proof-front proof cut (proof-neg opposite)))))

(defun b1-scaling-negative-from-signs (lib numeric not-positive not-zero)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((first (proof-step-first numeric))
         (term (proof-term-at first 1))
         (trichotomy (library-library-axiom lib "TRICHOTOMY" (list term)))
         (conjuncts (proof-proof-conjunct proof trichotomy))
         (order (proof-proof-modus-ponens proof (car conjuncts) numeric))
         (order (proof-proof-prove-if proof order not-positive)))
      (proof-proof-prove-if proof order not-zero))))

(defun b1-scaling-positive-rational-multiple (lib rational pos-scalar pos-factor)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((rational-first (proof-step-first rational))
         (scalar (proof-term-at rational-first 1))
         (factor-first (proof-step-first pos-factor))
         (factor (proof-term-at factor-first 2))
         (value (b1-arithmetic-product scalar factor))
         (parts (b1-arithmetic-numerator-product lib rational))
         (representation (car parts))
         (denominator-data (cadr parts))
         (int-d (car denominator-data))
         (int-n (cadr denominator-data))
         (pos-d (caddr denominator-data))
         (denominator-first (proof-step-first int-d))
         (d (proof-term-at denominator-first 1))
         (numerator-first (proof-step-first int-n))
         (n (proof-term-at numerator-first 1))
         (n-positive (b1-arithmetic-positive-product lib pos-d pos-scalar (list rational int-d)))
         (commute (library-library-axiom lib "COMMUTATIVITY-OF-*" (list d scalar)))
         (rearranged (proof-proof-chain proof commute (list representation)))
         (n-positive (proof-proof-rewrite proof n-positive rearranged '(1 2)))
         (multiple (b1-scaling-positive-multiple lib int-n n-positive pos-factor))
         (lib (cdr multiple))
         (proof (library-library-proof lib))
         (associated (library-library-axiom lib "ASSOCIATIVITY-OF-*" (list d scalar factor)))
         (scaled (proof-proof-symmetric proof associated))
         (rearranged (proof-proof-chain proof commute (list representation)))
         (scaled (proof-proof-rewrite proof scaled rearranged '(1 2 1)))
         (scaled-positive (library-library-transport-argument lib (car multiple) scaled 2))
         (nonzero (proof-eq value *proof-zero*))
         (at-zero (proof-proof-assume proof nonzero t))
         (impossible (proof-proof-rewrite proof scaled-positive at-zero '(1 2 2)))
         (multiply-zero (b1-arithmetic-multiply-zero lib d))
         (impossible (proof-proof-rewrite proof impossible multiply-zero '(1 2)))
         (zero (library-library-axiom lib "ZERO" nil))
         (cut (proof-proof-cut proof impossible zero))
         (not-zero (proof-proof-front proof cut (proof-neg nonzero)))
         (bad (proof-proof-assume proof (library-positive value) nil))
         (numeric (b1-arithmetic-known-type lib *library-numberp* value nil))
         (negative (b1-scaling-negative-from-signs lib numeric bad not-zero))
         (multiple (b1-scaling-positive-multiple lib int-d pos-d negative))
         (lib (cdr multiple))
         (negation (b1-arithmetic-multiply-negation lib d value))
         (lib (cdr negation))
         (proof (library-library-proof lib))
         (negative (proof-proof-rewrite proof (car multiple) (car negation) '(1 2)))
         (opposite (b1-scaling-opposite-sign lib scaled-positive))
         (cut (proof-proof-cut proof negative opposite))
         (step (proof-proof-front proof cut (library-positive value))))
      (cons step lib))))

(defun b1-scaling-scale-test-proof-truth (step lib)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((first (proof-step-first step))
         (term (proof-term-at first 2))
         (boolean (proof-proof-fact proof "booleanp-<"
                                    (list (list *library-x* *proof-zero*) (list *library-y* term)))))
      (b1-logic-bookproof-boolean-value lib step boolean))))

(defun b1-scaling-scale-test-proof (lib rational-scalar positive-factor)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((rational-first (proof-step-first rational-scalar))
         (scalar (proof-term-at rational-first 1))
         (factor-first (proof-step-first positive-factor))
         (factor (proof-term-at factor-first 2))
         (scaled (b1-arithmetic-product scalar factor))
         (test (library-positive scalar))
         (result (library-positive scaled))
         (positive (proof-proof-assume proof test t))
         (multiple (b1-scaling-positive-rational-multiple lib rational-scalar positive positive-factor))
         (lib (cdr multiple))
         (proof (library-library-proof lib))
         (yes (b1-scaling-scale-test-proof-truth (car multiple) lib))
         (test-step (proof-proof-assume proof test t))
         (test-truth (b1-scaling-scale-test-proof-truth test-step lib))
         (test-truth (proof-proof-symmetric proof test-truth))
         (yes (proof-proof-chain proof yes (list test-truth)))
         (is-zero (proof-eq scalar *proof-zero*))
         (commute (library-library-axiom lib "COMMUTATIVITY-OF-*" (list scalar factor)))
         (assume-zero (proof-proof-assume proof is-zero t))
         (zero (proof-proof-rewrite proof commute assume-zero '(1 2 2)))
         (zero-product (b1-arithmetic-multiply-zero lib factor))
         (zero (proof-proof-chain proof zero (list zero-product)))
         (zero-branch (proof-proof-reflexive proof result))
         (zero-branch (proof-proof-rewrite proof zero-branch zero '(1 2 2)))
         (zero-test (b1-logic-bookproof-constant lib (library-lt *proof-zero* *proof-zero*)))
         (zero-branch (proof-proof-chain proof zero-branch (list zero-test)))
         (no (proof-proof-assume proof test nil))
         (numeric (b1-arithmetic-known-type lib *library-numberp* scalar (list rational-scalar)))
         (nonzero (proof-proof-assume proof is-zero nil))
         (negative (b1-scaling-negative-from-signs lib numeric no nonzero))
         (minus-rational (b1-arithmetic-known-type lib *library-rationalp* (library-minus scalar)
                                                 (list rational-scalar)))
         (negative (b1-scaling-positive-rational-multiple lib minus-rational negative positive-factor))
         (lib (cdr negative))
         (negated-factor (b1-arithmetic-negative-left-factor lib scalar factor))
         (lib (cdr negated-factor))
         (proof (library-library-proof lib))
         (negative (proof-proof-rewrite proof (car negative) (car negated-factor) '(1 2)))
         (neg-scaled (b1-scaling-opposite-sign lib negative))
         (sums (b1-arithmetic-number-sums-init lib))
         (lib (b1-arithmetic-number-sums-library sums))
         (proof (library-library-proof lib))
         (scaled-number (b1-arithmetic-known-type lib *library-numberp* scaled nil))
         (double (b1-arithmetic-number-sums-cite sums "DOUBLE-NEGATION" (list scaled) (list scaled-number)))
         (neg-scaled (proof-proof-rewrite proof neg-scaled double '(1 1 2)))
         (nonpositive (b1-logic-bookproof-false-value lib neg-scaled))
         (on-nonpositive (proof-proof-cases proof is-zero zero-branch nonpositive))
         (test-false (b1-logic-bookproof-false-value lib no))
         (test-false (proof-proof-symmetric proof test-false))
         (no (proof-proof-chain proof on-nonpositive (list test-false)))
         (step (proof-proof-cases proof test yes no)))
      (cons step lib))))

(defun b1-scaling-positive-scale-test-lemma (lib)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((rational (proof-proof-assume proof (list *library-rationalp* *library-x*) t))
         (strict (proof-proof-assume proof (library-positive *library-y*) t))
         (result (b1-scaling-scale-test-proof lib rational strict))
         (claim (proof-step-first (car result)))
         (rational-first (proof-step-first rational))
         (strict-first (proof-step-first strict)))
      (library-library-lemma (cdr result) "POSITIVE-SCALE-TEST" claim (car result)
                             (list (proof-neg rational-first) (proof-neg strict-first))))))

(defun b1-scaling-positive-scale-test (lib rational-scalar positive-factor)
  (let* ((name (proof-sym "SELF-POSITIVE-SCALE-TEST" "ACL2"))
         (proof (library-library-proof lib)))
    (proof-with-checked-results
        ((lib (if (assoc-equal name (proof-proof-facts proof))
                  lib
                (b1-scaling-positive-scale-test-lemma lib)))
         (proof (library-library-proof lib))
         (rational-first (proof-step-first rational-scalar))
         (scalar (proof-term-at rational-first 1))
         (factor-first (proof-step-first positive-factor))
         (factor (proof-term-at factor-first 2))
         (step (proof-proof-use proof name (list (list *library-x* scalar) (list *library-y* factor))
                                (list rational-scalar positive-factor))))
      (cons step lib))))
