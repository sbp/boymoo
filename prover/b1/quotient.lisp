(defun b1-quotient-natural-from-positive (lib term integer-proof positive-proof)
  (proof-with-checked-results
   ((lower (library-library-cite lib "POSITIVE-NONNEGATIVE" (list term)
                                  (list integer-proof positive-proof))))
   (library-library-cite lib "NATURAL-FROM-BOUNDS" (list term)
                         (list integer-proof lower))))

(defun b1-quotient-quotient-bounds-consequence-open-quotient
    (cmp lib q int-n nonzero-d nfix-rule)
  (b1-logic-bookproof-normalize
   lib q (list int-n nonzero-d cmp)
   (list *b1-quotient-niq* *b1-quotient-numeric-eq* *b1-logic-eql*
         *b1-quotient-ifix*)
   (list nfix-rule) nil nil nil))

(defun b1-quotient-quotient-bounds-consequence-comparison
    (before after position lib n d smaller-n q-eq int-d all-ints)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
     ((multiply (proof-proof-reflexive proof (b1-arithmetic-product d before)))
      (multiply (proof-proof-rewrite proof multiply q-eq (append '(1 2 2) position)))
      (distribution (library-library-axiom lib "DISTRIBUTIVITY"
                                           (list d *proof-one* after)))
      (multiply (proof-proof-chain proof multiply (list distribution)))
      (unit (b1-arithmetic-multiply-one lib d (list int-d) nil))
      (multiply (proof-proof-rewrite proof multiply unit '(1 2 1)))
      (compare (proof-proof-reflexive proof (library-lt n (b1-arithmetic-product d before))))
      (compare (proof-proof-rewrite proof compare multiply '(1 2 2)))
      (product (proof-rewritten-term multiply))
      (differ (library-library-comparison lib n product all-ints))
      (compare (proof-proof-chain proof compare (list differ)))
      (shifted (library-library-comparison lib smaller-n
                                           (b1-arithmetic-product d after) all-ints))
      (compare-rhs (proof-rewritten-term compare))
      (from (proof-term-at compare-rhs 2))
      (shifted-rhs (proof-rewritten-term shifted))
      (to (proof-term-at shifted-rhs 2))
      (delta (library-library-linear-equal lib from to all-ints))
      (compare (proof-proof-rewrite proof compare delta '(1 2 2)))
      (reversed (proof-proof-symmetric proof shifted)))
     (proof-proof-chain proof compare (list reversed)))))

(defun b1-quotient-quotient-bounds-base
    (lib n d q conclusion bound int-n int-d nonneg-n nonzero-d nfix-rule)
  (let ((proof (library-library-proof lib))
        (d-q (b1-arithmetic-product d q))
        (d-next (b1-arithmetic-product d (library-plus *proof-one* q))))
    (proof-with-checked-results
     ((small-n (proof-proof-assume proof bound t))
      (base-eq (b1-quotient-quotient-bounds-consequence-open-quotient
                small-n lib q int-n nonzero-d nfix-rule))
      (natural-zero (library-library-natural lib *proof-zero*))
      (zero (library-library-transport-argument lib natural-zero base-eq 1))
      (zero-d (proof-proof-reflexive proof d-q))
      (zero-d (proof-proof-rewrite proof zero-d base-eq '(1 2 2)))
      (product-zero (b1-arithmetic-multiply-zero lib d))
      (zero-d (proof-proof-chain proof zero-d (list product-zero)))
      (zero-d (proof-proof-symmetric proof zero-d))
      (base-bound (proof-proof-rewrite proof nonneg-n zero-d '(1 1 2)))
      (base-bound (proof-proof-tidy proof base-bound))
      (base-upper (proof-proof-reflexive proof d-next))
      (base-upper (proof-proof-rewrite proof base-upper base-eq '(1 2 2 2)))
      (one (b1-logic-bookproof-constant lib (library-plus *proof-one* *proof-zero*)))
      (base-upper (proof-proof-rewrite proof base-upper one '(1 2 2)))
      (unit (b1-arithmetic-multiply-one lib d (list int-d) nil))
      (base-upper (proof-proof-chain proof base-upper (list unit)))
      (small-n (proof-proof-assume proof (library-lt n d) t))
      (base-upper (library-library-transport-argument lib small-n base-upper 2)))
     (b1-logic-bookproof-normalize-proof lib conclusion (list zero base-bound base-upper)
                                         nil nil nil))))

(defun b1-quotient-quotient-bounds-step
    (lib n d q conclusion formula bound smaller-n int-n int-d pos-d nonzero-d nfix-rule)
  (let ((proof (library-library-proof lib))
        (integers (list int-n int-d)))
    (proof-with-checked-results
     ((large-n (proof-proof-assume proof bound nil))
      (int-zero (library-library-type-of lib *proof-zero* nil))
      (positive-n (library-library-cite lib "LESS-THEN-WEAK" (list *proof-zero* d n)
                                        (list int-zero int-d int-n pos-d large-n)))
      (others (library-library-axiom lib "<-ON-OTHERS" (list n d)))
      (nonneg-small (proof-proof-rewrite proof large-n others '(1 1)))
      (int-small (library-library-type-of lib smaller-n integers))
      (less (library-library-less-from-difference lib smaller-n n pos-d integers))
      (descent (library-library-cite lib "NFIX-DECREASE" (list smaller-n n)
                                     (list int-small int-n positive-n less)))
      (child (proof-subst formula (list (cons n smaller-n))))
      (descent-claim (proof-step-first descent))
      (hyp (proof-proof-assume proof (proof-ite descent-claim child *proof-true*) t))
      (hyp (proof-proof-prove-if proof hyp descent))
      (child-guard (b1-logic-bookproof-normalize-proof
                    lib (cadr child) (list int-small int-d nonneg-small pos-d) nil nil nil))
      (child-proof (proof-proof-modus-ponens proof hyp child-guard))
      (parts (b1-logic-bookproof-split-conjuncts lib child-proof))
      (parts (proof-list-of-length parts 3))
      (nat-claim (proof-step-first (car parts)))
      (q-child (proof-term-at nat-claim 1))
      (int-q (library-library-cite lib "NATURAL-INTEGER" (list q-child) (list (car parts))))
      (q-eq (b1-quotient-quotient-bounds-consequence-open-quotient
             large-n lib q int-n nonzero-d nfix-rule))
      (natural-one (library-library-natural lib *proof-one*))
      (successor (library-library-cite lib "NATURAL-SUM" (list *proof-one* q-child)
                                       (list natural-one (car parts))))
      (successor (library-library-transport-argument lib successor q-eq 1))
      (all-ints (list int-n int-d int-q))
      (lower-eq (b1-quotient-quotient-bounds-consequence-comparison
                 q q-child nil lib n d smaller-n q-eq int-d all-ints))
      (lower (library-library-transport-argument lib (cadr parts) lower-eq 1))
      (upper-eq (b1-quotient-quotient-bounds-consequence-comparison
                 (library-plus *proof-one* q) (library-plus *proof-one* q-child) '(2)
                 lib n d smaller-n q-eq int-d all-ints))
      (upper (proof-proof-transport proof (caddr parts) upper-eq)))
     (b1-logic-bookproof-normalize-proof lib conclusion (list successor lower upper)
                                         nil nil nil))))

(defun b1-quotient-quotient-bounds-consequence (premise lib n d q conclusion formula smaller-n)
  (let ((proof (library-library-proof lib))
        (bound (library-lt n d)))
    (proof-with-checked-results
     ((parts (b1-logic-bookproof-split-conjuncts lib premise))
      (parts (proof-list-of-length parts 4))
      (int-n (car parts))
      (int-d (cadr parts))
      (nonneg-n (caddr parts))
      (pos-d (cadddr parts))
      (nat-d (b1-quotient-natural-from-positive lib d int-d pos-d))
      (nonzero-d (b1-arithmetic-positive-nonzero lib pos-d))
      (nfix (b1-integer-nfix-identity lib nat-d))
      (nfix-rule (b1-logic-equal-to nfix))
      (base (b1-quotient-quotient-bounds-base
             lib n d q conclusion bound int-n int-d nonneg-n nonzero-d nfix-rule))
      (step (b1-quotient-quotient-bounds-step
             lib n d q conclusion formula bound smaller-n int-n int-d pos-d nonzero-d nfix-rule)))
     (proof-proof-cases proof bound base step))))

(defun b1-quotient-quotient-bounds (lib)
  (let* ((name (proof-sym "SELF-QUOTIENT-BOUNDS" "ACL2"))
         (proof (library-library-proof lib)))
    (if (assoc-equal name (proof-proof-facts proof))
        (cons name lib)
      (let* ((n *library-x*)
             (d *library-y*)
             (q (list *b1-quotient-niq* n d))
             (guard (proof-ite (library-integer n)
                      (proof-ite (library-integer d)
                        (proof-ite (library-nonnegative n) (library-positive d) *proof-false*)
                        *proof-false*)
                      *proof-false*))
             (bounds (proof-ite (proof-neg (library-lt n (b1-arithmetic-product d q)))
                                (library-lt n (b1-arithmetic-product d
                                                                     (library-plus *proof-one* q)))
                                *proof-false*))
             (conclusion (proof-ite (list *library-natp* q) bounds *proof-false*))
             (formula (list *library-implies* guard conclusion))
             (measure (list *library-nfix* n))
             (smaller-n (library-diff n d))
             (pairs (list (list n smaller-n))))
        (proof-with-checked-results
         ((premise (b1-logic-bookproof-prove-implication-premise lib formula))
          (consequence (b1-quotient-quotient-bounds-consequence
                        premise lib n d q conclusion formula smaller-n))
          (step (b1-logic-bookproof-prove-implication-with-premise lib formula premise consequence))
          (ordinal (library-library-cite lib "NFIX-ORDINAL" (list n) nil))
          (step (proof-proof-induct proof ordinal step formula measure (list pairs)))
          (lib (library-library-lemma lib "QUOTIENT-BOUNDS" formula step nil)))
         (cons name lib))))))

(defun b1-quotient-count-integer (lib integer-p sign)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
     ((integer-claim (proof-step-first integer-p))
      (argument (proof-term-at integer-claim 1))
      (evidence (list integer-p))
      (rational (b1-arithmetic-known-type lib *library-rationalp* argument evidence))
      (numeric (b1-arithmetic-known-type lib *library-numberp* argument evidence))
      (consp-test (list *proof-consp* argument))
      (axiom (proof-proof-fact proof "consp-not-acl2-numberp" (list (list *library-x* argument))))
      (assumed (proof-proof-assume proof consp-test t))
      (clash (proof-proof-modus-ponens proof axiom assumed))
      (cut (proof-proof-cut proof numeric clash))
      (noncons (proof-proof-front proof cut (proof-neg consp-test))))
     (b1-logic-bookproof-normalize lib (list *library-count* argument)
                                  (list integer-p sign rational numeric noncons)
                                  (list *library-count* *b1-quotient-abs*) nil nil nil nil))))

(defun b1-quotient-count-natural (lib natural)
  (proof-with-checked-results
   ((claim (proof-step-first natural))
    (argument (proof-term-at claim 1))
    (integer-p (library-library-cite lib "NATURAL-INTEGER" (list argument) (list natural)))
    (lower (library-library-cite lib "NATURAL-NONNEGATIVE" (list argument) (list natural))))
   (b1-quotient-count-integer lib integer-p lower)))

(defun b1-quotient-quotient-less (lib int-n int-d pos-d pos-n int-i strict)
  (proof-with-checked-results
   ((n-claim (proof-step-first int-n))
    (n (proof-term-at n-claim 1))
    (d-claim (proof-step-first int-d))
    (d (proof-term-at d-claim 1))
    (q (list *b1-quotient-niq* n d))
    (i-claim (proof-step-first int-i))
    (i (proof-term-at i-claim 1))
    (bounds (b1-quotient-quotient-bounds lib))
    (lib (cdr bounds))
    (theorem (library-inherited proof-proof-fact lib (car bounds)
                                (list (list *library-x* n) (list *library-y* d))))
    (nonneg-n (library-library-cite lib "POSITIVE-NONNEGATIVE" (list n) (list int-n pos-n)))
    (theorem-claim (proof-step-first theorem))
    (guard (proof-term-at theorem-claim 1))
    (condition (b1-logic-bookproof-normalize-proof
                lib guard (list int-n int-d nonneg-n pos-d) nil nil nil))
    (applied (library-inherited proof-proof-modus-ponens lib theorem condition))
    (parts (b1-logic-bookproof-split-conjuncts lib applied))
    (parts (proof-list-of-length parts 3))
    (nat-q (car parts))
    (upper (cadr parts))
    (int-q (library-library-cite lib "NATURAL-INTEGER" (list q) (list nat-q)))
    (types (list int-n int-d int-i int-q))
    (test (library-lt i q))
    (assumed (library-inherited proof-proof-assume lib test t))
    (strict-product (b1-arithmetic-multiply-strict lib pos-d assumed types))
    (lib (cdr strict-product)))
   (let ((proof (library-library-proof lib))
         (d-i (b1-arithmetic-product d i))
         (d-q (b1-arithmetic-product d q)))
     (proof-with-checked-results
      ((int-di (library-library-type-of lib d-i types))
       (int-dq (library-library-type-of lib d-q types))
       (yes (library-library-cite lib "LESS-TO-WEAK" (list d-i d-q)
                                  (list int-di int-dq (car strict-product))))
       (q-less (library-lt q i))
       (eq-test (proof-eq q i))
       (compare (b1-arithmetic-integer-compare lib q i types))
       (negative (proof-proof-assume proof test nil))
       (cut (proof-proof-cut proof compare negative))
       (equal-proof (proof-proof-front proof cut eq-test))
       (no (library-library-cite lib "WEAK-REFLEXIVE" (list d-q) (list int-dq)))
       (no (proof-proof-rewrite proof no equal-proof '(1 1 2 2)))
       (weak (proof-proof-cases proof test yes no))
       (contradiction (library-library-cite lib "LESS-THEN-WEAK" (list n d-i d-q)
                                            (list int-n int-di int-dq strict weak)))
       (cut (proof-proof-cut proof contradiction upper))
       (less (proof-proof-front proof cut q-less)))
      (cons (list less nat-q) lib)))))

(defun b1-quotient-floor-half-bound-floor-case (denominator lib floor n-nonnegative identity)
  (b1-logic-bookproof-normalize
   lib floor (list denominator n-nonnegative)
   (list *b1-quotient-floor* *b1-quotient-numeric-eq* *b1-logic-eql* *proof-not*)
   (list identity) nil nil nil))

(defun b1-quotient-floor-half-bound (lib i int-i pos-i)
  (let* ((half (proof-quote '("ratio" 1 2)))
         (value (b1-arithmetic-product i half)))
    (proof-with-checked-results
     ((rational (b1-arithmetic-known-type lib *library-rationalp* value (list int-i)))
      (half-eq (b1-logic-bookproof-constant lib (library-positive half)))
      (half-pos (if half-eq
                    (library-inherited proof-proof-true-from-eq lib half-eq)
                  (library-inherited proof-proof-prove lib (library-positive half) nil nil)))
      (half-positive (b1-arithmetic-positive-product lib pos-i half-pos (list int-i)))
      (representation (b1-arithmetic-numerator-product lib rational))
      (int-d (caadr representation))
      (int-n (cadadr representation))
      (pos-d (car (cddadr representation)))
      (n-claim (proof-step-first int-n))
      (n (proof-term-at n-claim 1))
      (d-claim (proof-step-first int-d))
      (d (proof-term-at d-claim 1))
      (commute (library-library-axiom lib "COMMUTATIVITY-OF-*" (list d value)))
      (represented (library-inherited proof-proof-chain lib commute (list (car representation))))
      (pos-n (b1-arithmetic-positive-product lib pos-d half-positive (list int-d rational)))
      (pos-n (library-inherited proof-proof-rewrite lib pos-n represented '(1 2)))
      (sums (b1-arithmetic-number-sums-init lib))
      (lib (b1-arithmetic-number-sums-library sums))
      (numeric-i (b1-arithmetic-known-type lib *library-numberp* i (list int-i)))
      (half-less (b1-arithmetic-number-sums-comparison sums value i (list numeric-i)))
      (distribution (library-library-axiom lib "DISTRIBUTIVITY" (list i half half)))
      (double-half (library-inherited proof-proof-symmetric lib distribution))
      (sum (b1-logic-bookproof-constant lib (library-plus half half)))
      (double-half (library-inherited proof-proof-rewrite lib double-half sum '(1 2 2)))
      (unit (b1-arithmetic-multiply-one lib i (list numeric-i) nil))
      (double-half (library-inherited proof-proof-chain lib double-half (list unit)))
      (double-half (library-inherited proof-proof-symmetric lib double-half))
      (half-less (library-inherited proof-proof-rewrite lib half-less double-half '(1 2 2 1)))
      (delta (b1-arithmetic-number-sums-linear-equal
              sums (library-diff (library-plus value value) value) value nil))
      (half-less (library-inherited proof-proof-rewrite lib half-less delta '(1 2 2)))
      (half-less (library-inherited proof-proof-transport lib half-positive half-less))
      (scaled (b1-arithmetic-multiply-strict lib pos-d half-less (list int-i int-d rational)))
      (lib (cdr scaled))
      (up (library-inherited proof-proof-rewrite lib (car scaled) represented '(1 1)))
      (quotient (b1-quotient-quotient-less lib int-n int-d pos-d pos-n int-i up))
      (lib (cdr quotient)))
     (let ((proof (library-library-proof lib))
           (denominator-one (proof-eq d *proof-one*))
           (floor (list *b1-quotient-floor* value *proof-one*)))
       (proof-with-checked-results
        ((niq-less (caar quotient))
         (nat-q (cadar quotient))
         (nat-n (b1-quotient-natural-from-positive lib n int-n pos-n))
         (n-nonnegative (library-library-cite lib "NATURAL-NONNEGATIVE" (list n) (list nat-n)))
         (identity (b1-arithmetic-multiply-one lib value nil nil))
         (identity (b1-logic-equal-to identity))
         (d-unit (proof-proof-assume proof denominator-one t))
         (up-unit (proof-proof-rewrite proof up d-unit '(1 2 1)))
         (unit (b1-arithmetic-multiply-one lib i (list numeric-i) t))
         (up-unit (proof-proof-rewrite proof up-unit unit '(1 2)))
         (case-n (b1-quotient-floor-half-bound-floor-case d-unit lib floor n-nonnegative identity))
         (d-nonunit (proof-proof-assume proof denominator-one nil))
         (case-q (b1-quotient-floor-half-bound-floor-case d-nonunit lib floor n-nonnegative identity))
         (lt-unit (library-library-transport-argument lib up-unit case-n 1))
         (lt-other (library-library-transport-argument lib niq-less case-q 1))
         (lt-floor (proof-proof-cases proof denominator-one lt-unit lt-other))
         (nat-unit (library-library-transport-argument lib nat-n case-n 1))
         (nat-other (library-library-transport-argument lib nat-q case-q 1))
         (nat-floor (proof-proof-cases proof denominator-one nat-unit nat-other)))
        (cons (list lt-floor nat-floor) lib))))))

(defun b1-quotient-shift-descent-lemma (lib)
  (let* ((x *library-x*)
         (guard (list *b1-logic-zp* x))
         (shift (list *b1-quotient-ash* x *proof-neg-one*)))
    (proof-with-checked-results
     ((assertion (library-inherited proof-proof-assume lib guard nil))
      (int-x (b1-logic-bookproof-forces lib (library-integer x) assertion nil
                                        (list *b1-logic-zp* *proof-not*) nil))
      (assertion (library-inherited proof-proof-assume lib guard nil))
      (positive-x (b1-integer-no-zp lib x assertion int-x))
      (half-bound (b1-quotient-floor-half-bound lib x int-x positive-x))
      (lib (cdr half-bound))
      (less (caar half-bound))
      (natural-half (cadar half-bound))
      (natural-x (b1-quotient-natural-from-positive lib x int-x positive-x))
      (count-small (b1-quotient-count-natural lib natural-half))
      (count-big (b1-quotient-count-natural lib natural-x))
      (expt-zero (b1-logic-bookproof-normalize
                  lib (list *b1-quotient-expt* (proof-quote 2) *proof-zero*) nil
                  (list *b1-quotient-expt* *b1-quotient-zip* *b1-quotient-numeric-eq*
                        *b1-logic-eql*) nil nil nil nil))
      (expt-rule (b1-logic-equal-to expt-zero))
      (shift-eq (b1-logic-bookproof-normalize
                 lib shift (list int-x)
                 (list *b1-quotient-ash* *b1-quotient-ifix* *b1-quotient-expt*
                       *b1-quotient-zip* *b1-quotient-numeric-eq* *b1-logic-eql*
                       (proof-sym "FIX" "ACL2"))
                 (list expt-rule) nil nil nil))
      (ordered (library-library-transport-argument lib less count-small 1))
      (ordered (library-library-transport-argument lib ordered count-big 2))
      (small-claim (proof-step-first count-small))
      (small (proof-term-at small-claim 1))
      (big-claim (proof-step-first count-big))
      (big (proof-term-at big-claim 1))
      (ordering (library-library-ordinal-comparison lib small big))
      (ordered (library-inherited proof-proof-transport lib ordered ordering))
      (reversed (library-inherited proof-proof-symmetric lib shift-eq))
      (ordered (library-inherited proof-proof-rewrite lib ordered reversed '(1 1 1)))
      (ordered (library-inherited proof-proof-tidy lib ordered)))
     (library-library-lemma lib "ASH-RIGHT-DECREASE"
                            (list *proof-ordinal-less* (list *library-count* shift)
                                  (list *library-count* x))
                            ordered (list guard)))))

(defun b1-quotient-shift-descent (lib goal)
  (let ((name (proof-sym "SELF-ASH-RIGHT-DECREASE" "ACL2")))
    (proof-with-checked-results
     ((lib (if (assoc-equal name (proof-proof-facts (library-library-proof lib)))
               lib
             (b1-quotient-shift-descent-lemma lib)))
      (step (b1-logic-bookproof-from-fact lib name goal)))
     (cons step lib))))
