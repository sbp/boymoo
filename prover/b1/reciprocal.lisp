(in-package "BOYMOO-PROVER")
(set-verify-guards-eagerness 0)

(defun b1-reciprocal-reverse-inequality (lib negative)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
     ((literal (proof-step-first negative))
      (equality (proof-term-at literal 1))
      (parts (proof-list-of-length equality 3))
      (opposite (proof-eq (caddr parts) (cadr parts)))
      (assumed (proof-proof-assume proof opposite t))
      (positive (proof-proof-symmetric proof assumed))
      (cut (proof-proof-cut proof positive negative)))
     (proof-proof-front proof cut (proof-neg opposite)))))

(defun b1-reciprocal-above-one-consequence (bound lib formula)
  (proof-with-checked-results
   ((bound-claim (proof-step-first bound))
    (x (proof-term-at bound-claim 2))
    (y (b1-arithmetic-reciprocal x))
    (int-y (library-inherited proof-proof-assume lib (library-integer y) t))
    (x-numeric (b1-arithmetic-number-from-comparison lib bound 2))
    (x-nonzero (b1-arithmetic-comparison-excludes lib bound *proof-zero* 2))
    (xy-one (b1-arithmetic-inverse-product lib x x-numeric x-nonzero))
    (commute (library-library-axiom lib "COMMUTATIVITY-OF-*" (list y x)))
    (yx-one (library-inherited proof-proof-chain lib commute (list xy-one)))
    (y-numeric (b1-arithmetic-known-type lib *library-numberp* y (list int-y)))
    (zero-y (proof-eq y *proof-zero*))
    (assumed (library-inherited proof-proof-assume lib zero-y t))
    (empty (library-inherited proof-proof-rewrite lib xy-one assumed '(1 1 2)))
    (product-zero (b1-arithmetic-multiply-zero lib x))
    (empty (library-inherited proof-proof-rewrite lib empty product-zero '(1 1)))
    (impossible (b1-arithmetic-simplify-first lib empty))
    (y-nonzero (library-inherited proof-proof-front lib impossible (proof-neg zero-y)))
    (y-inv (b1-arithmetic-inverse-product lib y y-numeric y-nonzero))
    (x-is-inverse (b1-arithmetic-product-unique lib y-inv yx-one x-numeric))
    (rational-inverse (b1-arithmetic-known-type lib *library-rationalp*
                                              (b1-arithmetic-reciprocal y) (list int-y)))
    (rational-x (library-library-transport-argument lib rational-inverse x-is-inverse 1))
    (y-positive (library-positive y))
    (yes-y (library-inherited proof-proof-assume lib y-positive t))
    (scaled (b1-arithmetic-multiply-strict lib yes-y bound (list int-y rational-x)))
    (lib (cdr scaled))
    (unit (b1-arithmetic-multiply-one lib y (list int-y) nil))
    (too-small (library-inherited proof-proof-rewrite lib (car scaled) unit '(1 1)))
    (too-small (library-inherited proof-proof-rewrite lib too-small yx-one '(1 2)))
    (integer-bound (b1-arithmetic-integer-discrete lib yes-y int-y))
    (cut (library-inherited proof-proof-cut lib too-small integer-bound))
    (claim (proof-term-at formula 2))
    (yes (library-inherited proof-proof-front lib cut claim))
    (smaller-than-zero (b1-arithmetic-integer-compare lib *proof-zero* y (list int-y)))
    (reverse (b1-reciprocal-reverse-inequality lib y-nonzero))
    (smaller-than-zero (library-inherited proof-proof-discharge lib smaller-than-zero reverse))
    (comparison (library-library-comparison lib y *proof-zero* (list int-y)))
    (y-neg (library-inherited proof-proof-rewrite lib smaller-than-zero comparison '(1)))
    (minus-y (library-minus y))
    (int-minus-y (library-library-type-of lib minus-y (list int-y)))
    (drop-zero (library-library-cite lib "ADD-ZERO-LEFT" (list minus-y) (list int-minus-y)))
    (y-neg (library-inherited proof-proof-rewrite lib y-neg drop-zero '(1 2)))
    (sums (b1-arithmetic-number-sums-init lib))
    (lib (b1-arithmetic-number-sums-library sums))
    (comparison (b1-arithmetic-number-sums-comparison sums *proof-one* x (list x-numeric)))
    (bigger-than-one (library-inherited proof-proof-rewrite lib bound comparison '(1)))
    (bigger-claim (proof-step-first bigger-than-one))
    (difference (proof-term-at bigger-claim 2))
    (positive (library-library-axiom lib "POSITIVE" (list *proof-one* difference)))
    (parts (b1-logic-bookproof-split-conjuncts lib positive))
    (add (if (consp parts) (car parts) '(:failure "failure" "")))
    (add-claim (proof-step-first add))
    (add-guard (proof-term-at add-claim 1))
    (positive-one (library-inherited proof-proof-prove lib (library-positive *proof-one*) nil nil))
    (guard (b1-logic-bookproof-normalize-proof lib add-guard
                                              (list positive-one bigger-than-one) nil nil nil))
    (larger (library-inherited proof-proof-modus-ponens lib add guard))
    (cancel (b1-arithmetic-number-sums-linear-equal
             sums (library-plus *proof-one* (library-diff x *proof-one*)) x
             (list x-numeric)))
    (pos-x (library-inherited proof-proof-rewrite lib larger cancel '(1 2)))
    (pos-product (b1-arithmetic-positive-product lib pos-x y-neg (list rational-x int-y)))
    (negation (b1-arithmetic-multiply-negation lib x y))
    (lib (cdr negation))
    (pos-product (library-inherited proof-proof-rewrite lib pos-product (car negation) '(1 2)))
    (pos-product (library-inherited proof-proof-rewrite lib pos-product xy-one '(1 2 1)))
    (pos-product (b1-arithmetic-simplify-first lib pos-product))
    (no (library-inherited proof-proof-front lib pos-product claim))
    (step (library-inherited proof-proof-cases lib y-positive yes no)))
   (cons step lib)))

(defun b1-reciprocal-above-one (lib formula)
  (proof-with-checked-results
   ((premise (b1-logic-bookproof-prove-implication-premise lib formula))
    (result (b1-reciprocal-above-one-consequence premise lib formula))
    (lib (cdr result))
    (step (b1-logic-bookproof-prove-implication-with-premise lib formula premise (car result))))
   (cons step lib)))

(defun b1-reciprocal-below-minus-one-consequence (bound lib formula)
  (proof-with-checked-results
   ((bound-claim (proof-step-first bound))
    (x (proof-term-at bound-claim 1))
    (numeric (b1-arithmetic-number-from-comparison lib bound 1))
    (reflection (b1-arithmetic-reflect-minus-one lib x numeric))
    (lib (cdr reflection))
    (signed (library-inherited proof-proof-rewrite lib bound (car reflection) '(1)))
    (y (b1-arithmetic-reciprocal x))
    (exclusion (b1-arithmetic-comparison-excludes lib bound *proof-zero* 1))
    (identity (b1-arithmetic-reciprocal-negation lib x numeric exclusion))
    (lib (cdr identity))
    (assumed (library-inherited proof-proof-assume lib (library-integer y) t))
    (integral (library-library-cite lib "INTEGER-NEGATION" (list y) (list assumed)))
    (reversed (library-inherited proof-proof-symmetric lib (car identity)))
    (integral (library-inherited proof-proof-rewrite lib integral reversed '(1 1)))
    (fact (library-inherited proof-proof-fact lib (proof-sym "NOT-INTEGERP-/-1" "ACL2")
                             (list (list *library-x* (library-minus x)))))
    (false (library-inherited proof-proof-modus-ponens lib fact signed))
    (cut (library-inherited proof-proof-cut lib integral false))
    (claim (proof-term-at formula 2))
    (step (library-inherited proof-proof-front lib cut claim)))
   (cons step lib)))

(defun b1-reciprocal-below-minus-one (lib formula)
  (proof-with-checked-results
   ((premise (b1-logic-bookproof-prove-implication-premise lib formula))
    (result (b1-reciprocal-below-minus-one-consequence premise lib formula))
    (lib (cdr result))
    (step (b1-logic-bookproof-prove-implication-with-premise lib formula premise (car result))))
   (cons step lib)))

(defun b1-reciprocal-integer-reciprocal-false-rules (steps lib)
  (if (endp steps)
      nil
    (proof-with-checked-results
     ((eq (b1-logic-bookproof-false-value lib (car steps)))
      (rule (b1-logic-equal-to eq))
      (rest (b1-reciprocal-integer-reciprocal-false-rules (cdr steps) lib)))
     (cons rule rest))))

(defun b1-reciprocal-integer-reciprocal-remaining (conditions lib x int-x formula)
  (proof-with-checked-results
   ((nonneg-test (library-positive x))
    (greater-than-zero (library-inherited proof-proof-assume lib nonneg-test t))
    (x-is-positive (b1-arithmetic-integer-discrete lib greater-than-zero int-x))
    (gt-one (b1-arithmetic-integer-compare lib x *proof-one* (list int-x)))
    (gt-one (library-inherited proof-proof-discharge lib gt-one x-is-positive))
    (gt-one (library-inherited proof-proof-discharge lib gt-one (caddr conditions)))
    (fact (library-inherited proof-proof-fact lib (proof-sym "NOT-INTEGERP-/-1" "ACL2") nil))
    (hi (library-inherited proof-proof-modus-ponens lib fact gt-one))
    (negative (b1-arithmetic-integer-compare lib *proof-zero* x (list int-x)))
    (reverse (b1-reciprocal-reverse-inequality lib (cadr conditions)))
    (negative (library-inherited proof-proof-discharge lib negative reverse))
    (comparison (library-library-comparison lib x *proof-zero* (list int-x)))
    (neg-x (library-inherited proof-proof-rewrite lib negative comparison '(1)))
    (minus-x (library-minus x))
    (integer-neg-x (library-library-type-of lib minus-x (list int-x)))
    (zero (library-library-cite lib "ADD-ZERO-LEFT" (list minus-x) (list integer-neg-x)))
    (neg-x (library-inherited proof-proof-rewrite lib neg-x zero '(1 2)))
    (neg-x-at-least-one (b1-arithmetic-integer-discrete lib neg-x integer-neg-x))
    (neg-x-above-one (b1-arithmetic-integer-compare lib minus-x *proof-one*
                                                  (list int-x integer-neg-x)))
    (neg-x-above-one (library-inherited proof-proof-discharge lib neg-x-above-one
                                       neg-x-at-least-one))
    (number-x (b1-arithmetic-known-type lib *library-numberp* x (list int-x)))
    (reflection (b1-arithmetic-reflect-minus-one lib x number-x))
    (lib (cdr reflection)))
   (let ((proof (library-library-proof lib))
         (sign-eq (proof-eq minus-x *proof-one*)))
     (proof-with-checked-results
      ((negations (proof-proof-reflexive proof (library-minus minus-x)))
       (assumed (proof-proof-assume proof sign-eq t))
       (negations (proof-proof-rewrite proof negations assumed '(1 2 1)))
       (involution (library-library-cite lib "DOUBLE-NEGATION" (list x) (list int-x)))
       (reversed (proof-proof-symmetric proof involution))
       (constant (b1-logic-bookproof-constant lib (library-minus *proof-one*)))
       (to-minus-one (proof-proof-chain proof reversed (list negations constant)))
       (cut (proof-proof-cut proof to-minus-one (car conditions)))
       (not-sign-eq (proof-proof-front proof cut (proof-neg sign-eq)))
       (neg-x-above-one (proof-proof-discharge proof neg-x-above-one not-sign-eq))
       (fact (proof-proof-fact proof (proof-sym "NOT-INTEGERP-/-2" "ACL2") nil))
       (transported (proof-proof-transport proof neg-x-above-one (car reflection)))
       (lo (proof-proof-modus-ponens proof fact transported))
       (not-integral (proof-proof-cases proof nonneg-test hi lo))
       (rules (b1-reciprocal-integer-reciprocal-false-rules (cons not-integral conditions) lib))
       (claim (proof-term-at formula 2))
       (step (b1-logic-bookproof-normalize-proof lib claim conditions nil rules nil)))
      (cons step lib)))))

(defun b1-reciprocal-integer-reciprocal-consequence-constants (values conditions lib x int-x formula)
  (if (endp values)
      (b1-reciprocal-integer-reciprocal-remaining conditions lib x int-x formula)
    (let ((test (proof-eq x (car values))))
      (proof-with-checked-results
       ((equality (library-inherited proof-proof-assume lib test t))
        (claim (proof-term-at formula 2))
        (rule (b1-logic-equal-to equality))
        (yes (b1-logic-bookproof-normalize-proof lib claim nil nil (list rule) nil))
        (negative (library-inherited proof-proof-assume lib test nil))
        (result (b1-reciprocal-integer-reciprocal-consequence-constants
                 (cdr values) (append conditions (list negative)) lib x int-x formula))
        (lib (cdr result))
        (step (library-inherited proof-proof-cases lib test yes (car result))))
       (cons step lib)))))

(defun b1-reciprocal-integer-reciprocal-consequence (int-x lib formula)
  (proof-with-checked-results
   ((literal (proof-step-first int-x))
    (x (proof-term-at literal 1)))
   (b1-reciprocal-integer-reciprocal-consequence-constants
    (list *proof-neg-one* *proof-zero* *proof-one*) nil lib x int-x formula)))

(defun b1-reciprocal-integer-reciprocal (lib formula)
  (proof-with-checked-results
   ((premise (b1-logic-bookproof-prove-implication-premise lib formula))
    (result (b1-reciprocal-integer-reciprocal-consequence premise lib formula))
    (lib (cdr result))
    (step (b1-logic-bookproof-prove-implication-with-premise lib formula premise (car result))))
   (cons step lib)))
