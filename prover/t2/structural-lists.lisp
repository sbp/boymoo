(in-package "BOYMOO-PROVER")
(set-verify-guards-eagerness 0)

(defconst *t2-structural-lists-append* (proof-sym "BINARY-APPEND" "ACL2"))
(defconst *t2-structural-lists-symbol-alistp* (proof-sym "SYMBOL-ALISTP" "ACL2"))
(defconst *t2-structural-lists-true-listp* (proof-sym "TRUE-LISTP" "ACL2"))
(defconst *t2-structural-lists-revappend* (proof-cl "REVAPPEND"))
(defconst *t2-structural-lists-fields*
  (list (cons *t2-structural-lists-symbol-alistp* 3)
        (cons *t2-structural-lists-true-listp* 1)))
(defconst *t2-structural-lists-merge* (proof-sym "MERGE-SYMBOL-ALIST-<" "ACL2"))
(defconst *t2-structural-lists-sort* (proof-sym "MERGE-SORT-SYMBOL-ALIST-<" "ACL2"))
(defconst *t2-structural-lists-symbol-less* (proof-sym "SYMBOL<" "ACL2"))
(defconst *t2-structural-lists-acc* (proof-sym "ACC" "ACL2"))

(defun t2-structural-lists-constructed (term)
  (or (equal term *proof-false*)
      (proof-is-call term *proof-cons*)))

(defun t2-structural-lists-append-associativity-expand (call)
  (if (equal (t2-book-logic-head call) *t2-structural-lists-append*)
      (proof-with-checked-results ((argument (proof-term-at call 1)))
        (or (equal argument *library-x*)
            (t2-structural-lists-constructed argument)))
    nil))

(defun t2-structural-lists-append-associativity (lib)
  (let ((name "STRUCTURAL-APPEND-ASSOCIATIVITY")
        (proof (library-library-proof lib)))
    (if (assoc-equal (proof-sym (concatenate 'string "SELF-" name) "ACL2")
                     (proof-proof-facts proof))
        (cons name lib)
      (let* ((x *library-x*)
             (y *library-y*)
             (z *library-z*)
             (append-op *t2-structural-lists-append*)
             (formula (proof-eq (list append-op (list append-op x y) z)
                                (list append-op x (list append-op y z))))
             (branch (list *proof-consp* x))
             (tests (list (list branch t)))
             (expand (list (list :arg append-op 1 x) (list :constructed append-op 1))))
        (proof-with-checked-results
            ((smaller (t2-structural-proof-smaller lib formula x (list *t2-book-logic-cdr* x) tests nil nil))
             (hypothesis (car smaller))
             (pairs (cadr smaller))
             (yes (t2-structural-proof-solve lib formula expand tests nil (list hypothesis) 10))
             (no (t2-structural-proof-solve (cdr yes) formula expand (list (list branch nil)) nil nil 10))
             (lib (cdr no))
             (case-proof (proof-proof-cases (library-library-proof lib) branch (car yes) (car no)))
             (inducted (t2-structural-proof-induct lib formula x case-proof (list pairs)))
             (lib (library-library-lemma lib name formula inducted nil)))
          (cons name lib))))))

(defun t2-structural-lists-append-to-empty (lib)
  (let ((name "STRUCTURAL-APPEND-TO-EMPTY")
        (proof (library-library-proof lib)))
    (if (assoc-equal (proof-sym (concatenate 'string "SELF-" name) "ACL2")
                     (proof-proof-facts proof))
        (cons name lib)
      (let* ((x *library-x*)
             (append-op *t2-structural-lists-append*)
             (domain (list *t2-structural-lists-true-listp* x))
             (expression (list append-op x *proof-false*))
             (target (proof-eq expression x))
             (formula (list *library-implies* domain target))
             (branch (list *proof-consp* x)))
        (proof-with-checked-results
            ((typed (proof-proof-assume proof domain t))
             (tests (list (list branch t)))
             (components (t2-structural-proof-components lib typed tests 1 nil))
             (lib (cdr components))
             (tail (caar components))
             (smaller (t2-structural-proof-smaller lib formula x (list *t2-book-logic-cdr* x) tests nil nil))
             (hypothesis (car smaller))
             (substitutions (cadr smaller))
             (recursive (t2-arithmetic-arithmetic-modus-ponens lib hypothesis tail))
             (elimination (library-library-axiom lib "CAR-CDR-ELIM" (list x)))
             (nonempty (proof-proof-assume (library-library-proof lib) branch t))
             (collapsed (t2-arithmetic-arithmetic-modus-ponens lib elimination nonempty))
             (expand (list (list :term expression) (list :constructed append-op 1)))
             (yes (t2-structural-proof-solve lib target expand tests nil (list recursive collapsed) 10))
             (lib (cdr yes))
             (tests (list (list branch nil)))
             (opened (t2-structural-proof-reduce lib (list (list :term domain)) tests nil nil domain))
             (lib (cdr opened))
             (nil-eq (proof-proof-rewrite (library-library-proof lib) typed (car opened) '(1)))
             (no (t2-structural-proof-solve lib target expand tests nil (list nil-eq) 10))
             (lib (cdr no))
             (case-proof (proof-proof-cases (library-library-proof lib) branch (car yes) (car no)))
             (step (t2-power-implication lib domain case-proof))
             (inducted (t2-structural-proof-induct lib formula x step (list substitutions)))
             (lib (library-library-lemma lib name formula inducted nil)))
          (cons name lib))))))

(defun t2-structural-lists-preserve-list-predicate-expand (call operation predicate)
  (let ((operator (t2-book-logic-head call)))
    (if (or (equal operator operation) (equal operator predicate))
        (proof-with-checked-results ((argument (proof-term-at call 1)))
          (or (and (equal operator operation) (equal argument *library-x*))
              (and (equal operator predicate) (t2-structural-lists-constructed argument))))
      nil)))

(defun t2-structural-lists-field-count (predicate)
  (let ((entry (assoc-equal predicate *t2-structural-lists-fields*)))
    (if entry
        (cdr entry)
      '(:failure "MissingBinding" ""))))

(defun t2-structural-lists-unpack-arguments (term count)
  (if (integerp term)
      '(:failure "failure" "")
    (proof-list-of-length (cdr term) count)))

(defun t2-structural-lists-preserve-list-predicate (lib operation predicate)
  (proof-with-checked-results
      ((operation-name (proof-term-at operation 2))
       (predicate-name (proof-term-at predicate 2)))
    (let ((name (concatenate 'string "STRUCTURAL-" operation-name "-" predicate-name))
          (proof (library-library-proof lib)))
      (if (assoc-equal (proof-sym (concatenate 'string "SELF-" name) "ACL2")
                       (proof-proof-facts proof))
          (cons name lib)
        (let* ((x *library-x*)
               (y *library-y*)
               (px (list predicate x))
               (py (list predicate y)))
          (proof-with-checked-results
              ((assume-x (proof-proof-assume proof px t))
               (assume-y (proof-proof-assume proof py t))
               (joined (t2-power-join lib (list assume-x assume-y)))
               (domain (proof-step-first joined))
               (result (list predicate (list operation x y)))
               (formula (list *library-implies* domain result))
               (assume-domain (proof-proof-assume proof domain t))
               (conjuncts (t2-power-conjuncts lib assume-domain 2))
               (has-x (car conjuncts))
               (has-y (cadr conjuncts))
               (branch (list *proof-consp* x))
               (tests (list (list branch t)))
               (count (t2-structural-lists-field-count predicate))
               (components (t2-structural-proof-components lib has-x tests count nil))
               (lib (cdr components))
               (parts (car components))
               (fields (butlast parts 1))
               (next-acc (list *proof-cons* (list *t2-book-logic-car* x) y))
               (expand (list (list :arg operation 1 x) (list :constructed predicate 1)))
               (reversed-p (equal operation *t2-structural-lists-revappend*))
               (bindings (and reversed-p (list (list y next-acc))))
               (smaller (t2-structural-proof-smaller lib formula x (list *t2-book-logic-cdr* x) tests nil bindings))
               (accumulator (if reversed-p
                                (t2-structural-proof-solve lib (list predicate next-acc) expand tests
                                                           (append fields (list has-y)) nil 10)
                              (cons has-y lib)))
               (lib (cdr accumulator))
               (premise (t2-power-join lib (list (car (last parts)) (car accumulator))))
               (instance (t2-arithmetic-arithmetic-modus-ponens lib (car smaller) premise))
               (yes (t2-structural-proof-solve lib result expand tests (append fields (list instance)) nil 10))
               (no (t2-structural-proof-solve (cdr yes) result expand (list (list branch nil)) (list has-y) nil 10))
               (lib (cdr no))
               (case-proof (proof-proof-cases (library-library-proof lib) branch (car yes) (car no)))
               (implication (t2-power-implication lib domain case-proof))
               (inducted (t2-structural-proof-induct lib formula x implication (list (cadr smaller))))
               (lib (library-library-lemma lib name formula inducted nil)))
            (cons name lib)))))))

(defun t2-structural-lists-predicate-tail (lib predicate)
  (proof-with-checked-results ((predicate-name (proof-term-at predicate 2)))
    (let ((name (concatenate 'string "STRUCTURAL-TAIL-" predicate-name))
          (proof (library-library-proof lib)))
      (if (assoc-equal (proof-sym (concatenate 'string "SELF-" name) "ACL2")
                       (proof-proof-facts proof))
          (cons name lib)
        (let* ((x *library-x*)
               (domain (list predicate x))
               (target (list predicate (list *t2-book-logic-cdr* x)))
               (branch (list *proof-consp* x)))
          (proof-with-checked-results
              ((has-x (proof-proof-assume proof domain t))
               (count (t2-structural-lists-field-count predicate))
               (components (t2-structural-proof-components lib has-x (list (list branch t)) count nil))
               (yes (car (last (car components))))
               (expand (list (list :arg predicate 1 *proof-false*)))
               (no (t2-structural-proof-solve (cdr components) target expand (list (list branch nil)) nil nil 10))
               (lib (cdr no))
               (case-proof (proof-proof-cases (library-library-proof lib) branch yes (car no)))
               (implication (t2-power-implication lib domain case-proof))
               (claim (proof-step-first implication))
               (lib (library-library-lemma lib name claim implication nil)))
            (cons name lib)))))))

(defun t2-structural-lists-evens-preserves-expand (call term)
  (cond ((equal call term) t)
        ((equal (t2-book-logic-head call) *t2-structural-lists-symbol-alistp*)
         (proof-with-checked-results ((argument (proof-term-at call 1)))
           (t2-structural-lists-constructed argument)))
        (t nil)))

(defun t2-structural-lists-evens-preserves (lib formula)
  (let ((proof (library-library-proof lib))
        (predicate *t2-structural-lists-symbol-alistp*))
    (proof-with-checked-results
        ((parts (t2-structural-lists-unpack-arguments formula 2))
         (domain (car parts))
         (result (cadr parts))
         (term (proof-term-at result 1))
         (source (proof-term-at term 1))
         (root (list *proof-consp* source))
         (tests (list (list root t)))
         (tail (list *t2-book-logic-cdr* source))
         (next-list (list *t2-book-logic-cdr* tail))
         (assume-domain (proof-proof-assume proof domain t))
         (components (t2-structural-proof-components lib assume-domain tests 3 nil))
         (fields (car components))
         (tail-rule (t2-structural-lists-predicate-tail (cdr components) predicate))
         (lib (cdr tail-rule))
         (tail-rule (library-library-cite lib (car tail-rule) (list tail) nil))
         (accepted-tail (t2-arithmetic-arithmetic-modus-ponens lib tail-rule (car (last fields))))
         (smaller (t2-structural-proof-smaller lib formula source next-list tests nil nil))
         (recursed (t2-arithmetic-arithmetic-modus-ponens lib (car smaller) accepted-tail))
         (expand (list (list :term term) (list :constructed predicate 1)))
         (yes (t2-structural-proof-solve lib result expand tests (append (butlast fields 1) (list recursed)) nil 10))
         (no (t2-structural-proof-solve (cdr yes) result expand (list (list root nil)) nil nil 10))
         (lib (cdr no))
         (case-proof (proof-proof-cases (library-library-proof lib) root (car yes) (car no)))
         (step (t2-power-implication lib domain case-proof))
         (inducted (t2-structural-proof-induct lib formula source step (list (cadr smaller)))))
      (cons inducted lib))))

(defun t2-structural-lists-merge-preserves-expand (call term predicate)
  (cond ((equal call term) t)
        ((equal (t2-book-logic-head call) predicate)
         (proof-with-checked-results ((argument (proof-term-at call 1)))
           (t2-structural-lists-constructed argument)))
        (t nil)))

(defun t2-structural-lists-merge-preserves-branch
    (lib formula result expand both-lists measure test accumulator accumulated left right take-first element typed)
  (let* ((predicate *t2-structural-lists-symbol-alistp*)
         (next-acc (list *proof-cons* (list *t2-book-logic-car* element) accumulator))
         (child (list *t2-book-logic-cdr* element))
         (bindings (list (list element child) (list accumulator next-acc))))
    (proof-with-checked-results
        ((components (t2-structural-proof-components lib typed both-lists 3 nil))
         (lib (cdr components))
         (fields (car components))
         (smaller-acc (t2-structural-proof-solve lib (list predicate next-acc) expand both-lists
                                                 (append (butlast fields 1) (list accumulated)) nil 10))
         (lib (cdr smaller-acc))
         (tail (car (last fields)))
         (actuals (if take-first (list tail right) (list left tail)))
         (bindings-map (table-put (list (cons element child)) accumulator next-acc))
         (child-measure (proof-subst measure bindings-map))
         (comparison (list *proof-ordinal-less* child-measure measure))
         (ruler-facts (t2-tactics-ruler-facts-init lib both-lists nil))
         (descent (t2-lists-sum-decrease lib comparison ruler-facts))
         (hypothesis (t2-structural-proof-induction-instance lib formula (car descent) bindings))
         (premise (t2-power-join lib (append actuals (list (car smaller-acc)))))
         (recursion (t2-arithmetic-arithmetic-modus-ponens lib hypothesis premise))
         (tests (append both-lists (list (list test take-first))))
         (branch (t2-structural-proof-solve lib result expand tests (list recursion) nil 10)))
      (cons (list (car branch) bindings) (cdr branch)))))

(defun t2-structural-lists-merge-preserves (lib formula)
  (let ((proof (library-library-proof lib))
        (predicate *t2-structural-lists-symbol-alistp*)
        (car-op *t2-book-logic-car*))
    (proof-with-checked-results
        ((parts (t2-structural-lists-unpack-arguments formula 2))
         (domain (car parts))
         (result (cadr parts))
         (term (proof-term-at result 1))
         (arguments (t2-structural-lists-unpack-arguments term 3))
         (first (car arguments))
         (second (cadr arguments))
         (accumulator (caddr arguments))
         (assume-domain (proof-proof-assume proof domain t))
         (conjuncts (t2-power-conjuncts lib assume-domain 3))
         (left (car conjuncts))
         (right (cadr conjuncts))
         (accumulated (caddr conjuncts))
         (first-cons (list *proof-consp* first))
         (second-cons (list *proof-consp* second))
         (test (list *t2-structural-lists-symbol-less* (list car-op (list car-op first))
                     (list car-op (list car-op second))))
         (both-lists (list (list first-cons t) (list second-cons t)))
         (measure (library-plus (list *library-len* first) (list *library-len* second)))
         (natural (t2-arithmetic-arithmetic-natural lib measure))
         (ordinal (library-library-cite lib "NATURAL-ORDINAL" (list measure) (list natural)))
         (expand (list (list :term term) (list :constructed predicate 1)))
         (lemma (t2-structural-lists-preserve-list-predicate lib *t2-structural-lists-revappend* predicate))
         (lib (cdr lemma))
         (name (car lemma))
         (empty-first (library-library-cite lib name (list accumulator second) nil))
         (premise (t2-power-join lib (list accumulated right)))
         (empty-first (t2-arithmetic-arithmetic-modus-ponens lib empty-first premise))
         (empty-second (library-library-cite lib name (list accumulator first) nil))
         (premise (t2-power-join lib (list accumulated left)))
         (empty-second (t2-arithmetic-arithmetic-modus-ponens lib empty-second premise))
         (base-first (t2-structural-proof-solve lib result expand (list (list first-cons nil)) (list empty-first) nil 10))
         (base-second (t2-structural-proof-solve (cdr base-first) result expand (list (list first-cons t) (list second-cons nil))
                                                 (list empty-second) nil 10))
         (take-first (t2-structural-lists-merge-preserves-branch
                      (cdr base-second) formula result expand both-lists measure test
                      accumulator accumulated left right t first left))
         (take-second (t2-structural-lists-merge-preserves-branch
                       (cdr take-first) formula result expand both-lists measure test
                       accumulator accumulated left right nil second right))
         (lib (cdr take-second))
         (proof (library-library-proof lib))
         (both (proof-proof-cases proof test (caar take-first) (caar take-second)))
         (first-present (proof-proof-cases proof second-cons both (car base-second)))
         (step (proof-proof-cases proof first-cons first-present (car base-first)))
         (step (t2-power-implication lib domain step))
         (inducted (proof-proof-induct proof ordinal step formula measure
                                       (list (cadar take-first) (cadar take-second)))))
      (cons inducted lib))))

(defun t2-structural-lists-sort-preserves-expand (call term predicate)
  (cond ((equal call term) t)
        ((equal (t2-book-logic-head call) predicate)
         (proof-with-checked-results ((argument (proof-term-at call 1)))
           (equal argument *proof-false*)))
        (t nil)))

(defun t2-structural-lists-sort-preserves-child (lib child formula source measure tests)
  (proof-with-checked-results
      ((literal (proof-step-first child))
       (smaller-list (proof-term-at literal 1))
       (bindings (list (list source smaller-list)))
       (comparison (list *proof-ordinal-less* (list *library-len* smaller-list) measure))
       (facts (t2-tactics-ruler-facts-init lib tests nil))
       (descent (t2-lists-split-decrease lib comparison facts :ruler-facts))
       (lib (cadr descent))
       (hypothesis (t2-structural-proof-induction-instance lib formula (car descent) bindings))
       (result (t2-arithmetic-arithmetic-modus-ponens lib hypothesis child)))
    (cons (list result bindings) lib)))

(defun t2-structural-lists-sort-preserves (lib formula)
  (let ((proof (library-library-proof lib))
        (predicate *t2-structural-lists-symbol-alistp*)
        (x *library-x*)
        (y *library-y*))
    (proof-with-checked-results
        ((parts (t2-structural-lists-unpack-arguments formula 2))
         (domain (car parts))
         (result (cadr parts))
         (term (proof-term-at result 1))
         (source (proof-term-at term 1))
         (tail (list *t2-book-logic-cdr* source))
         (measure (list *library-len* source))
         (natural (t2-arithmetic-arithmetic-natural lib measure))
         (ordinal (library-library-cite lib "NATURAL-ORDINAL" (list measure) (list natural)))
         (typed (proof-proof-assume proof domain t))
         (branch (list *proof-consp* tail))
         (tests (list (list branch t)))
         (even-rule (proof-sym "SYMBOL-ALISTP-EVENS" "ACL2"))
         (merge-rule (proof-sym "SYMBOL-ALISTP-MERGE-SYMBOL-ALIST-<" "ACL2"))
         (tail-rule (t2-structural-lists-predicate-tail lib predicate))
         (lib (cdr tail-rule))
         (proof (library-library-proof lib))
         (tail-step (library-library-cite lib (car tail-rule) (list source) nil))
         (typed-tail (t2-arithmetic-arithmetic-modus-ponens lib tail-step typed))
         (evens (proof-proof-fact proof even-rule (list (list x source))))
         (typed-evens (t2-arithmetic-arithmetic-modus-ponens lib evens typed))
         (odds (proof-proof-fact proof even-rule (list (list x tail))))
         (typed-odds (t2-arithmetic-arithmetic-modus-ponens lib odds typed-tail))
         (open-odds (proof-proof-unfold proof (list *t2-lists-odds* source)))
         (typed-odds (library-library-transport-argument lib typed-odds open-odds 1))
         (sorted-evens (t2-structural-lists-sort-preserves-child lib typed-evens formula source measure tests))
         (sorted-odds (t2-structural-lists-sort-preserves-child (cdr sorted-evens) typed-odds formula source measure tests))
         (lib (cdr sorted-odds))
         (proof (library-library-proof lib))
         (even-literal (proof-step-first (caar sorted-evens)))
         (odd-literal (proof-step-first (caar sorted-odds)))
         (merge (proof-proof-fact proof merge-rule (list (list x (cadr even-literal))
                                                        (list y (cadr odd-literal))
                                                        (list *t2-structural-lists-acc* *proof-false*))))
         (expand (list (list :term term) (list :arg predicate 1 *proof-false*)))
         (empty (t2-structural-proof-solve lib (list predicate *proof-false*) expand nil nil nil 10))
         (lib (cdr empty))
         (premise (t2-power-join lib (list (caar sorted-evens) (caar sorted-odds) (car empty))))
         (recursed (t2-arithmetic-arithmetic-modus-ponens lib merge premise))
         (yes (t2-structural-proof-solve lib result expand tests (list recursed) nil 10))
         (no (t2-structural-proof-solve (cdr yes) result expand (list (list branch nil)) (list typed) nil 10))
         (lib (cdr no))
         (proof (library-library-proof lib))
         (case-proof (proof-proof-cases proof branch (car yes) (car no)))
         (step (t2-power-implication lib domain case-proof))
         (inducted (proof-proof-induct proof ordinal step formula measure
                                       (list (cadar sorted-evens) (cadar sorted-odds)))))
      (cons inducted lib))))

(defun t2-structural-lists-prove (lib formula)
  (if (proof-is-call formula *library-implies*)
      (proof-with-checked-results ((result (proof-term-at formula 2)))
        (if (proof-is-call result *t2-structural-lists-symbol-alistp*)
            (proof-with-checked-results ((term (proof-term-at result 1)))
              (let ((operation (t2-book-logic-head term)))
                (cond ((equal operation *t2-structural-lists-merge*)
                       (t2-structural-lists-merge-preserves lib formula))
                      ((equal operation *t2-lists-evens*)
                       (t2-structural-lists-evens-preserves lib formula))
                      ((equal operation *t2-structural-lists-sort*)
                       (t2-structural-lists-sort-preserves lib formula))
                      (t (cons nil lib)))))
          (cons nil lib)))
    (cons nil lib)))
