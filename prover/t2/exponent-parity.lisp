      (low (proof-proof-assume p (library-lt y *proof-neg-one*) nil))
      (bound (t2-ratios-at-least-one lib positive-y iy))
      (plus-one (t2-exponent-parity-integer-equality lib y *proof-one* integers bound high))
      (rational-zero (t2-arithmetic-rational lib *proof-zero* nil))
      (rational-y (t2-arithmetic-rational lib y integers))
      (negative (t2-order-trichotomy lib *proof-zero* y (list rational-zero rational-y)))
      (nonzero (proof-proof-assume p zero nil))
      (nonzero (t2-products-flip-neq lib nonzero))
      (negative (proof-proof-discharge p negative nonzero))
      (successor (t2-products-discrete-step lib negative integers))
      (successor-first (proof-step-first successor))
      (successor-test (proof-term-at successor-first 1))
      (shifted (t2-power-shift-integer-order lib (library-lt *proof-neg-one* y)
                                            successor-test integers))
      (no-larger (library-library-transport-argument lib successor shifted 1))
      (minus-one (t2-exponent-parity-integer-equality lib y *proof-neg-one* integers low no-larger))
      (point-zero (proof-proof-assume p zero t))
      (at-zero (t2-exponent-parity-near-zero-at 0 point-zero lib values))
      (positive-first (proof-step-first positive-y))
      (at-plus-one (t2-exponent-parity-near-zero-at 1 plus-one lib values))
      (at-minus-one (t2-exponent-parity-near-zero-at -1 minus-one lib values))
