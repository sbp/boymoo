(in-package "BOYMOO-PROVER")
(set-verify-guards-eagerness 0)

(defconst *t2-exponent-parity-half* (proof-quote '("ratio" 1 2)))
(defconst *t2-exponent-parity-evenp* (proof-cl "EVENP"))
(defconst *t2-exponent-parity-oddp* (proof-cl "ODDP"))

(defun t2-exponent-parity-half-integral (exponent)
  (library-integer (t2-products-times *t2-exponent-parity-half* exponent)))

(defun t2-exponent-parity-integer-translation (lib)
  (let* ((p (library-library-proof lib))
         (x *library-x*)
         (y *library-y*)
         (translated (library-plus x y))
         (left (library-integer translated))
         (right (library-integer x)))
    (proof-with-checked-results
     ((numeric (proof-proof-assume p (list *library-numberp* x) t))
      (iy (proof-proof-assume p (library-integer y) t))
      (precise (library-library-axiom lib "ASSOCIATIVITY-OF-+"
                                      (list x y (library-minus y))))
      (inverse (library-library-axiom lib "INVERSE-OF-+" (list y)))
      (precise (proof-proof-rewrite p precise inverse '(1 2 2)))
      (identity (t2-field-identity lib x numeric *proof-plus*))
      (precise (proof-proof-chain p precise (list identity)))
      (precise-first (proof-step-first precise))
      (restored (proof-term-at precise-first 1))
      (assumed-left (proof-proof-assume p left t))
      (backward (t2-arithmetic-arithmetic-type-of lib restored (list assumed-left iy)))
      (backward (proof-proof-rewrite p backward precise '(1 1)))
      (assumed-right (proof-proof-assume p right t))
      (forward (t2-arithmetic-arithmetic-type-of lib translated (list assumed-right iy)))
      (left-boolean (proof-proof-fact p "booleanp-integerp" (list (list x translated))))
      (right-boolean (proof-proof-fact p "booleanp-integerp" (list (list x x))))
      (proved (t2-field-equal-predicates lib left right backward forward
                                         left-boolean right-boolean))
      (claim (proof-step-first (car proved)))
      (numeric-first (proof-step-first numeric))
      (iy-first (proof-step-first iy)))
     (library-library-lemma (cdr proved) "INTEGER-TRANSLATION-TEST" claim (car proved)
                            (list (proof-neg numeric-first) (proof-neg iy-first))))))

(defun t2-exponent-parity-parity-predicates (lib)
  (let ((p (library-library-proof lib))
        (y *library-y*))
    (proof-with-checked-results
     ((even (proof-proof-unfold p (list *t2-exponent-parity-evenp* y)))
      (half (t2-book-logic-constant lib (t2-field-reciprocal (proof-quote 2))))
      (even (proof-proof-rewrite p even half '(1 2 1 2)))
      (swapped (library-library-axiom lib "COMMUTATIVITY-OF-*"
                                      (list y *t2-exponent-parity-half*)))
      (even (proof-proof-rewrite p even swapped '(1 2 1)))
      (even-first (proof-step-first even))
      (lib (library-library-lemma lib "EVEN-HALF-INTEGRAL" even-first even nil))
      (p (library-library-proof lib))
      (odd (proof-proof-unfold p (list *t2-exponent-parity-oddp* y)))
      (odd (proof-proof-rewrite p odd even '(1 2 1)))
      (odd-first (proof-step-first odd)))
     (library-library-lemma lib "ODD-HALF-NONINTEGRAL" odd-first odd nil))))

(defun t2-exponent-parity-parity-step (lib shift)
  (let* ((p (library-library-proof lib))
         (half *t2-exponent-parity-half*)
         (y *library-y*)
         (unit (proof-quote (floor shift 2)))
         (quoted-shift (proof-quote shift))
         (product (t2-products-times half y)))
    (proof-with-checked-results
     ((opened (library-library-axiom lib "DISTRIBUTIVITY" (list half y quoted-shift)))
      (scaled-shift (t2-book-logic-constant lib (t2-products-times half quoted-shift)))
      (opened (proof-proof-rewrite p opened scaled-shift '(1 2 2)))
      (numeric (t2-field-number lib product))
      (integral (t2-arithmetic-arithmetic-type-of lib unit nil))
      (test (library-library-cite lib "INTEGER-TRANSLATION-TEST" (list product unit)
                                 (list numeric integral)))
      (reversed (proof-proof-symmetric p opened)))
     (proof-proof-rewrite p test reversed '(1 1 1)))))

(defun t2-exponent-parity-negative-countdown-lemma (lib)
  (let* ((name "POWER-NEGATIVE-COUNTDOWN")
         (p (library-library-proof lib))
         (x *library-x*))
    (if (assoc-equal (proof-sym "SELF-POWER-NEGATIVE-COUNTDOWN" "ACL2")
                     (proof-proof-facts p))
        lib
      (proof-with-checked-results
       ((ix (proof-proof-assume p (library-integer x) t))
        (negative (proof-proof-assume p (library-lt x *proof-zero*) t))
        (goal (list *proof-ordinal-less* (list *library-count* (library-plus x *proof-one*))
                    (list *library-count* x)))
        (facts (t2-tactics-ruler-facts-init lib nil (list ix negative)))
        (result (t2-tactics-countdown-negative-countdown lib goal facts))
        (ix-first (proof-step-first ix))
        (negative-first (proof-step-first negative)))
       (library-library-lemma (cadr result) name goal (car result)
                              (list (proof-neg ix-first) (proof-neg negative-first)))))))

(defun t2-exponent-parity-countdown-step (lib integral sign forward)
  (proof-with-checked-results
   ((literal (proof-step-first integral))
    (exponent (proof-term-at literal 1))
    (smaller (library-plus exponent (if forward *proof-neg-one* *proof-one*))))
   (if forward
       (let ((p (library-library-proof lib)))
         (proof-with-checked-results
          ((step (library-library-builtin lib 10 exponent))
           (step (proof-proof-discharge p step integral))
           (step (proof-proof-discharge p step sign)))
          (cons (list smaller step) lib)))
     (proof-with-checked-results
      ((lib (t2-exponent-parity-negative-countdown-lemma lib))
       (step (library-library-cite lib "POWER-NEGATIVE-COUNTDOWN" (list exponent)
                                  (list integral sign))))
      (cons (list smaller step) lib)))))

(defun t2-exponent-parity-integer-bound (lib step)
  (proof-with-checked-results
   ((literal (proof-step-first step))
    (endpoints (proof-list-of-length (cdr literal) 2))
    (comparison (t2-arithmetic-arithmetic-ordinal-comparison
                 lib (car endpoints) (cadr endpoints) nil)))
   (library-inherited proof-proof-rewrite lib step comparison '(1))))

(defun t2-exponent-parity-two-step (lib integral forward)
  (proof-with-checked-results
   ((literal (proof-step-first integral))
    (exponent (proof-term-at literal 1)))
   (if (not (equal exponent *library-y*))
       '(:failure "failure" "")
     (let* ((p (library-library-proof lib))
            (y *library-y*)
            (test (if forward (library-lt *proof-one* y) (library-lt y *proof-neg-one*)))
            (integers (list integral)))
       (proof-with-checked-results
        ((outer (proof-proof-assume p test t))
         (constant-sign (t2-arithmetic-arithmetic-prove
                         lib (if forward (library-positive *proof-one*)
                               (library-lt *proof-neg-one* *proof-zero*)) nil nil))
         (sign (if forward (t2-order-strict-chain lib constant-sign outer)
                 (t2-order-strict-chain lib outer constant-sign)))
         (first (t2-exponent-parity-countdown-step (cdr sign) integral (car sign) forward))
         (lib (cdr first))
         (p (library-library-proof lib))
         (nearest (caar first))
         (next-test (if forward (library-positive nearest) (library-lt nearest *proof-zero*)))
         (outer-first (proof-step-first outer))
         (shifted-order (t2-power-shift-integer-order lib next-test outer-first integers))
         (next-sign (proof-proof-transport p outer shifted-order))
         (next-int (t2-arithmetic-arithmetic-type-of lib nearest integers))
         (second (t2-exponent-parity-countdown-step lib next-int next-sign forward))
         (lib (cdr second))
         (p (library-library-proof lib))
         (inner-bound (t2-exponent-parity-integer-bound lib (cadar second)))
         (outer-bound (t2-exponent-parity-integer-bound lib (cadar first)))
         (combined (t2-arithmetic-arithmetic-compare-chain lib inner-bound outer-bound nil))
         (combined-first (proof-step-first combined))
         (endpoints (proof-list-of-length (cdr combined-first) 2))
         (comparison (t2-arithmetic-arithmetic-ordinal-comparison
                      lib (car endpoints) (cadr endpoints) nil))
         (descent (proof-proof-transport p combined comparison))
         (shifted (library-plus y (proof-quote (if forward -2 2))))
         (descent-first (proof-step-first descent))
         (measure (proof-term-at descent-first 1))
         (argument (proof-term-at measure 1))
         (normal (t2-arithmetic-linear-equal lib argument shifted integers))
         (step (proof-proof-rewrite p descent normal '(1 1 1))))
        (cons (list shifted step) lib))))))

(defun t2-exponent-parity-constant-powers (indices lib values numeric nonzero)
  (if (endp indices)
      values
    (let* ((p (library-library-proof lib))
           (index (car indices))
           (direction (if (< 0 index) 1 -1))
           (predecessor (- index direction))
           (point (proof-quote index))
           (previous (proof-quote predecessor))
           (base *proof-neg-one*))
      (proof-with-checked-results
       ((proved
         (if (< 0 direction)
             (proof-with-checked-results
              ((integral (t2-arithmetic-arithmetic-type-of lib previous nil))
               (step (library-library-cite lib "POWER-SUCCESSOR" (list base previous)
                                          (list numeric nonzero integral)))
               (next (proof-proof-compute p (library-plus previous *proof-one*) index)))
              (proof-proof-rewrite p step next '(1 1 2)))
           (proof-with-checked-results
            ((integral (t2-arithmetic-arithmetic-type-of lib point nil))
             (step (library-library-cite lib "POWER-PREDECESSOR" (list base point)
                                        (list numeric nonzero integral)))
             (inverted (proof-proof-compute p (t2-field-reciprocal base) -1))
             (step (proof-proof-rewrite p step inverted '(1 2 1)))
             (next (proof-proof-compute p (library-plus point *proof-one*) (1+ index))))
            (proof-proof-rewrite p step next '(1 2 2 2)))))
        (proved (proof-proof-rewrite p proved (cdr (assoc-equal predecessor values)) '(1 2 2)))
        (literal (proof-step-first proved))
        (right (proof-term-at literal 2))
        (constant (t2-book-logic-constant lib right))
        (proved (proof-proof-chain p proved (list constant))))
       (t2-exponent-parity-constant-powers
        (cdr indices) lib (table-put values index proved) numeric nonzero)))))

(defun t2-exponent-parity-minus-one-constants (lib)
  (let ((p (library-library-proof lib))
        (base *proof-neg-one*))
    (proof-with-checked-results
     ((numeric (t2-arithmetic-number lib base nil))
      (not-nil-step (proof-proof-not-nil p))
      (comparison (proof-proof-compute p (proof-eq base *proof-zero*) *proof-nil*))
      (nonzero (library-library-transport-argument lib not-nil-step comparison 1))
      (zero (library-library-cite lib "POWER-ZERO-EXPONENT" (list base) nil))
      (values (t2-exponent-parity-constant-powers
               '(1 2 -1 -2) lib (list (cons 0 zero)) numeric nonzero)))
     (list values numeric nonzero))))

(defun t2-exponent-parity-integer-equality (lib a b integer-facts weak-ab weak-ba)
  (let ((p (library-library-proof lib)))
    (proof-with-checked-results
     ((a-type (t2-arithmetic-rational lib a integer-facts))
      (b-type (t2-arithmetic-rational lib b integer-facts))
      (proof (t2-order-trichotomy lib a b (list a-type b-type)))
      (proof (proof-proof-front p proof (proof-eq a b)))
      (proof (proof-proof-discharge p proof weak-ab)))
     (proof-proof-discharge p proof weak-ba))))

(defun t2-exponent-parity-near-zero-at (index equality lib values)
  (let* ((p (library-library-proof lib))
         (point (proof-quote index))
         (tested (t2-exponent-parity-half-integral point))
         (template (proof-eq (t2-power-power *proof-neg-one* *library-y*)
                             (proof-ite (t2-exponent-parity-half-integral *library-y*)
                                        *proof-one* *proof-neg-one*))))
    (proof-with-checked-results
     ((product (t2-book-logic-constant lib (cadr tested)))
      (reflexive (proof-proof-reflexive p tested))
      (fact (proof-proof-rewrite p reflexive product '(1 2 1)))
      (fact-first (proof-step-first fact))
      (right (proof-term-at fact-first 2))
      (constant (t2-book-logic-constant lib right))
      (fact (proof-proof-chain p fact (list constant)))
      (fact-first (proof-step-first fact))
      (right (proof-term-at fact-first 2))
      (truth (if (equal right *proof-true*)
                 (proof-proof-true-from-eq p fact)
               (proof-with-checked-results ((no (proof-proof-not-nil p)))
                 (library-library-transport-argument lib no fact 1))))
      (selected (proof-proof-select p (proof-ite tested *proof-one* *proof-neg-one*) truth))
      (known (if (assoc-equal index values)
                 (cdr (assoc-equal index values))
               '(:failure "failure" "")))
      (reversed (proof-proof-symmetric p selected))
      (result (proof-proof-chain p known (list reversed)))
      (equality-reversed (proof-proof-symmetric p equality)))
     (proof-proof-rewrite-result p result equality-reversed template *library-y*))))

