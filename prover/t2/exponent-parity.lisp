(defun t2-exponent-parity-minus-one-case (lib direction iy formula values numeric nonzero)
  (let* ((base *proof-neg-one*)
         (y *library-y*)
         (integers (list iy)))
    (proof-with-checked-results
     ((smaller (t2-exponent-parity-two-step lib iy (< 0 direction)))
      (lib (cdr smaller))
      (p (library-library-proof lib))
      (previous (caar smaller))
      (descent (cadar smaller))
      (pairs (list (list y previous)))
      (next-int (t2-arithmetic-arithmetic-type-of lib previous integers))
      (ih (t2-power-smaller-instance lib formula descent pairs (list next-int)))
      (move (proof-quote (* 2 direction)))
      (move-int (t2-arithmetic-arithmetic-type-of lib move nil))
      (source (library-library-cite lib "POWER-ADD-NONZERO" (list base move previous)
                                     (list numeric nonzero move-int next-int)))
      (normal (t2-arithmetic-linear-equal lib (library-plus move previous) y integers))
      (source (proof-proof-rewrite p source normal '(1 1 2)))
      (at-move (cdr (assoc-equal (* 2 direction) values)))
      (source (proof-proof-rewrite p source at-move '(1 2 1)))
      (power (t2-power-power base previous))
      (identity (library-library-axiom lib "UNICITY-OF-1" (list power)))
      (power-number (library-library-cite lib "POWER-NUMBER" (list base previous) nil))
      (fix (t2-field-numeric-fix lib power power-number))
      (source (proof-proof-chain p source (list identity fix ih)))
      (parity (t2-exponent-parity-parity-step lib (* -2 direction)))
      (source (proof-proof-rewrite p source parity '(1 2 1))))
     (cons (list source pairs) lib))))

(defun t2-exponent-parity-power-minus-one (lib)
  (let* ((p (library-library-proof lib))
         (y *library-y*)
         (expected (proof-ite (t2-exponent-parity-half-integral y) *proof-one* *proof-neg-one*))
         (claim (proof-eq (t2-power-power *proof-neg-one* y) expected)))
    (proof-with-checked-results
     ((iy (proof-proof-assume p (library-integer y) t))
      (integer-y (proof-step-first iy))
      (formula (list *library-implies* integer-y claim))
      (constants (t2-exponent-parity-minus-one-constants lib))
      (values (car constants))
      (numeric (cadr constants))
      (nonzero (caddr constants))
      (positive (t2-exponent-parity-minus-one-case lib 1 iy formula values numeric nonzero))
      (negative (t2-exponent-parity-minus-one-case (cdr positive) -1 iy formula values numeric nonzero))
      (lib (cdr negative))
      (p (library-library-proof lib))
      (close (t2-exponent-parity-near-zero lib iy values))
      (negative-case (proof-proof-cases p (library-lt y *proof-neg-one*) (caar negative) close))
      (body (proof-proof-cases p (library-lt *proof-one* y) (caar positive) negative-case))
      (ordinal (library-library-builtin lib 1 y))
      (induction-case (t2-power-implication lib integer-y body))
      (proof (proof-proof-induct p ordinal induction-case formula (list *library-count* y)
                                 (list (cadar positive) (cadar negative))))
      (proof (t2-arithmetic-arithmetic-modus-ponens lib proof iy)))
     (library-library-lemma lib "POWER-OF-MINUS-ONE" claim proof (list (proof-neg integer-y))))))

(defun t2-exponent-parity-negative-base-case (lib is-even iy value minus-product split unit pure-numeric)
  (let* ((p (library-library-proof lib))
         (x *library-x*)
         (y *library-y*)
         (half-integral (t2-exponent-parity-half-integral y))
         (label (if is-even "EVEN" "ODD"))
         (side (if is-even (proof-neg half-integral) half-integral))
         (neg-value (library-minus x)))
    (proof-with-checked-results
     ((test (proof-proof-assume p half-integral is-even))
      (unit-first (proof-step-first unit))
      (unit-right (proof-term-at unit-first 2))
      (selection (proof-proof-select p unit-right test))
      (opened (proof-proof-rewrite p split selection '(1 2 1)))
      (proof
       (if is-even
           (proof-with-checked-results
            ((identity (library-library-axiom lib "UNICITY-OF-1" (list value)))
             (fix (t2-field-numeric-fix lib value pure-numeric)))
            (proof-proof-chain p opened (list identity fix)))
         (proof-with-checked-results
          ((instantiated (proof-proof-instantiate p minus-product (list (list x value)))))
          (proof-proof-chain p opened (list instantiated)))))
      (claim (proof-step-first proof))
      (iy-first (proof-step-first iy))
      (lib (library-library-lemma lib (concatenate 'string "POWER-NEGATIVE-BASE-" label)
                                  claim proof (list (proof-neg iy-first) side)))
      (p (library-library-proof lib))
      (ratio (proof-proof-assume p (list *library-rationalp* x) t))
      (negative (proof-proof-assume p (library-lt x *proof-zero*) t))
      (opposite (t2-order-rational lib neg-value (list ratio)))
      (positive-order (library-library-cite lib "FIELD-LESS-ZERO-NEGATION" (list x) nil))
      (positive-base (proof-proof-transport p negative positive-order))
      (positive-power (library-library-cite lib "POWER-POSITIVE" (list neg-value y)
                                            (list opposite positive-base iy)))
      (alternate (proof-proof-instantiate p proof (list (list x neg-value))))
      (double (library-library-cite lib "FIELD-DOUBLE-NEGATION" (list x) nil))
      (numeric (t2-order-number-from-rational lib ratio))
      (fix (t2-field-numeric-fix lib x numeric))
      (double (proof-proof-chain p double (list fix)))
      (alternate (proof-proof-rewrite p alternate double '(1 1 1)))
      (sign
       (if is-even
           (library-library-transport-argument lib positive-power alternate 2)
         (proof-with-checked-results
          ((negative-order (library-library-cite lib "FIELD-LESS-NEGATION-ZERO"
                                                  (list (t2-power-power neg-value y)) nil))
           (sign (proof-proof-transport p positive-power negative-order)))
          (library-library-transport-argument lib sign alternate 1))))
      (sign-first (proof-step-first sign))
      (ratio-first (proof-step-first ratio))
      (negative-first (proof-step-first negative)))
     (library-library-lemma lib (concatenate 'string "POWER-NEGATIVE-BASE-SIGN-" label)
                            sign-first sign
                            (list (proof-neg ratio-first) (proof-neg negative-first)
                                  (proof-neg iy-first) side)))))

