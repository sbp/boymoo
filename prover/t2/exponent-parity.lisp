  (proof-with-checked-results
   ((lib (t2-exponent-parity-integer-translation lib))
    (lib (t2-exponent-parity-parity-predicates lib))
    (lib (t2-exponent-parity-power-minus-one lib))
    (lib (t2-exponent-parity-negative-base lib)))
   (t2-exponent-parity-integral-exponent-test lib)))
