     (t2-exponent-parity-negative-base-case lib nil iy value minus-product split unit pure-numeric))))

(defun t2-exponent-parity-integral-exponent-test (lib)
  (let* ((p (library-library-proof lib))
         (x *library-x*)
         (y *library-y*)
         (term (t2-power-power x y))
         (left (library-integer term))
         (test (library-lt y *proof-zero*))
         (right (proof-neg test)))
    (proof-with-checked-results
     ((integers (library-library-ints lib (list x y)))
      (ix (car integers))
      (iy (cadr integers))
      (above-unit (proof-proof-assume p (library-lt *proof-one* x) t))
      (ratio (t2-arithmetic-rational lib x (list ix)))
      (positive-one (t2-arithmetic-arithmetic-prove lib (library-positive *proof-one*) nil nil))
      (positive-base (t2-order-strict-chain lib positive-one above-unit))
      (lib (cdr positive-base))
      (p (library-library-proof lib))
      (positive-power (library-library-cite lib "POWER-POSITIVE" (list x y)
                                            (list ratio (car positive-base) iy)))
      (negative-y (proof-proof-assume p test t))
      (below-unit (library-library-cite lib "POWER-MONOTONE-AT-NEGATIVE" (list x y)
                                        (list ratio iy negative-y above-unit)))
      (integral-power (proof-proof-assume p left t))
      (unit-bound (t2-ratios-at-least-one lib positive-power integral-power))
      (impossible (proof-proof-cut p below-unit unit-bound))
      (impossible (proof-proof-front p impossible (proof-neg left)))
      (wrong (t2-field-false-value lib impossible))
      (right-opened (proof-proof-unfold p right))
      (right-opened-first (proof-step-first right-opened))
      (right-opened-rhs (proof-term-at right-opened-first 2))
      (right-false (proof-proof-if-true p right-opened-rhs))
      (right-false (proof-proof-chain p right-opened (list right-false)))
      (right-false (proof-proof-symmetric p right-false))
      (wrong (proof-proof-chain p wrong (list right-false)))
      (nonnegative-y (proof-proof-assume p test nil))
      (proper (library-library-cite lib "POWER-OF-INTEGER" (list x y) (list ix nonnegative-y)))
      (boolean (proof-proof-fact p "booleanp-integerp" (list (list x term))))
      (right-true (proof-proof-if-false p right-opened-rhs))
      (right-true (proof-proof-chain p right-opened (list right-true)))
      (left-true (t2-book-logic-true-boolean lib boolean proper))
      (lib (cdr left-true))
      (p (library-library-proof lib))
      (right-true (proof-proof-symmetric p right-true))
      (correct (proof-proof-chain p (car left-true) (list right-true)))
      (proof (proof-proof-cases p test wrong correct))
      (ix-first (proof-step-first ix))
      (iy-first (proof-step-first iy))
      (above-first (proof-step-first above-unit)))
     (library-library-lemma lib "POWER-OF-INTEGER-TEST" (proof-eq left right) proof
                            (list (proof-neg ix-first) (proof-neg iy-first) (proof-neg above-first))))))

