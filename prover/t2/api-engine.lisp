(defun t2-api-engine-lines (source)
  (if (stringp source)
      (t2-books-split-lines source t t)
    source))

(defun t2-api-engine-event (source)
  (t2-api-names-parsed source))

(defun t2-api-engine-core ()
  (t2-tactics-generator-init nil))

(defun t2-api-engine-library-measures ()
  *t2-api-engine-default-measures*)

(defun t2-api-engine-aid-lines (lines aids)
  (declare (xargs :measure (acl2-count lines)))
  (if (or (failure-p aids) (endp lines))
      aids
    (t2-api-engine-aid-lines
     (cdr lines)
     (proof-with-checked-results ((event (t2-api-engine-event (car lines))))
       (t2-books-parse-aid (car event) (cadr event) (car aids) (cadr aids))))))

(defun t2-api-engine-aids-for (aids)
  (t2-api-engine-aid-lines aids (list nil nil)))

(defun t2-api-engine-enrich-families (generator families complete)
  (declare (xargs :measure (acl2-count families)))
  (if (endp families)
      (cons complete generator)
    (let* ((lib (t2-books-independent-theory (t2-tactics-generator-lib generator)))
           (result (t2-books-build-lemma-family lib (car families)))
           (failed (failure-p result)))
      (t2-api-engine-enrich-families
       (if failed generator (t2-tactics-generator-with-lib generator result))
       (cdr families) (and (not failed) complete)))))

(defun t2-api-engine-enrich (generator)
  (t2-api-engine-enrich-families generator *t2-books-book-lemmas* t))

(defun t2-api-engine-admit-lines (generator lines)
  (declare (xargs :measure (acl2-count lines)))
  (if (or (failure-p generator) (endp lines))
      generator
    (t2-api-engine-admit-lines
     (proof-with-checked-results ((event (t2-api-engine-event (car lines))))
       (t2-tactics-generator-admit-given generator (car event) (cadr event)))
     (cdr lines))))

(defun t2-api-engine-base (library book)
  (proof-with-checked-results ((generator (t2-api-engine-core))
                               (generator (t2-api-engine-admit-lines generator library)))
    (if book
        (let ((result (t2-api-engine-enrich generator)))
          (list (cdr result) (car result)))
      (list generator nil))))

(defun t2-api-engine-context (library earlier book)
  (proof-with-checked-results
      ((base (t2-api-engine-base library book))
       (generator (t2-api-engine-admit-lines (car base) earlier)))
    (list generator (cadr base))))

(defun t2-api-engine-formal-minimum (definitions limit)
  (if (endp definitions)
      limit
    (proof-with-checked-results ((definition (proof-list-of-length (car definitions) 3)))
      (let* ((formals (cadr definition))
             (count (if (equal formals *proof-nil*) 0 (length formals))))
        (t2-api-engine-formal-minimum (cdr definitions) (min limit count))))))

(defun t2-api-engine-guessed-measures (definitions index measure measures)
  (if (endp definitions)
      measures
    (proof-with-checked-results
        ((formal (proof-term-at (cadar definitions) index)))
      (t2-api-engine-guessed-measures
       (cdr definitions) index measure
       (table-put measures (caar definitions) (list measure formal))))))

(defun t2-api-engine-guess-measure (generator rulers definitions index measure)
  (proof-with-checked-results
      ((measures (t2-api-engine-guessed-measures definitions index measure nil)))
    (let* ((lib (t2-books-independent-theory (t2-tactics-generator-lib generator)))
           (trial (t2-tactics-generator-with-lib generator lib))
           (result (t2-tactics-generator-prove-definition trial rulers definitions measures)))
      (cond ((t2-books-failure-kind-p result *t2-api-engine-failures*) nil)
            ((failure-p result) result)
            (t (list (t2-tactics-generator-lib (cdr result)) (car result)))))))

(defun t2-api-engine-guess-indices (indices generator rulers definitions result)
  (declare (xargs :measure (acl2-count indices)))
  (cond
   (result result)
   ((endp indices) '(:failure "Unproved" ""))
   (t
    (t2-api-engine-guess-indices
     (cdr indices) generator rulers definitions
     (or (t2-api-engine-guess-measure generator rulers definitions (car indices) *library-count*)
         (t2-api-engine-guess-measure generator rulers definitions (car indices) *library-len*))))))

(defun t2-api-engine-guessed-termination (generator data)
  (proof-with-checked-results ((rulers (proof-term-at data 0)))
    (if (endp (cdr data))
        '(:failure "RecipeMismatch" "")
      (proof-with-checked-results ((limit (t2-api-engine-formal-minimum (cdr data) 6)))
        (t2-api-engine-guess-indices (seq-range 0 limit 1) generator rulers (cdr data) nil)))))

(defun t2-api-engine-stored-measures (definitions stored measures)
  (if (endp definitions)
      measures
    (proof-with-checked-results ((definition (proof-list-of-length (car definitions) 3)))
      (let* ((name (car definition))
             (pair (assoc-equal name stored)))
        (if (not pair)
            (t2-api-engine-stored-measures (cdr definitions) stored measures)
          (proof-with-checked-results ((relation (proof-term-at (cdr pair) 1)))
            (let ((keep (and (equal relation *proof-ordinal-less*)
                             (subsetp-equal (t2-book-logic-variables (cadr pair))
                                            (cadr definition)))))
              (t2-api-engine-stored-measures
               (cdr definitions) stored
               (if keep (table-put measures name (cdr pair)) measures)))))))))

(defun t2-api-engine-generate (generator target hints stored)
  (if (not (equal (t2-books-obligation-kind target) "define"))
      (proof-with-checked-results
          ((result (t2-books-statement-prover-generate
                    (t2-books-statement-prover-init generator) target hints nil)))
        (car result))
    (let ((data (t2-books-obligation-data target)))
      (proof-with-checked-results
          ((measures (t2-api-engine-stored-measures (cdr data) stored nil)))
        (let* ((generator (t2-tactics-generator-with-measures generator measures))
               (result (t2-books-statement-prover-generate-with-state
                        (t2-books-statement-prover-init generator) target hints nil))
               (value (car result)))
          (if (t2-books-failure-kind-p value *t2-api-engine-failures*)
              (t2-api-engine-guessed-termination (t2-books-statement-prover-generator (cdr result)) data)
            value))))))

(defun t2-api-engine-common-lisp-definition-p (definitions)
  (if (endp definitions)
      nil
    (proof-with-checked-results
        ((definition (proof-list-of-length (car definitions) 3))
         (package (proof-term-at (car definition) 1)))
      (or (equal package "COMMON-LISP")
          (t2-api-engine-common-lisp-definition-p (cdr definitions))))))

(mutual-recursion
 (defun t2-api-engine-first-call-in-term (caller term tests env ruled rulers names)
   (declare (xargs :measure (acl2-count term)))
   (cond
    ((not (proof-compound term)) nil)
    ((endp term) '(:failure "failure" ""))
    ((equal (car term) *proof-quote*) nil)
    (t
     (let ((head (car term))
           (args (cdr term)))
       (cond
        ((proof-compound head)
         (if (not (equal (len head) 3))
             (proof-list-of-length head 3)
           (or (t2-api-engine-first-call-in-args
                caller args tests env
                (and ruled (termination-recursive-calls-extends *termination-lambdas* rulers))
                rulers names)
               (proof-with-checked-results
                   ((bindings (termination-lambda-bindings (cadr head) args env nil)))
                 (t2-api-engine-first-call-in-term
                  caller (caddr head) tests bindings ruled rulers names)))))
        ((and (equal head *termination-return-last*) (endp args))
         '(:failure "failure" ""))
        ((and (equal head *termination-return-last*) (equal (car args) *termination-mbe*))
         (if (consp (cddr args))
             (t2-api-engine-first-call-in-term caller (caddr args) tests env ruled rulers names)
           '(:failure "failure" "")))
        ((and (equal head *proof-if*) ruled)
         (if (not (equal (len args) 3))
             (proof-list-of-length args 3)
           (or (t2-api-engine-first-call-in-term
                caller (car args) tests env
                (termination-recursive-calls-extends *proof-if* rulers) rulers names)
               (proof-with-checked-results ((literal (proof-subst (car args) env)))
                 (or (t2-api-engine-first-call-in-term
                      caller (cadr args) (append tests (list (list literal t))) env t rulers names)
                     (t2-api-engine-first-call-in-term
                      caller (caddr args) (append tests (list (list literal nil))) env t rulers names))))))
        ((member-equal head names)
         (proof-with-checked-results ((actuals (termination-subst-actuals args env)))
           (termination-make-call caller head actuals tests)))
        (t
         (t2-api-engine-first-call-in-args
          caller args tests env
          (and ruled (termination-recursive-calls-extends head rulers)) rulers names)))))))
 (defun t2-api-engine-first-call-in-args (caller args tests env ruled rulers names)
   (declare (xargs :measure (acl2-count args)))
   (if (endp args)
       nil
     (or (t2-api-engine-first-call-in-term caller (car args) tests env ruled rulers names)
         (t2-api-engine-first-call-in-args caller (cdr args) tests env ruled rulers names)))))

(defun t2-api-engine-first-call-in-definitions (definitions rulers names result)
  (declare (xargs :measure (acl2-count definitions)))
  (cond
   (result result)
   ((endp definitions) nil)
   (t
    (t2-api-engine-first-call-in-definitions
     (cdr definitions) rulers names
     (proof-with-checked-results ((definition (proof-list-of-length (car definitions) 3)))
       (t2-api-engine-first-call-in-term
        (car definition) (caddr definition) nil nil t rulers names))))))

(defun t2-api-engine-first-recursive-call (rulers definitions)
  (proof-with-checked-results ((names (termination-definition-names definitions)))
    (t2-api-engine-first-call-in-definitions definitions rulers names nil)))

(defun t2-api-engine-signed-quotient-call-kind (value call)
  (let* ((actuals (termination-call-actuals call))
         (actual (car actuals))
         (tests (termination-call-tests call))
         (negative (library-lt value *proof-zero*))
         (divisor (caddr actual)))
    (and (consp actuals)
         (null (cdr actuals))
         (member-equal (list (list *t2-tactics-zip* value) nil) tests)
         (cond
          ((and (equal actual (list *t2-countdown-lognot* value))
                (member-equal (list negative t) tests))
           :complement)
          ((and (proof-is-call actual *t2-quotient-quotient*)
                (equal (len actual) 3)
                (equal (cadr actual) value)
                (proof-is-call divisor *proof-quote*)
                (equal (len divisor) 2)
                (integerp (cadr divisor))
                (< 1 (cadr divisor))
                (member-equal (list negative nil) tests))
           :quotient)
          (t nil)))))

(defun t2-api-engine-signed-quotient-calls-p (value calls kinds)
  (if (endp calls)
      (if (and (member-eq :complement kinds) (member-eq :quotient kinds)) t nil)
    (let ((kind (t2-api-engine-signed-quotient-call-kind value (car calls))))
      (and kind
           (t2-api-engine-signed-quotient-calls-p value (cdr calls)
                                                 (add-to-set-eq kind kinds))))))

(defun t2-api-engine-signed-quotient-p (rulers definitions)
  (let ((formals (cadar definitions)))
    (and (equal (len definitions) 1)
         (equal (len formals) 1)
         (proof-with-checked-results
             ((calls (termination-recursive-calls rulers definitions)))
           (t2-api-engine-signed-quotient-calls-p (car formals) calls nil)))))

(defun t2-api-engine-applicable-p (kind data)
  (cond
   ((equal kind "define")
    (let ((definitions (cdr data)))
      (proof-with-checked-results
          ((common-lisp-p (t2-api-engine-common-lisp-definition-p definitions))
           (rulers (proof-term-at data 0)))
        (if common-lisp-p
            (t2-api-engine-signed-quotient-p rulers definitions)
          (proof-with-checked-results
              ((call (t2-api-engine-first-recursive-call rulers definitions)))
            (if call t nil))))))
   ((equal kind "constrain")
    (proof-with-checked-results ((claim (proof-term-at data 1)))
      (not (equal claim *proof-nil*))))
   (t (equal kind "theorem"))))

(defun t2-api-engine-proof-text-parts (result)
  (if (failure-p result)
      result
    (let ((lib (car result))
          (entry (cadr result)))
      (proof-with-checked-results
          ((entries (t2-tactics-proof-entries (library-library-entries lib) entry)))
        (let ((reverse-entries (reverse entries)))
          (if (endp reverse-entries)
              '(:failure "failure" "")
            (list (reverse (cdr reverse-entries)) (cadddr (car reverse-entries))
                  (proof-proof-facts (library-library-proof lib)))))))))

(defun t2-api-engine-proof-text (result prefix)
  (proof-with-checked-results ((parts (t2-api-engine-proof-text-parts result)))
    (t2-api-names-namespace (car parts) (cadr parts) prefix (caddr parts))))

(defun t2-api-engine-retry (target hints stored earlier library prefix)
  (proof-with-checked-results ((context (t2-api-engine-context library earlier nil)))
    (let* ((generator (cdr (t2-api-engine-enrich (car context))))
           (result (t2-api-engine-generate generator target hints stored)))
      (if (t2-books-failure-kind-p result *t2-api-engine-failures*)
          nil
        (t2-api-engine-proof-text result prefix)))))

(defun t2-api-engine-prove-target (target earlier library aids prefix)
  (proof-with-checked-results ((aids (t2-api-engine-aids-for (t2-api-engine-lines aids))))
    (let* ((define-p (equal (t2-books-obligation-kind target) "define"))
           (stored (and define-p (table-update (t2-api-engine-library-measures) (car aids))))
           (hints (cadr aids))
           (library (t2-api-engine-lines library))
           (earlier (t2-api-engine-lines earlier))
           (book (or (not define-p) (not (endp hints)))))
      (proof-with-checked-results ((context (t2-api-engine-context library earlier book)))
        (let ((result (t2-api-engine-generate (car context) target hints stored)))
          (cond
           ((not (t2-books-failure-kind-p result *t2-api-engine-failures*))
            (t2-api-engine-proof-text result prefix))
           ((or (cadr context) (and book (endp earlier))) nil)
           (t (t2-api-engine-retry target hints stored earlier library prefix))))))))

(defun t2-api-engine-obligation (statement event)
  (proof-with-checked-results
      ((event event)
       (applicable (t2-api-engine-applicable-p (car event) (cadr event))))
    (if (not applicable)
        nil
      (proof-with-checked-results ((name (t2-books-first-name (car event) (cadr event))))
        (t2-books-make-obligation statement name (car event) (cadr event))))))

(defun t2-api-engine-prove (statement earlier library aids prefix)
  (proof-with-checked-results
      ((target (t2-api-engine-obligation statement (t2-api-engine-event statement))))
    (if target
        (t2-api-engine-prove-target target earlier library aids prefix)
      nil)))
