(defun t2-rounding-make-strict (lib weak left-rat right-rat noninteger integral)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((literal (proof-step-first weak))
         (comparison (proof-term-at literal 1))
         (operands (t2-rounding-comparison-operands comparison))
         (upper (car operands))
         (lower (cadr operands))
         (original (proof-eq upper lower))
         (changed (proof-proof-assume proof original t))
         (noninteger-literal (proof-step-first noninteger))
         (noninteger-test (proof-term-at noninteger-literal 1))
         (noninteger-value (proof-term-at noninteger-test 1))
         (changed (if (equal noninteger-value upper)
                      (proof-proof-symmetric proof changed)
                    changed))
         (now-integer (proof-proof-rewrite proof integral changed '(1 1)))
         (distinct (proof-proof-cut proof now-integer noninteger))
         (distinct (proof-proof-front proof distinct (proof-neg original)))
         (order (t2-order-trichotomy lib upper lower (list left-rat right-rat)))
         (order (proof-proof-discharge proof order distinct)))
      (proof-proof-discharge proof order weak))))

