(in-package "BOYMOO-PROVER")
(set-verify-guards-eagerness 0)

(defun t2-rounding-comparison-operands (literal)
  (if (integerp literal)
      '(:failure "failure" "")
    (proof-list-of-length (cdr literal) 2)))

(defun t2-rounding-shifted (lib step amount)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((literal (proof-step-first step))
         (operands (t2-rounding-comparison-operands literal))
         (translation
          (library-library-cite lib "FIELD-ORDER-TRANSLATION"
                                (list (car operands) (cadr operands) amount) nil)))
      (proof-proof-transport proof step translation))))

(defun t2-rounding-quotient-upper (lib)
  (let* ((proof (library-library-proof lib))
         (x *library-x*)
         (y *library-y*)
         (domain (t2-quotient-quotient-domain x y)))
    (proof-with-checked-results
        ((has-domain (proof-proof-assume proof domain t))
         (premises (t2-power-conjuncts lib has-domain 4))
         (ix (car premises))
         (iy (caddr premises))
         (positive-y (cadddr premises))
         (integers (list ix iy))
         (quotient (list *t2-quotient-quotient* x y))
         (claim (library-lt x (t2-products-times y (library-plus *proof-one* quotient))))
         (formula (list *library-implies* domain claim))
         (opened (t2-quotient-quotient-equation lib x y integers positive-y))
         (opened-literal (proof-step-first opened))
         (test (library-lt x y))
         (zero-branch (proof-proof-if-true proof (caddr opened-literal)))
         (at-zero (proof-proof-chain proof opened (list zero-branch)))
         (number-y (t2-arithmetic-number lib y integers))
         (unit (t2-field-identity lib y number-y *proof-times*))
         (base (proof-proof-reflexive proof (caddr claim)))
         (base (proof-proof-rewrite proof base at-zero '(1 2 2 2)))
         (sum (proof-proof-compute proof (library-plus *proof-one* *proof-zero*) 1))
         (base (proof-proof-rewrite proof base sum '(1 2 2)))
         (base (proof-proof-chain proof base (list unit)))
         (test-proof (proof-proof-assume proof test t))
         (base (library-library-transport-argument lib test-proof base 2))
         (enough (proof-proof-assume proof test nil))
         (smaller (library-diff x y))
         (descent (t2-subtraction-count-subtraction lib ix iy positive-y enough))
         (lib (cdr descent))
         (proof (library-library-proof lib))
         (pairs (list (list x smaller)))
         (smaller-int (t2-arithmetic-arithmetic-type-of lib smaller integers))
         (smaller-nonnegative (t2-subtraction-nonnegative-difference lib enough))
         (induction (t2-power-smaller-instance lib formula (car descent) pairs
                                              (list smaller-int smaller-nonnegative iy positive-y)))
         (advance (t2-rounding-shifted lib induction y))
         (sum (t2-arithmetic-linear-equal lib (library-plus smaller y) x integers))
         (advance (proof-proof-rewrite proof advance sum '(1 1)))
         (recursive-branch (proof-proof-if-false proof (caddr opened-literal)))
         (recursion (proof-proof-chain proof opened (list recursive-branch)))
         (recursion-literal (proof-step-first recursion))
         (child (caddr recursion-literal))
         (distributive (library-library-axiom lib "DISTRIBUTIVITY" (list y child *proof-one*)))
         (distributive (proof-proof-rewrite proof distributive unit '(1 2 2)))
         (encode (proof-proof-symmetric proof distributive))
         (commute (library-library-axiom lib "COMMUTATIVITY-OF-+" (list child *proof-one*)))
         (encode (proof-proof-rewrite proof encode commute '(1 2 2)))
         (reverse-recursion (proof-proof-symmetric proof recursion))
         (encode (proof-proof-rewrite proof encode reverse-recursion '(1 2 2 2)))
         (step (proof-proof-rewrite proof advance encode '(1 2)))
         (result (proof-proof-cases proof test base step))
         (ordinal (library-library-builtin lib 1 x))
         (case-proof (t2-power-implication lib domain result))
         (inducted (proof-proof-induct proof ordinal case-proof formula (list *library-count* x)
                                       (list pairs))))
      (library-library-lemma lib "QUOTIENT-STRICT-UPPER" formula inducted nil))))

