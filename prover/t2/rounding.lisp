(defun t2-rounding-negative-bracket (lib ratio negative-value not-integer)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((literal (proof-step-first ratio))
         (value (proof-term-at literal 1))
         (reversed-value (library-minus value))
         (opposite-type (t2-order-rational lib reversed-value (list ratio)))
         (zero-negation (library-library-cite lib "FIELD-LESS-ZERO-NEGATION" (list value) nil))
         (positive-value (proof-proof-transport proof negative-value zero-negation))
         (nonnegative (t2-order-opposite-order lib positive-value))
         (bracket (t2-rounding-nonnegative-bracket lib opposite-type nonnegative))
         (lib (cdr bracket))
         (proof (library-library-proof lib))
         (parts (car bracket))
         (num-sign (library-library-cite lib "NUMERATOR-NEGATION" (list value) nil))
         (den-sign (library-library-cite lib "DENOMINATOR-NEGATION" (list value) (list ratio)))
         (integral (t2-rounding-negative-bracket-change proof (car parts) num-sign den-sign))
         (lower (t2-rounding-negative-bracket-change proof (cadr parts) num-sign den-sign))
         (upper (t2-rounding-negative-bracket-change proof (caddr parts) num-sign den-sign))
         (integer-literal (proof-step-first integral))
         (q (cadr integer-literal))
         (int-neg (t2-arithmetic-arithmetic-type-of lib (library-minus q) (list integral)))
         (flip-lower (library-library-cite lib "FIELD-LESS-NEGATIONS" (list q (library-minus value)) nil))
         (flip-upper (library-library-cite lib "FIELD-LESS-NEGATIONS"
                                            (list (library-plus *proof-one* q) (library-minus value)) nil))
         (cancel (library-library-cite lib "FIELD-DOUBLE-NEGATION" (list value) nil))
         (value-number (t2-order-number-from-rational lib ratio))
         (fix (t2-field-numeric-fix lib value value-number))
         (cancel (proof-proof-chain proof cancel (list fix)))
         (flip-lower (proof-proof-rewrite proof flip-lower cancel '(1 1 2)))
         (flip-upper (proof-proof-rewrite proof flip-upper cancel '(1 1 2)))
         (below (proof-proof-transport proof upper flip-upper))
         (above (library-library-transport-argument lib lower flip-lower 1))
         (rat-neg (t2-arithmetic-rational lib (library-minus q) (list int-neg)))
         (above (t2-rounding-make-strict lib above rat-neg ratio not-integer int-neg))
         (raw (library-plus (library-minus q) *proof-neg-one*))
         (int-one (t2-arithmetic-arithmetic-type-of lib *proof-one* nil))
         (negative-add (library-library-cite lib "NEGATE-SUM" (list *proof-one* q) (list int-one integral)))
         (negative-one (proof-proof-compute proof (library-minus *proof-one*) -1))
         (negative-add (proof-proof-rewrite proof negative-add negative-one '(1 2 1)))
         (commute (library-library-axiom lib "COMMUTATIVITY-OF-+" (list *proof-neg-one* (library-minus q))))
         (negative-add (proof-proof-chain proof negative-add (list commute)))
         (below (proof-proof-rewrite proof below negative-add '(1 1)))
         (sum (t2-arithmetic-linear-equal lib (library-plus *proof-one* raw) (library-minus q) (list integral)))
         (reverse-sum (proof-proof-symmetric proof sum))
         (above (proof-proof-rewrite proof above reverse-sum '(1 2)))
         (int-raw (t2-arithmetic-arithmetic-type-of lib raw (list integral))))
      (cons (list int-raw below above) lib))))

(defun t2-rounding-noninteger-floor-normalize (proof facts displayed)
  (if (endp facts)
      nil
    (proof-with-checked-results
        ((reverse-display (proof-proof-symmetric proof displayed))
         (literal (proof-step-first (car facts)))
         (display-literal (proof-step-first displayed))
         (fact (proof-proof-rewrite-result proof (car facts) reverse-display literal (caddr display-literal)))
         (rest (t2-rounding-noninteger-floor-normalize proof (cdr facts) displayed)))
      (cons fact rest))))

(defun t2-rounding-noninteger-floor-branch (lib ratio not-integer opened sign negative negative-x)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((evidence (proof-proof-assume proof negative negative-x))
         (branch
          (if negative-x
              (proof-with-checked-results
                  ((bracket (t2-rounding-negative-bracket lib ratio evidence not-integer))
                   (lib (cdr bracket))
                   (proof (library-library-proof lib))
                   (n-neg (proof-proof-transport proof evidence sign))
                   (displayed (proof-step-first opened))
                   (right (proof-term-at displayed 2))
                   (condition (proof-term-at right 1))
                   (unfolded (proof-proof-unfold proof condition))
                   (selected (t2-input-fields-select lib unfolded n-neg))
                   (test (t2-input-fields-negated-value lib selected)))
                (cons (list (car bracket) test) lib))
            (proof-with-checked-results
                ((bracket (t2-rounding-nonnegative-bracket lib ratio evidence))
                 (lib (cdr bracket))
                 (facts (car bracket))
                 (integral (car facts))
                 (literal (proof-step-first integral))
                 (rat-int (t2-arithmetic-rational lib (cadr literal) (list integral)))
                 (strict (t2-rounding-make-strict lib (cadr facts) ratio rat-int not-integer integral))
                 (test (library-library-transport-argument lib evidence sign 1)))
              (cons (list (list integral strict (caddr facts)) test) lib))))
         (lib (cdr branch))
         (displayed (t2-input-fields-select lib opened (cadar branch)))
         (normalized (t2-rounding-noninteger-floor-normalize (library-library-proof lib) (caar branch) displayed))
         (joined (t2-power-join lib normalized)))
      (cons joined lib))))

(defun t2-rounding-noninteger-floor (lib)
  (let ((proof (library-library-proof lib))
        (x *library-x*))
    (proof-with-checked-results
        ((ratio (proof-proof-assume proof (list *library-rationalp* x) t))
         (not-integer (proof-proof-assume proof (library-integer x) nil))
         (opened (t2-rounding-normalized-floor lib ratio not-integer))
         (parts (t2-arithmetic-rational-parts lib ratio))
         (sign (t2-rounding-numerator-sign lib ratio (caddr parts) (cadr parts)))
         (lib (cdr sign))
         (negative (library-lt x *proof-zero*))
         (yes (t2-rounding-noninteger-floor-branch lib ratio not-integer opened (car sign) negative t))
         (no (t2-rounding-noninteger-floor-branch (cdr yes) ratio not-integer opened (car sign) negative nil))
         (lib (cdr no))
         (interval (proof-proof-cases (library-library-proof lib) negative (car yes) (car no)))
         (claim (proof-step-first interval))
         (rational (proof-step-first ratio)))
      (library-library-lemma lib "NONINTEGER-FLOOR-INTERVAL" claim interval
                             (list (proof-neg rational) (library-integer x))))))

(defun t2-rounding-weak-then-strict (lib weak strict types)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((literal (proof-step-first weak))
         (ordering (proof-term-at literal 1))
         (parts (proof-list-of-length ordering 3))
         (same (proof-eq (cadr parts) (caddr parts)))
         (equal-hyp (proof-proof-assume proof same t))
         (on-equal (proof-proof-rewrite proof strict equal-hyp '(1 1)))
         (ordered (t2-order-trichotomy lib (cadr parts) (caddr parts) types))
         (different (proof-proof-assume proof same nil))
         (ordered (proof-proof-discharge proof ordered different))
         (ordered (proof-proof-discharge proof ordered weak))
         (chained (t2-order-strict-chain lib ordered strict))
         (lib (cdr chained))
         (result (proof-proof-cases (library-library-proof lib) same on-equal (car chained))))
      (cons result lib))))

(defun t2-rounding-integer-comparisons-over (lib test floor-low floor-high next-type int-type integer-terms floor-type)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((hyp (proof-proof-assume proof test t))
         (upper (t2-products-discrete-step lib hyp integer-terms))
         (too-high (t2-power-products-strict-then-weak lib floor-high upper (list next-type int-type)))
         (lib (cdr too-high))
         (proof (library-library-proof lib))
         (not-test (proof-proof-assume proof test nil))
         (holds (t2-rounding-weak-then-strict lib not-test floor-low (list floor-type int-type))))
      (cons (list (car too-high) (car holds)) (cdr holds)))))

