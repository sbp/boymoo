(in-package "BOYMOO-PROVER")
(set-verify-guards-eagerness 0)

(defun t2-field-cancellation-lemma (lib name step)
  (proof-with-checked-results
    ((claim (proof-step-first step)))
    (library-library-lemma lib name claim step nil)))

(defun t2-field-cancellation-symmetric-test (lib a b)
  (let ((proof (library-library-proof lib))
        (left (proof-eq a b))
        (right (proof-eq b a)))
    (proof-with-checked-results
      ((left-assumption (proof-proof-assume proof left t))
       (goes-right (proof-proof-symmetric proof left-assumption))
       (right-assumption (proof-proof-assume proof right t))
       (goes-left (proof-proof-symmetric proof right-assumption))
       (equivalence (t2-field-equal-predicates lib left right goes-right goes-left nil nil)))
      (car equivalence))))

(defun t2-field-cancellation-guarded-identity (lib test)
  (let ((proof (library-library-proof lib))
        (term (proof-ite test test *proof-false*)))
    (proof-with-checked-results
      ((false-branch (proof-proof-if-false proof term))
       (assumption (proof-proof-assume proof test nil))
       (false-test (t2-field-false-value lib assumption))
       (back (proof-proof-symmetric proof false-test))
       (no (proof-proof-chain proof false-branch (list back)))
       (yes (proof-proof-if-true proof term)))
      (proof-proof-cases proof test yes no))))

(defun t2-field-cancellation-subtract-summand (lib value summand)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
      ((associated (library-library-axiom
                    lib "ASSOCIATIVITY-OF-+" (list value summand (library-minus summand))))
       (inverse (library-library-axiom lib "INVERSE-OF-+" (list summand)))
       (step (proof-proof-rewrite proof associated inverse '(1 2 2)))
       (commuted (library-library-axiom lib "COMMUTATIVITY-OF-+" (list value *proof-zero*)))
       (unit (library-library-axiom lib "UNICITY-OF-0" (list value))))
      (proof-proof-chain proof step (list commuted unit)))))

(defun t2-field-cancellation-commute-operands (lib step name operands position)
  (declare (xargs :measure (acl2-count operands)))
  (if (endp operands)
      step
    (proof-with-checked-results
      ((commuted (library-library-axiom lib name (list (car operands) *library-z*)))
       (step (proof-proof-rewrite
              (library-library-proof lib) step commuted (list 1 1 position))))
      (t2-field-cancellation-commute-operands lib step name (cdr operands) (+ 1 position)))))

(defun t2-field-cancellation-cancel-opposite (lib ordered)
  (let ((proof (library-library-proof lib))
        (x *library-x*)
        (y *library-y*))
    (proof-with-checked-results
      ((combined (t2-book-logic-ac-equal lib ordered (library-diff (library-plus y x) x)))
       (subtract (t2-field-cancellation-subtract-summand lib y x))
       (step (proof-proof-chain proof combined (list subtract)))
       (inner (proof-term-at ordered 2))
       (last (proof-term-at inner 2)))
      (t2-field-cancellation-lemma
       lib
       (if (equal last (library-minus x)) "FIELD-CANCEL-OPPOSITE-LAST"
         "FIELD-CANCEL-OPPOSITE-FIRST")
       step))))

(defun t2-field-cancellation-cancel-sums (lib)
  (let* ((proof (library-library-proof lib))
         (x *library-x*)
         (y *library-y*)
         (z *library-z*)
         (xz (library-plus x z))
         (yz (library-plus y z))
         (left (proof-eq xz yz))
         (right (proof-eq (t2-field-fixed x) (t2-field-fixed y))))
    (proof-with-checked-results
      ((expanded (t2-arithmetic-arithmetic-reflexive lib (library-diff xz z)))
       (equal-sums (proof-proof-assume proof left t))
       (expanded (proof-proof-rewrite proof expanded equal-sums '(1 2 1)))
       (subtract-x (t2-field-cancellation-subtract-summand lib x z))
       (expanded (proof-proof-rewrite proof expanded subtract-x '(1 1)))
       (subtract-y (t2-field-cancellation-subtract-summand lib y z))
       (to-right (proof-proof-rewrite proof expanded subtract-y '(1 2)))
       (restored (library-library-axiom lib "COMMUTATIVITY-OF-+" (list x z)))
       (remove-x (t2-field-remove-fixed-operand lib *proof-plus* z x))
       (insert-x (proof-proof-symmetric proof remove-x))
       (restored (proof-proof-chain proof restored (list insert-x)))
       (equal-fixes (proof-proof-assume proof right t))
       (restored (proof-proof-rewrite proof restored equal-fixes '(1 2 2)))
       (remove-y (t2-field-remove-fixed-operand lib *proof-plus* z y))
       (commuted (library-library-axiom lib "COMMUTATIVITY-OF-+" (list z y)))
       (to-left (proof-proof-chain proof restored (list remove-y commuted)))
       (equivalence (t2-field-equal-predicates lib left right to-right to-left nil nil))
       (lib (t2-field-cancellation-lemma (cdr equivalence) "FIELD-CANCEL-EQUAL-SUMS"
                                        (car equivalence)))
       (cancel (t2-field-cancellation-commute-operands
                lib (car equivalence) "COMMUTATIVITY-OF-+" (list x y) 1))
       (lib (t2-field-cancellation-lemma lib "FIELD-LEFT-CANCEL-EQUAL-SUMS" cancel))
       (lib (t2-field-cancellation-cancel-opposite
             lib (library-plus x (library-plus y (library-minus x))))))
      (t2-field-cancellation-cancel-opposite
       lib (library-plus x (library-plus (library-minus x) y))))))

(defun t2-field-cancellation-apply-operation (operation term)
  (if (eq operation :minus)
      (library-minus term)
    (t2-field-reciprocal term)))

(defun t2-field-cancellation-map-involution (lib operation label fix-label name)
  (let* ((proof (library-library-proof lib))
         (x *library-x*)
         (y *library-y*)
         (op-x (t2-field-cancellation-apply-operation operation x))
         (op-y (t2-field-cancellation-apply-operation operation y))
         (lhs (proof-eq op-x op-y))
         (rhs (proof-eq (t2-field-fixed x) (t2-field-fixed y)))
         (a (t2-field-cancellation-apply-operation operation op-x)))
    (proof-with-checked-results
      ((start (t2-arithmetic-arithmetic-reflexive lib a))
       (lhs-assumption (proof-proof-assume proof lhs t))
       (to-right (proof-proof-rewrite proof start lhs-assumption '(1 2 1)))
       (invert-x (library-library-cite lib label (list x) nil))
       (to-right (proof-proof-rewrite proof to-right invert-x '(1 1)))
       (invert-y (library-library-cite lib label (list y) nil))
       (to-right (proof-proof-rewrite proof to-right invert-y '(1 2)))
       (fix-x (library-library-cite lib fix-label (list x) nil))
       (left (proof-proof-symmetric proof fix-x))
       (rhs-assumption (proof-proof-assume proof rhs t))
       (left (proof-proof-rewrite proof left rhs-assumption '(1 2 1)))
       (fix-y (library-library-cite lib fix-label (list y) nil))
       (to-left (proof-proof-chain proof left (list fix-y)))
       (equivalence (t2-field-equal-predicates lib lhs rhs to-right to-left nil nil)))
      (t2-field-cancellation-lemma
       (cdr equivalence) (concatenate 'string "FIELD-EQUAL-" name) (car equivalence)))))

(defun t2-field-cancellation-map-zero-operation (lib operation name)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
      ((zero (library-library-cite lib (concatenate 'string "FIELD-EQUAL-" name)
                                   (list *library-x* *proof-zero*) nil))
       (operation-zero
        (proof-proof-compute
         proof (t2-field-cancellation-apply-operation operation *proof-zero*) 0))
       (zero (proof-proof-rewrite proof zero operation-zero '(1 1 2)))
       (numeric (t2-arithmetic-number lib *proof-zero* nil))
       (fix-zero (t2-field-numeric-fix lib *proof-zero* numeric))
       (zero (proof-proof-rewrite proof zero fix-zero '(1 2 2))))
      (t2-field-cancellation-lemma lib (concatenate 'string "FIELD-ZERO-" name) zero))))

(defun t2-field-cancellation-map-zero (lib)
  (proof-with-checked-results
    ((lib (t2-field-cancellation-map-zero-operation lib :minus "NEGATIONS")))
    (t2-field-cancellation-map-zero-operation lib :reciprocal "RECIPROCALS")))

(defun t2-field-cancellation-sum-zero (lib)
  (let* ((proof (library-library-proof lib))
         (x *library-x*)
         (y *library-y*)
         (minus-y (library-minus y)))
    (proof-with-checked-results
      ((cancel (library-library-cite lib "FIELD-CANCEL-EQUAL-SUMS" (list x minus-y y) nil))
       (commuted (library-library-axiom lib "COMMUTATIVITY-OF-+" (list minus-y y)))
       (inverse (library-library-axiom lib "INVERSE-OF-+" (list y)))
       (opposite (proof-proof-chain proof commuted (list inverse)))
       (cancel (proof-proof-rewrite proof cancel opposite '(1 1 2)))
       (numeric (t2-field-number lib minus-y))
       (fix (t2-field-numeric-fix lib minus-y numeric))
       (cancel (proof-proof-rewrite proof cancel fix '(1 2 2)))
       (lib (t2-field-cancellation-lemma lib "FIELD-SUM-ZERO-TEST" cancel))
       (proof (library-library-proof lib))
       (other (proof-proof-instantiate proof cancel (list (list x y) (list y x))))
       (commuted (library-library-axiom lib "COMMUTATIVITY-OF-+" (list y x)))
       (other (proof-proof-rewrite proof other commuted '(1 1 1)))
       (reversal (t2-field-cancellation-symmetric-test lib (t2-field-fixed y) (library-minus x)))
       (other (proof-proof-chain proof other (list reversal)))
       (symmetric (proof-proof-symmetric proof other))
       (common (proof-proof-chain proof symmetric (list cancel)))
       (cancel-first (proof-step-first cancel))
       (test (proof-term-at cancel-first 2))
       (other-first (proof-step-first other))
       (other-test (proof-term-at other-first 2))
       (branch (t2-arithmetic-arithmetic-reflexive lib (proof-ite test other-test *proof-false*)))
       (branch (proof-proof-rewrite proof branch common '(1 2 2)))
       (identity (t2-field-cancellation-guarded-identity lib test))
       (branch (proof-proof-chain proof branch (list identity)))
       (back (proof-proof-symmetric proof branch))
       (step (proof-proof-chain proof cancel (list back))))
      (t2-field-cancellation-lemma lib "FIELD-SUM-ZERO-BOTH-SIDES" step))))

(defun t2-field-cancellation-reciprocal-order (lib name product value)
  (proof-with-checked-results
    ((reorder (t2-book-logic-ac-equal lib product value))
     (cancel (library-library-cite lib "FIELD-RECIPROCAL-PRODUCT-CANCEL"
                                   (list *library-x* *library-y*) nil))
     (equation (proof-proof-chain (library-library-proof lib) reorder (list cancel))))
    (t2-field-cancellation-lemma lib (concatenate 'string "FIELD-" name) equation)))

(defun t2-field-cancellation-reciprocal-products (lib)
  (let* ((proof (library-library-proof lib))
         (x *library-x*)
         (y *library-y*)
         (reciprocal (t2-field-reciprocal y))
         (test (proof-eq (t2-field-fixed y) *proof-zero*))
         (value (t2-products-times (t2-products-times x reciprocal) y))
         (expected (proof-ite (proof-neg test) (t2-field-fixed x) *proof-zero*)))
    (proof-with-checked-results
      ((not-zero (proof-proof-assume proof test nil))
       (cancel (t2-quotient-rounding-cancel-divisor lib x y not-zero))
       (simplified (t2-arithmetic-simplify proof expected (list not-zero) (list *proof-not*)))
       (back (proof-proof-symmetric proof simplified))
       (yes (proof-proof-chain proof cancel (list back)))
       (at-zero (proof-proof-assume proof test t))
       (start (t2-arithmetic-arithmetic-reflexive lib value))
       (zero (t2-field-reciprocal-zero lib y at-zero))
       (no (proof-proof-rewrite proof start zero '(1 2 1 2)))
       (zero-x (t2-products-product-zero lib x))
       (no (proof-proof-rewrite (library-library-proof (cdr zero-x)) no (car zero-x) '(1 2 1)))
       (commuted (library-library-axiom (cdr zero-x) "COMMUTATIVITY-OF-*" (list *proof-zero* y)))
       (zero-y (t2-products-product-zero (cdr zero-x) y))
       (lib (cdr zero-y))
       (proof (library-library-proof lib))
       (no (proof-proof-chain proof no (list commuted (car zero-y))))
       (simplified (t2-arithmetic-simplify proof expected (list at-zero) (list *proof-not*)))
       (back (proof-proof-symmetric proof simplified))
       (no (proof-proof-chain proof no (list back)))
       (step (proof-proof-cases proof test no yes))
       (lib (t2-field-cancellation-lemma lib "FIELD-RECIPROCAL-PRODUCT-CANCEL" step))
       (lib (t2-field-cancellation-reciprocal-order
             lib "CANCEL-RECIPROCAL-RIGHT"
             (t2-products-times y (t2-products-times x reciprocal)) value)))
      (t2-field-cancellation-reciprocal-order
       lib "CANCEL-RECIPROCAL-LEFT" (t2-products-times y (t2-products-times reciprocal x)) value))))

(defun t2-field-cancellation-cancel-products (lib)
  (let ((x *library-x*)
        (y *library-y*)
        (z *library-z*)
        (unit *proof-zero*))
    (proof-with-checked-results
      ((step (library-library-cite lib "FIELD-RIGHT-CANCELLATION" (list x y z) nil))
       (step (t2-field-cancellation-commute-operands
              lib step "COMMUTATIVITY-OF-*" (list x y) 1))
       (lib (t2-field-cancellation-lemma lib "FIELD-LEFT-CANCELLATION" step))
       (proof (library-library-proof lib))
       (zero (proof-proof-instantiate proof step (list (list x y) (list y unit) (list z x))))
       (zero-x (t2-products-product-zero lib x))
       (lib (cdr zero-x))
       (proof (library-library-proof lib))
       (zero (proof-proof-rewrite proof zero (car zero-x) '(1 1 2)))
       (number (t2-arithmetic-number lib unit nil))
       (fix (t2-field-numeric-fix lib unit number))
       (zero (proof-proof-rewrite proof zero fix '(1 2 3 2)))
       (reversal (t2-field-cancellation-symmetric-test lib unit (t2-field-fixed x)))
       (zero (proof-proof-rewrite proof zero reversal '(1 2 1)))
       (zero (proof-proof-rewrite proof zero reversal '(1 2 2)))
       (lib (t2-field-cancellation-lemma lib "FIELD-PRODUCT-ZERO-TEST" zero))
       (commuted (library-library-axiom lib "COMMUTATIVITY-OF-*" (list unit x)))
       (zero-x (t2-products-product-zero lib x))
       (lib (cdr zero-x))
       (product (proof-proof-chain (library-library-proof lib) commuted (list (car zero-x))))
       (lib (t2-field-cancellation-lemma lib "FIELD-ZERO-TIMES" product))
       (minus-factor (t2-order-negate-left-factor lib x y)))
      (t2-field-cancellation-lemma lib "FIELD-NEGATE-LEFT-FACTOR" minus-factor))))

(defun t2-field-cancellation-numeric-self-equality (lib operator combine fixed-operand)
  (let* ((proof (library-library-proof lib))
         (x *library-x*)
         (y *library-y*)
         (value (if (eq combine :plus) (library-plus x y) (t2-products-times x y)))
         (other (if (equal fixed-operand x) y x))
         (addition (equal operator *proof-plus*))
         (unit (if addition *proof-zero* *proof-one*)))
    (proof-with-checked-results
      ((numeric (proof-proof-assume proof (list *library-numberp* fixed-operand) t))
       (type-test (proof-step-first numeric))
       (term (proof-eq value fixed-operand))
       (no-type (proof-proof-assume proof type-test nil))
       (number (t2-field-number lib value))
       (at-equality (proof-proof-assume proof term t))
       (follows (proof-proof-rewrite proof number at-equality '(1 1)))
       (contradiction (proof-proof-cut proof follows no-type))
       (impossible (proof-proof-front proof contradiction (proof-neg term)))
       (start (t2-arithmetic-arithmetic-reflexive lib term))
       (name (if addition "COMMUTATIVITY-OF-+" "COMMUTATIVITY-OF-*"))
       (commuted (library-library-axiom lib name (list unit fixed-operand)))
       (identity (t2-field-identity lib fixed-operand numeric operator))
       (canceled (proof-proof-chain proof commuted (list identity)))
       (canceled (proof-proof-symmetric proof canceled))
       (start (proof-proof-rewrite proof start canceled '(1 2 2)))
       (start (if (equal fixed-operand x)
                  (proof-with-checked-results
                    ((commuted (library-library-axiom lib name (list x y))))
                    (proof-proof-rewrite proof start commuted '(1 2 1)))
                start)))
      (list start impossible numeric other unit))))

(defun t2-field-cancellation-sum-equals (lib zero operand)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
      ((self (t2-field-cancellation-numeric-self-equality lib *proof-plus* :plus operand))
       (step (first self))
       (impossible (second self))
       (numeric (third self))
       (other (fourth self))
       (unit (fifth self))
       (cancel (library-library-cite lib "FIELD-CANCEL-EQUAL-SUMS"
                                     (list other unit operand) nil))
       (cancel (proof-proof-rewrite proof cancel zero '(1 2 2)))
       (numeric-test (proof-step-first numeric))
       (literal (proof-step-first cancel))
       (condition (proof-term-at literal 2))
       (target (proof-ite numeric-test condition *proof-false*))
       (combined (proof-proof-chain proof step (list cancel)))
       (true-branch (proof-proof-if-true proof target))
       (yes (library-library-transport-argument lib combined true-branch 2))
       (false-value (t2-field-false-value lib impossible))
       (false-branch (proof-proof-if-false proof target))
       (no (library-library-transport-argument lib false-value false-branch 2))
       (step (proof-proof-cases proof numeric-test yes no)))
      (t2-field-cancellation-lemma
       lib (concatenate 'string "FIELD-SUM-EQUALS-" (third operand)) step))))

(defun t2-field-cancellation-sum-equals-operand (lib)
  (proof-with-checked-results
    ((number (t2-arithmetic-number lib *proof-zero* nil))
     (zero (t2-field-numeric-fix lib *proof-zero* number))
     (lib (t2-field-cancellation-sum-equals lib zero *library-x*)))
    (t2-field-cancellation-sum-equals lib zero *library-y*)))

(defun t2-field-cancellation-fixed-one (lib)
  (let* ((proof (library-library-proof lib))
         (x *library-x*)
         (left (proof-eq (t2-field-fixed x) *proof-one*))
         (right (proof-eq x *proof-one*)))
    (proof-with-checked-results
      ((at-one (proof-proof-assume proof left t))
       (not-nil (proof-proof-not-nil proof))
       (unit-test (t2-book-logic-constant lib (proof-eq *proof-one* *proof-zero*)))
       (ground (library-library-transport-argument lib not-nil unit-test 1))
       (back (proof-proof-symmetric proof at-one))
       (nonzero (proof-proof-rewrite proof ground back '(1 1 1)))
       (evidence (t2-power-numeric-from-fixed-nonzero lib x nonzero))
       (fix (t2-field-numeric-fix lib x (first evidence)))
       (to-right (proof-proof-rewrite proof at-one fix '(1 1)))
       (exact (proof-proof-assume proof right t))
       (numeric (t2-arithmetic-number lib *proof-one* nil))
       (back (proof-proof-symmetric proof exact))
       (numeric (proof-proof-rewrite proof numeric back '(1 1)))
       (fix (t2-field-numeric-fix lib x numeric))
       (to-left (proof-proof-chain proof fix (list exact)))
       (equivalence (t2-field-equal-predicates lib left right to-right to-left nil nil)))
      (car equivalence))))

(defun t2-field-cancellation-product-reversal (proof step numeric reversal positions)
  (declare (xargs :measure (acl2-count positions)))
  (if (endp positions)
      step
    (let ((position (car positions)))
      (proof-with-checked-results
        ((step (proof-proof-rewrite proof step numeric (list 1 2 position 2)))
         (step (proof-proof-rewrite proof step reversal (list 1 2 position))))
        (t2-field-cancellation-product-reversal proof step numeric reversal (cdr positions))))))

(defun t2-field-cancellation-product-equals (lib fix-unit fix-one operand)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
      ((self (t2-field-cancellation-numeric-self-equality lib *proof-times* :times operand))
       (step (first self))
       (impossible (second self))
       (numeric (third self))
       (other (fourth self))
       (unit (fifth self))
       (cancel (library-library-cite lib "FIELD-RIGHT-CANCELLATION"
                                     (list other unit operand) nil))
       (cancel (proof-proof-rewrite proof cancel fix-unit '(1 2 3 2)))
       (one (proof-proof-instantiate proof fix-one (list (list *library-x* other))))
       (cancel (proof-proof-rewrite proof cancel one '(1 2 3)))
       (numeric-value (t2-field-numeric-fix lib operand numeric))
       (reversal (t2-field-cancellation-symmetric-test lib *proof-zero* operand))
       (cancel (t2-field-cancellation-product-reversal proof cancel numeric-value reversal '(1 2)))
       (numeric-test (proof-step-first numeric))
       (literal (proof-step-first cancel))
       (condition (proof-term-at literal 2))
       (target (proof-ite numeric-test condition *proof-false*))
       (combined (proof-proof-chain proof step (list cancel)))
       (true-branch (proof-proof-if-true proof target))
       (yes (library-library-transport-argument lib combined true-branch 2))
       (false-value (t2-field-false-value lib impossible))
       (false-branch (proof-proof-if-false proof target))
       (no (library-library-transport-argument lib false-value false-branch 2))
       (step (proof-proof-cases proof numeric-test yes no)))
      (t2-field-cancellation-lemma
       lib (concatenate 'string "FIELD-PRODUCT-EQUALS-" (third operand)) step))))

(defun t2-field-cancellation-product-equals-operand (lib)
  (proof-with-checked-results
    ((number (t2-arithmetic-number lib *proof-one* nil))
     (fix-unit (t2-field-numeric-fix lib *proof-one* number))
     (fix-one (t2-field-cancellation-fixed-one lib))
     (lib (t2-field-cancellation-product-equals lib fix-unit fix-one *library-x*)))
    (t2-field-cancellation-product-equals lib fix-unit fix-one *library-y*)))

(defun t2-field-cancellation-numerator-nonzero (lib)
  (let* ((proof (library-library-proof lib))
         (x *library-x*)
         (numerator (list *t2-arithmetic-numerator* x))
         (rat (list *library-rationalp* x)))
    (proof-with-checked-results
      ((neq (proof-proof-assume proof (proof-eq numerator *proof-zero*) nil))
       (completion (library-library-axiom lib "COMPLETION-OF-NUMERATOR" (list x)))
       (literal (proof-step-first completion))
       (body (proof-term-at literal 2))
       (false-branch (proof-proof-if-false proof body))
       (zero (proof-proof-chain proof completion (list false-branch)))
       (cut (proof-proof-cut proof zero neq))
       (ratio (proof-proof-front proof cut rat))
       (equivalence (library-library-cite lib "FIELD-NUMERATOR-ZERO" (list x) (list ratio)))
       (nonzero (proof-proof-rewrite proof neq equivalence '(1 1)))
       (number (t2-order-number-from-rational lib ratio))
       (step (t2-power-join lib (list nonzero number)))
       (claim (proof-step-first step))
       (neq-first (proof-step-first neq))
       (condition (proof-term-at neq-first 1)))
      (library-library-lemma lib "FIELD-NUMERATOR-NONZERO" claim step (list condition)))))

(defun t2-field-cancellation-build (lib)
  (proof-with-checked-results
    ((lib (t2-field-cancellation-cancel-sums lib))
     (lib (t2-field-cancellation-map-involution
           lib :minus "FIELD-DOUBLE-NEGATION" "FIELD-MINUS-FIX" "NEGATIONS"))
     (lib (t2-field-cancellation-map-zero lib))
     (lib (t2-field-cancellation-sum-zero lib))
     (lib (t2-field-cancellation-reciprocal-products lib))
     (lib (t2-field-cancellation-cancel-products lib))
     (lib (t2-field-cancellation-sum-equals-operand lib))
     (lib (t2-field-cancellation-product-equals-operand lib)))
    (t2-field-cancellation-numerator-nonzero lib)))
