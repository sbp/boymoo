(in-package "BOYMOO-PROVER")
(set-verify-guards-eagerness 0)
(logic)

(defconst *t2-power-zip* (proof-sym "ZIP" "ACL2"))
(defconst *t2-power-ifix* (proof-sym "IFIX" "ACL2"))
(defconst *t2-power-equal-num* (proof-cl "="))

(defun t2-power-term-at (term indices)
  (declare (xargs :measure (acl2-count indices)))
  (cond ((failure-p term) term)
        ((endp indices) term)
        (t (t2-power-term-at (proof-term-at term (car indices)) (cdr indices)))))

(defmacro t2-power-first (step &rest indices)
  `(t2-power-term-at (proof-step-first ,step) ',indices))

(defun t2-power-power (base exponent)
  (list *t2-book-logic-expt* base exponent))

(defun t2-power-condition (terms)
  (cond ((endp terms) '(:failure "MissingTermPart" ""))
        ((endp (cdr terms)) (car terms))
        (t (proof-ite (car terms) (t2-power-condition (cdr terms)) *proof-false*))))

(defun t2-power-join (lib premises)
  (cond ((endp premises) '(:failure "MissingTermPart" ""))
        ((endp (cdr premises)) (car premises))
        (t (proof-with-checked-results ((rest (t2-power-join lib (cdr premises))))
             (t2-field-conjunction lib (car premises) rest)))))

(defun t2-power-conjuncts (lib proof count)
  (declare (xargs :measure (nfix (1- count))))
  (if (or (not (integerp count)) (<= count 1))
      (list proof)
    (proof-with-checked-results
        ((parts (t2-arithmetic-arithmetic-conjunct lib proof))
         (rest (t2-power-conjuncts lib (cadr parts) (1- count))))
      (cons (car parts) rest))))

(defun t2-power-guards (steps)
  (if (endp steps)
      nil
    (proof-with-checked-results
        ((literal (proof-step-first (car steps)))
         (rest (t2-power-guards (cdr steps))))
      (cons (proof-neg literal) rest))))

(defun t2-power-literals (steps)
  (if (endp steps)
      nil
    (proof-with-checked-results
        ((literal (proof-step-first (car steps)))
         (rest (t2-power-literals (cdr steps))))
      (cons literal rest))))

(defun t2-power-assumptions (proof terms holds)
  (if (endp terms)
      nil
    (proof-with-checked-results
        ((step (proof-proof-assume proof (car terms) holds))
         (rest (t2-power-assumptions proof (cdr terms) holds)))
      (cons step rest))))

(defun t2-power-implication (lib antecedent conclusion)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((claim (proof-step-first conclusion))
         (formula (list *library-implies* antecedent claim))
         (opened (proof-proof-unfold proof formula))
         (rhs (t2-power-first opened 2))
         (if-true (proof-proof-if-true proof rhs))
         (test (proof-term-at rhs 2))
         (selected (proof-proof-select proof test conclusion))
         (yes (proof-proof-chain proof opened (list if-true selected)))
         (yes (proof-proof-true-from-eq proof yes))
         (if-false (proof-proof-if-false proof rhs))
         (no (proof-proof-chain proof opened (list if-false)))
         (no (proof-proof-true-from-eq proof no)))
      (proof-proof-cases proof antecedent yes no))))

(defun t2-power-smaller-instance (lib formula descent pairs premises)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((decrease (proof-step-first descent))
         (smaller (proof-subst formula (proof-bindings-table pairs nil)))
         (hypothesis (proof-ite decrease smaller *proof-true*))
         (assumed (proof-proof-assume proof hypothesis t))
         (proven (proof-proof-prove-if proof assumed descent))
         (joined (t2-power-join lib premises)))
      (t2-arithmetic-arithmetic-modus-ponens lib proven joined))))

(defun t2-power-zip-equation (lib exponent integral)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((opened (proof-proof-unfold proof (list *t2-power-zip* exponent)))
         (body (t2-power-first opened 2))
         (selected (proof-proof-select proof body integral))
         (step (proof-proof-chain proof opened (list selected)))
         (test (t2-power-first step 2))
         (equation (proof-proof-unfold proof test)))
      (proof-proof-chain proof step (list equation)))))

(defun t2-power-zero-power (lib base at-zero)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((exponent (t2-power-first at-zero 1))
         (selected (proof-proof-unfold proof (t2-power-power base *proof-zero*)))
         (zip-zero (t2-arithmetic-arithmetic-prove
                    lib (list *t2-power-zip* *proof-zero*) nil
                    (list *t2-power-zip* *t2-power-equal-num*)))
         (body (t2-power-first selected 2))
         (branch (proof-proof-select proof body zip-zero))
         (selected (proof-proof-chain proof selected (list branch)))
         (reflexive (t2-arithmetic-arithmetic-reflexive lib (t2-power-power base exponent)))
         (at-zero (proof-proof-rewrite proof reflexive at-zero '(1 2 2))))
      (proof-proof-chain proof at-zero (list selected)))))

(defun t2-power-nonzero-zip (lib exponent integral distinct-from-zero)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((equation (t2-power-zip-equation lib exponent integral))
         (reversed (proof-proof-symmetric proof equation))
         (rewritten (proof-proof-rewrite proof distinct-from-zero reversed '(1 1))))
      (proof-proof-tidy proof rewritten))))

(defun t2-power-split-power (lib base exponent integral not-zero fixed-base)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((opened (proof-proof-unfold proof (t2-power-power base exponent)))
         (body (t2-power-first opened 2))
         (not-zip (t2-power-nonzero-zip lib exponent integral not-zero))
         (selected (proof-proof-select proof body not-zip))
         (step (proof-proof-chain proof opened (list selected)))
         (test (t2-power-first step 2 1))
         (equality (proof-proof-unfold proof test))
         (fixed-test (proof-step-first fixed-base))
         (position (if (proof-is-call fixed-test *proof-not*) '(1 1) '(1)))
         (reversed (proof-proof-symmetric proof equality))
         (ruler (proof-proof-rewrite proof fixed-base reversed position))
         (body (t2-power-first step 2))
         (selected (proof-proof-select proof body ruler)))
      (proof-proof-chain proof step (list selected)))))

(defun t2-power-fixed-nonzero (lib numeric different)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((base (t2-power-first numeric 1))
         (representative (t2-field-numeric-fix lib base numeric))
         (reversed (proof-proof-symmetric proof representative))
         (rewritten (proof-proof-rewrite proof different reversed '(1 1 1))))
      (proof-proof-tidy proof rewritten))))

(defun t2-power-nonintegral-exponent (lib base evidence)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((exponent (t2-power-first evidence 1 1))
         (opened (proof-proof-unfold proof (list *t2-power-zip* exponent)))
         (body (t2-power-first opened 2))
         (selected (proof-proof-select proof body evidence))
         (zipped (proof-proof-chain proof opened (list selected)))
         (zipped (proof-proof-true-from-eq proof zipped))
         (equation (proof-proof-unfold proof (t2-power-power base exponent)))
         (body (t2-power-first equation 2))
         (selected (proof-proof-select proof body zipped)))
      (proof-proof-chain proof equation (list selected)))))

(defun t2-power-nonzero-power (lib base exponent numeric different)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((equation (proof-proof-fact
                    proof (proof-sym "EXPT-TYPE-PRESCRIPTION-NON-ZERO-BASE" "ACL2")
                    (list (list (proof-sym "R" "ACL2") base)
                          (list (proof-sym "I" "ACL2") exponent))))
         (premise (t2-field-conjunction lib numeric different)))
      (t2-arithmetic-arithmetic-modus-ponens lib equation premise))))

(defun t2-power-numeric-from-fixed-nonzero (lib base not-fixed-zero)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((opened (proof-proof-unfold proof (t2-field-fixed base)))
         (body (t2-power-first opened 2))
         (selected (proof-proof-if-false proof body))
         (zero (proof-proof-chain proof opened (list selected)))
         (cut (proof-proof-cut proof zero not-fixed-zero))
         (numeric (proof-proof-front proof cut (list *library-numberp* base)))
         (fix (t2-field-numeric-fix lib base numeric))
         (distinct-base (proof-proof-rewrite proof not-fixed-zero fix '(1 1 1)))
         (distinct-base (proof-proof-tidy proof distinct-base)))
      (list numeric distinct-base))))

(defun t2-power-rational-power (lib rational-base exponent)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((base (t2-power-first rational-base 1))
         (theorem (proof-proof-fact
                   proof (proof-sym "RATIONALP-EXPT-TYPE-PRESCRIPTION" "ACL2")
                   (list (list (proof-sym "R" "ACL2") base)
                         (list (proof-sym "I" "ACL2") exponent)))))
      (t2-arithmetic-arithmetic-modus-ponens lib theorem rational-base))))

(defun t2-power-base-conditions (increasing)
  (if increasing
      (list (library-lt *proof-one* *library-x*))
    (list (library-positive *library-x*) (library-lt *library-x* *proof-one*))))

(defun t2-power-shift-integer-order (lib first second integers)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((comparison (library-library-axiom lib "<-ON-OTHERS" (cdr first)))
         (other (library-library-axiom lib "<-ON-OTHERS" (cdr second)))
         (left (t2-power-first comparison 2 1))
         (right (t2-power-first other 2 1))
         (equation (t2-arithmetic-linear-equal lib left right integers))
         (comparison (proof-proof-rewrite proof comparison equation '(1 2 1)))
         (reversed (proof-proof-symmetric proof other)))
      (proof-proof-chain proof comparison (list reversed)))))

(defun t2-power-recurrence-from-smaller (lib base integral smaller numeric nonzero forward)
  (proof-with-checked-results ((exponent (t2-power-first integral 1)))
    (if (not forward)
        (library-library-cite lib "POWER-PREDECESSOR" (list base exponent)
                              (list numeric nonzero integral))
      (proof-with-checked-results
          ((previous (t2-power-first smaller 1))
           (equation (library-library-cite lib "POWER-SUCCESSOR" (list base previous)
                                           (list numeric nonzero smaller)))
           (linear (t2-arithmetic-linear-equal lib (library-plus previous *proof-one*)
                                               exponent (list integral))))
        (library-inherited proof-proof-rewrite lib equation linear '(1 1 2))))))

(defun t2-power-exponent-cases (lib integral)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((exponent (t2-power-first integral 1))
         (positive-exp (proof-proof-assume proof (library-positive exponent) t))
         (minus-one (library-plus exponent *proof-neg-one*))
         (plus-one (library-plus exponent *proof-one*))
         (small-pos (library-library-builtin lib 10 exponent))
         (small-pos (proof-proof-discharge proof small-pos integral))
         (small-pos (proof-proof-discharge proof small-pos positive-exp))
         (rational-zero (t2-arithmetic-rational lib *proof-zero* nil))
         (rational-exponent (t2-arithmetic-rational lib exponent (list integral)))
         (negative-exp (t2-order-trichotomy lib *proof-zero* exponent
                                            (list rational-zero rational-exponent)))
         (nonzero (proof-proof-assume proof (proof-eq exponent *proof-zero*) nil))
         (nonzero (t2-products-flip-neq lib nonzero))
         (negative-exp (proof-proof-discharge proof negative-exp nonzero))
         (goal (list *proof-ordinal-less* (list *library-count* plus-one)
                     (list *library-count* exponent)))
         (context (t2-tactics-ruler-facts-init lib nil (list integral negative-exp)))
         (small-neg (t2-tactics-countdown-negative-countdown lib goal context)))
      (cons (list (list minus-one small-pos) (list plus-one (car small-neg)))
            (cadr small-neg)))))

(defun t2-power-distance-decrease (lib lower upper order integers)
  (let ((proof (library-library-proof lib))
        (gap (library-diff upper lower)))
    (proof-with-checked-results
        ((integral (t2-arithmetic-arithmetic-type-of lib gap integers))
         (comparison (t2-arithmetic-comparison lib lower upper integers))
         (pos (proof-proof-rewrite proof order comparison '(1)))
         (descend (library-library-builtin lib 14 gap))
         (descend (proof-proof-discharge proof descend integral))
         (descend (proof-proof-discharge proof descend pos))
         (predecessor (library-plus upper *proof-neg-one*))
         (next-gap (library-diff predecessor lower))
         (equality (t2-arithmetic-linear-equal lib next-gap (library-plus *proof-neg-one* gap)
                                               integers))
         (reversed (proof-proof-symmetric proof equality))
         (descend (proof-proof-rewrite proof descend reversed '(1 1 1))))
      (proof-proof-tidy proof descend))))

(defun t2-power-equal-predecessor (lib lower upper smaller order integers)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((at-least (t2-products-discrete-step lib order integers))
         (comparison (t2-power-shift-integer-order
                      lib (library-lt smaller lower)
                      (library-lt upper (library-plus *proof-one* lower)) integers))
         (bound (library-library-transport-argument lib at-least comparison 1))
         (lower-rational (t2-arithmetic-rational lib lower integers))
         (smaller-rational (t2-arithmetic-rational lib smaller integers))
         (backwards (t2-order-trichotomy lib lower smaller
                                          (list lower-rational smaller-rational)))
         (cut (proof-proof-cut proof backwards bound)))
      (proof-proof-front proof cut (proof-eq lower smaller)))))

(defun t2-power-exponent-number-leaf (value tests lib)
  (declare (ignore tests))
  (if (member-equal value (list *proof-zero* *proof-one*))
      (t2-arithmetic-number lib value nil)
    (t2-field-number lib value)))

(defun t2-power-exponent-number-leaves (requests lib)
  (if (endp requests)
      nil
    (proof-with-checked-results
        ((step (t2-power-exponent-number-leaf (caar requests) (cadar requests) lib))
         (rest (t2-power-exponent-number-leaves (cdr requests) lib)))
      (cons (cons (car requests) step) rest))))

(defun t2-power-exponent-number (lib)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((opened (proof-proof-unfold proof (t2-power-power *library-x* *library-y*)))
         (template (list *library-numberp* *proof-result*))
         (body (t2-power-first opened 2))
         (requests (proof-proof-by-value-leaves proof body nil))
         (leaf (t2-power-exponent-number-leaves requests lib))
         (step (proof-proof-by-value proof body template leaf nil))
         (step (library-library-transport-argument lib step opened 1))
         (claim (proof-step-first step)))
      (library-library-lemma lib "POWER-NUMBER" claim step nil))))

(defun t2-power-recurrence-lemmas (lib)
  (let ((proof (library-library-proof lib))
        (x *library-x*)
        (y *library-y*)
        (zero *proof-zero*)
        (one *proof-one*))
    (proof-with-checked-results
        ((num (proof-proof-assume proof (list *library-numberp* x) t))
         (distinct-base (proof-proof-assume proof (proof-eq x zero) nil))
         (fixed-base (t2-power-fixed-nonzero lib num distinct-base))
         (integer-y (library-library-ints lib (list y)))
         (int-y (car integer-y))
         (nonnegative (proof-proof-assume proof (library-lt y zero) nil))
         (negative (proof-proof-assume proof (library-lt y zero) t))
         (next-y (library-plus y one))
         (int-next (t2-arithmetic-arithmetic-type-of lib next-y (list int-y)))
         (positive-next (library-library-cite lib "POSITIVE-ONE-PLUS" (list y)
                                              (list int-y nonnegative)))
         (commuted (library-library-axiom lib "COMMUTATIVITY-OF-+" (list one y)))
         (positive-next (proof-proof-rewrite proof positive-next commuted '(1 2)))
         (next-nonzero (t2-order-distinct lib positive-next))
         (next-nonzero (t2-products-flip-neq lib next-nonzero))
         (forward (t2-power-split-power lib x next-y int-next next-nonzero fixed-base))
         (body (t2-power-first forward 2))
         (forward-case (proof-proof-select proof body positive-next))
         (forward (proof-proof-chain proof forward (list forward-case)))
         (actual (t2-power-first forward 2 2 2))
         (same (t2-arithmetic-linear-equal lib actual y (list int-y)))
         (forward (proof-proof-rewrite proof forward same '(1 2 2 2)))
         (nonzero-y (t2-order-distinct lib negative))
         (backward (t2-power-split-power lib x y int-y nonzero-y fixed-base))
         (body (t2-power-first backward 2))
         (opposite (t2-order-opposite-order lib negative))
         (backward-case (proof-proof-select proof body opposite))
         (backward (proof-proof-chain proof backward (list backward-case)))
         (at-y (t2-power-power x y))
         (at-next (t2-power-power x next-y))
         (start (t2-arithmetic-arithmetic-reflexive lib (t2-products-times x at-y)))
         (start (proof-proof-rewrite proof start backward '(1 2 2)))
         (multiplication (library-library-axiom lib "ASSOCIATIVITY-OF-*"
                                                (list x (t2-field-reciprocal x) at-next)))
         (reversed (proof-proof-symmetric proof multiplication))
         (start (proof-proof-chain proof start (list reversed)))
         (invert (t2-field-inverse lib num distinct-base))
         (start (proof-proof-rewrite proof start invert '(1 2 1)))
         (unit (library-library-axiom lib "UNICITY-OF-1" (list at-next)))
         (numeric (library-library-cite lib "POWER-NUMBER" (list x next-y) nil))
         (fixed (t2-field-numeric-fix lib at-next numeric))
         (start (proof-proof-chain proof start (list unit fixed)))
         (reversed (proof-proof-symmetric proof start))
         (successor (proof-proof-cases proof (library-lt y zero) reversed forward))
         (num-literal (proof-step-first num))
         (int-literal (proof-step-first int-y))
         (side (list (proof-neg num-literal) (proof-eq x zero) (proof-neg int-literal)))
         (lib (library-library-lemma lib "POWER-SUCCESSOR"
                                     (proof-eq at-next (t2-products-times x at-y)) successor side))
         (proof (library-library-proof lib))
         (term (t2-products-times (t2-field-reciprocal x) at-next))
         (start (t2-arithmetic-arithmetic-reflexive lib term))
         (start (proof-proof-rewrite proof start successor '(1 2 2)))
         (multiplication (library-library-axiom lib "ASSOCIATIVITY-OF-*"
                                                (list (t2-field-reciprocal x) x at-y)))
         (reversed (proof-proof-symmetric proof multiplication))
         (start (proof-proof-chain proof start (list reversed)))
         (commuted (library-library-axiom lib "COMMUTATIVITY-OF-*"
                                          (list (t2-field-reciprocal x) x)))
         (product (proof-proof-chain proof commuted (list invert)))
         (start (proof-proof-rewrite proof start product '(1 2 1)))
         (unit (library-library-axiom lib "UNICITY-OF-1" (list at-y)))
         (numeric (library-library-cite lib "POWER-NUMBER" (list x y) nil))
         (fixed (t2-field-numeric-fix lib at-y numeric))
         (start (proof-proof-chain proof start (list unit fixed)))
         (predecessor (proof-proof-symmetric proof start)))
      (library-library-lemma lib "POWER-PREDECESSOR"
                             (proof-eq at-y (t2-products-times (t2-field-reciprocal x) at-next))
                             predecessor side))))

(defun t2-power-integer-exponent-test-case (lib zipped fixed-exponent holds)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((int-y (proof-proof-assume proof (library-integer *library-y*) holds))
         (body (t2-power-first zipped 2))
         (selected (proof-proof-select proof body int-y))
         (left (proof-proof-chain proof zipped (list selected)))
         (next (if holds
                   (proof-with-checked-results ((body (t2-power-first left 2)))
                     (proof-proof-unfold proof body))
                 (proof-with-checked-results
                     ((computed (proof-proof-compute proof (proof-eq *proof-zero* *proof-zero*)
                                                     *proof-t*)))
                   (proof-proof-symmetric proof computed))))
         (left (proof-proof-chain proof left (list next)))
         (body (t2-power-first fixed-exponent 2))
         (selected (proof-proof-select proof body int-y))
         (right (proof-proof-chain proof fixed-exponent (list selected)))
         (reversed (proof-proof-symmetric proof right)))
      (proof-proof-rewrite proof left reversed '(1 2 1)))))

(defun t2-power-integer-exponent-test (lib)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((zipped (proof-proof-unfold proof (list *t2-power-zip* *library-y*)))
         (fixed-exponent (proof-proof-unfold proof (list *t2-power-ifix* *library-y*)))
         (yes (t2-power-integer-exponent-test-case lib zipped fixed-exponent t))
         (no (t2-power-integer-exponent-test-case lib zipped fixed-exponent nil))
         (step (proof-proof-cases proof (library-integer *library-y*) yes no))
         (claim (proof-step-first step)))
      (library-library-lemma lib "POWER-ZIP-FIX" claim step nil))))

(defun t2-power-boundary-values (lib)
  (let ((x *library-x*)
        (y *library-y*)
        (zero *proof-zero*)
        (one *proof-one*))
    (proof-with-checked-results
        ((at-zero (t2-arithmetic-arithmetic-reflexive lib zero))
         (at-zero (t2-power-zero-power lib x at-zero))
         (lib (library-library-lemma lib "POWER-ZERO-EXPONENT"
                                     (proof-eq (t2-power-power x zero) one) at-zero nil))
         (proof (library-library-proof lib))
         (nonintegral (proof-proof-assume proof (library-integer y) nil))
         (equation (t2-power-nonintegral-exponent lib x nonintegral))
         (claim (proof-step-first equation))
         (lib (library-library-lemma lib "POWER-NONINTEGER-EXPONENT" claim equation
                                     (list (library-integer y))))
         (proof (library-library-proof lib))
         (zero-base (proof-eq (t2-field-fixed x) zero))
         (opened (proof-proof-unfold proof (t2-power-power x y)))
         (selected (t2-power-first opened 2))
         (zipped (proof-term-at selected 1))
         (zip-branch (proof-proof-if-true proof selected))
         (when-zipped (proof-proof-chain proof opened (list zip-branch)))
         (no-zip-branch (proof-proof-if-false proof selected))
         (when-unzipped (proof-proof-chain proof opened (list no-zip-branch)))
         (numeric-test (t2-power-first when-unzipped 2 1))
         (assumed-zero (proof-proof-assume proof zero-base t))
         (expanded (proof-proof-unfold proof numeric-test))
         (zero-test (proof-proof-transport proof assumed-zero expanded))
         (body (t2-power-first when-unzipped 2))
         (selected (proof-proof-select proof body zero-test))
         (when-unzipped (proof-proof-chain proof when-unzipped (list selected)))
         (conditional (proof-ite zipped one zero))
         (if-true (proof-proof-if-true proof conditional))
         (when-zipped (library-library-transport-argument lib when-zipped if-true 2))
         (if-false (proof-proof-if-false proof conditional))
         (when-unzipped (library-library-transport-argument lib when-unzipped if-false 2))
         (step (proof-proof-cases proof zipped when-zipped when-unzipped))
         (claim (proof-step-first step))
         (lib (library-library-lemma lib "POWER-FIXED-ZERO" claim step (list (proof-neg zero-base))))
         (numeric-zero (t2-arithmetic-number lib zero nil))
         (zero-fix (t2-field-numeric-fix lib zero numeric-zero))
         (equation (library-library-cite lib "POWER-FIXED-ZERO" (list zero y) (list zero-fix)))
         (claim (proof-step-first equation))
         (lib (library-library-lemma lib "POWER-ZERO-BASE" claim equation nil))
         (proof (library-library-proof lib))
         (no-zero (proof-proof-assume proof zero-base nil))
         (facts (t2-power-numeric-from-fixed-nonzero lib x no-zero))
         (numeric (car facts))
         (different (cadr facts))
         (int-zero (t2-arithmetic-arithmetic-type-of lib zero nil))
         (at-one (library-library-cite lib "POWER-SUCCESSOR" (list x zero)
                                      (list numeric different int-zero)))
         (sum (proof-proof-compute proof (library-plus zero one) 1))
         (at-one (proof-proof-rewrite proof at-one sum '(1 1 2)))
