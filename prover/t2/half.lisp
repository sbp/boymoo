    (strict-first (proof-step-first strict))
    (value (proof-term-at strict-first 1))
    (old-size (library-minus value))
    (pos-two (t2-arithmetic-arithmetic-prove lib (library-positive *t2-half-two*) nil nil))
    (parts (t2-floor-reduced-fraction lib value *t2-half-two* integers pos-two))
    (cross (car parts))
    (int-n (cadr parts))
    (int-d (caddr parts))
    (pos-d (cadddr parts))
    (integers (append integers (list int-n int-d)))
    (n-type (proof-step-first int-n))
    (n (proof-term-at n-type 1))
    (d-type (proof-step-first int-d))
    (d (proof-term-at d-type 1))
    (n-size (library-minus n))
    (scaled-negative (t2-products-scale lib strict pos-d integers nil))
    (reverse (proof-proof-symmetric proof cross))
    (scaled-negative (proof-proof-rewrite proof scaled-negative reverse '(1 1)))
    (zero (t2-products-product-zero lib d))
    (lib (cdr zero))
    (proof (library-library-proof lib))
    (scaled-negative (proof-proof-rewrite proof scaled-negative (car zero) '(1 2)))
    (zero (t2-products-product-zero lib *t2-half-two*))
    (lib (cdr zero))
    (proof (library-library-proof lib))
    (reverse (proof-proof-symmetric proof (car zero)))
    (scaled-negative (proof-proof-rewrite proof scaled-negative reverse '(1 2)))
    (neg-n (t2-products-cancel-scale lib scaled-negative pos-two integers))
    (pos-n-size (t2-arithmetic-negative-magnitude lib neg-n integers))
