(in-package "BOYMOO-PROVER")

(set-verify-guards-eagerness 0)

(defconst *t2-half-two* (proof-quote 2))
(defconst *t2-half-neg-two* (proof-quote -2))

(defun t2-half-magnitude-distinct (lib term constant distinct integers)
  (let* ((proof (library-library-proof lib))
         (magnitude (library-minus term))
         (same (proof-eq constant magnitude)))
    (proof-with-checked-results
     ((integral (t2-arithmetic-arithmetic-type-of lib term integers))
      (twice (library-library-cite lib "DOUBLE-NEGATION" (list term) (list integral)))
      (assumed (proof-proof-assume proof same t))
      (reverse (proof-proof-symmetric proof assumed))
      (value (proof-proof-rewrite proof twice reverse '(1 1 1)))
      (reverse (proof-proof-symmetric proof value))
      (constant (proof-proof-constant-base proof (library-minus constant)))
      (value (proof-proof-chain proof reverse (list constant)))
      (cut (proof-proof-cut proof value distinct)))
     (proof-proof-front proof cut (proof-neg same)))))

(defun t2-half-magnitude-greater-than-two (lib negative one-distinct two-distinct integers)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
     ((pos (t2-arithmetic-negative-magnitude lib negative integers))
      (literal (proof-step-first negative))
      (value (proof-term-at literal 1))
      (bound (t2-products-discrete-step lib pos integers))
      (one (proof-proof-compute proof (library-plus *proof-one* *proof-zero*) 1))
      (bound (proof-proof-rewrite proof bound one '(1 1 2)))
      (distinct (t2-half-magnitude-distinct lib value *proof-one* one-distinct integers))
      (past-one (t2-products-strict-from-weak lib bound distinct integers))
      (bound (t2-products-discrete-step lib past-one integers))
      (two (proof-proof-compute proof (library-plus *proof-one* *proof-one*) 2))
      (bound (proof-proof-rewrite proof bound two '(1 1 2)))
      (distinct (t2-half-magnitude-distinct lib value *t2-half-two* two-distinct integers)))
     (t2-products-strict-from-weak lib bound distinct integers))))

(defun t2-half-doubled (lib value integers)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
     ((expansion (library-library-axiom lib "DISTRIBUTIVITY" (list value *proof-one* *proof-one*)))
      (two (proof-proof-compute proof (library-plus *proof-one* *proof-one*) 2))
      (expansion (proof-proof-rewrite proof expansion two '(1 1 2)))
      (number (t2-arithmetic-number lib value integers))
      (unit (t2-products-product-one lib value number))
      (expansion (proof-proof-rewrite-first proof expansion unit))
      (swap (library-library-axiom lib "COMMUTATIVITY-OF-*" (list *t2-half-two* value))))
     (proof-proof-chain proof swap (list expansion)))))

(defun t2-half-build-rounding-bound (lib name)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
     ((types (library-library-ints lib (list *library-x* *library-y* *library-z*)))
      (equation (proof-eq (t2-products-times *t2-half-two* *library-y*)
                          (t2-products-times *library-x* *library-z*)))
      (same (proof-proof-assume proof equation t))
      (pos (proof-proof-assume proof (library-positive *library-x*) t))
      (magnitude (library-lt *t2-half-two* *library-z*))
      (pos-two (t2-arithmetic-arithmetic-prove lib (library-positive *t2-half-two*) nil nil))
      (wide (proof-proof-assume proof magnitude t))
      (bound (t2-products-scale lib wide pos types nil))
      (swap (library-library-axiom lib "COMMUTATIVITY-OF-*" (list *library-x* *t2-half-two*)))
      (bound (proof-proof-rewrite proof bound swap '(1 1)))
      (reverse (proof-proof-symmetric proof same))
      (bound (proof-proof-rewrite proof bound reverse '(1 2)))
      (bound (t2-products-cancel-scale lib bound pos-two types))
      (comparison (library-library-cite lib "LESS-SHIFT" (list *library-x* *library-y* *library-y*)
                                        (list (car types) (cadr types) bound)))
      (swap (library-library-axiom lib "COMMUTATIVITY-OF-+" (list *library-x* *library-y*)))
      (comparison (proof-proof-rewrite proof comparison swap '(1 1)))
      (doubled (t2-half-doubled lib *library-y* types))
      (reverse (proof-proof-symmetric proof doubled))
      (comparison (proof-proof-rewrite proof comparison reverse '(1 2)))
      (step (proof-proof-rewrite proof comparison same '(1 2)))
      (claim (proof-step-first step))
      (positive (proof-step-first pos)))
     (library-library-lemma lib name claim step
                            (library-guards (list (library-integer *library-x*)
                                                  (library-integer *library-y*)
                                                  (library-integer *library-z*)
                                                  positive magnitude equation))))))

(defun t2-half-rounding-bound (lib cross pos-factor wide integers)
  (let ((name "HALF-ROUNDING-BOUND"))
    (proof-with-checked-results
     ((lib (if (assoc-equal (proof-sym "SELF-HALF-ROUNDING-BOUND" "ACL2")
                           (proof-proof-facts (library-library-proof lib)))
               lib
             (t2-half-build-rounding-bound lib name)))
      (literal (proof-step-first cross))
      (parts (proof-list-of-length literal 3))
      (left (cadr parts))
      (right (caddr parts))
      (denominator (proof-term-at right 1))
      (numerator (proof-term-at left 2))
      (dividend (proof-term-at right 2))
      (terms (list denominator numerator dividend))
      (int-d (t2-arithmetic-arithmetic-type-of lib denominator integers))
      (int-n (t2-arithmetic-arithmetic-type-of lib numerator integers))
      (int-i (t2-arithmetic-arithmetic-type-of lib dividend integers))
      (step (library-library-cite lib name terms (list int-d int-n int-i pos-factor wide cross))))
     (cons step lib))))

(defun t2-half-build-negated-count (lib name)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
     ((types (library-library-ints lib (list *library-x*)))
      (ix (car types))
      (pos (proof-proof-assume proof (library-positive *library-x*) t))
      (negative (t2-arithmetic-less-from-difference lib (library-minus *library-x*) *proof-zero*
                                                   pos (list ix)))
      (result (t2-arithmetic-count-negative lib negative (list ix)))
      (lib (cdr result))
      (twice (library-library-cite lib "DOUBLE-NEGATION" (list *library-x*) (list ix)))
      (step (proof-proof-chain (library-library-proof lib) (car result) (list twice)))
      (claim (proof-step-first step)))
     (library-library-lemma lib name claim step
                            (library-guards (list (library-integer *library-x*)
                                                  (library-positive *library-x*)))))))

(defun t2-half-negated-count (lib positive-value integers)
  (let ((name "COUNT-NEGATED-POSITIVE"))
    (proof-with-checked-results
     ((lib (if (assoc-equal (proof-sym "SELF-COUNT-NEGATED-POSITIVE" "ACL2")
                           (proof-proof-facts (library-library-proof lib)))
               lib
             (t2-half-build-negated-count lib name)))
      (literal (proof-step-first positive-value))
      (value (proof-term-at literal 2))
      (integral (t2-arithmetic-arithmetic-type-of lib value integers))
      (step (library-library-cite lib name (list value) (list integral positive-value))))
     (cons step lib))))

(defun t2-half-count-after (lib equation count-value)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
     ((first (proof-step-first equation))
      (value (proof-term-at first 1))
      (identity (t2-arithmetic-arithmetic-reflexive lib (list *library-count* value)))
      (opened (proof-proof-rewrite proof identity equation '(1 2 1))))
     (proof-proof-chain proof opened (list count-value)))))

(defun t2-half-floor-at-minus-two (lib)
  (let ((proof (library-library-proof lib))
        (floor (list *t2-floor-floor* *t2-half-neg-two* *t2-half-two*))
        (reciprocal (list *t2-floor-reciprocal* *t2-half-two*))
        (half (proof-quote '("ratio" 1 2))))
    (proof-with-checked-results
     ((equation (t2-arithmetic-simplify proof floor nil (list *t2-floor-floor*)))
      (reciprocal (proof-proof-compute proof reciprocal (cadr half)))
      (equation (proof-proof-rewrite-first proof equation reciprocal))
      (product (proof-proof-compute proof (t2-products-times *t2-half-neg-two* half) -1))
      (equation (proof-proof-rewrite-first proof equation product))
      (denominator (proof-proof-compute proof (list *t2-arithmetic-denominator* *proof-neg-one*) 1))
      (equation (proof-proof-rewrite-first proof equation denominator))
      (numerator (proof-proof-compute proof (list *t2-arithmetic-numerator* *proof-neg-one*) -1))
      (equation (proof-proof-rewrite-first proof equation numerator))
      (first (proof-step-first equation))
      (body (proof-term-at first 2))
      (condition (proof-term-at body 1))
      (test (t2-arithmetic-arithmetic-prove lib condition nil (list *t2-floor-equal-num*)))
      (selected (proof-proof-select proof body test))
      (equation (proof-proof-chain proof equation (list selected)))
      (definitions (list *library-count* *t2-arithmetic-abs*))
      (count (t2-arithmetic-simplify proof (list *library-count* *proof-neg-one*) nil definitions))
      (floor-count (t2-half-count-after lib equation count))
      (old-count (t2-arithmetic-simplify proof (list *library-count* *t2-half-neg-two*) nil definitions))
      (smaller (t2-arithmetic-arithmetic-prove lib (library-lt *proof-one* *t2-half-two*) nil nil))
      (smaller (library-library-transport-argument lib smaller floor-count 1))
      (smaller (library-library-transport-argument lib smaller old-count 2))
      (first (proof-step-first smaller))
      (args (proof-list-of-length (cdr first) 2))
      (comparison (t2-arithmetic-arithmetic-ordinal-comparison lib (car args) (cadr args) nil)))
     (proof-proof-transport proof smaller comparison))))

