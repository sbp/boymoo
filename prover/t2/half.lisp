(defun t2-half-build-halving (lib)
  (if (assoc-equal (proof-sym "SELF-COUNT-FLOOR-HALF" "ACL2")
                  (proof-proof-facts (library-library-proof lib)))
      lib
    (proof-with-checked-results
     ((lib (t2-floor-build-positive-floor lib))
      (proof (library-library-proof lib))
      (integers (library-library-ints lib (list *library-x*)))
      (int-x (car integers))
      (test (library-lt *library-x* *proof-zero*))
      (nonzero (proof-proof-assume proof (proof-eq *library-x* *proof-zero*) nil))
      (not-minus-one (proof-proof-assume proof (proof-eq *library-x* *proof-neg-one*) nil))
      (nonnegative (proof-proof-assume proof test nil))
      (pos-x (library-library-cite lib "POSITIVE-FROM-NONZERO" (list *library-x*)
                                   (list int-x nonnegative nonzero)))
      (int-two (t2-arithmetic-arithmetic-type-of lib *t2-half-two* nil))
      (wide-two (t2-arithmetic-arithmetic-prove lib (library-lt *proof-one* *t2-half-two*) nil nil))
      (positive-case (library-library-cite lib "COUNT-FLOOR-POSITIVE" (list *library-x* *t2-half-two*)
                                           (list int-x int-two pos-x wide-two)))
      (at-minus-two (proof-eq *library-x* *t2-half-neg-two*))
      (constant-bound (t2-half-floor-at-minus-two lib))
      (same (proof-proof-assume proof at-minus-two t))
      (reverse (proof-proof-symmetric proof same))
      (at-two-bound (proof-proof-rewrite-first proof constant-bound reverse))
      (negative (proof-proof-assume proof test t))
      (not-minus-two (proof-proof-assume proof at-minus-two nil))
      (wide (t2-half-magnitude-greater-than-two lib negative not-minus-one not-minus-two integers))
      (rest (t2-half-negative-halving lib negative wide integers))
      (lib (cdr rest))
      (proof (library-library-proof lib))
      (negative-case (proof-proof-cases proof at-minus-two at-two-bound (car rest)))
      (result (proof-proof-cases proof test negative-case positive-case))
      (claim (proof-step-first result))
      (head (proof-term-at claim 0)))
     (if (not (equal head *proof-ordinal-less*))
         '(:failure "RecipeMismatch" "")
       (library-library-lemma lib "COUNT-FLOOR-HALF" claim result
                              (list (proof-neg (library-integer *library-x*))
                                    (proof-eq *library-x* *proof-zero*)
                                    (proof-eq *library-x* *proof-neg-one*)))))))

(defun t2-half-signed-floor-decrease-query (lib value divisor hypotheses replies)
  (if (not (equal divisor *t2-half-two*))
      '(:failure "RecipeMismatch" "")
    (descent-let*
     ((built (t2-half-build-halving lib))
      (hypotheses (t2-phase-hypotheses-after-library hypotheses lib built))
      (integral (t2-phase-hypotheses-require hypotheses (library-integer value) replies))
      (nonzero (t2-phase-hypotheses-require
                (cdr integral) (proof-neg (proof-eq value *proof-zero*)) replies))
      (not-minus-one (t2-phase-hypotheses-require
                      (cdr nonzero) (proof-neg (proof-eq value *proof-neg-one*)) replies))
      (step (library-library-cite built "COUNT-FLOOR-HALF" (list value)
                                  (list (car integral) (car nonzero) (car not-minus-one)))))
     (cons (list step (cdr not-minus-one)) built))))

(defun t2-half-signed-floor-decrease (lib value divisor hypotheses)
  (t2-half-signed-floor-decrease-query lib value divisor hypotheses :plain))
