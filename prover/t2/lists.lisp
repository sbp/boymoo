(in-package "BOYMOO-PROVER")
(set-verify-guards-eagerness 0)

(defconst *t2-lists-evens* (proof-sym "EVENS" "ACL2"))
(defconst *t2-lists-odds* (proof-sym "ODDS" "ACL2"))
(defconst *t2-lists-hons-remove* (proof-sym "HONS-REMOVE-ASSOC" "ACL2"))

(defun t2-lists-sum-shift (lib step offset left-offset)
  (if (not step)
      '(:failure "failure" "")
    (proof-with-checked-results
     ((literal (proof-step-first step))
      (parts (proof-list-of-length literal 3))
      (a (cadr parts)) (b (caddr parts))
      (types (t2-guarded-selectors-type-arguments lib (list a b offset) nil))
      (result (library-library-cite lib "LESS-SHIFT" (list a b offset) (append types (list step))))
      (result (if left-offset (descent-shift-left lib result a b offset) result)))
     (proof-proof-tidy (library-library-proof lib) result))))

(defun t2-lists-sum-decrease-decrease (n child parent lib hypotheses)
  (declare (xargs :measure (nfix n)))
  (cond
   ((not (o< (nfix (1- n)) (nfix n))) '(:failure "fuel" "t2-lists-sum-decrease-decrease"))
   ((equal child parent) (cons nil hypotheses))
   ((and (proof-is-call child *proof-plus*) (proof-is-call parent *proof-plus*))
    (proof-with-checked-results
     ((child-left (proof-term-at child 1))
      (parent-left (proof-term-at parent 1))
      (left (t2-lists-sum-decrease-decrease (1- n) child-left parent-left lib hypotheses))
      (child-right (proof-term-at child 2))
      (parent-right (proof-term-at parent 2))
      (right (t2-lists-sum-decrease-decrease (1- n) child-right parent-right lib (cdr left)))
      (step (cond
             ((and (car left) (car right))
              (proof-with-checked-results
               ((shifted-left (t2-lists-sum-shift lib (car left) child-right nil))
                (shifted-right (t2-lists-sum-shift lib (car right) parent-left t)))
               (t2-guarded-selectors-library-compare-chain lib shifted-left shifted-right)))
             ((car left) (t2-lists-sum-shift lib (car left) child-right nil))
             (t (t2-lists-sum-shift lib (car right) parent-left t)))))
     (cons step (cdr right))))
   ((not (proof-is-call parent *library-len*)) '(:failure "recipe-mismatch" ""))
   (t (proof-with-checked-results ((argument (proof-term-at parent 1)))
        (if (not (equal child (list *library-len* (list *library-cdr* argument))))
            '(:failure "recipe-mismatch" "")
          (proof-with-checked-results
           ((cons-step (t2-guarded-selectors-context-require hypotheses (list *proof-consp* argument)))
            (decrease (library-library-cite lib "LEN-CDR-LESS" (list argument) (list (car cons-step)))))
           (cons decrease (cdr cons-step))))))))

(defun t2-lists-sum-decrease (lib goal hypotheses)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
     ((parts (proof-list-of-length goal 3))
      (child (cadr parts)) (parent (caddr parts))
      (decrease (t2-lists-sum-decrease-decrease 1000000 child parent lib hypotheses))
      (comparison (t2-guarded-selectors-library-ordinal-comparison lib child parent))
      (step (if (car decrease)
                (proof-proof-transport proof (car decrease) comparison)
              '(:failure "failure" ""))))
     (cons step (cdr decrease)))))

(defun t2-lists-size-at-cons (lib size term cons-step)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
     ((equation (proof-proof-unfold proof (list size term)))
      (body (proof-rewritten-term equation))
      (selected (proof-proof-select proof body cons-step)))
     (proof-proof-chain proof equation (list selected)))))

(defun t2-lists-size-of-cons (lib size first rest)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
     ((cons-step (proof-proof-fact proof "consp-cons"
                                  (list (list *library-x* first) (list *library-y* rest))))
      (result (t2-lists-size-at-cons lib size (list *proof-cons* first rest) cons-step))
      (car-cons (library-library-axiom lib "CAR-CONS" (list first rest)))
      (result (proof-proof-rewrite-first proof result car-cons))
      (cdr-cons (library-library-axiom lib "CDR-CONS" (list first rest))))
     (proof-proof-rewrite-first proof result cdr-cons))))

(defun t2-lists-size-of-cons-result (lib size term)
  (let ((arguments (cdr term)))
    (cond ((integerp term) '(:failure "failure" ""))
          ((endp arguments)
           '(:failure "failure" ""))
          ((endp (cdr arguments))
           '(:failure "failure" ""))
          ((consp (cddr arguments))
           '(:failure "failure" ""))
          (t (t2-lists-size-of-cons lib size (car arguments) (cadr arguments))))))

(defun t2-lists-replace-smaller (lib bound equality)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
     ((literal (proof-step-first bound))
      (place (if (proof-is-call literal *proof-less*) '(1 1) '(1 1 2)))
      (reverse (proof-proof-symmetric proof equality))
      (rewritten (proof-proof-rewrite proof bound reverse place)))
     (proof-proof-tidy proof rewritten))))

(defun t2-lists-replace-larger (lib bound equality)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
     ((literal (proof-step-first bound))
      (place (if (proof-is-call literal *proof-less*) '(1 2) '(1 1 1)))
      (reverse (proof-proof-symmetric proof equality))
      (rewritten (proof-proof-rewrite proof bound reverse place)))
     (proof-proof-tidy proof rewritten))))

(defun t2-lists-empty-bound (lib size whole equation)
  (let ((proof (library-library-proof lib)) (whole-size (list size whole)))
    (proof-with-checked-results
     ((natural (t2-guarded-selectors-library-natural lib whole-size))
      (zero (library-library-cite lib "NATURAL-NONNEGATIVE" (list whole-size) (list natural)))
      (nil-size (t2-guarded-selectors-simplify proof (list size *proof-false*) nil (list size)))
      (bound (t2-lists-replace-smaller lib zero nil-size))
      (reverse (proof-proof-symmetric proof equation))
      (rewritten (proof-proof-rewrite proof bound reverse '(1 1 2 1))))
     (proof-proof-tidy proof rewritten))))

(defun t2-lists-induction-hypothesis (lib formula smaller-argument descent)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
     ((literal (proof-step-first descent))
      (instance (proof-subst formula (list (cons *library-x* smaller-argument))))
      (assumed (proof-proof-assume proof (proof-ite literal instance *proof-true*) t)))
     (proof-proof-prove-if proof assumed descent))))

(defun t2-lists-length-cdr-weak (lib)
  (let* ((proof (library-library-proof lib))
         (x *library-x*)
         (tail (list *library-len* (list *library-cdr* x)))
         (parent (list *library-len* x))
         (cons-test (list *proof-consp* x)))
    (proof-with-checked-results
     ((assumed (proof-proof-assume proof cons-test t))
      (strict (library-library-cite lib "LEN-CDR-LESS" (list x) (list assumed)))
      (yes (library-library-as-weak lib strict))
      (completion (library-library-axiom lib "COMPLETION-OF-CDR" (list x)))
      (body (proof-rewritten-term completion))
      (if-false (proof-proof-if-false proof body))
      (empty (proof-proof-chain proof completion (list if-false)))
      (reflexive (proof-proof-reflexive proof tail))
      (empty-tail (proof-proof-rewrite proof reflexive empty '(1 2 1)))
      (body (proof-rewritten-term empty-tail))
      (simplified (t2-guarded-selectors-simplify proof body nil (list *library-len*)))
      (empty-tail (proof-proof-chain proof empty-tail (list simplified)))
      (natural (t2-guarded-selectors-library-natural lib parent))
      (zero (library-library-cite lib "NATURAL-NONNEGATIVE" (list parent) (list natural)))
      (no (t2-lists-replace-smaller lib zero empty-tail))
      (cases (proof-proof-cases proof cons-test yes no)))
     (library-library-lemma lib "LEN-CDR-WEAK" (library-le tail parent) cases nil))))

(defun t2-lists-have-lemma-p (lib name)
  (assoc-equal (proof-sym (concatenate 'string "SELF-" name) "ACL2")
               (proof-proof-facts (library-library-proof lib))))

(defun t2-lists-build-weak-order (lib)
  (if (t2-lists-have-lemma-p lib "WEAK-SHIFT")
      lib
    (let* ((proof (library-library-proof lib))
           (x *library-x*) (y *library-y*) (z *library-z*)
           (yx (library-lt y x)) (zy (library-lt z y))
           (dx (library-diff y x)) (dy (library-diff z y))
           (xz (library-plus x z)) (yz (library-plus y z)))
      (proof-with-checked-results
       ((ints (library-library-ints lib (list x y z)))
        (weak-xy (proof-proof-assume proof yx nil))
        (weak-yz (proof-proof-assume proof zy nil))
        (x-order (library-library-axiom lib "<-ON-OTHERS" (list y x)))
        (weak-x (proof-proof-rewrite proof weak-xy x-order '(1 1)))
        (y-order (library-library-axiom lib "<-ON-OTHERS" (list z y)))
        (weak-y (proof-proof-rewrite proof weak-yz y-order '(1 1)))
        (shift (library-library-weak-from-difference lib xz yz weak-x ints))
        (guards (library-guards (list (library-integer x) (library-integer y) (library-integer z))))
        (lib (library-library-lemma lib "WEAK-SHIFT" (library-le xz yz) shift
                                    (append guards (list yx))))
        (dy-type (t2-guarded-selectors-library-type-of lib dy ints))
        (dx-type (t2-guarded-selectors-library-type-of lib dx ints))
        (sum (library-library-cite lib "NONNEGATIVE-SUM" (list dy dx)
                                   (list dy-type dx-type weak-y weak-x)))
        (transitive (library-library-weak-from-difference lib x z sum ints)))
       (library-library-lemma lib "WEAK-TRANSITIVE" (library-le x z) transitive
                              (append guards (list yx zy)))))))

(defun t2-lists-weak-shift (lib bound offset)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
     ((literal (proof-step-first bound))
      (outer (proof-list-of-length literal 2))
      (inner (proof-list-of-length (cadr outer) 3))
      (upper (cadr inner)) (lower (caddr inner))
      (lower-type (t2-guarded-selectors-library-type-of lib lower nil))
      (upper-type (t2-guarded-selectors-library-type-of lib upper nil))
      (offset-type (t2-guarded-selectors-library-type-of lib offset nil))
      (result (library-library-cite lib "WEAK-SHIFT" (list lower upper offset)
                                    (list lower-type upper-type offset-type bound)))
      (commute (library-library-axiom lib "COMMUTATIVITY-OF-+" (list upper offset)))
      (result (proof-proof-rewrite proof result commute '(1 1 1)))
      (commute (library-library-axiom lib "COMMUTATIVITY-OF-+" (list lower offset)))
      (result (proof-proof-rewrite proof result commute '(1 1 2))))
     (proof-proof-tidy proof result))))

(defun t2-lists-context-after-library (context initial lib)
  (if (equal (descent-hypotheses-proof (t2-guarded-selectors-context-hypotheses context)) initial)
      (t2-guarded-selectors-context-with-library context lib)
    context))

(defun t2-lists-evens-bound (lib rulers)
  (if (t2-lists-have-lemma-p lib "LEN-EVENS-WEAK")
      lib
    (proof-with-checked-results
     ((lib (t2-lists-build-weak-order lib))
      (lib (t2-lists-length-cdr-weak lib))
      (proof (library-library-proof lib))
      (x *library-x*)
      (even (list *t2-lists-evens* x))
      (formula (library-le (list *library-len* even) (list *library-len* x)))
      (equation (proof-proof-unfold proof even))
      (body (proof-rewritten-term equation))
      (stop (proof-term-at body 1))
      (taken (t2-guarded-selectors-context-init lib (list (list stop nil)) nil (eq rulers :ruler-facts)))
      (cons-step (t2-guarded-selectors-context-require taken (list *proof-consp* x)))
      (cdr-x (list *library-cdr* x))
      (cddr-x (list *library-cdr* cdr-x))
      (goal (list *proof-ordinal-less* (list *library-count* cddr-x) (list *library-count* x)))
      (descent (t2-guarded-selectors-context-selector-decrease lib goal (cdr cons-step)))
      (smaller (t2-lists-induction-hypothesis lib formula cddr-x (car descent)))
      (cddr-bound (library-library-cite lib "LEN-CDR-WEAK" (list cdr-x) nil))
      (chained (t2-guarded-selectors-library-compare-chain lib smaller cddr-bound))
      (shifted (t2-lists-weak-shift lib chained *proof-one*))
      (if-false (proof-proof-if-false proof body))
      (next-even (proof-proof-chain proof equation (list if-false)))
      (expanded (proof-rewritten-term next-even))
      (result-size (t2-lists-size-of-cons-result lib *library-len* expanded))
      (yes (t2-lists-replace-smaller lib shifted result-size))
      (size (t2-lists-size-at-cons lib *library-len* x (car cons-step)))
      (yes (t2-lists-replace-larger lib yes size))
      (reverse (proof-proof-symmetric proof next-even))
      (yes (proof-proof-rewrite proof yes reverse '(1 1 2 1)))
      (yes (proof-proof-tidy proof yes))
      (if-true (proof-proof-if-true proof body))
      (opened (proof-proof-chain proof equation (list if-true)))
      (no (t2-lists-empty-bound lib *library-len* x opened))
      (builtin (library-library-builtin lib 1 x))
      (cases (proof-proof-cases proof stop no yes))
      (induction (proof-proof-induct proof builtin cases formula (list *library-count* x)
                                     (list (list (list x cddr-x))))))
     (library-library-lemma lib "LEN-EVENS-WEAK" formula induction nil))))

(defun t2-lists-split-odds (lib term original first-tail hypotheses)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
     ((odds (proof-proof-unfold proof term))
      (weak (library-library-cite lib "LEN-EVENS-WEAK" (list first-tail) nil))
      (cons-step (t2-guarded-selectors-context-require hypotheses (list *proof-consp* original)))
      (strict (library-library-cite lib "LEN-CDR-LESS" (list original) (list (car cons-step))))
      (comparison (t2-guarded-selectors-library-compare-chain lib weak strict))
      (reverse (proof-proof-symmetric proof odds))
      (comparison (proof-proof-rewrite proof comparison reverse '(1 1 1))))
     (cons comparison (cdr cons-step)))))

(defun t2-lists-split-evens (lib term original first-tail hypotheses)
  (if (not (equal term (list *t2-lists-evens* original)))
      '(:failure "recipe-mismatch" "")
    (let ((proof (library-library-proof lib)))
      (proof-with-checked-results
       ((equation (proof-proof-unfold proof term))
        (body (proof-rewritten-term equation))
        (cons-step (t2-guarded-selectors-context-require hypotheses (list *proof-consp* original)))
        (test (proof-term-at body 1))
        (nonempty (t2-guarded-selectors-library-prove
                   lib (proof-neg test) (list (car cons-step))
                   (list (proof-cl "ENDP") (proof-cl "ATOM") *proof-not*)))
        (selected (proof-proof-select proof body nonempty))
        (expanded (proof-proof-chain proof equation (list selected)))
        (second-tail (list *library-cdr* first-tail))
        (weak (library-library-cite lib "LEN-EVENS-WEAK" (list second-tail) nil))
        (tail-cons (t2-guarded-selectors-context-require (cdr cons-step) (list *proof-consp* first-tail)))
        (strict (library-library-cite lib "LEN-CDR-LESS" (list first-tail) (list (car tail-cons))))
        (comparison (t2-guarded-selectors-library-compare-chain lib weak strict))
        (comparison (t2-lists-sum-shift lib comparison *proof-one* t))
        (result (proof-rewritten-term expanded))
        (size (t2-lists-size-of-cons-result lib *library-len* result))
        (comparison (t2-lists-replace-smaller lib comparison size))
        (size (t2-lists-size-at-cons lib *library-len* original (car cons-step)))
        (comparison (t2-lists-replace-larger lib comparison size))
        (reverse (proof-proof-symmetric proof expanded))
        (comparison (proof-proof-rewrite proof comparison reverse '(1 1 1))))
       (cons comparison (cdr tail-cons))))))

(defun t2-lists-split-decrease (lib goal hypotheses rulers)
  (proof-with-checked-results
   ((ready (t2-lists-evens-bound lib rulers))
    (proof (library-library-proof ready))
    (parts (proof-list-of-length goal 3))
    (child (cadr parts)) (parent (caddr parts))
    (original (proof-term-at parent 1))
    (first-tail (list *library-cdr* original))
    (term (proof-term-at child 1))
    (hypotheses (t2-lists-context-after-library hypotheses lib ready))
    (comparison (if (proof-is-call term *t2-lists-odds*)
                    (t2-lists-split-odds ready term original first-tail hypotheses)
                  (t2-lists-split-evens ready term original first-tail hypotheses)))
    (order (t2-guarded-selectors-library-ordinal-comparison ready child parent))
    (step (proof-proof-transport proof (car comparison) order)))
   (cons step (cons ready (cdr comparison)))))

(defun t2-lists-removal-keep (lib x taken kept smaller cdr-proof)
  (let ((proof (library-library-proof lib))
        (kept-argument (list *library-count* (list *library-car* x))))
    (proof-with-checked-results
     ((bound (t2-lists-weak-shift lib smaller kept-argument))
      (bound (t2-lists-weak-shift lib bound *proof-one*))
      (size (t2-lists-size-of-cons-result lib *library-count* kept))
      (bound (t2-lists-replace-smaller lib bound size))
      (size (t2-lists-size-at-cons lib *library-count* x cdr-proof))
      (bound (t2-lists-replace-larger lib bound size))
      (body (proof-rewritten-term taken))
      (if-true (proof-proof-if-true proof body))
      (equation (proof-proof-chain proof taken (list if-true)))
      (reverse (proof-proof-symmetric proof equation))
      (bound (proof-proof-rewrite proof bound reverse '(1 1 2 1))))
     (proof-proof-tidy proof bound))))

(defun t2-lists-removal-drop (lib x cdr-x taken removed smaller descent)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
     ((order (t2-guarded-selectors-library-ordinal-comparison lib
                                                       (list *library-count* cdr-x) (list *library-count* x)))
      (cdr-strict (proof-proof-rewrite proof descent order '(1)))
      (chained (t2-guarded-selectors-library-compare-chain lib smaller cdr-strict))
      (bound (library-library-as-weak lib chained))
      (body (proof-rewritten-term taken))
      (if-false (proof-proof-if-false proof body))
      (equation (proof-proof-chain proof taken (list if-false)))
      (reduced (proof-rewritten-term equation)))
     (if (not (equal reduced removed))
         '(:failure "recipe-mismatch" "")
       (proof-with-checked-results
        ((reverse (proof-proof-symmetric proof equation))
         (bound (proof-proof-rewrite proof bound reverse '(1 1 2 1))))
        (proof-proof-tidy proof bound))))))

(defun t2-lists-removal-bound (lib rulers)
  (if (t2-lists-have-lemma-p lib "COUNT-HONS-REMOVE-ASSOC-WEAK")
      lib
    (proof-with-checked-results
     ((lib (t2-lists-build-weak-order lib))
      (proof (library-library-proof lib))
      (x *library-x*)
      (removal (list *t2-lists-hons-remove* *library-y* x))
      (formula (library-le (list *library-count* removal) (list *library-count* x)))
      (equation (proof-proof-unfold proof removal))
      (body (proof-rewritten-term equation))
      (stop (proof-term-at body 1))
      (branch (t2-guarded-selectors-context-init lib (list (list stop nil)) nil (eq rulers :ruler-facts)))
      (cons-step (t2-guarded-selectors-context-require branch (list *proof-consp* x)))
      (if-false (proof-proof-if-false proof body))
      (taken (proof-proof-chain proof equation (list if-false)))
      (selected (proof-rewritten-term taken))
      (parts (if (integerp selected)
                 '(:failure "failure" "")
               (proof-list-of-length (cdr selected) 3)))
      (cdr-x (list *library-cdr* x))
      (builtin (library-library-builtin lib 3 x))
      (descent (proof-proof-discharge proof builtin (car cons-step)))
      (smaller (t2-lists-induction-hypothesis lib formula cdr-x descent))
      (kept-bound (t2-lists-removal-keep lib x taken (cadr parts) smaller (car cons-step)))
      (removed-bound (t2-lists-removal-drop lib x cdr-x taken (caddr parts) smaller descent))
      (nonempty (proof-proof-cases proof (car parts) kept-bound removed-bound))
      (if-true (proof-proof-if-true proof body))
      (opened (proof-proof-chain proof equation (list if-true)))
      (empty (t2-lists-empty-bound lib *library-count* x opened))
      (builtin (library-library-builtin lib 1 x))
      (cases (proof-proof-cases proof stop empty nonempty))
      (induction (proof-proof-induct proof builtin cases formula (list *library-count* x)
                                     (list (list (list x cdr-x))))))
     (library-library-lemma lib "COUNT-HONS-REMOVE-ASSOC-WEAK" formula induction nil))))

(defun t2-lists-removal-decrease (lib goal hypotheses rulers)
  (proof-with-checked-results
   ((ready (t2-lists-removal-bound lib rulers))
    (proof (library-library-proof ready))
    (parts (proof-list-of-length goal 3))
    (child (cadr parts)) (parent (caddr parts))
    (term (proof-term-at child 1))
    (source (proof-term-at term 2))
    (original (proof-term-at parent 1)))
   (if (not (equal source (list *library-cdr* original)))
       '(:failure "recipe-mismatch" "")
     (proof-with-checked-results
      ((key (proof-term-at term 1))
       (weak (library-library-cite ready "COUNT-HONS-REMOVE-ASSOC-WEAK" (list source key) nil))
       (hypotheses (t2-lists-context-after-library hypotheses lib ready))
       (count (list *library-count* source))
       (descent (t2-guarded-selectors-context-selector-decrease
                 ready (list *proof-ordinal-less* count parent) hypotheses))
      (order (t2-guarded-selectors-library-ordinal-comparison ready count parent))
       (strict (proof-proof-rewrite proof (car descent) order '(1)))
      (comparison (t2-guarded-selectors-library-compare-chain ready weak strict))
      (order (t2-guarded-selectors-library-ordinal-comparison ready child parent))
       (step (proof-proof-transport proof comparison order)))
      (cons step (cons ready (cdr descent)))))))
