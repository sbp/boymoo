(in-package "BOYMOO-PROVER")
(set-verify-guards-eagerness 0)

(defun t2-products-times (a b)
  (list *proof-times* a b))

(defun t2-products-fact-present-p (lib name)
  (assoc-equal (proof-sym (concatenate 'string "SELF-" name) "ACL2")
               (proof-proof-facts (library-library-proof lib))))

(defun t2-products-library-type-of (lib term evidence)
  (t2-guarded-selectors-library-type-of lib term evidence))

(defun t2-products-library-modus-ponens (lib step evidence)
  (let ((proof (library-library-proof lib)))
    (if (not (t2-guarded-selectors-arithmetic-p lib))
        (proof-proof-modus-ponens proof step evidence)
      (proof-with-checked-results ((literal (proof-step-first step)) (head (proof-term-at literal 0)))
        (if (not (equal head *library-implies*))
            '(:failure "recipe-mismatch" "")
          (proof-with-checked-results ((left (proof-term-at literal 1))
                                       (known (proof-step-first evidence)))
            (if (equal left known)
                (library-library-cite lib "IMPLICATION-CONSEQUENT" (cdr literal) (list step evidence))
              '(:failure "recipe-mismatch" ""))))))))

(defun t2-products-library-rational (lib term evidence)
  (proof-with-checked-results
   ((axiom (library-library-axiom lib "INTEGER-IMPLIES-RATIONAL" (list term)))
    (type (t2-products-library-type-of lib term evidence)))
   (t2-products-library-modus-ponens lib axiom type)))

(defun t2-products-library-number (lib term evidence)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
     ((fact (proof-proof-fact proof "rationalp-acl2-numberp" (list (list *library-x* term))))
      (rational (t2-products-library-rational lib term evidence)))
     (t2-products-library-modus-ponens lib fact rational))))

(defun t2-products-library-comparison (lib a b integers)
  (proof-with-checked-results
   ((a-type (t2-products-library-type-of lib a integers))
    (b-type (t2-products-library-type-of lib b integers)))
   (library-library-cite lib "LESS-DIFFERENCE" (list a b) (list a-type b-type))))

(defun t2-products-push-minus (n lib term evidence)
  (declare (xargs :measure (nfix n)))
  (let ((proof (library-library-proof lib)))
    (cond
     ((not (o< (nfix (1- n)) (nfix n))) '(:failure "fuel" "t2-products-push-minus"))
     ((proof-is-call term *proof-plus*)
      (proof-with-checked-results
       ((result (proof-proof-reflexive proof term))
        (left (proof-term-at term 1))
        (left (t2-products-push-minus (1- n) lib left evidence))
        (result (if left (proof-proof-rewrite proof result left '(1 2 1)) result))
        (right (proof-term-at term 2))
        (right (t2-products-push-minus (1- n) lib right evidence))
        (result (if right (proof-proof-rewrite proof result right '(1 2 2)) result))
        (value (proof-rewritten-term result)))
       (and (not (equal value term)) result)))
     ((proof-is-call term *proof-minus*)
      (proof-with-checked-results ((argument (proof-term-at term 1)))
        (if (proof-is-call argument *proof-quote*)
            (proof-proof-constant-base proof term)
          (proof-with-checked-results
           ((result
             (cond
              ((and (proof-is-call argument *proof-minus*) (t2-products-fact-present-p lib "DOUBLE-NEGATION"))
               (proof-with-checked-results
                ((item (proof-term-at argument 1))
                 (type (t2-products-library-type-of lib item evidence)))
                (library-library-cite lib "DOUBLE-NEGATION" (list item) (list type))))
              ((and (proof-is-call argument *proof-plus*) (t2-products-fact-present-p lib "NEGATE-SUM"))
               (proof-with-checked-results
                ((types (t2-guarded-selectors-type-arguments lib (cdr argument) evidence)))
                (library-library-cite lib "NEGATE-SUM" (cdr argument) types)))
              (t nil))))
           (and result
                (proof-with-checked-results
                 ((right (proof-rewritten-term result))
                  (rest (t2-products-push-minus (1- n) lib right evidence)))
                 (proof-proof-chain proof result (list rest))))))))
     (t nil))))

(defun t2-products-linear-remove-zero (lib step name term place evidence)
  (proof-with-checked-results
   ((type (t2-products-library-type-of lib term evidence))
    (zero (library-library-cite lib name (list term) (list type))))
   (proof-proof-rewrite (library-library-proof lib) step zero place)))

(defun t2-products-linear-combine (n lib step place evidence)
  (declare (xargs :measure (nfix n)))
  (if (not (o< (nfix (1- n)) (nfix n)))
      '(:failure "fuel" "t2-products-linear-combine")
    (let ((proof (library-library-proof lib)))
      (proof-with-checked-results
       ((literal (proof-step-first step))
        (node (library-linear-form-get literal (cdr place))))
       (if (not (proof-is-call node *proof-plus*))
           (proof-proof-tidy proof step)
         (proof-with-checked-results
          ((pair (proof-list-of-length (cdr node) 2))
           (a (car pair)) (rest (cadr pair))
           (suffix (proof-is-call rest *proof-plus*))
           (b (if suffix (proof-term-at rest 1) rest)))
          (cond
           ((equal a *proof-zero*)
            (proof-with-checked-results
             ((reduced (t2-products-linear-remove-zero lib step "ADD-ZERO-LEFT" rest place evidence)))
             (t2-products-linear-combine (1- n) lib reduced place evidence)))
           ((and (equal b *proof-zero*) (not suffix))
            (proof-with-checked-results
             ((reduced (t2-products-linear-remove-zero lib step "ADD-ZERO-RIGHT" a place evidence)))
             (t2-products-linear-combine (1- n) lib reduced place evidence)))
           (t (proof-with-checked-results ((combine (library-linear-combine-pair lib a b)))
                (if (not combine)
                    (t2-products-linear-combine (1- n) lib step (append place '(2)) evidence)
                  (proof-with-checked-results
                   ((step (if suffix
                              (proof-with-checked-results
                               ((tail (proof-term-at rest 2))
                                (assoc (library-library-axiom lib "ASSOCIATIVITY-OF-+" (list a b tail)))
                                (reverse (proof-proof-symmetric proof assoc)))
                               (proof-proof-rewrite proof step reverse place))
                            step))
                    (step (proof-proof-rewrite proof step combine (if suffix (append place '(1)) place))))
                   (t2-products-linear-combine (1- n) lib step '(1 2) evidence))))))))))))

(defun t2-products-linear-form (lib term evidence)
  (proof-with-checked-results
   ((step (t2-products-push-minus 1000000 lib term evidence))
    (step (or step (proof-proof-reflexive (library-library-proof lib) term)))
    (step (library-linear-reassociate 1000000 lib step '(1 2)))
    (step (library-linear-sort 1000000 lib step '(1 2) nil)))
   (t2-products-linear-combine 1000000 lib step '(1 2) evidence)))

(defun t2-products-library-linear-equal (lib left right integers)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
     ((a (t2-products-linear-form lib left integers))
      (b (t2-products-linear-form lib right integers))
      (a-normal (proof-rewritten-term a))
      (b-normal (proof-rewritten-term b)))
     (if (equal a-normal b-normal)
         (proof-with-checked-results ((reverse (proof-proof-symmetric proof b)))
           (proof-proof-chain proof a (list reverse)))
       (proof-with-checked-results ((a-text (proof-write a-normal)) (b-text (proof-write b-normal)))
         '(:failure "recipe-mismatch" ""))))))

(defun t2-products-library-weak-from-difference (lib a b nonnegative-difference integers)
  (proof-with-checked-results
   ((compare (library-library-axiom lib "<-ON-OTHERS" (list b a)))
    (literal (proof-step-first nonnegative-difference))
    (bound (proof-term-at literal 1))
    (term (proof-term-at bound 1))
    (delta (t2-products-library-linear-equal lib (library-diff b a) term integers))
    (compare (proof-proof-rewrite (library-library-proof lib) compare delta '(1 2 1))))
   (library-library-transport-argument lib nonnegative-difference compare 1)))

(defun t2-products-strict-neq (lib strict integers)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
     ((literal (proof-step-first strict)) (parts (proof-list-of-length literal 3)))
     (let* ((a (cadr parts)) (b (caddr parts)) (same (proof-eq a b)))
       (proof-with-checked-results
        ((assumed (proof-proof-assume proof same t))
         (contradiction (proof-proof-rewrite proof strict assumed '(1 1)))
         (type (t2-products-library-type-of lib b integers))
         (reflexive (library-library-cite lib "WEAK-REFLEXIVE" (list b) (list type)))
         (cut (proof-proof-cut proof contradiction reflexive)))
        (proof-proof-front proof cut (proof-neg same)))))))

(defun t2-products-flip-neq (lib distinct)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
     ((literal (proof-step-first distinct))
      (equality (proof-term-at literal 1))
      (parts (if (integerp equality)
                 '(:failure "failure" "")
               (proof-list-of-length (cdr equality) 2)))
      (reversed (proof-eq (cadr parts) (car parts)))
      (assumed (proof-proof-assume proof reversed t))
      (symmetric (proof-proof-symmetric proof assumed))
      (contradiction (proof-proof-cut proof symmetric distinct)))
     (proof-proof-front proof contradiction (proof-neg reversed)))))

(defun t2-products-weak-endpoints (bound)
  (proof-with-checked-results
   ((literal (proof-step-first bound))
    (parts (proof-list-of-length literal 2)))
   (proof-list-of-length (cadr parts) 3)))

(defun t2-products-strict-from-weak (lib bound distinct integers)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results ((parts (t2-products-weak-endpoints bound)))
      (let* ((upper (cadr parts)) (lower (caddr parts)) (delta (library-diff upper lower)))
        (proof-with-checked-results
         ((comparison (library-library-axiom lib "<-ON-OTHERS" (list upper lower)))
          (nonnegative-delta (proof-proof-rewrite proof bound comparison '(1 1)))
          (zero (proof-eq delta *proof-zero*))
          (same (t2-products-library-linear-equal lib (library-plus delta lower) upper integers))
          (assumed (proof-proof-assume proof zero t))
          (same (proof-proof-rewrite proof same assumed '(1 1 1)))
          (lower-type (t2-products-library-type-of lib lower integers))
          (add-zero (library-library-cite lib "ADD-ZERO-LEFT" (list lower) (list lower-type)))
          (same (proof-proof-rewrite proof same add-zero '(1 1)))
          (cut (proof-proof-cut proof same distinct))
          (delta-nonzero (proof-proof-front proof cut (proof-neg zero)))
          (delta-type (t2-products-library-type-of lib delta integers))
          (pos-delta (library-library-cite lib "POSITIVE-FROM-NONZERO" (list delta)
                                          (list delta-type nonnegative-delta delta-nonzero)))
          (comparison (t2-products-library-comparison lib lower upper integers)))
         (proof-proof-transport proof pos-delta comparison))))))

(defun t2-products-positive-from-nonzero (lib)
  (if (t2-products-fact-present-p lib "POSITIVE-FROM-NONZERO")
      lib
    (let* ((proof (library-library-proof lib))
           (x *library-x*)
           (pos (library-positive x))
           (zero (proof-eq x *proof-zero*)))
      (proof-with-checked-results
       ((ints (library-library-ints lib (list x)))
        (trichotomy (library-library-axiom lib "TRICHOTOMY" (list x)))
        (parts (t2-guarded-selectors-library-conjunct lib trichotomy))
        (number (t2-products-library-number lib x ints))
        (signs (t2-products-library-modus-ponens lib (car parts) number))
        (not-pos (proof-proof-assume proof pos nil))
        (nonzero (proof-proof-assume proof zero nil))
        (neg-case (t2-guarded-selectors-simplify-first proof signs (list not-pos nonzero) nil))
        (opposite (t2-products-library-comparison lib x *proof-zero* ints))
        (identity (t2-products-library-linear-equal lib (library-diff *proof-zero* x) (library-minus x) ints))
        (opposite (proof-proof-rewrite proof opposite identity '(1 2 2)))
        (strictly-negative (proof-proof-transport proof neg-case opposite))
        (negative (library-lt x *proof-zero*))
        (not-negative (proof-proof-assume proof negative nil))
        (contradiction (proof-proof-cut proof strictly-negative not-negative))
        (claim (proof-proof-front proof contradiction pos)))
       (library-library-lemma lib "POSITIVE-FROM-NONZERO" pos claim
                              (list (proof-neg (library-integer x)) negative zero))))))

(defun t2-products-numeric-add-zero (lib number)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
     ((literal (proof-step-first number))
      (term (proof-term-at literal 1))
      (axiom (library-library-axiom lib "UNICITY-OF-0" (list term)))
      (right (proof-rewritten-term axiom))
      (opened (proof-proof-unfold proof right))
      (body (proof-rewritten-term opened))
      (selected (proof-proof-select proof body number)))
     (proof-proof-chain proof axiom (list opened selected)))))

(defun t2-products-unique-inverse (lib value candidate zero candidate-number)
  (let* ((proof (library-library-proof lib)) (inverse (library-minus value)))
    (proof-with-checked-results
     ((number (library-library-cite lib "NEGATION-NUMBER" (list value) nil))
      (add-zero (t2-products-numeric-add-zero lib number))
      (commute (library-library-axiom lib "COMMUTATIVITY-OF-+" (list inverse *proof-zero*)))
      (add-zero (proof-proof-chain proof commute (list add-zero)))
      (reversed (proof-proof-symmetric proof add-zero))
      (zero-reversed (proof-proof-symmetric proof zero))
      (identity (proof-proof-rewrite proof reversed zero-reversed '(1 2 2)))
      (associate (library-library-axiom lib "ASSOCIATIVITY-OF-+" (list inverse value candidate)))
      (associate (proof-proof-symmetric proof associate))
      (identity (proof-proof-chain proof identity (list associate)))
      (commute (library-library-axiom lib "COMMUTATIVITY-OF-+" (list inverse value)))
      (axiom (library-library-axiom lib "INVERSE-OF-+" (list value)))
      (cancel (proof-proof-chain proof commute (list axiom)))
      (identity (proof-proof-rewrite proof identity cancel '(1 2 1)))
      (final-zero (t2-products-numeric-add-zero lib candidate-number)))
     (proof-proof-chain proof identity (list final-zero)))))

(defun t2-products-product-zero-lemma (lib)
  (let* ((proof (library-library-proof lib))
         (z *library-z*)
         (zero *proof-zero*)
         (term (t2-products-times z zero)))
    (proof-with-checked-results
     ((double (library-library-axiom lib "DISTRIBUTIVITY" (list z zero zero)))
      (compute (proof-proof-compute proof (library-plus zero zero) 0))
      (double (proof-proof-rewrite proof double compute '(1 1 2)))
      (cancel (library-library-axiom lib "INVERSE-OF-+" (list term)))
      (assoc (library-library-axiom lib "ASSOCIATIVITY-OF-+" (list term term (library-minus term))))
      (reversed (proof-proof-symmetric proof double))
      (assoc (proof-proof-rewrite proof assoc reversed '(1 1 1)))
      (assoc (proof-proof-rewrite proof assoc cancel '(1 2 2)))
      (closure (library-library-axiom lib "CLOSURE" (list z zero)))
      (parts (t2-guarded-selectors-library-conjunct lib closure))
      (remaining (t2-guarded-selectors-library-conjunct lib (cadr parts)))
      (commute (library-library-axiom lib "COMMUTATIVITY-OF-+" (list term zero)))
      (add-zero (t2-products-numeric-add-zero lib (car remaining)))
      (right-zero (proof-proof-chain proof commute (list add-zero)))
      (assoc (proof-proof-chain proof assoc (list right-zero)))
      (reversed (proof-proof-symmetric proof assoc))
      (identity (proof-proof-chain proof reversed (list cancel))))
     (library-library-lemma lib "PRODUCT-ZERO" (proof-eq term zero) identity nil))))

(defun t2-products-product-zero (lib factor)
  (proof-with-checked-results
   ((lib (if (t2-products-fact-present-p lib "PRODUCT-ZERO") lib (t2-products-product-zero-lemma lib)))
    (step (proof-proof-fact (library-library-proof lib) (proof-sym "SELF-PRODUCT-ZERO" "ACL2")
                            (list (list *library-z* factor)))))
   (cons step lib)))

(defun t2-products-multiplication-identities (lib)
  (let* ((proof (library-library-proof lib))
         (x *library-x*) (z *library-z*)
         (product (t2-products-times z x))
         (other (t2-products-times z (library-minus x))))
    (proof-with-checked-results
     ((ints (library-library-ints lib (list x z)))
      (distribute (library-library-axiom lib "DISTRIBUTIVITY" (list z x (library-minus x))))
      (zero (proof-proof-symmetric proof distribute))
      (cancel (library-library-axiom lib "INVERSE-OF-+" (list x)))
      (zero (proof-proof-rewrite proof zero cancel '(1 2 2)))
      (product-zero (t2-products-product-zero lib z))
      (lib (cdr product-zero))
      (proof (library-library-proof lib))
      (zero (proof-proof-chain proof zero (list (car product-zero))))
      (number (t2-products-library-number lib other ints))
      (inverse (t2-products-unique-inverse lib product other zero number))
      (reversed (proof-proof-symmetric proof inverse)))
     (library-library-lemma lib "NEGATE-PRODUCT" (proof-eq other (library-minus product)) reversed
                            (library-guards (list (library-integer x) (library-integer z)))))))

(defun t2-products-product-one (lib term number)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
     ((commute (library-library-axiom lib "COMMUTATIVITY-OF-*" (list term *proof-one*)))
      (unit (library-library-axiom lib "UNICITY-OF-1" (list term)))
      (identity (proof-proof-chain proof commute (list unit)))
      (right (proof-rewritten-term identity))
      (simplified (t2-guarded-selectors-simplify proof right (list number) (list (proof-sym "FIX" "ACL2")))))
     (proof-proof-chain proof identity (list simplified)))))

(defun t2-products-product-difference (lib factor upper lower integers)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
     ((step (library-library-axiom lib "DISTRIBUTIVITY" (list factor upper (library-minus lower))))
      (lower-type (t2-products-library-type-of lib lower integers))
      (factor-type (t2-products-library-type-of lib factor integers))
      (negated (proof-proof-use proof (proof-sym "SELF-NEGATE-PRODUCT" "ACL2")
                                (list (list *library-x* lower) (list *library-z* factor))
                                (list lower-type factor-type))))
     (proof-proof-rewrite proof step negated '(1 2 2)))))

(defun t2-products-product-positive (lib a b integers a-positive b-positive)
  (proof-with-checked-results
   ((a-rational (t2-products-library-rational lib a integers))
    (b-rational (t2-products-library-rational lib b integers)))
   (library-library-cite lib "POSITIVE-PRODUCT" (list a b)
                         (list a-rational b-rational a-positive b-positive))))

(defun t2-products-build-product-order (lib)
  (if (t2-products-fact-present-p lib "LESS-PRODUCT")
      lib
    (let* ((x *library-x*) (y *library-y*) (z *library-z*)
           (xy (library-lt x y))
           (difference (library-diff y x))
           (lower-product (t2-products-times z x))
           (upper-product (t2-products-times z y)))
      (proof-with-checked-results
       ((lib (t2-products-positive-from-nonzero lib))
        (lib (t2-products-multiplication-identities lib))
        (proof (library-library-proof lib))
        (ints (library-library-ints lib (list x y z)))
        (positive-factor (proof-proof-assume proof (library-positive z) t))
        (distributive (t2-products-product-difference lib z y x ints))
        (result-delta (proof-rewritten-term distributive))
        (comparison (t2-products-library-comparison lib lower-product upper-product ints))
        (assumed (proof-proof-assume proof xy t))
        (delta-order (t2-products-library-comparison lib x y ints))
        (pos-delta (proof-proof-rewrite proof assumed delta-order '(1)))
        (scaled (t2-products-product-positive lib z difference ints positive-factor pos-delta))
        (scaled (proof-proof-rewrite proof scaled distributive '(1 2)))
        (strict (proof-proof-transport proof scaled comparison))
        (conditions (library-guards (list (library-integer x) (library-integer y)
                                          (library-integer z) (library-positive z))))
        (claim (proof-step-first strict))
        (lib (library-library-lemma lib "LESS-PRODUCT" claim strict (append conditions (list (proof-neg xy)))))
        (proof (library-library-proof lib))
        (weak (proof-proof-assume proof (library-lt y x) nil))
        (difference-order (library-library-axiom lib "<-ON-OTHERS" (list y x)))
        (nonnegative-delta (proof-proof-rewrite proof weak difference-order '(1 1)))
        (zero (proof-eq difference *proof-zero*))
        (nonzero (proof-proof-assume proof zero nil))
        (difference-type (t2-products-library-type-of lib difference ints))
        (pos-delta (library-library-cite lib "POSITIVE-FROM-NONZERO" (list difference)
                                        (list difference-type nonnegative-delta nonzero)))
        (scaled (t2-products-product-positive lib z difference ints positive-factor pos-delta))
        (positive-result (proof-proof-rewrite proof scaled distributive '(1 2)))
        (type (t2-products-library-type-of lib result-delta ints))
        (positive-case (library-library-cite lib "POSITIVE-NONNEGATIVE" (list result-delta)
                                             (list type positive-result)))
        (reversed (proof-proof-symmetric proof distributive))
        (is-zero (proof-proof-assume proof zero t))
        (zero-equation (proof-proof-rewrite proof reversed is-zero '(1 2 2)))
        (product-zero (t2-products-product-zero lib z))
        (lib (cdr product-zero))
        (proof (library-library-proof lib))
        (zero-equation (proof-proof-chain proof zero-equation (list (car product-zero))))
        (axiom (library-library-axiom lib "ZERO" nil))
        (reversed (proof-proof-symmetric proof zero-equation))
        (zero-case (proof-proof-rewrite proof axiom reversed '(1 1 1)))
        (zero-case (proof-proof-tidy proof zero-case))
        (nonnegative-product (proof-proof-cases proof zero zero-case positive-case))
        (negative-result (library-library-axiom lib "<-ON-OTHERS" (list upper-product lower-product)))
        (weak-product (library-library-transport-argument lib nonnegative-product negative-result 1))
        (claim (proof-step-first weak-product))
        (lib (library-library-lemma lib "WEAK-PRODUCT" claim weak-product (append conditions (list (library-lt y x)))))
        (proof (library-library-proof lib))
        (strict-comparison (library-lt lower-product upper-product))
        (not-xy (proof-proof-assume proof xy nil))
        (converse (library-library-cite lib "WEAK-PRODUCT" (list y x z)
                                      (list (cadr ints) (car ints) (caddr ints) positive-factor not-xy)))
        (assumed (proof-proof-assume proof strict-comparison t))
        (cut (proof-proof-cut proof assumed converse))
        (cancel (proof-proof-front proof cut xy)))
       (library-library-lemma lib "LESS-CANCEL-PRODUCT" xy cancel
                              (append conditions (list (proof-neg strict-comparison))))))))

(defun t2-products-scale (lib bound positive-factor integers weak)
  (proof-with-checked-results
   ((parts (if weak
               (t2-products-weak-endpoints bound)
             (proof-with-checked-results ((literal (proof-step-first bound)))
               (proof-list-of-length literal 3))))
    (lower (if weak (caddr parts) (cadr parts)))
    (upper (if weak (cadr parts) (caddr parts)))
    (literal (proof-step-first positive-factor))
    (factor (proof-term-at literal 2))
    (arguments (list lower upper factor))
    (types (t2-guarded-selectors-type-arguments lib arguments integers)))
   (library-library-cite lib (if weak "WEAK-PRODUCT" "LESS-PRODUCT") arguments
                         (append types (list positive-factor bound)))))

(defun t2-products-cancel-scale (lib strict positive-factor integers)
  (proof-with-checked-results
   ((literal (proof-step-first strict))
    (parts (proof-list-of-length literal 3))
    (lower (cadr parts))
    (upper (caddr parts))
    (literal (proof-step-first positive-factor))
    (factor (proof-term-at literal 2))
    (left-factor (proof-term-at lower 1))
    (right-factor (proof-term-at upper 1)))
   (if (not (and (equal left-factor right-factor) (equal right-factor factor)))
       '(:failure "recipe-mismatch" "")
     (proof-with-checked-results
      ((a (proof-term-at lower 2))
       (b (proof-term-at upper 2))
       (arguments (list a b factor))
       (types (t2-guarded-selectors-type-arguments lib arguments integers)))
      (library-library-cite lib "LESS-CANCEL-PRODUCT" arguments
                            (append types (list positive-factor strict)))))))

(defun t2-products-negate-product (lib a b integers)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
     ((b-type (t2-products-library-type-of lib b integers))
      (a-type (t2-products-library-type-of lib a integers)))
     (proof-proof-use proof (proof-sym "SELF-NEGATE-PRODUCT" "ACL2")
                      (list (list *library-x* b) (list *library-z* a))
                      (list b-type a-type)))))

(defun t2-products-discrete-step (lib strict integers)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
     ((literal (proof-step-first strict))
      (parts (proof-list-of-length literal 3))
      (lower (cadr parts))
      (upper (caddr parts))
      (difference (library-diff upper lower))
      (comparison (t2-products-library-comparison lib lower upper integers))
      (pos-delta (proof-proof-rewrite proof strict comparison '(1)))
      (term (proof-ite (library-integer difference) (library-positive difference) *proof-false*))
      (type (t2-products-library-type-of lib difference integers))
      (selection (proof-proof-select proof term type))
      (premise (proof-proof-transport proof pos-delta selection))
      (discrete (proof-proof-fact proof "integer-discrete" (list (list *library-x* difference))))
      (successor (t2-products-library-modus-ponens lib discrete premise))
      (comparison (library-library-axiom lib "<-ON-OTHERS" (list difference *proof-one*)))
      (successor (proof-proof-rewrite proof successor comparison '(1 1))))
     (t2-products-library-weak-from-difference lib (library-plus *proof-one* lower) upper successor integers))))
