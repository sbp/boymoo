(in-package "BOYMOO-PROVER")

(set-verify-guards-eagerness 0)

(defun t2-subtraction-nonnegative-difference (lib bound)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
     ((literal (proof-step-first bound))
      (negative (proof-list-of-length literal 2))
      (comparison (proof-list-of-length (cadr negative) 3))
      (axiom (library-library-axiom lib "<-ON-OTHERS" (cdr comparison)))
      (step (proof-proof-rewrite proof bound axiom '(1 1))))
     (proof-proof-tidy proof step))))

(defun t2-subtraction-build-count-subtraction (lib name)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
     ((integers (library-library-ints lib (list *library-x* *library-y*)))
      (positive-y (proof-proof-assume proof (library-positive *library-y*) t))
      (enough (proof-proof-assume proof (library-lt *library-x* *library-y*) nil))
      (positive-x (t2-arithmetic-arithmetic-compare-chain lib positive-y enough integers))
      (before (t2-arithmetic-natural-from-positive lib (car integers) positive-x))
      (remainder (library-diff *library-x* *library-y*))
      (remainder-int (t2-arithmetic-arithmetic-type-of lib remainder integers))
      (bound (t2-subtraction-nonnegative-difference lib enough))
      (after (t2-arithmetic-natural-from-sign lib remainder-int bound))
      (smaller (t2-arithmetic-less-from-difference lib remainder *library-x* positive-y integers))
      (after-count (t2-arithmetic-count-natural lib after))
      (lib (cdr after-count))
      (smaller (library-library-transport-argument lib smaller (car after-count) 1))
      (before-count (t2-arithmetic-count-natural lib before))
      (lib (cdr before-count))
      (smaller (library-library-transport-argument lib smaller (car before-count) 2))
      (order (t2-arithmetic-arithmetic-ordinal-comparison lib (list *library-count* remainder)
                                                         (list *library-count* *library-x*) nil))
      (step (proof-proof-transport (library-library-proof lib) smaller order))
      (claim (proof-step-first step)))
     (library-library-lemma lib name claim step
                            (append (library-guards (list (library-integer *library-x*)
                                                          (library-integer *library-y*)
                                                          (library-positive *library-y*)))
                                    (list (library-lt *library-x* *library-y*)))))))

(defun t2-subtraction-count-subtraction (lib int-whole int-part positive-part bound)
  (let ((name "COUNT-SUBTRACTION-DECREASE"))
    (proof-with-checked-results
     ((lib (if (assoc-equal (proof-sym "SELF-COUNT-SUBTRACTION-DECREASE" "ACL2")
                           (proof-proof-facts (library-library-proof lib)))
               lib
             (t2-subtraction-build-count-subtraction lib name)))
      (whole-type (proof-step-first int-whole))
      (whole (proof-term-at whole-type 1))
      (part-type (proof-step-first int-part))
      (part (proof-term-at part-type 1))
      (step (library-library-cite lib name (list whole part)
                                  (list int-whole int-part positive-part bound))))
     (cons step lib))))

(defun t2-subtraction-nfix-nonzero (lib value distinct)
  (proof-with-checked-results
   ((lib (t2-arithmetic-arithmetic-build-countdowns lib))
    (lib (t2-products-positive-from-nonzero lib))
    (proof (library-library-proof lib))
    (natural (list *library-natp* value))
    (opened (library-library-cite lib "LIBRARY-NFIX" (list value) nil))
    (not-natural (proof-proof-assume proof natural nil))
    (zero-case (t2-arithmetic-simplify proof (list *library-nfix* value) (list not-natural)
                                       (list *library-nfix*)))
    (at-zero (proof-proof-chain proof opened (list zero-case)))
    (cut (proof-proof-cut proof at-zero distinct))
    (nat (proof-proof-front proof cut natural))
    (equation (t2-arithmetic-arithmetic-known-nfix lib (list *t2-arithmetic-nfix* value) nat))
    (unfixed (proof-proof-rewrite proof distinct equation '(1 1 1)))
    (unfixed-distinct (proof-proof-tidy proof unfixed))
    (integral (library-library-cite lib "NATURAL-INTEGER" (list value) (list nat)))
    (bound (library-library-cite lib "NATURAL-NONNEGATIVE" (list value) (list nat)))
    (positive-value (library-library-cite lib "POSITIVE-FROM-NONZERO" (list value)
                                            (list integral bound unfixed-distinct))))
   (cons (list integral positive-value) lib)))

(defun t2-subtraction-ifix-comparison (lib whole part positive-part int-part bound)
  (proof-with-checked-results
   ((lib (t2-arithmetic-arithmetic-build-countdowns lib))
    (proof (library-library-proof lib))
    (fixed (list *t2-arithmetic-ifix* whole))
    (fixed-int (t2-arithmetic-arithmetic-type-of lib fixed nil))
    (positive-fixed (t2-arithmetic-arithmetic-compare-chain lib positive-part bound
                                                            (list int-part fixed-int)))
    (opened (proof-proof-unfold proof fixed))
    (equation (proof-step-first opened))
    (body (proof-term-at equation 2))
    (if-false (proof-proof-if-false proof body))
    (zero-case (proof-proof-chain proof opened (list if-false)))
    (at-zero (proof-proof-rewrite proof positive-fixed zero-case '(1 2)))
    (zero (library-library-axiom lib "ZERO" nil))
    (cut (proof-proof-cut proof at-zero zero))
    (int-whole (proof-proof-front proof cut (library-integer whole)))
    (selected (proof-proof-select proof body int-whole))
    (identity (proof-proof-chain proof opened (list selected)))
    (unfixed (proof-proof-rewrite proof bound identity '(1 1 1)))
    (unfixed (proof-proof-tidy proof unfixed))
    (claim (proof-step-first unfixed)))
   (if (equal claim (library-le part whole))
       (cons (list int-whole unfixed) lib)
     '(:failure "recipe-mismatch" ""))))

(defun t2-subtraction-part-evidence (lib part hypotheses replies)
  (descent-let*
   ((int-part (t2-phase-hypotheses-lookup hypotheses (library-integer part) replies))
    (positive-part (t2-phase-hypotheses-lookup (cdr int-part) (library-positive part) replies))
    (hypotheses (cdr positive-part)))
   (cond
    ((and (car int-part) (car positive-part))
     (cons (list (car int-part) (car positive-part) hypotheses) lib))
    ((proof-is-call part *proof-quote*)
     (proof-with-checked-results
      ((integral (t2-arithmetic-arithmetic-type-of lib part nil))
       (positive (t2-arithmetic-arithmetic-prove lib (library-positive part) nil nil)))
      (cons (list integral positive hypotheses) lib)))
    (t
     (descent-let*
      ((distinct (t2-phase-hypotheses-require
                  hypotheses
                  (proof-neg (proof-eq (list *t2-arithmetic-nfix* part) *proof-zero*))
                  replies))
       (evidence (t2-subtraction-nfix-nonzero lib part (car distinct)))
       (hypotheses (t2-phase-hypotheses-after-library (cdr distinct) lib (cdr evidence))))
      (cons (list (caar evidence) (cadar evidence) hypotheses) (cdr evidence)))))))

(defun t2-subtraction-whole-evidence (lib whole part positive-part int-part hypotheses replies)
  (descent-let* ((bound (t2-phase-hypotheses-lookup hypotheses (library-le part whole) replies)))
    (if (car bound)
        (descent-let* ((int-whole (t2-phase-hypotheses-require
                                    (cdr bound) (library-integer whole) replies)))
          (cons (list (car int-whole) (car bound) (cdr int-whole)) lib))
      (descent-let*
       ((fixed (t2-phase-hypotheses-require
                (cdr bound) (library-le part (list *t2-arithmetic-ifix* whole)) replies))
        (evidence (t2-subtraction-ifix-comparison lib whole part positive-part int-part (car fixed)))
        (hypotheses (t2-phase-hypotheses-after-library (cdr fixed) lib (cdr evidence))))
       (cons (list (caar evidence) (cadar evidence) hypotheses) (cdr evidence))))))

(defun t2-subtraction-subtraction-decrease-query (lib whole part hypotheses replies)
  (descent-let*
   ((part-evidence (t2-subtraction-part-evidence lib part hypotheses replies))
    (lib (cdr part-evidence))
    (int-part (caar part-evidence))
    (positive-part (cadar part-evidence))
    (whole-evidence (t2-subtraction-whole-evidence lib whole part positive-part int-part
                                                 (caddar part-evidence) replies))
    (lib (cdr whole-evidence))
    (int-whole (caar whole-evidence))
    (bound (cadar whole-evidence))
    (result (t2-subtraction-count-subtraction lib int-whole int-part positive-part bound))
    (hypotheses (t2-phase-hypotheses-after-library (caddar whole-evidence) lib (cdr result))))
   (cons (list (car result) hypotheses) (cdr result))))

(defun t2-subtraction-subtraction-decrease (lib whole part hypotheses)
  (t2-subtraction-subtraction-decrease-query lib whole part hypotheses :plain))
