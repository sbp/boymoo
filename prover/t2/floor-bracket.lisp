(in-package "BOYMOO-PROVER")
(set-verify-guards-eagerness 0)

(defun t2-floor-bracket-first-at (step index)
  (proof-with-checked-results
    ((literal (proof-step-first step)))
    (proof-term-at literal index)))

(defun t2-floor-bracket-lemma (lib name step conditions)
  (proof-with-checked-results
    ((claim (proof-step-first step)))
    (library-library-lemma lib name claim step conditions)))

(defun t2-floor-bracket-bracket (lib)
  (let* ((proof (library-library-proof lib))
         (x *library-x*)
         (y *library-y*)
         (args (list x y))
         (cases (t2-quotient-rounding-quotient-cases-init lib x y))
         (ratio (t2-quotient-rounding-quotient-cases-ratio cases))
         (rat-test (t2-quotient-rounding-quotient-cases-rat cases))
         (integral-test (t2-quotient-rounding-quotient-cases-integral cases))
         (floor (list *t2-floor-floor* x y))
         (zero *proof-zero*)
         (one *proof-one*))
    (proof-with-checked-results
      ((integer-ratio (proof-proof-assume proof integral-test t))
       (rat (proof-proof-assume proof rat-test t))
       (not-integer (proof-proof-assume proof integral-test nil))
       (direction (library-library-cite lib "NONINTEGER-FLOOR-INTERVAL" (list ratio)
                                        (list rat not-integer)))
       (unit (library-library-cite lib "FLOOR-UNIT-DIVISOR" args nil))
       (back (proof-proof-symmetric proof unit))
       (direction (proof-proof-rewrite-first proof direction back))
       (parts (t2-power-conjuncts lib direction 3))
       (integral (first parts))
       (low (second parts))
       (commuted (library-library-axiom lib "COMMUTATIVITY-OF-+" (list one floor)))
       (high (proof-proof-rewrite proof (third parts) commuted '(1 2)))
       (rat-literal (proof-step-first rat))
       (integer-literal (proof-step-first integer-ratio))
       (lib (t2-floor-bracket-lemma lib "NONINTEGER-QUOTIENT-FLOOR-LOWER" low
                                    (list (proof-neg rat-literal) integer-literal)))
       (proof (library-library-proof lib))
       (opposite (t2-order-opposite-order lib low))
       (fractional (t2-power-join lib (list integral opposite high)))
       (cases (t2-quotient-rounding-quotient-cases-init lib x y))
       (exact (t2-quotient-rounding-quotient-cases-value cases *t2-floor-floor*
                                                        (list rat integer-ratio)))
       (integral (library-library-transport-argument lib integer-ratio exact 1))
       (irreflexive (t2-order-irreflexive lib ratio))
       (back (proof-proof-symmetric proof exact))
       (low (proof-proof-rewrite proof irreflexive back '(1 1 2)))
       (less (t2-arithmetic-arithmetic-prove lib (library-lt zero one) nil nil))
       (translation (library-library-cite lib "FIELD-ORDER-TRANSLATION" (list zero one ratio) nil))
       (high (proof-proof-transport proof less translation))
       (number (t2-arithmetic-number lib ratio (list integer-ratio)))
       (add-zero (t2-arithmetic-arithmetic-numeric-add-zero lib number))
       (high (proof-proof-rewrite proof high add-zero '(1 1)))
       (commuted (library-library-axiom lib "COMMUTATIVITY-OF-+" (list one ratio)))
       (high (proof-proof-rewrite proof high commuted '(1 2)))
       (back (proof-proof-symmetric proof exact))
       (high (proof-proof-rewrite proof high back '(1 2 1)))
       (whole (t2-power-join lib (list integral low high)))
       (step (proof-proof-cases proof integral-test whole fractional))
       (conditions (list (proof-neg rat-literal)))
       (lib (t2-floor-bracket-lemma lib "RATIONAL-QUOTIENT-FLOOR-BRACKET" step conditions))
       (proof (library-library-proof lib))
       (bad-ratio (proof-proof-assume proof rat-test nil))
       (cases (t2-quotient-rounding-quotient-cases-init lib x y))
       (absent (t2-quotient-rounding-quotient-cases-value cases *t2-floor-floor* (list bad-ratio)))
       (integer-zero (t2-arithmetic-arithmetic-type-of lib zero nil))
       (integral (library-library-transport-argument lib integer-zero absent 1))
       (parts (t2-arithmetic-arithmetic-conjunct lib step))
       (full (proof-proof-cases proof rat-test (first parts) integral))
       (lib (library-library-lemma lib "FLOOR-IS-INTEGER" (library-integer floor) full nil))
       (proof (library-library-proof lib))
       (bounds (library-library-cite lib "RATIONAL-QUOTIENT-FLOOR-BRACKET" args (list rat)))
       (parts (t2-power-conjuncts lib bounds 3))
       (translation (library-library-cite lib "FIELD-ORDER-TRANSLATION"
                                           (list ratio (library-plus floor one) *proof-neg-one*) nil))
       (upper (proof-proof-transport proof (third parts) translation))
       (upper-bound (t2-floor-bracket-first-at upper 2))
       (linear (t2-arithmetic-linear-equal lib upper-bound floor (list (first parts))))
       (upper (proof-proof-rewrite proof upper linear '(1 2)))
       (step (t2-power-join lib (list upper (second parts)))))
      (t2-floor-bracket-lemma lib "FLOOR-WITHIN-ONE-OF-QUOTIENT" step conditions))))

(defun t2-floor-bracket-rational-mod-at-zero (floor-equals-zero lib opened x-type input-type)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
      ((step (proof-proof-rewrite proof opened floor-equals-zero '(1 2 2 1 1)))
       (zero (library-library-cite lib "REMAINDER-WITH-ZERO-QUOTIENT" (list *library-x* *library-y*) nil))
       (fix (t2-field-numeric-fix lib *library-x* x-type))
       (step (proof-proof-chain proof step (list zero fix))))
      (library-library-transport-argument lib input-type step 1))))

(defun t2-floor-bracket-rational-mod (lib cases i-floor opened)
  (let* ((proof (library-library-proof lib))
         (x *library-x*)
         (y *library-y*)
         (rat (t2-quotient-rounding-quotient-cases-rat cases)))
    (proof-with-checked-results
      ((rat-head (proof-term-at rat 0))
       (input-type (proof-proof-assume proof (list rat-head x) t))
       (x-type (t2-order-number-from-rational lib input-type))
       (nonrational (proof-proof-assume proof rat nil))
       (rational-ratio (proof-proof-assume proof rat t))
       (quotient (t2-quotient-rounding-quotient-cases-ratio cases))
       (floor (t2-floor-bracket-first-at i-floor 1))
       (zero (proof-eq quotient *proof-zero*))
       (inverse-number (t2-order-number-from-rational lib rational-ratio))
       (nonzero (proof-proof-assume proof zero nil))
       (multiplication (t2-quotient-rounding-cancel-nonzero-divisor lib x y nonzero))
       (lib (cdr multiplication))
       (proof (library-library-proof lib))
       (unit (t2-field-inverse lib inverse-number nonzero))
       (result (t2-field-cancel-inverse-on-right lib y quotient unit))
       (result (proof-proof-symmetric proof result))
       (commuted (library-library-axiom lib "COMMUTATIVITY-OF-*" (list y quotient)))
       (result (proof-proof-rewrite proof result commuted '(1 2 1)))
       (result (proof-proof-rewrite proof result (car multiplication) '(1 2 1)))
       (fix (t2-field-numeric-fix lib x x-type))
       (result (proof-proof-rewrite proof result fix '(1 2 1)))
       (expression (t2-floor-bracket-first-at result 2))
       (rat-expression (t2-order-rational lib expression (list rational-ratio input-type)))
       (rat-y (library-library-transport-argument lib rat-expression result 1))
       (floor-type (t2-arithmetic-rational lib floor (list i-floor)))
       (rat-product (t2-order-rational lib (t2-products-times floor (t2-field-fixed y))
                                       (list floor-type rat-y)))
       (remove-fix (t2-field-remove-fixed-operand lib *proof-times* floor y))
       (rat-product (proof-proof-rewrite proof rat-product remove-fix '(1 1)))
       (body (t2-floor-bracket-first-at opened 2))
       (mod-type (t2-order-rational lib body (list input-type rat-product)))
       (nonzero-case (library-library-transport-argument lib mod-type opened 1))
       (zero-evidence (proof-proof-assume proof zero t))
       (integer-zero (t2-arithmetic-arithmetic-type-of lib *proof-zero* nil))
       (reverse-zero (proof-proof-symmetric proof zero-evidence))
       (at-integer (proof-proof-rewrite proof integer-zero reverse-zero '(1 1)))
       (case-value (t2-quotient-rounding-quotient-cases-value cases *t2-floor-floor*
                                                             (list rational-ratio at-integer)))
       (zero-floor (proof-proof-chain proof case-value (list zero-evidence)))
       (zero-case (t2-floor-bracket-rational-mod-at-zero zero-floor lib opened x-type input-type))
       (rational-case (proof-proof-cases proof zero zero-case nonzero-case))
       (nonrat-floor (t2-quotient-rounding-quotient-cases-value cases *t2-floor-floor*
                                                               (list nonrational)))
       (nonrational-case
        (t2-floor-bracket-rational-mod-at-zero nonrat-floor lib opened x-type input-type))
       (step (proof-proof-cases proof rat rational-case nonrational-case))
       (input-condition (proof-step-first input-type)))
      (t2-floor-bracket-lemma lib "RATIONAL-DIVIDEND-MOD-TYPE" step
                             (list (proof-neg input-condition))))))

(defun t2-floor-bracket-signed-divisor (lib known-sign)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
      ((literal (proof-step-first known-sign))
       (arguments (if (integerp literal)
                      '(:failure "failure" "")
                    (cdr literal)))
       (fixed-sign (library-library-cite lib "FIELD-FIX-ORDER" arguments nil))
       (left (proof-term-at literal 1))
       (position (if (equal left *proof-zero*) 1 2))
       (number (t2-arithmetic-number lib *proof-zero* nil))
       (fix (t2-field-numeric-fix lib *proof-zero* number))
       (fixed-sign (proof-proof-rewrite proof fixed-sign fix (list 1 2 position)))
       (fixed-sign (proof-proof-rewrite proof known-sign fixed-sign '(1)))
       (nonzero (t2-order-distinct lib fixed-sign))
       (nonzero (if (equal position 1) (t2-products-flip-neq lib nonzero) nonzero))
       (evidence (t2-power-numeric-from-fixed-nonzero lib *library-y* nonzero)))
      (list nonzero (first evidence) (second evidence)))))

(defun t2-floor-bracket-remainder-identity (lib q f known-sign)
  (let ((proof (library-library-proof lib))
        (x *library-x*)
        (y *library-y*))
    (proof-with-checked-results
      ((sign (t2-floor-bracket-signed-divisor lib known-sign))
       (multiplied (t2-quotient-rounding-cancel-divisor lib x y (first sign)))
       (modulus (proof-proof-unfold proof (list *t2-quotient-rounding-mod* x y)))
       (body (t2-floor-bracket-first-at modulus 2))
       (second (proof-term-at body 2))
       (commuted (library-library-axiom lib "COMMUTATIVITY-OF-+" (list x second)))
       (remove-fix (t2-field-remove-fixed-operand lib *proof-plus* second x))
       (insert-fix (proof-proof-symmetric proof remove-fix))
       (commuted-fix (library-library-axiom lib "COMMUTATIVITY-OF-+" (list second (t2-field-fixed x))))
       (completed (proof-proof-chain proof commuted (list insert-fix commuted-fix)))
       (modulus (proof-proof-chain proof modulus (list completed)))
       (back (proof-proof-symmetric proof multiplied))
       (modulus (proof-proof-rewrite proof modulus back '(1 2 1)))
       (commuted (library-library-axiom lib "COMMUTATIVITY-OF-*" (list q y)))
       (modulus (proof-proof-rewrite proof modulus commuted '(1 2 1)))
       (commuted (library-library-axiom lib "COMMUTATIVITY-OF-*" (list f y)))
       (modulus (proof-proof-rewrite proof modulus commuted '(1 2 2 1)))
       (scaled (t2-euclid-scale-difference lib y q f))
       (back (proof-proof-symmetric proof scaled))
       (step (proof-proof-chain proof modulus (list back))))
      (list step (second sign) (third sign)))))

(defun t2-floor-bracket-remainder-bound (lib delta rat-delta ratio numeric different pos
                                         increasing bound value)
  (let ((y *library-y*))
    (proof-with-checked-results
      ((rational (t2-arithmetic-rational lib value nil))
       (order (library-library-cite lib "RATIONAL-OPERANDS-SIGNED-ORDER" (list delta value y)
                                    (list rat-delta rational numeric different)))
       (order (t2-input-fields-select lib order pos))
       (value-slot (if increasing 2 1))
       (unit
        (if (equal value *proof-zero*)
            (t2-products-product-zero lib y)
          (proof-with-checked-results
            ((identity (t2-field-identity lib y numeric *proof-times*)))
            (cons identity lib))))
       (lib (cdr unit))
       (proof (library-library-proof lib))
       (order (proof-proof-rewrite proof order (car unit) (list 1 2 value-slot)))
       (back (proof-proof-symmetric proof ratio))
       (order (proof-proof-rewrite proof order back (list 1 2 (- 3 value-slot))))
       (step (proof-proof-rewrite proof bound order (if (equal value *proof-one*) '(1) '(1 1)))))
      (cons step lib))))

(defun t2-floor-bracket-remainder-bounds-case (lib q floor delta rat-q rat-delta
                                               nonnegative strict increasing)
  (let ((y *library-y*))
    (proof-with-checked-results
      ((sign (proof-proof-assume (library-library-proof lib)
                                 (if increasing (library-positive y) (library-lt y *proof-zero*))
                                 t))
       (remainder (t2-floor-bracket-remainder-identity lib q floor sign))
       (ratio (first remainder))
       (numeric (second remainder))
       (different (third remainder))
       (pos (if increasing sign (t2-order-opposite-order lib sign)))
       (lower (t2-floor-bracket-remainder-bound lib delta rat-delta ratio numeric different
                                                pos increasing nonnegative *proof-zero*))
       (upper (t2-floor-bracket-remainder-bound (cdr lower) delta rat-delta ratio numeric different
                                                pos increasing strict *proof-one*))
       (lib (cdr upper))
       (compound (t2-power-join lib (list (car lower) (car upper))))
       (rat-literal (proof-step-first rat-q))
       (sign-literal (proof-step-first sign)))
      (t2-floor-bracket-lemma
       lib (if increasing "MOD-POSITIVE-DIVISOR-BOUNDS" "MOD-NEGATIVE-DIVISOR-BOUNDS")
       compound (library-guards (list rat-literal sign-literal))))))

(defun t2-floor-bracket-remainder-bounds (lib cases floor-integer)
  (let ((proof (library-library-proof lib))
        (q (t2-quotient-rounding-quotient-cases-ratio cases)))
    (proof-with-checked-results
      ((floor (t2-floor-bracket-first-at floor-integer 1))
       (delta (library-diff q floor))
       (rat-q (proof-proof-assume proof (t2-quotient-rounding-quotient-cases-rat cases) t))
       (rat-floor (t2-arithmetic-rational lib floor (list floor-integer)))
       (rat-delta (t2-order-rational lib delta (list rat-q rat-floor)))
       (bounds (library-library-cite lib "RATIONAL-QUOTIENT-FLOOR-BRACKET"
                                      (list *library-x* *library-y*) (list rat-q)))
       (parts (t2-power-conjuncts lib bounds 3))
       (difference (library-library-cite lib "FIELD-LESS-NEGATIVE-DIFFERENCE" (list q floor) nil))
       (nonnegative (library-library-transport-argument lib (second parts) difference 1))
       (translation (library-library-cite lib "FIELD-ORDER-TRANSLATION"
                                           (list q (library-plus floor *proof-one*) (library-minus floor)) nil))
       (strict (proof-proof-transport proof (third parts) translation))
       (summed (library-library-axiom lib "COMMUTATIVITY-OF-+" (list floor *proof-one*)))
       (upper-bound (t2-floor-bracket-first-at strict 2))
       (reflexive (t2-arithmetic-arithmetic-reflexive lib upper-bound))
       (within (proof-proof-rewrite proof reflexive summed '(1 2 1)))
       (subtract (t2-field-cancellation-subtract-summand lib *proof-one* floor))
       (number (t2-arithmetic-number lib *proof-one* nil))
       (fix (t2-field-numeric-fix lib *proof-one* number))
       (within (proof-proof-chain proof within (list subtract fix)))
       (strict (proof-proof-rewrite proof strict within '(1 2)))
       (lib (t2-floor-bracket-remainder-bounds-case lib q floor delta rat-q rat-delta
                                                   nonnegative strict t)))
      (t2-floor-bracket-remainder-bounds-case lib q floor delta rat-q rat-delta
                                              nonnegative strict nil))))

(defun t2-floor-bracket-build (lib)
  (let* ((x *library-x*)
         (y *library-y*)
         (args (list x y))
         (modulus (list *t2-quotient-rounding-mod* x y)))
    (proof-with-checked-results
      ((lib (t2-floor-bracket-bracket lib))
       (proof (library-library-proof lib))
       (floor-integer (library-library-cite lib "FLOOR-IS-INTEGER" args nil))
       (opened (proof-proof-unfold proof modulus))
       (integers (library-library-ints lib args))
       (body (t2-floor-bracket-first-at opened 2))
       (type (t2-arithmetic-arithmetic-type-of lib body (append integers (list floor-integer))))
       (step (library-library-transport-argument lib type opened 1))
       (ix (proof-step-first (first integers)))
       (iy (proof-step-first (second integers)))
       (lib (t2-floor-bracket-lemma lib "MOD-OF-INTEGERS-TYPE" step (library-guards (list ix iy))))
       (proof (library-library-proof lib))
       (numeric (proof-proof-assume proof (list *library-numberp* x) t))
       (floor (t2-floor-bracket-first-at floor-integer 1))
       (product (t2-products-times y floor))
       (reposition (library-library-axiom lib "COMMUTATIVITY-OF-+" (list modulus product)))
       (reposition (proof-proof-rewrite proof reposition opened '(1 2 2)))
       (commuted (library-library-axiom lib "COMMUTATIVITY-OF-*" (list floor y)))
       (reposition (proof-proof-rewrite proof reposition commuted '(1 2 2 2 1)))
       (cancel (library-library-cite lib "FIELD-CANCEL-OPPOSITE-LAST" (list product x) nil))
       (fix (t2-field-numeric-fix lib x numeric))
       (step (proof-proof-chain proof reposition (list cancel fix)))
       (type-test (proof-step-first numeric))
       (lib (t2-floor-bracket-lemma lib "FLOOR-MOD-RECONSTRUCTION" step (list (proof-neg type-test))))
       (cases (t2-quotient-rounding-quotient-cases-init lib x y))
       (lib (t2-floor-bracket-rational-mod lib cases floor-integer opened))
       (cases (t2-quotient-rounding-quotient-cases-init lib x y)))
      (t2-floor-bracket-remainder-bounds lib cases floor-integer))))
