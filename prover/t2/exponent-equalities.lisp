(defun t2-exponent-equalities-magnitude-negative (lib sign raw is-rational not-negative-unit)
  (let* ((p (library-library-proof lib))
         (x *library-x*)
         (unit (proof-eq raw *proof-one*))
         (twice (library-minus raw)))
    (proof-with-checked-results
     ((sign-law (library-library-cite lib "FIELD-LESS-ZERO-NEGATION" (list x) nil))
      (positive (proof-proof-transport p sign sign-law))
      (double (library-library-cite lib "FIELD-DOUBLE-NEGATION" (list x) nil))
      (number (t2-order-number-from-rational lib is-rational))
      (fixed (t2-field-numeric-fix lib x number))
      (double (proof-proof-chain p double (list fixed)))
      (twice-refl (t2-arithmetic-arithmetic-reflexive lib twice))
      (at-unit (proof-proof-assume p unit t))
      (proof (proof-proof-rewrite p twice-refl at-unit '(1 2 1)))
      (minus-one (proof-proof-compute p (library-minus *proof-one*) -1))
      (proof (proof-proof-chain p proof (list minus-one)))
      (proof (proof-proof-rewrite p proof double '(1 1)))
      (contradiction (proof-proof-cut p proof not-negative-unit))
      (distinct (proof-proof-front p contradiction (proof-neg unit))))
     (list positive distinct))))

(defun t2-exponent-equalities-magnitude-branch (lib is-rational distinct-bases test negative)
  (let ((p (library-library-proof lib)))
    (proof-with-checked-results
     ((sign (proof-proof-assume p test negative))
      (magnitude (t2-ratios-absolute lib sign))
      (raw (caddr (proof-step-first magnitude)))
      (is-type (t2-order-rational lib raw (list is-rational)))
      (positive-and-distinct
       (if negative
           (t2-exponent-equalities-magnitude-negative
            lib sign raw is-rational (car distinct-bases))
         (proof-with-checked-results
          ((zero-rational (t2-arithmetic-rational lib *proof-zero* nil))
           (step (t2-order-trichotomy lib *library-x* *proof-zero*
                                      (list is-rational zero-rational)))
           (step (proof-proof-discharge p step (cadr distinct-bases)))
           (step (proof-proof-discharge p step sign)))
          (list step (caddr distinct-bases)))))
      (typed (library-library-transport-argument lib is-type magnitude 1))
      (positive (library-library-transport-argument
                 lib (car positive-and-distinct) magnitude 2))
      (reverse (proof-proof-symmetric p magnitude))
      (distinct (proof-proof-rewrite p (cadr positive-and-distinct) reverse '(1 1 1))))
     (list typed positive distinct))))

(defun t2-exponent-equalities-magnitude-domain (lib is-rational distinct-bases)
  (let ((p (library-library-proof lib))
        (test (library-lt *library-x* *proof-zero*)))
    (proof-with-checked-results
     ((distinct-bases (proof-list-of-length distinct-bases 3))
      (yes (t2-exponent-equalities-magnitude-branch lib is-rational distinct-bases test t))
      (no (t2-exponent-equalities-magnitude-branch lib is-rational distinct-bases test nil))
      (typed (proof-proof-cases p test (car yes) (car no)))
      (positive (proof-proof-cases p test (cadr yes) (cadr no)))
      (distinct (proof-proof-cases p test (caddr yes) (caddr no))))
     (list typed positive distinct))))

(defun t2-exponent-equalities-absolute-comparison (lib known absolute-left absolute-right)
  (let ((p (library-library-proof lib)))
    (proof-with-checked-results
     ((literal (proof-step-first known))
      (terms (proof-list-of-length (cdr literal) 2))
      (reflexive (t2-arithmetic-arithmetic-reflexive
                  lib (list *t2-exponent-equalities-abs* (car terms))))
      (equal-magnitudes (proof-proof-rewrite p reflexive known '(1 2 1)))
      (equal-magnitudes (proof-proof-rewrite p equal-magnitudes absolute-left '(1 1))))
     (proof-proof-rewrite p equal-magnitudes absolute-right '(1 2)))))

(defun t2-exponent-equalities-signed-injectivity (lib)
  (let* ((x *library-x*)
         (y *library-y*)
         (z *library-z*)
         (p (library-library-proof lib))
         (magnitude (list *t2-exponent-equalities-abs* x))
         (left (proof-eq (t2-power-power x y) (t2-power-power x z)))
         (right (proof-eq y z)))
    (proof-with-checked-results
     ((ratio (proof-proof-assume p (list *library-rationalp* x) t))
      (integers (library-library-ints lib (list y z)))
      (iy (car integers))
      (iz (cadr integers))
      (exceptional (t2-exponent-equalities-nonexceptional lib))
      (positive-types (t2-exponent-equalities-magnitude-domain lib ratio exceptional))
      (booleans (library-library-cite lib "POWER-POSITIVE-INJECTIVE"
                                      (list magnitude y z) (append positive-types integers)))
      (absolute-left (library-library-cite lib "POWER-ABSOLUTE" (list x y) (list ratio iy)))
      (absolute-right (library-library-cite lib "POWER-ABSOLUTE" (list x z) (list ratio iz)))
      (known (proof-proof-assume p left t))
      (expanded (t2-exponent-equalities-absolute-comparison lib known absolute-left absolute-right))
      (cancel (proof-proof-rewrite p expanded booleans '(1)))
      (equal-powers (t2-exponent-equalities-equality-from-exponents lib x y z))
      (result (t2-field-equal-predicates lib left right cancel equal-powers nil nil))
      (proof (car result)))
     (library-library-lemma
      (cdr result) "POWER-EQUAL-EXPONENTS" (proof-step-first proof) proof
      (append (list (cadr (proof-step-first (car exceptional)))
                    (cadr (proof-step-first (cadr exceptional)))
                    (cadr (proof-step-first (caddr exceptional))))
              (library-guards
               (list (proof-step-first ratio) (proof-step-first iy) (proof-step-first iz))))))))

(defun t2-exponent-equalities-unit-on-other-bases (lib iy ratio)
  (let* ((x *library-x*)
         (y *library-y*)
         (p (library-library-proof lib))
         (magnitude (list *t2-exponent-equalities-abs* x))
         (impossible (proof-eq (t2-power-power x y) *proof-neg-one*)))
    (proof-with-checked-results
     ((distinct-bases (t2-exponent-equalities-nonexceptional lib))
      (unit (library-library-cite lib "POWER-ZERO-EXPONENT" (list x) nil))
      (zero-type (t2-arithmetic-arithmetic-type-of lib *proof-zero* nil))
      (when-one (library-library-cite lib "POWER-EQUAL-EXPONENTS" (list x y *proof-zero*)
                                      (append distinct-bases (list ratio iy zero-type))))
      (when-one (proof-proof-rewrite p when-one unit '(1 1 2)))
      (typed (t2-exponent-equalities-magnitude-domain lib ratio distinct-bases))
      (zero-type (t2-arithmetic-arithmetic-type-of lib *proof-zero* nil))
      (equal (library-library-cite lib "POWER-POSITIVE-INJECTIVE" (list magnitude y *proof-zero*)
                                   (append typed (list iy zero-type))))
      (zero-power (library-library-cite lib "POWER-ZERO-EXPONENT" (list magnitude) nil))
      (equal (proof-proof-rewrite p equal zero-power '(1 1 2)))
      (left (library-library-cite lib "POWER-ABSOLUTE" (list x y) (list ratio iy)))
      (negative (t2-arithmetic-arithmetic-prove lib (library-lt *proof-neg-one* *proof-zero*)
                                                nil nil))
      (right (t2-ratios-absolute lib negative))
      (minus (proof-proof-compute p (library-minus *proof-neg-one*) 1))
      (right (proof-proof-chain p right (list minus)))
      (assumed (proof-proof-assume p impossible t))
      (equal-abs (t2-exponent-equalities-absolute-comparison lib assumed left right))
      (at-zero (proof-proof-rewrite p equal-abs equal '(1)))
      (reverse (proof-proof-symmetric p at-zero))
      (at-one (proof-proof-rewrite p unit reverse '(1 1 2)))
      (assumed (proof-proof-assume p impossible t))
      (contradiction (proof-proof-rewrite p assumed at-one '(1 1)))
      (contradiction (t2-arithmetic-simplify-first p contradiction nil nil))
      (contradiction (proof-proof-front p contradiction (proof-neg impossible)))
      (when-minus (t2-field-false-value lib contradiction)))
     (list when-one when-minus))))

(defun t2-exponent-equalities-compare-value (lib equation unit)
  (let ((p (library-library-proof lib)))
    (proof-with-checked-results
     ((literal (proof-step-first equation))
      (value (proof-term-at literal 1))
      (left (proof-eq value unit))
      (reflexive (t2-arithmetic-arithmetic-reflexive lib left))
      (reduced (proof-proof-rewrite p reflexive equation '(1 2 1)))
      (computed (t2-book-logic-constant lib (caddr (proof-step-first reduced)))))
     (proof-proof-chain p reduced (list computed)))))

(defun t2-exponent-equalities-minus-one-branch
    (lib unit parity expected contribution even)
  (let ((p (library-library-proof lib)))
    (proof-with-checked-results
     ((test (proof-proof-assume p parity even))
      (selected (proof-proof-select p (caddr (proof-step-first contribution)) test))
      (value (proof-proof-chain p contribution (list selected)))
      (actual (t2-exponent-equalities-compare-value lib value unit))
      (truth
       (if (equal unit *proof-one*)
           (proof-with-checked-results
            ((boolean (proof-proof-fact p "booleanp-integerp"
                                        (list (list *library-x* (cadr parity))))))
            (if even
                (t2-book-logic-true-boolean lib boolean test)
              (proof-with-checked-results
               ((false (t2-field-false-value lib test)))
               (cons false lib))))
         (proof-with-checked-results
          ((opened (proof-proof-unfold p (caddr (proof-step-first expected))))
           (selected (proof-proof-select p (caddr (proof-step-first opened)) test))
           (step (proof-proof-chain p opened (list selected))))
          (cons step lib))))
      (lib (cdr truth))
      (p (library-library-proof lib))
      (expected-value (proof-proof-chain p expected (list (car truth))))
      (reverse (proof-proof-symmetric p expected-value))
      (step (proof-proof-chain p actual (list reverse))))
     (cons step lib))))

(defun t2-exponent-equalities-compare-minus-one-powers (lib iy unit)
  (let ((parity (t2-exponent-parity-half-integral *library-y*))
        (arguments (list *library-x* *library-y*)))
    (proof-with-checked-results
     ((expected (library-library-cite lib
                                      (if (equal unit *proof-one*)
                                          "EVEN-HALF-INTEGRAL"
                                        "ODD-HALF-NONINTEGRAL")
                                      arguments nil))
      (contribution (library-library-cite lib "POWER-OF-MINUS-ONE" arguments (list iy)))
      (even (t2-exponent-equalities-minus-one-branch lib unit parity expected contribution t))
      (odd (t2-exponent-equalities-minus-one-branch (cdr even) unit parity expected contribution nil))
      (lib (cdr odd))
      (step (library-inherited proof-proof-cases lib parity (car even) (car odd))))
     (cons step lib))))

(defun t2-exponent-equalities-unit-one-case
    (lib is-one zip-test zip-equation zero-exp nested at-one compare)
  (let ((p (library-library-proof lib))
        (x *library-x*)
        (y *library-y*)
        (outer (proof-ite is-one is-one nested)))
    (proof-with-checked-results
     ((base-one (proof-proof-assume p is-one t))
      (base-true (t2-field-true-equality lib base-one))
      (reverse (proof-proof-symmetric p base-true))
      (at-one (proof-proof-chain p at-one (list reverse)))
      (selected (proof-proof-if-true p outer))
      (at-one (library-library-transport-argument lib at-one selected 2))
      (selected (proof-proof-if-false p outer))
      (rest (library-library-transport-argument lib compare selected 2))
      (compare (proof-proof-cases p is-one at-one rest))
      (answer (proof-ite zip-test zip-test outer))
      (zero-power (proof-proof-unfold p (t2-power-power x y)))
      (selected (proof-proof-if-true p (caddr (proof-step-first zero-power))))
      (zero-power (proof-proof-chain p zero-power (list selected)))
      (actual (t2-exponent-equalities-compare-value lib zero-power *proof-one*))
      (zero-true (t2-field-true-equality lib zero-exp))
      (true-zip (proof-proof-chain p zip-equation (list zero-true)))
      (selected (proof-proof-if-true p answer))
      (expected (proof-proof-chain p selected (list true-zip)))
      (reverse (proof-proof-symmetric p expected))
      (actual (proof-proof-chain p actual (list reverse)))
      (selected (proof-proof-if-false p answer))
      (rest (library-library-transport-argument lib compare selected 2)))
     (proof-proof-cases p zip-test actual rest))))

(defun t2-exponent-equalities-exact-unit
    (lib sign iy ratio defaults zero-base one-base zip-equation zero-exp exponent-not-zero)
  (let* ((x *library-x*)
         (is-zero (proof-eq x *proof-zero*))
         (is-one (proof-eq x *proof-one*))
         (is-minus (proof-eq x *proof-neg-one*))
         (zip-test (list *t2-power-zip* *library-y*))
         (onep (equal sign *proof-one*)))
    (proof-with-checked-results
     ((minus (t2-exponent-equalities-compare-minus-one-powers lib iy sign))
      (lib (cdr minus))
      (p (library-library-proof lib))
      (base-minus (proof-proof-assume p is-minus t))
      (reverse (proof-proof-symmetric p base-minus))
      (minus (proof-proof-rewrite p (car minus) reverse '(1 1 1 1)))
      (nested (proof-ite is-minus (caddr (proof-step-first minus)) *proof-false*))
      (selected (proof-proof-if-true p nested))
      (minus-case (library-library-transport-argument lib minus selected 2))
      (unzipped (proof-proof-if-false p (caddr (proof-step-first zero-base))))
      (base-zero (proof-proof-chain p zero-base (list unzipped)))
      (base-zero (t2-exponent-equalities-compare-value lib base-zero sign))
      (at-one (t2-exponent-equalities-compare-value lib one-base sign))
      (base-zero
       (if onep
           base-zero
         (proof-with-checked-results
          ((zipped (proof-proof-if-true p (caddr (proof-step-first zero-base))))
           (value (proof-proof-chain p zero-base (list zipped)))
           (base-zipped (t2-exponent-equalities-compare-value lib value sign)))
          (proof-proof-cases p zip-test base-zipped base-zero))))
      (general
       (if onep
           (proof-with-checked-results
            ((false (t2-field-false-value lib exponent-not-zero)))
            (proof-proof-chain p (car defaults) (list false)))
         (cadr defaults)))
      (other (proof-proof-cases p is-zero base-zero general))
      (other (if onep other (proof-proof-cases p is-one at-one other)))
      (selected (proof-proof-if-false p nested))
      (other (library-library-transport-argument lib other selected 2))
      (compare (proof-proof-cases p is-minus minus-case other))
      (compare
       (if onep
           (t2-exponent-equalities-unit-one-case lib is-one zip-test zip-equation
                                                 zero-exp nested at-one compare)
         compare)))
     (library-library-lemma lib (if onep "POWER-EQUAL-ONE" "POWER-EQUAL-MINUS-ONE")
                            (proof-step-first compare) compare
                            (library-guards (list (proof-step-first ratio)
                                                  (proof-step-first iy)))))))

(defun t2-exponent-equalities-exact-units (lib)
  (let* ((x *library-x*)
         (y *library-y*)
         (p (library-library-proof lib))
         (zip-test (list *t2-power-zip* y)))
    (proof-with-checked-results
     ((integers (library-library-ints lib (list y)))
      (iy (car integers))
      (ratio (proof-proof-assume p (list *library-rationalp* x) t))
      (defaults (t2-exponent-equalities-unit-on-other-bases lib iy ratio))
      (zero-base (library-library-cite lib "POWER-ZERO-BASE" (list *proof-zero* y) nil))
      (is-zero (proof-proof-assume p (proof-eq x *proof-zero*) t))
      (reverse (proof-proof-symmetric p is-zero))
      (zero-base (proof-proof-rewrite p zero-base reverse '(1 1 1)))
      (one-base (library-library-cite lib "POWER-UNIT-BASE" (list x y) nil))
      (is-one (proof-proof-assume p (proof-eq x *proof-one*) t))
      (reverse (proof-proof-symmetric p is-one))
      (one-base (proof-proof-rewrite p one-base reverse '(1 1 1)))
      (zip-equation (proof-proof-unfold p zip-test))
      (selected (proof-proof-select p (caddr (proof-step-first zip-equation)) iy))
