(in-package "BOYMOO-PROVER")
(set-verify-guards-eagerness 0)

(defconst *t2-exponent-equalities-abs* '("sym" "COMMON-LISP" "ABS"))

(defun t2-exponent-equalities-absolute-power-sign
    (lib negative parity iy base-type opposite base-double inside even)
  (let ((suffix (if even "EVEN" "ODD"))
        (y *library-y*)
        (p (library-library-proof lib)))
    (proof-with-checked-results
     ((test (proof-proof-assume p parity even))
      (negative-step (proof-proof-assume p negative t))
      (sign (library-library-cite
             lib (concatenate 'string "POWER-NEGATIVE-BASE-SIGN-" suffix)
             (list *library-x* y) (list negative-step base-type iy test)))
      (exposed (library-library-cite
                lib (concatenate 'string "POWER-NEGATIVE-BASE-" suffix)
                (list opposite y) (list iy test)))
      (exposed (proof-proof-rewrite p exposed base-double '(1 1 1)))
      (reduced
       (if even
           (proof-with-checked-results
            ((reversed (t2-order-opposite-order lib sign))
             (absolute (t2-ratios-absolute lib reversed)))
            (proof-proof-chain p absolute (list exposed)))
         (let ((value (t2-power-power opposite y)))
           (proof-with-checked-results
            ((absolute (t2-ratios-absolute lib sign))
             (reduced (proof-proof-rewrite p absolute exposed '(1 2 1)))
             (double (library-library-cite lib "FIELD-DOUBLE-NEGATION"
                                           (list value) nil))
             (numeric (library-library-cite lib "POWER-NUMBER"
                                            (list opposite y) nil))
             (fixed (t2-field-numeric-fix lib value numeric)))
            (proof-proof-chain p reduced (list double fixed))))))
      (inside (proof-proof-symmetric p inside)))
     (proof-proof-rewrite p reduced inside '(1 2 1)))))

(defun t2-exponent-equalities-absolute-power (lib)
  (let* ((x *library-x*)
         (y *library-y*)
         (p (library-library-proof lib))
         (negative (library-lt x *proof-zero*))
         (base-abs (list *t2-exponent-equalities-abs* x))
         (value (t2-power-power x y))
         (outside (t2-power-power base-abs y)))
    (proof-with-checked-results
     ((base-type (proof-proof-assume p (list *library-rationalp* x) t))
      (integers (library-library-ints lib (list y)))
      (iy (car integers))
      (nonnegative (proof-proof-assume p negative nil))
      (power-positive (library-library-cite lib "POWER-NONNEGATIVE-BASE"
                                            (list x y) (list base-type nonnegative)))
      (absolute-value (t2-ratios-absolute lib power-positive))
      (absolute-base (t2-ratios-absolute lib nonnegative))
      (from-magnitude (proof-proof-symmetric p absolute-base))
      (ordinary (proof-proof-rewrite p absolute-value from-magnitude '(1 2 1)))
      (opposite (library-minus x))
      (negative-step (proof-proof-assume p negative t))
      (inside (t2-ratios-absolute lib negative-step))
      (double (library-library-cite lib "FIELD-DOUBLE-NEGATION" (list x) nil))
      (numeric (t2-order-number-from-rational lib base-type))
      (fixed (t2-field-numeric-fix lib x numeric))
      (base-double (proof-proof-chain p double (list fixed)))
      (parity (t2-exponent-parity-half-integral y))
      (even (t2-exponent-equalities-absolute-power-sign
             lib negative parity iy base-type opposite base-double inside t))
      (odd (t2-exponent-equalities-absolute-power-sign
            lib negative parity iy base-type opposite base-double inside nil))
      (negative-case (proof-proof-cases p parity even odd))
      (proof (proof-proof-cases p negative negative-case ordinary)))
     (library-library-lemma lib "POWER-ABSOLUTE"
                            (proof-eq (list *t2-exponent-equalities-abs* value) outside)
                            proof (library-guards (list (proof-step-first base-type)
                                                        (proof-step-first iy)))))))

(defun t2-exponent-equalities-equality-from-exponents (lib base left right)
  (let ((p (library-library-proof lib)))
    (proof-with-checked-results
     ((same (proof-proof-assume p (proof-eq left right) t))
      (power (t2-power-power base left))
      (reflexive (t2-arithmetic-arithmetic-reflexive lib power)))
     (proof-proof-rewrite p reflexive same '(1 2 2)))))

(defun t2-exponent-equalities-order-apart (lib step left)
  (proof-with-checked-results
   ((apart (t2-order-distinct lib step))
    (literal (proof-step-first apart)))
   (if (equal literal (proof-neg left))
       apart
     (t2-products-flip-neq lib apart))))

(defun t2-exponent-equalities-positive-injectivity-incompatible
    (strict lib integers ratio wide pos narrow left)
  (let ((p (library-library-proof lib)))
    (proof-with-checked-results
     ((literal (proof-step-first strict))
      (bounds (proof-list-of-length (cdr literal) 2))
      (low (car bounds))
      (high (cadr bounds))
      (low-type (t2-arithmetic-arithmetic-type-of lib low integers))
      (high-type (t2-arithmetic-arithmetic-type-of lib high integers))
      (above-one (proof-proof-assume p wide t))
      (grows (library-library-cite lib "POWER-MONOTONE"
                                   (list *library-x* low high)
                                   (list ratio low-type high-type strict above-one)))
      (falls (library-library-cite lib "POWER-ANTITONE"
                                   (list *library-x* low high)
                                   (list ratio low-type high-type strict pos narrow)))
      (increasing (t2-exponent-equalities-order-apart lib grows left))
      (decreasing (t2-exponent-equalities-order-apart lib falls left)))
     (proof-proof-cases p wide increasing decreasing))))

(defun t2-exponent-equalities-positive-injectivity (lib)
  (let* ((x *library-x*)
         (y *library-y*)
         (z *library-z*)
         (p (library-library-proof lib))
         (wide (library-lt *proof-one* x))
         (left (proof-eq (t2-power-power x y) (t2-power-power x z)))
         (right (proof-eq y z))
         (equal-unit (proof-eq x *proof-one*))
         (less (library-lt y z)))
    (proof-with-checked-results
     ((ratio (proof-proof-assume p (list *library-rationalp* x) t))
      (pos (proof-proof-assume p (library-positive x) t))
      (nonunit (proof-proof-assume p equal-unit nil))
      (integers (library-library-ints lib (list y z)))
      (one-rational (t2-arithmetic-rational lib *proof-one* nil))
      (narrow (t2-order-trichotomy lib *proof-one* x (list ratio one-rational)))
      (reverse-unit (t2-products-flip-neq lib nonunit))
      (narrow (proof-proof-discharge p narrow reverse-unit))
      (y-rational (t2-arithmetic-rational lib y integers))
      (z-rational (t2-arithmetic-rational lib z integers))
      (reverse (t2-order-trichotomy lib y z (list y-rational z-rational)))
      (different (proof-proof-assume p right nil))
      (reverse (proof-proof-discharge p reverse different))
      (forward (proof-proof-assume p less t))
      (yes (t2-exponent-equalities-positive-injectivity-incompatible
            forward lib integers ratio wide pos narrow left))
      (no (t2-exponent-equalities-positive-injectivity-incompatible
           reverse lib integers ratio wide pos narrow left))
      (apart (proof-proof-cases p less yes no))
      (same-power (proof-proof-assume p left t))
      (cut (proof-proof-cut p same-power apart))
      (cancel (proof-proof-front p cut right))
      (equal-powers (t2-exponent-equalities-equality-from-exponents lib x y z))
      (result (t2-field-equal-predicates lib left right cancel equal-powers nil nil))
      (proof (car result)))
     (library-library-lemma
      (cdr result) "POWER-POSITIVE-INJECTIVE" (proof-step-first proof) proof
      (cons equal-unit (library-guards (list (proof-step-first ratio)
                                            (proof-step-first pos)
                                            (proof-step-first (car integers))
                                            (proof-step-first (cadr integers)))))))))

