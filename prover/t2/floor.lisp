(in-package "BOYMOO-PROVER")

(set-verify-guards-eagerness 0)

(defconst *t2-floor-floor* (proof-cl "FLOOR"))
(defconst *t2-floor-equal-num* (proof-cl "="))
(defconst *t2-floor-atom* (proof-cl "ATOM"))
(defconst *t2-floor-endp* (proof-cl "ENDP"))
(defconst *t2-floor-print-base* (proof-sym "PRINT-BASE-P" "ACL2"))
(defconst *t2-floor-member* (proof-sym "MEMBER-EQUAL" "ACL2"))
(defconst *t2-floor-reciprocal* (proof-sym "UNARY-/" "ACL2"))

(defun t2-floor-conjunction (lib test consequence)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
     ((test-term (proof-step-first test))
      (consequence-term (proof-step-first consequence))
      (term (proof-ite test-term consequence-term *proof-false*))
      (selected (proof-proof-select proof term test)))
     (proof-proof-transport proof consequence selected))))

(defun t2-floor-cancel-reciprocal (lib factor value integers pos-factor)
  (let ((proof (library-library-proof lib))
        (reciprocal (list *t2-floor-reciprocal* factor)))
    (proof-with-checked-results
     ((distinct (t2-products-strict-neq lib pos-factor integers))
      (nonzero (t2-products-flip-neq lib distinct))
      (number (t2-arithmetic-number lib factor integers))
      (guard (t2-floor-conjunction lib number nonzero))
      (inverse (library-library-axiom lib "INVERSE-OF-*" (list factor)))
      (cancellation (t2-arithmetic-arithmetic-modus-ponens lib inverse guard))
      (associativity (library-library-axiom lib "ASSOCIATIVITY-OF-*" (list factor reciprocal value)))
      (associativity (proof-proof-symmetric proof associativity))
      (opened (proof-proof-rewrite proof associativity cancellation '(1 2 1)))
      (swap (library-library-axiom lib "COMMUTATIVITY-OF-*" (list *proof-one* value)))
      (value-number (t2-arithmetic-number lib value integers))
      (unit (t2-products-product-one lib value value-number)))
     (proof-proof-chain proof opened (list swap unit)))))

(defun t2-floor-reduced-fraction (lib i b integers pos-b)
  (let ((proof (library-library-proof lib))
        (reciprocal (list *t2-floor-reciprocal* b)))
    (proof-with-checked-results
     ((q (t2-products-times i reciprocal))
      (rational-b (t2-arithmetic-rational lib b integers))
      (reciprocal-fact (proof-proof-fact proof "rationalp-unary-/" (list (list *library-x* b))))
      (rat-recip (t2-arithmetic-arithmetic-modus-ponens lib reciprocal-fact rational-b))
      (rat-i (t2-arithmetic-rational lib i integers))
      (pair (t2-floor-conjunction lib rat-i rat-recip))
      (product-fact (proof-proof-fact proof "rationalp-binary-*"
                                     (list (list *library-x* i) (list *library-y* reciprocal))))
      (rational (t2-arithmetic-arithmetic-modus-ponens lib product-fact pair))
      (parts (t2-arithmetic-rational-parts lib rational))
      (int-n (car parts))
      (int-d (cadr parts))
      (pos-d (caddr parts))
      (n-type (proof-step-first int-n))
      (n (proof-term-at n-type 1))
      (d-type (proof-step-first int-d))
      (d (proof-term-at d-type 1))
      (integers (append integers (list int-n int-d)))
      (reduction (library-library-axiom lib "RATIONAL-IMPLIES2" (list q)))
      (reduced (t2-arithmetic-arithmetic-modus-ponens lib reduction rational))
      (recover-n (t2-floor-cancel-reciprocal lib d n integers pos-d))
      (recovered-n (proof-proof-rewrite-first proof recover-n reduced))
      (recovery (t2-floor-cancel-reciprocal lib b i integers pos-b))
      (swap (library-library-axiom lib "COMMUTATIVITY-OF-*" (list reciprocal i)))
      (recovery (proof-proof-rewrite-first proof recovery swap))
      (step (t2-arithmetic-arithmetic-reflexive lib (t2-products-times b n)))
      (unrecover (proof-proof-symmetric proof recovered-n))
      (step (proof-proof-rewrite proof step unrecover '(1 2 2)))
      (assoc (library-library-axiom lib "ASSOCIATIVITY-OF-*" (list b d q)))
      (reverse-assoc (proof-proof-symmetric proof assoc))
      (step (proof-proof-chain proof step (list reverse-assoc)))
      (swap (library-library-axiom lib "COMMUTATIVITY-OF-*" (list b d)))
      (step (proof-proof-rewrite proof step swap '(1 2 1)))
      (assoc (library-library-axiom lib "ASSOCIATIVITY-OF-*" (list d b q)))
      (step (proof-proof-chain proof step (list assoc)))
      (step (proof-proof-rewrite proof step recovery '(1 2 2))))
     (list step int-n int-d pos-d))))

(defun t2-floor-multiply-by-one (lib factor value test integers)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
     ((assumed (proof-proof-assume proof test t))
      (opened (proof-proof-unfold proof test))
      (same (proof-proof-rewrite proof assumed opened '(1)))
      (identity (t2-arithmetic-arithmetic-reflexive lib (t2-products-times factor value)))
      (direct (proof-proof-rewrite proof identity same '(1 2 1)))
      (swap (library-library-axiom lib "COMMUTATIVITY-OF-*" (list *proof-one* value)))
      (number (t2-arithmetic-number lib value integers))
      (unit (t2-products-product-one lib value number)))
     (proof-proof-chain proof direct (list swap unit)))))

(defun t2-floor-positive-floor-result (lib floor natural-n pos-d integers)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
     ((natural-first (proof-step-first natural-n))
      (n (proof-term-at natural-first 1))
      (pos-first (proof-step-first pos-d))
      (d (proof-term-at pos-first 2))
      (equation (t2-arithmetic-simplify proof floor nil (list *t2-floor-floor*)))
      (equation-first (proof-step-first equation))
      (body (proof-term-at equation-first 2))
      (test (proof-term-at body 1))
      (if-true (proof-proof-if-true proof body))
      (when-one (proof-proof-chain proof equation (list if-true)))
      (one-natural (library-library-transport-argument lib natural-n when-one 1))
      (n-int (t2-arithmetic-arithmetic-type-of lib n integers))
      (reflexive (library-library-cite lib "WEAK-REFLEXIVE" (list n) (list n-int)))
      (product (t2-floor-multiply-by-one lib d n test integers))
      (reverse (proof-proof-symmetric proof product))
      (unit-bound (proof-proof-rewrite proof reflexive reverse '(1 1 2)))
      (reverse (proof-proof-symmetric proof when-one))
      (unit-bound (proof-proof-rewrite proof unit-bound reverse '(1 1 2 2)))
      (unit-bound (proof-proof-tidy proof unit-bound))
      (nonneg-n (library-library-cite lib "NATURAL-NONNEGATIVE" (list n) (list natural-n)))
      (if-false (proof-proof-if-false proof body))
      (branch (proof-term-at body 3))
      (selected (proof-proof-select proof branch nonneg-n))
      (when-fraction (proof-proof-chain proof equation (list if-false selected)))
      (quotient (t2-quotient-quotient-bound lib n d integers nonneg-n pos-d))
      (lib (cdr quotient))
      (proof (library-library-proof lib))
      (quotient-natural (caar quotient))
      (quotient-product (cadar quotient))
      (fraction-natural (library-library-transport-argument lib quotient-natural when-fraction 1))
      (reverse (proof-proof-symmetric proof when-fraction))
      (fraction-bound (proof-proof-rewrite proof quotient-product reverse '(1 1 2 2)))
      (fraction-bound (proof-proof-tidy proof fraction-bound))
      (natural (proof-proof-cases proof test one-natural fraction-natural))
      (bound (proof-proof-cases proof test unit-bound fraction-bound)))
     (cons (list natural bound) lib))))

(defun t2-floor-build-positive-floor (lib)
  (if (assoc-equal (proof-sym "SELF-COUNT-FLOOR-POSITIVE" "ACL2")
                  (proof-proof-facts (library-library-proof lib)))
      lib
    (proof-with-checked-results
     ((lib (t2-arithmetic-arithmetic-build-countdowns lib))
      (lib (t2-arithmetic-arithmetic-build-weak-order lib))
      (lib (t2-products-build-product-order lib))
      (proof (library-library-proof lib))
      (integers (library-library-ints lib (list *library-x* *library-y*)))
      (int-i (car integers))
      (int-b (cadr integers))
      (pos-i (proof-proof-assume proof (library-positive *library-x*) t))
      (wide-b (proof-proof-assume proof (library-lt *proof-one* *library-y*) t))
      (pos-one (t2-arithmetic-arithmetic-prove lib (library-positive *proof-one*) nil nil))
      (pos-b (t2-arithmetic-arithmetic-compare-chain lib pos-one wide-b (list int-b)))
      (parts (t2-floor-reduced-fraction lib *library-x* *library-y* integers pos-b))
      (cross (car parts))
      (int-n (cadr parts))
      (int-d (caddr parts))
      (pos-d (cadddr parts))
      (integers (list int-i int-b int-n int-d))
      (n-type (proof-step-first int-n))
      (n (proof-term-at n-type 1))
      (d-type (proof-step-first int-d))
      (d (proof-term-at d-type 1))
      (pos-product (t2-products-product-positive lib d *library-x* integers pos-d pos-i))
      (reverse (proof-proof-symmetric proof cross))
      (pos-product (proof-proof-rewrite proof pos-product reverse '(1 2)))
      (zero (t2-products-product-zero lib *library-y*))
      (lib (cdr zero))
      (proof (library-library-proof lib))
      (reverse (proof-proof-symmetric proof (car zero)))
      (pos-product (proof-proof-rewrite proof pos-product reverse '(1 1)))
      (pos-n (t2-products-cancel-scale lib pos-product pos-b integers))
      (natural-n (t2-arithmetic-natural-from-positive lib int-n pos-n))
      (floor (list *t2-floor-floor* *library-x* *library-y*))
      (result (t2-floor-positive-floor-result lib floor natural-n pos-d integers))
      (lib (cdr result))
      (proof (library-library-proof lib))
      (floor-nat (caar result))
      (floor-bound (cadar result))
      (floor-int (library-library-cite lib "NATURAL-INTEGER" (list floor) (list floor-nat)))
      (integers (append integers (list floor-int)))
      (n-bound (t2-products-scale lib wide-b pos-n integers nil))
      (n-number (t2-arithmetic-number lib n integers))
      (unit (t2-products-product-one lib n n-number))
      (n-bound (proof-proof-rewrite proof n-bound unit '(1 1)))
      (swap (library-library-axiom lib "COMMUTATIVITY-OF-*" (list n *library-y*)))
      (n-bound (proof-proof-rewrite proof n-bound swap '(1 2)))
      (n-bound (proof-proof-rewrite proof n-bound cross '(1 2)))
      (combined (t2-arithmetic-arithmetic-compare-chain lib floor-bound n-bound integers))
      (smaller (t2-products-cancel-scale lib combined pos-d integers))
      (floor-count (t2-arithmetic-count-natural lib floor-nat))
      (lib (cdr floor-count))
      (smaller (library-library-transport-argument lib smaller (car floor-count) 1))
      (i-nat (t2-arithmetic-natural-from-positive lib int-i pos-i))
      (i-count (t2-arithmetic-count-natural lib i-nat))
      (lib (cdr i-count))
      (smaller (library-library-transport-argument lib smaller (car i-count) 2))
      (literal (proof-step-first smaller))
      (args (proof-list-of-length (cdr literal) 2))
      (claim (cons *proof-ordinal-less* args))
      (comparison (t2-arithmetic-arithmetic-ordinal-comparison lib (car args) (cadr args) nil))
      (step (proof-proof-transport (library-library-proof lib) smaller comparison)))
     (library-library-lemma lib "COUNT-FLOOR-POSITIVE" claim step
                            (library-guards (list (library-integer *library-x*)
                                                  (library-integer *library-y*)
                                                  (library-positive *library-x*)
                                                  (library-lt *proof-one* *library-y*)))))))

(defun t2-floor-constant-members (n lib member formula)
  (declare (xargs :measure (nfix n)))
  (if (not (o< (nfix (1- n)) (nfix n)))
      '(:failure "fuel" "t2-floor-constant-members")
    (let ((proof (library-library-proof lib)))
      (proof-with-checked-results
       ((literal (proof-step-first member))
        (parts (proof-list-of-length literal 3))
        (item (cadr parts))
        (collection (caddr parts))
        (equation (proof-proof-unfold proof literal))
        (equation-first (proof-step-first equation))
        (term (proof-term-at equation-first 2))
        (body (t2-arithmetic-simplify proof term nil (list *t2-floor-endp* *t2-floor-atom* *proof-not*)))
        (equation (proof-proof-chain proof equation (list body)))
        (opened (proof-proof-rewrite proof member equation '(1)))
        (values (proof-term-at collection 1)))
       (if (equal values *proof-nil*)
           (proof-proof-subsume proof opened (cons formula (cdr (proof-step-clause opened))))
         (proof-with-checked-results
          ((value (proof-term-at values 0))
           (first (proof-quote value))
           (rest (or (cdr values) *proof-nil*))
           (head (proof-proof-compute proof (list *library-car* collection) value))
           (opened (proof-proof-rewrite-first proof opened head))
           (tail (proof-proof-compute proof (list *library-cdr* collection) rest))
           (opened (proof-proof-rewrite-first proof opened tail))
           (test (proof-eq item first))
           (opened-first (proof-step-first opened))
           (opened-test (proof-term-at opened-first 1)))
          (if (not (equal opened-test test))
              '(:failure "recipe-mismatch" "")
            (proof-with-checked-results
             ((claim (proof-ite (library-integer first) (library-lt *proof-one* first) *proof-false*))
              (holds (t2-arithmetic-arithmetic-prove lib claim nil nil))
              (assumed (proof-proof-assume proof test t))
              (reverse (proof-proof-symmetric proof assumed))
              (good (proof-proof-rewrite-first proof holds reverse))
              (denied (proof-proof-assume proof test nil))
              (remaining (proof-proof-prove-if proof opened denied))
              (other (t2-floor-constant-members (1- n) lib remaining formula)))
             (proof-proof-cases proof test good other)))))))))

(defun t2-floor-build-print-base-facts (lib)
  (let ((proof (library-library-proof lib))
        (base-test (list *t2-floor-print-base* *library-x*)))
    (proof-with-checked-results
     ((opened (t2-arithmetic-simplify proof base-test nil (list *t2-floor-print-base* *termination-return-last*)))
      (assumed (proof-proof-assume proof base-test t))
      (step (proof-proof-rewrite proof assumed opened '(1)))
      (parts (t2-arithmetic-arithmetic-conjunct lib step))
      (membership (car parts))
      (first (proof-step-first membership)))
     (if (not (proof-is-call first *t2-floor-member*))
         '(:failure "recipe-mismatch" "")
       (proof-with-checked-results
        ((formula (proof-ite (library-integer *library-x*)
                             (library-lt *proof-one* *library-x*) *proof-false*))
         (proof (t2-floor-constant-members 1000000 lib membership formula)))
        (library-library-lemma lib "PRINT-BASE-BOUNDS" formula proof (list (proof-neg base-test))))))))

(defun t2-floor-print-base-facts (lib base premise)
  (proof-with-checked-results
   ((lib (if (assoc-equal (proof-sym "SELF-PRINT-BASE-BOUNDS" "ACL2")
                         (proof-proof-facts (library-library-proof lib)))
             lib
           (t2-floor-build-print-base-facts lib)))
    (step (library-library-cite lib "PRINT-BASE-BOUNDS" (list base) (list premise)))
    (result (t2-arithmetic-arithmetic-conjunct lib step)))
   (cons result lib)))

(defun t2-floor-divisor-bounds-query (lib base hypotheses replies)
  (let ((bound (library-lt *proof-one* base)))
    (if (proof-is-call base *proof-quote*)
        (proof-with-checked-results
         ((int-base (t2-arithmetic-arithmetic-type-of lib base nil))
          (wide-base (t2-arithmetic-arithmetic-prove lib bound nil nil)))
         (cons (list (list int-base wide-base) hypotheses) lib))
      (descent-let*
       ((int-base (t2-phase-hypotheses-lookup hypotheses (library-integer base) replies))
        (wide-base (t2-phase-hypotheses-lookup (cdr int-base) bound replies))
        (hypotheses (cdr wide-base)))
       (if (and (car int-base) (car wide-base))
           (cons (list (list (car int-base) (car wide-base)) hypotheses) lib)
         (descent-let*
          ((premise (t2-phase-hypotheses-require hypotheses (list *t2-floor-print-base* base) replies))
           (result (t2-floor-print-base-facts lib base (car premise)))
           (hypotheses (t2-phase-hypotheses-after-library (cdr premise) lib (cdr result))))
          (cons (list (car result) hypotheses) (cdr result))))))))

(defun t2-floor-divisor-bounds (lib base hypotheses)
  (t2-floor-divisor-bounds-query lib base hypotheses :plain))

(defun t2-floor-positive-floor-decrease-query (lib input-value base hypotheses positive-input replies)
  (descent-let*
   ((built (t2-floor-build-positive-floor lib))
    (hypotheses (t2-phase-hypotheses-after-library hypotheses lib built))
    (divisor (t2-floor-divisor-bounds-query built base hypotheses replies))
    (lib (cdr divisor))
    (divisor-steps (caar divisor))
    (hypotheses (cadar divisor))
    (int-input (t2-phase-hypotheses-require hypotheses (library-integer input-value) replies))
    (step (library-library-cite lib "COUNT-FLOOR-POSITIVE" (list input-value base)
                                (list (car int-input) (car divisor-steps) positive-input
                                      (cadr divisor-steps)))))
   (cons (list step (cdr int-input)) lib)))

(defun t2-floor-positive-floor-decrease (lib input-value base hypotheses positive-input)
  (t2-floor-positive-floor-decrease-query lib input-value base hypotheses positive-input :plain))
