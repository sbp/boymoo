(in-package "BOYMOO-PROVER")
(set-verify-guards-eagerness 0)

(defconst *t2-completed-operations-lognot* (proof-cl "LOGNOT"))
(defconst *t2-completed-operations-logorc1* (proof-cl "LOGORC1"))
(defconst *t2-completed-operations-logand* (proof-sym "BINARY-LOGAND" "ACL2"))
(defconst *t2-completed-operations-logior* (proof-sym "BINARY-LOGIOR" "ACL2"))
(defconst *t2-completed-operations-logeqv* (proof-sym "BINARY-LOGEQV" "ACL2"))
(defconst *t2-completed-operations-logxor* (proof-sym "BINARY-LOGXOR" "ACL2"))

(defun t2-completed-operations-zero-mod (lib floor-zero)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((mod (proof-proof-unfold proof (list *t2-quotient-rounding-mod* *library-x* *library-y*)))
         (mod (proof-proof-rewrite proof mod floor-zero '(1 2 2 1 1)))
         (remainder (library-library-cite lib "REMAINDER-WITH-ZERO-QUOTIENT"
                                          (list *library-x* *library-y*) nil)))
      (proof-proof-chain proof mod (list remainder)))))

(defun t2-completed-operations-rounding-default (lib label guard floor-case nx x-default)
  (proof-with-checked-results
      ((floor (t2-conditional-default-value lib guard floor-case))
       (floor-claim (proof-step-first floor))
       (lib (library-library-lemma lib (concatenate 'string "FLOOR-COMPLETION-" label)
                                   floor-claim floor nil))
       (mod-case (t2-completed-operations-zero-mod lib floor-case))
       (proof (library-library-proof lib))
       (fix (proof-proof-unfold proof (t2-field-fixed *library-x*)))
       (fix (if (equal guard nx)
                (t2-input-fields-select lib fix x-default)
              fix))
       (mod-case (proof-proof-chain proof mod-case (list fix)))
       (mod (t2-conditional-default-value lib guard mod-case))
       (mod-claim (proof-step-first mod)))
    (library-library-lemma lib (concatenate 'string "MOD-COMPLETION-" label)
                           mod-claim mod nil)))

(defun t2-completed-operations-rounding-defaults (lib)
  (let* ((cases (t2-quotient-rounding-quotient-cases-init lib *library-x* *library-y*))
         (nx (list *library-numberp* *library-x*))
         (ny (list *library-numberp* *library-y*))
         (proof (library-library-proof lib)))
    (proof-with-checked-results
        ((x-default (proof-proof-assume proof nx nil))
         (completed (library-library-axiom
                     lib "COMPLETION-OF-*" (list *library-x* (t2-field-reciprocal *library-y*))))
         (x-zero (t2-input-fields-select lib completed x-default))
         (y-fix (proof-proof-unfold proof (t2-field-fixed *library-y*)))
         (y-default (proof-proof-assume proof ny nil))
         (y-zero (t2-input-fields-select lib y-fix y-default))
         (rat (t2-quotient-rounding-quotient-cases-rat cases))
         (nonrational (proof-proof-assume proof rat nil))
         (floor-ratio (t2-quotient-rounding-quotient-cases-value
                       cases *t2-floor-floor* (list nonrational)))
         (floor-dividend (t2-floor-thresholds-floor-with-zero-ratio lib cases x-zero))
         (floor-divisor (t2-floor-thresholds-fixed-zero-floor lib cases y-zero))
         (lib (t2-completed-operations-rounding-default
               (cdr floor-divisor) "RATIO" rat floor-ratio nx x-default))
         (lib (t2-completed-operations-rounding-default
               lib "DIVIDEND" nx floor-dividend nx x-default)))
      (t2-completed-operations-rounding-default
       lib "DIVISOR" ny (car floor-divisor) nx x-default))))

(defun t2-completed-operations-lognot-zero (lib value missing)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((opened (proof-proof-unfold proof (list *t2-completed-operations-lognot* value)))
         (actual (proof-proof-unfold proof (list *t2-power-ifix* value)))
         (actual (t2-input-fields-select lib actual missing))
         (reference (proof-proof-unfold proof (list *t2-power-ifix* *proof-zero*)))
         (type-step (t2-arithmetic-arithmetic-type-of lib *proof-zero* nil))
         (reference (t2-input-fields-select lib reference type-step))
         (zero (proof-proof-unfold proof (list *t2-completed-operations-lognot* *proof-zero*)))
         (opened (t2-round-ties-replace-body lib opened actual))
         (zero (t2-round-ties-replace-body lib zero reference))
         (reversed (proof-proof-symmetric proof zero)))
      (proof-proof-chain proof opened (list reversed)))))

(defun t2-completed-operations-logand-default (lib first second position missing)
  (let* ((position (cond ((eq position t) 1)
                         ((null position) 0)
                         (t position)))
         (index (if (integerp position) (1- position) position))
         (proof (library-library-proof lib)))
    (proof-with-checked-results
        ((value (cond ((not (integerp index))
                       '(:failure "failure" ""))
                      ((< index -2) '(:failure "failure" ""))
                      (t (proof-term-at (list first second) (if (< index 0) (+ 2 index) index)))))
         (zip (proof-proof-unfold proof (list *t2-power-zip* value)))
         (known (t2-input-fields-select lib zip missing))
         (zipped (proof-proof-true-from-eq proof known))
         (opened (proof-proof-unfold proof (list *t2-completed-operations-logand* first second))))
      (if (equal position 1)
          (t2-input-fields-select lib opened zipped)
        (let ((test (list *t2-power-zip* first)))
          (proof-with-checked-results
              ((nonzero (proof-proof-assume proof test nil))
               (no (t2-input-fields-select lib opened nonzero))
               (no (t2-input-fields-select lib no zipped))
               (literal (proof-step-first opened))
               (body (proof-term-at literal 2))
               (condition (proof-proof-if-true proof body))
               (yes (proof-proof-chain proof opened (list condition))))
            (proof-proof-cases proof test yes no)))))))

(defun t2-completed-operations-xor-body (step)
  (proof-with-checked-results
      ((literal (proof-step-first step))
       (body (proof-term-at literal 2)))
    (proof-term-at body 1)))

(defun t2-completed-operations-xor-operand (proof eqn position)
  (proof-with-checked-results
      ((body (t2-completed-operations-xor-body eqn))
       (call (proof-term-at body position))
       (applied (proof-proof-unfold proof call)))
    (proof-proof-rewrite proof eqn applied (list 1 2 1 position))))

(defun t2-completed-operations-xor-expansion (lib arguments)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((eqn (proof-proof-unfold proof (cons *t2-completed-operations-logxor* arguments)))
         (body (t2-completed-operations-xor-body eqn))
         (applied (proof-proof-unfold proof body))
         (eqn (proof-proof-rewrite proof eqn applied '(1 2 1)))
         (eqn (t2-completed-operations-xor-operand proof eqn 1)))
      (t2-completed-operations-xor-operand proof eqn 2))))

(defun t2-completed-operations-bit-defaults-and-or (lib position value)
  (let ((guard (library-integer value)))
    (proof-with-checked-results
        ((missing (proof-proof-assume (library-library-proof lib) guard nil))
         (logand (t2-completed-operations-logand-default lib *library-x* *library-y* position missing))
         (step (t2-conditional-default-value lib guard logand))
         (claim (proof-step-first step))
         (lib (library-library-lemma lib (concatenate 'string "LOGAND-COMPLETION-" (decimal-text position))
                                     claim step nil))
         (source (list *library-x* *library-y*))
         (target (if (equal position 1) (list *proof-zero* *library-y*) (list *library-x* *proof-zero*)))
         (inverted (t2-completed-operations-lognot-zero lib value missing))
         (proof (library-library-proof lib))
         (old (proof-proof-unfold proof (cons *t2-completed-operations-logior* source)))
         (old (t2-round-ties-replace-body lib old inverted))
         (new (proof-proof-unfold proof (cons *t2-completed-operations-logior* target)))
         (reversed (proof-proof-symmetric proof new))
         (or-proof (proof-proof-chain proof old (list reversed)))
         (step (t2-conditional-default-value lib guard or-proof))
         (claim (proof-step-first step)))
      (library-library-lemma lib (concatenate 'string "LOGIOR-COMPLETION-" (decimal-text position))
                             claim step nil))))

(defun t2-completed-operations-bit-defaults-xor (lib position value)
  (let ((guard (library-integer value))
        (proof (library-library-proof lib)))
    (proof-with-checked-results
        ((missing (proof-proof-assume proof guard nil))
         (other (if (equal position 1) *library-y* *library-x*))
         (source (list *library-x* *library-y*))
         (target (if (equal position 1) (list *proof-zero* *library-y*) (list *library-x* *proof-zero*)))
         (old (t2-completed-operations-xor-expansion lib source))
         (inverted (t2-completed-operations-lognot-zero lib value missing))
         (old (t2-round-ties-replace-body lib old inverted))
         (update (library-library-cite lib "LOGIOR-COMPLETION-2"
                                       (list (list *t2-completed-operations-lognot* other) value) nil))
         (update (t2-input-fields-select lib update missing))
         (old (t2-round-ties-replace-body lib old update))
         (new (t2-completed-operations-xor-expansion lib target))
         (reversed (proof-proof-symmetric proof new))
         (chain (proof-proof-chain proof old (list reversed)))
         (step (t2-conditional-default-value lib guard chain))
         (claim (proof-step-first step)))
      (library-library-lemma lib (concatenate 'string "LOGXOR-COMPLETION-" (decimal-text position))
                             claim step nil))))

(defun t2-completed-operations-bit-defaults (lib)
  (proof-with-checked-results
      ((lib (t2-completed-operations-bit-defaults-and-or lib 1 *library-x*))
       (lib (t2-completed-operations-bit-defaults-and-or lib 2 *library-y*))
       (lib (t2-completed-operations-bit-defaults-xor lib 1 *library-x*)))
    (t2-completed-operations-bit-defaults-xor lib 2 *library-y*)))

(defun t2-completed-operations-build (lib)
  (proof-with-checked-results ((lib (t2-completed-operations-rounding-defaults lib)))
    (t2-completed-operations-bit-defaults lib)))
