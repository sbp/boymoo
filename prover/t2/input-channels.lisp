(in-package "BOYMOO-PROVER")
(set-verify-guards-eagerness 0)

(defconst *t2-input-channels-symbol-alist* (proof-sym "SYMBOL-ALISTP" "ACL2"))
(defconst *t2-input-channels-open-list* (proof-sym "OPEN-CHANNEL-LISTP" "ACL2"))
(defconst *t2-input-channels-open-entry* (proof-sym "OPEN-CHANNEL1" "ACL2"))
(defconst *t2-input-channels-update-input* (proof-sym "UPDATE-OPEN-INPUT-CHANNELS" "ACL2"))

(defun t2-input-channels-car (term)
  (list *t2-book-logic-car* term))

(defun t2-input-channels-cdr (term)
  (list *t2-book-logic-cdr* term))

(defun t2-input-channels-after-atom-test (lib equation shape)
  (let ((p (library-library-proof lib)))
    (proof-with-checked-results
     ((equation-first (proof-step-first equation))
      (conditional (proof-term-at equation-first 2))
      (test (proof-term-at conditional 1))
      (boundary (t2-input-fields-end-condition lib test))
      (shape-first (proof-step-first shape))
      (boundary-first (proof-step-first boundary))
      (boundary-test (proof-term-at boundary-first 2))
      (selection
       (if (equal shape-first boundary-test)
           (proof-proof-transport p shape boundary)
         (proof-with-checked-results
          ((opened (proof-proof-unfold p boundary-test))
           (value (t2-input-fields-select lib opened shape))
           (value (proof-proof-chain p boundary (list value))))
          (t2-input-fields-negated-value lib value)))))
     (t2-input-fields-select lib equation selection))))

(defun t2-input-channels-list-tests (lib evidence shape)
  (let ((p (library-library-proof lib)))
    (proof-with-checked-results
     ((literal (proof-step-first evidence))
      (opened (proof-proof-unfold p literal))
      (equation (t2-input-channels-after-atom-test lib opened shape))
      (proposition (proof-proof-rewrite p evidence equation '(1))))
     (t2-input-state-tests lib proposition))))

(defun t2-input-channels-cons-proof (lib pair)
  (if (integerp pair)
      '(:failure "failure" "")
    (library-inherited proof-proof-fact lib "consp-cons"
                       (seq-zip (list *library-x* *library-y*) (cdr pair)))))

(defun t2-input-channels-typed-lookup (lib)
  (let* ((p (library-library-proof lib))
         (table *library-x*)
         (key *library-y*)
         (entry (list *t2-input-fields-assoc* key table))
         (success (list *proof-consp* (t2-input-channels-cdr (t2-input-channels-cdr entry))))
         (is-cons (list *proof-consp* table)))
    (proof-with-checked-results
     ((symbol-list (proof-proof-assume p (list *t2-input-channels-symbol-alist* table) t))
      (open-list (proof-proof-assume p (list *t2-input-channels-open-list* table) t))
      (success-proof (proof-proof-assume p success t))
      (joined (t2-power-join lib (list symbol-list open-list success-proof)))
      (domain (proof-step-first joined))
      (assumed (proof-proof-assume p domain t))
      (parts (t2-input-state-tests lib assumed))
      (parts (proof-list-of-length parts 3))
      (symbols (car parts))
      (entries (cadr parts))
      (consumed (caddr parts))
      (cons-proof (proof-proof-assume p is-cons t))
      (symbol-parts (t2-input-channels-list-tests lib symbols cons-proof))
      (symbol-parts (proof-list-of-length symbol-parts 3))
      (head-key (cadr symbol-parts))
      (tail-symbols (caddr symbol-parts))
      (entry-parts (t2-input-channels-list-tests lib entries cons-proof))
      (entry-parts (proof-list-of-length entry-parts 2))
      (valid-head (car entry-parts))
      (tail-entries (cadr entry-parts))
      (head-key-first (proof-step-first head-key))
      (key-test (proof-term-at head-key-first 0))
      (key-type (proof-proof-assume p (list key-test key) t))
      (entry-type (proof-proof-assume p (list *t2-input-channels-open-entry*
                                              (t2-input-channels-cdr entry)) t))
      (conclusion-step (t2-power-join lib (list key-type entry-type)))
      (conclusion (proof-step-first conclusion-step))
      (formula (list *library-implies* domain conclusion))
      (opened (proof-proof-unfold p entry))
      (nonempty (t2-input-channels-after-atom-test lib opened cons-proof))
      (nonempty-first (proof-step-first nonempty))
      (nonempty-right (proof-term-at nonempty-first 2))
      (hit (proof-term-at nonempty-right 1))
      (key-true (proof-proof-assume p hit t))
      (present (t2-input-fields-select lib nonempty key-true))
      (key-reversed (proof-proof-symmetric p key-true))
      (symbol (proof-proof-rewrite p head-key key-reversed '(1 1)))
      (present-reversed (proof-proof-symmetric p present))
      (property (proof-proof-rewrite p valid-head present-reversed '(1 1 1)))
      (found (t2-power-join lib (list symbol property)))
      (key-false (proof-proof-assume p hit nil))
      (elsewhere (t2-input-fields-select lib nonempty key-false))
      (carry (proof-proof-rewrite p consumed elsewhere '(1 1 1 1)))
      (descent (library-library-builtin lib 3 table))
      (descent (proof-proof-discharge p descent cons-proof))
      (substitutions (list (list table (t2-input-channels-cdr table))))
      (tail (t2-power-smaller-instance lib formula descent substitutions
                                       (list tail-symbols tail-entries carry)))
      (elsewhere-reversed (proof-proof-symmetric p elsewhere))
      (later (proof-proof-rewrite p tail elsewhere-reversed '(1 2 1 1)))
      (step-cons (proof-proof-cases p hit found later))
      (atom-proof (proof-proof-assume p is-cons nil))
      (absent (t2-input-channels-after-atom-test lib opened atom-proof))
      (impossible (proof-proof-rewrite p consumed absent '(1 1 1 1)))
      (empty-cdr (t2-book-logic-constant lib (t2-input-channels-cdr *proof-false*)))
      (impossible (proof-proof-rewrite p impossible empty-cdr '(1 1 1)))
      (impossible (proof-proof-rewrite p impossible empty-cdr '(1 1)))
      (empty-consp (t2-book-logic-constant lib (list *proof-consp* *proof-false*)))
      (impossible (proof-proof-rewrite p impossible empty-consp '(1)))
      (step-atom (proof-proof-subsume p impossible
                                     (cons conclusion (cdr (proof-step-clause impossible)))))
      (step (proof-proof-cases p is-cons step-cons step-atom))
      (ordinal (library-library-builtin lib 1 table))
      (induction-case (t2-power-implication lib domain step))
      (proved (proof-proof-induct p ordinal induction-case formula
                                  (list *library-count* table) (list substitutions))))
     (library-library-lemma lib "READ-CHANNEL-LOOKUP" formula proved nil))))

(defun t2-input-channels-prefix-table (lib entry head tail)
  (let ((p (library-library-proof lib)))
    (proof-with-checked-results
     ((tail-first (proof-step-first tail))
      (table (proof-term-at tail-first 1))
      (result (list *proof-cons* entry table))
      (opened (proof-proof-unfold p (list *t2-input-channels-open-list* result)))
      (cons-proof (t2-input-channels-cons-proof lib result))
      (opened (t2-input-channels-after-atom-test lib opened cons-proof))
      (opened-first (proof-step-first opened))
      (opened-right (proof-term-at opened-first 2))
      (projected (t2-input-fields-project-cons-fields lib opened-right))
      (opened (proof-proof-chain p opened (list projected)))
      (joined (t2-power-join lib (list head tail))))
     (proof-proof-transport p joined opened))))

(defun t2-input-channels-typed-write (lib)
  (let* ((p (library-library-proof lib))
         (table *library-x*)
         (key *library-y*)
         (value *library-z*)
         (fresh (list *proof-cons* key value))
         (write-term (list *t2-input-fields-add-pair* key value table))
         (is-cons (list *proof-consp* table)))
    (proof-with-checked-results
     ((old (proof-proof-assume p (list *t2-input-channels-open-list* table) t))
      (good (proof-proof-assume p (list *t2-input-channels-open-entry* value) t))
      (joined (t2-power-join lib (list old good)))
      (domain (proof-step-first joined))
      (assumed (proof-proof-assume p domain t))
      (parts (t2-input-state-tests lib assumed))
      (parts (proof-list-of-length parts 2))
      (original (car parts))
      (value-type (cadr parts))
      (formula (list *library-implies* domain (list *t2-input-channels-open-list* write-term)))
      (cons-proof (proof-proof-assume p is-cons t))
      (original-parts (t2-input-channels-list-tests lib original cons-proof))
      (original-parts (proof-list-of-length original-parts 2))
      (head (car original-parts))
      (tail (cadr original-parts))
      (opened (proof-proof-unfold p write-term))
      (nonempty (t2-input-channels-after-atom-test lib opened cons-proof))
      (nonempty-first (proof-step-first nonempty))
      (nonempty-right (proof-term-at nonempty-first 2))
      (first-test (proof-term-at nonempty-right 1))
      (first-true (proof-proof-assume p first-test t))
      (same (t2-input-fields-select lib nonempty first-true))
      (remains (t2-input-channels-prefix-table lib fresh value-type tail))
      (remains (library-library-transport-argument lib remains same 1))
      (first-false (proof-proof-assume p first-test nil))
      (other (t2-input-fields-select lib nonempty first-false))
      (other-first (proof-step-first other))
      (other-right (proof-term-at other-first 2))
      (order-test (proof-term-at other-right 1))
      (order-true (proof-proof-assume p order-test t))
      (before (t2-input-fields-select lib other order-true))
      (inserted (t2-input-channels-prefix-table lib fresh value-type original))
      (inserted (library-library-transport-argument lib inserted before 1))
      (order-false (proof-proof-assume p order-test nil))
      (deeper (t2-input-fields-select lib other order-false))
      (descent (library-library-builtin lib 3 table))
      (descent (proof-proof-discharge p descent cons-proof))
      (pairs (list (list table (t2-input-channels-cdr table))))
      (suffix (t2-power-smaller-instance lib formula descent pairs (list tail value-type)))
      (recursive (t2-input-channels-prefix-table lib (t2-input-channels-car table) head suffix))
      (recursive (library-library-transport-argument lib recursive deeper 1))
      (order-cases (proof-proof-cases p order-test inserted recursive))
      (step-cons (proof-proof-cases p first-test remains order-cases))
      (atom-proof (proof-proof-assume p is-cons nil))
      (empty (t2-input-channels-after-atom-test lib opened atom-proof))
      (empty-table (proof-proof-unfold p (list *t2-input-channels-open-list* *proof-false*)))
      (empty-cons (t2-input-state-closed-boolean lib (list *proof-consp* *proof-false*) nil))
      (empty-table (t2-input-channels-after-atom-test lib empty-table empty-cons))
      (empty-table (proof-proof-true-from-eq p empty-table))
      (step-atom (t2-input-channels-prefix-table lib fresh value-type empty-table))
      (step-atom (library-library-transport-argument lib step-atom empty 1))
      (step (proof-proof-cases p is-cons step-cons step-atom))
      (ordinal (library-library-builtin lib 1 table))
      (induction-case (t2-power-implication lib domain step))
      (proved (proof-proof-induct p ordinal induction-case formula
                                  (list *library-count* table) (list pairs))))
     (library-library-lemma lib "READ-CHANNEL-TYPED-WRITE" formula proved nil))))

(defun t2-input-channels-typed-pop (lib)
  (let* ((p (library-library-proof lib))
         (x *library-x*)
         (tail (t2-input-channels-cdr x))
         (updated (list *proof-cons* (t2-input-channels-car x) (t2-input-channels-cdr tail))))
    (proof-with-checked-results
     ((old (proof-proof-assume p (list *t2-input-channels-open-entry* x) t))
      (consumed (proof-proof-assume p (list *proof-consp* tail) t))
      (old-first (proof-step-first old))
      (definition (proof-proof-unfold p old-first))
      (definition-first (proof-step-first definition))
      (definition-right (proof-term-at definition-first 2))
      (reduced (t2-input-fields-bindings lib definition-right))
      (opened (proof-proof-chain p definition (list reduced)))
      (old-opened (proof-proof-rewrite p old opened '(1)))
      (parts (t2-input-state-tests lib old-opened))
      (parts (proof-list-of-length parts 4))
      (is-list (car parts))
      (is-cons (cadr parts))
      (header (caddr parts))
      (object-types (cadddr parts))
      (list-first (proof-step-first is-list))
      (list-opened (proof-proof-unfold p list-first))
      (list-selected (t2-input-fields-select lib list-opened is-cons))
      (tail-list (proof-proof-rewrite p is-list list-selected '(1)))
      (tail-first (proof-step-first tail-list))
      (tail-opened (proof-proof-unfold p tail-first))
      (tail-selected (t2-input-fields-select lib tail-opened consumed))
      (next-list (proof-proof-rewrite p tail-list tail-selected '(1)))
      (object-parts (t2-input-channels-list-tests lib object-types consumed))
      (object-parts (proof-list-of-length object-parts 2))
      (remaining-types (cadr object-parts))
      (new-cons (t2-input-channels-cons-proof lib updated))
      (proper (proof-proof-unfold p (list *t2-input-state-true-list* updated)))
      (proper (t2-input-fields-select lib proper new-cons))
      (proper-first (proof-step-first proper))
      (proper-right (proof-term-at proper-first 2))
      (proper-fields (t2-input-fields-project-cons-fields lib proper-right))
      (proper (proof-proof-chain p proper (list proper-fields)))
      (new-list (proof-proof-transport p next-list proper))
      (new (proof-proof-unfold p (list *t2-input-channels-open-entry* updated)))
      (new-first (proof-step-first new))
      (new-right (proof-term-at new-first 2))
      (new-bindings (t2-input-fields-bindings lib new-right))
      (new (proof-proof-chain p new (list new-bindings)))
      (new-first (proof-step-first new))
      (new-right (proof-term-at new-first 2))
      (new-fields (t2-input-fields-project-cons-fields lib new-right))
      (new (proof-proof-chain p new (list new-fields)))
      (joined (t2-power-join lib (list new-list new-cons header remaining-types)))
      (proved (proof-proof-transport p joined new))
      (claim (proof-step-first proved))
      (consumed-first (proof-step-first consumed)))
     (library-library-lemma lib "READ-CHANNEL-DROP-OBJECT" claim proved
                            (library-guards (list old-first consumed-first))))))

(defun t2-input-channels-read-channel-table (lib)
  (let* ((p (library-library-proof lib))
         (x *library-x*)
         (y *library-y*)
         (channel (list *t2-input-fields-assoc* y x)))
    (proof-with-checked-results
     ((opened (proof-proof-assume p (list *t2-input-state-open-channels* x) t))
      (opened-first (proof-step-first opened))
      (definition (proof-proof-unfold p opened-first))
      (tested (proof-proof-rewrite p opened definition '(1)))
      (parts (t2-input-state-tests lib tested))
      (parts (proof-list-of-length parts 2))
      (ordered (car parts))
      (entries (cadr parts))
      (symbols (t2-input-state-instantiate
                lib "ORDERED-SYMBOL-ALISTP-FORWARD-TO-SYMBOL-ALISTP" "X" (list x)))
      (symbols (t2-arithmetic-arithmetic-modus-ponens lib symbols ordered))
      (consumed (proof-proof-assume p
                 (list *proof-consp* (t2-input-channels-cdr (t2-input-channels-cdr channel))) t))
      (lookup (library-library-cite lib "READ-CHANNEL-LOOKUP" (list x y) nil))
      (evidence (t2-power-join lib (list symbols entries consumed)))
      (lookup (t2-arithmetic-arithmetic-modus-ponens lib lookup evidence))
      (types (t2-input-state-tests lib lookup))
      (types (proof-list-of-length types 2))
      (key-type (car types))
      (entry-type (cadr types))
      (value (library-library-cite lib "READ-CHANNEL-DROP-OBJECT"
                                   (list (t2-input-channels-cdr channel))
                                   (list entry-type consumed)))
      (value-first (proof-step-first value))
      (head (proof-term-at value-first 1))
      (new-order (t2-input-state-ordered-write lib x y head ordered key-type))
      (new-entries (library-library-cite lib "READ-CHANNEL-TYPED-WRITE" (list x y head) nil))
      (write-evidence (t2-power-join lib (list entries value)))
      (new-entries (t2-arithmetic-arithmetic-modus-ponens lib new-entries write-evidence))
      (new-entries-first (proof-step-first new-entries))
      (new-entries-term (proof-term-at new-entries-first 1))
      (new-table (list *t2-input-state-open-channels* new-entries-term))
      (joined (t2-power-join lib (list new-order new-entries)))
      (new-opened (proof-proof-unfold p new-table))
      (proved (proof-proof-transport p joined new-opened))
      (claim (proof-step-first proved))
      (consumed-first (proof-step-first consumed)))
     (library-library-lemma lib "READ-CHANNELS-CONSUME" claim proved
                            (library-guards (list opened-first consumed-first))))))

(defun t2-input-channels-read-state-branch (lib holds test opened read printed printed-state old-channels)
  (let ((p (library-library-proof lib)))
    (proof-with-checked-results
     ((branch (proof-proof-assume p test holds))
      (chosen (t2-input-fields-select lib opened branch))
      (reflexive (proof-proof-reflexive p read))
      (projected (proof-proof-rewrite p reflexive chosen '(1 2 2)))
      (chosen-first (proof-step-first chosen))
      (chosen-right (proof-term-at chosen-first 2))
      (projection (t2-input-fields-cons-projection lib *t2-input-fields-mv-nth* 2 chosen-right))
      (projected (proof-proof-chain p projected (list projection)))
      (projected-first (proof-step-first projected))
      (value (proof-term-at projected-first 2))
      (proved
       (if holds
           (if (not (proof-is-call value *t2-input-channels-update-input*))
               '(:failure "failure" "")
             (proof-with-checked-results
              ((changed (library-library-cite lib "READ-CHANNELS-CONSUME"
                         (list (list *t2-input-fields-channels* printed-state) *library-x*)
                         (list old-channels branch)))
               (table (proof-term-at value 1)))
              (library-library-cite lib "STATE-P1-INPUT-TABLE-WRITE" (list printed-state table)
                                    (list printed changed))))
         printed)))
     (library-library-transport-argument lib proved projected 1))))

(defun t2-input-channels-preserve-read-state (lib)
  (let ((p (library-library-proof lib))
        (x *library-x*)
        (y *library-y*))
    (proof-with-checked-results
     ((original (proof-proof-assume p (list *t2-input-state-state* y) t))
      (printed (library-library-cite lib "STATE-P1-PRINT-ORACLE" (list y) (list original)))
      (printed-first (proof-step-first printed))
      (printed-state (proof-term-at printed-first 1))
      (definition (proof-proof-unfold p printed-first))
      (printed-opened (proof-proof-rewrite p printed definition '(1)))
      (old-channels (t2-input-state-tests-first
                     lib printed-opened
                     (list *t2-input-state-open-channels*
                           (list *t2-input-fields-channels* printed-state))))
      (opened (proof-proof-unfold p (list *t2-input-fields-read-object* x y)))
      (opened-first (proof-step-first opened))
      (opened-right (proof-term-at opened-first 2))
      (reduced (t2-input-fields-bindings lib opened-right))
      (opened (proof-proof-chain p opened (list reduced)))
      (opened-first (proof-step-first opened))
      (opened-right (proof-term-at opened-first 2))
      (test (proof-term-at opened-right 1))
      (read (t2-input-fields-result-state x y))
      (success (t2-input-channels-read-state-branch lib t test opened read printed printed-state old-channels))
      (failure (t2-input-channels-read-state-branch lib nil test opened read printed printed-state old-channels))
      (original-first (proof-step-first original))
      (cases (proof-proof-cases p test success failure))
      (proven (t2-power-implication lib original-first cases))
      (claim (proof-step-first proven)))
     (library-library-lemma lib "READ-OBJECT-PRESERVES-STATE-P1" claim proven nil))))

(defun t2-input-channels-build (lib)
  (proof-with-checked-results
   ((lib (t2-input-channels-typed-lookup lib))
    (lib (t2-input-channels-typed-write lib))
    (lib (t2-input-channels-typed-pop lib))
    (lib (t2-input-channels-read-channel-table lib)))
   (t2-input-channels-preserve-read-state lib)))
