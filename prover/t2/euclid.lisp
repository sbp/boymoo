(in-package "BOYMOO-PROVER")
(set-verify-guards-eagerness 0)

(defconst *t2-euclid-gcd* (proof-sym "SELF-EUCLID-GCD" "ACL2"))
(defconst *t2-euclid-coeff-x* (proof-sym "SELF-EUCLID-X" "ACL2"))
(defconst *t2-euclid-coeff-y* (proof-sym "SELF-EUCLID-Y" "ACL2"))
(defconst *t2-euclid-functions*
  (list *t2-euclid-gcd* *t2-euclid-coeff-x* *t2-euclid-coeff-y*))
(defconst *t2-euclid-measure*
  (list *library-count* (library-plus *library-x* *library-y*)))
(defconst *t2-euclid-first-coefficient* (proof-sym "A" "ACL2"))
(defconst *t2-euclid-second-coefficient* (proof-sym "B" "ACL2"))

(defun t2-euclid-selection (left right)
  (proof-ite (library-positive left) *proof-true* (library-positive right)))

(defun t2-euclid-either-positive (lib left right evidence)
  (let ((branch (library-positive left))
        (formula (t2-euclid-selection left right))
        (proof (library-library-proof lib)))
    (proof-with-checked-results
        ((true-step (t2-arithmetic-arithmetic-prove lib *proof-true* nil nil))
         (if-true (proof-proof-if-true proof formula))
         (yes (proof-proof-transport proof true-step if-true))
         (literal (proof-step-first evidence)))
      (if (equal literal branch)
          (proof-proof-discharge proof yes evidence)
        (proof-with-checked-results
            ((if-false (proof-proof-if-false proof formula))
             (no (proof-proof-transport proof evidence if-false)))
          (proof-proof-cases proof branch yes no))))))

(defun t2-euclid-descent-lemma (lib remaining smaller name changed-positive
                                   remaining-positive integers)
  (let ((total (library-plus *library-x* *library-y*)))
    (proof-with-checked-results
        ((strict (t2-arithmetic-less-from-difference lib remaining total changed-positive integers))
         (weak (t2-arithmetic-arithmetic-as-weak lib strict integers))
         (int-total (t2-arithmetic-arithmetic-type-of lib total integers))
         (int-remaining (t2-arithmetic-arithmetic-type-of lib remaining integers))
         (descent (t2-subtraction-count-subtraction lib int-total int-remaining
                                                    remaining-positive weak))
         (lib (cdr descent))
         (equality (t2-arithmetic-linear-equal lib (library-diff total remaining) smaller integers))
         (step (proof-proof-rewrite (library-library-proof lib) (car descent) equality '(1 1 1)))
         (literal (proof-step-first step)))
      (library-library-lemma lib name literal step
                             (library-guards
                              (list (library-integer *library-x*) (library-integer *library-y*)
                                    (library-positive *library-x*) (library-positive *library-y*)))))))

(defun t2-euclid-descents (lib)
  (let ((x *library-x*) (y *library-y*) (proof (library-library-proof lib)))
    (proof-with-checked-results
        ((integers (library-library-ints lib (list x y)))
         (positive-x (proof-proof-assume proof (library-positive x) t))
         (positive-y (proof-proof-assume proof (library-positive y) t))
         (lib (t2-euclid-descent-lemma lib y (library-plus (library-diff x y) y)
                                     "EUCLID-SUBTRACT-Y" positive-x positive-y integers)))
      (t2-euclid-descent-lemma lib x (library-plus x (library-diff y x))
                              "EUCLID-SUBTRACT-X" positive-y positive-x integers))))

(defun t2-euclid-definition (name less greater x-only y-only)
  (let* ((x *library-x*) (y *library-y*)
         (recursive (proof-ite (library-lt x y) less greater))
         (positive-pair (proof-ite (library-positive x)
                                  (proof-ite (library-positive y) recursive x-only)
                                  y-only)))
    (list name (list x y)
          (proof-ite (library-integer x)
                     (proof-ite (library-integer y) positive-pair *proof-zero*)
                     *proof-zero*))))

(defun t2-euclid-definitions ()
  (let* ((x *library-x*) (y *library-y*)
         (smaller-x (library-diff x y))
         (smaller-y (library-diff y x))
         (gcd-x (list *t2-euclid-gcd* smaller-x y))
         (a-x (list *t2-euclid-coeff-x* smaller-x y))
         (b-x (list *t2-euclid-coeff-y* smaller-x y))
         (gcd-y (list *t2-euclid-gcd* x smaller-y))
         (a-y (list *t2-euclid-coeff-x* x smaller-y))
         (b-y (list *t2-euclid-coeff-y* x smaller-y)))
    (list (t2-euclid-definition *t2-euclid-gcd* gcd-y gcd-x x y)
          (t2-euclid-definition *t2-euclid-coeff-x* (library-diff a-y b-y) a-x
                                *proof-one* *proof-zero*)
          (t2-euclid-definition *t2-euclid-coeff-y* b-y (library-diff b-x a-x)
                                *proof-zero* *proof-one*))))

(defun t2-euclid-install-goals (proof goals steps)
  (if (endp goals)
      nil
    (let ((goal (car goals)))
      (proof-with-checked-results ((literal (proof-term-at goal (nfix (1- (len goal))))))
        (let ((entry (assoc-equal literal steps)))
          (if (not entry)
              '(:failure "failure" "")
            (proof-with-checked-results
                ((step (proof-proof-subsume proof (cdr entry) goal))
                 (rest (t2-euclid-install-goals proof (cdr goals) steps)))
              (cons step rest))))))))

(defun t2-euclid-add-definitions (proof definitions)
  (if (endp definitions)
      proof
    (let ((definition (car definitions)))
      (t2-euclid-add-definitions
       (proof-proof-add-definition proof (car definition) (cadr definition) (caddr definition))
       (cdr definitions)))))

(defun t2-euclid-install (lib)
  (let* ((x *library-x*) (y *library-y*)
         (proof (library-library-proof lib))
         (definitions (t2-euclid-definitions))
         (rulers (list *proof-if*))
         (measures (pairlis$ *t2-euclid-functions*
                             (list *t2-euclid-measure* *t2-euclid-measure* *t2-euclid-measure*))))
    (proof-with-checked-results
        ((calls (termination-recursive-calls rulers definitions))
         (base (library-library-builtin lib 1 (cadr *t2-euclid-measure*)))
         (integers (library-library-ints lib (list x y)))
         (positive-x (proof-proof-assume proof (library-positive x) t))
         (positive-y (proof-proof-assume proof (library-positive y) t))
         (premises (append integers (list positive-x positive-y)))
         (left (library-library-cite lib "EUCLID-SUBTRACT-Y" (list x y) premises))
         (right (library-library-cite lib "EUCLID-SUBTRACT-X" (list x y) premises))
         (base-literal (proof-step-first base))
         (left-literal (proof-step-first left))
         (right-literal (proof-step-first right))
         (steps (table-put (table-put (list (cons base-literal base)) left-literal left)
                             right-literal right))
         (goals (termination-obligations definitions measures calls))
         (proofs (t2-euclid-install-goals proof goals steps))
         (measure (proof-proof-entry "measure" *t2-euclid-gcd*
                                     (cons *t2-euclid-gcd* (table-values measures)) proofs))
         (new-proof (t2-euclid-add-definitions proof definitions))
         (source (proof-line "define" (cons rulers definitions))))
      (library-make-library
       new-proof
       (append (library-library-entries lib)
               (list (list "define" *t2-euclid-gcd* (caddr measure)
                           (concatenate 'string source (cadddr measure)))))))))

(defun t2-euclid-multiple (divisor value)
  (t2-products-times (t2-field-reciprocal divisor) value))

(defun t2-euclid-properties (x y)
  (let ((gcd (list *t2-euclid-gcd* x y))
        (a (list *t2-euclid-coeff-x* x y))
        (b (list *t2-euclid-coeff-y* x y)))
    (list (library-integer gcd) (library-positive gcd)
          (library-integer a) (library-integer b)
          (proof-eq gcd (library-plus (t2-products-times a x) (t2-products-times b y)))
          (library-integer (t2-euclid-multiple gcd x))
          (library-integer (t2-euclid-multiple gcd y)))))

(defun t2-euclid-select-step (proof equation evidence)
  (proof-with-checked-results
      ((literal (proof-step-first equation))
       (rhs (proof-term-at literal 2))
       (selected (proof-proof-select proof rhs evidence)))
    (proof-proof-chain proof equation (list selected))))

(defun t2-euclid-select-branch (proof equation evidence)
  (declare (xargs :measure (acl2-count evidence)))
  (if (or (endp evidence) (failure-p equation))
      equation
    (t2-euclid-select-branch proof (t2-euclid-select-step proof equation (car evidence))
                             (cdr evidence))))

(defun t2-euclid-branch-equation (proof name evidence)
  (proof-with-checked-results
      ((opened (proof-proof-unfold proof (list name *library-x* *library-y*))))
    (t2-euclid-select-branch proof opened evidence)))

(defun t2-euclid-branch-values (lib evidence)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((gcd (t2-euclid-branch-equation proof *t2-euclid-gcd* evidence))
         (a (t2-euclid-branch-equation proof *t2-euclid-coeff-x* evidence))
         (b (t2-euclid-branch-equation proof *t2-euclid-coeff-y* evidence)))
      (list gcd a b))))

(defun t2-euclid-scale-difference (lib scale whole part)
  (proof-with-checked-results
      ((equation (library-library-axiom lib "DISTRIBUTIVITY"
                                       (list scale whole (library-minus part))))
       (negative (library-library-cite lib "FIELD-NEGATIVE-FACTOR" (list scale part) nil)))
    (proof-proof-rewrite (library-library-proof lib) equation negative '(1 2 2))))

(defun t2-euclid-restore-combination (lib whole part a b)
  (let ((proof (library-library-proof lib))
        (original (library-plus (t2-products-times a (library-diff whole part))
                                (t2-products-times b part))))
    (proof-with-checked-results
        ((original-proof (proof-proof-reflexive proof original))
         (scaled (t2-euclid-scale-difference lib a whole part))
         (left (proof-proof-rewrite proof original-proof scaled '(1 2 1)))
         (commute-diff (library-library-axiom lib "COMMUTATIVITY-OF-*" (list (library-diff b a) part)))
         (scaled (t2-euclid-scale-difference lib part b a))
         (right-factor (proof-proof-chain proof commute-diff (list scaled)))
         (commute-b (library-library-axiom lib "COMMUTATIVITY-OF-*" (list part b)))
         (right-factor (proof-proof-rewrite proof right-factor commute-b '(1 2 1)))
         (commute-a (library-library-axiom lib "COMMUTATIVITY-OF-*" (list part a)))
         (right-factor (proof-proof-rewrite proof right-factor commute-a '(1 2 2 1)))
         (factor-equality (proof-step-first right-factor))
         (desired (library-plus (t2-products-times a whole) (cadr factor-equality)))
         (desired-proof (proof-proof-reflexive proof desired))
         (right (proof-proof-rewrite proof desired-proof right-factor '(1 2 2)))
         (left-literal (proof-step-first left))
         (right-literal (proof-step-first right))
         (meet (t2-book-logic-ac-equal lib (caddr left-literal) (caddr right-literal)))
         (reverse (proof-proof-symmetric proof right)))
      (proof-proof-chain proof left (list meet reverse)))))

(defun t2-euclid-reconstruction-lemmas (lib)
  (let* ((x *library-x*) (y *library-y*) (z *library-z*)
         (difference (library-diff x y)))
    (proof-with-checked-results
        ((combination (t2-euclid-restore-combination lib x y
                                                   *t2-euclid-first-coefficient*
                                                   *t2-euclid-second-coefficient*))
         (claim (proof-step-first combination))
         (lib (library-library-lemma lib "EUCLID-RESTORE-COMBINATION" claim combination nil))
         (proof (library-library-proof lib))
         (integers (library-library-ints lib (list x y)))
         (restored (t2-arithmetic-linear-equal lib x (library-plus difference y) integers))
         (reflexive (proof-proof-reflexive proof (t2-products-times z x)))
         (equation (proof-proof-rewrite proof reflexive restored '(1 2 2)))
         (distributivity (library-library-axiom lib "DISTRIBUTIVITY" (list z difference y)))
         (equation (proof-proof-chain proof equation (list distributivity)))
         (multiples (library-library-ints lib (list (t2-products-times z difference)
                                                   (t2-products-times z y))))
         (expanded (proof-step-first equation))
         (integral (t2-arithmetic-arithmetic-type-of lib (caddr expanded) multiples))
         (step (library-library-transport-argument lib integral equation 1))
         (literal (proof-step-first step))
         (ix (proof-step-first (car integers)))
         (iy (proof-step-first (cadr integers)))
         (md (proof-step-first (car multiples)))
         (my (proof-step-first (cadr multiples))))
      (library-library-lemma lib "EUCLID-RESTORE-DIVISIBILITY" literal step
                             (library-guards (list ix iy md my))))))

(defun t2-euclid-combination (lib whole part first second)
  (proof-proof-fact (library-library-proof lib)
                    (proof-sym "SELF-EUCLID-RESTORE-COMBINATION" "ACL2")
                    (list (list *library-x* whole) (list *library-y* part)
                          (list *t2-euclid-first-coefficient* first)
                          (list *t2-euclid-second-coefficient* second))))

(defun t2-euclid-restore-divisibility (lib whole part divisor divides-difference divides-part integers)
  (proof-with-checked-results
      ((int-whole (t2-arithmetic-arithmetic-type-of lib whole integers))
       (int-part (t2-arithmetic-arithmetic-type-of lib part integers)))
    (library-library-cite lib "EUCLID-RESTORE-DIVISIBILITY"
                          (list whole part (t2-field-reciprocal divisor))
                          (list int-whole int-part divides-difference divides-part))))

(defun t2-euclid-base-domain (lib domain x-positive)
  (let ((proof (library-library-proof lib))
        (ix (car domain)) (iy (cadr domain))
        (x *library-x*) (y *library-y*))
    (if x-positive
        (proof-with-checked-results
            ((positive-value (proof-proof-assume proof (library-positive x) t))
             (y-test (proof-proof-assume proof (library-positive y) nil)))
          (list x y ix iy positive-value y-test (cadddr domain)
                (list ix iy positive-value y-test)))
      (proof-with-checked-results
          ((x-test (proof-proof-assume proof (library-positive x) nil))
           (positive-value (proof-proof-prove-if proof (nth 4 domain) x-test)))
        (list y x iy ix positive-value x-test (caddr domain) (list ix iy x-test))))))

(defun t2-euclid-rewrite-divisor (proof divisor gcd)
  (proof-with-checked-results ((reverse (proof-proof-symmetric proof gcd)))
    (proof-proof-rewrite proof divisor reverse '(1 1 1 1))))

(defun t2-euclid-base-divisors (lib base-domain gcd x-positive)
  (let* ((proper (car base-domain)) (empty (cadr base-domain))
         (proper-int (caddr base-domain)) (empty-int (cadddr base-domain))
         (positive-value (nth 4 base-domain)) (no-positive (nth 5 base-domain))
         (no-negative (nth 6 base-domain))
         (reciprocal (t2-field-reciprocal proper))
         (proof (library-library-proof lib)))
    (proof-with-checked-results
        ((proper-number (t2-arithmetic-number lib proper (list proper-int)))
         (empty-number (t2-arithmetic-number lib empty (list empty-int)))
         (zero (t2-order-zero-from-sign lib empty no-positive no-negative empty-number))
         (distinct (t2-order-distinct lib positive-value))
         (different (t2-products-flip-neq lib distinct))
         (commute (library-library-axiom lib "COMMUTATIVITY-OF-*" (list reciprocal proper)))
         (inverse (t2-field-inverse lib proper-number different))
         (divide (proof-proof-chain proof commute (list inverse)))
         (empty-reflexive (proof-proof-reflexive proof (t2-euclid-multiple proper empty)))
         (empty-divide (proof-proof-rewrite proof empty-reflexive zero '(1 2 2)))
         (product-zero (t2-products-product-zero lib reciprocal))
         (lib (cdr product-zero))
         (proof (library-library-proof lib))
         (empty-divide (proof-proof-chain proof empty-divide (list (car product-zero))))
         (int-one (t2-arithmetic-arithmetic-type-of lib *proof-one* nil))
         (nonempty-type (library-library-transport-argument lib int-one divide 1))
         (int-zero (t2-arithmetic-arithmetic-type-of lib *proof-zero* nil))
         (empty-type (library-library-transport-argument lib int-zero empty-divide 1))
         (first (t2-euclid-rewrite-divisor proof (if x-positive nonempty-type empty-type) gcd))
         (second (t2-euclid-rewrite-divisor proof (if x-positive empty-type nonempty-type) gcd)))
      (cons (list first second) lib))))

(defun t2-euclid-base-product (lib factor value integers)
  (let ((proof (library-library-proof lib)))
    (if (equal factor *proof-one*)
        (proof-with-checked-results
            ((commute (library-library-axiom lib "COMMUTATIVITY-OF-*" (list *proof-one* value)))
             (number (t2-arithmetic-number lib value integers))
             (identity (t2-field-identity lib value number *proof-times*))
             (step (proof-proof-chain proof commute (list identity))))
          (cons step lib))
      (proof-with-checked-results ((zero (proof-proof-reflexive proof *proof-zero*)))
        (t2-field-zero-product-from-left lib *proof-zero* value zero)))))

(defun t2-euclid-base-reduce (lib reduced value coefficient index integers)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((literal (proof-step-first coefficient))
         (factor (proof-term-at literal 2))
         (reduced (proof-proof-rewrite proof reduced coefficient (list 1 2 index 1)))
         (product (t2-euclid-base-product lib factor value integers))
         (lib (cdr product))
         (next (proof-proof-rewrite (library-library-proof lib) reduced (car product)
                                    (list 1 2 index))))
      (cons next lib))))

(defun t2-euclid-type-coefficient (lib equation)
  (proof-with-checked-results
      ((literal (proof-step-first equation))
       (term (proof-term-at literal 2))
       (type-step (t2-arithmetic-arithmetic-type-of lib term nil)))
    (library-library-transport-argument lib type-step equation 1)))

(defun t2-euclid-base-combination (lib proper integers equations)
  (let* ((x *library-x*) (y *library-y*)
         (proof (library-library-proof lib))
         (gcd (car equations))
         (combo (caddr (nth 4 (t2-euclid-properties x y)))))
    (proof-with-checked-results
        ((reflexive (proof-proof-reflexive proof combo))
         (reduction (t2-euclid-base-reduce lib reflexive x (cadr equations) 1 integers))
         (reduction (t2-euclid-base-reduce (cdr reduction) (car reduction) y (caddr equations) 2 integers))
         (lib (cdr reduction))
         (proof (library-library-proof lib))
         (literal (proof-step-first (car reduction)))
         (equality (t2-arithmetic-linear-equal lib (caddr literal) proper integers))
         (reduced (proof-proof-chain proof (car reduction) (list equality)))
         (reverse (proof-proof-symmetric proof reduced))
         (combination (proof-proof-chain proof gcd (list reverse))))
      (cons combination lib))))

(defun t2-euclid-base (lib domain x-positive)
  (proof-with-checked-results
      ((domain (proof-list-of-length domain 5))
       (facts (t2-euclid-base-domain lib domain x-positive))
       (equations (t2-euclid-branch-values lib (nth 7 facts)))
       (gcd (car equations))
       (literal (proof-step-first gcd))
       (value (proof-term-at literal 2)))
    (if (not (equal value (car facts)))
        '(:failure "failure" "")
      (proof-with-checked-results
          ((divisors (t2-euclid-base-divisors lib facts gcd x-positive))
           (combination (t2-euclid-base-combination (cdr divisors) (car facts)
                                                   (list (car domain) (cadr domain)) equations))
           (lib (cdr combination))
           (type-a (t2-euclid-type-coefficient lib (cadr equations)))
           (type-b (t2-euclid-type-coefficient lib (caddr equations)))
           (type-gcd (library-library-transport-argument lib (caddr facts) gcd 1))
           (positive-gcd (library-library-transport-argument lib (nth 4 facts) gcd 2))
           (step (t2-power-join lib (append (list type-gcd positive-gcd type-a type-b
                                                (car combination))
                                           (car divisors)))))
        (cons step lib)))))

(defun t2-euclid-descend-bounds (lib branch integers px py subtract-from-x)
  (let ((x *library-x*) (y *library-y*) (proof (library-library-proof lib))
        (ix (car integers)) (iy (cadr integers)))
    (if subtract-from-x
        (let ((left (library-diff x y)))
          (proof-with-checked-results
              ((bound-left (t2-subtraction-nonnegative-difference lib branch))
               (bound-right (library-library-cite lib "POSITIVE-NONNEGATIVE" (list y) (list iy py))))
            (list left y bound-left bound-right (list (list x left)) "EUCLID-SUBTRACT-Y" py)))
      (let ((right (library-diff y x)))
        (proof-with-checked-results
            ((bound-left (library-library-cite lib "POSITIVE-NONNEGATIVE" (list x) (list ix px)))
             (int-right (t2-arithmetic-arithmetic-type-of lib right integers))
             (comparison (t2-arithmetic-comparison lib x y integers))
             (positive (proof-proof-rewrite proof branch comparison '(1)))
             (bound-right (library-library-cite lib "POSITIVE-NONNEGATIVE"
                                                 (list right) (list int-right positive))))
          (list x right bound-left bound-right (list (list y right)) "EUCLID-SUBTRACT-X" px))))))

(defun t2-euclid-descend-adjust (lib hypothesis left right integers subtract-from-x)
  (let* ((x *library-x*) (y *library-y*)
         (proof (library-library-proof lib))
         (child-gcd (list *t2-euclid-gcd* left right))
         (child-a (list *t2-euclid-coeff-x* left right))
         (child-b (list *t2-euclid-coeff-y* left right))
         (ai (caddr hypothesis)) (bi (cadddr hypothesis))
         (combined (nth 4 hypothesis))
         (divides-x (nth 5 hypothesis)) (divides-y (nth 6 hypothesis))
         (types (list ai bi)))
    (if subtract-from-x
        (proof-with-checked-results
            ((adjusted (t2-euclid-combination lib x y child-a child-b))
             (type-b (t2-arithmetic-arithmetic-type-of lib (library-diff child-b child-a) types))
             (divides-x (t2-euclid-restore-divisibility lib x y child-gcd divides-x divides-y integers)))
          (list adjusted ai type-b divides-x divides-y))
      (proof-with-checked-results
          ((adjusted (t2-euclid-combination lib y x child-b child-a))
           (combined-literal (proof-step-first combined))
           (exchange (library-library-axiom lib "COMMUTATIVITY-OF-+" (cdr (caddr combined-literal))))
           (adjusted-literal (proof-step-first adjusted))
           (exchange-back (library-library-axiom lib "COMMUTATIVITY-OF-+" (cdr (caddr adjusted-literal))))
           (adjusted (proof-proof-chain proof exchange (list adjusted exchange-back)))
           (type-a (t2-arithmetic-arithmetic-type-of lib (library-diff child-a child-b) types))
           (divides-y (t2-euclid-restore-divisibility lib y x child-gcd divides-y divides-x integers)))
        (list adjusted type-a bi divides-x divides-y)))))

(defun t2-euclid-descend-combine (lib hypothesis equations adjusted)
  (let ((proof (library-library-proof lib)) (gcd (car equations))
        (a (cadr equations)) (b (caddr equations)))
    (proof-with-checked-results
        ((identity (proof-proof-chain proof gcd (list (nth 4 hypothesis) (car adjusted))))
         (reverse-a (proof-proof-symmetric proof a))
         (identity (proof-proof-rewrite proof identity reverse-a '(1 2 1 1)))
         (reverse-b (proof-proof-symmetric proof b))
         (identity (proof-proof-rewrite proof identity reverse-b '(1 2 2 1)))
         (type-a (library-library-transport-argument lib (cadr adjusted) a 1))
         (type-b (library-library-transport-argument lib (caddr adjusted) b 1))
         (divides-x (t2-euclid-rewrite-divisor proof (cadddr adjusted) gcd))
         (divides-y (t2-euclid-rewrite-divisor proof (nth 4 adjusted) gcd))
         (type-gcd (library-library-transport-argument lib (car hypothesis) gcd 1))
         (positive-gcd (library-library-transport-argument lib (cadr hypothesis) gcd 2)))
      (t2-power-join lib (list type-gcd positive-gcd type-a type-b identity divides-x divides-y)))))

(defun t2-euclid-descend (lib formula domain subtract-from-x)
  (let ((x *library-x*) (y *library-y*) (proof (library-library-proof lib)))
    (proof-with-checked-results
        ((domain (proof-list-of-length domain 5))
         (integers (list (car domain) (cadr domain)))
         (px (proof-proof-assume proof (library-positive x) t))
         (py (proof-proof-assume proof (library-positive y) t))
         (branch (proof-proof-assume proof (library-lt x y) (not subtract-from-x)))
         (evidence (append integers (list px py)))
         (equations (t2-euclid-branch-values lib (append evidence (list branch))))
         (bounds (t2-euclid-descend-bounds lib branch integers px py subtract-from-x))
         (left (car bounds))
         (right (cadr bounds))
         (pairs (nth 4 bounds))
         (descent (library-library-cite lib (nth 5 bounds) (list x y) evidence))
         (int-left (t2-arithmetic-arithmetic-type-of lib left integers))
         (int-right (t2-arithmetic-arithmetic-type-of lib right integers))
         (positive (t2-euclid-either-positive lib left right (nth 6 bounds)))
         (subdomain (list int-left int-right (caddr bounds) (cadddr bounds) positive))
         (hypothesis (t2-power-smaller-instance lib formula descent pairs subdomain))
         (facts (t2-power-conjuncts lib hypothesis 7))
         (adjusted (t2-euclid-descend-adjust lib facts left right integers subtract-from-x))
         (step (t2-euclid-descend-combine lib facts equations adjusted)))
      (list step pairs))))

(defun t2-euclid-build (lib)
  (let ((x *library-x*) (y *library-y*))
    (proof-with-checked-results
        ((lib (t2-euclid-descents lib))
         (lib (t2-euclid-install lib))
         (lib (t2-euclid-reconstruction-lemmas lib))
         (proof (library-library-proof lib))
         (premises (list (library-integer x) (library-integer y)
                         (library-nonnegative x) (library-nonnegative y) (t2-euclid-selection x y)))
         (domain (t2-power-condition premises))
         (assumed (proof-proof-assume proof domain t))
         (facts (t2-power-conjuncts lib assumed (len premises)))
         (conclusion (t2-power-condition (t2-euclid-properties x y)))
         (formula (list *library-implies* domain conclusion))
         (left (t2-euclid-descend lib formula facts t))
         (right (t2-euclid-descend lib formula facts nil))
         (inner (proof-proof-cases proof (library-lt x y) (car right) (car left)))
         (x-base (t2-euclid-base lib facts t))
         (lib (cdr x-base))
         (x-positive (proof-proof-cases (library-library-proof lib) (library-positive y)
                                        inner (car x-base)))
         (y-base (t2-euclid-base lib facts nil))
         (lib (cdr y-base))
         (proof (library-library-proof lib))
         (step (proof-proof-cases proof (library-positive x) x-positive (car y-base)))
         (ordinal (library-library-builtin lib 1 (cadr *t2-euclid-measure*)))
         (implied (t2-power-implication lib domain step))
         (invariant (proof-proof-induct proof ordinal implied formula *t2-euclid-measure*
                                        (list (cadr left) (cadr right)))))
      (library-library-lemma lib "EUCLID-INVARIANT" formula invariant nil))))

(defun t2-euclid-invariant (lib first second int-first int-second bound-first bound-second positive-arg)
  (proof-with-checked-results
      ((step (library-library-cite lib "EUCLID-INVARIANT" (list first second) nil))
       (positive (t2-euclid-either-positive lib first second positive-arg))
       (domain (t2-power-join lib (list int-first int-second bound-first bound-second positive)))
       (consequent (t2-arithmetic-arithmetic-modus-ponens lib step domain)))
    (t2-power-conjuncts lib consequent 7)))
