(in-package "BOYMOO-PROVER")

(set-verify-guards-eagerness 0)

(defconst *t2-ratios-abs* (proof-cl "ABS"))

(defun t2-ratios-numerator (term)
  (list *t2-arithmetic-numerator* term))

(defun t2-ratios-denominator (term)
  (list *t2-arithmetic-denominator* term))

(defun t2-ratios-step-at (step index)
  (proof-with-checked-results ((literal (proof-step-first step)))
    (proof-term-at literal index)))

(defun t2-ratios-add-lemma (lib name step conditions)
  (proof-with-checked-results ((claim (proof-step-first step)))
    (library-library-lemma lib name claim step conditions)))

(defun t2-ratios-cancel-positive (lib positive-factor integer-factor integer-value)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((factor (t2-ratios-step-at positive-factor 2))
         (value (t2-ratios-step-at integer-value 1))
         (product (library-library-axiom
                   lib "ASSOCIATIVITY-OF-*" (list factor (t2-field-reciprocal factor) value)))
         (factor-number (t2-arithmetic-number lib factor (list integer-factor)))
         (distinct (t2-order-distinct lib positive-factor))
         (nonzero (t2-products-flip-neq lib distinct))
         (inverse-product (t2-field-inverse lib factor-number nonzero))
         (reverse-product (proof-proof-symmetric proof product))
         (reordered (proof-proof-rewrite proof reverse-product inverse-product '(1 2 1)))
         (unit (library-library-axiom lib "UNICITY-OF-1" (list value)))
         (value-number (t2-arithmetic-number lib value (list integer-value)))
         (fixed (t2-field-numeric-fix lib value value-number)))
      (proof-proof-chain proof reordered (list unit fixed)))))

(defun t2-ratios-reduced-input (lib n int-n n-sign negative-numerator)
  (if negative-numerator
      (let ((p (library-minus n)))
        (proof-with-checked-results
            ((i-p (t2-arithmetic-arithmetic-type-of lib p (list int-n)))
             (positive (t2-arithmetic-negative-magnitude lib n-sign (list int-n)))
             (p-bound (t2-order-opposite-order lib positive)))
          (list p i-p p-bound)))
    (list n int-n n-sign)))

(defun t2-ratios-reduced-sign (lib n int-n p gcd i-a combo divides-p negative-numerator)
  (if negative-numerator
      (let ((proof (library-library-proof lib)))
        (proof-with-checked-results
            ((a (t2-ratios-step-at i-a 1))
             (negative (library-library-cite lib "FIELD-NEGATIVE-FACTOR" (list a n) nil))
             (left (t2-order-negate-left-factor lib a n))
             (reverse-left (proof-proof-symmetric proof left))
             (identity-sign (proof-proof-chain proof negative (list reverse-left)))
             (signed-combo (proof-proof-rewrite proof combo identity-sign '(1 2 1)))
             (original (library-library-cite
                        lib "FIELD-NEGATIVE-FACTOR" (list (t2-field-reciprocal gcd) p) nil))
             (normal (library-library-cite lib "DOUBLE-NEGATION" (list n) (list int-n)))
             (original (proof-proof-rewrite proof original normal '(1 1 2)))
             (result (t2-ratios-step-at original 2))
             (type (t2-arithmetic-arithmetic-type-of lib result (list divides-p)))
             (divides-n (library-library-transport-argument lib type original 1))
             (signed-type (t2-arithmetic-arithmetic-type-of lib (library-minus a) (list i-a))))
          (list signed-combo divides-n signed-type)))
    (list combo divides-p i-a)))

(defun t2-ratios-reduced-pair (lib is-rational negative-numerator)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((value (t2-ratios-step-at is-rational 1))
         (n (t2-ratios-numerator value))
         (d (t2-ratios-denominator value))
         (parts (t2-arithmetic-rational-parts lib is-rational))
         (int-n (car parts))
         (int-d (cadr parts))
         (pos-d (caddr parts))
         (n-sign (proof-proof-assume proof (library-lt n *proof-zero*) negative-numerator))
         (d-bound (t2-order-opposite-order lib pos-d))
         (inputs (t2-ratios-reduced-input lib n int-n n-sign negative-numerator))
         (p (car inputs))
         (invariant (t2-euclid-invariant lib p d (cadr inputs) int-d (caddr inputs) d-bound pos-d))
         (int-gcd (car invariant))
         (pos-gcd (cadr invariant))
         (i-b (cadddr invariant))
         (gcd (t2-ratios-step-at int-gcd 1))
         (signed (t2-ratios-reduced-sign lib n int-n p gcd (caddr invariant)
                                         (nth 4 invariant) (nth 5 invariant) negative-numerator))
         (divides-p (cadr signed))
         (divides-d (nth 6 invariant))
         (factor-n (t2-ratios-cancel-positive lib pos-gcd int-gcd int-n))
         (factor-n (proof-proof-symmetric proof factor-n))
         (factor-d (t2-ratios-cancel-positive lib pos-gcd int-gcd int-d))
         (factor-d (proof-proof-symmetric proof factor-d))
         (r (t2-ratios-step-at divides-p 1))
         (q (t2-ratios-step-at divides-d 1))
         (law (proof-proof-fact
               proof (proof-sym "LOWEST-TERMS" "ACL2")
               (list (list *library-x* value) (list (proof-sym "N" "ACL2") gcd)
                     (list (proof-sym "R" "ACL2") r) (list (proof-sym "Q" "ACL2") q))))
         (premise (t2-power-join
                   lib (list int-gcd is-rational divides-p divides-d pos-gcd factor-n factor-d)))
         (positive-divisor (t2-arithmetic-arithmetic-modus-ponens lib law premise))
         (claim (proof-step-first positive-divisor)))
      (if (not (equal claim (proof-eq gcd *proof-one*)))
          '(:failure "failure" "")
        (proof-with-checked-results
            ((reverse-divisor (proof-proof-symmetric proof positive-divisor))
             (result (proof-proof-chain proof reverse-divisor (list (car signed)))))
          (list result (caddr signed) i-b))))))

(defun t2-ratios-multiply-representation (lib coefficient inverse-denominator component multiplier simplify)
  (let ((raw (t2-products-times (t2-products-times inverse-denominator multiplier)
                                (t2-products-times coefficient component)))
        (target (t2-products-times coefficient
                                   (t2-products-times
                                    (t2-products-times inverse-denominator component) multiplier))))
    (proof-with-checked-results ((equation (t2-book-logic-ac-equal lib raw target)))
      (proof-proof-rewrite (library-library-proof lib) equation simplify '(1 2 2 1)))))

(defun t2-ratios-denominator-divides-case
  (lib ratio negative n d inv-d scale unit-scale representation undo one-times-y iy integral-product)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((reduced (t2-ratios-reduced-pair lib ratio negative))
         (coefficients (car reduced))
         (int-a (cadr reduced))
         (int-b (caddr reduced))
         (a (t2-ratios-step-at int-a 1))
         (b (t2-ratios-step-at int-b 1))
         (reverse-scale (proof-proof-symmetric proof unit-scale))
         (equation (proof-proof-rewrite proof reverse-scale coefficients '(1 2 2)))
         (sum (t2-ratios-step-at coefficients 2))
         (distributed (library-library-axiom lib "DISTRIBUTIVITY" (cons scale (cdr sum))))
         (equation (proof-proof-chain proof equation (list distributed)))
         (adjusted-numerator (t2-ratios-multiply-representation lib a inv-d n *library-y* representation))
         (adjusted-denominator (t2-ratios-multiply-representation lib b inv-d d *library-y* undo))
         (adjusted-denominator (proof-proof-rewrite proof adjusted-denominator one-times-y '(1 2 2)))
         (equation (proof-proof-rewrite proof equation adjusted-numerator '(1 2 1)))
         (equation (proof-proof-rewrite proof equation adjusted-denominator '(1 2 2)))
         (product (t2-ratios-step-at equation 2))
         (result (t2-arithmetic-arithmetic-type-of lib product (list int-a int-b iy integral-product))))
      (library-library-transport-argument lib result equation 1))))

(defun t2-ratios-denominator-divides (lib)
  (let* ((proof (library-library-proof lib))
         (x *library-x*)
         (y *library-y*)
         (is-rational (list *library-rationalp* x))
         (is-integer (library-integer y))
         (product-type (library-integer (t2-products-times x y))))
    (proof-with-checked-results
        ((ratio (proof-proof-assume proof is-rational t))
         (iy (proof-proof-assume proof is-integer t))
         (integral-product (proof-proof-assume proof product-type t))
         (n (t2-ratios-numerator x))
         (d (t2-ratios-denominator x))
         (parts (t2-arithmetic-rational-parts lib ratio))
         (int-d (cadr parts))
         (pos-d (caddr parts))
         (inv-d (t2-field-reciprocal d))
         (num-d (t2-arithmetic-number lib d (list int-d)))
         (distinct (t2-order-distinct lib pos-d))
         (nonzero (t2-products-flip-neq lib distinct))
         (undo (t2-field-inverse lib num-d nonzero))
         (commute (library-library-axiom lib "COMMUTATIVITY-OF-*" (list inv-d d)))
         (undo (proof-proof-chain proof commute (list undo)))
         (ratio-law (library-library-axiom lib "RATIONAL-IMPLIES2" (list x)))
         (representation (t2-arithmetic-arithmetic-modus-ponens lib ratio-law ratio))
         (scale (t2-products-times inv-d y))
         (scale-type (library-library-cite lib "FIELD-PRODUCT-NUMBER" (list inv-d y) nil))
         (unit-scale (t2-field-identity lib scale scale-type *proof-times*))
         (numeric-y (t2-arithmetic-number lib y (list iy)))
         (unit (library-library-axiom lib "UNICITY-OF-1" (list y)))
         (fixed-y (t2-field-numeric-fix lib y numeric-y))
         (one-times-y (proof-proof-chain proof unit (list fixed-y)))
         (yes (t2-ratios-denominator-divides-case
               lib ratio t n d inv-d scale unit-scale representation undo one-times-y iy integral-product))
         (no (t2-ratios-denominator-divides-case
              lib ratio nil n d inv-d scale unit-scale representation undo one-times-y iy integral-product))
         (step (proof-proof-cases proof (library-lt n *proof-zero*) yes no)))
      (t2-ratios-add-lemma lib "DENOMINATOR-DIVIDES" step
                           (library-guards (list is-rational is-integer product-type))))))

(defun t2-ratios-multiplier-ratio (lib ratio integral positive-multiplier integral-product)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((x (t2-ratios-step-at ratio 1))
         (w (t2-ratios-step-at integral 1))
         (parts (t2-arithmetic-rational-parts lib ratio))
         (int-d (cadr parts))
         (pos-d (caddr parts))
         (d (t2-ratios-step-at int-d 1))
         (quotient-type (library-library-cite
                         lib "DENOMINATOR-DIVIDES" (list x w) (list ratio integral integral-product)))
         (d-type (t2-arithmetic-rational lib d (list int-d)))
         (inv-d (t2-field-reciprocal d))
         (inv-type (t2-order-rational lib inv-d (list d-type)))
         (reciprocal-positive (library-library-cite lib "FIELD-RECIPROCAL-POSITIVE" (list d) (list d-type)))
         (positive-inverse (proof-proof-transport proof pos-d reciprocal-positive))
         (w-type (t2-arithmetic-rational lib w (list integral)))
         (positive-quotient (library-library-cite
                             lib "POSITIVE-PRODUCT" (list inv-d w)
                             (list inv-type w-type positive-inverse positive-multiplier))))
      (list quotient-type positive-quotient))))

(defun t2-ratios-at-least-one (lib positive-integer integral)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((bound (t2-products-discrete-step lib positive-integer (list integral)))
         (one (proof-proof-compute proof (library-plus *proof-one* *proof-zero*) 1)))
      (proof-proof-rewrite proof bound one '(1 1 2)))))

(defun t2-ratios-denominator-bound (lib)
  (let* ((proof (library-library-proof lib))
         (x *library-x*)
         (y *library-y*)
         (is-rational (list *library-rationalp* x))
         (is-integer (library-integer y))
         (is-positive (library-positive y))
         (product-type (library-integer (t2-products-times x y))))
    (proof-with-checked-results
        ((ratio (proof-proof-assume proof is-rational t))
         (iy (proof-proof-assume proof is-integer t))
         (py (proof-proof-assume proof is-positive t))
         (product (proof-proof-assume proof product-type t))
         (multiplier (t2-ratios-multiplier-ratio lib ratio iy py product))
         (unit-bound (t2-ratios-at-least-one lib (cadr multiplier) (car multiplier)))
         (parts (t2-arithmetic-rational-parts lib ratio))
         (iden (cadr parts))
         (pden (caddr parts))
         (den (t2-ratios-step-at iden 1))
         (rational-y (t2-arithmetic-rational lib y (list iy)))
         (rational-den (t2-arithmetic-rational lib den (list iden)))
         (reciprocal-positive (library-library-cite lib "FIELD-RECIPROCAL-POSITIVE"
                                                     (list den) (list rational-den)))
         (inverse-positive (proof-proof-transport proof pden reciprocal-positive))
         (test (library-lt y den))
         (supposed (proof-proof-assume proof test t))
         (contradiction (t2-order-increasing-product lib supposed inverse-positive (list rational-y rational-den)))
         (den-number (t2-arithmetic-number lib den (list iden)))
         (distinct (t2-order-distinct lib pden))
         (nonzero (t2-products-flip-neq lib distinct))
         (retract (t2-field-inverse lib den-number nonzero))
         (commute (library-library-axiom lib "COMMUTATIVITY-OF-*" (list (t2-field-reciprocal den) den)))
         (unit (proof-proof-chain proof commute (list retract)))
         (contradiction (proof-proof-rewrite proof contradiction unit '(1 2)))
         (cut (proof-proof-cut proof contradiction unit-bound))
         (step (proof-proof-front proof cut (proof-neg test))))
      (t2-ratios-add-lemma lib "DENOMINATOR-BOUND" step
                           (library-guards (list is-rational is-integer is-positive product-type))))))

(defun t2-ratios-same-denominator (lib left right integral-lr integral-rl)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((left-parts (t2-arithmetic-rational-parts lib left))
         (right-parts (t2-arithmetic-rational-parts lib right))
         (int-left (cadr left-parts))
         (pos-left (caddr left-parts))
         (int-right (cadr right-parts))
         (pos-right (caddr right-parts))
         (a (t2-ratios-step-at int-left 1))
         (b (t2-ratios-step-at int-right 1))
         (left-value (t2-ratios-step-at left 1))
         (weak-left (library-library-cite lib "DENOMINATOR-BOUND" (list left-value b)
                                          (list left int-right pos-right integral-lr)))
         (right-value (t2-ratios-step-at right 1))
         (weak-right (library-library-cite lib "DENOMINATOR-BOUND" (list right-value a)
                                           (list right int-left pos-left integral-rl)))
         (rational-a (t2-arithmetic-rational lib a (list int-left)))
         (rational-b (t2-arithmetic-rational lib b (list int-right)))
         (comparison (t2-order-trichotomy lib a b (list rational-a rational-b)))
         (equality (proof-proof-front proof comparison (proof-eq a b)))
         (equality (proof-proof-discharge proof equality weak-left)))
      (proof-proof-discharge proof equality weak-right))))

(defun t2-ratios-multiplied-negative (lib ratio)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((value (t2-ratios-step-at ratio 1))
         (parts (t2-arithmetic-rational-parts lib ratio))
         (int-n (car parts))
         (int-d (cadr parts))
         (original (library-library-cite lib "FIELD-MULTIPLY-DENOMINATOR" (list value) (list ratio)))
         (den (t2-ratios-step-at int-d 1))
         (normalized (t2-order-negate-left-factor lib value den))
         (normalized (proof-proof-rewrite proof normalized original '(1 2 1)))
         (num (t2-ratios-step-at int-n 1))
         (integer-minus (t2-arithmetic-arithmetic-type-of lib (library-minus num) (list int-n))))
      (library-library-transport-argument lib integer-minus normalized 1))))

(defun t2-ratios-symmetry-negative (lib is-rational)
  (let* ((proof (library-library-proof lib))
         (x *library-x*)
         (numeric-x (list *library-numberp* x)))
    (proof-with-checked-results
        ((false-rational (proof-proof-assume proof is-rational nil))
         (original-zero (library-library-axiom lib "COMPLETION-OF-NUMERATOR" (list x)))
         (completion (t2-ratios-step-at original-zero 2))
         (selected (proof-proof-select proof completion false-rational))
         (original-zero (proof-proof-chain proof original-zero (list selected)))
         (expected (proof-proof-reflexive proof (library-minus (t2-ratios-numerator x))))
         (expected (proof-proof-rewrite proof expected original-zero '(1 2 1)))
         (minus-zero (proof-proof-compute proof (library-minus *proof-zero*) 0))
         (expected (proof-proof-chain proof expected (list minus-zero)))
         (double-bad (library-library-cite lib "FIELD-DOUBLE-NEGATION" (list x) nil))
         (numeric (proof-proof-assume proof numeric-x t))
         (fixed (t2-field-numeric-fix lib x numeric))
         (double-bad (proof-proof-chain proof double-bad (list fixed)))
         (imagined-type (list *library-rationalp* (library-minus x)))
         (imagined (proof-proof-assume proof imagined-type t))
         (rational-x (t2-order-rational lib (library-minus (library-minus x)) (list imagined)))
         (rational-x (proof-proof-rewrite proof rational-x double-bad '(1 1)))
         (cut (proof-proof-cut proof rational-x false-rational))
         (incompatible (proof-proof-front proof cut (proof-neg imagined-type)))
         (num (library-library-axiom lib "COMPLETION-OF-NUMERATOR" (list (library-minus x))))
         (num-completion (t2-ratios-step-at num 2))
         (select-num (proof-proof-select proof num-completion incompatible))
         (expected-reverse (proof-proof-symmetric proof expected))
         (ordinary-nil (proof-proof-chain proof num (list select-num expected-reverse)))
         (raw-minus (library-library-axiom lib "COMPLETION-OF-UNARY-MINUS" (list x)))
         (minus-completion (t2-ratios-step-at raw-minus 2))
         (no-minus (proof-proof-if-false proof minus-completion))
         (no-number (proof-proof-chain proof raw-minus (list no-minus)))
         (invalid (proof-proof-reflexive proof (t2-ratios-numerator (library-minus x))))
         (invalid (proof-proof-rewrite proof invalid no-number '(1 2 1)))
         (zero-num (t2-book-logic-constant lib (t2-ratios-numerator *proof-zero*)))
         (expected-reverse (proof-proof-symmetric proof expected))
         (invalid (proof-proof-chain proof invalid (list zero-num expected-reverse))))
      (proof-proof-cases proof numeric-x ordinary-nil invalid))))

(defun t2-ratios-symmetry (lib)
  (let* ((proof (library-library-proof lib))
         (x *library-x*)
         (negative-x (library-minus x))
         (is-rational (list *library-rationalp* x)))
    (proof-with-checked-results
        ((ratio (proof-proof-assume proof is-rational t))
         (opposite (t2-order-rational lib negative-x (list ratio)))
         (double (library-library-cite lib "FIELD-DOUBLE-NEGATION" (list x) nil))
         (numeric (t2-order-number-from-rational lib ratio))
         (fixed (t2-field-numeric-fix lib x numeric))
         (double (proof-proof-chain proof double (list fixed)))
         (multiply-opposite (t2-ratios-multiplied-negative lib opposite))
         (restored (proof-proof-rewrite proof multiply-opposite double '(1 1 1)))
         (reversed-product (t2-ratios-multiplied-negative lib ratio))
         (equal-d (t2-ratios-same-denominator lib opposite ratio reversed-product restored))
         (lib (t2-ratios-add-lemma lib "DENOMINATOR-NEGATION" equal-d
                                  (list (proof-neg is-rational))))
         (proof (library-library-proof lib))
         (value (library-library-cite lib "FIELD-MULTIPLY-DENOMINATOR" (list negative-x) (list opposite)))
         (value (proof-proof-symmetric proof value))
         (value (proof-proof-rewrite proof value equal-d '(1 2 2)))
         (negated (t2-order-negate-left-factor lib x (t2-ratios-denominator x)))
         (value (proof-proof-chain proof value (list negated)))
         (original (library-library-cite lib "FIELD-MULTIPLY-DENOMINATOR" (list x) (list ratio)))
         (value (proof-proof-rewrite proof value original '(1 2 1)))
         (other (t2-ratios-symmetry-negative lib is-rational))
         (step (proof-proof-cases proof is-rational value other)))
      (t2-ratios-add-lemma lib "NUMERATOR-NEGATION" step nil))))

(defun t2-ratios-translate (lib)
  (let* ((proof (library-library-proof lib))
         (x *library-x*)
         (y *library-y*)
         (is-rational (list *library-rationalp* x))
         (is-integer (library-integer y))
         (raw (library-plus x y)))
    (proof-with-checked-results
        ((ratio (proof-proof-assume proof is-rational t))
         (iy (proof-proof-assume proof is-integer t))
         (y-type (t2-arithmetic-rational lib y (list iy)))
         (translated (t2-order-rational lib raw (list ratio y-type)))
         (parts (t2-arithmetic-rational-parts lib ratio))
         (translated-parts (t2-arithmetic-rational-parts lib translated))
         (int-n (car parts))
         (int-d (cadr parts))
         (int-nt (car translated-parts))
         (int-dt (cadr translated-parts))
         (den (t2-ratios-step-at int-d 1))
         (den-t (t2-ratios-step-at int-dt 1))
         (product (library-library-axiom lib "COMMUTATIVITY-OF-*" (list raw den)))
         (distributed (library-library-axiom lib "DISTRIBUTIVITY" (list den x y)))
         (product (proof-proof-chain proof product (list distributed)))
         (commute (library-library-axiom lib "COMMUTATIVITY-OF-*" (list den x)))
         (clear-den (library-library-cite lib "FIELD-MULTIPLY-DENOMINATOR" (list x) (list ratio)))
         (normalized (proof-proof-chain proof commute (list clear-den)))
         (product (proof-proof-rewrite proof product normalized '(1 2 1)))
         (product-value (t2-ratios-step-at product 2))
         (integral (t2-arithmetic-arithmetic-type-of lib product-value (list int-n int-d iy)))
         (forward (library-library-transport-argument lib integral product 1))
         (shifted (library-library-axiom lib "ASSOCIATIVITY-OF-+" (list x y (library-minus y))))
         (inverse-y (library-library-axiom lib "INVERSE-OF-+" (list y)))
         (shifted (proof-proof-rewrite proof shifted inverse-y '(1 2 2)))
         (numeric (t2-order-number-from-rational lib ratio))
         (identity (t2-field-identity lib x numeric *proof-plus*))
         (shifted (proof-proof-chain proof shifted (list identity)))
         (reverse (library-library-axiom lib "COMMUTATIVITY-OF-*" (list x den-t)))
         (unshifted (proof-proof-symmetric proof shifted))
         (reverse (proof-proof-rewrite proof reverse unshifted '(1 2 2)))
         (scaled (t2-euclid-scale-difference lib den-t raw y))
         (reverse (proof-proof-chain proof reverse (list scaled)))
         (commute (library-library-axiom lib "COMMUTATIVITY-OF-*" (list den-t raw)))
         (clear-den-t (library-library-cite lib "FIELD-MULTIPLY-DENOMINATOR" (list raw) (list translated)))
         (multiplied (proof-proof-chain proof commute (list clear-den-t)))
         (reverse (proof-proof-rewrite proof reverse multiplied '(1 2 1)))
         (reverse-value (t2-ratios-step-at reverse 2))
         (integral (t2-arithmetic-arithmetic-type-of lib reverse-value (list int-nt int-dt iy)))
         (backward (library-library-transport-argument lib integral reverse 1))
         (equal-d (t2-ratios-same-denominator lib translated ratio forward backward))
         (lib (t2-ratios-add-lemma lib "DENOMINATOR-INTEGER-TRANSLATION" equal-d
                                  (library-guards (list is-rational is-integer))))
         (proof (library-library-proof lib))
         (hypotheses (proof-ite is-rational is-integer *proof-false*))
         (assumed (proof-proof-assume proof hypotheses t))
         (given (t2-power-conjuncts lib assumed 2))
         (natural-order (library-library-cite lib "DENOMINATOR-INTEGER-TRANSLATION" (list x y) given))
         (commute (library-library-axiom lib "COMMUTATIVITY-OF-+" (list x y)))
         (swapped-order (proof-proof-rewrite proof natural-order commute '(1 1 1)))
         (swapped (t2-power-implication lib hypotheses swapped-order))
         (natural (t2-power-implication lib hypotheses natural-order))
