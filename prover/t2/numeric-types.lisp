(in-package "BOYMOO-PROVER")
(set-verify-guards-eagerness 0)

(defun t2-numeric-types-one-bound (lib strictly-positive integral)
  (let ((p (library-library-proof lib)))
    (proof-with-checked-results
     ((bound (t2-products-discrete-step lib strictly-positive (list integral)))
      (one (proof-proof-compute p (library-plus *proof-one* *proof-zero*) 1)))
     (proof-proof-rewrite p bound one '(1 1 2)))))

(defun t2-numeric-types-involution-term (operation term)
  (if (eq operation :minus)
      (library-minus term)
    (t2-field-reciprocal term)))

(defun t2-numeric-types-build-rational-type (term evidence lib)
  (t2-order-rational lib term evidence))

(defun t2-numeric-types-involution-closure (closure lib term evidence)
  (if (eq closure :integer)
      (t2-arithmetic-arithmetic-type-of lib term evidence)
    (t2-numeric-types-build-rational-type term evidence lib)))

(defun t2-numeric-types-type-under-involution (lib operation label predicate bool-axiom closure)
  (let* ((p (library-library-proof lib))
         (x *library-x*)
         (operated (t2-numeric-types-involution-term operation x))
         (left (list predicate operated))
         (right (list predicate x)))
    (proof-with-checked-results
     ((numeric (proof-proof-assume p (list *library-numberp* x) t))
      (completed (library-library-cite lib label (list x) nil))
      (fix (t2-field-numeric-fix lib x numeric))
      (completed (proof-proof-chain p completed (list fix)))
      (assume-left (proof-proof-assume p left t))
      (to-right (t2-numeric-types-involution-closure
                 closure lib (t2-numeric-types-involution-term operation operated) (list assume-left)))
      (to-right (proof-proof-rewrite p to-right completed '(1 1)))
      (assume-right (proof-proof-assume p right t))
      (to-left (t2-numeric-types-involution-closure closure lib operated (list assume-right)))
      (left-boolean (proof-proof-fact p bool-axiom (list (list x operated))))
      (right-boolean (proof-proof-fact p bool-axiom (list (list x x))))
      (proved (t2-field-equal-predicates lib left right to-right to-left left-boolean right-boolean))
      (predicate-name (proof-term-at predicate 2))
      (claim (proof-step-first (car proved)))
      (numeric-first (proof-step-first numeric)))
     (library-library-lemma
      (cdr proved) (concatenate 'string predicate-name "-OF-"
                                (if (eq operation :minus) "NEGATION" "RECIPROCAL"))
      claim (car proved) (list (proof-neg numeric-first))))))

(defun t2-numeric-types-fixed-order (lib)
  (let* ((p (library-library-proof lib))
         (x *library-x*)
         (y *library-y*)
         (fix-y (t2-field-fixed y))
         (minus-x (library-minus x)))
    (proof-with-checked-results
     ((original (library-library-cite lib "FIELD-LESS-DIFFERENCE" (list x y) nil))
      (fixed-diff (library-library-cite lib "FIELD-LESS-DIFFERENCE"
                                        (list (t2-field-fixed x) fix-y) nil))
      (minus-fix (library-library-cite lib "FIELD-MINUS-FIX" (list x) nil))
      (fixed-diff (proof-proof-rewrite p fixed-diff minus-fix '(1 2 2 2)))
      (commuted (library-library-axiom lib "COMMUTATIVITY-OF-+" (list fix-y minus-x)))
      (removed (t2-field-remove-fixed-operand lib *proof-plus* minus-x y))
      (commuted-back (library-library-axiom lib "COMMUTATIVITY-OF-+" (list minus-x y)))
      (restored (proof-proof-chain p commuted (list removed commuted-back)))
      (fixed-diff (proof-proof-rewrite p fixed-diff restored '(1 2 2)))
      (fixed-reversed (proof-proof-symmetric p fixed-diff))
      (proof (proof-proof-chain p original (list fixed-reversed)))
      (claim (proof-step-first proof)))
     (library-library-lemma lib "FIELD-FIX-ORDER" claim proof nil))))

(defun t2-numeric-types-reciprocal-negation (lib)
  (let* ((p (library-library-proof lib))
         (x *library-x*)
         (inv (t2-field-reciprocal x))
         (test (proof-eq (t2-field-fixed x) *proof-zero*))
         (minus-x (library-minus x))
         (minus-inv (library-minus inv)))
    (proof-with-checked-results
     ((zero (proof-proof-assume p test t))
      (small (library-library-cite lib "FIELD-MINUS-FIX" (list x) nil))
      (small (proof-proof-symmetric p small))
      (small (proof-proof-rewrite p small zero '(1 2 1)))
      (zero-value (proof-proof-compute p (library-minus *proof-zero*) 0))
      (small (proof-proof-chain p small (list zero-value)))
      (a (proof-proof-reflexive p (t2-field-reciprocal minus-x)))
      (a (proof-proof-rewrite p a small '(1 2 1)))
      (a-first (proof-step-first a))
      (a-right (proof-term-at a-first 2))
      (a-value (proof-proof-compute p a-right 0))
      (a (proof-proof-chain p a (list a-value)))
      (b (proof-proof-reflexive p minus-inv))
      (inverse-zero (t2-field-reciprocal-zero lib x zero))
      (b (proof-proof-rewrite p b inverse-zero '(1 2 1)))
      (b-first (proof-step-first b))
      (b-right (proof-term-at b-first 2))
      (b-value (proof-proof-compute p b-right 0))
      (b (proof-proof-chain p b (list b-value)))
      (b-reversed (proof-proof-symmetric p b))
      (at-zero (proof-proof-chain p a (list b-reversed)))
      (product (library-library-cite lib "FIELD-NEGATIVE-FACTOR" (list minus-x inv) nil))
      (negative-factor (t2-order-negate-left-factor lib x inv))
      (product (proof-proof-rewrite p product negative-factor '(1 2 1)))
      (different (proof-proof-assume p test nil))
      (inverse (t2-field-inverse-of-fixed lib x different))
      (product (proof-proof-rewrite p product inverse '(1 2 1 1)))
      (negative-one (proof-proof-compute p (library-minus *proof-one*) -1))
      (product (proof-proof-rewrite p product negative-one '(1 2 1)))
      (one (proof-proof-compute p (library-minus *proof-neg-one*) 1))
      (product (proof-proof-chain p product (list one)))
      (candidate-type (t2-field-number lib minus-inv))
      (factor-type (t2-field-number lib minus-x))
      (nonzero (t2-field-unique-reciprocal lib product candidate-type factor-type))
      (lib (cdr nonzero))
      (p (library-library-proof lib))
      (proof (proof-proof-cases p test at-zero (car nonzero)))
      (claim (proof-step-first proof)))
     (library-library-lemma lib "FIELD-RECIPROCAL-NEGATION" claim proof nil))))

(defun t2-numeric-types-reciprocal-above-one (lib)
  (let* ((p (library-library-proof lib))
         (x *library-x*)
         (one *proof-one*)
         (inv (t2-field-reciprocal x))
         (fix (t2-field-fixed x)))
    (proof-with-checked-results
     ((comparison (proof-proof-assume p (library-lt one x) t))
      (integral (proof-proof-assume p (library-integer inv) t))
      (rat (t2-arithmetic-rational lib inv (list integral)))
      (inv-inv (t2-order-rational lib (t2-field-reciprocal inv) (list rat)))
      (involution (library-library-cite lib "FIELD-RECIPROCAL-INVOLUTION" (list x) nil))
      (rat-fix (proof-proof-rewrite p inv-inv involution '(1 1)))
      (fixed-compare (library-library-cite lib "FIELD-FIX-ORDER" (list one x) nil))
      (num-one (t2-arithmetic-number lib one nil))
      (fix-one (t2-field-numeric-fix lib one num-one))
      (fixed-compare (proof-proof-rewrite p fixed-compare fix-one '(1 2 1)))
      (converted (proof-proof-rewrite p comparison fixed-compare '(1)))
      (positive-one (t2-arithmetic-arithmetic-prove lib (library-positive one) nil nil))
      (pos (t2-order-strict-chain lib positive-one converted))
      (lib (cdr pos))
      (pos (car pos))
      (p (library-library-proof lib))
      (signs (library-library-cite lib "FIELD-RECIPROCAL-POSITIVE" (list fix) (list rat-fix)))
      (inv-fix (library-library-cite lib "FIELD-RECIPROCAL-FIX" (list x) nil))
      (signs (proof-proof-rewrite p signs inv-fix '(1 1 2)))
      (inv-pos (proof-proof-transport p pos signs))
      (bound (t2-numeric-types-one-bound lib inv-pos integral))
      (different (t2-order-distinct lib pos))
      (different (t2-products-flip-neq lib different))
      (inverse (t2-field-inverse-of-fixed lib x different))
      (commuted (library-library-axiom lib "COMMUTATIVITY-OF-*" (list fix inv)))
      (removed (t2-field-remove-fixed-operand lib *proof-times* inv x))
      (commuted-back (library-library-axiom lib "COMMUTATIVITY-OF-*" (list inv x)))
      (fixed-inverse (proof-proof-chain p commuted (list removed commuted-back inverse)))
      (rat-one (t2-arithmetic-rational lib one nil))
      (scale (library-library-cite lib "FIELD-POSITIVE-SCALE" (list inv one fix)
                                   (list rat rat-one rat-fix pos)))
      (scale (proof-proof-rewrite p scale fixed-inverse '(1 1 1)))
      (numeric (t2-field-number lib fix))
      (identity (t2-field-identity lib fix numeric *proof-times*))
      (scale (proof-proof-rewrite p scale identity '(1 1 2)))
      (converted (proof-proof-rewrite p converted scale '(1)))
      (contradiction (proof-proof-cut p converted bound))
      (integral-first (proof-step-first integral))
      (denial (proof-proof-front p contradiction (proof-neg integral-first)))
      (claim (proof-step-first denial))
      (comparison-first (proof-step-first comparison)))
     (library-library-lemma lib "RECIPROCAL-NONINTEGER-ABOVE-ONE" claim denial
                            (list (proof-neg comparison-first))))))

(defun t2-numeric-types-reflected-order (lib value constant-value)
  (let ((p (library-library-proof lib)))
    (proof-with-checked-results
     ((swap (library-library-cite lib "FIELD-LESS-NEGATIONS" (list constant-value value) nil))
      (constant (t2-book-logic-constant lib (library-minus constant-value))))
     (if constant
         (proof-proof-rewrite p swap constant '(1 1 1))
       '(:failure "failure" "")))))

(defun t2-numeric-types-reciprocal-below-minus-one (lib)
  (let* ((p (library-library-proof lib))
         (x *library-x*)
         (inv (t2-field-reciprocal x))
         (wanted (library-integer inv)))
    (proof-with-checked-results
     ((negative (proof-proof-assume p (library-lt x *proof-neg-one*) t))
      (reflected (t2-numeric-types-reflected-order lib x *proof-neg-one*))
      (magnitude (proof-proof-transport p negative reflected))
      (nonintegral (library-library-cite lib "RECIPROCAL-NONINTEGER-ABOVE-ONE"
                                         (list (library-minus x)) (list magnitude)))
      (rec-negation (library-library-cite lib "FIELD-RECIPROCAL-NEGATION" (list x) nil))
      (nonintegral (proof-proof-rewrite p nonintegral rec-negation '(1 1 1)))
      (wanted-step (proof-proof-assume p wanted t))
      (integral (t2-arithmetic-arithmetic-type-of lib (library-minus inv) (list wanted-step)))
      (cut (proof-proof-cut p integral nonintegral))
      (proved (proof-proof-front p cut (proof-neg wanted)))
      (claim (proof-step-first proved))
      (negative-first (proof-step-first negative)))
     (library-library-lemma lib "RECIPROCAL-NONINTEGER-BELOW-MINUS-ONE" claim proved
                            (list (proof-neg negative-first))))))

(defun t2-numeric-types-positive-integer-above-one (lib integral sign different)
  (let ((p (library-library-proof lib)))
    (proof-with-checked-results
     ((literal (proof-step-first integral))
      (value (proof-term-at literal 1))
      (bound (t2-numeric-types-one-bound lib sign integral))
      (rational-value (t2-arithmetic-rational lib value (list integral)))
      (rational-one (t2-arithmetic-rational lib *proof-one* nil))
      (choices (t2-order-trichotomy lib value *proof-one* (list rational-value rational-one)))
      (choices (proof-proof-discharge p choices bound)))
     (proof-proof-discharge p choices different))))

(defun t2-numeric-types-integral-reciprocal-cases (values lib left right proof)
  (if (endp values)
      proof
    (let* ((p (library-library-proof lib))
           (x *library-x*)
           (value (car values))
           (test (proof-eq x value)))
      (proof-with-checked-results
       ((known (proof-proof-assume p test t))
        (rhs (proof-proof-reflexive p right))
        (rhs (proof-proof-rewrite-result p rhs known (proof-eq *proof-zero* right) x))
        (rhs-first (proof-step-first rhs))
        (rhs-term (proof-term-at rhs-first 2))
        (rhs-evaluated (t2-arithmetic-simplify p rhs-term nil nil))
        (rhs (proof-proof-chain p rhs (list rhs-evaluated)))
        (lhs (proof-proof-reflexive p left))
        (lhs (proof-proof-rewrite p lhs known '(1 2 1 1)))
        (inverse (t2-book-logic-constant lib (t2-field-reciprocal value)))
        (lhs (proof-proof-rewrite p lhs inverse '(1 2 1)))
        (lhs-first (proof-step-first lhs))
        (lhs-term (proof-term-at lhs-first 2))
        (lhs-evaluated (t2-book-logic-constant lib lhs-term))
        (lhs (proof-proof-chain p lhs (list lhs-evaluated)))
        (rhs-reversed (proof-proof-symmetric p rhs))
        (proved (proof-proof-chain p lhs (list rhs-reversed)))
        (proof (proof-proof-cases p test proved proof)))
       (t2-numeric-types-integral-reciprocal-cases (cdr values) lib left right proof)))))

(defun t2-numeric-types-integral-reciprocal (lib)
  (let* ((p (library-library-proof lib))
         (x *library-x*)
         (zero *proof-zero*)
         (one *proof-one*)
         (minus-one *proof-neg-one*)
         (first (proof-eq x minus-one))
         (second (proof-eq x zero))
         (third (proof-eq x one))
         (right (proof-ite first first (proof-ite second second third)))
         (left (library-integer (t2-field-reciprocal x)))
         (claim (proof-eq left right)))
    (proof-with-checked-results
     ((ix (proof-proof-assume p (library-integer x) t))
      (unequal-first (proof-proof-assume p first nil))
      (unequal-second (proof-proof-assume p second nil))
      (unequal-third (proof-proof-assume p third nil))
      (unequal (list unequal-first unequal-second unequal-third))
      (numeric (t2-arithmetic-number lib x (list ix)))
      (above (proof-proof-assume p (library-positive x) t))
      (greater (t2-numeric-types-positive-integer-above-one lib ix above unequal-third))
      (pos (library-library-cite lib "RECIPROCAL-NONINTEGER-ABOVE-ONE" (list x) (list greater)))
      (above-first (proof-step-first above))
      (not-above (proof-proof-assume p above-first nil))
      (below (t2-rational-scaling-negative-number lib numeric not-above unequal-second))
      (sign (library-library-cite lib "FIELD-LESS-ZERO-NEGATION" (list x) nil))
      (magnitude (proof-proof-transport p below sign))
      (minus-x (library-minus x))
      (m-test (proof-eq minus-x one))
      (reverse (proof-proof-reflexive p (library-minus minus-x)))
      (m-equal (proof-proof-assume p m-test t))
      (reverse (proof-proof-rewrite p reverse m-equal '(1 2 1)))
      (double (library-library-cite lib "FIELD-DOUBLE-NEGATION" (list x) nil))
      (reverse (proof-proof-rewrite p reverse double '(1 1)))
      (fix (t2-field-numeric-fix lib x numeric))
      (reverse (proof-proof-rewrite p reverse fix '(1 1)))
      (negative-one (proof-proof-compute p (library-minus one) -1))
      (reverse (proof-proof-rewrite p reverse negative-one '(1 2)))
      (not-m (proof-proof-cut p reverse unequal-first))
      (not-m (proof-proof-front p not-m (proof-neg m-test)))
      (int-minus (t2-arithmetic-arithmetic-type-of lib minus-x (list ix)))
      (larger (t2-numeric-types-positive-integer-above-one lib int-minus magnitude not-m))
      (reflected (t2-numeric-types-reflected-order lib x minus-one))
      (lower (proof-proof-rewrite p larger reflected '(1)))
      (negative (library-library-cite lib "RECIPROCAL-NONINTEGER-BELOW-MINUS-ONE" (list x) (list lower)))
      (no (proof-proof-cases p above-first pos negative))
      (selected (t2-arithmetic-simplify p right unequal nil))
      (third-false (t2-field-false-value lib unequal-third))
      (selected (proof-proof-chain p selected (list third-false)))
      (left-false (t2-field-false-value lib no))
      (selected-reversed (proof-proof-symmetric p selected))
      (proof (proof-proof-chain p left-false (list selected-reversed)))
      (proof (t2-numeric-types-integral-reciprocal-cases (list one zero minus-one) lib left right proof))
      (ix-first (proof-step-first ix)))
     (library-library-lemma lib "INTEGER-RECIPROCAL-TEST" claim proof (list (proof-neg ix-first))))))

(defun t2-numeric-types-build (lib)
  (proof-with-checked-results
   ((lib (t2-numeric-types-type-under-involution lib :minus "FIELD-DOUBLE-NEGATION"
                                                *library-rationalp* "booleanp-rationalp" :rational))
    (lib (t2-numeric-types-type-under-involution lib :minus "FIELD-DOUBLE-NEGATION"
                                                *proof-integerp* "booleanp-integerp" :integer))
    (lib (t2-numeric-types-type-under-involution lib :reciprocal "FIELD-RECIPROCAL-INVOLUTION"
                                                *library-rationalp* "booleanp-rationalp" :rational))
    (lib (t2-numeric-types-fixed-order lib))
    (lib (t2-numeric-types-reciprocal-negation lib))
    (lib (t2-numeric-types-reciprocal-above-one lib))
    (lib (t2-numeric-types-reciprocal-below-minus-one lib)))
   (t2-numeric-types-integral-reciprocal lib)))
