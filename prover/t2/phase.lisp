(in-package "BOYMOO-PROVER")

(set-verify-guards-eagerness 0)

(defun t2-phase-hypotheses-lookup (hypotheses term replies)
  (proof-with-checked-results
   ((result (t2-guarded-selectors-context-find hypotheses term)))
   (if (or (car result) (eq replies :plain))
       result
     (let* ((hypotheses (cdr result))
            (reply (assoc-equal term replies)))
       (if reply
           (cons (cadr reply)
                 (if (cddr reply)
                     (descent-hypotheses-remember hypotheses term (cadr reply))
                   hypotheses))
         (list :descent-request term hypotheses))))))

(defun t2-phase-hypotheses-require (hypotheses term replies)
  (descent-let* ((result (t2-phase-hypotheses-lookup hypotheses term replies)))
    (if (car result) result (descent-missing-hypothesis term))))

(defun t2-phase-hypotheses-after-library (context initial lib)
  (let ((hypotheses (t2-guarded-selectors-context-hypotheses context)))
    (if (and (not (equal initial lib))
             (equal (descent-hypotheses-proof hypotheses) initial))
        (t2-guarded-selectors-context-with-library context lib)
      context)))

(defun t2-phase-weighted-measure (term)
  (proof-with-checked-results
   ((leading (and (proof-is-call term *proof-plus*)
                  (proof-term-at term 1)))
    (upper-phase (equal leading *proof-one*))
    (product (if upper-phase (proof-term-at term 2) term)))
   (if (proof-is-call product *proof-times*)
       (proof-with-checked-results ((parts (proof-list-of-length (cdr product) 2)))
         (let ((factor (car parts))
               (size (cadr parts)))
           (proof-with-checked-results
            ((value (and (proof-is-call factor *proof-quote*) (proof-term-at factor 1))))
            (and (integerp value) (< 1 value)
                 (or (proof-is-call size *library-count*) (proof-is-call size *library-len*))
                 (list factor size upper-phase)))))
     nil)))

(defun t2-phase-weighted-ordinal (lib measure)
  (proof-with-checked-results
   ((lib (t2-products-build-product-order lib))
    (parts (t2-phase-weighted-measure measure))
    (parts (or parts '(:failure "failure" "")))
    (factor (car parts))
    (size (cadr parts))
    (upper-phase (caddr parts))
    (size-natural (t2-arithmetic-arithmetic-natural lib size))
    (bound (library-library-cite lib "NATURAL-NONNEGATIVE" (list size) (list size-natural)))
    (product (t2-products-times factor size))
    (positive (t2-arithmetic-arithmetic-prove lib (library-positive factor) nil nil))
    (scaled (t2-products-scale lib bound positive nil t))
    (zero (t2-products-product-zero lib factor))
    (lib (cdr zero))
    (proof (library-library-proof lib))
    (scaled (proof-proof-rewrite proof scaled (car zero) '(1 1 2)))
    (product-int (t2-arithmetic-arithmetic-type-of lib product nil))
    (natural (t2-arithmetic-natural-from-sign lib product-int scaled))
    (natural (if upper-phase
                 (proof-with-checked-results ((one-natural (t2-arithmetic-arithmetic-natural lib *proof-one*)))
                   (library-library-cite lib "NATURAL-SUM" (list *proof-one* product)
                                         (list one-natural natural)))
               natural))
    (step (library-library-cite lib "NATURAL-ORDINAL" (list measure) (list natural))))
   (cons step lib)))

(defun t2-phase-build-phase-separation (lib name)
  (proof-with-checked-results
   ((lib (t2-products-build-product-order lib))
    (proof (library-library-proof lib))
    (integers (library-library-ints lib (list *library-x* *library-y* *library-z*)))
    (wide (proof-proof-assume proof (library-lt *proof-one* *library-z*) t))
    (pos-one (t2-arithmetic-arithmetic-prove lib (library-positive *proof-one*) nil nil))
    (pos (t2-arithmetic-arithmetic-compare-chain lib pos-one wide integers))
    (smaller (proof-proof-assume proof (library-lt *library-x* *library-y*) t))
    (next-size (t2-products-discrete-step lib smaller integers))
    (scaled (t2-products-scale lib next-size pos integers t))
    (offset (t2-products-times *library-z* *library-x*))
    (one-int (t2-arithmetic-arithmetic-type-of lib *proof-one* nil))
    (offset-int (t2-arithmetic-arithmetic-type-of lib offset integers))
    (shifted (library-library-cite lib "LESS-SHIFT" (list *proof-one* *library-z* offset)
                                  (list one-int (caddr integers) offset-int wide)))
    (expansion (library-library-axiom lib "DISTRIBUTIVITY"
                                     (list *library-z* *proof-one* *library-x*)))
    (number (t2-arithmetic-number lib *library-z* integers))
    (unit (t2-products-product-one lib *library-z* number))
    (expansion (proof-proof-rewrite proof expansion unit '(1 2 1)))
    (shifted (library-library-transport-argument lib shifted expansion 2))
    (step (t2-arithmetic-arithmetic-compare-chain lib shifted scaled integers))
    (claim (proof-step-first step)))
   (library-library-lemma
    lib name claim step
    (library-guards (list (library-integer *library-x*) (library-integer *library-y*)
                          (library-integer *library-z*) (library-lt *proof-one* *library-z*)
                          (library-lt *library-x* *library-y*))))))

(defun t2-phase-phase-separation (lib child parent factor descent)
  (let ((name "TWO-PHASE-SEPARATION"))
    (proof-with-checked-results
     ((lib (if (assoc-equal (proof-sym "SELF-TWO-PHASE-SEPARATION" "ACL2")
                           (proof-proof-facts (library-library-proof lib)))
               lib
             (t2-phase-build-phase-separation lib name)))
      (int-child (t2-arithmetic-arithmetic-type-of lib child nil))
      (int-parent (t2-arithmetic-arithmetic-type-of lib parent nil))
      (int-factor (t2-arithmetic-arithmetic-type-of lib factor nil))
      (wide (t2-arithmetic-arithmetic-prove lib (library-lt *proof-one* factor) nil nil))
      (step (library-library-cite lib name (list child parent factor)
                                  (list int-child int-parent int-factor wide descent))))
     (cons step lib))))

(defun t2-phase-shift (lib step offset)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
     ((first (proof-step-first step))
      (parts (proof-list-of-length first 3))
      (a (cadr parts))
      (b (caddr parts))
      (int-a (t2-arithmetic-arithmetic-type-of lib a nil))
      (int-b (t2-arithmetic-arithmetic-type-of lib b nil))
      (int-offset (t2-arithmetic-arithmetic-type-of lib offset nil))
      (shifted (library-library-cite lib "LESS-SHIFT" (list a b offset)
                                     (list int-a int-b int-offset step)))
      (swap-a (library-library-axiom lib "COMMUTATIVITY-OF-+" (list a offset)))
      (shifted (proof-proof-rewrite proof shifted swap-a '(1 1)))
      (swap-b (library-library-axiom lib "COMMUTATIVITY-OF-+" (list b offset)))
      (shifted (proof-proof-rewrite proof shifted swap-b '(1 2))))
     (proof-proof-tidy proof shifted))))

(defun t2-phase-selector-steps (edges lib step hypotheses replies)
  (declare (xargs :measure (acl2-count edges)))
  (if (endp edges)
      (proof-with-checked-results
       ((first (proof-step-first step))
        (head (proof-term-at first 0)))
       (if (equal head *proof-less*)
           (cons step hypotheses)
         '(:failure "RecipeMismatch" "")))
    (let* ((edge (car edges))
           (head (car edge))
           (base (cadr edge)))
      (descent-let*
       ((evidence (t2-phase-hypotheses-lookup hypotheses (list *proof-consp* base) replies))
        (bound (descent-selector-edge lib head base (car evidence)))
        (step (if step (t2-arithmetic-arithmetic-compare-chain lib bound step nil) bound)))
       (t2-phase-selector-steps (cdr edges) lib step (cdr evidence) replies)))))

(defun t2-phase-selector-step (lib actual parent hypotheses replies)
  (let ((proof (library-library-proof lib)))
    (descent-let*
     ((head (proof-term-at actual 0))
      (selector (member-equal head (list *library-car* *library-cdr*)))
      (argument (and selector (proof-term-at actual 1)))
      (base (proof-term-at parent 1)))
     (if (and selector (equal argument base))
         (descent-let*
          ((structural (library-library-builtin lib (if (equal head *library-car*) 2 3) base))
           (evidence (t2-phase-hypotheses-require hypotheses (list *proof-consp* base) replies))
           (step (proof-proof-discharge proof structural (car evidence))))
          (cons step (cdr evidence)))
       (descent-let* ((edges (descent-selector-chain-edges actual base nil)))
         (if edges
             (descent-let*
              ((result (t2-phase-selector-steps edges lib nil hypotheses replies))
               (child (list *library-count* actual))
               (order (t2-arithmetic-arithmetic-ordinal-comparison lib child parent nil))
               (step (proof-proof-transport proof (car result) order)))
              (cons step (cdr result)))
           (proof-with-checked-results ((text (proof-write base)))
             '(:failure "RecipeMismatch" ""))))))))

(defun t2-phase-count-decrease (lib child parent hypotheses replies)
  (let ((proof (library-library-proof lib)))
    (descent-let*
     ((child-head (proof-term-at child 0))
      (parent-head (and (equal child-head *library-count*) (proof-term-at parent 0))))
     (if (not (equal parent-head *library-count*))
         '(:failure "RecipeMismatch" "")
       (descent-let*
        ((raw (proof-term-at child 1))
         (opened (t2-arithmetic-simplify proof raw nil (list *termination-return-last*)))
         (actual (if opened (proof-rewritten-term opened) raw))
         (result (t2-phase-selector-step lib actual parent hypotheses replies)))
        (if (not opened)
            result
          (proof-with-checked-results
           ((reverse (proof-proof-symmetric proof opened))
            (rewritten (proof-proof-rewrite proof (car result) reverse '(1 1 1)))
            (step (proof-proof-tidy proof rewritten)))
           (cons step (cdr result)))))))))

(defun t2-phase-weighted-size-order (lib small large hypotheses replies)
  (if (proof-is-call large *library-count*)
      (descent-let*
       ((result (t2-phase-count-decrease lib small large hypotheses replies))
        (comparison (t2-arithmetic-arithmetic-ordinal-comparison lib small large nil))
        (order (proof-proof-rewrite (library-library-proof lib) (car result) comparison '(1))))
       (cons order (cdr result)))
    (if (not (proof-is-call large *library-len*))
        '(:failure "RecipeMismatch" "")
      (proof-with-checked-results ((list-term (proof-term-at large 1)))
        (if (not (equal small (list *library-len* (list *library-cdr* list-term))))
            '(:failure "RecipeMismatch" "")
          (descent-let*
           ((evidence (t2-phase-hypotheses-require hypotheses (list *proof-consp* list-term) replies))
            (order (library-library-cite lib "LEN-CDR-LESS" (list list-term) (list (car evidence)))))
           (cons order (cdr evidence))))))))

(defun t2-phase-weighted-strict (lib small large factor child-phase parent-phase order)
  (if (and child-phase (not parent-phase))
      (t2-phase-phase-separation lib small large factor order)
    (proof-with-checked-results
     ((positive (t2-arithmetic-arithmetic-prove lib (library-positive factor) nil nil))
      (strict (t2-products-scale lib order positive nil nil))
      (strict (cond
               (child-phase (t2-phase-shift lib strict *proof-one*))
               (parent-phase
                (proof-with-checked-results
                 ((upper (t2-products-times factor large))
                  (integral (t2-arithmetic-arithmetic-type-of lib upper nil))
                  (greater (library-library-cite lib "SUCCESSOR-LARGER" (list upper) (list integral))))
                 (t2-arithmetic-arithmetic-compare-chain lib strict greater nil)))
               (t strict))))
     (cons strict lib))))

(defun t2-phase-weighted-decrease-query (lib goal hypotheses replies)
  (descent-let*
   ((goal (proof-list-of-length goal 3))
    (child (cadr goal))
    (parent (caddr goal))
    (child-parts (t2-phase-weighted-measure child))
    (child-parts (or child-parts '(:failure "failure" "")))
    (parent-parts (t2-phase-weighted-measure parent))
    (parent-parts (or parent-parts '(:failure "failure" "")))
    (factor (car child-parts))
    (small (cadr child-parts))
    (large (cadr parent-parts))
    (child-phase (caddr child-parts))
    (parent-phase (caddr parent-parts)))
   (if (not (equal factor (car parent-parts)))
       '(:failure "RecipeMismatch" "")
     (let ((base (t2-products-times factor small)))
       (descent-let*
        ((order (if (equal small large)
                    (if (and (not child-phase) parent-phase)
                        (proof-with-checked-results
                         ((integral (t2-arithmetic-arithmetic-type-of lib base nil))
                          (strict (library-library-cite lib "SUCCESSOR-LARGER" (list base)
                                                        (list integral))))
                         (cons strict hypotheses))
                      '(:failure "RecipeMismatch" ""))
                  (t2-phase-weighted-size-order lib small large hypotheses replies)))
         (strict (if (equal small large)
                     (cons (car order) lib)
                   (t2-phase-weighted-strict lib small large factor child-phase parent-phase
                                             (car order))))
         (comparison (t2-arithmetic-arithmetic-ordinal-comparison (cdr strict) child parent nil))
         (step (proof-proof-transport (library-library-proof (cdr strict)) (car strict) comparison))
         (hypotheses (t2-phase-hypotheses-after-library (cdr order) lib (cdr strict))))
        (cons (list step hypotheses) (cdr strict)))))))

(defun t2-phase-weighted-decrease (lib goal hypotheses)
  (t2-phase-weighted-decrease-query lib goal hypotheses :plain))
