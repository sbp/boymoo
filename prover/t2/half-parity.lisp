(in-package "BOYMOO-PROVER")
(set-verify-guards-eagerness 0)

(defconst *t2-half-parity-two* (proof-quote 2))
(defconst *t2-half-parity-neg-half* (proof-quote '("ratio" -1 2)))

(defun t2-half-parity-integer-boolean (lib test)
  (proof-with-checked-results
   ((argument (proof-term-at test 1)))
   (library-inherited proof-proof-fact lib "booleanp-integerp"
                      (list (list *library-x* argument)))))

(defun t2-half-parity-complement-branch (lib distinct left right truth)
  (let ((p (library-library-proof lib)))
    (proof-with-checked-results
     ((right-test (proof-proof-assume p right truth))
      (same-test (proof-proof-assume p left truth))
      (left-value
       (if truth
           (proof-with-checked-results
            ((boolean (t2-half-parity-integer-boolean lib left)))
            (t2-book-logic-true-boolean lib boolean same-test))
         (proof-with-checked-results
          ((step (t2-field-false-value lib same-test)))
          (cons step lib))))
      (lib (cdr left-value))
      (right-value
       (if truth
           (proof-with-checked-results
            ((boolean (t2-half-parity-integer-boolean lib right)))
            (t2-book-logic-true-boolean lib boolean right-test))
         (proof-with-checked-results
          ((step (t2-field-false-value lib right-test)))
          (cons step lib))))
      (lib (cdr right-value))
      (p (library-library-proof lib))
      (reverse (proof-proof-symmetric p (car right-value)))
      (equality (proof-proof-chain p (car left-value) (list reverse)))
      (cut (proof-proof-cut p equality distinct))
      (complement (proof-proof-front p cut (if truth (proof-neg left) left)))
      (value
       (if truth
           (proof-with-checked-results
            ((step (t2-field-false-value lib complement)))
            (cons step lib))
         (proof-with-checked-results
          ((boolean (t2-half-parity-integer-boolean lib left)))
          (t2-book-logic-true-boolean lib boolean complement))))
      (lib (cdr value))
      (p (library-library-proof lib))
      (simplified (t2-arithmetic-simplify p (proof-neg right) (list right-test) (list *proof-not*)))
      (reverse (proof-proof-symmetric p simplified))
      (step (proof-proof-chain p (car value) (list reverse))))
     (cons step lib))))

(defun t2-half-parity-boolean-complement (lib distinct)
  (proof-with-checked-results
   ((literal (proof-step-first distinct))
    (equation (proof-term-at literal 1))
    (terms (proof-list-of-length (cdr equation) 2))
    (left (car terms))
    (right (cadr terms))
    (yes (t2-half-parity-complement-branch lib distinct left right t))
    (no (t2-half-parity-complement-branch (cdr yes) distinct left right nil))
    (lib (cdr no))
    (step (library-inherited proof-proof-cases lib right (car yes) (car no))))
   (cons step lib)))

(defun t2-half-parity-evaluate-base-test (lib step position argument index)
  (let ((p (library-library-proof lib))
        (product-term (cadr argument)))
    (proof-with-checked-results
     ((product (t2-arithmetic-arithmetic-reflexive lib product-term))
      (product
       (if (zerop index)
           product
         (proof-with-checked-results
          ((value (proof-proof-compute p (library-plus *proof-zero* *proof-one*) 1)))
          (proof-proof-rewrite p product value '(1 2 2)))))
      (value (t2-book-logic-constant lib (caddr (proof-step-first product))))
      (product (proof-proof-chain p product (list value)))
      (evaluated (t2-arithmetic-arithmetic-reflexive lib argument))
      (evaluated (proof-proof-rewrite p evaluated product '(1 2 1)))
      (value (t2-book-logic-constant lib (caddr (proof-step-first evaluated))))
      (evaluated (proof-proof-chain p evaluated (list value))))
     (proof-proof-rewrite p step evaluated (list 1 2 position)))))

(defun t2-half-parity-alternation-base (lib template)
  (let* ((p (library-library-proof lib))
         (x *library-x*)
         (first (t2-exponent-parity-half-integral (library-plus *proof-zero* *proof-one*)))
         (second (t2-exponent-parity-half-integral *proof-zero*))
         (test (proof-eq first second)))
    (proof-with-checked-results
     ((step (t2-arithmetic-arithmetic-reflexive lib test))
      (step (t2-half-parity-evaluate-base-test lib step 1 first 1))
      (step (t2-half-parity-evaluate-base-test lib step 2 second 0))
      (value (proof-proof-compute p (caddr (proof-step-first step)) *proof-nil*))
      (step (proof-proof-chain p step (list value)))
      (not-nil (proof-proof-not-nil p))
      (at-zero (library-library-transport-argument lib not-nil step 1))
      (zero (proof-proof-assume p (proof-eq x *proof-zero*) t))
      (reverse (proof-proof-symmetric p zero)))
     (proof-proof-rewrite-result p at-zero reverse template x))))

(defun t2-half-parity-advance (lib proof previous successor integer-facts forward)
  (let ((p (library-library-proof lib))
        (advance (library-plus previous *proof-one*))
        (x *library-x*))
    (if forward
        (proof-with-checked-results
         ((equality (t2-arithmetic-linear-equal lib advance x integer-facts))
          (proof (proof-proof-rewrite p proof equality '(1 1 1 1 2)))
          (period (library-library-cite lib "HALF-INTEGRAL-PERIOD" (list previous) nil))
          (equality (t2-arithmetic-linear-equal
                     lib (library-plus previous *t2-half-parity-two*) successor integer-facts))
          (period (proof-proof-rewrite p period equality '(1 1 1 2)))
          (reverse (proof-proof-symmetric p period)))
         (proof-proof-rewrite p proof reverse '(1 1 2)))
      (proof-with-checked-results
       ((equality (t2-arithmetic-linear-equal
                   lib advance (library-plus x *t2-half-parity-two*) integer-facts))
        (proof (proof-proof-rewrite p proof equality '(1 1 1 1 2)))
        (period (library-library-cite lib "HALF-INTEGRAL-PERIOD" (list x) nil)))
       (proof-proof-rewrite p proof period '(1 1 1))))))

(defun t2-half-parity-alternation-branch (lib formula ix successor evidence forward)
  (proof-with-checked-results
   ((countdown (t2-exponent-parity-countdown-step lib ix evidence forward))
    (lib (cdr countdown))
    (previous (caar countdown))
    (bound (cadar countdown))
    (pair (list (list *library-x* previous)))
    (integer-facts (list ix))
    (previous-type (t2-arithmetic-arithmetic-type-of lib previous integer-facts))
    (proof (t2-power-smaller-instance lib formula bound pair (list previous-type)))
    (proof (t2-half-parity-advance lib proof previous successor integer-facts forward))
    (step (t2-products-flip-neq lib proof)))
   (cons (list step pair) lib)))

(defun t2-half-parity-alternation (lib)
  (let* ((x *library-x*)
         (y *library-y*)
         (p (library-library-proof lib))
         (successor (library-plus x *proof-one*))
         (distinct (proof-neg (proof-eq (t2-exponent-parity-half-integral successor)
                                       (t2-exponent-parity-half-integral x))))
         (zero (proof-eq x *proof-zero*))
         (sign (library-positive x)))
    (proof-with-checked-results
     ((parity (t2-exponent-parity-parity-step lib 2))
      (period (proof-proof-instantiate p parity (list (list y x))))
      (lib (library-library-lemma lib "HALF-INTEGRAL-PERIOD" (proof-step-first period) period nil))
      (p (library-library-proof lib))
      (integers (library-library-ints lib (list x)))
      (ix (car integers))
      (integer-x (proof-step-first ix))
      (formula (list *library-implies* integer-x distinct))
      (number (t2-arithmetic-number lib x (list ix)))
      (nonpositive (proof-proof-assume p sign nil))
      (nonzero (proof-proof-assume p zero nil))
      (negative (t2-rational-scaling-negative-number lib number nonpositive nonzero))
      (positive (proof-proof-assume p sign t))
      (forward (t2-half-parity-alternation-branch lib formula ix successor positive t))
      (reverse (t2-half-parity-alternation-branch (cdr forward) formula ix successor negative nil))
      (lib (cdr reverse))
      (p (library-library-proof lib))
      (base (t2-half-parity-alternation-base lib distinct))
      (branches (proof-proof-cases p sign (caar forward) (caar reverse)))
      (case-step (proof-proof-cases p zero base branches))
      (case-step (t2-power-implication lib integer-x case-step))
      (ordinal (library-library-builtin lib 1 x))
      (inducted (proof-proof-induct p ordinal case-step formula (list *library-count* x)
                                   (list (cadar forward) (cadar reverse))))
      (step (t2-arithmetic-arithmetic-modus-ponens lib inducted ix))
      (result (t2-half-parity-boolean-complement lib step))
      (proof (car result)))
     (library-library-lemma (cdr result) "HALF-INTEGRAL-ALTERNATES"
                            (proof-step-first proof) proof (list (proof-neg integer-x))))))

(defun t2-half-parity-cancel-half (lib numeric outer inner)
  (let ((p (library-library-proof lib)))
    (proof-with-checked-results
     ((literal (proof-step-first numeric))
      (value (proof-term-at literal 1))
      (associated (library-library-axiom lib "ASSOCIATIVITY-OF-*" (list outer inner value)))
      (step (proof-proof-symmetric p associated))
      (computed (t2-book-logic-constant lib (t2-products-times outer inner)))
      (step (proof-proof-rewrite p step computed '(1 2 1)))
      (unit (library-library-axiom lib "UNICITY-OF-1" (list value)))
      (fixed (t2-field-numeric-fix lib value numeric)))
     (proof-proof-chain p step (list unit fixed)))))

(defun t2-half-parity-fold-constants (lib source value first second)
  (let* ((p (library-library-proof lib))
         (sum (library-plus first second)))
    (proof-with-checked-results
     ((step (t2-book-logic-ac-equal lib source (library-plus value sum)))
      (computed (t2-book-logic-constant lib sum))
      (step (proof-proof-rewrite p step computed '(1 2 2)))
      (right (caddr (proof-step-first step)))
      (constant (proof-term-at right 2)))
     (if (equal constant *proof-zero*)
         (proof-with-checked-results
          ((commuted (library-library-axiom lib "COMMUTATIVITY-OF-+"
                                            (list value *proof-zero*)))
           (number (t2-field-number lib value))
           (add-zero (t2-arithmetic-arithmetic-numeric-add-zero lib number)))
          (proof-proof-chain p step (list commuted add-zero)))
       step))))

(defun t2-half-parity-half-shift (lib)
  (let* ((p (library-library-proof lib))
         (x *library-x*)
         (half *t2-exponent-parity-half*)
         (two *t2-half-parity-two*)
         (double (t2-products-times two x))
         (shifted (library-plus half x))
         (test (library-integer double))
         (expected (proof-ite test (proof-neg (library-integer x)) *proof-false*)))
    (proof-with-checked-results
     ((numeric (proof-proof-assume p (list *library-numberp* x) t))
      (integer-double (proof-proof-assume p test t))
      (proof (library-library-cite lib "HALF-INTEGRAL-ALTERNATES"
                                   (list double) (list integer-double)))
      (cancelled (t2-half-parity-cancel-half lib numeric half two))
      (moved (library-library-axiom lib "DISTRIBUTIVITY" (list half double *proof-one*)))
      (moved (proof-proof-rewrite p moved cancelled '(1 2 1)))
      (value (t2-book-logic-constant lib (t2-products-times half *proof-one*)))
      (moved (proof-proof-rewrite p moved value '(1 2 2)))
      (commuted (library-library-axiom lib "COMMUTATIVITY-OF-+" (list x half)))
      (moved (proof-proof-chain p moved (list commuted)))
      (proof (proof-proof-rewrite p proof moved '(1 1 1)))
      (proof (proof-proof-rewrite p proof cancelled '(1 2 1 1)))
      (selected (proof-proof-if-true p expected))
      (yes (library-library-transport-argument lib proof selected 2))
      (source (library-plus (t2-products-times two shifted) *proof-neg-one*))
      (doubled (library-library-axiom lib "DISTRIBUTIVITY" (list two half x)))
      (value (t2-book-logic-constant lib (t2-products-times two half)))
      (doubled (proof-proof-rewrite p doubled value '(1 2 1)))
      (adjusted (t2-arithmetic-arithmetic-reflexive lib source))
      (adjusted (proof-proof-rewrite p adjusted doubled '(1 2 1)))
      (folded (t2-half-parity-fold-constants lib (caddr (proof-step-first adjusted))
                                            double *proof-one* *proof-neg-one*))
      (adjusted (proof-proof-chain p adjusted (list folded)))
      (integer-shifted (library-integer shifted))
      (known (proof-proof-assume p integer-shifted t))
      (known (t2-arithmetic-arithmetic-type-of lib source (list known)))
      (known (proof-proof-rewrite p known adjusted '(1 1)))
      (not-integer (proof-proof-assume p test nil))
      (cut (proof-proof-cut p known not-integer))
      (no (proof-proof-front p cut (proof-neg integer-shifted)))
      (no (t2-field-false-value lib no))
      (selected (proof-proof-if-false p expected))
      (no (library-library-transport-argument lib no selected 2))
      (proof (proof-proof-cases p test yes no)))
     (library-library-lemma lib "HALF-SHIFT-INTEGER-TEST" (proof-step-first proof) proof
                            (list (proof-neg (proof-step-first numeric)))))))

(defun t2-half-parity-translate-half-test (lib half argument integral)
  (let ((p (library-library-proof lib)))
    (proof-with-checked-results
     ((number (t2-field-number lib half))
      (test (library-library-cite lib "HALF-SHIFT-INTEGER-TEST" (list half) (list number)))
      (numeric (t2-arithmetic-number lib argument (list integral)))
      (cancelled (t2-half-parity-cancel-half lib numeric *t2-half-parity-two*
                                             *t2-exponent-parity-half*))
      (test (proof-proof-rewrite p test cancelled '(1 2 1 1)))
      (selected (proof-proof-select p (caddr (proof-step-first test)) integral)))
     (proof-proof-chain p test (list selected)))))

(defun t2-half-parity-sum-parity (lib)
  (let* ((p (library-library-proof lib))
         (x *library-x*)
         (y *library-y*)
         (half *t2-exponent-parity-half*)
         (left (t2-products-times half x))
         (right (t2-products-times half y))
         (sum (library-plus left right))
         (claim (library-integer sum))
         (integer-left (library-integer left))
         (integer-right (library-integer right))
         (expected (proof-ite integer-left integer-right (proof-neg integer-right))))
    (proof-with-checked-results
     ((integers (library-library-ints lib (list x y)))
      (ix (car integers))
      (iy (cadr integers))
      (left-integral (proof-proof-assume p integer-left t))
      (number (t2-field-number lib right))
      (translated (library-library-cite lib "INTEGER-TRANSLATION-TEST"
                                        (list right left) (list number left-integral)))
      (commuted (library-library-axiom lib "COMMUTATIVITY-OF-+" (list right left)))
      (translated (proof-proof-rewrite p translated commuted '(1 1 1)))
      (selected (proof-proof-if-true p expected))
      (yes (library-library-transport-argument lib translated selected 2))
      (a (library-plus half left))
      (b (library-plus right *t2-half-parity-neg-half*))
      (shifted (t2-half-parity-translate-half-test lib left x ix))
      (not-integral (proof-proof-assume p integer-left nil))
      (integral-a (proof-proof-transport p not-integral shifted))
      (number (t2-field-number lib b))
      (translated (library-library-cite lib "INTEGER-TRANSLATION-TEST"
                                        (list b a) (list number integral-a)))
      (restored (t2-half-parity-fold-constants lib (library-plus b a) sum
                                              *t2-half-parity-neg-half* half))
      (translated (proof-proof-rewrite p translated restored '(1 1 1)))
      (number (t2-field-number lib b))
      (one-integral (t2-arithmetic-arithmetic-type-of lib *proof-one* nil))
      (shift-right (library-library-cite lib "INTEGER-TRANSLATION-TEST"
                                         (list b *proof-one*) (list number one-integral)))
      (restored (t2-half-parity-fold-constants lib (library-plus b *proof-one*) right
                                              *t2-half-parity-neg-half* *proof-one*))
      (commuted (library-library-axiom lib "COMMUTATIVITY-OF-+" (list right half)))
      (restored (proof-proof-chain p restored (list commuted)))
      (shift-right (proof-proof-rewrite p shift-right restored '(1 1 1)))
      (reverse (proof-proof-symmetric p shift-right))
      (translate-right (t2-half-parity-translate-half-test lib right y iy))
      (no (proof-proof-chain p translated (list reverse translate-right)))
      (selected (proof-proof-if-false p expected))
      (no (library-library-transport-argument lib no selected 2))
      (proof (proof-proof-cases p integer-left yes no))
      (literal (proof-step-first proof)))
     (if (equal literal (proof-eq claim expected))
         (library-library-lemma lib "HALF-INTEGER-SUM-TEST" literal proof
                                (library-guards (list (proof-step-first ix) (proof-step-first iy))))
       '(:failure "failure" "")))))

(defun t2-half-parity-build (lib)
  (proof-with-checked-results
   ((lib (t2-half-parity-alternation lib))
    (lib (t2-half-parity-half-shift lib)))
   (t2-half-parity-sum-parity lib)))
