         (x *library-x*) (y *library-y*)
         (inv (t2-field-reciprocal x))
         (claim (proof-eq (t2-power-power inv y) (t2-field-reciprocal (t2-power-power x y))))
         (test (proof-eq (t2-field-fixed x) *proof-zero*)))
    (proof-with-checked-results
        ((not-zero (proof-proof-assume proof test nil))
         (evidence (t2-power-numeric-from-fixed-nonzero lib x not-zero))
         (distribution (library-library-cite lib "POWER-BASE-PRODUCT" (list x y inv) nil))
         (inversion (t2-field-inverse lib (car evidence) (cadr evidence)))
         (distribution (proof-proof-rewrite proof distribution inversion '(1 1 1)))
         (reversed (proof-proof-symmetric proof distribution))
         (unit (library-library-cite lib "POWER-UNIT-BASE" (list x y) nil))
         (product-one (proof-proof-chain proof reversed (list unit)))
         (numeric (library-library-cite lib "POWER-NUMBER" (list inv y) nil))
         (numeric-power (library-library-cite lib "POWER-NUMBER" (list x y) nil))
         (reciprocal (t2-field-unique-reciprocal lib product-one numeric numeric-power))
         (lib (cdr reciprocal))
         (proof (library-library-proof lib))
         (nonzero (proof-proof-symmetric proof (car reciprocal)))
         (evidence (proof-proof-assume proof test t))
         (value (t2-arithmetic-arithmetic-reflexive lib (t2-power-power inv y)))
         (inverse-zero (t2-field-reciprocal-zero lib x evidence))
         (value (proof-proof-rewrite proof value inverse-zero '(1 2 1)))
         (zero-power (library-library-cite lib "POWER-ZERO-BASE" (list *proof-zero* y) nil))
         (value (proof-proof-chain proof value (list zero-power)))
         (right (t2-arithmetic-arithmetic-reflexive lib (caddr claim)))
         (fixed-zero (library-library-cite lib "POWER-FIXED-ZERO" (list x y) (list evidence)))
         (right (proof-proof-rewrite proof right fixed-zero '(1 2 1)))
         (yes (t2-power-products-base-reciprocal-zero-branch lib value right t))
         (no (t2-power-products-base-reciprocal-zero-branch lib value right nil))
         (zero (proof-proof-cases proof (list *t2-power-zip* y) yes no))
         (result (proof-proof-cases proof test zero nonzero)))
      (library-library-lemma lib "POWER-BASE-RECIPROCAL" claim result nil))))

