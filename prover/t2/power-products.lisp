(defun t2-power-products-combine-exponents (lib)
  (let* ((proof (library-library-proof lib))
         (x *library-x*) (y *library-y*) (z *library-z*)
         (base (t2-power-power x z))
         (exp-product (t2-products-times z y))
         (left (t2-power-power base y))
