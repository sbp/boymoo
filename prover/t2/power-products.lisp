(defun t2-power-products-scaled-exponent (lib exponent previous scale integers forward)
  (let* ((proof (library-library-proof lib))
         (increment (if forward *proof-one* *proof-neg-one*)))
    (proof-with-checked-results
        ((translated (t2-arithmetic-linear-equal lib exponent (library-plus previous increment) integers))
         (product (t2-arithmetic-arithmetic-reflexive lib (t2-products-times scale exponent)))
         (product (proof-proof-rewrite proof product translated '(1 2 2)))
         (distribution (library-library-axiom lib "DISTRIBUTIVITY" (list scale previous increment)))
         (product (proof-proof-chain proof product (list distribution)))
         (numeric (t2-arithmetic-number lib scale integers))
         (unit (t2-field-identity lib scale numeric *proof-times*))
         (replacement
          (if forward
              unit
            (proof-with-checked-results
                ((negative (library-library-cite lib "FIELD-NEGATIVE-FACTOR" (list scale *proof-one*) nil))
                 (computed (proof-proof-compute proof (library-minus *proof-one*) -1))
                 (negative (proof-proof-rewrite proof negative computed '(1 1 2))))
              (proof-proof-rewrite proof negative unit '(1 2 1)))))
         (product (proof-proof-rewrite proof product replacement '(1 2 2)))
         (right (t2-power-products-operand product 2))
         (order (library-library-axiom lib "COMMUTATIVITY-OF-+" (cdr right))))
      (proof-proof-chain proof product (list order)))))

(defun t2-power-products-combine-case
    (lib forward descent-case formula numeric distinct outer inner numeric-base nonzero-base)
  (let* ((proof (library-library-proof lib))
         (x *library-x*) (y *library-y*) (z *library-z*)
         (base (t2-power-power x z))
         (integers (list outer inner)))
    (proof-with-checked-results
        ((parts (proof-list-of-length descent-case 2))
         (smaller (car parts))
         (pairs (list (list y smaller)))
         (sub (t2-arithmetic-arithmetic-type-of lib smaller integers))
         (ih (t2-power-smaller-instance lib formula (cadr parts) pairs
                                        (list numeric distinct sub inner)))
         (lhs (t2-power-recurrence-from-smaller lib base outer sub numeric-base nonzero-base forward))
         (lhs (proof-proof-rewrite proof lhs ih '(1 2 2)))
         (lhs
          (if forward
              lhs
            (proof-with-checked-results
                ((inversion (library-library-cite lib "POWER-NEGATE-EXPONENT" (list x z)
                                                   (list numeric distinct inner)))
                 (reversed (proof-proof-symmetric proof inversion)))
              (proof-proof-rewrite proof lhs reversed '(1 2 1)))))
         (scaled (t2-power-products-scaled-exponent lib y smaller z integers forward))
         (right (t2-power-products-operand scaled 2))
         (summands (proof-list-of-length (cdr right) 2))
         (i (car summands))
         (j (cadr summands))
         (ii (t2-arithmetic-arithmetic-type-of lib i integers))
         (ij (t2-arithmetic-arithmetic-type-of lib j integers))
         (sum-law (library-library-cite lib "POWER-ADD-NONZERO" (list x i j)
                                        (list numeric distinct ii ij)))
         (reversed (proof-proof-symmetric proof scaled))
         (rhs (proof-proof-rewrite proof sum-law reversed '(1 1 2)))
         (reversed (proof-proof-symmetric proof rhs))
         (step (proof-proof-chain proof lhs (list reversed))))
      (list step pairs))))

