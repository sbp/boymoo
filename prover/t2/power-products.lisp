(in-package "BOYMOO-PROVER")

(set-verify-guards-eagerness 0)
(logic)

(defun t2-power-products-operand (step position)
  (proof-with-checked-results ((literal (proof-step-first step)))
    (proof-term-at literal position)))

(defun t2-power-products-firsts (steps)
  (if (endp steps)
      nil
    (proof-with-checked-results
        ((first (proof-step-first (car steps)))
         (rest (t2-power-products-firsts (cdr steps))))
      (cons first rest))))

(defun t2-power-products-rewrite-inverses (proof grouped per-factor position)
  (declare (xargs :measure (acl2-count per-factor)))
  (cond
   ((endp per-factor) grouped)
   (grouped
    (proof-with-checked-results
        ((grouped (proof-proof-rewrite proof grouped (car per-factor) (list 1 2 position))))
      (t2-power-products-rewrite-inverses proof grouped (cdr per-factor) (1+ position))))
   (t (proof-with-checked-results
          ((literal (proof-step-first (car per-factor)))
           (parts (proof-list-of-length literal 3)))
        (if (equal (car parts) *proof-equal*)
            '(:failure "failure" "")
          '(:failure "failure" ""))))))

(defun t2-power-products-inverse-product-equation (lib left right per-factor)
  (let* ((proof (library-library-proof lib))
         (a (t2-field-reciprocal left))
         (b (t2-field-reciprocal right)))
    (proof-with-checked-results
        ((grouped (t2-book-logic-ac-equal
                   lib (t2-products-times (t2-products-times left right) (t2-products-times a b))
                   (t2-products-times (t2-products-times left a) (t2-products-times right b))))
         (grouped (t2-power-products-rewrite-inverses proof grouped per-factor 1))
         (unit (proof-proof-compute proof (t2-products-times *proof-one* *proof-one*) 1)))
      (if grouped
          (proof-proof-chain proof grouped (list unit))
        '(:failure "failure" "")))))

(defun t2-power-products-both-one (lib product first second)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((equation (t2-arithmetic-arithmetic-reflexive lib product))
         (equation (proof-proof-rewrite proof equation first '(1 2 1)))
         (equation (proof-proof-rewrite proof equation second '(1 2 2)))
         (unit (proof-proof-compute proof (t2-products-times *proof-one* *proof-one*) 1)))
      (proof-proof-chain proof equation (list unit)))))

(defun t2-power-products-distribute-case
    (lib forward descent-case formula number-x nonzero-x number-z nonzero-z integral
         numeric-product nonzero-product)
  (let* ((proof (library-library-proof lib))
         (x *library-x*) (z *library-z*)
         (product (t2-products-times x z)))
    (proof-with-checked-results
        ((parts (proof-list-of-length descent-case 2))
         (smaller (car parts))
         (pairs (list (list *library-y* smaller)))
         (sub (t2-arithmetic-arithmetic-type-of lib smaller (list integral)))
         (ih (t2-power-smaller-instance lib formula (cadr parts) pairs
                                        (list number-x nonzero-x number-z nonzero-z sub)))
         (a (t2-power-recurrence-from-smaller lib x integral sub number-x nonzero-x forward))
         (b (t2-power-recurrence-from-smaller lib z integral sub number-z nonzero-z forward))
         (step (t2-power-recurrence-from-smaller
                lib product integral sub numeric-product nonzero-product forward))
         (step (proof-proof-rewrite proof step ih '(1 2 2)))
         (step (if forward
                   step
                 (proof-with-checked-results
                     ((inversion (library-library-cite lib "FIELD-RECIPROCAL-PRODUCT" (list x z) nil)))
                   (proof-proof-rewrite proof step inversion '(1 2 1)))))
         (right (t2-power-products-operand step 2))
         (a-right (t2-power-products-operand a 2))
         (b-right (t2-power-products-operand b 2))
         (order (t2-book-logic-ac-equal lib right (t2-products-times a-right b-right)))
         (step (proof-proof-chain proof step (list order)))
         (reversed (proof-proof-symmetric proof a))
         (step (proof-proof-rewrite proof step reversed '(1 2 1)))
         (reversed (proof-proof-symmetric proof b))
         (step (proof-proof-rewrite proof step reversed '(1 2 2)))
         (step (proof-proof-tidy proof step)))
      (list step pairs))))

(defun t2-power-products-distribute-nonzero (lib)
  (let ((proof (library-library-proof lib))
        (x *library-x*) (y *library-y*) (z *library-z*))
    (proof-with-checked-results
        ((number-x (proof-proof-assume proof (list *library-numberp* x) t))
         (nonzero-x (proof-proof-assume proof (proof-eq x *proof-zero*) nil))
         (number-z (proof-proof-assume proof (list *library-numberp* z) t))
         (nonzero-z (proof-proof-assume proof (proof-eq z *proof-zero*) nil))
         (ints (library-library-ints lib (list y)))
         (assumptions (append (list number-x nonzero-x number-z nonzero-z) ints))
         (terms (t2-power-products-firsts assumptions))
         (domain (t2-power-condition terms))
         (domain-step (proof-proof-assume proof domain t))
         (parts (t2-power-conjuncts lib domain-step (len assumptions)))
         (number-x (car parts))
         (nonzero-x (cadr parts))
         (number-z (caddr parts))
         (nonzero-z (cadddr parts))
         (integral (nth 4 parts))
         (product (t2-products-times x z))
         (left (t2-power-power product y))
         (right (t2-products-times (t2-power-power x y) (t2-power-power z y)))
         (formula (list *library-implies* domain (proof-eq left right)))
         (inverse-x (t2-field-inverse lib number-x nonzero-x))
         (inverse-z (t2-field-inverse lib number-z nonzero-z))
         (invert (t2-power-products-inverse-product-equation lib x z (list inverse-x inverse-z)))
         (numeric-product (t2-field-number lib product))
         (nonzero (t2-field-nonzero-factor lib invert))
         (nonzero-product (car nonzero))
         (lib (cdr nonzero))
         (proof (library-library-proof lib))
         (exp-zero (proof-proof-assume proof (proof-eq y *proof-zero*) t))
         (x-one (t2-power-zero-power lib x exp-zero))
         (z-one (t2-power-zero-power lib z exp-zero))
         (product-one (t2-power-products-both-one lib right x-one z-one))
         (zero-product (t2-power-zero-power lib product exp-zero))
         (reversed (proof-proof-symmetric proof product-one))
         (base (proof-proof-chain proof zero-product (list reversed)))
         (descents (t2-power-exponent-cases lib integral))
         (lib (cdr descents))
         (proof (library-library-proof lib))
         (forward (t2-power-products-distribute-case
                   lib t (caar descents) formula number-x nonzero-x number-z nonzero-z integral
                   numeric-product nonzero-product))
         (backward (t2-power-products-distribute-case
                    lib nil (cadar descents) formula number-x nonzero-x number-z nonzero-z integral
                    numeric-product nonzero-product))
         (cases (proof-proof-cases proof (library-positive y) (car forward) (car backward)))
         (step (proof-proof-cases proof (proof-eq y *proof-zero*) base cases))
         (ordinal (library-library-builtin lib 1 y))
         (case-step (t2-power-implication lib domain step))
         (induction (proof-proof-induct proof ordinal case-step formula (list *library-count* y)
                                        (list (cadr forward) (cadr backward))))
         (joint (t2-power-join lib assumptions))
         (step (t2-arithmetic-arithmetic-modus-ponens lib induction joint)))
      (cons step lib))))

(defun t2-power-products-base-product-zero-branch (lib left-zero product-value holds)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((right (t2-power-products-operand left-zero 2))
         (selected (if holds (proof-proof-if-true proof right) (proof-proof-if-false proof right)))
         (reversed (proof-proof-symmetric proof product-value)))
      (proof-proof-chain proof left-zero (list selected reversed)))))

(defun t2-power-products-base-product-discharge (lib step base test)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((assumed (proof-proof-assume proof test nil))
         (evidence (t2-power-numeric-from-fixed-nonzero lib base assumed))
         (step (proof-proof-discharge proof step (car evidence))))
      (proof-proof-discharge proof step (cadr evidence)))))

(defun t2-power-products-base-product (lib)
  (let* ((proof (library-library-proof lib))
         (x *library-x*) (y *library-y*) (z *library-z*)
         (product (t2-products-times x z))
         (left (t2-power-power product y))
         (right (t2-products-times (t2-power-power x y) (t2-power-power z y)))
         (x-zero (proof-eq (t2-field-fixed x) *proof-zero*))
         (z-zero (proof-eq (t2-field-fixed z) *proof-zero*))
         (zipped (list *t2-power-zip* y)))
    (proof-with-checked-results
        ((zero-base (proof-proof-assume proof x-zero t))
         (reflexive (t2-arithmetic-arithmetic-reflexive lib left))
         (fixed-product (t2-field-zero-fixed-product lib x z zero-base))
         (lib (cdr fixed-product))
         (proof (library-library-proof lib))
         (left-zero (proof-proof-rewrite proof reflexive (car fixed-product) '(1 2 1)))
         (power-zero (library-library-cite lib "POWER-ZERO-BASE" (list *proof-zero* y) nil))
         (left-zero (proof-proof-chain proof left-zero (list power-zero)))
         (first (library-library-cite lib "POWER-FIXED-ZERO" (list x y) (list zero-base)))
         (at-zero (proof-proof-assume proof zipped t))
         (second (proof-proof-unfold proof (t2-power-power z y)))
         (second-right (t2-power-products-operand second 2))
         (selected (proof-proof-select proof second-right at-zero))
         (second (proof-proof-chain proof second (list selected)))
         (first-right (t2-power-products-operand first 2))
         (selected (proof-proof-if-true proof first-right))
         (first-one (proof-proof-chain proof first (list selected)))
         (when-zipped (t2-power-products-both-one lib right first-one second))
         (selected (proof-proof-if-false proof first-right))
         (first-zero (proof-proof-chain proof first (list selected)))
         (when-unzipped (t2-field-zero-product-from-left lib (cadr right) (caddr right) first-zero))
         (lib (cdr when-unzipped))
         (proof (library-library-proof lib))
         (yes (t2-power-products-base-product-zero-branch lib left-zero when-zipped t))
         (no (t2-power-products-base-product-zero-branch lib left-zero (car when-unzipped) nil))
         (zero-left (proof-proof-cases proof zipped yes no))
         (zero-right (proof-proof-instantiate proof zero-left (list (list x z) (list z x))))
         (order (library-library-axiom lib "COMMUTATIVITY-OF-*" (list z x)))
         (zero-right (proof-proof-rewrite proof zero-right order '(1 1 1)))
         (order (library-library-axiom lib "COMMUTATIVITY-OF-*"
                                       (list (t2-power-power z y) (t2-power-power x y))))
         (zero-right (proof-proof-chain proof zero-right (list order)))
         (nonzero (t2-power-products-distribute-nonzero lib))
         (lib (cdr nonzero))
         (proof (library-library-proof lib))
         (nonzero (t2-power-products-base-product-discharge lib (car nonzero) x x-zero))
         (nonzero (t2-power-products-base-product-discharge lib nonzero z z-zero))
         (right-case (proof-proof-cases proof z-zero zero-right nonzero))
         (integer-case (proof-proof-cases proof x-zero zero-left right-case))
         (integer-test (library-integer y))
         (nonint (proof-proof-assume proof integer-test nil))
         (x-one (t2-power-nonintegral-exponent lib x nonint))
         (z-one (t2-power-nonintegral-exponent lib z nonint))
         (product-one (t2-power-products-both-one lib right x-one z-one))
         (product-value (t2-power-nonintegral-exponent lib product nonint))
         (reversed (proof-proof-symmetric proof product-one))
         (other (proof-proof-chain proof product-value (list reversed)))
         (result (proof-proof-cases proof integer-test integer-case other)))
      (library-library-lemma lib "POWER-BASE-PRODUCT" (proof-eq left right) result nil))))

(defun t2-power-products-base-reciprocal-zero-branch (lib value right holds)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((conditional (t2-power-products-operand value 2))
         (selected (if holds
                       (proof-proof-if-true proof conditional)
                     (proof-proof-if-false proof conditional)))
         (a (proof-proof-chain proof value (list selected)))
         (selected (if holds
                       (proof-proof-if-true proof conditional)
                     (proof-proof-if-false proof conditional)))
         (b (proof-proof-rewrite proof right selected '(1 2 1)))
         (b-right (t2-power-products-operand b 2))
         (computed (proof-proof-compute proof b-right (if holds 1 0)))
         (b (proof-proof-chain proof b (list computed)))
         (reversed (proof-proof-symmetric proof b)))
      (proof-proof-chain proof a (list reversed)))))

(defun t2-power-products-base-reciprocal (lib)
