(in-package "BOYMOO-PROVER")
(set-verify-guards-eagerness 0)

(defconst *t2-field-fix* '("sym" "ACL2" "FIX"))
(defconst *t2-field-divide* '("sym" "ACL2" "UNARY-/"))

(defun t2-field-fixed (term)
  (list *t2-field-fix* term))

(defun t2-field-reciprocal (term)
  (list *t2-field-divide* term))

(defun t2-field-step-term (step index)
  (proof-with-checked-results ((literal (proof-step-first step)))
    (proof-term-at literal index)))

(defun t2-field-binary-arguments (term)
  (if (integerp term)
      '(:failure "failure" "")
    (proof-list-of-length (cdr term) 2)))

(defun t2-field-conjunction (lib first second)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
     ((test (proof-step-first first))
      (consequence (proof-step-first second))
      (selection (proof-proof-select proof
                                     (proof-ite test consequence *proof-false*)
                                     first)))
     (proof-proof-transport proof second selection))))

(defun t2-field-number (lib term)
  (proof-with-checked-results
   ((operator (proof-term-at term 0)))
   (let ((name (cond ((equal operator *t2-field-fix*) "FIELD-FIX-NUMBER")
                     ((equal operator *t2-field-divide*) "FIELD-RECIPROCAL-NUMBER")
                     ((equal operator *proof-plus*) "SUM-NUMBER")
                     ((equal operator *proof-times*) "FIELD-PRODUCT-NUMBER")
                     ((equal operator *proof-minus*) "NEGATION-NUMBER"))))
     (if name
         (library-library-cite lib name (cdr term) nil)
       '(:failure "missing-binding" "")))))

(defun t2-field-numeric-fix (lib term numeric)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
     ((equation (proof-proof-unfold proof (t2-field-fixed term)))
      (body (t2-field-step-term equation 2))
      (selection (proof-proof-select proof body numeric)))
     (proof-proof-chain proof equation (list selection)))))

(defun t2-field-identity (lib term numeric operator)
  (let* ((addition (equal operator *proof-plus*))
         (unit (if addition *proof-zero* *proof-one*))
         (uniqueness (if addition "UNICITY-OF-0" "UNICITY-OF-1"))
         (commutativity (if addition "COMMUTATIVITY-OF-+" "COMMUTATIVITY-OF-*")))
    (proof-with-checked-results
     ((commute (library-library-axiom lib commutativity (list term unit)))
      (unique (library-library-axiom lib uniqueness (list term)))
      (fixed (t2-field-numeric-fix lib term numeric)))
     (library-inherited proof-proof-chain lib commute (list unique fixed)))))

(defun t2-field-remove-fixed-operand (lib operator x y)
  (library-library-cite lib
                        (if (equal operator *proof-plus*)
                            "FIELD-ADD-FIX"
                          "FIELD-MULTIPLY-FIX")
                        (list x y)
                        nil))

(defun t2-field-inverse (lib numeric different)
  (proof-with-checked-results
   ((term (t2-field-step-term numeric 1))
    (axiom (library-library-axiom lib "INVERSE-OF-*" (list term)))
    (premise (t2-field-conjunction lib numeric different)))
   (t2-arithmetic-arithmetic-modus-ponens lib axiom premise)))

(defun t2-field-nonzero-factor (lib equation)
  (proof-with-checked-results
   ((literal (proof-step-first equation))
    (sides (t2-field-binary-arguments literal)))
   (let ((product (car sides))
         (unit (cadr sides)))
     (if (and (proof-is-call product *proof-times*) (equal unit *proof-one*))
         (proof-with-checked-results
          ((factors (t2-field-binary-arguments product)))
          (let* ((first (car factors))
                 (second (cadr factors))
                 (test (proof-eq first *proof-zero*))
                 (proof (library-library-proof lib)))
            (proof-with-checked-results
             ((assumption (proof-proof-assume proof test t))
              (zero-case (proof-proof-rewrite proof equation assumption '(1 1 1)))
              (commute (library-library-axiom lib "COMMUTATIVITY-OF-*"
                                              (list *proof-zero* second)))
              (zero-case (proof-proof-rewrite proof zero-case commute '(1 1)))
              (zero-product (t2-products-product-zero lib second))
              (lib (cdr zero-product))
              (proof (library-library-proof lib))
              (zero-case (proof-proof-rewrite proof zero-case (car zero-product) '(1 1)))
              (computed (proof-proof-compute proof (proof-eq *proof-zero* *proof-one*)
                                             *proof-nil*))
              (zero-case (proof-proof-rewrite proof zero-case computed '(1)))
              (zero-case (proof-proof-tidy proof zero-case))
              (result (proof-proof-front proof zero-case (proof-neg test))))
             (cons result lib))))
       '(:failure "failure" "")))))

(defun t2-field-unique-reciprocal (lib equation numeric-candidate numeric-factor)
  (proof-with-checked-results
   ((product (t2-field-step-term equation 1))
    (factors (t2-field-binary-arguments product)))
   (let ((a (car factors))
         (b (cadr factors)))
     (proof-with-checked-results
      ((numeric-a (or numeric-factor (t2-field-number lib a)))
       (nonzero (t2-field-nonzero-factor lib equation))
       (lib (cdr nonzero))
       (invert (t2-field-inverse lib numeric-a (car nonzero)))
       (inv (t2-field-reciprocal a))
       (inv-numeric (t2-field-number lib inv))
       (multiplied (t2-field-identity lib inv inv-numeric *proof-times*))
       (proof (library-library-proof lib))
       (unit-product (proof-proof-symmetric proof multiplied))
       (unit-equation (proof-proof-symmetric proof equation))
       (result (proof-proof-rewrite proof unit-product unit-equation '(1 2 2)))
       (assoc (library-library-axiom lib "ASSOCIATIVITY-OF-*" (list inv a b)))
       (assoc (proof-proof-symmetric proof assoc))
       (result (proof-proof-chain proof result (list assoc)))
       (commute (library-library-axiom lib "COMMUTATIVITY-OF-*" (list inv a)))
       (product (proof-proof-chain proof commute (list invert)))
       (result (proof-proof-rewrite proof result product '(1 2 1)))
       (unique (library-library-axiom lib "UNICITY-OF-1" (list b)))
       (fixed (t2-field-numeric-fix lib b numeric-candidate))
       (result (proof-proof-chain proof result (list unique fixed))))
      (cons result lib)))))

(defun t2-field-reciprocal-zero (lib value zero)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
     ((equality (library-library-cite lib "FIELD-RECIPROCAL-FIX" (list value) nil))
      (equality (proof-proof-symmetric proof equality))
      (equality (proof-proof-rewrite proof equality zero '(1 2 1)))
      (computed (proof-proof-compute proof (t2-field-reciprocal *proof-zero*) 0)))
     (proof-proof-chain proof equality (list computed)))))

(defun t2-field-cancel-inverse-on-right (lib value factor inverse-product)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
     ((normalized (library-library-axiom lib "ASSOCIATIVITY-OF-*"
                                         (list value factor (t2-field-reciprocal factor))))
      (normalized (proof-proof-rewrite proof normalized inverse-product '(1 2 2)))
      (commute (library-library-axiom lib "COMMUTATIVITY-OF-*" (list value *proof-one*)))
      (unique (library-library-axiom lib "UNICITY-OF-1" (list value))))
     (proof-proof-chain proof normalized (list commute unique)))))

(defun t2-field-multiply-cancel (lib value other factor equality inverse-product)
  (let ((inv (t2-field-reciprocal factor))
        (proof (library-library-proof lib)))
    (proof-with-checked-results
     ((lhs (t2-field-step-term equality 1))
      (reflexive (proof-proof-reflexive proof (t2-products-times lhs inv)))
      (result (proof-proof-rewrite proof reflexive equality '(1 2 1)))
      (left (t2-field-cancel-inverse-on-right lib value factor inverse-product))
      (result (proof-proof-rewrite proof result left '(1 1)))
      (right (t2-field-cancel-inverse-on-right lib other factor inverse-product))
      (result (proof-proof-rewrite proof result right '(1 2))))
     (proof-proof-tidy proof result))))

(defun t2-field-true-equality (lib step)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
     ((literal (proof-step-first step))
      (parts (proof-list-of-length literal 3))
      (reflexive (proof-proof-fact proof "equal-same" (list (list *library-x* (caddr parts)))))
      (reversed (proof-proof-symmetric proof step))
      (result (proof-proof-rewrite proof reflexive reversed '(1 1 1))))
     (proof-proof-tidy proof result))))

(defun t2-field-false-value (lib evidence)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
     ((term (t2-field-step-term evidence 1))
      (boolean (proof-proof-nil-or-true proof term)))
     (proof-proof-discharge proof boolean evidence))))

(defun t2-field-equal-predicates-positive (step boolean lib)
  (if boolean
      (t2-book-logic-true-boolean lib boolean step)
    (proof-with-checked-results ((result (t2-field-true-equality lib step)))
      (cons result lib))))

(defun t2-field-equal-predicates (lib left right goes-right goes-left
                                  left-boolean right-boolean)
  (proof-with-checked-results
   ((selected (library-inherited proof-proof-assume lib left t))
    (a-true (t2-field-equal-predicates-positive selected left-boolean lib))
    (lib (cdr a-true))
    (b-true (t2-field-equal-predicates-positive goes-right right-boolean lib))
    (lib (cdr b-true))
    (proof (library-library-proof lib))
    (no (proof-proof-assume proof left nil))
    (not-right (proof-proof-cut proof goes-left no))
    (not-right (proof-proof-front proof not-right (proof-neg right)))
    (a-false (t2-field-false-value lib no))
    (b-false (t2-field-false-value lib not-right))
    (b-true-reversed (proof-proof-symmetric proof (car b-true)))
    (yes-step (proof-proof-chain proof (car a-true) (list b-true-reversed)))
    (b-false-reversed (proof-proof-symmetric proof b-false))
    (no-step (proof-proof-chain proof a-false (list b-false-reversed)))
    (result (proof-proof-cases proof left yes-step no-step)))
   (cons result lib)))

(defun t2-field-inverse-of-fixed (lib value nonzero)
  (let* ((fix (t2-field-fixed value))
         (reciprocal (t2-field-reciprocal value))
         (proof (library-library-proof lib)))
    (proof-with-checked-results
     ((number (t2-field-number lib fix))
      (result (t2-field-inverse lib number nonzero))
      (fixed (library-library-cite lib "FIELD-RECIPROCAL-FIX" (list value) nil))
      (result (proof-proof-rewrite proof result fixed '(1 1 2)))
      (swapped (library-library-axiom lib "COMMUTATIVITY-OF-*" (list fix reciprocal)))
      (removed (t2-field-remove-fixed-operand lib *proof-times* reciprocal value))
      (commuted (library-library-axiom lib "COMMUTATIVITY-OF-*" (list reciprocal value)))
      (unfolded (proof-proof-chain proof swapped (list removed commuted)))
      (result (proof-proof-rewrite proof result unfolded '(1 1))))
     (proof-proof-tidy proof result))))

(defun t2-field-zero-product-from-left (lib left right zero)
