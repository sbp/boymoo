      (result (proof-proof-cases proof zero-test yes-step no-step)))
     (library-library-lemma lib "FIELD-RIGHT-CANCELLATION" (proof-eq left formula) result nil))))

(defun t2-field-inverse-twice (lib)
  (let* ((x *library-x*)
         (inner (t2-field-reciprocal x))
         (term (t2-field-reciprocal inner))
         (fixed (t2-field-fixed x))
         (test (proof-eq fixed *proof-zero*))
         (proof (library-library-proof lib)))
    (proof-with-checked-results
     ((assumed (proof-proof-assume proof test nil))
      (reciprocal-product (t2-field-inverse-of-fixed lib x assumed))
      (fixed-right (t2-field-remove-fixed-operand lib *proof-times* inner x))
      (commute (library-library-axiom lib "COMMUTATIVITY-OF-*" (list inner x)))
      (reflected (proof-proof-chain proof fixed-right (list commute reciprocal-product)))
