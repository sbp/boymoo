      (cases (proof-proof-cases proof int-x int-case rational-case)))
     (library-library-lemma lib "FIELD-DENOMINATOR-ONE" (proof-eq left right) cases nil))))

(defun t2-field-fraction-conjuncts (lib evidence premise)
  (if (endp evidence)
      premise
    (proof-with-checked-results
     ((premise (t2-field-conjunction lib (car evidence) premise)))
     (t2-field-fraction-conjuncts lib (cdr evidence) premise))))

(defun t2-field-fraction-lemmas (lib)
  (let* ((x *library-x*)
         (zero *proof-zero*)
         (one *proof-one*)
         (numerator (list *t2-arithmetic-numerator* x))
         (denominator (list *t2-arithmetic-denominator* x))
         (ratio (list *library-rationalp* x))
         (proof (library-library-proof lib)))
    (proof-with-checked-results
     ((rational (proof-proof-assume proof ratio t))
      (parts (t2-arithmetic-rational-parts lib rational))
      (integers (list (car parts) (cadr parts)))
      (pos-d (caddr parts))
      (axiom (library-library-axiom lib "RATIONAL-IMPLIES2" (list x)))
      (invert (t2-arithmetic-arithmetic-modus-ponens lib axiom rational))
      (canceled (t2-floor-cancel-reciprocal lib denominator numerator integers pos-d))
      (canceled (proof-proof-rewrite-first proof canceled invert))
      (commute (library-library-axiom lib "COMMUTATIVITY-OF-*" (list x denominator)))
      (product (proof-proof-chain proof commute (list canceled)))
      (claim (proof-step-first product))
      (lib (library-library-lemma lib "FIELD-MULTIPLY-DENOMINATOR" claim product
                                  (list (proof-neg ratio))))
      (proof (library-library-proof lib))

      (completed (library-library-axiom lib "COMPLETION-OF-DENOMINATOR" (list x)))
      (body (t2-field-step-term completed 2))
      (false-branch (proof-proof-if-false proof body))
      (other (proof-proof-chain proof completed (list false-branch)))
      (reflexive (proof-proof-reflexive proof (t2-products-times x denominator)))
      (fallback (proof-proof-rewrite proof reflexive other '(1 2 2)))
      (commute (library-library-axiom lib "COMMUTATIVITY-OF-*" (list x one)))
      (unique (library-library-axiom lib "UNICITY-OF-1" (list x)))
      (fallback (proof-proof-chain proof fallback (list commute unique)))
      (formula (proof-ite ratio numerator (t2-field-fixed x)))
      (true-branch (proof-proof-if-true proof formula))
      (yes-step (library-library-transport-argument lib product true-branch 2))
      (false-branch (proof-proof-if-false proof formula))
      (no-step (library-library-transport-argument lib fallback false-branch 2))
      (claim (proof-step-first yes-step))
      (cases (proof-proof-cases proof ratio yes-step no-step))
      (lib (library-library-lemma lib "FIELD-MULTIPLY-DENOMINATOR-COMPLETE" claim cases nil))
      (proof (library-library-proof lib))

      (ints (library-library-ints lib (list x)))
      (int-x (car ints))
      (rational-x (t2-arithmetic-rational lib x (list int-x)))
      (parts (t2-arithmetic-rational-parts lib rational-x))
      (int-d (cadr parts))
      (pos-d (caddr parts))
      (scaled (library-library-cite lib "FIELD-MULTIPLY-DENOMINATOR" (list x)
                                     (list rational-x)))
      (commute (library-library-axiom lib "COMMUTATIVITY-OF-*" (list denominator x)))
      (scaled (proof-proof-chain proof commute (list scaled)))
      (numeric (t2-arithmetic-number lib denominator (list int-d)))
      (unit (t2-field-identity lib denominator numeric *proof-times*))
      (int-one (t2-arithmetic-arithmetic-type-of lib one nil))
      (scaled-reversed (proof-proof-symmetric proof scaled))
      (unit-reversed (proof-proof-symmetric proof unit))
      (premise (t2-field-fraction-conjuncts
                lib (list scaled-reversed pos-d int-one int-x rational-x int-d) unit-reversed))
      (minimal (proof-proof-fact proof (proof-sym "LOWEST-TERMS" "ACL2")
                                 (list (list (proof-sym "N" "ACL2") denominator)
                                       (list (proof-sym "R" "ACL2") x)
                                       (list (proof-sym "Q" "ACL2") one))))
      (denom-one (t2-arithmetic-arithmetic-modus-ponens lib minimal premise))
      (claim (proof-step-first denom-one))
      (lib (library-library-lemma lib "FIELD-INTEGER-DENOMINATOR" claim denom-one
                                  (list (proof-neg (library-integer x)))))
      (proof (library-library-proof lib))
      (from-product (proof-proof-symmetric proof scaled))
      (from-product (proof-proof-rewrite proof from-product denom-one '(1 2 1)))
      (unique (library-library-axiom lib "UNICITY-OF-1" (list x)))
      (numeric (t2-arithmetic-number lib x (list int-x)))
      (fixed (t2-field-numeric-fix lib x numeric))
      (integer-num (proof-proof-chain proof from-product (list unique fixed)))
      (claim (proof-step-first integer-num))
      (lib (library-library-lemma lib "FIELD-INTEGER-NUMERATOR" claim integer-num
                                  (list (proof-neg (library-integer x)))))
      (lib (t2-field-denominator-one lib))
      (proof (library-library-proof lib))

      (left (proof-eq numerator zero))
      (right (proof-eq x zero))
      (parts (t2-arithmetic-rational-parts lib rational))
      (positive-d (caddr parts))
      (parts (t2-arithmetic-rational-parts lib rational))
      (d-type (cadr parts))
      (positive-neq (t2-products-strict-neq lib positive-d (list d-type)))
      (numeric (t2-arithmetic-number lib denominator (list d-type)))
      (distinct (t2-products-flip-neq lib positive-neq))
      (d-invert (t2-field-inverse lib numeric distinct))
      (assumed (proof-proof-assume proof left t))
      (output (proof-proof-chain proof product (list assumed)))
      (commute (library-library-axiom lib "COMMUTATIVITY-OF-*" (list zero denominator)))
      (zero-factor (t2-products-product-zero lib denominator))
      (lib (cdr zero-factor))
      (proof (library-library-proof lib))
      (zero-product (proof-proof-chain proof commute (list (car zero-factor))))
      (zero-reversed (proof-proof-symmetric proof zero-product))
      (output (proof-proof-chain proof output (list zero-reversed)))
      (precedes (t2-field-multiply-cancel lib x zero denominator output d-invert))
      (rational-number (proof-proof-fact proof "rationalp-acl2-numberp" nil))
      (num-x (t2-arithmetic-arithmetic-modus-ponens lib rational-number rational))
      (fixed (t2-field-numeric-fix lib x num-x))
      (precedes (proof-proof-rewrite proof precedes fixed '(1 1)))
      (numeric (t2-arithmetic-number lib zero nil))
      (fixed (t2-field-numeric-fix lib zero numeric))
      (precedes (proof-proof-rewrite proof precedes fixed '(1 2)))
      (product-reversed (proof-proof-symmetric proof product))
      (assumed (proof-proof-assume proof right t))
      (inverse-direction (proof-proof-rewrite proof product-reversed assumed '(1 2 1)))
      (inverse-direction (proof-proof-chain proof inverse-direction (list zero-product)))
      (result (t2-field-equal-predicates lib left right precedes inverse-direction nil nil))
      (lib (cdr result))
      (claim (proof-step-first (car result))))
     (library-library-lemma lib "FIELD-NUMERATOR-ZERO" claim (car result)
                            (list (proof-neg ratio))))))

