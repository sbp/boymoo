         (right (proof-eq (t2-field-fixed x) (t2-field-fixed y)))
         (proof (library-library-proof lib)))
    (proof-with-checked-results
     ((fixed-x (t2-field-remove-fixed-operand lib *proof-times* x z))
      (fixed-y (t2-field-remove-fixed-operand lib *proof-times* y z))
      (assumed (proof-proof-assume proof zero-test nil))
      (distinct (t2-products-flip-neq lib assumed))
