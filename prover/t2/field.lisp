(defun t2-field-product-second-numeric (lib step)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
     ((product (t2-field-step-term step 1))
      (factors (t2-field-binary-arguments product)))
     (let* ((first (car factors))
            (second (cadr factors))
            (numeric (list *library-numberp* second)))
       (proof-with-checked-results
        ((zero (library-library-axiom lib "COMPLETION-OF-*" (list second first)))
         (body (t2-field-step-term zero 2))
         (branch (proof-proof-if-false proof body))
         (zero (proof-proof-chain proof zero (list branch)))
         (commute (library-library-axiom lib "COMMUTATIVITY-OF-*" (list first second)))
         (zero (proof-proof-chain proof commute (list zero)))
         (contradiction (proof-proof-rewrite proof step zero '(1 1)))
         (computed (proof-proof-compute proof (proof-eq *proof-zero* *proof-one*) *proof-nil*))
         (contradiction (proof-proof-rewrite proof contradiction computed '(1)))
         (contradiction (proof-proof-tidy proof contradiction)))
        (proof-proof-front proof contradiction numeric))))))

(defun t2-field-numeric-axioms (lib)
  (proof-with-checked-results
   ((closure (library-library-axiom lib "CLOSURE" (list *library-x* *library-y*)))
    (conjuncts (t2-arithmetic-arithmetic-conjunct lib closure))
    (products (t2-arithmetic-arithmetic-conjunct lib (cadr conjuncts)))
    (reciprocals (t2-arithmetic-arithmetic-conjunct lib (cadr products)))
    (multiplied (car products))
    (inverted (cadr reciprocals))
    (claim (proof-step-first multiplied))
    (lib (library-library-lemma lib "FIELD-PRODUCT-NUMBER" claim multiplied nil))
    (claim (proof-step-first inverted))
    (lib (library-library-lemma lib "FIELD-RECIPROCAL-NUMBER" claim inverted nil))
    (sum-number (library-library-cite lib "SUM-NUMBER" (list *proof-zero* *library-x*) nil))
    (unique (library-library-axiom lib "UNICITY-OF-0" (list *library-x*)))
    (proof (library-library-proof lib))
    (fixed-number (proof-proof-rewrite proof sum-number unique '(1 1)))
    (fixed-number (proof-proof-tidy proof fixed-number))
    (claim (proof-step-first fixed-number)))
   (library-library-lemma lib "FIELD-FIX-NUMBER" claim fixed-number nil)))

(defun t2-field-fixed-binary-lemma (lib operator unit suffix uniqueness tag)
  (let* ((x *library-x*)
         (y *library-y*)
         (term (list operator x (t2-field-fixed y)))
         (proof (library-library-proof lib)))
    (proof-with-checked-results
     ((unique (library-library-axiom lib uniqueness (list y)))
      (equality (proof-proof-symmetric proof unique))
      (reflexive (proof-proof-reflexive proof term))
      (result (proof-proof-rewrite proof reflexive equality '(1 2 2)))
      (commute (library-library-axiom lib (concatenate 'string "COMMUTATIVITY-OF-" suffix)
                                      (list unit y)))
      (result (proof-proof-rewrite proof result commute '(1 2 2)))
      (intermediate (list operator x y))
      (assoc (library-library-axiom lib (concatenate 'string "ASSOCIATIVITY-OF-" suffix)
                                    (list x y unit)))
      (assoc (proof-proof-symmetric proof assoc))
      (numeric (t2-field-number lib intermediate))
      (identity (t2-field-identity lib intermediate numeric operator))
      (result (proof-proof-chain proof result (list assoc identity))))
     (library-library-lemma lib tag (proof-eq term intermediate) result nil))))

(defun t2-field-fixed-unary-lemma (lib operator name label test good)
  (let* ((x *library-x*)
         (raw (list operator x))
         (coerced (list operator (t2-field-fixed x)))
         (proof (library-library-proof lib)))
    (proof-with-checked-results
     ((reflexive (proof-proof-reflexive proof coerced))
      (yes-step (proof-proof-rewrite proof reflexive good '(1 2 1)))
      (bad-value (proof-proof-assume proof test nil))
      (fixed-zero (t2-arithmetic-simplify proof (t2-field-fixed x) (list bad-value)
                                          (list *t2-field-fix*)))
      (zero (proof-proof-compute proof (list operator *proof-zero*) 0))
      (reflexive (proof-proof-reflexive proof coerced))
      (no-step (proof-proof-rewrite proof reflexive fixed-zero '(1 2 1)))
      (completion (library-library-axiom lib name (list x)))
      (body (t2-field-step-term completion 2))
      (zero-completion (t2-arithmetic-simplify proof body (list bad-value) (list *proof-not*)))
      (completion (proof-proof-chain proof completion (list zero-completion)))
      (completion (proof-proof-symmetric proof completion))
      (no-step (proof-proof-chain proof no-step (list zero completion)))
      (result (proof-proof-cases proof test yes-step no-step)))
     (library-library-lemma lib label (proof-eq coerced raw) result nil))))

(defun t2-field-fixed-operand-lemmas (lib)
  (let ((test (list *library-numberp* *library-x*)))
    (proof-with-checked-results
     ((lib (t2-field-fixed-binary-lemma lib *proof-plus* *proof-zero* "+"
                                       "UNICITY-OF-0" "FIELD-ADD-FIX"))
      (lib (t2-field-fixed-binary-lemma lib *proof-times* *proof-one* "*"
                                       "UNICITY-OF-1" "FIELD-MULTIPLY-FIX"))
      (truth (library-inherited proof-proof-assume lib test t))
      (good (t2-field-numeric-fix lib *library-x* truth))
      (lib (t2-field-fixed-unary-lemma lib *t2-field-divide* "COMPLETION-OF-UNARY-/"
                                      "FIELD-RECIPROCAL-FIX" test good)))
     (t2-field-fixed-unary-lemma lib *proof-minus* "COMPLETION-OF-UNARY-MINUS"
                                 "FIELD-MINUS-FIX" test good))))

(defun t2-field-minus-form (lib)
  (let* ((x *library-x*)
         (y *library-y*)
         (z *proof-zero*)
         (xneg (library-minus x))
         (fixed (t2-field-fixed x))
         (proof (library-library-proof lib)))
    (proof-with-checked-results
     ((reflexive (proof-proof-reflexive proof (library-plus xneg fixed)))
      (unique (library-library-axiom lib "UNICITY-OF-0" (list x)))
      (unique (proof-proof-symmetric proof unique))
      (zero (proof-proof-rewrite proof reflexive unique '(1 2 2)))
      (commute (library-library-axiom lib "COMMUTATIVITY-OF-+" (list xneg (library-plus z x))))
      (assoc (library-library-axiom lib "ASSOCIATIVITY-OF-+" (list z x xneg)))
      (zero (proof-proof-chain proof zero (list commute assoc)))
      (inverse (library-library-axiom lib "INVERSE-OF-+" (list x)))
      (zero (proof-proof-rewrite proof zero inverse '(1 2 2)))
      (computed (proof-proof-compute proof (library-plus z z) 0))
      (zero (proof-proof-chain proof zero (list computed)))
      (numeric (t2-field-number lib fixed))
      (double (t2-arithmetic-arithmetic-unique-inverse lib xneg fixed zero numeric))
      (lib (library-library-lemma lib "FIELD-DOUBLE-NEGATION"
                                  (proof-eq (library-minus xneg) fixed) double nil))
      (a (t2-products-times x y))
      (b (t2-products-times x (library-minus y)))
      (distribute (library-library-axiom lib "DISTRIBUTIVITY" (list x y (library-minus y))))
      (proof (library-library-proof lib))
      (equation (proof-proof-symmetric proof distribute))
      (inverse (library-library-axiom lib "INVERSE-OF-+" (list y)))
      (equation (proof-proof-rewrite proof equation inverse '(1 2 2)))
      (product-zero (t2-products-product-zero lib x))
      (lib (cdr product-zero))
      (proof (library-library-proof lib))
      (equation (proof-proof-chain proof equation (list (car product-zero))))
      (numeric (t2-field-number lib b))
      (result (t2-arithmetic-arithmetic-unique-inverse lib a b equation numeric))
      (result (proof-proof-symmetric proof result)))
     (library-library-lemma lib "FIELD-NEGATIVE-FACTOR" (proof-eq b (library-minus a)) result nil))))

