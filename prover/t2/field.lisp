      (fixed-y-reversed (proof-proof-symmetric proof fixed-y))
      (equal-products (proof-proof-rewrite proof equal-products fixed-y-reversed '(1 2)))
      (cancel (t2-field-multiply-cancel lib x y factor equal-products law))
      (given (proof-proof-assume proof right t))
      (inserted (library-library-axiom lib "COMMUTATIVITY-OF-*" (list x z)))
      (remove-x (t2-field-remove-fixed-operand lib *proof-times* z x))
      (remove-x (proof-proof-symmetric proof remove-x))
      (inserted (proof-proof-chain proof inserted (list remove-x)))
      (inserted (proof-proof-rewrite proof inserted given '(1 2 2)))
      (other (library-library-axiom lib "COMMUTATIVITY-OF-*" (list z y)))
      (remove-y (t2-field-remove-fixed-operand lib *proof-times* z y))
      (follows (proof-proof-chain proof inserted (list remove-y other)))
      (nonzero-result (t2-field-equal-predicates lib left right cancel follows nil nil))
      (lib (cdr nonzero-result))
      (zero-x (t2-field-rights-cancel-factor-zero x fixed-x lib zero-test))
      (lib (cdr zero-x))
      (zero-y (t2-field-rights-cancel-factor-zero y fixed-y lib zero-test))
      (lib (cdr zero-y))
      (proof (library-library-proof lib))
      (zero-y-reversed (proof-proof-symmetric proof (car zero-y)))
      (zeros (proof-proof-chain proof (car zero-x) (list zero-y-reversed)))
      (zero (t2-field-true-equality lib zeros))
      (assumed (proof-proof-assume proof zero-test t))
      (true-test (t2-field-true-equality lib assumed))
      (true-test (proof-proof-symmetric proof true-test))
