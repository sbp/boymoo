(defun t2-field-rights-cancel (lib)
  (let* ((x *library-x*)
         (y *library-y*)
         (z *library-z*)
         (xz (t2-products-times x z))
         (yz (t2-products-times y z))
         (left (proof-eq xz yz))
         (factor (t2-field-fixed z))
