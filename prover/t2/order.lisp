         (positive-y (library-positive y))
         (iff (proof-sym "IFF" "ACL2"))
         (comparison (if (equal index 1)
                         (library-lt product *proof-zero*)
                       (library-positive product)))
         (condition (proof-ite (proof-neg zero-x)
                               (proof-ite (proof-neg zero-y) (list iff flag positive-y) *proof-false*)
                               *proof-false*)))
    (proof-with-checked-results
     ((positive-positive (t2-order-product-signs-leaf
                          lib args types rat-x index condition flag nonzero-x nonzero-y
                          (car sign-x) (car sign-y) t t))
      (lib (cdr positive-positive))
      (positive-negative (t2-order-product-signs-leaf
                          lib args types rat-x index condition flag nonzero-x nonzero-y
                          (car sign-x) (cadr sign-y) t nil))
      (lib (cdr positive-negative))
      (negative-positive (t2-order-product-signs-leaf
                          lib args types rat-x index condition flag nonzero-x nonzero-y
                          (cadr sign-x) (car sign-y) nil t))
      (lib (cdr negative-positive))
      (negative-negative (t2-order-product-signs-leaf
                          lib args types rat-x index condition flag nonzero-x nonzero-y
                          (cadr sign-x) (cadr sign-y) nil nil))
      (lib (cdr negative-negative))
      (proof (library-library-proof lib))
      (yes (proof-proof-cases proof positive-y (car positive-positive) (car positive-negative)))
      (no (proof-proof-cases proof positive-y (car negative-positive) (car negative-negative)))
      (nonzero (proof-proof-cases proof positive-x yes no))
      (y-zero (proof-proof-assume proof zero-y t))
      (when-y-zero (t2-order-product-signs-zero-case
                    zero-product-y (list nonzero-x y-zero) lib comparison index condition))
      (x-zero (proof-proof-assume proof zero-x t))
      (when-x-zero (t2-order-product-signs-zero-case
                    zero-product-x (list x-zero) lib comparison index condition))
      (when-x-nonzero (proof-proof-cases proof zero-y when-y-zero nonzero))
      (step (proof-proof-cases proof zero-x when-x-zero when-x-nonzero))
