(in-package "BOYMOO-PROVER")

(set-verify-guards-eagerness 0)

(defun t2-order-known-rational (claim known)
  (if (endp known)
      nil
    (proof-with-checked-results ((literal (proof-step-first (car known))))
      (if (equal literal claim)
          (car known)
        (t2-order-known-rational claim (cdr known))))))

(mutual-recursion
 (defun t2-order-rational (lib term known)
   (declare (xargs :measure (acl2-count term)))
   (let ((claim (list *library-rationalp* term)))
     (proof-with-checked-results ((premise (t2-order-known-rational claim known)))
       (if premise
           premise
         (proof-with-checked-results ((operator (proof-term-at term 0)))
           (let ((name (cond ((equal operator *proof-plus*) "rationalp-binary-+")
                             ((equal operator *proof-times*) "rationalp-binary-*")
                             ((equal operator *proof-minus*) "rationalp-unary--")
                             ((equal operator *t2-field-divide*) "rationalp-unary-/")
                             (t nil))))
             (if (and name (consp term))
                 (proof-with-checked-results
                  ((arguments (t2-order-rational-arguments lib (cdr term) known))
                   (premise (cond ((equal (len arguments) 2)
                                   (t2-field-conjunction lib (car arguments) (cadr arguments)))
                                  ((consp arguments) (car arguments))
                                  (t '(:failure "MissingTermPart" ""))))
                   (fact (proof-proof-fact
                          (library-library-proof lib) name
                          (seq-zip (list *library-x* *library-y*) (cdr term)))))
                  (t2-arithmetic-arithmetic-modus-ponens lib fact premise))
               (t2-arithmetic-arithmetic-prove lib claim nil nil))))))))

 (defun t2-order-rational-arguments (lib terms known)
   (declare (xargs :measure (acl2-count terms)))
   (if (endp terms)
       nil
     (proof-with-checked-results
      ((first (t2-order-rational lib (car terms) known))
       (rest (t2-order-rational-arguments lib (cdr terms) known)))
      (cons first rest)))))

(defun t2-order-number-from-rational (lib evidence)
  (proof-with-checked-results
   ((literal (proof-step-first evidence))
    (term (proof-term-at literal 1))
    (fact (proof-proof-fact (library-library-proof lib)
                            "rationalp-acl2-numberp"
                            (list (list *library-x* term)))))
   (t2-arithmetic-arithmetic-modus-ponens lib fact evidence)))

(defun t2-order-negate-difference (lib a b)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
     ((equation (library-library-axiom lib "DISTRIBUTIVITY-OF-MINUS-OVER-+"
                                      (list a (library-minus b))))
      (double-negation (library-library-cite lib "FIELD-DOUBLE-NEGATION" (list b) nil))
      (equation (proof-proof-rewrite proof equation double-negation '(1 2 2)))
      (fixed (t2-field-remove-fixed-operand lib *proof-plus* (library-minus a) b))
      (commute (library-library-axiom lib "COMMUTATIVITY-OF-+" (list (library-minus a) b))))
     (proof-proof-chain proof equation (list fixed commute)))))

(defun t2-order-trichotomy (lib a b rats)
  (let* ((proof (library-library-proof lib))
         (difference (library-diff b a))
         (same (proof-eq a b))
         (delta-zero (proof-eq difference *proof-zero*)))
    (proof-with-checked-results
     ((eq-from-zero (library-library-axiom lib "ASSOCIATIVITY-OF-+"
                                          (list b (library-minus a) a)))
      (commute (library-library-axiom lib "COMMUTATIVITY-OF-+" (list (library-minus a) a)))
      (inverse (library-library-axiom lib "INVERSE-OF-+" (list a)))
      (reverse (proof-proof-chain proof commute (list inverse)))
      (eq-from-zero (proof-proof-rewrite proof eq-from-zero reverse '(1 2 2)))
      (commute (library-library-axiom lib "COMMUTATIVITY-OF-+" (list b *proof-zero*)))
      (zero-b (library-library-axiom lib "UNICITY-OF-0" (list b)))
      (eq-from-zero (proof-proof-chain proof eq-from-zero (list commute zero-b)))
      (delta-assumption (proof-proof-assume proof delta-zero t))
      (eq-from-zero (proof-proof-rewrite proof eq-from-zero delta-assumption '(1 1 1)))
      (zero-a (library-library-axiom lib "UNICITY-OF-0" (list a)))
      (eq-from-zero (proof-proof-rewrite proof eq-from-zero zero-a '(1 1)))
      (rat-a (t2-order-rational lib a rats))
      (number-a (t2-order-number-from-rational lib rat-a))
      (fixed-a (t2-field-numeric-fix lib a number-a))
      (eq-from-zero (proof-proof-rewrite proof eq-from-zero fixed-a '(1 1)))
      (rat-b (t2-order-rational lib b rats))
      (number-b (t2-order-number-from-rational lib rat-b))
      (fixed-b (t2-field-numeric-fix lib b number-b))
      (eq-from-zero (proof-proof-chain proof eq-from-zero (list fixed-b)))
      (different (proof-proof-assume proof same nil))
      (cut (proof-proof-cut proof eq-from-zero different))
      (nonzero (proof-proof-front proof cut (proof-neg delta-zero)))
      (trichotomy (library-library-axiom lib "TRICHOTOMY" (list difference)))
      (conjuncts (t2-arithmetic-arithmetic-conjunct lib trichotomy))
      (numeric (t2-field-number lib difference))
      (case (t2-arithmetic-arithmetic-modus-ponens lib (car conjuncts) numeric))
      (negative (proof-proof-assume proof (library-lt a b) nil))
      (less-difference (library-library-cite lib "FIELD-LESS-DIFFERENCE" (list a b) nil))
      (negative (proof-proof-rewrite proof negative less-difference '(1 1)))
      (result (proof-proof-prove-if proof case negative))
      (result (proof-proof-prove-if proof result nonzero))
      (negated (t2-order-negate-difference lib b a))
      (result (proof-proof-rewrite proof result negated '(1 2)))
      (reverse-difference (library-library-cite lib "FIELD-LESS-DIFFERENCE" (list b a) nil)))
     (proof-proof-transport proof result reverse-difference))))

(defun t2-order-irreflexive (lib value)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
     ((comparison (library-library-axiom lib "<-ON-OTHERS" (list value value)))
      (inverse (library-library-axiom lib "INVERSE-OF-+" (list value)))
      (comparison (proof-proof-rewrite proof comparison inverse '(1 2 1)))
      (zero (library-library-axiom lib "ZERO" nil)))
     (library-library-transport-argument lib zero comparison 1))))

(defun t2-order-strict-chain-lemma (lib name)
  (let* ((proof (library-library-proof lib))
         (x *library-x*)
         (y *library-y*)
         (z *library-z*)
         (xy-test (library-lt x y))
         (yz-test (library-lt y z))
         (dxy (library-diff y x))
         (dyz (library-diff z y)))
    (proof-with-checked-results
     ((xy (proof-proof-assume proof xy-test t))
      (xy-difference (library-library-cite lib "FIELD-LESS-DIFFERENCE" (list x y) nil))
      (xy (proof-proof-rewrite proof xy xy-difference '(1)))
      (yz (proof-proof-assume proof yz-test t))
      (yz-difference (library-library-cite lib "FIELD-LESS-DIFFERENCE" (list y z) nil))
      (yz (proof-proof-rewrite proof yz yz-difference '(1)))
      (combined (library-library-cite lib "POSITIVE-SUM" (list dxy dyz) (list xy yz)))
      (normal (t2-book-logic-ac-equal
               lib (library-plus dxy dyz)
               (library-plus (library-plus y (library-minus y)) (library-diff z x))))
      (inverse (library-library-axiom lib "INVERSE-OF-+" (list y)))
      (normal (proof-proof-rewrite proof normal inverse '(1 2 1)))
      (numeric (t2-field-number lib (library-diff z x)))
      (add-zero (t2-arithmetic-arithmetic-numeric-add-zero lib numeric))
      (normal (proof-proof-chain proof normal (list add-zero)))
      (combined (proof-proof-rewrite proof combined normal '(1 2)))
      (xz-difference (library-library-cite lib "FIELD-LESS-DIFFERENCE" (list x z) nil))
      (step (proof-proof-transport proof combined xz-difference))
      (claim (proof-step-first step)))
     (library-library-lemma lib name claim step (library-guards (list xy-test yz-test))))))

(defun t2-order-strict-chain (lib first second)
  (let ((name "FIELD-LESS-TRANSITIVE"))
    (proof-with-checked-results
     ((lib (if (assoc-equal (proof-sym "SELF-FIELD-LESS-TRANSITIVE" "ACL2")
                             (proof-proof-facts (library-library-proof lib)))
               lib
             (t2-order-strict-chain-lemma lib name)))
      (first-literal (proof-step-first first))
      (first-parts (proof-list-of-length first-literal 3))
      (second-literal (proof-step-first second))
      (second-parts (proof-list-of-length second-literal 3)))
     (let ((a (cadr first-parts))
           (b (caddr first-parts))
           (middle (cadr second-parts))
           (last (caddr second-parts)))
       (if (equal middle b)
           (proof-with-checked-results
            ((step (library-library-cite lib name (list a b last) (list first second))))
            (cons step lib))
         '(:failure "RecipeMismatch" ""))))))

(defun t2-order-opposite-order (lib strict)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
     ((literal (proof-step-first strict))
      (parts (proof-list-of-length literal 3)))
     (let* ((a (cadr parts))
            (b (caddr parts))
            (delta (library-diff b a)))
       (proof-with-checked-results
        ((less-difference (library-library-cite lib "FIELD-LESS-DIFFERENCE" (list a b) nil))
         (positive-delta (proof-proof-rewrite proof strict less-difference '(1)))
         (trichotomy (library-library-axiom lib "TRICHOTOMY" (list delta)))
         (conjuncts (t2-arithmetic-arithmetic-conjunct lib trichotomy))
         (exclusivity (cadr conjuncts))
         (exclusive-literal (proof-step-first exclusivity))
         (exclusive-test (proof-term-at exclusive-literal 1))
         (opened (proof-proof-unfold proof exclusive-test))
         (opened-literal (proof-step-first opened))
         (opened-body (proof-term-at opened-literal 2))
         (selected (proof-proof-select proof opened-body positive-delta))
         (as-nil (proof-proof-chain proof opened (list selected)))
         (not-nil (proof-proof-not-nil proof))
         (as-nil-reversed (proof-proof-symmetric proof as-nil))
         (denial (proof-proof-rewrite proof not-nil as-nil-reversed '(1 1)))
         (impossible (proof-proof-prove-if proof exclusivity denial))
         (negated (t2-order-negate-difference lib b a))
         (impossible (proof-proof-rewrite proof impossible negated '(1 1 2)))
         (reverse-difference (library-library-cite lib "FIELD-LESS-DIFFERENCE" (list b a) nil)))
        (library-library-transport-argument lib impossible reverse-difference 1))))))

(defun t2-order-increasing-product (lib comparison factor-positive types)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
     ((literal (proof-step-first comparison))
      (parts (proof-list-of-length literal 3))
      (factor-literal (proof-step-first factor-positive))
      (factor (proof-term-at factor-literal 2)))
     (let* ((a (cadr parts))
            (b (caddr parts))
            (delta (library-diff b a)))
       (proof-with-checked-results
        ((less-difference (library-library-cite lib "FIELD-LESS-DIFFERENCE" (list a b) nil))
         (difference (proof-proof-rewrite proof comparison less-difference '(1)))
         (rat-factor (t2-order-rational lib factor types))
         (rat-delta (t2-order-rational lib delta types))
         (product (library-library-cite lib "POSITIVE-PRODUCT" (list factor delta)
                                       (list rat-factor rat-delta factor-positive difference)))
         (distributed (library-library-axiom lib "DISTRIBUTIVITY" (list factor b (library-minus a))))
         (negative-factor (library-library-cite lib "FIELD-NEGATIVE-FACTOR" (list factor a) nil))
         (distributed (proof-proof-rewrite proof distributed negative-factor '(1 2 2)))
         (product (proof-proof-rewrite proof product distributed '(1 2)))
         (scaled-difference (library-library-cite
                             lib "FIELD-LESS-DIFFERENCE"
                             (list (t2-products-times factor a) (t2-products-times factor b)) nil)))
        (proof-proof-transport proof product scaled-difference))))))

(defun t2-order-boolean-less (lib formula)
  (if (integerp formula)
      '(:failure "failure" "")
    (proof-proof-fact (library-library-proof lib) "booleanp-<"
                      (seq-zip (list *library-x* *library-y*) (cdr formula)))))

(defun t2-order-zero-from-sign (lib value nonpos nonneg numeric)
  (let ((proof (library-library-proof lib))
        (test-pos (library-positive value))
        (test-zero (proof-eq value *proof-zero*)))
    (declare (ignore test-pos))
    (proof-with-checked-results
     ((trichotomy (library-library-axiom lib "TRICHOTOMY" (list value)))
      (conjuncts (t2-arithmetic-arithmetic-conjunct lib trichotomy))
      (tri (t2-arithmetic-arithmetic-modus-ponens lib (car conjuncts) numeric))
      (tri (proof-proof-prove-if proof tri nonpos))
      (not-zero (proof-proof-assume proof test-zero nil))
      (bad (proof-proof-prove-if proof tri not-zero))
      (less-zero (library-library-cite lib "FIELD-LESS-ZERO-NEGATION" (list value) nil))
      (bad (proof-proof-rewrite proof bad less-zero '(1)))
      (cut (proof-proof-cut proof bad nonneg)))
     (proof-proof-front proof cut test-zero))))

(defun t2-order-negate-left-factor (lib a b)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
     ((step (library-library-axiom lib "COMMUTATIVITY-OF-*" (list (library-minus a) b)))
      (negative (library-library-cite lib "FIELD-NEGATIVE-FACTOR" (list b a) nil))
      (step (proof-proof-chain proof step (list negative)))
      (commute (library-library-axiom lib "COMMUTATIVITY-OF-*" (list b a))))
     (proof-proof-rewrite proof step commute '(1 2 1)))))

(defun t2-order-distinct (lib strict)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
     ((literal (proof-step-first strict))
      (parts (proof-list-of-length literal 3)))
     (let* ((a (cadr parts))
            (b (caddr parts))
            (test (proof-eq a b)))
       (proof-with-checked-results
        ((same (proof-proof-assume proof test t))
         (bad (proof-proof-rewrite proof strict same '(1 1)))
         (irreflexive (t2-order-irreflexive lib b))
         (cut (proof-proof-cut proof bad irreflexive)))
        (proof-proof-front proof cut (proof-neg test)))))))

(defun t2-order-scaled-quotient (lib numerator divisor denominator-type distinct-from-zero types)
  (let ((proof (library-library-proof lib))
        (quotient (t2-field-reciprocal divisor)))
    (proof-with-checked-results
     ((numeric (t2-order-number-from-rational lib denominator-type))
      (law (t2-field-inverse lib numeric distinct-from-zero)))
     (if (equal numerator *proof-one*)
         law
       (let ((product (t2-products-times divisor (t2-products-times numerator quotient))))
         (proof-with-checked-results
          ((reordered (t2-book-logic-ac-equal
                       lib product (t2-products-times numerator (t2-products-times divisor quotient))))
           (reordered (proof-proof-rewrite proof reordered law '(1 2 2)))
           (rat-numerator (t2-order-rational lib numerator types))
           (numeric (t2-order-number-from-rational lib rat-numerator))
           (identity (t2-field-identity lib numerator numeric *proof-times*)))
          (proof-proof-chain proof reordered (list identity))))))))

