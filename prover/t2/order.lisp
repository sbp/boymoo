         (z-zero (proof-eq z *proof-zero*)))
    (proof-with-checked-results
     ((types (t2-order-assume-rationals lib (list x y z)))
      (positive (proof-proof-assume proof pos t))
      (yes (library-library-cite lib "FIELD-POSITIVE-SCALE" (list x y z)
                                 (append types (list positive))))
      (less-negations (library-library-cite lib "FIELD-LESS-NEGATIONS" (list b a) nil))
      (reverse (proof-proof-symmetric proof less-negations))
      (negated-y (t2-order-negate-left-factor lib z y))
      (negated-y (proof-proof-symmetric proof negated-y))
      (reverse (proof-proof-rewrite proof reverse negated-y '(1 2 1)))
      (negated-x (t2-order-negate-left-factor lib z x))
      (negated-x (proof-proof-symmetric proof negated-x))
      (reverse (proof-proof-rewrite proof reverse negated-x '(1 2 2)))
      (negative (proof-proof-assume proof neg-z t))
      (less-zero (library-library-cite lib "FIELD-LESS-ZERO-NEGATION" (list z) nil))
      (positive-magnitude (proof-proof-transport proof negative less-zero))
      (rat-magnitude (t2-order-rational lib (library-minus z) types))
      (inverted (library-library-cite lib "FIELD-POSITIVE-SCALE" (list y x (library-minus z))
                                      (list (cadr types) (car types) rat-magnitude
                                            positive-magnitude)))
      (negative-case (proof-proof-chain proof reverse (list inverted)))
      (negative-claim (proof-step-first negative-case))
      (rat-conditions (t2-order-first-literals types))
      (lib (library-library-lemma lib "FIELD-NEGATIVE-SCALE" negative-claim negative-case
                                  (library-guards (append rat-conditions (list neg-z)))))
      (proof (library-library-proof lib))
      (nonpos (proof-proof-assume proof pos nil))
      (nonneg (proof-proof-assume proof neg-z nil))
      (numeric (t2-order-number-from-rational lib (caddr types)))
      (zero (t2-order-zero-from-sign lib z nonpos nonneg numeric))
      (at-zero (t2-arithmetic-arithmetic-reflexive lib formula))
      (zero-product-x (t2-field-zero-product-from-left lib z x zero))
