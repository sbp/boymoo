      (proof (library-library-proof lib))
      (commute-x (library-library-axiom lib "COMMUTATIVITY-OF-*" (list z x)))
      (right (proof-proof-rewrite proof step commute-x '(1 1 1)))
      (commute-y (library-library-axiom lib "COMMUTATIVITY-OF-*" (list z y)))
      (right (proof-proof-rewrite proof right commute-y '(1 1 2)))
      (right-claim (proof-step-first right))
      (lib (library-library-lemma lib "FIELD-SCALE-RIGHT" right-claim right conditions))
      (rat-one (t2-arithmetic-rational lib *proof-one* nil))
      (lib (t2-order-complete-scaling-unit lib x *proof-one* 2 "X-Y-Y" types rat-one)))
     (t2-order-complete-scaling-unit lib *proof-one* x 1 "Y-X-Y" types rat-one))))

(defun t2-order-normalizing-quotients-law
    (lib numerator divisor tag reciprocal-d types denominator-type
         positive-case negative-case pos-product neg-product quotient-zero index args leaf-types)
  (let* ((proof (library-library-proof lib))
         (x *library-x*)
         (positive-d (library-positive divisor))
         (negative-d (library-lt divisor *proof-zero*))
         (other-index (- 3 index))
