      (zero-result (if reciprocal-p
                       (cons inverse-zero lib)
                     (proof-with-checked-results
                      ((reflexive (t2-arithmetic-arithmetic-reflexive lib quotient))
                       (rewritten (proof-proof-rewrite proof reflexive inverse-zero '(1 2 2)))
