      (computed (proof-proof-compute proof (library-lt *proof-zero* *proof-zero*) *proof-nil*))
      (at-zero (proof-proof-chain proof at-zero (list computed)))
      (zero-if (proof-ite z-zero *proof-false* *proof-false*))
      (zero-selected (proof-proof-select proof zero-if zero))
      (at-zero (library-library-transport-argument lib at-zero zero-selected 2))
      (negative-if (proof-ite neg-z (library-lt y x) zero-if))
      (when-negative (proof-proof-if-true proof negative-if))
      (negative-case (library-library-transport-argument lib negative-case when-negative 2))
      (when-zero (proof-proof-if-false proof negative-if))
      (zero-case (library-library-transport-argument lib at-zero when-zero 2))
      (root (proof-ite pos (library-lt x y) negative-if))
      (when-positive (proof-proof-if-true proof root))
      (yes (library-library-transport-argument lib yes when-positive 2))
      (no (proof-proof-cases proof neg-z negative-case zero-case))
      (when-not-positive (proof-proof-if-false proof root))
      (no (library-library-transport-argument lib no when-not-positive 2))
      (step (proof-proof-cases proof pos yes no))
      (claim (proof-step-first step))
      (conditions (library-guards rat-conditions))
