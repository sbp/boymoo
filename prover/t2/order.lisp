(defun t2-order-positive-scaling (lib)
  (let* ((proof (library-library-proof lib))
         (x *library-x*)
         (y *library-y*)
         (z *library-z*)
         (left (library-lt (t2-products-times z x) (t2-products-times z y)))
         (right (library-lt x y))
         (same (proof-eq x y)))
    (proof-with-checked-results
     ((rats (t2-order-assume-rationals lib (list x y z)))
      (pos (proof-proof-assume proof (library-positive z) t))
      (right-assumed (proof-proof-assume proof right t))
      (forward (t2-order-increasing-product lib right-assumed pos rats))
      (left-assumed (proof-proof-assume proof left t))
      (same-assumed (proof-proof-assume proof same t))
      (equality-case (proof-proof-rewrite proof left-assumed same-assumed '(1 1 2)))
      (irreflexive (t2-order-irreflexive lib (t2-products-times z y)))
      (impossible (proof-proof-cut proof equality-case irreflexive))
      (equality-case (proof-proof-subsume proof impossible
                                          (cons right (proof-step-clause impossible))))
      (equality-case (proof-proof-front proof equality-case right))
      (less (t2-order-trichotomy lib x y rats))
      (reverse (t2-order-increasing-product lib less pos rats))
      (opposite (t2-order-opposite-order lib reverse))
      (contradiction (proof-proof-cut proof left-assumed opposite))
      (different-case (proof-proof-front proof contradiction right))
      (cancel (proof-proof-cases proof same equality-case different-case))
      (left-boolean (t2-order-boolean-less lib left))
      (right-boolean (t2-order-boolean-less lib right))
      (equal-predicates (t2-field-equal-predicates
                         lib left right cancel forward left-boolean right-boolean))
      (rat-conditions (t2-order-first-literals rats))
      (pos-literal (proof-step-first pos)))
     (library-library-lemma
      (cdr equal-predicates) "FIELD-POSITIVE-SCALE" (proof-eq left right)
      (car equal-predicates) (library-guards (append rat-conditions (list pos-literal)))))))

(defun t2-order-complete-scaling-unit (lib before after index suffix types rat-one)
  (let* ((y *library-y*)
         (name (concatenate 'string "FIELD-SCALE-UNIT-" suffix))
         (known (append types (list rat-one))))
    (proof-with-checked-results
     ((rat-before (t2-order-rational lib before known))
      (rat-after (t2-order-rational lib after known))
      (ordered (library-library-cite lib "FIELD-SCALE-LEFT" (list before after y)
                                     (list rat-before rat-after (cadr types))))
      (numeric (t2-order-number-from-rational lib (cadr types)))
      (unit (t2-field-identity lib y numeric *proof-times*))
      (ordered (proof-proof-rewrite (library-library-proof lib) ordered unit (list 1 1 index)))
      (claim (proof-step-first ordered))
      (rat-conditions (t2-order-first-literals (list (car types) (cadr types))))
      (conditions (library-guards rat-conditions))
      (lib (library-library-lemma lib name claim ordered conditions))
      (commute (library-library-axiom lib "COMMUTATIVITY-OF-*" (list y *library-x*)))
      (swapped (proof-proof-rewrite (library-library-proof lib) ordered commute
                                    (list 1 1 (- 3 index))))
      (swapped-claim (proof-step-first swapped)))
     (library-library-lemma lib (concatenate 'string name "-REVERSED")
                            swapped-claim swapped conditions))))

(defun t2-order-complete-scaling (lib)
  (let* ((proof (library-library-proof lib))
         (x *library-x*)
         (y *library-y*)
         (z *library-z*)
         (a (t2-products-times z x))
         (b (t2-products-times z y))
