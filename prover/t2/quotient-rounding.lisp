(in-package "BOYMOO-PROVER")
(set-verify-guards-eagerness 0)

(defconst *t2-quotient-rounding-ceiling* (proof-cl "CEILING"))
(defconst *t2-quotient-rounding-truncate* (proof-cl "TRUNCATE"))
(defconst *t2-quotient-rounding-rem* (proof-cl "REM"))
(defconst *t2-quotient-rounding-mod* (proof-cl "MOD"))
(defconst *t2-quotient-rounding-ash* (proof-cl "ASH"))

(defun t2-quotient-rounding-first (step)
  (if step
      (proof-step-first step)
    '(:failure "failure" "")))

(defun t2-quotient-rounding-step-term (step index)
  (proof-with-checked-results ((literal (t2-quotient-rounding-first step)))
    (proof-term-at literal index)))

(defun t2-quotient-rounding-quotient-cases-init (lib dividend divisor)
  (let ((ratio (t2-products-times dividend (t2-field-reciprocal divisor))))
    (list :t2-quotient-rounding-quotient-cases lib dividend divisor ratio
          (list *library-rationalp* ratio) (library-integer ratio)
          (library-lt ratio *proof-zero*))))

(defun t2-quotient-rounding-quotient-cases-lib (cases)
  (nth 1 cases))

(defun t2-quotient-rounding-quotient-cases-dividend (cases)
  (nth 2 cases))

(defun t2-quotient-rounding-quotient-cases-divisor (cases)
  (nth 3 cases))

(defun t2-quotient-rounding-quotient-cases-ratio (cases)
  (nth 4 cases))

(defun t2-quotient-rounding-quotient-cases-rat (cases)
  (nth 5 cases))

(defun t2-quotient-rounding-quotient-cases-integral (cases)
  (nth 6 cases))

(defun t2-quotient-rounding-quotient-cases-negative (cases)
  (nth 7 cases))

(defun t2-quotient-rounding-quotient-cases-with-lib (cases lib)
  (cons (car cases) (cons lib (cddr cases))))

(defun t2-quotient-rounding-opened-rounding (lib function dividend divisor)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((step (proof-proof-unfold proof (list function dividend divisor)))
         (body (t2-quotient-rounding-step-term step 2))
         (bound (t2-input-fields-bindings lib body)))
      (proof-proof-chain proof step (list bound)))))

(defun t2-quotient-rounding-unit-product (lib value numeric)
  (let* ((proof (library-library-proof lib))
         (inverse (t2-field-reciprocal *proof-one*))
         (completed (t2-products-times value inverse)))
    (proof-with-checked-results
        ((reflexive (proof-proof-reflexive proof completed))
         (one (t2-book-logic-constant lib inverse))
         (unit (proof-proof-rewrite proof reflexive one '(1 2 2)))
         (identity (t2-field-identity lib value numeric *proof-times*)))
      (proof-proof-chain proof unit (list identity)))))

(defun t2-quotient-rounding-to-unit-divisor (lib function dividend divisor)
  (let ((proof (library-library-proof lib))
        (quotient (t2-products-times dividend (t2-field-reciprocal divisor))))
    (proof-with-checked-results
        ((left (t2-quotient-rounding-opened-rounding lib function dividend divisor))
         (right (t2-quotient-rounding-opened-rounding lib function quotient *proof-one*))
         (numeric (t2-field-number lib quotient))
         (unit (t2-quotient-rounding-unit-product lib quotient numeric))
         (completed (t2-quotient-rounding-step-term unit 1))
         (body (t2-quotient-rounding-step-term right 2))
         (right (proof-proof-rewrite-result proof right unit
                                            (proof-eq *proof-zero* body) completed))
         (reverse (proof-proof-symmetric proof right)))
      (proof-proof-chain proof left (list reverse)))))

(defun t2-quotient-rounding-completed-part (lib name ratio nonrational)
  (proof-with-checked-results
      ((step (library-library-axiom lib (concatenate 'string "COMPLETION-OF-" name)
                                    (list ratio))))
    (t2-input-fields-select lib step nonrational)))

(defun t2-quotient-rounding-fractional-value (cases opened ratio-test integral tests)
  (let* ((lib (t2-quotient-rounding-quotient-cases-lib cases))
         (proof (library-library-proof lib))
         (ratio (t2-quotient-rounding-quotient-cases-ratio cases))
         (denominator (proof-eq (list *t2-arithmetic-denominator* ratio) *proof-one*)))
    (proof-with-checked-results
        ((den (library-library-cite lib "FIELD-DENOMINATOR-ONE" (list ratio) nil))
         (den-body (t2-quotient-rounding-step-term den 2))
         (false-step (t2-arithmetic-simplify proof den-body (list integral ratio-test)
                                          (list *proof-not*)))
         (not-nil (proof-proof-not-nil proof))
         (den (proof-proof-chain proof den (list false-step)))
         (nonunit (library-library-transport-argument lib not-nil den 1))
         (nonunit-literal (t2-quotient-rounding-first nonunit)))
      (if (not (equal nonunit-literal (proof-neg denominator)))
          '(:failure "failure" "")
        (proof-with-checked-results
            ((opened (t2-input-fields-select lib opened nonunit))
             (sign (library-library-cite lib "FIELD-NUMERATOR-NEGATIVE" (list ratio)
                                         (list ratio-test)))
             (left (t2-quotient-rounding-step-term sign 1))
             (sign (if (equal left (library-lt (list *t2-arithmetic-numerator* ratio)
                                               *proof-zero*))
                       sign
                     (proof-proof-symmetric proof sign)))
             (comparison (proof-term-at tests 2))
             (comparison-literal (t2-quotient-rounding-first comparison))
             (n-sign (if (equal comparison-literal
                                 (proof-neg (t2-quotient-rounding-quotient-cases-negative cases)))
                         (library-library-transport-argument lib comparison sign 1)
                       (proof-proof-transport proof comparison sign)))
             (opened-body (t2-quotient-rounding-step-term opened 2))
             (selected (t2-arithmetic-simplify proof opened-body (list n-sign) (list *proof-not*))))
          (proof-proof-chain proof opened (list selected)))))))

(defun t2-quotient-rounding-quotient-cases-value (cases function tests)
  (let* ((lib (t2-quotient-rounding-quotient-cases-lib cases))
         (proof (library-library-proof lib))
         (ratio (t2-quotient-rounding-quotient-cases-ratio cases)))
    (proof-with-checked-results
        ((opened (t2-quotient-rounding-opened-rounding
                  lib function (t2-quotient-rounding-quotient-cases-dividend cases)
                  (t2-quotient-rounding-quotient-cases-divisor cases)))
         (body (t2-quotient-rounding-step-term opened 2))
         (test (proof-term-at body 1))
         (unfolded (proof-proof-unfold proof test))
         (opened (proof-proof-rewrite proof opened unfolded '(1 2 1)))
         (ratio-test (proof-term-at tests 0))
         (ratio-literal (t2-quotient-rounding-first ratio-test)))
      (if (equal ratio-literal (proof-neg (t2-quotient-rounding-quotient-cases-rat cases)))
          (proof-with-checked-results
              ((den (t2-quotient-rounding-completed-part lib "DENOMINATOR" ratio ratio-test))
               (selected (t2-input-fields-select lib opened den))
               (num (t2-quotient-rounding-completed-part lib "NUMERATOR" ratio ratio-test)))
            (proof-proof-chain proof selected (list num)))
        (proof-with-checked-results
            ((integral (proof-term-at tests 1))
             (integral-literal (t2-quotient-rounding-first integral)))
          (if (equal integral-literal (t2-quotient-rounding-quotient-cases-integral cases))
              (proof-with-checked-results
                  ((den (library-library-cite lib "FIELD-INTEGER-DENOMINATOR" (list ratio)
                                              (list integral)))
                   (selected (t2-input-fields-select lib opened den))
                   (num (library-library-cite lib "FIELD-INTEGER-NUMERATOR" (list ratio)
                                              (list integral))))
                (proof-proof-chain proof selected (list num)))
            (t2-quotient-rounding-fractional-value cases opened ratio-test integral tests)))))))

(defun t2-quotient-rounding-resolve-floor-term (lib floor expression)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results ((source (t2-quotient-rounding-step-term floor 1)))
      (if (equal expression source)
          floor
        (proof-with-checked-results
            ((reflexive (proof-proof-reflexive proof expression))
             (after (proof-proof-rewrite proof reflexive floor '(1 2 2)))
             (value (t2-quotient-rounding-step-term floor 2)))
          (if (proof-is-call value *proof-plus*)
              (proof-with-checked-results ((offset (proof-term-at value 2)))
                (if (equal offset *proof-neg-one*)
                    (proof-with-checked-results
                        ((after-body (t2-quotient-rounding-step-term after 2))
                         (base (proof-term-at value 1))
                         (folded (t2-half-parity-fold-constants lib after-body base
                                                                 *proof-one* *proof-neg-one*)))
                      (proof-proof-chain proof after (list folded)))
                  after))
            after))))))

(defun t2-quotient-rounding-cancel-divisor (lib dividend divisor nonzero)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((unit (t2-field-inverse-of-fixed lib divisor nonzero))
         (inverse (t2-field-reciprocal divisor))
         (commute (library-library-axiom lib "COMMUTATIVITY-OF-*" (list inverse divisor)))
         (unit (proof-proof-chain proof commute (list unit)))
         (assoc (library-library-axiom lib "ASSOCIATIVITY-OF-*" (list dividend inverse divisor)))
         (step (proof-proof-rewrite proof assoc unit '(1 2 2)))
         (commute (library-library-axiom lib "COMMUTATIVITY-OF-*" (list dividend *proof-one*)))
         (identity (library-library-axiom lib "UNICITY-OF-1" (list dividend))))
      (proof-proof-chain proof step (list commute identity)))))

(defun t2-quotient-rounding-cancel-nonzero-divisor (lib dividend divisor nonzero-ratio)
  (let* ((proof (library-library-proof lib))
         (ratio (t2-products-times dividend (t2-field-reciprocal divisor)))
         (test (proof-eq (t2-field-fixed divisor) *proof-zero*)))
    (proof-with-checked-results
        ((assumed (proof-proof-assume proof test t))
         (zero (t2-field-reciprocal-zero lib divisor assumed))
         (reflexive (proof-proof-reflexive proof ratio))
         (zero (proof-proof-rewrite proof reflexive zero '(1 2 2)))
         (product (t2-products-product-zero lib dividend))
         (lib (cdr product))
         (proof (library-library-proof lib))
         (zero (proof-proof-chain proof zero (list (car product))))
         (cut (proof-proof-cut proof zero nonzero-ratio))
         (nonzero (proof-proof-front proof cut (proof-neg test)))
         (cancelled (t2-quotient-rounding-cancel-divisor lib dividend divisor nonzero)))
      (cons cancelled lib))))

(defun t2-quotient-rounding-remainder-increment (lib opened floor)
  (let* ((proof (library-library-proof lib))
         (y *library-y*)
         (x *library-x*)
         (increment (library-plus *proof-one* floor))
         (product (t2-products-times increment y)))
    (proof-with-checked-results
        ((scaled (library-library-axiom lib "COMMUTATIVITY-OF-*" (list increment y)))
         (distributed (library-library-axiom lib "DISTRIBUTIVITY" (list y *proof-one* floor)))
         (scaled (proof-proof-chain proof scaled (list distributed)))
         (commute (library-library-axiom lib "COMMUTATIVITY-OF-*" (list y *proof-one*)))
         (identity (library-library-axiom lib "UNICITY-OF-1" (list y)))
         (unit (proof-proof-chain proof commute (list identity)))
         (scaled (proof-proof-rewrite proof scaled unit '(1 2 1)))
         (commute (library-library-axiom lib "COMMUTATIVITY-OF-*" (list y floor)))
         (scaled (proof-proof-rewrite proof scaled commute '(1 2 2)))
         (source (t2-quotient-rounding-step-term scaled 1)))
      (if (not (equal source product))
          '(:failure "failure" "")
        (proof-with-checked-results
            ((opened (proof-proof-rewrite proof opened scaled '(1 2 2 1)))
             (floor-product (t2-products-times floor y))
             (subtract (library-library-axiom lib "DISTRIBUTIVITY-OF-MINUS-OVER-+"
                                               (list (t2-field-fixed y) floor-product)))
             (opened (proof-proof-rewrite proof opened subtract '(1 2 2)))
             (minus-fix (library-library-cite lib "FIELD-MINUS-FIX" (list y) nil))
             (opened (proof-proof-rewrite proof opened minus-fix '(1 2 2 1)))
             (before (t2-quotient-rounding-step-term opened 2))
             (target (library-plus (library-diff x floor-product) (library-minus y)))
             (reordered (t2-book-logic-ac-equal lib before target))
             (opened (proof-proof-chain proof opened (list reordered)))
             (mod (proof-proof-unfold proof (list *t2-quotient-rounding-mod* x y)))
             (reverse (proof-proof-symmetric proof mod)))
          (proof-proof-rewrite proof opened reverse '(1 2 1)))))))

(defun t2-quotient-rounding-rounded-quotients-branch (tests cases function expected floor increment)
  (let* ((lib (t2-quotient-rounding-quotient-cases-lib cases))
         (proof (library-library-proof lib)))
    (proof-with-checked-results
        ((lhs (t2-quotient-rounding-quotient-cases-value cases function tests))
         (rhs (t2-arithmetic-simplify proof expected tests (list *proof-not*)))
         (target (t2-quotient-rounding-step-term rhs 2))
         (rhs (if (or (equal target floor) (equal target increment))
                  (proof-with-checked-results
                      ((value (t2-quotient-rounding-quotient-cases-value cases *t2-floor-floor* tests))
                       (resolved (t2-quotient-rounding-resolve-floor-term lib value target)))
                    (proof-proof-chain proof rhs (list resolved)))
                rhs))
         (left (t2-quotient-rounding-step-term lhs 2))
         (right (t2-quotient-rounding-step-term rhs 2))
         (lhs (if (equal left right)
                  lhs
                (proof-with-checked-results ((aligned (t2-book-logic-ac-equal lib left right)))
                  (proof-proof-chain proof lhs (list aligned)))))
         (reverse (proof-proof-symmetric proof rhs)))
      (proof-proof-chain proof lhs (list reverse)))))

(defun t2-quotient-rounding-remainders-branch (tests cases trunc rem fix floor mod expected)
  (let* ((lib (t2-quotient-rounding-quotient-cases-lib cases))
         (proof (library-library-proof lib))
         (x *library-x*)
         (y *library-y*))
    (proof-with-checked-results
        ((trunc-body (t2-quotient-rounding-step-term trunc 2))
         (simplified (t2-arithmetic-simplify proof trunc-body tests (list *proof-not*)))
         (specialized (proof-proof-chain proof trunc (list simplified)))
         (lhs (proof-proof-rewrite proof rem specialized '(1 2 2 1 1)))
         (point (t2-quotient-rounding-step-term specialized 2))
         (lhs-and-lib
          (cond ((equal point *proof-zero*)
                 (proof-with-checked-results
                     ((zero (library-library-cite lib "REMAINDER-WITH-ZERO-QUOTIENT" (list x y) nil))
                      (fix-equation (proof-proof-unfold proof fix))
                      (lhs (proof-proof-chain proof lhs (list zero fix-equation))))
                   (cons lhs lib)))
                ((equal point floor)
                 (proof-with-checked-results
                     ((opened (proof-proof-unfold proof mod))
                      (reverse (proof-proof-symmetric proof opened))
                      (lhs (proof-proof-chain proof lhs (list reverse))))
                   (cons lhs lib)))
                ((equal point (t2-quotient-rounding-quotient-cases-ratio cases))
                 (proof-with-checked-results
                     ((test (proof-term-at tests 2))
                      (nonzero (t2-order-distinct lib test))
                      (cancelled (t2-quotient-rounding-cancel-nonzero-divisor lib x y nonzero))
                      (lib (cdr cancelled))
                      (proof (library-library-proof lib))
                      (lhs (proof-proof-rewrite proof lhs (car cancelled) '(1 2 2 1)))
                      (fix (library-library-cite lib "FIELD-MINUS-FIX" (list x) nil))
                      (lhs (proof-proof-rewrite proof lhs fix '(1 2 2)))
                      (inverse (library-library-axiom lib "INVERSE-OF-+" (list x)))
                      (lhs (proof-proof-chain proof lhs (list inverse))))
                   (cons lhs lib)))
                (t (proof-with-checked-results
                       ((lhs (t2-quotient-rounding-remainder-increment lib lhs floor)))
                     (cons lhs lib)))))
         (lib (cdr lhs-and-lib))
         (proof (library-library-proof lib))
         (rhs (t2-arithmetic-simplify proof expected tests (list *proof-not*)))
         (reverse (proof-proof-symmetric proof rhs))
         (step (proof-proof-chain proof (car lhs-and-lib) (list reverse))))
      (cons step lib))))

(defun t2-quotient-rounding-branch-request-p (value)
  (eq (car value) :t2-quotient-rounding-branch-request))

(defun t2-quotient-rounding-branch-request-tests (request)
  (cadr request))

(defun t2-quotient-rounding-branch-request-lib (request)
  (caddr request))

(defun t2-quotient-rounding-branch-result (tests cases branch replies)
  (let ((lib (t2-quotient-rounding-quotient-cases-lib cases)))
    (case (car branch)
      (:rounded-quotients
       (proof-with-checked-results
           ((step (t2-quotient-rounding-rounded-quotients-branch
                   tests cases (nth 1 branch) (nth 2 branch) (nth 3 branch) (nth 4 branch))))
         (cons step lib)))
      (:remainders
       (t2-quotient-rounding-remainders-branch
        tests cases (nth 1 branch) (nth 2 branch) (nth 3 branch)
        (nth 4 branch) (nth 5 branch) (nth 6 branch)))
      (otherwise
       (let ((reply (assoc-equal tests replies)))
         (if reply
             (let ((result (cdr reply)))
               (cond ((failure-p result) result)
                     ((failure-p (car result)) (car result))
                     ((proof-step-p (car result)) result)
                     (t (cons result lib))))
           (list :t2-quotient-rounding-branch-request tests lib)))))))

(defmacro t2-quotient-rounding-with-branch-results (bindings result)
  (if (endp bindings)
      result
    (let ((binding (car bindings))
          (name (caar bindings)))
      `(let (,binding)
         (if (or (failure-p ,name) (t2-quotient-rounding-branch-request-p ,name))
             ,name
           (t2-quotient-rounding-with-branch-results ,(cdr bindings) ,result))))))

(defun t2-quotient-rounding-quotient-cases-signs (signs cases branch replies split ratio integral)
  (declare (xargs :measure (acl2-count signs)))
  (let ((lib (t2-quotient-rounding-quotient-cases-lib cases)))
    (if (endp signs)
        (cons (list nil nil) lib)
      (let ((proof (library-library-proof lib)))
        (proof-with-checked-results
            ((test (proof-proof-assume proof (t2-quotient-rounding-quotient-cases-negative cases)
                                      (car signs)))
             (nonintegral (proof-proof-assume proof (t2-quotient-rounding-quotient-cases-integral cases)
                                             nil)))
          (t2-quotient-rounding-with-branch-results
              ((fraction (t2-quotient-rounding-branch-result
                          (list ratio nonintegral test) cases branch replies))
               (cases (t2-quotient-rounding-quotient-cases-with-lib cases (cdr fraction)))
               (whole (if split
                          (t2-quotient-rounding-branch-result
                           (list ratio integral test) cases branch replies)
                        (cons nil (cdr fraction))))
               (cases (t2-quotient-rounding-quotient-cases-with-lib cases (cdr whole)))
               (rest (t2-quotient-rounding-quotient-cases-signs
                      (cdr signs) cases branch replies split ratio integral)))
            (cons (list (if split (cons (car whole) (caar rest)) nil)
                        (cons (car fraction) (cadar rest)))
                  (cdr rest))))))))

(defun t2-quotient-rounding-quotient-cases-prove-branch (cases branch replies split)
  (let* ((lib (t2-quotient-rounding-quotient-cases-lib cases))
         (proof (library-library-proof lib))
         (rat-test (t2-quotient-rounding-quotient-cases-rat cases))
         (int-test (t2-quotient-rounding-quotient-cases-integral cases))
         (sign-test (t2-quotient-rounding-quotient-cases-negative cases)))
    (t2-quotient-rounding-with-branch-results
        ((ratio (proof-proof-assume proof rat-test t))
         (integral (proof-proof-assume proof int-test t))
         (by-sign (t2-quotient-rounding-quotient-cases-signs
                   '(t nil) cases branch replies split ratio integral))
         (wholes (caar by-sign))
         (fractions (cadar by-sign))
         (cases (t2-quotient-rounding-quotient-cases-with-lib cases (cdr by-sign)))
         (proof (library-library-proof (cdr by-sign)))
         (whole (if split
                    (proof-with-checked-results
                        ((step (proof-proof-cases proof sign-test (car wholes) (cadr wholes))))
                      (cons step (cdr by-sign)))
                  (t2-quotient-rounding-branch-result (list ratio integral) cases branch replies)))
         (proof (library-library-proof (cdr whole)))
         (fraction (proof-proof-cases proof sign-test (car fractions) (cadr fractions)))
         (rational (proof-proof-cases proof int-test (car whole) fraction))
         (nonrational (proof-proof-assume proof rat-test nil))
         (cases (t2-quotient-rounding-quotient-cases-with-lib cases (cdr whole)))
         (other (t2-quotient-rounding-branch-result (list nonrational) cases branch replies))
         (proof (library-library-proof (cdr other)))
         (step (proof-proof-cases proof rat-test rational (car other))))
      (cons step (cdr other)))))

(defun t2-quotient-rounding-quotient-cases-prove-with-library (cases replies split-integer-sign)
  (t2-quotient-rounding-quotient-cases-prove-branch cases nil replies split-integer-sign))

(defun t2-quotient-rounding-rounded-quotients-for (cases floor increment functions)
  (declare (xargs :measure (acl2-count functions)))
  (if (endp functions)
      (t2-quotient-rounding-quotient-cases-lib cases)
    (let* ((function (car functions))
           (truncate-p (equal function *t2-quotient-rounding-truncate*))
           (adjusted (proof-ite (t2-quotient-rounding-quotient-cases-integral cases)
                                (t2-quotient-rounding-quotient-cases-ratio cases) increment))
           (adjusted (if truncate-p
                         (proof-ite (proof-neg (t2-quotient-rounding-quotient-cases-negative cases))
                                    floor adjusted)
                       adjusted))
           (expected (proof-ite (proof-neg (t2-quotient-rounding-quotient-cases-rat cases))
                                *proof-zero* adjusted)))
      (proof-with-checked-results
          ((step-and-lib (t2-quotient-rounding-quotient-cases-prove-branch
                          cases (list :rounded-quotients function expected floor increment)
                          nil truncate-p))
           (step (car step-and-lib))
           (name (proof-term-at function 2))
           (claim (t2-quotient-rounding-first step))
           (lib (library-library-lemma (cdr step-and-lib) (concatenate 'string name "-BY-FLOOR")
                                       claim step nil)))
        (t2-quotient-rounding-rounded-quotients-for
         (t2-quotient-rounding-quotient-cases-with-lib cases lib)
         floor increment (cdr functions))))))

(defun t2-quotient-rounding-rounded-quotients (lib)
  (let ((cases (t2-quotient-rounding-quotient-cases-init lib *library-x* *library-y*))
        (floor (list *t2-floor-floor* *library-x* *library-y*)))
    (t2-quotient-rounding-rounded-quotients-for
     cases floor (library-plus *proof-one* floor)
     (list *t2-quotient-rounding-truncate* *t2-quotient-rounding-ceiling*))))

(defun t2-quotient-rounding-zero-remainder (lib)
  (let* ((proof (library-library-proof lib))
         (x *library-x*)
         (y *library-y*)
         (zero *proof-zero*))
    (proof-with-checked-results
        ((step (proof-proof-reflexive proof (library-diff x (t2-products-times zero y))))
         (commute (library-library-axiom lib "COMMUTATIVITY-OF-*" (list zero y)))
         (product (t2-products-product-zero lib y))
         (lib (cdr product))
         (proof (library-library-proof lib))
         (product (proof-proof-chain proof commute (list (car product))))
         (step (proof-proof-rewrite proof step product '(1 2 2 1)))
         (minus-zero (proof-proof-compute proof (library-minus zero) 0))
         (step (proof-proof-rewrite proof step minus-zero '(1 2 2)))
         (commute (library-library-axiom lib "COMMUTATIVITY-OF-+" (list x zero)))
         (identity (library-library-axiom lib "UNICITY-OF-0" (list x)))
         (step (proof-proof-chain proof step (list commute identity)))
         (claim (t2-quotient-rounding-first step)))
      (library-library-lemma lib "REMAINDER-WITH-ZERO-QUOTIENT" claim step nil))))

(defun t2-quotient-rounding-remainders (lib)
  (let* ((proof (library-library-proof lib))
         (x *library-x*)
         (y *library-y*)
         (cases (t2-quotient-rounding-quotient-cases-init lib x y))
         (fix (t2-field-fixed x))
         (floor (list *t2-floor-floor* x y))
         (mod (list *t2-quotient-rounding-mod* x y)))
    (proof-with-checked-results
        ((trunc (library-library-cite lib "TRUNCATE-BY-FLOOR" (list x y) nil))
         (rem (proof-proof-unfold proof (list *t2-quotient-rounding-rem* x y)))
