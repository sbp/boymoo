(in-package "BOYMOO-PROVER")
(set-verify-guards-eagerness 0)
(logic)

(defun t2-power-transport-inverse-factors-orientation (lib orientation rational different evidence)
  (let ((proof (library-library-proof lib))
        (x *library-x*)
        (y *library-y*))
    (proof-with-checked-results
     ((step (library-library-cite
             lib (concatenate 'string "FIELD-CANCEL-RECIPROCAL-" orientation)
             (list y x) nil))
      (literal (proof-step-first step))
      (rhs (proof-term-at literal 2))
      (simplified (t2-arithmetic-simplify proof rhs (list evidence) (list *proof-not*)))
      (step (proof-proof-chain proof step (list simplified)))
      (claim (proof-step-first step))
      (rational-term (proof-step-first rational))
      (difference (proof-step-first different))
      (equal-zero (proof-term-at difference 1)))
     (library-library-lemma
      lib (concatenate 'string "RATIONAL-CANCEL-RECIPROCAL-" orientation)
      claim step (list (proof-neg rational-term) equal-zero)))))

(defun t2-power-transport-inverse-factors (lib)
  (let ((proof (library-library-proof lib))
        (x *library-x*))
    (proof-with-checked-results
     ((rational (proof-proof-assume proof (list *library-rationalp* x) t))
      (different (proof-proof-assume proof (proof-eq x *proof-zero*) nil))
      (numeric (t2-order-number-from-rational lib rational))
      (evidence (t2-power-fixed-nonzero lib numeric different))
      (lib (t2-power-transport-inverse-factors-orientation
            lib "LEFT" rational different evidence)))
     (t2-power-transport-inverse-factors-orientation lib "RIGHT" rational different evidence))))

(defun t2-power-transport-zero-base-negation (lib integral base-zero)
  (let* ((proof (library-library-proof lib))
         (x *library-x*)
         (y *library-y*)
         (exponent (library-minus y)))
    (proof-with-checked-results
     ((negative-integral (t2-arithmetic-arithmetic-type-of lib exponent (list integral)))
      (left (library-library-cite lib "POWER-FIXED-ZERO" (list x exponent) (list base-zero)))
      (zip-negative (t2-power-zip-equation lib exponent negative-integral))
      (left (proof-proof-rewrite proof left zip-negative '(1 2 1)))
      (zero-negations (library-library-cite lib "FIELD-ZERO-NEGATIONS" (list y) nil))
      (left (proof-proof-rewrite proof left zero-negations '(1 2 1)))
      (number-y (t2-arithmetic-number lib y (list integral)))
      (fixed-y (t2-field-numeric-fix lib y number-y))
      (left (proof-proof-rewrite proof left fixed-y '(1 2 1 1)))
      (right (t2-arithmetic-arithmetic-reflexive
              lib (t2-power-power (t2-field-reciprocal x) y)))
      (reciprocal-zero (t2-field-reciprocal-zero lib x base-zero))
      (right (proof-proof-rewrite proof right reciprocal-zero '(1 2 1)))
      (zero-power (library-library-cite lib "POWER-ZERO-BASE" (list *proof-zero* y) nil))
      (right (proof-proof-chain proof right (list zero-power)))
      (zip-y (t2-power-zip-equation lib y integral))
      (right (proof-proof-rewrite proof right zip-y '(1 2 1)))
      (right (proof-proof-symmetric proof right)))
     (proof-proof-chain proof left (list right)))))

(defun t2-power-transport-power-reciprocals (lib)
  (let* ((proof (library-library-proof lib))
         (x *library-x*)
         (y *library-y*)
         (z *library-z*))
    (proof-with-checked-results
     ((integers (library-library-ints lib (list y)))
      (integral (car integers))
      (inverted (library-library-cite lib "POWER-BASE-RECIPROCAL" (list x y) nil))
      (reversed (proof-proof-symmetric proof inverted))
      (claim (proof-step-first reversed))
      (reversed (proof-proof-symmetric proof inverted))
      (lib (library-library-lemma lib "POWER-RECIPROCAL-BASE-REVERSED" claim reversed nil))
      (proof (library-library-proof lib))
      (nonzero-test (proof-eq (t2-field-fixed x) *proof-zero*))
      (nonzero (proof-proof-assume proof nonzero-test nil))
      (parts (t2-power-numeric-from-fixed-nonzero lib x nonzero))
      (left (library-library-cite lib "POWER-NEGATE-EXPONENT" (list x y)
                                  (list (car parts) (cadr parts) integral)))
      (base-zero (proof-proof-assume proof nonzero-test t))
      (zero-case (t2-power-transport-zero-base-negation lib integral base-zero))
      (reversed (proof-proof-symmetric proof inverted))
      (nonzero-case (proof-proof-chain proof left (list reversed)))
      (yes (proof-proof-cases proof nonzero-test zero-case nonzero-case))
      (numeric-exponent (list *library-numberp* y))
      (integer-term (proof-step-first integral))
      (noninteger (proof-proof-assume proof integer-term nil))
      (numeric-exponent-step (proof-proof-assume proof numeric-exponent t))
      (negative (library-library-cite lib "INTEGERP-OF-NEGATION" (list y)
                                      (list numeric-exponent-step)))
      (closed (library-library-transport-argument lib noninteger negative 1))
      (nonint (library-library-cite lib "POWER-NONINTEGER-EXPONENT"
                                    (list x (library-minus y)) (list closed)))
      (completion (library-library-axiom lib "COMPLETION-OF-UNARY-MINUS" (list y)))
      (completion-first (proof-step-first completion))
      (completion-rhs (proof-term-at completion-first 2))
      (false-completion (proof-proof-if-false proof completion-rhs))
      (zero (proof-proof-chain proof completion (list false-completion)))
      (at-zero (t2-arithmetic-arithmetic-reflexive lib (t2-power-power x (library-minus y))))
      (at-zero (proof-proof-rewrite proof at-zero zero '(1 2 2)))
      (zero-exponent (library-library-cite lib "POWER-ZERO-EXPONENT" (list x) nil))
      (at-zero (proof-proof-chain proof at-zero (list zero-exponent)))
      (left (proof-proof-cases proof numeric-exponent nonint at-zero))
      (right (library-library-cite lib "POWER-NONINTEGER-EXPONENT"
                                   (list (t2-field-reciprocal x) y) (list noninteger)))
      (integer-term (proof-step-first integral))
      (right (proof-proof-symmetric proof right))
      (no (proof-proof-chain proof left (list right)))
      (step (proof-proof-cases proof integer-term yes no))
      (claim (proof-step-first step))
      (lib (library-library-lemma lib "POWER-NEGATE-EXPONENT-TO-BASE" claim step nil))
      (proof (library-library-proof lib))
      (one (library-library-cite lib "POWER-NEGATE-EXPONENT-TO-BASE" (list x *proof-one*) nil))
      (minus-one (t2-book-logic-constant lib (library-minus *proof-one*)))
      (one (if minus-one
               (proof-proof-rewrite proof one minus-one '(1 1 2))
             '(:failure "failure" "")))
      (reciprocal-x (t2-field-reciprocal x))
      (one-exponent (library-library-cite lib "POWER-ONE-EXPONENT" (list reciprocal-x) nil))
      (number-reciprocal (t2-field-number lib reciprocal-x))
      (fixed-reciprocal (t2-field-numeric-fix lib reciprocal-x number-reciprocal))
      (one (proof-proof-chain proof one (list one-exponent fixed-reciprocal)))
      (claim (proof-step-first one))
      (lib (library-library-lemma lib "POWER-MINUS-ONE-EXPONENT" claim one nil))
      (proof (library-library-proof lib))
      (step (library-library-cite lib "POWER-NEGATE-EXPONENT-TO-BASE"
                                   (list x (t2-products-times y z)) nil))
      (negative-factor (t2-order-negate-left-factor lib y z))
      (negative-factor (proof-proof-symmetric proof negative-factor))
      (step (proof-proof-rewrite proof step negative-factor '(1 1 2)))
      (step (proof-proof-symmetric proof step))
      (claim (proof-step-first step)))
     (library-library-lemma lib "POWER-NEGATE-EXPONENT-FACTOR" claim step nil))))

(defun t2-power-transport-rational-reconstruction (lib)
  (let ((proof (library-library-proof lib))
        (x *library-x*))
    (proof-with-checked-results
     ((rat (proof-proof-assume proof (list *library-rationalp* x) t))
      (axiom (library-library-axiom lib "RATIONAL-IMPLIES2" (list x)))
      (rebuilt (t2-arithmetic-arithmetic-modus-ponens lib axiom rat))
      (swapped (library-library-axiom
                lib "COMMUTATIVITY-OF-*"
                (list (t2-field-reciprocal (list *t2-arithmetic-denominator* x))
                      (list *t2-arithmetic-numerator* x))))
      (step (proof-proof-rewrite proof rebuilt swapped '(1 1)))
      (claim (proof-step-first step))
      (rat-term (proof-step-first rat)))
     (library-library-lemma lib "RATIONAL-RECONSTRUCTION" claim step (list (proof-neg rat-term))))))

(defun t2-power-transport-power-sum (lib)
  (let ((proof (library-library-proof lib))
        (x *library-x*)
        (y *library-y*)
        (z *library-z*))
    (proof-with-checked-results
     ((integers (library-library-ints lib (list y z)))
      (a (car integers))
      (b (cadr integers))
      (nonzero (proof-proof-assume proof (proof-eq (library-plus y z) *proof-zero*) nil))
      (left (library-library-cite lib "POWER-ADD-COMPLETE" (list x y z) (list a b)))
      (literal (proof-step-first left))
      (sum (proof-term-at literal 2))
      (selected (proof-proof-select proof sum nonzero))
      (step (proof-proof-chain proof left (list selected)))
      (claim (proof-step-first step))
      (integer-y (proof-step-first a))
      (integer-z (proof-step-first b))
      (nonzero-term (proof-step-first nonzero))
      (zero-test (proof-term-at nonzero-term 1)))
     (library-library-lemma lib "POWER-ADD-NONZERO-SUM" claim step
                            (list (proof-neg integer-y) (proof-neg integer-z) zero-test)))))

(defun t2-power-transport-numeric-completion-lemma (lib name numeric completion)
  (proof-with-checked-results
   ((step (t2-conditional-default-value lib numeric completion))
    (claim (proof-step-first step)))
   (library-library-lemma lib (concatenate 'string "COMPLETED-" name "-ON-NONNUMBER")
                          claim step nil)))

(defun t2-power-transport-numeric-completion (lib)
  (let* ((proof (library-library-proof lib))
         (x *library-x*)
         (numeric (list *library-numberp* x)))
    (proof-with-checked-results
     ((fix (proof-proof-unfold proof (t2-field-fixed x)))
      (fix-first (proof-step-first fix))
      (fix-rhs (proof-term-at fix-first 2))
      (branch (proof-proof-if-false proof fix-rhs))
      (zero (proof-proof-chain proof fix (list branch)))
      (divide (t2-field-reciprocal-zero lib x zero))
      (expt (library-library-cite lib "POWER-FIXED-ZERO" (list x *library-y*) (list zero)))
      (lib (t2-power-transport-numeric-completion-lemma lib "DIVIDE" numeric divide)))
     (t2-power-transport-numeric-completion-lemma lib "EXPT" numeric expt))))

(defun t2-power-transport-build (lib)
  (proof-with-checked-results
   ((lib (t2-power-transport-inverse-factors lib))
    (lib (t2-power-transport-power-reciprocals lib))
    (lib (t2-power-transport-rational-reconstruction lib))
    (lib (t2-power-transport-power-sum lib)))
   (t2-power-transport-numeric-completion lib)))
