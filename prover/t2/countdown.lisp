(in-package "BOYMOO-PROVER")
(set-verify-guards-eagerness 0)

(defconst *t2-countdown-lognot* (proof-cl "LOGNOT"))
(defconst *t2-countdown-cl-abs* (proof-cl "ABS"))
(defconst *t2-countdown-minusp* (proof-cl "MINUSP"))

(defun t2-countdown-absolute-count-lemma (lib)
  (if (t2-arithmetic-has-lemma lib "ABSOLUTE-COUNT-INTEGER")
      lib
    (let* ((proof (library-library-proof lib))
           (x *library-x*)
           (absolute (list *t2-countdown-cl-abs* x)))
      (proof-with-checked-results
          ((ints (library-library-ints lib (list x)))
           (ix (car ints))
           (opened (t2-arithmetic-simplify proof absolute nil
                                            (list *t2-countdown-cl-abs* *t2-countdown-minusp*)))
           (int-abs (proof-proof-unfold proof (list *t2-arithmetic-abs* x)))
           (body (t2-arithmetic-first-at int-abs 2))
           (selected (proof-proof-select proof body ix))
           (int-abs (proof-proof-chain proof int-abs (list selected)))
           (back (proof-proof-symmetric proof int-abs))
           (count (t2-arithmetic-arithmetic-integral-count lib x ix))
           (lib (cdr count))
           (proof (library-library-proof lib))
           (count-back (proof-proof-symmetric proof (car count)))
           (step (proof-proof-chain proof opened (list back count-back))))
        (library-library-lemma lib "ABSOLUTE-COUNT-INTEGER"
                               (proof-eq absolute (list *library-count* x)) step
                               (list (proof-neg (library-integer x))))))))

(defun t2-countdown-absolute-count (lib integral)
  (proof-with-checked-results
      ((lib (t2-countdown-absolute-count-lemma lib))
       (value (t2-arithmetic-first-at integral 1))
       (step (library-library-cite lib "ABSOLUTE-COUNT-INTEGER" (list value) (list integral))))
    (cons step lib)))

(defun t2-countdown-fixed-absolute-ordinal (lib measure)
  (proof-with-checked-results
      ((lib (t2-arithmetic-arithmetic-build-countdowns lib))
       (value (proof-term-at measure 1))
       (integral (t2-arithmetic-arithmetic-type-of lib value nil))
       (equation (t2-countdown-absolute-count lib integral))
       (lib (cdr equation))
       (ordinal (library-library-builtin lib 1 value))
       (step (library-library-transport-argument lib ordinal (car equation) 1)))
    (cons step lib)))

(defun t2-countdown-fixed-absolute-count-query (lib measure hypotheses replies)
  (t2-arithmetic-with-queries
      ((fixed (proof-term-at measure 1))
       (value (proof-term-at fixed 1))
       (premises (t2-arithmetic-hypothesis-query :premises nil lib hypotheses replies))
       (integers (t2-arithmetic-integer-premises (car premises)))
       (integral (t2-arithmetic-arithmetic-type-of lib value integers))
       (proof (library-library-proof lib))
       (original (t2-arithmetic-simplify proof fixed (list integral) (list *t2-arithmetic-ifix*)))
       (same (t2-arithmetic-arithmetic-reflexive lib measure))
       (opened (proof-proof-rewrite proof same original '(1 2 1)))
       (equation (t2-countdown-absolute-count lib integral))
       (next-lib (cdr equation))
       (step (proof-proof-chain (library-library-proof next-lib) opened (list (car equation)))))
    (list step next-lib (t2-arithmetic-hypotheses-after-library (cadr premises) lib next-lib))))

(defun t2-countdown-fixed-absolute-count (lib measure hypotheses)
  (t2-countdown-fixed-absolute-count-query lib measure hypotheses :plain))

(defun t2-countdown-signed-premise-fallback (lib value hypotheses negative replies)
  (t2-arithmetic-with-queries
      ((next-lib (t2-products-positive-from-nonzero lib))
       (hypotheses (t2-arithmetic-hypotheses-after-library hypotheses lib next-lib))
       (integral (t2-arithmetic-hypothesis-query :require (library-integer value)
                                                 next-lib hypotheses replies))
       (nonzero (t2-arithmetic-hypothesis-query :require (proof-neg (proof-eq value *proof-zero*))
                                                next-lib (cadr integral) (caddr integral)))
       (weak (if negative (library-le value *proof-zero*) (library-nonnegative value)))
       (bound (t2-arithmetic-hypothesis-query :require weak
                                               next-lib (cadr nonzero) (caddr nonzero)))
       (step (if negative
                 (t2-products-strict-from-weak next-lib (car bound) (car nonzero)
                                                (list (car integral)))
               (library-library-cite next-lib "POSITIVE-FROM-NONZERO" (list value)
                                     (list (car integral) (car bound) (car nonzero))))))
    (list step next-lib (cadr bound))))

(defun t2-countdown-signed-premise-query (lib value hypotheses negative replies)
  (let ((literal (if negative (library-lt value *proof-zero*) (library-positive value))))
    (t2-arithmetic-with-queries
        ((result (t2-arithmetic-hypothesis-query :find literal lib hypotheses replies)))
      (if (car result)
          (list (car result) lib (cadr result))
        (t2-countdown-signed-premise-fallback lib value (cadr result) negative (caddr result))))))

(defun t2-countdown-signed-premise (lib value hypotheses negative)
  (t2-countdown-signed-premise-query lib value hypotheses negative :plain))

(defun t2-countdown-nonpositive-count-lemma (lib)
  (if (t2-arithmetic-has-lemma lib "COUNT-NONPOSITIVE")
      lib
    (let* ((x *library-x*)
           (zero (proof-eq x *proof-zero*))
           (pos (library-positive x)))
      (proof-with-checked-results
          ((lib (t2-products-positive-from-nonzero lib))
           (proof (library-library-proof lib))
           (ints (library-library-ints lib (list x)))
           (ix (car ints))
           (bound (proof-proof-assume proof pos nil))
           (count-zero (t2-arithmetic-simplify proof (list *library-count* *proof-zero*)
                                                 nil (list *library-count* *t2-arithmetic-abs*)))
           (minus-zero (proof-proof-compute proof (library-minus *proof-zero*) 0))
           (back (proof-proof-symmetric proof minus-zero))
           (zero-truth (proof-proof-chain proof count-zero (list back)))
           (at-zero (proof-proof-assume proof zero t))
           (back (proof-proof-symmetric proof at-zero))
           (zero-case (proof-proof-rewrite-first proof zero-truth back))
           (nonzero (proof-proof-assume proof zero nil))
           (strict (t2-products-strict-from-weak lib bound nonzero (list ix)))
           (count (t2-arithmetic-count-negative lib strict (list ix)))
           (lib (cdr count))
           (step (proof-proof-cases (library-library-proof lib) zero zero-case (car count))))
        (library-library-lemma lib "COUNT-NONPOSITIVE"
                               (proof-eq (list *library-count* x) (library-minus x)) step
                               (list (proof-neg (library-integer x)) pos))))))

(defun t2-countdown-magnitude-predecessor (lib negative int-value)
  (let ((proof (library-library-proof lib))
        (integers (list int-value)))
    (proof-with-checked-results
        ((magnitude (t2-arithmetic-negative-magnitude lib negative integers))
         (value (t2-arithmetic-first-at magnitude 2))
         (integral (t2-arithmetic-arithmetic-type-of lib value integers))
         (int-term (proof-step-first integral))
         (pos-term (proof-step-first magnitude))
         (selected (proof-proof-select proof (proof-ite int-term pos-term *proof-false*) integral))
         (premise (proof-proof-transport proof magnitude selected))
         (fact (proof-proof-fact proof "integer-discrete" (list (list *library-x* value))))
         (at-least-one (t2-arithmetic-arithmetic-modus-ponens lib fact premise))
         (equation (library-library-axiom lib "<-ON-OTHERS" (list value *proof-one*)))
         (nonnegative (proof-proof-rewrite proof at-least-one equation '(1 1)))
         (decrement (library-plus *proof-neg-one* value))
         (identity (t2-arithmetic-linear-equal lib decrement (library-diff value *proof-one*) integers))
         (back (proof-proof-symmetric proof identity))
         (nonnegative (proof-proof-rewrite proof nonnegative back '(1 1 1)))
         (nonnegative (proof-proof-tidy proof nonnegative))
         (integral (t2-arithmetic-arithmetic-type-of lib decrement integers)))
      (t2-arithmetic-natural-from-sign lib integral nonnegative))))

(defun t2-countdown-lognot-count (lib child after magnitude negative int-value)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((opened (t2-arithmetic-simplify proof after (list int-value)
                                          (list *t2-countdown-lognot* *t2-arithmetic-ifix*)))
         (swap (library-library-axiom lib "COMMUTATIVITY-OF-+" (list magnitude *proof-neg-one*)))
         (opened (proof-proof-chain proof opened (list swap)))
         (same (t2-arithmetic-arithmetic-reflexive lib child))
         (step (proof-proof-rewrite proof same opened '(1 2 1)))
         (natural (t2-countdown-magnitude-predecessor lib negative int-value))
         (count (t2-arithmetic-count-natural lib natural))
         (lib (cdr count))
         (step (proof-proof-chain (library-library-proof lib) step (list (car count)))))
      (cons step lib))))

(defun t2-countdown-successor-count (lib value after negative integers)
  (proof-with-checked-results
      ((lib (t2-arithmetic-arithmetic-build-countdowns lib))
       (lib (t2-countdown-nonpositive-count-lemma lib))
       (proof (library-library-proof lib))
       (successor (library-plus *proof-one* value))
       (bound (t2-products-discrete-step lib negative integers))
       (swap (library-library-axiom lib "COMMUTATIVITY-OF-+" (list *proof-one* value)))
       (bound (cond ((equal after successor) bound)
                    ((equal after (library-plus value *proof-one*))
                     (proof-proof-rewrite proof bound swap '(1 1 2)))
                    (t '(:failure "RecipeMismatch" ""))))
       (integral (t2-arithmetic-arithmetic-type-of lib after integers))
       (count (library-library-cite lib "COUNT-NONPOSITIVE" (list after) (list integral bound)))
       (count (if (equal after successor)
                  (proof-proof-rewrite proof count swap '(1 2 1))
                count))
       (negated (library-library-cite lib "NEGATE-SUCCESSOR" (list value) nil))
       (count (proof-proof-chain proof count (list negated))))
    (cons count lib)))

(defun t2-countdown-negative-countdown-step (lib child parent value after negative int-value)
  (let* ((integers (list int-value))
         (magnitude (library-minus value))
         (predecessor (library-plus *proof-neg-one* magnitude))
         (complement (equal after (list *t2-countdown-lognot* value))))
    (proof-with-checked-results
        ((positive (t2-arithmetic-arithmetic-prove lib (library-positive *proof-one*) nil nil))
         (strict (t2-arithmetic-less-from-difference lib predecessor magnitude positive integers))
         (child-count (if complement
                          (t2-countdown-lognot-count lib child after magnitude negative int-value)
                        (t2-countdown-successor-count lib value after negative integers)))
         (parent-count (t2-arithmetic-count-negative (cdr child-count) negative integers))
         (lib (cdr parent-count))
         (step (if complement
                   (t2-arithmetic-count-comparison lib strict (car child-count)
                                                   (car parent-count) integers)
                 (proof-with-checked-results
                     ((strict (library-library-transport-argument lib strict (car child-count) 1))
                      (strict (library-library-transport-argument lib strict (car parent-count) 2))
                      (comparison (t2-arithmetic-arithmetic-ordinal-comparison lib child parent nil)))
                   (proof-proof-transport (library-library-proof lib) strict comparison)))))
      (cons step lib))))

(defun t2-countdown-negative-countdown-query (lib goal hypotheses replies)
  (t2-arithmetic-with-queries
      ((parts (proof-list-of-length goal 3))
       (child (cadr parts))
       (parent (caddr parts))
       (value (proof-term-at parent 1))
       (after (proof-term-at child 1))
       (integral (t2-arithmetic-hypothesis-query :require (library-integer value)
                                                  lib hypotheses replies))
       (negative (t2-countdown-signed-premise-query lib value (cadr integral) t (caddr integral)))
       (step (t2-countdown-negative-countdown-step (cadr negative) child parent value after
                                                  (car negative) (car integral))))
    (list (car step) (cdr step)
          (t2-arithmetic-hypotheses-after-library (caddr negative) (cadr negative) (cdr step)))))

(defun t2-countdown-negative-countdown (lib goal hypotheses)
  (t2-countdown-negative-countdown-query lib goal hypotheses :plain))
