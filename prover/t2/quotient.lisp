(in-package "BOYMOO-PROVER")

(set-verify-guards-eagerness 0)

(defconst *t2-quotient-quotient* (proof-sym "NONNEGATIVE-INTEGER-QUOTIENT" "ACL2"))
(defconst *t2-quotient-quotient-fact* (proof-sym "SELF-NONNEGATIVE-QUOTIENT-BOUND" "ACL2"))

(defun t2-quotient-quotient-domain (i j)
  (proof-ite (library-integer i)
             (proof-ite (library-nonnegative i)
                        (proof-ite (library-integer j) (library-positive j) *proof-false*)
                        *proof-false*)
             *proof-false*))

(defun t2-quotient-quotient-properties (i j)
  (let ((value (list *t2-quotient-quotient* i j)))
    (proof-ite (list *library-natp* value) (library-le (t2-products-times j value) i)
               *proof-false*)))

(defun t2-quotient-quotient-equation (lib i j ij pos-j)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
     ((eqn (proof-proof-unfold proof (list *t2-quotient-quotient* i j)))
      (int-j (t2-arithmetic-arithmetic-type-of lib j ij))
      (bound (library-library-cite lib "POSITIVE-NONNEGATIVE" (list j) (list int-j pos-j)))
      (nat-j (library-library-cite lib "NATURAL-FROM-BOUNDS" (list j) (list int-j bound)))
      (known (t2-arithmetic-arithmetic-known-nfix lib (list *t2-arithmetic-nfix* j) nat-j))
      (eqn (proof-proof-rewrite-first proof eqn known))
      (fixed (t2-arithmetic-simplify proof (list *t2-arithmetic-ifix* i) ij
                                    (list *t2-arithmetic-ifix*)))
      (eqn (proof-proof-rewrite-first proof eqn fixed))
      (distinct (t2-products-strict-neq lib pos-j ij))
      (distinct (t2-products-flip-neq lib distinct))
      (numeric-equal (proof-cl "="))
      (neg-equal (t2-arithmetic-arithmetic-prove lib (proof-neg (list numeric-equal j *proof-zero*))
                                                (list distinct) (list numeric-equal)))
      (first (proof-step-first eqn))
      (rhs (proof-term-at first 2))
      (simplified (t2-arithmetic-simplify proof rhs (list neg-equal) nil)))
     (proof-proof-chain proof eqn (list simplified)))))

(defun t2-quotient-bound-base (lib equation rhs nonneg-x properties)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
     ((when-true (proof-proof-if-true proof rhs))
      (at-zero (proof-proof-chain proof equation (list when-true)))
      (nil-product (t2-products-product-zero lib *library-y*))
      (lib (cdr nil-product))
      (proof (library-library-proof lib))
      (zero-natural (t2-arithmetic-arithmetic-natural lib *proof-zero*))
      (natural (library-library-transport-argument lib zero-natural at-zero 1))
      (product (proof-proof-symmetric proof (car nil-product)))
      (bound (proof-proof-rewrite proof nonneg-x product '(1 1 2)))
      (zero (proof-proof-symmetric proof at-zero))
      (bound (proof-proof-rewrite proof bound zero '(1 1 2 2)))
      (base (t2-arithmetic-arithmetic-prove lib properties (list natural bound) nil)))
     (cons base lib))))

(defun t2-quotient-bound-step (lib equation rhs test formula properties integers pos-y)
  (let ((proof (library-library-proof lib))
        (int-x (car integers))
        (int-y (cadr integers)))
    (proof-with-checked-results
     ((enough (proof-proof-assume proof test nil))
      (after (library-diff *library-x* *library-y*))
      (nonneg-after (t2-subtraction-nonnegative-difference lib enough))
      (after-int (t2-arithmetic-arithmetic-type-of lib after integers))
      (descending (t2-subtraction-count-subtraction lib int-x int-y pos-y enough))
      (lib (cdr descending))
      (proof (library-library-proof lib))
      (substitution (list (list *library-x* after)))
      (descent (car descending))
      (descent-literal (proof-step-first descent))
      (smaller-formula (proof-subst formula (list (cons *library-x* after))))
      (hypothesis (proof-ite descent-literal smaller-formula *proof-true*))
      (assumed (proof-proof-assume proof hypothesis t))
      (smaller (proof-proof-prove-if proof assumed descent))
      (smaller-domain (t2-arithmetic-arithmetic-prove lib (t2-quotient-quotient-domain after *library-y*)
                                                     (list after-int nonneg-after int-y pos-y) nil))
      (consequence (t2-arithmetic-arithmetic-modus-ponens lib smaller smaller-domain))
      (parts (t2-arithmetic-arithmetic-conjunct lib consequence))
      (nat (car parts))
      (bound (cadr parts))
      (child-value (list *t2-quotient-quotient* after *library-y*))
      (child-int (library-library-cite lib "NATURAL-INTEGER" (list child-value) (list nat)))
      (shifted (t2-arithmetic-arithmetic-weak-shift lib bound *library-y* (append integers (list child-int))))
      (advance (library-library-axiom lib "DISTRIBUTIVITY" (list *library-y* *proof-one* child-value)))
      (divisor-number (t2-arithmetic-number lib *library-y* integers))
      (unit (t2-products-product-one lib *library-y* divisor-number))
      (advance (proof-proof-rewrite proof advance unit '(1 2 1)))
      (upper (t2-arithmetic-linear-equal lib (library-plus *library-y* after) *library-x* integers))
      (shifted (proof-proof-rewrite proof shifted upper '(1 1 1)))
      (advance (proof-proof-symmetric proof advance))
      (shifted (proof-proof-rewrite proof shifted advance '(1 1 2)))
      (when-false (proof-proof-if-false proof rhs))
      (step-eq (proof-proof-chain proof equation (list when-false)))
      (reverse (proof-proof-symmetric proof step-eq))
      (bound (proof-proof-rewrite proof shifted reverse '(1 1 2 2)))
      (bound (proof-proof-tidy proof bound))
      (successor (library-plus *proof-one* child-value))
      (one-natural (t2-arithmetic-arithmetic-natural lib *proof-one*))
      (natural (library-library-cite lib "NATURAL-SUM" (list *proof-one* child-value)
                                    (list one-natural nat)))
      (natural (library-library-transport-argument lib natural step-eq 1))
      (step-eq-first (proof-step-first step-eq))
      (result (proof-term-at step-eq-first 2)))
     (if (not (equal result successor))
         '(:failure "recipe-mismatch" "")
       (proof-with-checked-results
        ((step (t2-arithmetic-arithmetic-prove lib properties (list natural bound) nil)))
        (cons (list step substitution) lib))))))

(defun t2-quotient-prove-quotient-bound (lib)
  (if (assoc-equal *t2-quotient-quotient-fact* (proof-proof-facts (library-library-proof lib)))
      lib
    (proof-with-checked-results
     ((lib (t2-arithmetic-arithmetic-build-countdowns lib))
      (lib (t2-arithmetic-arithmetic-build-weak-order lib))
      (lib (t2-products-build-product-order lib))
      (proof (library-library-proof lib))
      (domain (t2-quotient-quotient-domain *library-x* *library-y*))
      (properties (t2-quotient-quotient-properties *library-x* *library-y*))
      (formula (list *library-implies* domain properties))
      (assumed (proof-proof-assume proof domain t))
      (parts (t2-arithmetic-arithmetic-conjunct lib assumed))
      (int-x (car parts))
      (parts (t2-arithmetic-arithmetic-conjunct lib (cadr parts)))
      (nonneg-x (car parts))
      (parts (t2-arithmetic-arithmetic-conjunct lib (cadr parts)))
      (int-y (car parts))
      (pos-y (cadr parts))
      (integers (list int-x int-y))
      (equation (t2-quotient-quotient-equation lib *library-x* *library-y* integers pos-y))
      (equation-first (proof-step-first equation))
      (rhs (proof-term-at equation-first 2))
      (test (library-lt *library-x* *library-y*))
      (rhs-test (proof-term-at rhs 1)))
     (if (not (equal rhs-test test))
         '(:failure "recipe-mismatch" "")
       (proof-with-checked-results
        ((base (t2-quotient-bound-base lib equation rhs nonneg-x properties))
         (step (t2-quotient-bound-step (cdr base) equation rhs test formula properties integers pos-y))
         (lib (cdr step))
         (proof (library-library-proof lib))
         (consequence (proof-proof-cases proof test (car base) (caar step)))
         (assumed (proof-proof-assume proof domain t))
         (good (t2-arithmetic-arithmetic-prove lib formula (list assumed consequence) (list *library-implies*)))
         (denied (proof-proof-assume proof domain nil))
         (bad (t2-arithmetic-arithmetic-prove lib formula (list denied) (list *library-implies*)))
         (ordinal (library-library-builtin lib 1 *library-x*))
         (cases (proof-proof-cases proof domain good bad))
         (induction (proof-proof-induct proof ordinal cases formula (list *library-count* *library-x*)
                                       (list (cadar step)))))
        (library-library-lemma lib "NONNEGATIVE-QUOTIENT-BOUND" formula induction nil))))))

(defun t2-quotient-quotient-bound (lib i j integers nonnegative-i positive-j)
  (proof-with-checked-results
   ((lib (t2-quotient-prove-quotient-bound lib))
    (proof (library-library-proof lib))
    (int-i (t2-arithmetic-arithmetic-type-of lib i integers))
    (int-j (t2-arithmetic-arithmetic-type-of lib j integers))
    (premise (t2-arithmetic-arithmetic-prove lib (t2-quotient-quotient-domain i j)
                                             (list int-i nonnegative-i int-j positive-j) nil))
    (fact (proof-proof-fact proof *t2-quotient-quotient-fact* (list (list *library-x* i) (list *library-y* j))))
    (step (t2-arithmetic-arithmetic-modus-ponens lib fact premise))
    (result (t2-arithmetic-arithmetic-conjunct lib step)))
   (cons result lib)))

; The certificate names these formulas so repeated case tests and
; induction hypotheses can use short terms.
(defconst *t2-quotient-additive-domain* (library-lemma-name "QUOTIENT-ADDITIVE-DOMAIN"))
(defconst *t2-quotient-additive-claim* (library-lemma-name "QUOTIENT-ADDITIVE-CLAIM"))

(defun t2-quotient-prove-additive-domain (lib value divisor evidence)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((opened (proof-proof-unfold proof (list *t2-quotient-additive-domain* value divisor)))
         (body (proof-rewritten-term opened))
         (step (t2-arithmetic-arithmetic-prove lib body evidence nil)))
      (proof-proof-transport proof step opened))))

(defun t2-quotient-additive-properties (value quotient)
  (proof-ite (list *library-natp* quotient)
             (proof-ite (library-le quotient value)
                        (proof-ite (library-positive value) (library-lt quotient value) *proof-true*)
                        *proof-false*)
             *proof-false*))

(defun t2-quotient-additive-result (lib properties natural weak strict)
  (let ((proof (library-library-proof lib))
        (guarded (caddr (caddr properties))))
    (proof-with-checked-results
        ((yes (proof-proof-if-true proof guarded))
         (yes (proof-proof-transport proof strict yes))
         (no (proof-proof-if-false proof guarded))
         (truth (t2-arithmetic-arithmetic-prove lib *proof-true* nil nil))
         (no (proof-proof-transport proof truth no))
         (bound (proof-proof-cases proof (cadr guarded) yes no)))
      (t2-arithmetic-arithmetic-prove lib properties (list natural weak bound) nil))))

(defun t2-quotient-additive-base (lib equation body properties natural-value)
  (let ((proof (library-library-proof lib))
        (value *library-x*))
    (proof-with-checked-results
        ((when-small (proof-proof-if-true proof body))
         (at-zero (proof-proof-chain proof equation (list when-small)))
         (natural (t2-arithmetic-arithmetic-natural lib *proof-zero*))
         (natural (library-library-transport-argument lib natural at-zero 1))
         (weak (library-library-cite lib "NATURAL-NONNEGATIVE" (list value) (list natural-value)))
         (back (proof-proof-symmetric proof at-zero))
         (weak (proof-proof-rewrite proof weak back '(1 1 2)))
         (strict (proof-proof-assume proof (library-positive value) t))
         (strict (proof-proof-rewrite proof strict back '(1 1))))
      (t2-quotient-additive-result lib properties natural weak strict))))

(defun t2-quotient-additive-upper-step (lib smaller child-weak wide-divisor integers)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((shifted (t2-arithmetic-arithmetic-weak-shift lib child-weak *proof-one* integers))
         (comparison (t2-arithmetic-comparison lib *proof-one* *library-y* integers))
         (gap (proof-proof-rewrite proof wide-divisor comparison '(1)))
         (upper (t2-arithmetic-less-from-difference
                 lib (library-plus *proof-one* smaller) *library-x* gap integers)))
      (t2-arithmetic-arithmetic-compare-chain lib shifted upper integers))))

(defun t2-quotient-additive-step (lib equation body formula properties natural-value
                                     integers wide-divisor positive-divisor)
  (let* ((proof (library-library-proof lib))
         (smaller (library-diff *library-x* *library-y*))
         (child (list *t2-quotient-quotient* smaller *library-y*))
         (test (cadr body))
         (substitution (list (list *library-x* smaller))))
    (proof-with-checked-results
        ((enough (proof-proof-assume proof test nil))
         (nonnegative (t2-subtraction-nonnegative-difference lib enough))
         (smaller-int (t2-arithmetic-arithmetic-type-of lib smaller integers))
         (smaller-nat (t2-arithmetic-natural-from-sign lib smaller-int nonnegative))
         (decrease (t2-arithmetic-less-from-difference lib smaller *library-x* positive-divisor integers))
         (child-count (t2-arithmetic-count-natural lib smaller-nat))
         (parent-count (t2-arithmetic-count-natural (cdr child-count) natural-value))
         (lib (cdr parent-count))
         (ord-decrease (t2-arithmetic-count-comparison lib decrease (car child-count)
                                                        (car parent-count) integers))
         (instance (proof-subst formula (list (cons *library-x* smaller))))
         (hypothesis (proof-ite (proof-step-first ord-decrease) instance *proof-true*))
         (assumed (proof-proof-assume proof hypothesis t))
         (claim (proof-proof-prove-if proof assumed ord-decrease))
         (opened (proof-proof-unfold proof instance))
         (claim (proof-proof-rewrite proof claim opened '(1)))
         (domain (t2-quotient-prove-additive-domain
                  lib smaller *library-y* (list smaller-nat (cadr integers) wide-divisor)))
         (consequence (proof-proof-prove-if proof claim domain))
         (parts (t2-arithmetic-arithmetic-conjunct lib consequence))
         (child-nat (car parts))
         (bounds (t2-arithmetic-arithmetic-conjunct lib (cadr parts)))
         (child-int (library-library-cite lib "NATURAL-INTEGER" (list child) (list child-nat)))
         (strict (t2-quotient-additive-upper-step lib smaller (car bounds) wide-divisor
                                                 (cons child-int integers)))
         (advanced (proof-proof-if-false proof body))
         (advanced (proof-proof-chain proof equation (list advanced)))
         (strict (library-library-transport-argument lib strict advanced 1))
         (one-nat (t2-arithmetic-arithmetic-natural lib *proof-one*))
         (natural (library-library-cite lib "NATURAL-SUM" (list *proof-one* child)
                                        (list one-nat child-nat)))
         (natural (library-library-transport-argument lib natural advanced 1))
         (quotient (list *t2-quotient-quotient* *library-x* *library-y*))
         (quotient-int (library-library-cite lib "NATURAL-INTEGER" (list quotient) (list natural)))
         (weak (t2-arithmetic-arithmetic-as-weak lib strict (cons quotient-int integers)))
         (step (t2-quotient-additive-result lib properties natural weak strict)))
      (cons (list step substitution) lib))))

(defun t2-quotient-prove-additive-bound (lib)
  (if (t2-arithmetic-has-lemma lib "QUOTIENT-ADDITIVE-BOUND")
      lib
    (let* ((x *library-x*)
           (y *library-y*)
           (formals (list x y))
           (quotient (list *t2-quotient-quotient* x y))
           (domain (cons *t2-quotient-additive-domain* formals))
           (domain-body (proof-ite (list *library-natp* x)
                                   (proof-ite (library-integer y) (library-lt *proof-one* y) *proof-false*)
                                   *proof-false*))
           (properties (t2-quotient-additive-properties x quotient))
           (formula (cons *t2-quotient-additive-claim* formals))
           (formula-body (proof-ite domain properties *proof-true*)))
      (proof-with-checked-results
          ((lib (library-library-definition lib *t2-quotient-additive-domain* formals domain-body))
           (lib (library-library-definition lib *t2-quotient-additive-claim* formals formula-body))
           (lib (t2-arithmetic-arithmetic-build-countdowns lib))
           (lib (t2-arithmetic-arithmetic-build-weak-order lib))
           (proof (library-library-proof lib))
           (assumed (proof-proof-assume proof domain t))
           (opened-domain (proof-proof-unfold proof domain))
           (conditions (proof-proof-rewrite proof assumed opened-domain '(1)))
           (parts (t2-arithmetic-arithmetic-conjunct lib conditions))
           (natural (car parts))
           (parts (t2-arithmetic-arithmetic-conjunct lib (cadr parts)))
           (int-x (library-library-cite lib "NATURAL-INTEGER" (list x) (list natural)))
           (integers (list int-x (car parts)))
           (wide-divisor (cadr parts))
           (pos-one (t2-arithmetic-arithmetic-prove lib (library-positive *proof-one*) nil nil))
           (pos-divisor (t2-arithmetic-arithmetic-compare-chain lib pos-one wide-divisor integers))
           (equation (t2-quotient-quotient-equation lib x y integers pos-divisor))
           (body (proof-rewritten-term equation)))
        (if (not (equal body (proof-ite (library-lt x y) *proof-zero*
                                        (library-plus *proof-one*
                                                      (list *t2-quotient-quotient* (library-diff x y) y)))))
            '(:failure "recipe-mismatch" "")
          (proof-with-checked-results
              ((base (t2-quotient-additive-base lib equation body properties natural))
               (step (t2-quotient-additive-step lib equation body formula properties natural
                                                integers wide-divisor pos-divisor))
               (lib (cdr step))
               (proof (library-library-proof lib))
               (consequence (proof-proof-cases proof (cadr body) base (caar step)))
               (good (t2-arithmetic-arithmetic-prove lib formula-body (list assumed consequence) nil))
               (denied (proof-proof-assume proof domain nil))
               (bad (t2-arithmetic-arithmetic-prove lib formula-body (list denied) nil))
               (cases (proof-proof-cases proof domain good bad))
               (opened-formula (proof-proof-unfold proof formula))
               (cases (proof-proof-transport proof cases opened-formula))
               (ordinal (library-library-builtin lib 1 x))
               (induction (proof-proof-induct proof ordinal cases formula (list *library-count* x)
                                              (list (cadar step)))))
            (library-library-lemma lib "QUOTIENT-ADDITIVE-BOUND" formula induction nil)))))))

(defun t2-quotient-build-quotient-descent (lib)
  (if (t2-arithmetic-has-lemma lib "COUNT-QUOTIENT-DECREASE")
      lib
    (let* ((x *library-x*)
           (y *library-y*)
           (ix (library-integer x))
           (iy (library-integer y))
           (positive (library-positive x))
           (wide (library-lt *proof-one* y))
           (quotient (list *t2-quotient-quotient* x y)))
      (proof-with-checked-results
          ((lib (t2-quotient-prove-additive-bound lib))
           (proof (library-library-proof lib))
           (int-x (proof-proof-assume proof ix t))
           (int-y (proof-proof-assume proof iy t))
           (pos-x (proof-proof-assume proof positive t))
           (wide-y (proof-proof-assume proof wide t))
           (nat-x (t2-arithmetic-natural-from-positive lib int-x pos-x))
           (domain (t2-quotient-prove-additive-domain lib x y (list nat-x int-y wide-y)))
           (claim (library-library-cite lib "QUOTIENT-ADDITIVE-BOUND" nil nil))
           (opened (proof-proof-unfold proof (list *t2-quotient-additive-claim* x y)))
           (claim (proof-proof-rewrite proof claim opened '(1)))
           (properties (proof-proof-prove-if proof claim domain))
           (parts (t2-arithmetic-arithmetic-conjunct lib properties))
           (nat-q (car parts))
           (parts (t2-arithmetic-arithmetic-conjunct lib (cadr parts)))
           (strict (proof-proof-prove-if proof (cadr parts) pos-x))
           (int-q (library-library-cite lib "NATURAL-INTEGER" (list quotient) (list nat-q)))
           (q-count (t2-arithmetic-count-natural lib nat-q))
           (x-count (t2-arithmetic-count-natural (cdr q-count) nat-x))
           (lib (cdr x-count))
           (step (t2-arithmetic-count-comparison lib strict (car q-count) (car x-count)
                                                (list int-q int-x)))
           (literal (proof-step-first step)))
        (library-library-lemma lib "COUNT-QUOTIENT-DECREASE" literal step
                               (library-guards (list ix iy positive wide)))))))
