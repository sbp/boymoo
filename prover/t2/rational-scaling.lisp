(defun t2-rational-scaling-reduce-product-comparison (lib equation factor value right-slot)
  (let ((zero-index (- 3 right-slot)))
    (proof-with-checked-results
     ((zero-result (t2-products-product-zero lib factor))
      (lib (cdr zero-result))
      (proof (library-library-proof lib))
      (equation (proof-proof-rewrite proof equation (car zero-result) (list 1 1 zero-index)))
      (equation
       (if (equal factor value)
           equation
         (proof-with-checked-results
          ((commute (library-library-axiom lib "COMMUTATIVITY-OF-*" (list factor value))))
          (proof-proof-rewrite proof equation commute (list 1 1 right-slot))))))
     (cons equation lib))))

(defun t2-rational-scaling-sign-name (positive)
  (if positive "POS" "NEG"))

(defun t2-rational-scaling-sign-inferences-factor (lib rat y-evidence sign-y strict)
  (if strict
      y-evidence
    (let ((proof (library-library-proof lib))
          (y *library-y*))
      (proof-with-checked-results
       ((rat-zero (t2-arithmetic-rational lib *proof-zero* nil))
        (relation (t2-order-trichotomy lib (if sign-y y *proof-zero*) (if sign-y *proof-zero* y)
                                      (list rat rat-zero)))
        (different (proof-proof-assume proof (proof-eq y *proof-zero*) nil))
        (different (if sign-y different (t2-products-flip-neq lib different))))
       (proof-proof-discharge proof relation different)))))

(defun t2-rational-scaling-sign-inferences-weak (lib x-evidence equation slot)
  (let* ((proof (library-library-proof lib))
         (x *library-x*)
         (y *library-y*)
         (test (proof-eq y *proof-zero*)))
    (proof-with-checked-results
     ((step (library-library-transport-argument lib x-evidence equation 1))
      (zero (proof-proof-assume proof test t))
      (product-zero (t2-field-zero-product-from-left lib y x zero))
      (lib (cdr product-zero))
      (proof (library-library-proof lib))
      (commute (library-library-axiom lib "COMMUTATIVITY-OF-*" (list x y)))
      (product-zero (proof-proof-chain proof commute (list (car product-zero))))
      (irreflexive (library-library-axiom lib "ZERO" nil))
      (product-zero (proof-proof-symmetric proof product-zero))
      (zero-case (proof-proof-rewrite proof irreflexive product-zero (list 1 1 slot)))
      (step (proof-proof-cases proof test zero-case step)))
     (cons step lib))))

(defun t2-rational-scaling-sign-inferences-case (lib rat sign-x sign-y strict)
  (let* ((proof (library-library-proof lib))
         (x *library-x*)
         (y *library-y*)
         (same-sign (eq sign-x sign-y))
         (zero-left (eq same-sign strict))
         (a (if zero-left *proof-zero* x))
         (b (if zero-left x *proof-zero*))
         (slot (if zero-left 2 1))
         (x-bound (if (eq sign-x strict) (library-positive x) (library-lt x *proof-zero*)))
         (y-bound (if (eq sign-y strict) (library-positive y) (library-lt y *proof-zero*))))
    (proof-with-checked-results
     ((x-evidence (proof-proof-assume proof x-bound strict))
      (y-evidence (proof-proof-assume proof y-bound strict))
      (factor (t2-rational-scaling-sign-inferences-factor lib rat y-evidence sign-y strict))
      (equation (library-library-cite
                 lib (if sign-y "RATIONAL-POSITIVE-ORDER" "RATIONAL-NEGATIVE-ORDER")
                 (list a b y) (list rat factor)))
      (result (t2-rational-scaling-reduce-product-comparison lib equation y x slot))
      (equation (car result))
      (lib (cdr result))
      (proof (library-library-proof lib))
      (result (if strict
                  (proof-with-checked-results
                   ((step (proof-proof-transport proof x-evidence equation)))
                   (cons step lib))
                (t2-rational-scaling-sign-inferences-weak lib x-evidence equation slot)))
      (step (car result))
      (lib (cdr result))
      (label (concatenate 'string "RATIONAL-SCALE-SIGN-"
                          (t2-rational-scaling-sign-name sign-x) "-"
                          (t2-rational-scaling-sign-name sign-y) "-"
                          (if strict "STRICT" "WEAK")))
      (side (if strict (library-guards (list x-bound y-bound)) (list x-bound y-bound)))
      (claim (proof-step-first step))
      (ratio-term (proof-step-first rat)))
     (library-library-lemma lib label claim step (cons (proof-neg ratio-term) side)))))

(defun t2-rational-scaling-sign-inferences-cases (lib rat cases)
  (declare (xargs :measure (acl2-count cases)))
  (if (or (failure-p lib) (endp cases))
      lib
    (let ((signs (car cases)))
      (t2-rational-scaling-sign-inferences-cases
       (t2-rational-scaling-sign-inferences-case lib rat (car signs) (cadr signs) (caddr signs))
       rat (cdr cases)))))

(defun t2-rational-scaling-sign-inferences (lib)
  (proof-with-checked-results
   ((rat (proof-proof-assume (library-library-proof lib)
                             (list *library-rationalp* *library-y*) t)))
   (t2-rational-scaling-sign-inferences-cases
    lib rat '((t t t) (t t nil) (t nil t) (t nil nil)
              (nil t t) (nil t nil) (nil nil t) (nil nil nil)))))

