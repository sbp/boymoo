(defun t2-rational-scaling-negative-product-y-branch
    (lib comparison expected nonzero ratio x-sign x-strict x-pos y-pos)
  (let* ((proof (library-library-proof lib))
         (y *library-y*)
         (z *library-z*)
         (y-positive (library-positive z))
         (y-negative (library-lt z *proof-zero*)))
    (proof-with-checked-results
     ((y-sign (proof-proof-assume proof y-positive y-pos))
      (y-strict
       (if y-pos
           y-sign
         (proof-with-checked-results
          ((numeric (t2-order-number-from-rational lib ratio)))
          (t2-rational-scaling-negative-number lib numeric y-sign (cadr nonzero)))))
      (label (concatenate 'string "RATIONAL-SCALE-SIGN-"
                          (t2-rational-scaling-sign-name x-pos) "-"
                          (t2-rational-scaling-sign-name y-pos) "-STRICT"))
      (scaled (library-library-cite lib label (list y z) (list ratio x-strict y-strict)))
      (comparison-sign (if (eq x-pos y-pos) (t2-order-opposite-order lib scaled) scaled))
      (comparison-value (t2-rational-scaling-truth-value lib comparison comparison-sign))
      (lib (cdr comparison-value))
      (proof (library-library-proof lib))
      (rhs (t2-arithmetic-simplify proof expected (append nonzero (list x-sign x-strict))
