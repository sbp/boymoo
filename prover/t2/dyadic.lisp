(in-package "BOYMOO-PROVER")
(set-verify-guards-eagerness 0)

(defconst *t2-dyadic-two* (proof-quote 2))

(defun t2-dyadic-twice (value)
  (t2-products-times *t2-dyadic-two* value))

(defun t2-dyadic-half (value)
  (t2-products-times *t2-exponent-parity-half* value))

(defun t2-dyadic-low-gap (value)
  (library-diff (t2-ratios-denominator value) (t2-ratios-numerator value)))

(defun t2-dyadic-high-gap (value)
  (library-diff (t2-ratios-numerator value) (t2-ratios-denominator value)))

(defun t2-dyadic-measure (value)
  (list *library-count*
        (proof-ite (library-lt value *proof-one*) (t2-dyadic-low-gap value)
                   (proof-ite (library-lt value *t2-dyadic-two*) *proof-zero*
                              (t2-dyadic-high-gap value)))))

(defun t2-dyadic-cancel-scales (lib value is-rational first second)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((assoc (library-library-axiom lib "ASSOCIATIVITY-OF-*" (list first second value)))
         (equation (proof-proof-symmetric proof assoc))
         (scale (t2-book-logic-constant lib (t2-products-times first second)))
         (equation (proof-proof-rewrite proof equation scale '(1 2 1)))
         (unity (library-library-axiom lib "UNICITY-OF-1" (list value)))
         (number (t2-order-number-from-rational lib is-rational))
         (fix (t2-field-numeric-fix lib value number)))
      (proof-proof-chain proof equation (list unity fix)))))

(defun t2-dyadic-pos-product (lib scale is-rational is-positive)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((literal (proof-step-first is-rational))
         (value (proof-term-at literal 1))
         (ratio (t2-order-rational lib scale nil))
         (scale-sign (t2-book-logic-constant lib (library-positive scale)))
         (positive (proof-proof-true-from-eq proof scale-sign)))
      (library-library-cite lib "POSITIVE-PRODUCT" (list scale value)
                            (list ratio is-rational positive is-positive)))))

(defun t2-dyadic-positive-numerator (lib rat positive-value pos-d int-d)
  (proof-with-checked-results
      ((ratio-literal (proof-step-first rat))
       (x (proof-term-at ratio-literal 1))
       (den-literal (proof-step-first int-d))
       (d (proof-term-at den-literal 1))
       (ratio-d (t2-arithmetic-rational lib d (list int-d)))
       (ratio-zero (t2-arithmetic-rational lib *proof-zero* nil))
       (scaled (t2-order-increasing-product lib positive-value pos-d (list rat ratio-d ratio-zero)))
       (zero (t2-products-product-zero lib d))
       (lib (cdr zero))
       (proof (library-library-proof lib))
       (scaled (proof-proof-rewrite proof scaled (car zero) '(1 1)))
       (commute (library-library-axiom lib "COMMUTATIVITY-OF-*" (list d x)))
       (multiply (library-library-cite lib "FIELD-MULTIPLY-DENOMINATOR" (list x) (list rat)))
       (normalized (proof-proof-chain proof commute (list multiply)))
       (result (proof-proof-rewrite proof scaled normalized '(1 2))))
    (cons result lib)))

(defun t2-dyadic-reduced-parts-move-endpoint (lib upper-num index pos-num)
  (proof-with-checked-results
      ((sign (t2-order-opposite-order lib pos-num))
       (absolute (t2-ratios-absolute lib sign)))
    (proof-proof-rewrite (library-library-proof lib) upper-num absolute (list 1 1 index))))

(defun t2-dyadic-reduced-parts-move (lib rat positive-value)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((literal (proof-step-first rat))
         (u (proof-term-at literal 1))
         (v (t2-dyadic-twice u))
         (large-ratio (t2-order-rational lib v (list rat)))
         (large-positive (t2-dyadic-pos-product lib *t2-dyadic-two* rat positive-value))
         (parts-u (t2-arithmetic-rational-parts lib rat))
         (nu (car parts-u))
         (du (cadr parts-u))
         (positive-du (caddr parts-u))
         (parts-v (t2-arithmetic-rational-parts lib large-ratio))
         (nv (car parts-v))
         (dv (cadr parts-v))
         (positive-dv (caddr parts-v))
         (integer-parts (list nu du nv dv))
         (den-literal (proof-step-first du))
         (d (cadr den-literal))
         (num-literal (proof-step-first nu))
         (n (cadr num-literal))
         (equation (library-library-axiom lib "ASSOCIATIVITY-OF-*" (list *t2-dyadic-two* u d)))
         (multiply (library-library-cite lib "FIELD-MULTIPLY-DENOMINATOR" (list u) (list rat)))
         (equation (proof-proof-rewrite proof equation multiply '(1 2 2)))
         (multiplied (t2-arithmetic-arithmetic-type-of lib (t2-dyadic-twice n) (list nu)))
         (multiplied (library-library-transport-argument lib multiplied equation 1))
         (lower-den (library-library-cite lib "DENOMINATOR-BOUND" (list v d)
                                         (list large-ratio du positive-du multiplied)))
         (int-two (t2-arithmetic-arithmetic-type-of lib *t2-dyadic-two* nil))
         (positive-two (t2-arithmetic-arithmetic-prove lib (library-positive *t2-dyadic-two*) nil nil))
         (upper-num (library-library-cite lib "NUMERATOR-DIVIDED-BOUND" (list *t2-dyadic-two* v)
                                         (list int-two positive-two large-ratio)))
         (reciprocal (t2-book-logic-constant lib (t2-field-reciprocal *t2-dyadic-two*)))
         (upper-num (proof-proof-rewrite proof upper-num reciprocal '(1 1 2 1 1 1)))
         (recover (t2-dyadic-cancel-scales lib u rat *t2-exponent-parity-half* *t2-dyadic-two*))
         (upper-num (proof-proof-rewrite proof upper-num recover '(1 1 2 1 1)))
         (positive-nv (t2-dyadic-positive-numerator lib large-ratio large-positive positive-dv dv))
         (positive-nu (t2-dyadic-positive-numerator (cdr positive-nv) rat positive-value positive-du du))
         (lib (cdr positive-nu))
         (upper-num (t2-dyadic-reduced-parts-move-endpoint lib upper-num 1 (car positive-nv)))
         (upper-num (t2-dyadic-reduced-parts-move-endpoint lib upper-num 2 (car positive-nu))))
      (cons (list lower-den upper-num integer-parts large-ratio) lib))))

(defun t2-dyadic-strict-gap-order (lib)
  (let ((proof (library-library-proof lib))
        (x *library-x*)
        (two *t2-dyadic-two*))
    (proof-with-checked-results
        ((rat (proof-proof-assume proof (list *library-rationalp* x) t))
         (above (proof-proof-assume proof (library-positive x) t))
         (v (t2-dyadic-twice x))
         (moved (t2-dyadic-reduced-parts-move lib rat above))
         (lib (cdr moved))
         (proof (library-library-proof lib))
         (parts (car moved))
         (lower-den (car parts))
         (upper-num (cadr parts))
         (integers (caddr parts))
         (ratio-v (cadddr parts))
         (original-num (proof-step-first (car integers)))
         (original-den (proof-step-first (cadr integers)))
         (next-num (proof-step-first (caddr integers)))
         (next-den (proof-step-first (cadddr integers)))
         (d (cadr original-den))
         (e (cadr next-den))
         (n (cadr original-num))
         (m (cadr next-num))
         (order (library-lt e d))
         (left (t2-dyadic-low-gap v))
         (right (t2-dyadic-low-gap x))
         (middle (library-diff e n))
         (nonnegative (t2-subtraction-nonnegative-difference lib upper-num))
         (weak (t2-arithmetic-weak-from-difference lib left middle nonnegative integers))
         (has-order (proof-proof-assume proof order t))
         (compare (t2-arithmetic-comparison lib e d integers))
         (gap (proof-proof-rewrite proof has-order compare '(1)))
         (lower (t2-arithmetic-less-from-difference lib middle right gap integers))
         (before (t2-arithmetic-arithmetic-compare-chain lib weak lower integers))
         (type-e (t2-arithmetic-rational lib e integers))
         (type-d (t2-arithmetic-rational lib d integers))
         (needs-equal (t2-order-trichotomy lib e d (list type-e type-d)))
         (needs-equal (proof-proof-front proof needs-equal (proof-eq e d)))
         (same-den (proof-proof-discharge proof needs-equal lower-den))
         (not-order (proof-proof-assume proof order nil))
         (same-den (proof-proof-discharge proof same-den not-order))
         (rebuild (library-library-axiom lib "RATIONAL-IMPLIES2" (list v)))
         (rebuild (t2-arithmetic-arithmetic-modus-ponens lib rebuild ratio-v))
         (rebuild (proof-proof-rewrite proof rebuild same-den '(1 1 1 1)))
         (same-numer (proof-eq n m))
         (equal-numer (proof-proof-assume proof same-numer t))
         (reverse-numer (proof-proof-symmetric proof equal-numer))
         (rebuild (proof-proof-rewrite proof rebuild reverse-numer '(1 1 2)))
         (rebuild (proof-proof-symmetric proof rebuild))
         (rebuild-x (library-library-axiom lib "RATIONAL-IMPLIES2" (list x)))
         (rebuild-x (t2-arithmetic-arithmetic-modus-ponens lib rebuild-x rat))
         (equal-values (proof-proof-chain proof rebuild (list rebuild-x)))
         (one-less-two (t2-arithmetic-arithmetic-prove lib (library-lt *proof-one* two) nil nil))
         (one-rational (t2-arithmetic-rational lib *proof-one* nil))
         (two-rational (t2-arithmetic-rational lib two nil))
         (bigger (t2-order-increasing-product lib one-less-two above (list rat one-rational two-rational)))
         (number-x (t2-order-number-from-rational lib rat))
         (unit (t2-field-identity lib x number-x *proof-times*))
         (bigger (proof-proof-rewrite proof bigger unit '(1 1)))
         (commute (library-library-axiom lib "COMMUTATIVITY-OF-*" (list x two)))
         (bigger (proof-proof-rewrite proof bigger commute '(1 2)))
         (different (t2-order-distinct lib bigger))
         (different (t2-products-flip-neq lib different))
         (change (proof-proof-cut proof equal-values different))
         (change (proof-proof-front proof change (proof-neg same-numer)))
         (stronger-num (t2-products-strict-from-weak lib upper-num change integers))
         (comparison (t2-arithmetic-comparison lib n m integers))
         (positive-gap (proof-proof-rewrite proof stronger-num comparison '(1)))
         (after (t2-arithmetic-less-from-difference lib left middle positive-gap integers))
         (after (proof-proof-rewrite proof after same-den '(1 2 1)))
         (den-gap (proof-proof-cases proof order before after))
         (claim (proof-step-first den-gap))
         (ratio-test (proof-step-first rat))
         (positive-test (proof-step-first above))
         (guards (library-guards (list ratio-test positive-test)))
         (lib (library-library-lemma lib "DYADIC-DENOMINATOR-GAP" claim den-gap guards))
         (proof (library-library-proof lib))
         (smaller (library-library-cite lib "DYADIC-DENOMINATOR-GAP" (list x) (list rat above)))
         (comparison (t2-arithmetic-comparison lib left right integers))
         (difference (proof-proof-rewrite proof smaller comparison '(1)))
         (other (t2-arithmetic-less-from-difference lib (t2-dyadic-high-gap x) (t2-dyadic-high-gap v)
                                                   difference integers))
         (claim (proof-step-first other)))
      (library-library-lemma lib "DYADIC-NUMERATOR-GAP" claim other guards))))

(defun t2-dyadic-positive-gap (lib is-rational order)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((ratio-literal (proof-step-first is-rational))
         (x (proof-term-at ratio-literal 1))
         (parts (t2-arithmetic-rational-parts lib is-rational))
         (int-n (car parts))
         (int-d (cadr parts))
         (pos-d (caddr parts))
         (den-literal (proof-step-first int-d))
         (d (cadr den-literal))
         (one-rational (t2-arithmetic-rational lib *proof-one* nil))
         (den-rational (t2-arithmetic-rational lib d (list int-d)))
         (scaled (t2-order-increasing-product lib order pos-d (list is-rational one-rational den-rational)))
         (commute (library-library-axiom lib "COMMUTATIVITY-OF-*" (list d x)))
         (multiply (library-library-cite lib "FIELD-MULTIPLY-DENOMINATOR" (list x) (list is-rational)))
         (multiplied (proof-proof-chain proof commute (list multiply)))
         (number (t2-arithmetic-number lib d (list int-d)))
         (unital (t2-field-identity lib d number *proof-times*))
         (product (proof-step-first multiplied))
         (scaled-literal (proof-step-first scaled))
         (first (if (equal (cadr scaled-literal) (cadr product)) multiplied unital))
         (scaled (proof-proof-rewrite proof scaled first '(1 1)))
         (scaled-literal (proof-step-first scaled))
         (second (if (equal (caddr scaled-literal) (cadr product)) multiplied unital))
         (scaled (proof-proof-rewrite proof scaled second '(1 2)))
         (scaled-literal (proof-step-first scaled))
         (types (list int-n int-d))
         (comparison (t2-arithmetic-comparison lib (cadr scaled-literal) (caddr scaled-literal) types))
         (result (proof-proof-rewrite proof scaled comparison '(1))))
      (list result types))))

(defun t2-dyadic-rank-value-select (proof step condition)
  (proof-with-checked-results
      ((literal (proof-step-first step))
       (right (proof-term-at literal 2))
       (selected (proof-proof-select proof right condition)))
    (proof-proof-chain proof step (list selected))))

(defun t2-dyadic-rank-value-conditions (proof step conditions)
  (declare (xargs :measure (acl2-count conditions)))
  (if (or (failure-p step) (endp conditions))
      step
    (t2-dyadic-rank-value-conditions
     proof (t2-dyadic-rank-value-select proof step (car conditions)) (cdr conditions))))

(defun t2-dyadic-rank-value (lib value conditions)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results ((step (proof-proof-reflexive proof (cadr (t2-dyadic-measure value)))))
      (t2-dyadic-rank-value-conditions proof step conditions))))

(defun t2-dyadic-rank-count (lib expansion gap types)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((literal (proof-step-first expansion))
         (term (proof-term-at literal 2))
         (natural (if (equal term *proof-zero*)
                      (t2-arithmetic-arithmetic-natural lib *proof-zero*)
                    (proof-with-checked-results ((integer (t2-arithmetic-arithmetic-type-of lib term types)))
                      (t2-arithmetic-natural-from-positive lib integer gap))))
         (rank (proof-term-at literal 1))
         (opened (proof-proof-reflexive proof (list *library-count* rank)))
         (opened (proof-proof-rewrite proof opened expansion '(1 2 1)))
         (counted (t2-arithmetic-count-natural lib natural))
         (lib (cdr counted))
         (result (proof-proof-chain (library-library-proof lib) opened (list (car counted)))))
      (cons result lib))))

(defun t2-dyadic-ordinal-rank (lib smaller greater difference)
  (proof-with-checked-results
      ((step (library-library-transport-argument lib difference smaller 1))
       (step (library-library-transport-argument lib step greater 2))
       (smaller-literal (proof-step-first smaller))
       (a (proof-term-at smaller-literal 1))
       (greater-literal (proof-step-first greater))
       (b (proof-term-at greater-literal 1))
       (ordinal (t2-arithmetic-arithmetic-ordinal-comparison lib a b nil)))
    (proof-proof-transport (library-library-proof lib) step ordinal)))

(defun t2-dyadic-doubling (lib rat pos)
  (let ((proof (library-library-proof lib))
        (two *t2-dyadic-two*)
        (one *proof-one*))
    (proof-with-checked-results
        ((literal (proof-step-first rat))
         (x (proof-term-at literal 1))
         (condition (proof-proof-assume proof (library-lt x one) t))
         (large (t2-dyadic-twice x))
         (large-ratio (t2-order-rational lib large (list rat)))
         (before (t2-dyadic-positive-gap lib rat condition))
         (expansion (t2-dyadic-rank-value lib x (list condition)))
         (original (t2-dyadic-rank-count lib expansion (car before) (cadr before)))
         (lib (cdr original))
         (proof (library-library-proof lib))
         (positive-two (t2-arithmetic-arithmetic-prove lib (library-positive two) nil nil))
         (rational-one (t2-arithmetic-rational lib one nil))
         (rational-two (t2-arithmetic-rational lib two nil))
         (below-two (t2-order-increasing-product lib condition positive-two (list rat rational-one rational-two)))
         (product (t2-book-logic-constant lib (t2-products-times two one)))
         (below-two (proof-proof-rewrite proof below-two product '(1 2)))
         (test (library-lt large one))
         (before-exponent (proof-proof-assume proof test t))
         (after-gap (t2-dyadic-positive-gap lib large-ratio before-exponent))
         (expansion (t2-dyadic-rank-value lib large (list before-exponent)))
         (after (t2-dyadic-rank-count lib expansion (car after-gap) (cadr after-gap)))
         (lib (cdr after))
         (proof (library-library-proof lib))
         (decrease (library-library-cite lib "DYADIC-DENOMINATOR-GAP" (list x) (list rat pos)))
         (first (t2-dyadic-ordinal-rank lib (car after) (car original) decrease))
         (at-least-one (proof-proof-assume proof test nil))
         (expansion (t2-dyadic-rank-value lib large (list at-least-one below-two)))
         (ended (t2-dyadic-rank-count lib expansion nil nil))
         (lib (cdr ended))
         (second (t2-dyadic-ordinal-rank lib (car ended) (car original) (car before)))
         (step (proof-proof-cases (library-library-proof lib) test first second))
         (claim (proof-step-first step))
         (pos-literal (proof-step-first pos))
         (condition-literal (proof-step-first condition)))
      (library-library-lemma lib "DYADIC-DOUBLE-DECREASE" claim step
                             (library-guards (list literal pos-literal condition-literal))))))

(defun t2-dyadic-above-one (lib is-rational at-least-two)
  (proof-with-checked-results
      ((one-less-two (t2-arithmetic-arithmetic-prove lib (library-lt *proof-one* *t2-dyadic-two*) nil nil))
       (rational-two (t2-arithmetic-rational lib *t2-dyadic-two* nil)))
    (t2-power-products-strict-then-weak lib one-less-two at-least-two (list is-rational rational-two))))

(defun t2-dyadic-halving (lib rat pos)
  (let ((proof (library-library-proof lib))
        (two *t2-dyadic-two*)
        (half *t2-exponent-parity-half*))
    (proof-with-checked-results
        ((literal (proof-step-first rat))
         (x (proof-term-at literal 1))
         (condition (proof-proof-assume proof (library-lt x two) nil))
         (above (t2-dyadic-above-one lib rat condition))
         (lib (cdr above))
         (gap (t2-dyadic-positive-gap lib rat (car above)))
         (opposite (t2-order-opposite-order lib (car above)))
         (expansion (t2-dyadic-rank-value lib x (list opposite condition)))
         (original (t2-dyadic-rank-count lib expansion (car gap) (cadr gap)))
         (lib (cdr original))
         (proof (library-library-proof lib))
         (small (t2-dyadic-half x))
         (child-ratio (t2-order-rational lib small (list rat)))
         (child-pos (t2-dyadic-pos-product lib half rat pos))
         (two-rational (t2-arithmetic-rational lib two nil))
         (half-rational (t2-order-rational lib half nil))
         (half-sign (t2-book-logic-constant lib (library-positive half)))
         (half-positive (proof-proof-true-from-eq proof half-sign))
         (scale (library-library-cite lib "FIELD-POSITIVE-SCALE" (list x two half)
                                     (list rat two-rational half-rational half-positive)))
         (at-least-one (library-library-transport-argument lib condition scale 1))
         (product (t2-book-logic-constant lib (t2-products-times half two)))
         (at-least-one (proof-proof-rewrite proof at-least-one product '(1 1 2)))
         (test (library-lt small two))
         (inside (proof-proof-assume proof test t))
         (expansion (t2-dyadic-rank-value lib small (list at-least-one inside)))
         (ended (t2-dyadic-rank-count lib expansion nil nil))
         (lib (cdr ended))
         (proof (library-library-proof lib))
         (first (t2-dyadic-ordinal-rank lib (car ended) (car original) (car gap)))
         (child-high (proof-proof-assume proof test nil))
         (child-above (t2-dyadic-above-one lib child-ratio child-high))
         (lib (cdr child-above))
         (after-gap (t2-dyadic-positive-gap lib child-ratio (car child-above)))
         (expansion (t2-dyadic-rank-value lib small (list at-least-one child-high)))
         (after (t2-dyadic-rank-count lib expansion (car after-gap) (cadr after-gap)))
         (lib (cdr after))
         (proof (library-library-proof lib))
         (decrease (library-library-cite lib "DYADIC-NUMERATOR-GAP" (list small) (list child-ratio child-pos)))
         (back (t2-dyadic-cancel-scales lib x rat two half))
         (decrease-literal (proof-step-first decrease))
         (back-literal (proof-step-first back))
         (decrease (proof-proof-rewrite-result proof decrease back
                                               (library-lt *proof-false* (caddr decrease-literal))
                                               (cadr back-literal)))
         (second (t2-dyadic-ordinal-rank lib (car after) (car original) decrease))
         (step (proof-proof-cases proof test first second))
         (claim (proof-step-first step))
         (pos-literal (proof-step-first pos)))
      (library-library-lemma lib "DYADIC-HALF-DECREASE" claim step
                             (append (library-guards (list literal pos-literal))
                                     (list (library-lt x two)))))))

(defun t2-dyadic-build (lib)
  (proof-with-checked-results
      ((lib (t2-dyadic-strict-gap-order lib))
       (proof (library-library-proof lib))
       (rat (proof-proof-assume proof (list *library-rationalp* *library-x*) t))
       (pos (proof-proof-assume proof (library-positive *library-x*) t))
       (lib (t2-dyadic-doubling lib rat pos)))
    (t2-dyadic-halving lib rat pos)))

(defun t2-dyadic-definition-matches (calls cases)
  (if (endp calls)
      t
    (let ((actuals (termination-call-actuals (car calls))))
      (and (equal (len actuals) 1)
           (assoc-equal (car actuals) cases)
           (t2-dyadic-definition-matches (cdr calls) cases)))))

(defun t2-dyadic-definition-decrease (lib call cases formal)
  (let ((entry (assoc-equal (car (termination-call-actuals call)) cases)))
    (if (not entry)
        '(:failure "missing-binding" "")
      (proof-with-checked-results
          ((facts (t2-tactics-ruler-facts-init lib (termination-call-tests call) nil))
           (rat (t2-tactics-ruler-facts-require facts (list *library-rationalp* formal)))
           (positive (t2-tactics-ruler-facts-require (cdr rat) (library-positive formal)))
           (branch (t2-tactics-ruler-facts-require (cdr positive) (caddr entry)))
           (step (library-library-cite lib (cadr entry) (list formal)
                                       (list (car rat) (car positive) (car branch))))
           (literal (proof-step-first step))
           (head (proof-term-at literal 0)))
        (if (equal head *proof-ordinal-less*)
            step
          '(:failure "recipe-mismatch" ""))))))

(defun t2-dyadic-definition-case-proof (lib obligation call measured cases formal)
  (proof-with-checked-results
      ((step (if call
                 (t2-dyadic-definition-decrease lib call cases formal)
               (library-library-builtin lib 1 (cadr measured)))))
    (proof-proof-subsume (library-library-proof lib) step obligation)))

(defun t2-dyadic-definition-collect (step proofs)
  (if (failure-p step) step (cons step proofs)))

(defun t2-dyadic-definition-proofs (lib obligations measured cases formal seen proofs)
  (declare (xargs :measure (acl2-count obligations)))
  (cond
   ((failure-p proofs) proofs)
   ((endp obligations) (reverse proofs))
   (t
    (let ((obligation (caar obligations))
          (call (cadar obligations))
          (remaining (cdr obligations)))
      (if (member-equal obligation seen)
          (t2-dyadic-definition-proofs lib remaining measured cases formal seen proofs)
        (t2-dyadic-definition-proofs
         lib remaining measured cases formal (cons obligation seen)
         (t2-dyadic-definition-collect
          (t2-dyadic-definition-case-proof lib obligation call measured cases formal) proofs)))))))

(defun t2-dyadic-definition (lib definitions calls)
  (if (not (equal (len definitions) 1))
      nil
    (proof-with-checked-results ((formals (proof-term-at (car definitions) 1)))
      (if (not (equal (len formals) 1))
          nil
        (proof-with-checked-results ((definition (proof-list-of-length (car definitions) 3)))
          (let* ((name (car definition))
                 (formal (car formals))
                 (cases
                  (list (list (t2-dyadic-twice formal) "DYADIC-DOUBLE-DECREASE" (library-lt formal *proof-one*))
                        (list (t2-dyadic-half formal) "DYADIC-HALF-DECREASE"
                              (proof-neg (library-lt formal *t2-dyadic-two*))))))
            (if (and (consp calls) (t2-dyadic-definition-matches calls cases))
                (proof-with-checked-results
                    ((measured (t2-dyadic-measure formal))
                     (obligations (termination-obligation-cases definitions (list (cons name measured)) calls))
                     (steps (t2-dyadic-definition-proofs lib obligations measured cases formal nil nil)))
                  (proof-proof-entry "measure" name (list name measured) steps))
              nil)))))))
