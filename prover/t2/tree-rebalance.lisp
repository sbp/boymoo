(in-package "BOYMOO-PROVER")
(set-verify-guards-eagerness 0)

(defconst *t2-tree-rebalance-build-tree* (proof-sym "SYMBOL-ALIST-TO-BTREE-AUX" "ACL2"))
(defconst *t2-tree-rebalance-rebalance* (proof-sym "REBALANCE-SYMBOL-BTREE" "ACL2"))
(defconst *t2-tree-rebalance-length* (proof-cl "LENGTH"))
(defconst *t2-tree-rebalance-stringp* (proof-cl "STRINGP"))

(defmacro t2-tree-rebalance-with-library (bindings result)
  (if (endp bindings)
      result
    (let* ((binding (car bindings))
           (name (car binding))
           (form (cadr binding)))
      `(let ((checked-tree-value ,form))
         (cond ((failure-p checked-tree-value) (cons checked-tree-value lib))
               ((failure-p (car checked-tree-value)) checked-tree-value)
               (t (let ((,name checked-tree-value))
                    (t2-tree-rebalance-with-library ,(cdr bindings) ,result))))))))

(defun t2-tree-rebalance-unproved-p (result)
  (and (failure-p result) (equal (cadr result) "unproved")))

; A structural normalization can add lemmas before reporting an unproved
; goal. The state-returning traversal supplies the Library for the fallback.
(defun t2-tree-rebalance-reduce (lib expand tests premises equations term)
  (let ((result (t2-structural-proof-reduce lib expand tests premises equations term)))
    (if (t2-tree-rebalance-unproved-p result)
        (cons result (cdr (t2-symbol-trees-normal-form lib term expand tests premises equations)))
      result)))

(defun t2-tree-rebalance-solve (lib goal expand premises equations)
  (let ((result (t2-structural-proof-solve lib goal expand nil premises equations 10)))
    (if (t2-tree-rebalance-unproved-p result)
        (cons result (cdr (t2-symbol-trees-solve lib goal expand nil premises equations 10)))
      result)))

(defun t2-tree-rebalance-components (lib premise known)
  (let ((result (t2-structural-proof-components lib premise nil 3 known)))
    (if (t2-tree-rebalance-unproved-p result)
        (let* ((term (proof-step-first premise))
               (normal (t2-symbol-trees-normal-form lib term (list (list :term term)) nil known nil)))
          (cons result (cdr normal)))
      result)))

(defun t2-tree-rebalance-first (step)
  (if step
      (proof-step-first step)
    '(:failure "failure" "")))

(defun t2-tree-rebalance-step-term (step index)
  (proof-with-checked-results ((literal (t2-tree-rebalance-first step)))
    (proof-term-at literal index)))

(defun t2-tree-rebalance-prefixes (seq n)
  (let ((result (list *t2-tree-rebalance-build-tree* seq n)))
    (list (list *t2-input-fields-mv-nth* *proof-zero* result)
          (list *t2-input-fields-mv-nth* *proof-one* result))))

(defun t2-tree-rebalance-prefix-properties (seq n)
  (let* ((prefixes (t2-tree-rebalance-prefixes seq n))
         (tree (car prefixes))
         (rest (cadr prefixes)))
    (list (list *t2-symbol-trees-treep* tree)
          (list *t2-structural-lists-symbol-alistp* rest)
          (proof-eq (list *library-len* rest) (library-diff (list *library-len* seq) n))
          (proof-eq (list *t2-structural-lists-append* (list *t2-symbol-trees-to-alist* tree) rest)
                    seq))))

(defun t2-tree-rebalance-positive-length (lib strictly-positive)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((length (t2-tree-rebalance-step-term strictly-positive 2))
         (head (proof-term-at length 0)))
      (if (not (equal head *library-len*))
          '(:failure "recipe-mismatch" "")
        (proof-with-checked-results
            ((equation (proof-proof-unfold proof length))
             (body (t2-tree-rebalance-step-term equation 2))
             (false-branch (proof-proof-if-false proof body))
             (zero (proof-proof-chain proof equation (list false-branch)))
             (false-step (proof-proof-rewrite proof strictly-positive zero '(1 2)))
             (zero-axiom (library-library-axiom lib "ZERO" nil))
             (cut (proof-proof-cut proof false-step zero-axiom))
             (seq (proof-term-at length 1)))
          (proof-proof-front proof cut (list *proof-consp* seq)))))))

(defun t2-tree-rebalance-length-after-tail (lib nonempty)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((seq (t2-tree-rebalance-step-term nonempty 1))
         (length (list *library-len* seq))
         (shortened (list *library-len* (list *t2-book-logic-cdr* seq)))
         (opened (proof-proof-unfold proof length))
         (cons-length (t2-input-fields-select lib opened nonempty))
         (difference (proof-proof-reflexive proof (library-diff length *proof-one*)))
         (before (proof-proof-rewrite proof difference cons-length '(1 2 1)))
         (before-body (t2-tree-rebalance-step-term before 2))
         (after (t2-arithmetic-linear-equal lib before-body shortened nil))
         (step (proof-proof-chain proof before (list after))))
      (proof-proof-symmetric proof step))))

(defun t2-tree-rebalance-publish-projection (lib aux built index position)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((source (t2-tree-rebalance-step-term aux 1))
         (reflexive (proof-proof-reflexive proof (list *t2-input-fields-mv-nth* position source)))
         (expanded (proof-proof-rewrite proof reflexive aux '(1 2 2)))
         (selected (t2-input-fields-cons-projection lib *t2-input-fields-mv-nth* index built)))
      (proof-proof-chain proof expanded (list selected)))))

(defun t2-tree-rebalance-publish (lib aux known)
  (let ((proof (library-library-proof lib)))
    (proof-with-checked-results
        ((built (t2-tree-rebalance-step-term aux 2))
         (tree (t2-tree-rebalance-publish-projection lib aux built 0 *proof-zero*))
         (rest (t2-tree-rebalance-publish-projection lib aux built 1 *proof-one*))
         (known (proof-list-of-length known 4))
         (tree-type (library-library-transport-argument lib (nth 0 known) tree 1))
         (rest-type (library-library-transport-argument lib (nth 1 known) rest 1))
         (rest-reversed (proof-proof-symmetric proof rest))
         (length (proof-proof-rewrite proof (nth 2 known) rest-reversed '(1 1 1)))
         (tree-reversed (proof-proof-symmetric proof tree))
         (recovered (proof-proof-rewrite proof (nth 3 known) tree-reversed '(1 1 1 1)))
         (rest-reversed (proof-proof-symmetric proof rest))
         (recovered (proof-proof-rewrite proof recovered rest-reversed '(1 1 2))))
      (t2-power-join lib (list tree-type rest-type length recovered)))))

(defun t2-tree-rebalance-simplify-build-attempt (lib n known)
  (let ((operation (list *t2-tree-rebalance-build-tree* *library-x* n)))
    (t2-tree-rebalance-reduce lib (list (list :term operation) (list :head *t2-tactics-zp*))
                             nil known nil operation)))

(defconst *t2-tree-rebalance-constructor-expansions*
  (list (list :constructed *t2-symbol-trees-treep* 1)
        (list :constructed *t2-symbol-trees-to-alist* 1)
        (list :constructed *t2-structural-lists-append* 1)))

(defun t2-tree-rebalance-short-prefix-known (lib size typed lower-bound equivalence tree rest length)
  (let* ((proof (library-library-proof lib))
         (x *library-x*)
         (full-length (list *library-len* x))
         (tree-goal (list *t2-symbol-trees-treep* tree))
         (rebuild-goal (proof-eq (list *t2-structural-lists-append*
                                       (list *t2-symbol-trees-to-alist* tree) rest)
                                 x))
         (expand *t2-tree-rebalance-constructor-expansions*))
    (if (equal size 0)
        (t2-tree-rebalance-with-library
            ((tree-result (t2-tree-rebalance-solve lib tree-goal expand nil nil))
             (lib (cdr tree-result))
             (rem-len (t2-arithmetic-linear-equal lib full-length length nil))
             (rebuilt (t2-tree-rebalance-solve lib rebuild-goal expand nil nil)))
          (cons (list (car tree-result) typed rem-len (car rebuilt)) (cdr rebuilt)))
      (t2-tree-rebalance-with-library
          ((bound (proof-proof-rewrite proof lower-bound equivalence '(1 1 2)))
           (one-positive (t2-arithmetic-arithmetic-prove lib (library-lt *proof-zero* *proof-one*)
                                                         nil nil))
           (length-type (t2-arithmetic-arithmetic-type-of lib full-length nil))
           (positive (t2-arithmetic-arithmetic-compare-chain lib one-positive bound (list length-type)))
           (known (t2-tree-rebalance-positive-length lib positive))
           (components (t2-tree-rebalance-components lib typed (list known)))
           (lib (cdr components))
           (entry-cons (nth 0 (car components)))
           (key-type (nth 1 (car components)))
           (rest-type (nth 2 (car components)))
           (tree-result (t2-tree-rebalance-solve lib tree-goal expand (list entry-cons key-type) nil))
           (lib (cdr tree-result))
           (rem-len (t2-tree-rebalance-length-after-tail lib known))
           (elim (library-library-axiom lib "CAR-CDR-ELIM" (list x)))
           (original (t2-arithmetic-arithmetic-modus-ponens lib elim known))
           (rebuilt (t2-tree-rebalance-solve lib rebuild-goal expand (list entry-cons) (list original))))
        (cons (list (car tree-result) rest-type rem-len (car rebuilt)) (cdr rebuilt))))))

(defun t2-tree-rebalance-short-prefix-attempt (lib size typed lower-bound claim)
  (let* ((proof (library-library-proof lib))
         (y *library-y*)
         (value (if (equal size 0) *proof-zero* *proof-one*)))
    (t2-tree-rebalance-with-library
        ((equivalence (proof-proof-assume proof (proof-eq y value) t))
         (output (t2-tree-rebalance-simplify-build-attempt lib value nil))
         (lib (cdr output))
         (output (car output))
         (body (t2-tree-rebalance-step-term output 2))
         (tree (proof-term-at body 1))
         (rest-cons (proof-term-at body 2))
         (rest (proof-term-at rest-cons 1))
         (length (library-diff (list *library-len* *library-x*) value))
         (known (t2-tree-rebalance-short-prefix-known lib size typed lower-bound equivalence
                                                      tree rest length))
         (lib (cdr known))
         (proof (library-library-proof lib))
         (result (t2-tree-rebalance-publish lib output (car known)))
         (reverse (proof-proof-symmetric proof equivalence))
         (result (proof-proof-rewrite-result proof result reverse claim y)))
      (cons result lib))))

(defun t2-tree-rebalance-long-prefix-attempt (lib formula typed size nonnegative enough)
  (let* ((proof (library-library-proof lib))
         (x *library-x*)
         (y *library-y*)
         (two *t2-half-parity-two*)
         (zero-test (proof-eq y *proof-zero*))
         (one-test (proof-eq y *proof-one*)))
    (t2-tree-rebalance-with-library
        ((zero (proof-proof-assume proof zero-test nil))
         (one (proof-proof-assume proof one-test nil))
         (lib (t2-products-positive-from-nonzero lib))
         (sign (library-library-cite lib "POSITIVE-FROM-NONZERO" (list y)
                                     (list size nonnegative zero)))
         (facts (t2-tactics-ruler-facts-init lib nil (list size sign)))
         (middle (list *t2-floor-floor* y two))
         (part (library-plus *proof-one* middle))
         (right-size (library-diff y part))
         (lib (t2-floor-split-quotient-bracket lib))
         (two-int (t2-arithmetic-arithmetic-type-of lib two nil))
         (two-large (t2-arithmetic-arithmetic-prove lib (library-lt *proof-one* two) nil nil))
         (bracket (library-library-cite lib "FLOOR-SPLIT-BOUNDS" (list y two)
                                        (list size two-int sign two-large)))
         (parts (t2-power-conjuncts lib bracket 3))
         (integral (nth 0 parts))
         (lower (nth 1 parts))
         (upper (nth 2 parts))
         (known-ints (list size integral))
         (length (list *library-len* x))
         (length-int (t2-arithmetic-arithmetic-type-of lib length nil))
         (within (t2-arithmetic-arithmetic-compare-chain lib upper enough
                                                        (list size integral length-int)))
         (left-bindings (list (list y middle)))
         (facts (t2-tactics-ruler-facts-with-proof facts lib))
         (left-descent (t2-floor-split-decrease lib (list middle nil) facts))
         (lib (cadr left-descent))
         (facts (caddr left-descent))
         (left (t2-structural-proof-induction-instance lib formula (car left-descent) left-bindings))
         (weak (t2-arithmetic-arithmetic-as-weak lib within known-ints))
         (premise (t2-power-join lib (list typed integral lower weak)))
         (left (t2-arithmetic-arithmetic-modus-ponens lib left premise))
         (parts (t2-power-conjuncts lib left 4))
         (left-type (nth 0 parts))
         (left-rest (nth 1 parts))
         (left-len (nth 2 parts))
         (left-eq (nth 3 parts))
         (rest (t2-tree-rebalance-step-term left-rest 1))
         (compare (t2-arithmetic-comparison lib middle length known-ints))
         (proof (library-library-proof lib))
         (pos-len (proof-proof-rewrite proof within compare '(1)))
         (reverse (proof-proof-symmetric proof left-len))
         (pos-len (proof-proof-rewrite proof pos-len reverse '(1 2)))
         (nonempty (t2-tree-rebalance-positive-length lib pos-len))
         (parts (t2-tree-rebalance-components lib left-rest (list nonempty)))
         (lib (cdr parts))
         (proof (library-library-proof lib))
         (entry-cons (nth 0 (car parts)))
         (key-type (nth 1 (car parts)))
         (tail-type (nth 2 (car parts)))
         (tail (list *t2-book-logic-cdr* rest))
         (tail-len (t2-tree-rebalance-length-after-tail lib nonempty))
         (tail-len (proof-proof-rewrite-first proof tail-len left-len))
         (room (library-library-cite lib "FIELD-ORDER-TRANSLATION"
                                     (list (list *library-len* tail) right-size part) nil))
         (room-lhs (t2-tree-rebalance-step-term room 1))
         (first-sum (proof-term-at room-lhs 1))
         (reflexive (proof-proof-reflexive proof first-sum))
         (sum-length (proof-proof-rewrite proof reflexive tail-len '(1 2 1)))
         (sum-body (t2-tree-rebalance-step-term sum-length 2))
         (linear (t2-arithmetic-linear-equal lib sum-body length known-ints))
         (sum-length (proof-proof-chain proof sum-length (list linear)))
         (room (proof-proof-rewrite proof room sum-length '(1 1 1)))
         (room-lhs (t2-tree-rebalance-step-term room 1))
         (second-sum (proof-term-at room-lhs 2))
         (restored (t2-arithmetic-linear-equal lib second-sum y known-ints))
         (room (proof-proof-rewrite proof room restored '(1 1 2)))
         (right-enough (proof-proof-rewrite proof enough room '(1 1)))
         (right-bound (t2-products-discrete-step lib upper known-ints))
         (right-nonnegative (t2-subtraction-nonnegative-difference lib right-bound))
         (right-bindings (list (list x tail) (list y right-size)))
         (facts (t2-tactics-ruler-facts-with-proof facts lib))
         (right-descent (t2-floor-split-decrease lib (list middle t) facts))
         (lib (cadr right-descent))
         (proof (library-library-proof lib))
         (right (t2-structural-proof-induction-instance lib formula (car right-descent) right-bindings))
         (right-int (t2-arithmetic-arithmetic-type-of lib right-size known-ints))
         (premise (t2-power-join lib (list tail-type right-int right-nonnegative right-enough)))
         (right (t2-arithmetic-arithmetic-modus-ponens lib right premise))
         (parts (t2-power-conjuncts lib right 4))
         (right-type (nth 0 parts))
         (right-rest (nth 1 parts))
         (right-len (nth 2 parts))
         (right-eq (nth 3 parts))
         (length-equation (proof-proof-rewrite-first proof right-len tail-len))
         (length-body (t2-tree-rebalance-step-term length-equation 2))
         (length-normal (t2-arithmetic-linear-equal lib length-body (library-diff length y) known-ints))
         (length-equation (proof-proof-chain proof length-equation (list length-normal)))
         (output (t2-tree-rebalance-simplify-build-attempt lib y (list size sign one)))
         (lib (cdr output))
         (output (car output))
         (output-body (t2-tree-rebalance-step-term output 2))
         (tree (proof-term-at output-body 1))
         (expand *t2-tree-rebalance-constructor-expansions*)
         (reduced (t2-tree-rebalance-solve lib (list *t2-symbol-trees-treep* tree) expand
                                         (list entry-cons key-type left-type right-type) nil))
         (lib (cdr reduced))
         (reduced (car reduced))
         (left-tree (t2-tree-rebalance-step-term left-type 1))
         (right-tree (t2-tree-rebalance-step-term right-type 1))
         (l-alist (list *t2-symbol-trees-to-alist* left-tree))
         (r-alist (list *t2-symbol-trees-to-alist* right-tree))
         (trailing (list *proof-cons* (list *t2-book-logic-car* rest) r-alist))
         (elim (library-library-axiom lib "CAR-CDR-ELIM" (list rest)))
         (restored (t2-arithmetic-arithmetic-modus-ponens lib elim nonempty))
         (association (t2-structural-lists-append-associativity lib))
         (lib (cdr association))
         (right-rest-term (t2-tree-rebalance-step-term right-rest 1))
         (association (library-library-cite lib (car association)
                                            (list l-alist trailing right-rest-term) nil))
         (rebuild-goal (proof-eq (list *t2-structural-lists-append*
                                       (list *t2-symbol-trees-to-alist* tree) right-rest-term) x))
         (recovered (t2-tree-rebalance-solve lib rebuild-goal expand (list entry-cons)
                                           (list association right-eq restored left-eq)))
         (lib (cdr recovered))
         (exact (t2-tree-rebalance-publish lib output (list reduced right-rest length-equation
                                                            (car recovered)))))
      (cons (list exact (list left-bindings right-bindings)) lib))))

(defun t2-tree-rebalance-prefix-invariant-attempt (lib)
  (let* ((proof (library-library-proof lib))
         (name "TREE-FROM-SYMBOL-ALIST-PREFIX")
         (x *library-x*)
         (y *library-y*))
    (if (assoc-equal (proof-sym (concatenate 'string "SELF-" name) "ACL2")
                     (proof-proof-facts proof))
        (cons name lib)
      (t2-tree-rebalance-with-library
          ((premises (list (list *t2-structural-lists-symbol-alistp* x) (library-integer y)
                           (proof-neg (library-lt y *proof-zero*))
                           (proof-neg (library-lt (list *library-len* x) y))))
           (domain (t2-power-condition premises))
           (assumed (proof-proof-assume proof domain t))
           (parts (t2-power-conjuncts lib assumed 4))
           (typed (nth 0 parts))
           (size (nth 1 parts))
           (nonnegative (nth 2 parts))
           (upper (nth 3 parts))
           (claim (t2-power-condition (t2-tree-rebalance-prefix-properties x y)))
           (formula (list *library-implies* domain claim))
           (tail (t2-tree-rebalance-long-prefix-attempt lib formula typed size nonnegative upper))
           (lib (cdr tail))
           (substitutions (cadar tail))
           (tail (caar tail))
           (one (t2-tree-rebalance-short-prefix-attempt lib 1 typed upper claim))
           (lib (cdr one))
           (proof (library-library-proof lib))
           (one (proof-proof-cases proof (proof-eq y *proof-one*) (car one) tail))
           (zero (t2-tree-rebalance-short-prefix-attempt lib 0 typed upper claim))
           (lib (cdr zero))
           (proof (library-library-proof lib))
           (cases (proof-proof-cases proof (proof-eq y *proof-zero*) (car zero) one))
           (case-proof (t2-power-implication lib domain cases))
           (step (t2-structural-proof-induct lib formula y case-proof substitutions))
           (lib (library-library-lemma lib name formula step nil)))
        (cons name lib)))))

(defun t2-tree-rebalance-proper-length-attempt (lib typed)
  (let ((proof (library-library-proof lib)))
    (t2-tree-rebalance-with-library
        ((seq (t2-tree-rebalance-step-term typed 1))
         (start (proof-proof-unfold proof (list *t2-tree-rebalance-length* seq)))
         (branch (list *proof-consp* seq))
         (text (list *t2-tree-rebalance-stringp* seq))
         (theorem (proof-proof-fact proof "consp-not-stringp" (list (list *library-x* seq))))
         (assumed (proof-proof-assume proof branch t))
         (no-string (t2-arithmetic-arithmetic-modus-ponens lib theorem assumed))
         (term (t2-tree-rebalance-first typed))
         (normal (t2-tree-rebalance-reduce lib (list (list :term term))
                                         (list (list branch nil)) nil nil term))
         (lib (cdr normal))
         (proof (library-library-proof lib))
         (empty (proof-proof-rewrite proof typed (car normal) '(1)))
         (not-nil (proof-proof-not-nil proof))
         (computed (t2-book-logic-constant lib (list *t2-tree-rebalance-stringp* *proof-false*)))
         (no-text (library-library-transport-argument lib not-nil computed 1))
         (reverse (proof-proof-symmetric proof empty))
         (no-text (proof-proof-rewrite proof no-text reverse '(1 1 1)))
         (literal (t2-tree-rebalance-first no-text)))
      (if (not (equal literal (proof-neg text)))
          (cons '(:failure "recipe-mismatch" "") lib)
        (t2-tree-rebalance-with-library
            ((yes (t2-input-fields-select lib start no-string))
             (no (t2-input-fields-select lib start no-text))
             (step (proof-proof-cases proof branch yes no)))
          (cons step lib))))))

(defun t2-tree-rebalance-rebalance-consequences-attempt (lib)
  (let* ((proof (library-library-proof lib))
         (name "TREE-REBALANCE-INVARIANT")
         (x *library-x*))
    (if (assoc-equal (proof-sym (concatenate 'string "SELF-" name) "ACL2")
                     (proof-proof-facts proof))
        (cons name lib)
      (t2-tree-rebalance-with-library
          ((typed (proof-proof-assume proof (list *t2-symbol-trees-treep* x) t))
           (seq (list *t2-symbol-trees-to-alist* x))
           (typed-implication (proof-proof-fact proof
                               (proof-sym "SYMBOL-ALISTP-SYMBOL-BTREE-TO-ALIST" "ACL2") nil))
           (typed-seq (t2-arithmetic-arithmetic-modus-ponens lib typed-implication typed))
           (true-list (proof-sym "TRUE-LISTP-SYMBOL-BTREE-TO-ALIST" "ACL2"))
           (fact (assoc-equal true-list (proof-proof-facts proof)))
           (clause (if fact (cdr fact) '(:failure "missing-binding" "")))
           (literal (proof-term-at clause 0))
           (argument (proof-term-at literal 1))
           (actual (proof-term-at argument 1))
           (proper (proof-proof-fact proof true-list (list (list actual x))))
           (length (t2-tree-rebalance-proper-length-attempt lib proper))
           (lib (cdr length))
           (length (car length))
           (n (list *library-len* seq))
           (n-type (t2-arithmetic-arithmetic-type-of lib n nil))
           (natural (t2-arithmetic-arithmetic-natural lib n))
           (nonnegative (library-library-cite lib "NATURAL-NONNEGATIVE" (list n) (list natural)))
           (n-type-again (t2-arithmetic-arithmetic-type-of lib n nil))
           (reflexive (library-library-cite lib "WEAK-REFLEXIVE" (list n) (list n-type-again)))
           (bounds (list typed-seq n-type nonnegative reflexive))
           (invariant (t2-tree-rebalance-prefix-invariant-attempt lib))
           (lib (cdr invariant))
           (proof (library-library-proof lib))
           (prefix (library-library-cite lib (car invariant) (list seq n) nil))
           (bounds-step (t2-power-join lib bounds))
           (prefix (t2-arithmetic-arithmetic-modus-ponens lib prefix bounds-step))
           (parts (t2-power-conjuncts lib prefix 4))
           (tree-type (nth 0 parts))
           (rest-type (nth 1 parts))
           (rest-len (nth 2 parts))
           (recovered (nth 3 parts))
           (rest (t2-tree-rebalance-step-term rest-type 1))
           (inverse (library-library-axiom lib "INVERSE-OF-+" (list n)))
           (rest-len (proof-proof-chain proof rest-len (list inverse)))
           (cons-term (list *proof-consp* rest))
           (assumed (proof-proof-assume proof cons-term t))
           (shorter (library-library-cite lib "LEN-CDR-LESS" (list rest) (list assumed)))
           (shorter (proof-proof-rewrite proof shorter rest-len '(1 2)))
           (tail-len (list *library-len* (list *t2-book-logic-cdr* rest)))
           (natural (t2-arithmetic-arithmetic-natural lib tail-len))
           (nonnegative (library-library-cite lib "NATURAL-NONNEGATIVE" (list tail-len)
                                              (list natural)))
           (cut (proof-proof-cut proof shorter nonnegative))
           (not-cons (proof-proof-front proof cut (proof-neg cons-term)))
           (rest-term (t2-tree-rebalance-first rest-type))
           (rest-expansion (t2-tree-rebalance-reduce lib (list (list :term rest-term))
                                                   nil (list not-cons) nil rest-term))
           (lib (cdr rest-expansion))
           (proof (library-library-proof lib))
           (empty (proof-proof-rewrite proof rest-type (car rest-expansion) '(1)))
           (recovered (proof-proof-rewrite proof recovered empty '(1 1 2)))
           (tree (t2-tree-rebalance-step-term tree-type 1))
           (proper-tree (proof-proof-fact proof true-list (list (list actual tree))))
           (append-nil (t2-structural-lists-append-to-empty lib))
           (lib (cdr append-nil))
           (proof (library-library-proof lib))
           (append-nil (library-library-cite lib (car append-nil)
                                              (list (list *t2-symbol-trees-to-alist* tree)) nil))
           (append-nil (t2-arithmetic-arithmetic-modus-ponens lib append-nil proper-tree))
           (recovered (proof-proof-rewrite proof recovered append-nil '(1 1)))
           (operation (list *t2-tree-rebalance-rebalance* x))
           (equation (t2-tree-rebalance-reduce lib (list (list :term operation))
                                             nil nil (list length) operation))
           (lib (cdr equation))
           (proof (library-library-proof lib))
           (equation (car equation))
           (tree-type (library-library-transport-argument lib tree-type equation 1))
           (reverse (proof-proof-symmetric proof equation))
           (recovered (proof-proof-rewrite proof recovered reverse '(1 1 1)))
           (domain (t2-tree-rebalance-first typed))
           (joined (t2-power-join lib (list tree-type recovered)))
           (step (t2-power-implication lib domain joined))
           (claim (t2-tree-rebalance-first step))
           (lib (library-library-lemma lib name claim step nil)))
        (cons name lib)))))

(defun t2-tree-rebalance-rebalance-lookup-attempt (lib formula)
  (let ((proof (library-library-proof lib))
        (x *library-x*))
    (t2-tree-rebalance-with-library
        ((sides (proof-list-of-length (cdr formula) 2))
         (domain (car sides))
         (target (cadr sides))
         (lookup (proof-term-at target 1))
         (looked-up (proof-list-of-length (cdr lookup) 2))
         (key (car looked-up))
         (rebuilt (cadr looked-up))
         (source (proof-term-at rebuilt 1))
         (assumed (proof-proof-assume proof domain t))
         (parts (t2-arithmetic-arithmetic-conjunct lib assumed))
         (typed (car parts))
         (ordered (cadr parts))
         (consequences (t2-tree-rebalance-rebalance-consequences-attempt lib))
         (lib (cdr consequences))
         (proof (library-library-proof lib))
         (facts (library-library-cite lib (car consequences) (list source) nil))
         (facts (t2-arithmetic-arithmetic-modus-ponens lib facts typed))
         (parts (t2-arithmetic-arithmetic-conjunct lib facts))
         (rebuilt-typed (car parts))
         (inorder (cadr parts))
         (rebuilt-ordered (library-library-transport-argument lib ordered inorder 1))
         (association (proof-sym "ASSOC-IN-SYMBOL-BTREE-TO-ALIST" "ACL2"))
         (key-var (proof-sym "KEY" "ACL2"))
         (after (proof-proof-fact proof association (list (list x rebuilt) (list key-var key))))
         (premise (t2-power-join lib (list rebuilt-typed rebuilt-ordered)))
         (after (t2-arithmetic-arithmetic-modus-ponens lib after premise))
         (after (proof-proof-rewrite-first proof after inorder))
         (before (proof-proof-fact proof association (list (list x source) (list key-var key))))
         (assumed (proof-proof-assume proof domain t))
         (before (t2-arithmetic-arithmetic-modus-ponens lib before assumed))
         (reverse (proof-proof-symmetric proof after))
         (equation (proof-proof-chain proof reverse (list before)))
         (step (t2-power-implication lib domain equation)))
      (cons step lib))))

(defun t2-tree-rebalance-lookup-claim-p (domain claim)
  (and (proof-is-call domain *proof-if*)
       (proof-is-call claim *proof-equal*)
       (proof-with-checked-results ((lookup (proof-term-at claim 1)))
         (and (proof-is-call lookup *t2-symbol-trees-find*)
              (proof-with-checked-results ((operation (proof-term-at lookup 2)))
                (proof-is-call operation *t2-tree-rebalance-rebalance*))))))

(defun t2-tree-rebalance-claim-index (claim)
  (cond ((proof-is-call claim *t2-symbol-trees-treep*)
         (proof-with-checked-results ((operation (proof-term-at claim 1)))
           (and (proof-is-call operation *t2-tree-rebalance-rebalance*) 0)))
        ((proof-is-call claim *proof-equal*)
         (proof-with-checked-results ((conversion (proof-term-at claim 1)))
           (and (proof-is-call conversion *t2-symbol-trees-to-alist*)
                (proof-with-checked-results ((operation (proof-term-at conversion 1)))
                  (and (proof-is-call operation *t2-tree-rebalance-rebalance*) 1)))))
        (t nil)))

(defun t2-tree-rebalance-prove-consequence (lib domain claim)
  (t2-tree-rebalance-with-library ((index (t2-tree-rebalance-claim-index claim)))
    (if (null index)
        (cons nil lib)
      (t2-tree-rebalance-with-library
          ((consequences (t2-tree-rebalance-rebalance-consequences-attempt lib))
           (lib (cdr consequences))
           (proof (library-library-proof lib))
           (source (proof-term-at domain 1))
           (facts (library-library-cite lib (car consequences) (list source) nil))
           (assumed (proof-proof-assume proof domain t))
           (consequence (t2-arithmetic-arithmetic-modus-ponens lib facts assumed))
           (parts (t2-arithmetic-arithmetic-conjunct lib consequence))
           (step (t2-power-implication lib domain (nth index parts))))
        (cons step lib)))))

(defun t2-tree-rebalance-prove-attempt (lib formula)
  (if (not (proof-is-call formula *library-implies*))
      (cons nil lib)
    (t2-tree-rebalance-with-library
        ((sides (proof-list-of-length (cdr formula) 2))
         (domain (car sides))
         (claim (cadr sides))
         (lookup-p (t2-tree-rebalance-lookup-claim-p domain claim)))
      (cond (lookup-p (t2-tree-rebalance-rebalance-lookup-attempt lib formula))
            ((proof-is-call domain *t2-symbol-trees-treep*)
             (t2-tree-rebalance-prove-consequence lib domain claim))
            (t (cons nil lib))))))

